[
{"id": 0, "speaker": 2, "form": "dlg", "jp": "「ただいま‥‥」"},
{"id": 1, "speaker": 3, "form": "dlg", "jp": "「おかえりなさい」"},
{"id": 2, "speaker": 26, "form": "dlg", "jp": "「オジャマしてるよ」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「三田さん、来てたの？」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「父さんは？」"},
{"id": 5, "speaker": 26, "form": "dlg", "jp": "「研究所に残ってるよ‥‥」"},
{"id": 6, "speaker": 26, "form": "dlg", "jp": "「ボクは博士の着替えを取りに来ただけだから‥‥」"},
{"id": 7, "speaker": 3, "form": "dlg", "jp": "「三田さんからも父さんに\n　たまには帰って来るように言っておいてください」"},
{"id": 8, "speaker": 26, "form": "dlg", "jp": "「そう言ってるんですけどね‥‥」"},
{"id": 9, "speaker": 3, "form": "dlg", "jp": "「明日あった時にキツく言っておかないと‥‥」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「明日父さんに会うの？」"},
{"id": 11, "speaker": 3, "form": "dlg", "jp": "「何言ってるの、明日は『パーティー』でしょう？」"},
{"id": 12, "speaker": 3, "form": "dlg", "jp": "忘れてた‥‥"},
{"id": 13, "speaker": 3, "form": "dlg", "jp": "明日は父さんの研究のバックアップをしている会社の\n『パーティー』がありボクたちも招待されてる。"},
{"id": 14, "speaker": 26, "form": "dlg", "jp": "「明日の『パーティー』はごちそうが出るらしいよ」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「今の中学生はそんなことじゃよろこばないよ」"},
{"id": 16, "speaker": 26, "form": "dlg", "jp": "「あはははは‥‥」"},
{"id": 17, "speaker": 26, "form": "dlg", "jp": "「そうだね、ボクが中学生の時も喜ばなかったよ‥‥」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「で、パーティーってどこであるの？」"},
{"id": 19, "speaker": 3, "form": "dlg", "jp": "「それが‥‥」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 21, "speaker": 3, "form": "dlg", "jp": "「『あのホテル』なの‥‥」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「『あのホテル』？」"},
{"id": 23, "speaker": 26, "form": "dlg", "jp": "「ナゴムくんたちが\n　ルードに襲われたホテルなんだって‥‥」"},
{"id": 24, "speaker": 3, "form": "dlg", "jp": "「もうルードのことは心配ないでしょうけど、\n　なんかイヤよねぇ」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「不思議な『運命』を感じるね‥‥」"},
{"id": 27, "speaker": 26, "form": "dlg", "jp": "「まあ、不思議なことがあるから\n　世の中面白いんですけどね‥‥」"},
{"id": 28, "speaker": 26, "form": "dlg", "jp": "「実はボクが科学者を目ざしたのも\n　不思議を究明したいからなんですけど‥‥」"},
{"id": 29, "speaker": 3, "form": "dlg", "jp": "「もしかして三田さんは、\n　『幽霊』とか『超能力』を信じる人？」"},
{"id": 30, "speaker": 26, "form": "dlg", "jp": "「ええ、信じるもなにも『大好物』です！」"},
{"id": 31, "speaker": 26, "form": "choice", "jp": "「科学者なのに？」"},
{"id": 32, "speaker": 26, "form": "choice", "jp": "「趣味悪い！！」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「科学者なのに？」"},
{"id": 34, "speaker": 26, "form": "dlg", "jp": "「『科学者だから』ですよ！！」"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "「趣味悪い！！」"},
{"id": 36, "speaker": 26, "form": "dlg", "jp": "「そんなことはありませんよ！」"},
{"id": 37, "speaker": 26, "form": "dlg", "jp": "「不思議を解明しようとするのが\n　科学者の宿命です！」"},
{"id": 38, "speaker": 26, "form": "dlg", "jp": "「『エジソン』が『霊界通信』を\n　発明しようとしていたのは有名な話ですし‥‥」"},
{"id": 39, "speaker": 26, "form": "dlg", "jp": "「もっと有名なのでは、\n　例の『火の玉教授』とか‥‥」"},
{"id": 40, "speaker": 26, "form": "choice", "jp": "「じゃあ、『ＵＦＯ』とか詳しいの？」"},
{"id": 41, "speaker": 26, "form": "choice", "jp": "「じゃあ、『超能力』とか詳しいの？」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "「じゃあ、『ＵＦＯ』とか詳しいの？」"},
{"id": 43, "speaker": 26, "form": "dlg", "jp": "「まあ、それなりにね‥‥」"},
{"id": 44, "speaker": 26, "form": "choice", "jp": "「やっぱり、『宇宙人』の乗り物なの？」"},
{"id": 45, "speaker": 26, "form": "choice", "jp": "「どうして『円盤型』なの？」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「やっぱり、『宇宙人』の乗り物なの？」"},
{"id": 47, "speaker": 26, "form": "dlg", "jp": "「それはどうかなぁ～？」"},
{"id": 48, "speaker": 26, "form": "dlg", "jp": "「『未確認飛行物体』の目撃証言は\n　信じられるレポートもたくさんあるけど‥‥」"},
{"id": 49, "speaker": 26, "form": "dlg", "jp": "「『エイリアン遭遇』のレポートは\n　ウソくさいものばかりだから‥‥」"},
{"id": 50, "speaker": 26, "form": "choice", "jp": "「『アダムスキーさん』の話は？」"},
{"id": 51, "speaker": 26, "form": "choice", "jp": "「『ニューハンプシャー州の夫婦』の話は？」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「『アダムスキーさん』の話は？」"},
{"id": 53, "speaker": 26, "form": "dlg", "jp": "「ああ、あの『アダムスキー型ＵＦＯ』の‥‥」"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "「『金星人に会った』って‥‥」"},
{"id": 55, "speaker": 26, "form": "dlg", "jp": "「『６１歳』で『金星人』に出会って、\n　ペンダントをもらったっていってるけど‥‥」"},
{"id": 56, "speaker": 26, "form": "dlg", "jp": "「若い頃の写真に\n　そのペンダントが写っているからな‥‥」"},
{"id": 57, "speaker": 26, "form": "dlg", "jp": "「なにより、月や火星に空気があるって話を\n　信じられるかどうかって感じかな‥‥」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「『ニューハンプシャー州の夫婦』の話は？」"},
{"id": 59, "speaker": 26, "form": "dlg", "jp": "「あの『宇宙人にさらわれて身体検査された』\n　っていう‥‥」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「ホントだったら恐いよね‥‥」"},
{"id": 61, "speaker": 26, "form": "dlg", "jp": "「ホントでしたらね‥‥」"},
{"id": 62, "speaker": 26, "form": "dlg", "jp": "「あれって、『逆行催眠』で出て来た証言でしょう？」"},
{"id": 63, "speaker": 26, "form": "dlg", "jp": "「『逆行催眠』ってあてになんないんですよ‥‥」"},
{"id": 64, "speaker": 26, "form": "dlg", "jp": "「だいたい、『催眠状態』ってネボケた状態だから」\n"},
{"id": 65, "speaker": 26, "form": "dlg", "jp": "「『前世を見た』とか『宇宙人にあった』とか\n　寝言みたいなコトを‥‥」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「どうして『円盤型』なの？」"},
{"id": 67, "speaker": 26, "form": "dlg", "jp": "「それは、はじめてＵＦＯが大々的に\n　マスコミに報じられた時の話なんですけど‥‥」"},
{"id": 68, "speaker": 26, "form": "dlg", "jp": "「目撃者が『お皿を投げたみたいな飛び方だった』\n　って言ったのが『空飛ぶ円盤』って報じられたから」"},
{"id": 69, "speaker": 26, "form": "dlg", "jp": "「そのせいでみんなかってに、『ＵＦＯ』＝『円盤型』\n　って思い込むようになったんですよ」"},
{"id": 70, "speaker": 26, "form": "dlg", "jp": "「別に目撃者は\n　形については何も言ってないんですけどね？」"},
{"id": 71, "speaker": 3, "form": "dlg", "jp": "「詳しいんですね‥‥」"},
{"id": 72, "speaker": 3, "form": "choice", "jp": "「ちょっと見直したよ‥‥」"},
{"id": 73, "speaker": 3, "form": "choice", "jp": "「‥‥友達少ないでしょう？」"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "「‥‥友達少ないでしょう？」"},
{"id": 75, "speaker": 26, "form": "dlg", "jp": "「まあ、孤独は科学者の宿命です！！」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「ちょっと見直したよ‥‥」"},
{"id": 77, "speaker": 26, "form": "dlg", "jp": "「アリガトウ‥‥」"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "「じゃあ、『超能力』とか詳しいの？」"},
{"id": 79, "speaker": 26, "form": "dlg", "jp": "「まあ、それなりにね‥‥」"},
{"id": 80, "speaker": 26, "form": "choice", "jp": "「念写とか詳しい？」"},
{"id": 81, "speaker": 26, "form": "choice", "jp": "「やっぱり、スプーン曲げ？」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「念写とか詳しい？」"},
{"id": 83, "speaker": 26, "form": "dlg", "jp": "「あれは手品だからなぁ～」"},
{"id": 84, "speaker": 26, "form": "choice", "jp": "「『東大の博士がみとめた』って‥‥？」"},
{"id": 85, "speaker": 26, "form": "choice", "jp": "「『月の裏側の写真』の話は？」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「『東大の博士がみとめた』って‥‥」"},
{"id": 87, "speaker": 26, "form": "dlg", "jp": "「『福来博士』のことだろう？」"},
{"id": 88, "speaker": 26, "form": "dlg", "jp": "「あの人まともな実験で成功したことないから‥‥」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「やっぱり、スプーン曲げ？」"},
{"id": 90, "speaker": 26, "form": "dlg", "jp": "「あれは手品だからなぁ～」"},
{"id": 91, "speaker": 26, "form": "choice", "jp": "「やっぱり‥‥」"},
{"id": 92, "speaker": 26, "form": "choice", "jp": "「じゃあ、誰でもできるの？」"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "「やっぱり‥‥」"},
{"id": 94, "speaker": 26, "form": "dlg", "jp": "「だって、どうして『スプーン』なんだって思いません？」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「思う、思う‥‥」"},
{"id": 96, "speaker": 26, "form": "dlg", "jp": "「あれって、パーティーなんかで\n　簡単にできるからでしょう？」"},
{"id": 97, "speaker": 26, "form": "dlg", "jp": "「まあ、マッチ棒を使った\n　『テーブルマジック』みたいなもんですよ‥‥」"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "「『月の裏側の写真』の話は？」"},
{"id": 99, "speaker": 26, "form": "dlg", "jp": "「あれって雑誌の想像図だろう？」"},
{"id": 100, "speaker": 26, "form": "dlg", "jp": "「どうして、そんなもの『念写』するの？」"},
{"id": 101, "speaker": 26, "form": "dlg", "jp": "「インチキにもほどがあるよ‥‥」"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「じゃあ、誰でもできるの？」"},
{"id": 103, "speaker": 26, "form": "dlg", "jp": "「ですから、手品なんで、手品師じゃないと‥‥」"},
{"id": 104, "speaker": 26, "form": "dlg", "jp": "「そもそも、誰でもできないことをするから\n　『超能力』だっていっちゃうと‥‥」"},
{"id": 105, "speaker": 26, "form": "dlg", "jp": "「『大食い』も『腹話術』も\n　みんな『超能力』ってことになっちゃいますね‥‥」"},
{"id": 106, "speaker": 26, "form": "dlg", "jp": "三田さんは結構このテの話が好きなのか、\nうれしそうに話してくれた。"},
{"id": 107, "speaker": 26, "form": "dlg", "jp": "三田さんになら『能力』の話をしても大丈夫かも‥‥"},
{"id": 108, "speaker": 26, "form": "dlg", "jp": "自分ひとりで抱えるには深刻すぎる問題だし、\nここは相談してみるか‥‥"},
{"id": 109, "speaker": 26, "form": "choice", "jp": "【しかし、『ジーンとの約束』が‥‥】"},
{"id": 110, "speaker": 26, "form": "choice", "jp": "【いや、相談しておいて損はないだろう】"},
{"id": 111, "speaker": 26, "form": "dlg", "jp": "【いや、相談しておいて損はないだろう】"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「三田さん‥‥」"},
{"id": 113, "speaker": 26, "form": "dlg", "jp": "「どうしたんだい？」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「実はボク‥‥」"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "「『超能力者』なんです‥‥」"},
{"id": 116, "speaker": 26, "form": "dlg", "jp": "「それはスゴイ！！」"},
{"id": 117, "speaker": 26, "form": "dlg", "jp": "「で、何ができるの？」"},
{"id": 118, "speaker": 26, "form": "dlg", "jp": "「『スプーン曲げ』？　『トランプ当て』？」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「手品じゃないんです！！」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「本当に超能力者なんです！」"},
{"id": 121, "speaker": 3, "form": "dlg", "jp": "「本当なの？」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「ボク、体を自由に『変質』させることができるんだ」"},
{"id": 124, "speaker": 26, "form": "dlg", "jp": "「何それ？」"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "「例えば、\n　体を鉄のように硬くすることができるんだ‥‥」"},
{"id": 126, "speaker": 26, "form": "dlg", "jp": "「体の一部ってことじゃないですよね？」"},
{"id": 127, "speaker": 3, "form": "dlg", "jp": "「‥‥」"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "「いいから見てて‥‥」"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "「ハッ！！」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "ボクはあの時と同じように\n自分の体が硬くなるように念じた。"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥\n‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 132, "speaker": 3, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 133, "speaker": 26, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "しかし、なんの変化も現れなかった。"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "どうして、あの時はたしかに‥‥"},
{"id": 137, "speaker": 26, "form": "dlg", "jp": "「もう、おしまい？」"},
{"id": 138, "speaker": 26, "form": "dlg", "jp": "「まさか、それで柔軟体操がニガテになったとか？」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「そんなんじゃありません！！」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "いったいどういうことだ？"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "あの時と今とでどう違うんだ？"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "そうかっ！"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "あの時は命がけで念じたんだ‥‥"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "あの『能力』は命がけじゃないと発動しないんだ！"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "（やっぱり、真剣じゃないとダメなんだ‥‥）"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「ちょっとまって！」"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「姉さん、『ナイフ』持って来て‥‥」"},
{"id": 149, "speaker": 3, "form": "dlg", "jp": "「何をするつもり？」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「いいから持って来てよ」"},
{"id": 151, "speaker": 3, "form": "dlg", "jp": "「危ないことしないでよ‥‥」"},
{"id": 152, "speaker": 3, "form": "dlg", "jp": "姉さんは不安な表情で、\nボクに『ナイフ』を手渡した。"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「三田さん、この『ナイフ』を\n　ボクの顔めがけて投げてみて‥‥」"},
{"id": 154, "speaker": 26, "form": "dlg", "jp": "「そんなことできないよ‥‥」"},
{"id": 155, "speaker": 26, "form": "dlg", "jp": "「大丈夫？　タネとかあるの？」"},
{"id": 156, "speaker": 26, "form": "choice", "jp": "「タネなんかないよ！」"},
{"id": 157, "speaker": 26, "form": "choice", "jp": "「大丈夫、タネはしこんであるから」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「大丈夫、タネはしこんであるから‥‥」"},
{"id": 159, "speaker": 26, "form": "dlg", "jp": "「それなら遠慮なく‥‥」"},
{"id": 160, "speaker": 26, "form": "dlg", "jp": "「行くよ！！」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「いいですよ！」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「シュンッ！」"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "三田さんはボクの顔を狙ってナイフを投げた‥‥"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「グサッ！」"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "「ウワッ！！」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "「タネなんかないよ！」"},
{"id": 167, "speaker": 26, "form": "dlg", "jp": "「あぶないよ‥‥」"},
{"id": 168, "speaker": 3, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 169, "speaker": 3, "form": "dlg", "jp": "「くだらない手品遊びなんかしてないで、\n　宿題でもしなさい！！」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "食事を終えたボクは、\nそのまま大人しく自分の部屋へ戻ることにした。"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "（‥‥？？）"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "（窓が開いている？）"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "（なぜだ？）"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「シュンッ！」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "何かが風を切る音が聞こえた。"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「グサッ！」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「ウワッ！！」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "【しかし、『ジーンとの約束』が‥‥】"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "やっぱり、このことは誰にも話さないでおこう！"},
