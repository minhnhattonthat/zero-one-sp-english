[
{"id": 0, "speaker": 51, "form": "dlg", "jp": "「で、どこにおるの？」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "「あの建物の中だろう？」"},
{"id": 2, "speaker": 51, "form": "dlg", "jp": "「なんで知ってるん？」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「その人の妹がウチに来たんだ‥‥」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「正確にはソイツが乗っ取った体の持ち主の妹‥‥」"},
{"id": 5, "speaker": 51, "form": "dlg", "jp": "「もしかして、オバケ屋敷のあの子？」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 7, "speaker": 29, "form": "dlg", "jp": "「とにかく、話が聞かれるとマズイわ！」"},
{"id": 8, "speaker": 29, "form": "dlg", "jp": "「今から、少しの間『テレパシー』は禁止よ！」"},
{"id": 9, "speaker": 31, "form": "dlg", "jp": "「こんなに遠くまで『能力』の有効範囲があったとは‥‥」"},
{"id": 10, "speaker": 29, "form": "dlg", "jp": "「違うわ！」"},
{"id": 11, "speaker": 29, "form": "dlg", "jp": "「アイツの『イメージ』は一旦完全に消えたのよ？」"},
{"id": 12, "speaker": 29, "form": "dlg", "jp": "「たぶん‥‥」"},
{"id": 13, "speaker": 29, "form": "dlg", "jp": "「『形』を変えてココまで来て、\n　それから復元したんだわ‥‥」"},
{"id": 14, "speaker": 31, "form": "dlg", "jp": "「で、なんでこんなとこまで？」"},
{"id": 15, "speaker": 29, "form": "dlg", "jp": "「それは‥‥」"},
{"id": 16, "speaker": 51, "form": "dlg", "jp": "「もしかしたら‥‥」"},
{"id": 17, "speaker": 51, "form": "dlg", "jp": "「『清田さん』を『殺すため』ちゃう？」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 19, "speaker": 51, "form": "dlg", "jp": "「アイツ、\n　こないだのウチらの話を聞いてたんちゃうかな？」"},
{"id": 20, "speaker": 51, "form": "dlg", "jp": "「その人の発明品がアイツの『コレクション』を\n　元に戻せるって言ってたから‥‥」"},
{"id": 21, "speaker": 51, "form": "dlg", "jp": "「あの時、常光寺、\n　『城北大学の清田さん』って言ってたし‥‥」"},
{"id": 22, "speaker": 31, "form": "dlg", "jp": "「アイツなら、ヤリかねないな‥‥」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「じゃあ清田さんは‥‥」"},
{"id": 24, "speaker": 29, "form": "dlg", "jp": "「その妹っていう子の話が本当なら、\n　もう『脳』は乗っ取られてるわね‥‥」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「そんな！！」"},
{"id": 26, "speaker": 31, "form": "dlg", "jp": "「で、今ソイツは？」"},
{"id": 27, "speaker": 29, "form": "dlg", "jp": "「アレ、さっきまで建物の中にいたハズだけど‥‥」"},
{"id": 28, "speaker": 31, "form": "dlg", "jp": "「見失ったのか？」"},
{"id": 29, "speaker": 29, "form": "dlg", "jp": "「もう一度探してみるわ！」"},
{"id": 30, "speaker": 29, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 31, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 32, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「どうなの？」"},
{"id": 34, "speaker": 29, "form": "dlg", "jp": "「えっ！？」"},
{"id": 35, "speaker": 31, "form": "dlg", "jp": "「どうした？」"},
{"id": 36, "speaker": 29, "form": "dlg", "jp": "「ケネス後ろ！！」"},
{"id": 37, "speaker": 29, "form": "dlg", "jp": "「グサッ！」"},
{"id": 38, "speaker": 31, "form": "dlg", "jp": "「ウワッ！！」"},
{"id": 39, "speaker": 37, "form": "dlg", "jp": "「や、やったぞ！！」"},
{"id": 40, "speaker": 37, "form": "dlg", "jp": "「さっきのおかえしだ！！」"},
{"id": 41, "speaker": 37, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 42, "speaker": 37, "form": "dlg", "jp": "清田さんに乗り移ったゴトウは\n建物の中に逃げ込んだ。"},
{"id": 43, "speaker": 31, "form": "dlg", "jp": "「ウグ‥‥‥‥」"},
{"id": 44, "speaker": 15, "form": "dlg", "jp": "「とにかく、救急車を！！」"},
{"id": 45, "speaker": 31, "form": "dlg", "jp": "「オレより、アイツのコトを‥‥」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 47, "speaker": 29, "form": "dlg", "jp": "「アイツのコトは私とナゴムにまかせて！」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「そうだね、アイコはケネスを病院に‥‥」"},
{"id": 49, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃんたちだけで大丈夫なの？」"},
{"id": 50, "speaker": 16, "form": "dlg", "jp": "「とにかく、救急車！！」"},
{"id": 51, "speaker": 31, "form": "dlg", "jp": "「オレより、アイツのコトを‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "「アイツのコトは私とナゴムにまかせて！」"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "「そうだね、長尾はケネスを病院に‥‥」"},
{"id": 55, "speaker": 16, "form": "dlg", "jp": "「２人だけで大丈夫なの？」"},
{"id": 56, "speaker": 18, "form": "dlg", "jp": "「とにかく、救急車を！！」"},
{"id": 57, "speaker": 31, "form": "dlg", "jp": "「オレより、アイツのコトを‥‥」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 59, "speaker": 29, "form": "dlg", "jp": "「アイツのコトは私とナゴムにまかせて！」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「そうだね、堤さんはケネスを病院に‥‥」"},
{"id": 61, "speaker": 18, "form": "dlg", "jp": "「２人だけで大丈夫？」"},
{"id": 62, "speaker": 51, "form": "dlg", "jp": "「とにかく、救急車や！！」"},
