[
{"id": 0, "speaker": 2, "form": "dlg", "jp": "「で、姉さんはどこに‥‥？」"},
{"id": 1, "speaker": 29, "form": "dlg", "jp": "「キミのお姉さんらしき人は‥‥」"},
{"id": 2, "speaker": 29, "form": "dlg", "jp": "「う～～ん‥‥」"},
{"id": 3, "speaker": 29, "form": "dlg", "jp": "ジーンは精神を集中させ、姉さんを探してくれた。"},
{"id": 4, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 5, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 7, "speaker": 29, "form": "dlg", "jp": "「牢のあった通路を出て来た方と反対に進んで、\n　突き当たりを左に進むの‥‥」"},
{"id": 8, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 9, "speaker": 29, "form": "dlg", "jp": "途中の十字路には見張りがいる"},
{"id": 10, "speaker": 29, "form": "dlg", "jp": "から、それに注意して\n　そのまままっすぐ進むと広い場所に出るから‥‥」"},
{"id": 11, "speaker": 29, "form": "dlg", "jp": "「そこにある部屋の中にいるわ‥‥」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「わかった、突き当たりを左にまっすぐだね‥‥」"},
{"id": 13, "speaker": 29, "form": "dlg", "jp": "「それから、もうすぐ国際警察が\n　大挙して踏み込んでくるから‥‥」"},
{"id": 14, "speaker": 29, "form": "dlg", "jp": "「そのどさくさにまぎれれば、\n　どうにかなるかも‥‥」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「どうして、そんなこと？」"},
{"id": 16, "speaker": 29, "form": "dlg", "jp": "「今、"},
{"id": 17, "speaker": 29, "form": "dlg", "jp": "警察の無線"},
{"id": 18, "speaker": 29, "form": "dlg", "jp": "が聞こえたの‥‥」"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "「もうすぐ、『ルード壊滅作戦』を実行開始するって‥‥」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「わかった、ありがと‥‥」"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "「じゃあ、これで私は‥‥」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「うん、本当にありがとう‥‥」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "ジーンはジャングルの中に走り去った。"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "（さてと‥‥）"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "（姉さんを助けにゆくか‥‥）"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "ボクは再び建物の中に戻っていった。"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "（ここのことだな‥‥）"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "（ジーンの言っていた『見張りのいる十字路』ってのは‥‥）"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "そこには確かに２人の見張りがいた。"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "見張りはまだボクに気が付いていないようで、\nさらには緊張感なくダラダラとしているだけだった。"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "（よし、これならどうにかやりすごせそうだ‥‥）"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "（しまった！）"},
{"id": 35, "speaker": 30, "form": "dlg", "jp": "「オイ、逃げるつもりだな！」"},
{"id": 36, "speaker": 30, "form": "dlg", "jp": "「させるかっ！」"},
{"id": 37, "speaker": 30, "form": "dlg", "jp": "「ダーーーン！」"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "ボクの胸から大量の血が吹き出した。"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "ボクはそのまま意識を失った‥‥"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "（よし、うまくいったぞ！）"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "（あとはこの道をまっすぐだな‥‥）"},
{"id": 44, "speaker": 2, "form": "dlg", "jp": "（しまった！）"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "（また見張りだ‥‥）"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "（姉さんはこの先にいるっていうのに‥‥！！）"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "（とりあえず、この階段を登ってみるか‥‥）"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "階段を登ってみたが、そこからは\n姉さんがいる場所には行けそうもなかった。"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "いつまでもここにいたら、ヤツらに見つかってしまう。"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "なんとかしなくては‥‥"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "しかし、消火器があるぐらいで、\nあとは目立ったものは見あたらない‥‥"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "（消火器か‥‥）"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "（これをぶつけてみるか‥‥）"},
{"id": 55, "speaker": 30, "form": "dlg", "jp": "「コゾウ！　そんなところで何してやがる！！」"},
{"id": 56, "speaker": 30, "form": "dlg", "jp": "「ダーーーン！」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "ボクの胸から大量の血が吹き出した。"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "ボクはそのまま意識を失った‥‥"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "（よしっ！）"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "（今のうちに‥‥）"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "（ここか‥‥）"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "（姉さん‥‥！！）"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "そこには銃をつきつけられて、\n無理矢理作業をさせられている姉さんの姿があった。"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "（こう、がっちりと見張られていたら、\n　簡単に助け出すことはできないな‥‥）"},
{"id": 68, "speaker": 2, "form": "choice", "jp": "（こんな時にジーンがいてくれたら‥‥）"},
{"id": 69, "speaker": 2, "form": "choice", "jp": "（仕方ない、しばらく様子をみよう‥‥）"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "（こんな時にジーンがいてくれたら‥‥）"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "（‥‥‥？）"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "（そういえば、ジーンが言ってたぞ！）"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "（もうすぐ、『国際警察が突入してくるから\n　それに便乗して逃げ出せ』って‥‥）"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "（よし、それまで待ってみるか‥‥）"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "（仕方ない、しばらく様子をみよう‥‥）"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "（たしかジーンが『国際警察が突入してくるから\n　それに便乗して逃げ出せ』って言ってたから）"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "（すこし、待ってれば、\n　状況は変わるだろう‥‥）"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "ボクはしばらくここに身をひそめ、\nチャンスをうかがうことにした。"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "そして、\nチャンスは思っていたより早くに訪れた‥‥"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "（‥‥？？）"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "多分、警察の作戦が開始されたのだろう。"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "姉さんを見張っていた連中が、\n部屋から飛び出していった。"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "（今だ！　今のうちに‥‥）"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「姉さん！！」"},
{"id": 87, "speaker": 3, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "「今のうちだ早く逃げよう！！」"},
{"id": 89, "speaker": 3, "form": "dlg", "jp": "「へっ？」"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "「大丈夫だ、出口はわかっている！」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「ついて来て！！」"},
{"id": 92, "speaker": 3, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 93, "speaker": 3, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 94, "speaker": 3, "form": "dlg", "jp": "ボクは姉さんを連れて来た道を戻り始めた。"},
{"id": 95, "speaker": 3, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 96, "speaker": 3, "form": "dlg", "jp": "あちらこちらから、銃声や爆音が聞こえる。"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「こっちだ！」"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "「しまった！」"},
{"id": 99, "speaker": 3, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "「出口はこの先なんだけど‥‥」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "ボクたちの目の前では警察とルードとの\n銃撃戦が繰り広げられていた。"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「仕方ない‥‥」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「姉さん、銃撃がやんだら突っ込むから\n　遅れずについて来てよ！」"},
{"id": 104, "speaker": 3, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「姉さん！！」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "ボクは慌てて姉さんに駆け寄ろうとした。"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "その時！！"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「うわっ！！」"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「うわっ！！」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "ボクたちはどうにか通りぬけることができた。"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「もう少しだから頑張って‥‥」"},
{"id": 113, "speaker": 3, "form": "dlg", "jp": "「ええ、私は大丈夫よ‥‥」"},
{"id": 114, "speaker": 32, "form": "dlg", "jp": "「お～い、キミたち～！」"},
{"id": 115, "speaker": 32, "form": "dlg", "jp": "「そんなとこで何をしているんだ～～！」"},
{"id": 116, "speaker": 32, "form": "dlg", "jp": "「早く退避しなさい～～」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「行こう！！」"},
{"id": 118, "speaker": 28, "form": "dlg", "jp": "「フフフフフ‥‥」"},
{"id": 119, "speaker": 28, "form": "dlg", "jp": "「どこへ行くつもりだ‥‥」"},
{"id": 120, "speaker": 3, "form": "dlg", "jp": "「私たちを日本に帰してください！！」"},
{"id": 121, "speaker": 28, "form": "dlg", "jp": "「おとなしく現場に戻るんだ！！」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「こんなことしている場合じゃないだろう？」"},
{"id": 123, "speaker": 28, "form": "dlg", "jp": "「なんのことだ‥‥？」"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「警察が‥‥」"},
{"id": 125, "speaker": 28, "form": "dlg", "jp": "「関係ない！」"},
{"id": 126, "speaker": 28, "form": "dlg", "jp": "「警察なんて恐るるにたらんな‥‥」"},
{"id": 127, "speaker": 28, "form": "dlg", "jp": "「さあ、おとなしく戻るんだ！」"},
{"id": 128, "speaker": 3, "form": "dlg", "jp": "「お断わりします！！」"},
{"id": 129, "speaker": 28, "form": "dlg", "jp": "「フフフフフ‥‥強情なレディーだ‥‥」"},
{"id": 130, "speaker": 28, "form": "dlg", "jp": "「弟の命がどうなってもかまわないのか？」"},
{"id": 131, "speaker": 3, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 132, "speaker": 28, "form": "dlg", "jp": "「３つ数える間に、戻ると言ってもらおうか‥‥」"},
{"id": 133, "speaker": 28, "form": "dlg", "jp": "「１つ‥‥」"},
{"id": 134, "speaker": 28, "form": "dlg", "jp": "「２つ‥‥」"},
{"id": 135, "speaker": 28, "form": "dlg", "jp": "「３つ‥‥」"},
{"id": 136, "speaker": 3, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 137, "speaker": 28, "form": "dlg", "jp": "「そうか、わかったよ‥‥」"},
{"id": 138, "speaker": 28, "form": "dlg", "jp": "「姉弟仲良くオヤジさんのところへ行きな‥‥」"},
{"id": 139, "speaker": 28, "form": "dlg", "jp": "ウィルソン大佐の指が引き金にかかった瞬間‥‥"},
{"id": 140, "speaker": 4, "form": "dlg", "jp": "「リツコ、ナゴム伏せて！！」"},
{"id": 141, "speaker": 4, "form": "dlg", "jp": "館内放送の声だった‥‥"},
{"id": 142, "speaker": 28, "form": "dlg", "jp": "「何‥‥？」"},
{"id": 143, "speaker": 28, "form": "dlg", "jp": "目の前にいた大佐が一瞬にして蒸発してしまった。"},
{"id": 144, "speaker": 3, "form": "dlg", "jp": "「いったい何が‥‥？」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「わからない‥‥」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "天井を見上げると、\nそこには大きな穴があいていた。"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「とにかく今のうちに‥‥」"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "ボクたちは出口へと駆け出した。"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "（しまった！）"},
{"id": 151, "speaker": 30, "form": "dlg", "jp": "「オイ、逃げるつもりだな！」"},
{"id": 152, "speaker": 30, "form": "dlg", "jp": "「させるかっ！」"},
{"id": 153, "speaker": 30, "form": "dlg", "jp": "「ダーーーン！」"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "ボクの胸から大量の血が吹き出した。"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "ボクはそのまま意識を失った‥‥"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "「ハァ、ハァ‥‥」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「もう大丈夫だろう‥‥」"},
{"id": 159, "speaker": 3, "form": "dlg", "jp": "「そうね‥‥‥」"},
{"id": 160, "speaker": 4, "form": "dlg", "jp": "「ちょっと、アナタたち！！」"},
{"id": 161, "speaker": 21, "form": "dlg", "jp": "「こんなところで何してるの！？」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「警視さん！！」"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「警視さんこそ、どうして‥‥？」"},
{"id": 164, "speaker": 21, "form": "dlg", "jp": "「私は、仕事よ‥‥」"},
{"id": 165, "speaker": 21, "form": "dlg", "jp": "「それより、アナタたちは‥‥？」"},
{"id": 166, "speaker": 3, "form": "dlg", "jp": "「私たちは、\n　『ルード』に無理矢理連れてこられたんです」"},
{"id": 167, "speaker": 21, "form": "dlg", "jp": "「何？　まだかかわりをもってるの！？」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「そんなことより、警視さんの仕事って‥‥」"},
{"id": 169, "speaker": 21, "form": "dlg", "jp": "「"},
{"id": 170, "speaker": 21, "form": "dlg", "jp": "『ルード壊滅作戦』"},
{"id": 171, "speaker": 21, "form": "dlg", "jp": "の指揮よ！！」"},
{"id": 172, "speaker": 3, "form": "dlg", "jp": "「もしかして、さっき私たちを助けてくれたのは？」"},
{"id": 173, "speaker": 21, "form": "dlg", "jp": "「何のことかしら？」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「さっきの屋根からの攻撃は‥‥」"},
{"id": 175, "speaker": 21, "form": "dlg", "jp": "「ああ、アレね‥‥」"},
{"id": 176, "speaker": 21, "form": "dlg", "jp": "「アレは私たちには関係ないわ‥‥」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「どういうことですか？」"},
{"id": 178, "speaker": 21, "form": "dlg", "jp": "「アレは軍の仕業よ‥‥」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「軍？？」"},
{"id": 180, "speaker": 21, "form": "dlg", "jp": "「ホラみて、軍事衛星からの攻撃よ‥‥」"},
{"id": 181, "speaker": 21, "form": "dlg", "jp": "「大袈裟なことを‥‥」"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "「軍がどうして‥‥？」"},
{"id": 183, "speaker": 21, "form": "dlg", "jp": "「さあ、手柄を私たちに渡したくないとか‥‥」"},
{"id": 184, "speaker": 21, "form": "dlg", "jp": "「何か秘密があって隠滅しようとしてるとか‥‥」"},
{"id": 185, "speaker": 21, "form": "dlg", "jp": "「理由はいろいろ考えられるわ‥‥」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「でも、軍ならどうしてボクたちの名前を‥‥」"},
{"id": 187, "speaker": 3, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「ハァ‥‥？」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "姉さんはボクの質問をさえぎった。"},
{"id": 190, "speaker": 21, "form": "dlg", "jp": "「どうかしたの‥‥？」"},
{"id": 191, "speaker": 3, "form": "dlg", "jp": "「いえ、なんでもありません！！」"},
{"id": 192, "speaker": 3, "form": "dlg", "jp": "「ナゴム！　ちょっと‥‥」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 194, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 195, "speaker": 3, "form": "dlg", "jp": "（攻撃の前に名前を呼ばれたことは言っちゃダメ！）"},
{"id": 196, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "（どうして‥‥？）"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 200, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 201, "speaker": 3, "form": "dlg", "jp": "（理由は後で話すから‥‥）"},
{"id": 202, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 203, "speaker": 21, "form": "dlg", "jp": "「まあ、たしかに軍のおかげで、\n　仕事ははかどりそうだけど‥‥」"},
{"id": 204, "speaker": 21, "form": "dlg", "jp": "ボクたちはこのあとインターポールに保護され、\n事情聴取を受けることになった。"},
{"id": 205, "speaker": 21, "form": "dlg", "jp": "事情聴取の最中に聞いた話では、今回の作戦によって\n『ルード』の幹部のほとんどは逮捕され、"},
{"id": 206, "speaker": 21, "form": "dlg", "jp": "事実上の壊滅状態ということだった。"},
{"id": 207, "speaker": 21, "form": "dlg", "jp": "事情聴取では『どうやって逃げ出したのか？』を\nしつこく聞かれたが、"},
{"id": 208, "speaker": 21, "form": "dlg", "jp": "ボクは『ジーン』や『超能力』のことは言わなかった。"},
{"id": 209, "speaker": 21, "form": "dlg", "jp": "なぜかはわからないが、言ってしまうと\n面倒なことに巻き込まれるような気がしたからだ‥‥"},
{"id": 210, "speaker": 21, "form": "dlg", "jp": "また、なぜだか軍は今回の作戦への関与を\n完全否定しているらしい。"},
{"id": 211, "speaker": 21, "form": "dlg", "jp": "おかげで、警視さんは手柄を独り占めできたようだ。"},
{"id": 212, "speaker": 21, "form": "dlg", "jp": "事情聴取は警視さんがいてくれたおかげで\n２日で終わらせてもらえ、"},
{"id": 213, "speaker": 21, "form": "dlg", "jp": "ボクたちは日本に帰れることになった。"},
{"id": 214, "speaker": 21, "form": "dlg", "jp": "２００５／０８／０５／ＰＭ０８：３０"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "「これで本当に終わりなんだよね‥‥？」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「『ルード』は壊滅したって言ってたし‥‥」"},
{"id": 217, "speaker": 3, "form": "dlg", "jp": "「今度こそそうあってほしいものね‥‥」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「まさか外国まで連れて来られるとは‥‥」"},
{"id": 219, "speaker": 3, "form": "dlg", "jp": "「せっかく夏休みだったんだから、\n　このまま観光してから帰ってもよかったわね‥‥」"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「本当だね‥‥」"},
{"id": 221, "speaker": 3, "form": "dlg", "jp": "「なんだかナゴム、\n　たくましくなったんじゃない？」"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "「そうかもしれないな‥‥」"},
{"id": 223, "speaker": 3, "form": "dlg", "jp": "「あるんだ‥‥『自覚』‥‥」"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "「いや、もう父さんも、シローもいないんだから、\n　やっぱりボクが強くなんないと‥‥」"},
{"id": 225, "speaker": 3, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 226, "speaker": 3, "form": "dlg", "jp": "「でも、シローはいなくなってないかも‥‥」"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 228, "speaker": 3, "form": "dlg", "jp": "「シローはきっと生きているわ‥‥」"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 230, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 231, "speaker": 3, "form": "dlg", "jp": "あの声"},
{"id": 232, "speaker": 3, "form": "dlg", "jp": "よ‥‥」"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "「声？」"},
{"id": 234, "speaker": 3, "form": "dlg", "jp": "「私たちがロバートとかいう人に殺されかけた時に\n　聞こえたあの声‥‥」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「じゃあ、姉さんはあそこに『シロー』がいたと‥‥」"},
{"id": 236, "speaker": 3, "form": "dlg", "jp": "「う～ん、まだ調べてみないとわからないけど、\n　アレはきっと『シロー』だわ‥‥」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「ふ～ん」"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "「姉さんが言うならそうかもしれないね‥‥」"},
{"id": 239, "speaker": 3, "form": "dlg", "jp": "「そういえば、ナゴム‥‥」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 241, "speaker": 3, "form": "dlg", "jp": "「アナタはどうして、あそこから脱出できたの？」"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「偶然だよ、グウゼン‥‥」"},
{"id": 244, "speaker": 3, "form": "dlg", "jp": "「私たちって、ツイてるのかしら、\n　ツイていないのかしら‥‥？」"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "「さあ‥‥」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "結局ボクは、姉さんにも『ジーン』や\n『超能力』のことを話さなかった。"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "ボクは、このことがさらに\nボクたちに災いをもたらすのではと思っていたからだ‥‥"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "敵の動きは一定のパターンなので見極めれば\n簡単に脱出できるハズ。\n経験を積むことがクリアへの近道。"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "敵の動きは一定のパターンなので見極めれば、\nあとはタイミングの問題。\n経験を積むことがクリアへの近道。"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "敵の銃撃のタイミングは一定。\nパターンを覚えてしまえ。\n経験を積むことがクリアへの近道。"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "失敗の原因は緊張感の欠落。\n今はムダな道を進んでいる場合では無い。"}
]
