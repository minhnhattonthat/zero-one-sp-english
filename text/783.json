[
{"id": 0, "speaker": 14, "form": "dlg", "jp": "「夏休みもこれで１日終了か‥‥」"},
{"id": 1, "speaker": 14, "form": "dlg", "jp": "「なんか、最近１日が終わるの早くないか？」"},
{"id": 2, "speaker": 13, "form": "dlg", "jp": "「別にまだ１日が終わったわけじゃないけどな」"},
{"id": 3, "speaker": 14, "form": "dlg", "jp": "「まあ、そうだけど‥‥」"},
{"id": 4, "speaker": 4, "form": "dlg", "jp": "（『母親』のことが知りたければ\n　ついて来なさい‥‥）"},
{"id": 5, "speaker": 4, "form": "dlg", "jp": "‥‥‥‥‥‥！？"},
{"id": 6, "speaker": 4, "form": "dlg", "jp": "ボクの頭の中で誰かの声が聞こえた。"},
{"id": 7, "speaker": 4, "form": "dlg", "jp": "いったい誰？"},
{"id": 8, "speaker": 13, "form": "dlg", "jp": "「オイ、アレ！」"},
{"id": 9, "speaker": 13, "form": "dlg", "jp": "「さっきの外国人じゃない？」"},
{"id": 10, "speaker": 14, "form": "dlg", "jp": "「ホントだ‥‥」"},
{"id": 11, "speaker": 4, "form": "dlg", "jp": "（知りたければついて来なさい‥‥）"},
{"id": 12, "speaker": 4, "form": "dlg", "jp": "まさか！"},
{"id": 13, "speaker": 4, "form": "dlg", "jp": "あの外国人が？"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「シンちゃん、ツトム‥‥」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「先に帰っててよ」"},
{"id": 16, "speaker": 14, "form": "dlg", "jp": "「ああ‥‥別にいいけど‥‥」"},
{"id": 17, "speaker": 14, "form": "dlg", "jp": "ボクは彼女を追うことにした。"},
{"id": 18, "speaker": 14, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 19, "speaker": 14, "form": "dlg", "jp": "ボクは必死で彼女の消えた方向へと走った。"},
{"id": 20, "speaker": 14, "form": "dlg", "jp": "しかし‥‥"},
{"id": 21, "speaker": 14, "form": "dlg", "jp": "見失ってしまったか‥‥"},
{"id": 22, "speaker": 14, "form": "dlg", "jp": "いったいなんだったんだろう、"},
{"id": 23, "speaker": 14, "form": "dlg", "jp": "‥‥‥‥‥‥あの声‥‥‥‥‥‥‥‥"},
{"id": 24, "speaker": 14, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 25, "speaker": 14, "form": "dlg", "jp": "２００５／０８／１１／ＰＭ０５：０５"},
{"id": 26, "speaker": 14, "form": "dlg", "jp": "「しっかし、さっきのガイジンさんカワイかったな‥‥」"},
{"id": 27, "speaker": 13, "form": "dlg", "jp": "「シンちゃんの好み？」"},
{"id": 28, "speaker": 14, "form": "dlg", "jp": "「オウヨ！」"},
{"id": 29, "speaker": 14, "form": "dlg", "jp": "「まあ、どちらかっていうとだけどな‥‥」"},
{"id": 30, "speaker": 14, "form": "dlg", "jp": "「ナゴムはどう思った？」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「どうって‥‥」"},
{"id": 32, "speaker": 2, "form": "choice", "jp": "「結構タイプかも‥‥」"},
{"id": 33, "speaker": 2, "form": "choice", "jp": "「まあまあかな‥‥？」"},
{"id": 34, "speaker": 2, "form": "choice", "jp": "「別にタイプじゃない！」"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "「結構タイプかも‥‥」"},
{"id": 36, "speaker": 14, "form": "dlg", "jp": "「だろう？」"},
{"id": 37, "speaker": 13, "form": "dlg", "jp": "「２人とも年上好き？」"},
{"id": 38, "speaker": 14, "form": "dlg", "jp": "「ダマレ！\n　ロ◯コン！！」"},
{"id": 39, "speaker": 13, "form": "dlg", "jp": "「ウララ‥‥」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「まあまあかな‥‥？」"},
{"id": 41, "speaker": 14, "form": "dlg", "jp": "「ミ◯キーはまあまあの味！！」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "「別にタイプじゃない！」"},
{"id": 43, "speaker": 14, "form": "dlg", "jp": "「そんな、『！』までつけて否定することか？」"},
{"id": 44, "speaker": 14, "form": "dlg", "jp": "「で、ツトムはどうなんだ？」"},
{"id": 45, "speaker": 13, "form": "dlg", "jp": "「オレはすべての女性の味方だから、\n　女の子を見た目だけで判断しません！」"},
{"id": 46, "speaker": 13, "form": "dlg", "jp": "「１２人妹がいたら、全員かわいがるよ！」"},
{"id": 47, "speaker": 14, "form": "dlg", "jp": "「ロリ好きじゃないのか！？」"},
{"id": 48, "speaker": 14, "form": "dlg", "jp": "「そういうことを言うヤツが一番あぶねえんだ‥‥」"},
{"id": 49, "speaker": 14, "form": "dlg", "jp": "「オマエじゃないのか、話題の通り魔って‥‥」"},
{"id": 50, "speaker": 13, "form": "dlg", "jp": "「ちがうって、オレは女性の味方だから‥‥」"},
{"id": 51, "speaker": 14, "form": "dlg", "jp": "「ところで、ナゴム‥‥」"},
{"id": 52, "speaker": 14, "form": "dlg", "jp": "「作文、書けそうか？」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "「『中学最後の夏休みはバカな友達と\n　バカ話をして過ごしました』って‥‥」"},
{"id": 55, "speaker": 14, "form": "dlg", "jp": "「なるほど、それは良かった‥‥」"},
{"id": 56, "speaker": 14, "form": "dlg", "jp": "「じゃあな、また明日‥‥」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 58, "speaker": 13, "form": "dlg", "jp": "「じゃあ、お姉様に『女性の味方』が\n　よろしくって言ってたって伝えといて‥‥」"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "「ああ、わかった‥‥」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "ボクたちは、そこで解散した。"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "なんだか、すっかり疲れてしまった。"},
{"id": 62, "speaker": 2, "form": "choice", "jp": "（今日はぐっすり眠れそうだ‥‥）"},
{"id": 63, "speaker": 2, "form": "choice", "jp": "（今日も眠れそうにない‥‥）"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "（今日はぐっすり眠れそうだ‥‥）"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "（さあ、いそいで帰ろう）"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "（今日も眠れそうにない‥‥）"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "（なぜなら‥‥）"},
{"id": 68, "speaker": 2, "form": "choice", "jp": "（『ジーン』に似た少女のことが気にかかる‥‥）"},
{"id": 69, "speaker": 2, "form": "choice", "jp": "（『通り魔』のことが気にかかる‥‥）"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "（『ジーン』に似た少女のことが気にかかる‥‥）"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "（アレはもしかしたら本当に『ジーン』なのかもしれない）"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "（もしそうだとしたら、一体何をしに日本へ？）"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "（まさか、ボクに会うため！？）"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "（ダメだ、考えれば考えるほど不安になる‥‥）"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "（余計なことは考えず、いそいで帰ろう）"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "（『通り魔』のことが気にかかる‥‥）"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "（ウワサでは、この町でも被害者が出たらしい‥‥）"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "（何かイヤな予感がする‥‥）"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "（『通り魔』は若い女性ばかり狙うらしい‥‥）"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "（まさか、姉さんが‥‥！？）"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "（ダメだ、考えれば考えるほど不安になる‥‥）"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "（余計なことは考えず、いそいで帰ろう）"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "その時！"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「ブーン！」"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "鉄球がボクめがけて飛んでくる。"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "あんなのが命中したら死んでしまう。"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "よけなきゃ！"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "「ウガグッ！」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "もう一度、命中したらきっと命が危ない‥‥"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "ボクは立っているのがやっとの状態だ。"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "こんな体でよけることができるのか？"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "冷や汗がアゴから滴り落ちる。"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "鉄球がうなり始めた！"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "来るっ！"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「ブーン！」"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "ダメだ‥‥"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "もうよけられない！！"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "このままでは確実に死んでしまう！！"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "この体が"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "『鋼鉄製』"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "でもない限り！！"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「ガーン！！」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "確かに鉄球はボクに命中した。"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "しかし、ボクは全然痛みを感じなかった。"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "なぜだ‥‥！？"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "！？"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "なんだ、この体は‥‥！？"},
{"id": 108, "speaker": 4, "form": "dlg", "jp": "「それが、キミの能力よ‥‥」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「誰だっ！？」"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「キ、キミはっ！？」"},
{"id": 111, "speaker": 29, "form": "dlg", "jp": "「『ジーン・ライト』よ‥‥」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「ジーン‥‥？」"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "「キミの"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "お母さんの仲間"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "よ‥‥」"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "誰だっ！？"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "「無事に日本に帰って来れたようね‥‥？」"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「ジーン！！」"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "「とりあえず、いつまでもそのカッコウじゃ\n　人目につくわ‥‥」"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "「もとのキミに戻って‥‥」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「戻ってってどうやって‥‥？」"},
{"id": 122, "speaker": 29, "form": "dlg", "jp": "「今、キミは追い込まれて力を発動しただけ。\n　落ち着けばそれで戻れるんじゃない？」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「落ち着けっていっても、\n　こんなことになったら落ち着けないよ‥‥」"},
{"id": 124, "speaker": 29, "form": "dlg", "jp": "「緊張を解除すればいいのよ‥‥」"},
{"id": 125, "speaker": 29, "form": "dlg", "jp": "「安心して、もう『アレ』は飛んでこないから‥‥」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「ホントウだね？」"},
{"id": 127, "speaker": 29, "form": "dlg", "jp": "「信じて‥‥」"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "ボクは少し安心した。"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "「ホラ、戻ったでしょう‥‥」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「いったい、どういうことなんだ！？」"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "「さっきの鉄球も君の仕業なのか？」"},
{"id": 133, "speaker": 29, "form": "dlg", "jp": "「一度にいろいろ聞かないで！」"},
{"id": 134, "speaker": 29, "form": "dlg", "jp": "「それに、ここじゃ人目につくわ‥‥」"},
{"id": 135, "speaker": 29, "form": "dlg", "jp": "「説明してあげるから、場所を変えましょう」"},
{"id": 136, "speaker": 29, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "そういって、彼女は作業員の帰った後の工事現場に\nボクを引き込んだ。"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "「ここなら、人目につかないでしょう？」"},
{"id": 139, "speaker": 29, "form": "dlg", "jp": "「さあ、説明してあげるわ‥‥‥」"},
{"id": 140, "speaker": 29, "form": "dlg", "jp": "「何が聞きたいの？」"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "「キミはいったい？」"},
{"id": 142, "speaker": 29, "form": "dlg", "jp": "「名前ならさっき名乗ったハズだけど‥‥」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「そうじゃなくて‥‥」"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "「なんで、母さんのこと？\n　それにさっきの『鉄球』は？」"},
{"id": 145, "speaker": 29, "form": "dlg", "jp": "「ゴメン、一度には答えられないわ‥‥」"},
{"id": 146, "speaker": 29, "form": "dlg", "jp": "「まず、『鉄球』は『ケネス』の仕業よ‥‥」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「『ケネス』？」"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「じゃあ、もう一度聞くけど一体今のは？」"},
{"id": 149, "speaker": 29, "form": "dlg", "jp": "「日本人らしい、あいまいな質問ね‥‥」"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "「どっちのこと？\n　『鉄球』？それとも『体の変化』？」"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「どっちもだよ‥‥」"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "「じゃあ、まず"},
{"id": 153, "speaker": 29, "form": "dlg", "jp": "『鉄球』"},
{"id": 154, "speaker": 29, "form": "dlg", "jp": "のことからね」"},
{"id": 155, "speaker": 29, "form": "dlg", "jp": "「アレは私じゃないわ‥‥」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「じゃあ、なんなんだよ？」"},
{"id": 157, "speaker": 29, "form": "dlg", "jp": "「紹介するわ‥‥」"},
{"id": 158, "speaker": 29, "form": "dlg", "jp": "「『ケネス』！！」"},
{"id": 159, "speaker": 31, "form": "dlg", "jp": "「『ケネス・アーノルド』だ‥‥」"},
{"id": 160, "speaker": 31, "form": "dlg", "jp": "「ナイス、トゥ　ミ－チュウ！！」"},
{"id": 161, "speaker": 29, "form": "dlg", "jp": "「彼も『超能力者』で、\n　"},
{"id": 162, "speaker": 29, "form": "dlg", "jp": "『サイコキネシス』"},
{"id": 163, "speaker": 29, "form": "dlg", "jp": "が使えるの‥‥」"},
{"id": 164, "speaker": 31, "form": "dlg", "jp": "「手荒なまねをして悪かったな‥‥」"},
{"id": 165, "speaker": 31, "form": "dlg", "jp": "「まあ、これも"},
{"id": 166, "speaker": 31, "form": "dlg", "jp": "キミの能力"},
{"id": 167, "speaker": 31, "form": "dlg", "jp": "を引き出すためだ‥‥」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「ボクの能力？？」"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "「さっきのアレよ‥‥」"},
{"id": 170, "speaker": 29, "form": "dlg", "jp": "「まさか『マテリアルメスメリズマー』だったとはね‥‥」"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "「『マテリアルメスメリズマー』？？」"},
{"id": 172, "speaker": 29, "form": "dlg", "jp": "「『肉体催眠術者』‥‥」"},
{"id": 173, "speaker": 29, "form": "dlg", "jp": "「つまり、暗示で"},
{"id": 174, "speaker": 29, "form": "dlg", "jp": "自分の肉体を\n　変質させることができる"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "人間ってこと」"},
{"id": 176, "speaker": 29, "form": "dlg", "jp": "「超能力の中でも最も珍しい能力の１つよ‥‥」"},
{"id": 177, "speaker": 31, "form": "dlg", "jp": "「エリートだよキミは‥‥」"},
{"id": 178, "speaker": 29, "form": "dlg", "jp": "「つまり、"},
{"id": 179, "speaker": 29, "form": "dlg", "jp": "キミもお母さんと同じ\n　『超能力者』"},
{"id": 180, "speaker": 29, "form": "dlg", "jp": "ってことよ！」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「母さんって"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "『超能力者』"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "だったの！？」"},
{"id": 184, "speaker": 31, "form": "dlg", "jp": "「知らなかったのか？」"},
{"id": 185, "speaker": 31, "form": "choice", "jp": "「母さんのことを知ってるの？」"},
{"id": 186, "speaker": 31, "form": "choice", "jp": "「じゃあ、さっきの『声』は？」"},
{"id": 187, "speaker": 31, "form": "choice", "jp": "「キミたちはいったい？」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「母さんのことを知ってるの？」"},
{"id": 189, "speaker": 29, "form": "dlg", "jp": "「私たちの間では"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "『伝説のチャネラー』"},
{"id": 191, "speaker": 29, "form": "dlg", "jp": "よ‥‥」"},
{"id": 192, "speaker": 2, "form": "dlg", "jp": "「『チャネラー』？」"},
{"id": 193, "speaker": 29, "form": "dlg", "jp": "「他人の意識を呼び出せる、いわゆる"},
{"id": 194, "speaker": 29, "form": "dlg", "jp": "『霊媒師』"},
{"id": 195, "speaker": 29, "form": "dlg", "jp": "‥‥」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "『霊媒師』"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "？」"},
{"id": 199, "speaker": 31, "form": "dlg", "jp": "「『イタコ』ってヤツだ‥‥」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "「じゃあ、さっきの『声』は？」"},
{"id": 201, "speaker": 29, "form": "dlg", "jp": "「私の"},
{"id": 202, "speaker": 29, "form": "dlg", "jp": "『テレパシー』"},
{"id": 203, "speaker": 29, "form": "dlg", "jp": "よ‥‥」"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "『テレパシー』"},
{"id": 206, "speaker": 2, "form": "dlg", "jp": "が使えるの？」"},
{"id": 207, "speaker": 29, "form": "dlg", "jp": "「『超能力者』は全員使えるわよ！」"},
{"id": 208, "speaker": 29, "form": "dlg", "jp": "「キミだって‥‥」"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "「ボクにも？」"},
{"id": 210, "speaker": 29, "form": "dlg", "jp": "「さっき、私の『テレパシー』を受信したでしょう？」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「あれはキミの能力じゃぁ？」"},
{"id": 212, "speaker": 31, "form": "dlg", "jp": "「ジーンは念じただけだ‥‥\n　受信したのはナゴムだ‥‥」"},
{"id": 213, "speaker": 31, "form": "dlg", "jp": "「その証拠にいっしょにいた友だちには\n　聞こえていない‥‥」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "「キミたちはいったい？」"},
{"id": 215, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 216, "speaker": 29, "form": "dlg", "jp": "キミと同じ『超能力者』"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "よ‥‥」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「じゃあ、キミたちもあんな体に？」"},
{"id": 219, "speaker": 29, "form": "dlg", "jp": "「同じ『超能力者』だけど、\n　同じ『能力』を持っているわけじゃないわ‥‥」"},
{"id": 220, "speaker": 29, "form": "dlg", "jp": "「ケネスは『サイコキネシス』だし‥‥」"},
{"id": 221, "speaker": 29, "form": "dlg", "jp": "「私は『千里眼』‥‥」"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "「『千里眼』？」"},
{"id": 223, "speaker": 29, "form": "dlg", "jp": "「遠くの物が見えたり普通の人が聞こえない音を\n　聞くことができるの‥‥」"},
{"id": 224, "speaker": 31, "form": "dlg", "jp": "「まあ、簡単に言えば『人間レーダー』だな‥‥」"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "「はぁ‥‥」"},
{"id": 226, "speaker": 2, "form": "choice", "jp": "「じゃあ、さっきの『声』は？」"},
{"id": 227, "speaker": 2, "form": "choice", "jp": "「キミたちはいったい？」"},
{"id": 228, "speaker": 2, "form": "choice", "jp": "「母さんのことを知ってるの？」"},
{"id": 229, "speaker": 2, "form": "choice", "jp": "「キミたちはいったい？」"},
{"id": 230, "speaker": 2, "form": "choice", "jp": "「母さんのことを知ってるの？」"},
{"id": 231, "speaker": 2, "form": "choice", "jp": "「じゃあ、さっきの『声』は？」"},
{"id": 232, "speaker": 29, "form": "dlg", "jp": "「聞きたいことはそれだけ？」"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "「母さんは‥‥」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「母さんはどうして『自殺』なんか？」"},
{"id": 235, "speaker": 29, "form": "dlg", "jp": "「お母さんにこだわるのね‥‥」"},
{"id": 236, "speaker": 2, "form": "dlg", "jp": "「母さんの"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "『幽霊』"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "を見たんだ‥‥」"},
{"id": 239, "speaker": 31, "form": "dlg", "jp": "「"},
{"id": 240, "speaker": 31, "form": "dlg", "jp": "『幽霊』"},
{"id": 241, "speaker": 31, "form": "dlg", "jp": "？」"},
{"id": 242, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 243, "speaker": 29, "form": "dlg", "jp": "『残存思念』"},
{"id": 244, "speaker": 29, "form": "dlg", "jp": "ね‥‥」"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "『残存思念』"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "？」"},
{"id": 248, "speaker": 29, "form": "dlg", "jp": "「『幽霊』なんかじゃないわ‥‥」"},
{"id": 249, "speaker": 29, "form": "dlg", "jp": "「キミのお母さんは自分の意識の一部を\n　『場』に固定させていたようね‥‥」"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "「なんで『自殺』なんか‥‥」"},
{"id": 251, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 252, "speaker": 29, "form": "dlg", "jp": "「『自殺』なんかしていないわ‥‥」"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 255, "speaker": 29, "form": "dlg", "jp": "殺された"},
{"id": 256, "speaker": 29, "form": "dlg", "jp": "のよ‥‥」"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥！！」"},
{"id": 258, "speaker": 29, "form": "dlg", "jp": "「『自殺』に見せかけて‥‥」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「いったい誰に！」"},
{"id": 260, "speaker": 29, "form": "dlg", "jp": "「名前は言えないわ‥‥」"},
{"id": 261, "speaker": 2, "form": "dlg", "jp": "「って、知ってるんだね？」"},
{"id": 262, "speaker": 29, "form": "dlg", "jp": "「直接手をくだしたのは誰かは知らないけど‥‥」"},
{"id": 263, "speaker": 29, "form": "dlg", "jp": "「暗殺を指示したのは『大物政治家』よ‥‥」"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "「『大物政治家』！？」"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "「なんで、そんなエライ人が？」"},
{"id": 266, "speaker": 31, "form": "dlg", "jp": "「なんでエライんだ？」"},
{"id": 267, "speaker": 31, "form": "dlg", "jp": "「『大物』だからか？」"},
{"id": 268, "speaker": 31, "form": "dlg", "jp": "「『政治家』だからか？」"},
{"id": 269, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥」"},
{"id": 270, "speaker": 29, "form": "dlg", "jp": "「まあ、エライ人だったのは間違いないわ‥‥」"},
{"id": 271, "speaker": 29, "form": "dlg", "jp": "「でも、エライ人だから、\n　『常光寺タイラ』の能力が脅威だったの‥‥」"},
{"id": 272, "speaker": 29, "form": "dlg", "jp": "「キミのお母さんだってバカじゃないから、\n　その『能力』を他人に知られないようにしてたわ」"},
{"id": 273, "speaker": 29, "form": "dlg", "jp": "「でも、ある事件の被害者家族が困っているのを\n　知ってその人たちの為に『能力』を使おうと‥‥」"},
{"id": 274, "speaker": 2, "form": "dlg", "jp": "「なんで、それだけのことで殺されるの？」"},
{"id": 275, "speaker": 31, "form": "dlg", "jp": "「世の中には『本当の未解決事件』と\n　『ウソの未解決事件』があるんだよ！」"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "「『ウソの未解決事件』？」"},
{"id": 277, "speaker": 29, "form": "dlg", "jp": "「ワケがあって、\n　あえて解決をしない事件よ‥‥」"},
{"id": 278, "speaker": 29, "form": "dlg", "jp": "「キミのお母さんが『力』を貸そうとした事件は‥‥」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "「『ウソの未解決事件』だった‥‥」"},
{"id": 280, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 281, "speaker": 29, "form": "dlg", "jp": "「警察が犯人もわかっているけど\n　逮捕できない事件‥‥」"},
{"id": 282, "speaker": 29, "form": "dlg", "jp": "「それをキミのお母さんは\n　解決しようとしてしまった‥‥」"},
{"id": 283, "speaker": 29, "form": "dlg", "jp": "「それが、『大物政治家』にバレてしまった‥‥」"},
{"id": 284, "speaker": 2, "form": "dlg", "jp": "「で、『暗殺』‥‥」"},
{"id": 285, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "「キミたちは母さんの仲間なんでしょう？」"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「どうしてカタキを！！」"},
{"id": 289, "speaker": 29, "form": "dlg", "jp": "「『ルール』よ‥‥」"},
{"id": 290, "speaker": 29, "form": "dlg", "jp": "「仕方ないの‥‥」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「『ルール』？」"},
{"id": 292, "speaker": 31, "form": "dlg", "jp": "「オレたちは普通の人間に『能力』や\n　『組織』のことを知られちゃいけないんだ‥‥」"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "「どうして？」"},
{"id": 294, "speaker": 29, "form": "dlg", "jp": "「キミのお母さんのような目にあうから‥‥」"},
{"id": 295, "speaker": 29, "form": "dlg", "jp": "「本当なら、他人に『能力』のことを知られた者は\n　仲間によって殺されることになってるの‥‥」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 297, "speaker": 29, "form": "dlg", "jp": "「そういう存在が世間に広まると\n　私たち全員の命が危なくなるから‥‥」"},
{"id": 298, "speaker": 31, "form": "dlg", "jp": "「『魔女狩り』って知ってるだろう？」"},
{"id": 299, "speaker": 29, "form": "dlg", "jp": "「だから、私たちの組織はキミのお母さんを\n　助けなかったの‥‥」"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 301, "speaker": 2, "form": "dlg", "jp": "「でも、『自殺』ってことになってるってことは\n　その犯人も政治家も逮捕されてないんだろう？」"},
{"id": 302, "speaker": 31, "form": "dlg", "jp": "「それどころか、元の事件の犯人もな‥‥」"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "「どうにかできないの？」"},
{"id": 304, "speaker": 29, "form": "dlg", "jp": "「私たちがどうにかするレベルの相手じゃないわ‥‥」"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「確かに大きすぎる相手だろうけど‥‥」"},
{"id": 306, "speaker": 31, "form": "dlg", "jp": "「ハァ？」"},
{"id": 307, "speaker": 29, "form": "dlg", "jp": "「小さすぎるのよ！！」"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "「小さすぎる！？」"},
{"id": 309, "speaker": 29, "form": "dlg", "jp": "「私たち"},
{"id": 310, "speaker": 29, "form": "dlg", "jp": "『Ｅ－ｇｒｏ』"},
{"id": 311, "speaker": 29, "form": "dlg", "jp": "（イーグル）の敵は\n　もっと巨大で強力なものなの‥‥」"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って！！」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "『Ｅ－ｇｒｏ』"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "（イーグル）って？」"},
{"id": 316, "speaker": 29, "form": "dlg", "jp": "「エスパーグループの略‥‥」"},
{"id": 317, "speaker": 29, "form": "dlg", "jp": "「私たちは『ペルー』に本部のある超能力者ばかりの組織\n　『Ｅ－ｇｒｏ』（イーグル）のメンバーなの‥‥」"},
{"id": 318, "speaker": 29, "form": "dlg", "jp": "「キミのお母さんもそうだったわ‥‥」"},
{"id": 319, "speaker": 29, "form": "dlg", "jp": "「私たち２人は本部の指示で日本にいる超能力者を\n　勧誘するためにやって来たの‥‥」"},
{"id": 320, "speaker": 29, "form": "dlg", "jp": "「巨大な敵と戦うためには\n　もっとメンバーを補充する必要があるの‥‥」"},
{"id": 321, "speaker": 31, "form": "dlg", "jp": "「仲間になってくれるだろう？」"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 323, "speaker": 2, "form": "dlg", "jp": "「なんで、ボクが？」"},
{"id": 324, "speaker": 31, "form": "dlg", "jp": "「ナゴムはスゴイ能力を持ってるじゃないか！？」"},
{"id": 325, "speaker": 31, "form": "dlg", "jp": "「だいたい、\n　誰がその能力を覚せいしてやったと思ってるんだ？」"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "「そんなおかしな恩を着せられても‥‥」"},
{"id": 327, "speaker": 2, "form": "dlg", "jp": "「だいたい『巨大な敵』って‥‥」"},
{"id": 328, "speaker": 29, "form": "dlg", "jp": "「『ゲーマー』よ‥‥」"},
{"id": 329, "speaker": 2, "form": "dlg", "jp": "「『ゲーマー』？」"},
{"id": 330, "speaker": 2, "form": "dlg", "jp": "「あのゲーム好きの？」"},
{"id": 331, "speaker": 29, "form": "dlg", "jp": "「確かに『ゲーム好き』ではあるけど、\n　キミが考えている連中とは違うわ‥‥」"},
{"id": 332, "speaker": 29, "form": "dlg", "jp": "「『人類滅亡』を企む巨大な敵よ‥‥」"},
{"id": 333, "speaker": 29, "form": "dlg", "jp": "ボクに彼女たちの話がまったく理解できない。\nどこまでが冗談で、どこまでが本当なんだ？"},
{"id": 334, "speaker": 31, "form": "dlg", "jp": "「難しくかんがえるな‥‥」"},
{"id": 335, "speaker": 31, "form": "dlg", "jp": "「キミは知りたいことがあってここに来たと思っている‥‥」"},
{"id": 336, "speaker": 31, "form": "dlg", "jp": "「しかし、知ったことが\n　予想していたことと大きく違った‥‥」"},
{"id": 337, "speaker": 31, "form": "dlg", "jp": "「そしてここに来た意味を失いかけている‥‥」"},
{"id": 338, "speaker": 31, "form": "dlg", "jp": "「だが、それはキミ自身の事情でしかない‥‥」"},
{"id": 339, "speaker": 31, "form": "dlg", "jp": "「たしかに、\n　キミの予想は間違っていたかもしれないが」"},
{"id": 340, "speaker": 31, "form": "dlg", "jp": "「キミがここに来たことは間違いじゃないんだよ！」"},
{"id": 341, "speaker": 31, "form": "dlg", "jp": "「キミはお母さんの意志をついで\n　オレたちといっしょに戦うベキなんだ！」"},
{"id": 342, "speaker": 31, "form": "dlg", "jp": "『母さんの意志』‥‥‥"},
{"id": 343, "speaker": 31, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 344, "speaker": 31, "form": "dlg", "jp": "本当に母さんが\nこの人たちの仲間だったっていう証拠は？"},
{"id": 345, "speaker": 29, "form": "dlg", "jp": "「難しく考えないで」"},
{"id": 346, "speaker": 29, "form": "dlg", "jp": "「この世界がなくなってもいいと思うか？\n　思わないか？　それだけのことよ‥‥」"},
{"id": 347, "speaker": 29, "form": "dlg", "jp": "「どう、理解できた？」"},
{"id": 348, "speaker": 29, "form": "choice", "jp": "「理解できないよ、ぜんぜん！」"},
{"id": 349, "speaker": 29, "form": "choice", "jp": "「なんとなくは‥‥」"},
{"id": 350, "speaker": 2, "form": "dlg", "jp": "「理解できないよ、ぜんぜん！」"},
{"id": 351, "speaker": 29, "form": "dlg", "jp": "「複雑に考えないで、\n　現実に起きたことだけを感じとって‥‥」"},
{"id": 352, "speaker": 29, "form": "dlg", "jp": "「キミは自分の体を守るために、\n　自分の体を頑丈に『変質』させた‥‥」"},
{"id": 353, "speaker": 29, "form": "dlg", "jp": "「ただ、それだけのことよ‥‥」"},
{"id": 354, "speaker": 2, "form": "dlg", "jp": "「なんとなくは‥‥」"},
{"id": 355, "speaker": 2, "form": "dlg", "jp": "「つまり、ボクは自分の意志で、\n　自分の体を『変質』させることができる？」"},
{"id": 356, "speaker": 29, "form": "dlg", "jp": "「そう、\n　ただ、それだけのことよ‥‥」"},
{"id": 357, "speaker": 2, "form": "dlg", "jp": "「それだけのことって‥‥」"},
{"id": 358, "speaker": 2, "form": "dlg", "jp": "「それって、ものすごいことじゃないの？」"},
{"id": 359, "speaker": 29, "form": "dlg", "jp": "「ダメよ、常識にとらわれちゃ！」"},
{"id": 360, "speaker": 31, "form": "dlg", "jp": "「よく、スプーン曲げをする\n　『インチキ手品師』が言うだろう？」"},
{"id": 361, "speaker": 31, "form": "dlg", "jp": "「『スプーンは簡単に曲がるものだけど\n　曲がらないという意識が曲がらなくしている』って」"},
{"id": 362, "speaker": 31, "form": "dlg", "jp": "「アレと同じだよ‥‥」"},
{"id": 363, "speaker": 29, "form": "dlg", "jp": "「そう、人間の体は\n　本当は自由に『変質』するものなんだけど」"},
{"id": 364, "speaker": 29, "form": "dlg", "jp": "「『変質』しないっていうイメージが\n　『変質』をさまたげているのよ！」"},
{"id": 365, "speaker": 2, "form": "dlg", "jp": "「つまり、ボクは自分の意志で、\n　自分の体を『変質』させることができる？」"},
{"id": 366, "speaker": 29, "form": "dlg", "jp": "「そう、\n　ただ、それだけのことよ‥‥」"},
{"id": 367, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ボクは自由に\n　自分の体を『変質』することができるんだね？」"},
{"id": 368, "speaker": 29, "form": "dlg", "jp": "「たぶんね‥‥」"},
{"id": 369, "speaker": 2, "form": "dlg", "jp": "「じゃあ、試しに‥‥」"},
{"id": 370, "speaker": 2, "form": "choice", "jp": "「４０Ｍに巨大化しよう！」"},
{"id": 371, "speaker": 2, "form": "choice", "jp": "「透明人間になってみよう！」"},
{"id": 372, "speaker": 2, "form": "dlg", "jp": "「４０Ｍに巨大化しよう！」"},
{"id": 373, "speaker": 2, "form": "dlg", "jp": "「デュワッ！！」"},
{"id": 374, "speaker": 2, "form": "dlg", "jp": "‥‥‥"},
{"id": 375, "speaker": 2, "form": "dlg", "jp": "しかし、何も起こらなかった。"},
{"id": 376, "speaker": 2, "form": "dlg", "jp": "「やっぱり、命がけでないとできないのかな？」"},
{"id": 377, "speaker": 29, "form": "dlg", "jp": "「それも有るかもしれないけど‥‥」"},
{"id": 378, "speaker": 29, "form": "dlg", "jp": "「一番の理由は、『質量の変化』のイメージ化が\n　うまくできないんじゃないかしら？」"},
{"id": 379, "speaker": 29, "form": "dlg", "jp": "「同じ質量で『変質』するのと、\n　質量まで変えるのは全然異なることだから‥‥」"},
{"id": 380, "speaker": 31, "form": "dlg", "jp": "「日焼けするのは簡単だけど、\n　ダイエットは難しいみたいなもんだな‥‥」"},
{"id": 381, "speaker": 29, "form": "dlg", "jp": "「多分、質量の変化が頭でイメージできるようになれば\n　もしかしたら可能になるかもしれないけど‥‥」"},
{"id": 382, "speaker": 2, "form": "dlg", "jp": "「透明人間になってみよう！」"},
{"id": 383, "speaker": 2, "form": "dlg", "jp": "「テケレッツのパ！」"},
{"id": 384, "speaker": 2, "form": "dlg", "jp": "‥‥‥"},
{"id": 385, "speaker": 2, "form": "dlg", "jp": "しかし、何も起こらなかった。"},
{"id": 386, "speaker": 2, "form": "dlg", "jp": "「やっぱり、命がけでないとできないのかな？」"},
{"id": 387, "speaker": 29, "form": "dlg", "jp": "「それも有るかもしれないけど‥‥」"},
{"id": 388, "speaker": 29, "form": "dlg", "jp": "「一番の理由は、『透明化』のイメージ化が\n　うまくできないんじゃないかしら？」"},
{"id": 389, "speaker": 29, "form": "dlg", "jp": "「たとえば、ガラスは透明だけど、\n　見ることができるでしょう？」"},
{"id": 390, "speaker": 29, "form": "dlg", "jp": "「『見えない物』って一体何を思い浮かべる？」"},
{"id": 391, "speaker": 2, "form": "dlg", "jp": "「『空気』とか‥‥」"},
{"id": 392, "speaker": 29, "form": "dlg", "jp": "「確かに『空気』は見えないように思うけど‥‥」"},
{"id": 393, "speaker": 29, "form": "dlg", "jp": "「実際は見えてないだけで、\n　見えないわけじゃないでしょう？」"},
{"id": 394, "speaker": 29, "form": "dlg", "jp": "「空が青く見えるのだって、\n　本当は空気が見えているだけだから‥‥」"},
{"id": 395, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って、言っている意味がわかんないよ！」"},
{"id": 396, "speaker": 29, "form": "dlg", "jp": "「そういうことよ‥‥」"},
{"id": 397, "speaker": 29, "form": "dlg", "jp": "「つまり、キミが『透明』をイメージできない以上、\n　キミは『透明』になれないのよ！」"},
{"id": 398, "speaker": 31, "form": "dlg", "jp": "「日本の首相のモノマネはできても、\n　タンザニアの首相のモノマネは難しいだろう？」"},
{"id": 399, "speaker": 29, "form": "dlg", "jp": "「多分、『透明』が頭でイメージできるようになれば\n　もしかしたら可能になるかもしれないけど‥‥」"},
{"id": 400, "speaker": 2, "form": "dlg", "jp": "「じゃあ、\n　さっきみたいに体を硬くするぐらいなら簡単に‥‥」"},
{"id": 401, "speaker": 29, "form": "dlg", "jp": "「それも、なんとも言えないわね‥‥」"},
{"id": 402, "speaker": 29, "form": "dlg", "jp": "「多分、さっきは自分の『命』がかかっていたから\n　真剣に念じることができたんじゃぁないかしら‥‥」"},
{"id": 403, "speaker": 2, "form": "dlg", "jp": "「ちょっと、待って！！」"},
{"id": 404, "speaker": 2, "form": "dlg", "jp": "「今まで、何度も『死にそうな目』にあったけど、\n　一度もあんな風になったことはなかったぞ！」"},
{"id": 405, "speaker": 29, "form": "dlg", "jp": "「だから、真剣じゃなかったのよ‥‥」"},
{"id": 406, "speaker": 2, "form": "dlg", "jp": "「そんなコトはない！\n　死にそうなんだから『真剣』だった」"},
{"id": 407, "speaker": 31, "form": "dlg", "jp": "「甘えがあったとか‥‥」"},
{"id": 408, "speaker": 31, "form": "dlg", "jp": "「例えば、自分以外の誰かが助けてくれるとか‥‥」"},
{"id": 409, "speaker": 2, "form": "dlg", "jp": "「！！！」"},
{"id": 410, "speaker": 31, "form": "dlg", "jp": "「思い当たるフシがあるんだな？」"},
{"id": 411, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 412, "speaker": 31, "form": "dlg", "jp": "「難しく考えちゃダメなんだ‥‥」"},
{"id": 413, "speaker": 31, "form": "dlg", "jp": "「『空を飛びたい』と思うから\n　『飛行機を発明する』‥‥」"},
{"id": 414, "speaker": 31, "form": "dlg", "jp": "「誰も思わなければ、\n　『飛行機』なんて『発明されない』‥‥」"},
{"id": 415, "speaker": 31, "form": "dlg", "jp": "「『泳げる』と思うから『海に入る』‥‥」"},
{"id": 416, "speaker": 31, "form": "dlg", "jp": "「『泳げない』と思えば、『海には入らない』‥‥」"},
{"id": 417, "speaker": 31, "form": "dlg", "jp": "「できると思ったことはできる可能性がある\n　できないと思ったことはやりもしない‥‥」"},
{"id": 418, "speaker": 31, "form": "dlg", "jp": "「ほしいと思ったものは手に入れようとする\n　いらないものは欲しがりもしない‥‥」"},
{"id": 419, "speaker": 31, "form": "dlg", "jp": "「ただ、それだけのこと‥‥」"},
{"id": 420, "speaker": 29, "form": "dlg", "jp": "「キミが『能力』を必要とした時、\n　その能力があるのなら、それは発動され‥‥」"},
{"id": 421, "speaker": 29, "form": "dlg", "jp": "「必要としなければ、能力は発動されないのよ」"},
{"id": 422, "speaker": 29, "form": "dlg", "jp": "「今まで眠っていた『能力』が発動したのは、\n　あの時、私と出会って『能力』の存在を認めたからよ」"},
{"id": 423, "speaker": 29, "form": "dlg", "jp": "「以前のキミなら能力をイメージすることすら\n　できていなかったでしょうから‥‥」"},
{"id": 424, "speaker": 29, "form": "dlg", "jp": "「どう、理解できた？」"},
{"id": 425, "speaker": 2, "form": "dlg", "jp": "「理解できたけど‥‥」"},
{"id": 426, "speaker": 2, "form": "choice", "jp": "「なぜ、ボクの能力を覚醒させたんだ？」"},
{"id": 427, "speaker": 2, "form": "choice", "jp": "「なぜ、日本に来たの？」"},
{"id": 428, "speaker": 2, "form": "choice", "jp": "「日本語ウマイね２人とも‥‥」"},
{"id": 429, "speaker": 2, "form": "dlg", "jp": "「日本語ウマイね２人とも‥‥」"},
{"id": 430, "speaker": 29, "form": "dlg", "jp": "「日本語のできるメンバーが選ばれて来ているのよ！」"},
{"id": 431, "speaker": 2, "form": "dlg", "jp": "「選ばれて来た？」"},
{"id": 432, "speaker": 29, "form": "dlg", "jp": "「そう、"},
{"id": 433, "speaker": 29, "form": "dlg", "jp": "『Ｅ－ｇｒｏ』"},
{"id": 434, "speaker": 29, "form": "dlg", "jp": "（イーグル）にね‥‥」"},
{"id": 435, "speaker": 29, "form": "choice", "jp": "「『Ｅ－ｇｒｏ』（イーグル）？」"},
{"id": 436, "speaker": 29, "form": "choice", "jp": "「『Ｅａｇｌｅ』の間違いじゃァ？」"},
{"id": 437, "speaker": 2, "form": "dlg", "jp": "「『Ｅａｇｌｅ』の間違いじゃァ？」"},
{"id": 438, "speaker": 29, "form": "dlg", "jp": "「単なる語呂合わせよ、気にしないで‥‥」"},
{"id": 439, "speaker": 29, "form": "dlg", "jp": "「ワシって意味じゃなく、\n　エスパーグループって意味だから‥‥」"},
{"id": 440, "speaker": 29, "form": "dlg", "jp": "「私たちは『ペルー』に本部のある超能力者ばかりの組織\n　『Ｅ－ｇｒｏ』（イーグル）のメンバーなの‥‥」"},
{"id": 441, "speaker": 29, "form": "dlg", "jp": "「私たち２人は本部の指示で日本にいる超能力者を\n　勧誘するためにやって来たのよ」"},
{"id": 442, "speaker": 2, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』（イーグル）？」"},
{"id": 443, "speaker": 29, "form": "dlg", "jp": "「ワシって意味じゃなく、\n　エスパーグループって意味だから‥‥」"},
{"id": 444, "speaker": 29, "form": "dlg", "jp": "「私たちは『ペルー』に本部のある超能力者ばかりの組織\n　『Ｅ－ｇｒｏ』（イーグル）のメンバーなの‥‥」"},
{"id": 445, "speaker": 29, "form": "dlg", "jp": "「私たち２人は本部の指示で日本にいる超能力者を\n　勧誘するためにやって来たのよ」"},
{"id": 446, "speaker": 2, "form": "dlg", "jp": "「なぜ、ボクの能力を覚醒させたんだ？」"},
{"id": 447, "speaker": 29, "form": "dlg", "jp": "「私たちは『ペルー』に本部のある超能力者ばかりの組織\n　『Ｅ－ｇｒｏ』（イーグル）のメンバーなの‥‥」"},
{"id": 448, "speaker": 29, "form": "dlg", "jp": "「私たち２人は本部の指示で日本にいる超能力者を\n　勧誘するためにやって来たのよ」"},
{"id": 449, "speaker": 2, "form": "dlg", "jp": "「なぜ、日本に来たの？」"},
{"id": 450, "speaker": 29, "form": "dlg", "jp": "「私たちは『ペルー』に本部のある超能力者ばかりの組織\n　『Ｅ－ｇｒｏ』（イーグル）のメンバーなの‥‥」"},
{"id": 451, "speaker": 29, "form": "dlg", "jp": "「私たち２人は本部の指示で日本にいる超能力者を\n　勧誘するためにやって来たのよ」"},
{"id": 452, "speaker": 2, "form": "dlg", "jp": "「危険に巻き込まれたりするんじゃぁ？」"},
{"id": 453, "speaker": 31, "form": "dlg", "jp": "「まあ、そういうこともありうるな‥」"},
{"id": 454, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ヤダよ‥‥」"},
{"id": 455, "speaker": 31, "form": "dlg", "jp": "「しかし、放っておくと、もっと危険な目にあうな‥‥」"},
{"id": 456, "speaker": 31, "form": "dlg", "jp": "「ヘタすると、この世界が無くなってしまうかも‥‥」"},
{"id": 457, "speaker": 2, "form": "dlg", "jp": "「はぁ‥‥？」"},
{"id": 458, "speaker": 29, "form": "dlg", "jp": "「私たちは\n　『この世』を守るための仲間を集めてるの‥‥」"},
{"id": 459, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 460, "speaker": 2, "form": "choice", "jp": "「何をするための仲間なんだ？」"},
{"id": 461, "speaker": 2, "form": "choice", "jp": "「何の組織なんだよ？」"},
{"id": 462, "speaker": 2, "form": "choice", "jp": "「なんかおおげさだなぁ‥‥」"},
{"id": 463, "speaker": 2, "form": "dlg", "jp": "「なんかおおげさだなぁ‥‥」"},
{"id": 464, "speaker": 2, "form": "dlg", "jp": "「この世がなくなるって‥‥」"},
{"id": 465, "speaker": 2, "form": "choice", "jp": "「核戦争かい？」"},
{"id": 466, "speaker": 2, "form": "choice", "jp": "「地球温暖化かい？」"},
{"id": 467, "speaker": 2, "form": "choice", "jp": "「Ё石衝突かい？」"},
{"id": 468, "speaker": 2, "form": "dlg", "jp": "「核戦争かい！？」"},
{"id": 469, "speaker": 2, "form": "dlg", "jp": "「地球温暖化かい？」"},
{"id": 470, "speaker": 2, "form": "dlg", "jp": "「Ё石衝突かい？」"},
{"id": 471, "speaker": 2, "form": "dlg", "jp": "「そんなのボクの力じゃぁどうにも‥‥」"},
{"id": 472, "speaker": 31, "form": "dlg", "jp": "「何を勘違いしてるんだ？」"},
{"id": 473, "speaker": 31, "form": "dlg", "jp": "「オレたちの戦う相手はもっと別の次元の‥‥」"},
{"id": 474, "speaker": 2, "form": "dlg", "jp": "「何をするための仲間なんだ？」"},
{"id": 475, "speaker": 29, "form": "dlg", "jp": "「『この世』を守るための仲間‥‥」"},
{"id": 476, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 477, "speaker": 29, "form": "dlg", "jp": "「この世界を、文明を、\n　愛する人たちを守るための仲間よ」"},
{"id": 478, "speaker": 2, "form": "dlg", "jp": "「一体、何の組織なんだよ？」"},
{"id": 479, "speaker": 29, "form": "dlg", "jp": "「『この世』を守るための組織‥‥」"},
{"id": 480, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 481, "speaker": 29, "form": "dlg", "jp": "「この世界を、文明を、\n　愛する人たちを守るための組織よ」"},
{"id": 482, "speaker": 2, "form": "dlg", "jp": "「アヤシイよ、オタクら‥‥」"},
{"id": 483, "speaker": 2, "form": "dlg", "jp": "「そんな勧誘だったら、駅前でやってくれよ！！」"},
{"id": 484, "speaker": 2, "form": "choice", "jp": "「ボクはお金は持っていないぞ！！」"},
{"id": 485, "speaker": 2, "form": "choice", "jp": "「ボクは自動車免許なんかほしくないぞ！」"},
{"id": 486, "speaker": 2, "form": "dlg", "jp": "「ボクは自動車免許なんかほしくないぞ！」"},
{"id": 487, "speaker": 31, "form": "dlg", "jp": "「オイオイ、別に軍隊に勧誘しているワケじゃぁ‥‥」"},
{"id": 488, "speaker": 31, "form": "dlg", "jp": "「まあ、仲間になってもらうと、戦ってもらうことになるから\n　ある意味『軍隊』と同じか‥‥」"},
{"id": 489, "speaker": 2, "form": "dlg", "jp": "「ボクはお金は持っていないぞ！！」"},
{"id": 490, "speaker": 31, "form": "dlg", "jp": "「何を勘違いしてるんだ？」"},
{"id": 491, "speaker": 31, "form": "dlg", "jp": "「オレたちはただ、一緒に戦う仲間に\n　なってもらおうと‥‥」"},
{"id": 492, "speaker": 2, "form": "dlg", "jp": "「戦うって、一体何と？」"},
{"id": 493, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 494, "speaker": 29, "form": "dlg", "jp": "『ゲーマー』"},
{"id": 495, "speaker": 29, "form": "dlg", "jp": "よ‥‥」"},
{"id": 496, "speaker": 2, "form": "dlg", "jp": "「『ゲーマー』？」"},
{"id": 497, "speaker": 2, "form": "dlg", "jp": "「あのゲーム好きの？」"},
{"id": 498, "speaker": 29, "form": "dlg", "jp": "「確かに『ゲーム好き』ではあるけど、\n　キミが考えている連中とは違うわ‥‥」"},
{"id": 499, "speaker": 29, "form": "dlg", "jp": "「とりあえず、\n　今、ここで話せるのはここまでよ‥‥」"},
{"id": 500, "speaker": 29, "form": "dlg", "jp": "「後は、キミが仲間になってくれるって\n　約束したら教えてあげる‥‥」"},
{"id": 501, "speaker": 2, "form": "dlg", "jp": "「そんな話で約束なんてできないよ！」"},
{"id": 502, "speaker": 31, "form": "dlg", "jp": "「だから、複雑に考えちゃダメだって‥‥」"},
{"id": 503, "speaker": 31, "form": "dlg", "jp": "「この世界がなくなってもいいのか、\n　どうかだけの問題だって‥‥」"},
{"id": 504, "speaker": 2, "form": "dlg", "jp": "「それがウサンクサイんだよ‥‥」"},
{"id": 505, "speaker": 31, "form": "dlg", "jp": "「じゃあ、自分の力や、\n　オレたちの力を信じるかどうかだ‥‥」"},
{"id": 506, "speaker": 31, "form": "dlg", "jp": "「オレたちが『マジックショー』や『ツボ売り』のために\n　超能力者を集めていると思うのか？」"},
{"id": 507, "speaker": 31, "form": "dlg", "jp": "「そんなことをするなら、\n　もっと堂々と『駅前』なんかで勧誘するさ！」"},
{"id": 508, "speaker": 29, "form": "dlg", "jp": "「で、どうなの？」"},
{"id": 509, "speaker": 2, "form": "dlg", "jp": "「たしかに、キミには\n　一度助けてもらったことがあるけど‥‥」"},
{"id": 510, "speaker": 2, "form": "choice", "jp": "「わかった、仲間になるよ！！」"},
{"id": 511, "speaker": 2, "form": "choice", "jp": "「ダメだ、やっぱり信用できない！！」"},
{"id": 512, "speaker": 2, "form": "dlg", "jp": "「ダメだ、やっぱり信用できない！！」"},
{"id": 513, "speaker": 29, "form": "dlg", "jp": "「これが最後のチャンスよ‥‥\n　良く考えて答えてね‥‥」"},
{"id": 514, "speaker": 29, "form": "dlg", "jp": "「私たちの仲間になってくれる？」"},
{"id": 515, "speaker": 29, "form": "choice", "jp": "「イヤだ、仲間にならない！！」"},
{"id": 516, "speaker": 29, "form": "choice", "jp": "「わかった、仲間になるよ！！」"},
{"id": 517, "speaker": 2, "form": "dlg", "jp": "「イヤだ、仲間にならない！！」"},
{"id": 518, "speaker": 29, "form": "dlg", "jp": "「残念ね‥‥」"},
{"id": 519, "speaker": 29, "form": "dlg", "jp": "「能力が完全に目覚める前に、\n　キミには死んでもらうわ‥‥」"},
{"id": 520, "speaker": 2, "form": "dlg", "jp": "「ちょっと、待って！！」"},
{"id": 521, "speaker": 2, "form": "dlg", "jp": "「どうして！？」"},
{"id": 522, "speaker": 29, "form": "dlg", "jp": "「その力は志の低い人間が持つには危険すぎる‥‥」"},
{"id": 523, "speaker": 29, "form": "dlg", "jp": "「悪用される前に消滅させなければ‥‥」"},
{"id": 524, "speaker": 29, "form": "dlg", "jp": "「言っておくけど、『能力で助かる』って\n　考えているならそうは行かないわよ‥‥」"},
{"id": 525, "speaker": 29, "form": "dlg", "jp": "「キミはまだ、自由に能力を\n　コントロールできないんだから‥‥」"},
{"id": 526, "speaker": 29, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 527, "speaker": 29, "form": "dlg", "jp": "「ダーーーン！」"},
{"id": 528, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 529, "speaker": 2, "form": "dlg", "jp": "ボクの胸から大量の血が吹き出した。"},
{"id": 530, "speaker": 2, "form": "dlg", "jp": "ボクはそのまま意識を失った‥‥"},
{"id": 531, "speaker": 2, "form": "dlg", "jp": "「わかった、仲間になるよ！！」"},
{"id": 532, "speaker": 2, "form": "dlg", "jp": "「なんか２人の目つきコワイし‥‥」"},
{"id": 533, "speaker": 2, "form": "dlg", "jp": "「なんかよくわかんないけど、\n　『ジーン』には以前、助けてもらった恩があるし‥‥」"},
{"id": 534, "speaker": 2, "form": "dlg", "jp": "「なにより、２人とも、\n　コワイぐらい真剣だから‥‥」"},
{"id": 535, "speaker": 29, "form": "dlg", "jp": "「良かったわ‥‥」"},
{"id": 536, "speaker": 29, "form": "dlg", "jp": "「もし、断わられたら\n　キミを殺さなくちゃいけなかったの‥‥」"},
{"id": 537, "speaker": 2, "form": "dlg", "jp": "「ええっ！！」"},
{"id": 538, "speaker": 29, "form": "dlg", "jp": "「だって、その能力が悪用されたら\n　大変なことになってしまうから‥‥」"},
{"id": 539, "speaker": 29, "form": "dlg", "jp": "「完全にキミが能力を使いこなせるように\n　なる前に消してしまわないと‥‥」"},
{"id": 540, "speaker": 29, "form": "dlg", "jp": "「もちろん、裏切った時も死んでもらうから‥‥」"},
{"id": 541, "speaker": 2, "form": "dlg", "jp": "「コワイことをサラリと言うんだね‥‥」"},
{"id": 542, "speaker": 29, "form": "dlg", "jp": "「あたり前じゃない‥‥」"},
{"id": 543, "speaker": 29, "form": "dlg", "jp": "「人類の運命がかかってるんだから‥‥」"},
{"id": 544, "speaker": 29, "form": "dlg", "jp": "数時間前まで普通の中学生だった人間に\nそんなオオゲサなこと言っても‥‥"},
{"id": 545, "speaker": 2, "form": "dlg", "jp": "「なんかその言葉がピンとこないんだよな‥‥」"},
{"id": 546, "speaker": 31, "form": "dlg", "jp": "「いきなり、\n　すべてを受け入れろって言ってもムリがあるな‥‥」"},
{"id": 547, "speaker": 31, "form": "dlg", "jp": "「しかし、キミはわかっているハズだ‥‥」"},
{"id": 548, "speaker": 31, "form": "dlg", "jp": "「今、自分が正しい選択をしたことを‥‥」"},
{"id": 549, "speaker": 31, "form": "dlg", "jp": "「もし、オレたちのことが信用できないんだったら\n　自分のことを信じるんだ‥‥」"},
{"id": 550, "speaker": 31, "form": "dlg", "jp": "「ウソやデタラメであんな姿に変身しないだろう？」"},
{"id": 551, "speaker": 31, "form": "dlg", "jp": "それなんだよなぁ。\nあの姿のせいで余計に現実味がないんだ。"},
{"id": 552, "speaker": 31, "form": "choice", "jp": "「わかった、裏切らないよ！」"},
{"id": 553, "speaker": 31, "form": "choice", "jp": "「でも、ボクが本当に力になれるの？」"},
{"id": 554, "speaker": 2, "form": "dlg", "jp": "「わかった、裏切らないよ！」"},
{"id": 555, "speaker": 2, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 556, "speaker": 2, "form": "dlg", "jp": "「でも、ボクが本当に力になれるの？」"},
{"id": 557, "speaker": 2, "form": "dlg", "jp": "「なんだか、実感がわかないんだな～」"},
{"id": 558, "speaker": 29, "form": "dlg", "jp": "「しかたないわね‥‥」"},
{"id": 559, "speaker": 29, "form": "dlg", "jp": "「いきなり、信じろって言ってもムリがあるわね‥‥」"},
{"id": 560, "speaker": 2, "form": "dlg", "jp": "「だろう？」"},
{"id": 561, "speaker": 29, "form": "dlg", "jp": "「もう一度試してみる？」"},
{"id": 562, "speaker": 2, "form": "dlg", "jp": "「えっ！？」"},
{"id": 563, "speaker": 2, "form": "dlg", "jp": "「ヤだよ‥‥」"},
{"id": 564, "speaker": 2, "form": "dlg", "jp": "「さっきも死にかけたんだぜ‥‥」"},
{"id": 565, "speaker": 29, "form": "dlg", "jp": "「まだ気付いていないみたいね‥‥」"},
{"id": 566, "speaker": 2, "form": "dlg", "jp": "「何が？」"},
{"id": 567, "speaker": 29, "form": "dlg", "jp": "「さっきの傷、もうすっかり回復してるわよ‥‥」"},
{"id": 568, "speaker": 2, "form": "dlg", "jp": "「そういえば、さっきは立ってるのもやっとだったのに‥‥」"},
{"id": 569, "speaker": 31, "form": "dlg", "jp": "「自分の体を『無傷な状態』に『変質させた』んだな‥‥」"},
{"id": 570, "speaker": 29, "form": "dlg", "jp": "「じゃあ、もう１回いくわよ‥‥」"},
{"id": 571, "speaker": 29, "form": "dlg", "jp": "「ケネス、お願い！！」"},
{"id": 572, "speaker": 31, "form": "dlg", "jp": "「ＯＫ！！」"},
{"id": 573, "speaker": 31, "form": "dlg", "jp": "「ソレッ！！」"},
{"id": 574, "speaker": 2, "form": "dlg", "jp": "「ウワッ！！」"},
{"id": 575, "speaker": 29, "form": "dlg", "jp": "「自分の力を信じて‥‥」"},
{"id": 576, "speaker": 2, "form": "dlg", "jp": "（どうしよう？？）"},
{"id": 577, "speaker": 2, "form": "choice", "jp": "【体を柔らかくする】"},
{"id": 578, "speaker": 2, "form": "choice", "jp": "【筋肉を強くする】"},
{"id": 579, "speaker": 2, "form": "choice", "jp": "【体を硬くする】"},
{"id": 580, "speaker": 2, "form": "dlg", "jp": "ダメだどうしていいのかわからない！"},
{"id": 581, "speaker": 2, "form": "dlg", "jp": "ロープがヨウシャなくボクの体をしめつける。"},
{"id": 582, "speaker": 29, "form": "dlg", "jp": "「自分の能力を信じて！」"},
{"id": 583, "speaker": 2, "form": "dlg", "jp": "「ウググググググ‥‥」"},
{"id": 584, "speaker": 2, "form": "dlg", "jp": "呼吸がまったくできない。"},
{"id": 585, "speaker": 2, "form": "dlg", "jp": "意識がだんだんと遠くなる。"},
{"id": 586, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥」"},
{"id": 587, "speaker": 2, "form": "dlg", "jp": "そして、ロープはボクの体を引き裂いた。"},
{"id": 588, "speaker": 2, "form": "dlg", "jp": "【体を柔らかくする】"},
{"id": 589, "speaker": 2, "form": "dlg", "jp": "ボクは体を柔らかくして脱出を試みた。"},
{"id": 590, "speaker": 2, "form": "dlg", "jp": "成功だ！！"},
{"id": 591, "speaker": 31, "form": "dlg", "jp": "「やったじゃないか！！」"},
{"id": 592, "speaker": 31, "form": "dlg", "jp": "【筋肉を強くする】"},
{"id": 593, "speaker": 31, "form": "dlg", "jp": "ボクは筋肉を強くして脱出を試みた。"},
{"id": 594, "speaker": 31, "form": "dlg", "jp": "成功だ！！"},
{"id": 595, "speaker": 31, "form": "dlg", "jp": "「やったじゃないか！！」"},
{"id": 596, "speaker": 31, "form": "dlg", "jp": "【体を硬くする】"},
{"id": 597, "speaker": 31, "form": "dlg", "jp": "体を硬くして脱出を試みた。"},
{"id": 598, "speaker": 31, "form": "dlg", "jp": "成功だ！！"},
{"id": 599, "speaker": 31, "form": "dlg", "jp": "「やったじゃないか！！」"},
{"id": 600, "speaker": 29, "form": "dlg", "jp": "「どう、実感わいてきた？」"},
{"id": 601, "speaker": 29, "form": "choice", "jp": "「ああ、実感アリアリ！」"},
{"id": 602, "speaker": 29, "form": "choice", "jp": "「まあ、なんとなく‥‥」"},
{"id": 603, "speaker": 29, "form": "choice", "jp": "「まだ、なんとも‥‥」"},
{"id": 604, "speaker": 2, "form": "dlg", "jp": "「ああ、実感アリアリ！」"},
{"id": 605, "speaker": 29, "form": "dlg", "jp": "「くれぐれも『能力』を悪用しないでよ！」"},
{"id": 606, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 607, "speaker": 2, "form": "dlg", "jp": "「まあ、なんとなく‥‥」"},
{"id": 608, "speaker": 29, "form": "dlg", "jp": "「そうね、今はそれぐらいで十分だわ‥‥」"},
{"id": 609, "speaker": 29, "form": "dlg", "jp": "「くれぐれも『能力』を悪用しないでよ！」"},
{"id": 610, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 611, "speaker": 2, "form": "dlg", "jp": "「まだ、なんとも‥‥」"},
{"id": 612, "speaker": 29, "form": "dlg", "jp": "「そうね、今はそれぐらいで十分だわ‥‥」"},
{"id": 613, "speaker": 29, "form": "dlg", "jp": "「くれぐれも『能力』を悪用しないでよ！」"},
{"id": 614, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 615, "speaker": 29, "form": "dlg", "jp": "「いけない、誰かこっちにくるわ！」"},
{"id": 616, "speaker": 31, "form": "dlg", "jp": "「物わかりが悪いから、説明に時間をとりすぎたな‥‥」"},
{"id": 617, "speaker": 29, "form": "dlg", "jp": "「とりあえず、これでいったん解散よ！」"},
{"id": 618, "speaker": 2, "form": "dlg", "jp": "「待って、まだわからないことだらけ‥‥」"},
{"id": 619, "speaker": 29, "form": "dlg", "jp": "「そのうち説明してあげるわ」"},
{"id": 620, "speaker": 29, "form": "dlg", "jp": "「それから、このことは誰にも話しちゃダメよ！」"},
{"id": 621, "speaker": 29, "form": "dlg", "jp": "「誰かにバラしたらその時も‥‥」"},
{"id": 622, "speaker": 2, "form": "dlg", "jp": "「わかったよ！！」"},
{"id": 623, "speaker": 29, "form": "dlg", "jp": "「じゃあね！」"},
{"id": 624, "speaker": 29, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 625, "speaker": 31, "form": "dlg", "jp": "「バーイ！！」"},
{"id": 626, "speaker": 31, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 627, "speaker": 2, "form": "dlg", "jp": "「オイ、待ってよ‥‥」"},
{"id": 628, "speaker": 2, "form": "dlg", "jp": "２人はそのまま走り去った。"},
{"id": 629, "speaker": 2, "form": "dlg", "jp": "（『超能力』か‥‥）"},
{"id": 630, "speaker": 2, "form": "dlg", "jp": "ボクは釈然としないまま、家に帰ることにした。"},
{"id": 631, "speaker": 3, "form": "dlg", "jp": "「ナゴム！」"},
{"id": 632, "speaker": 2, "form": "dlg", "jp": "「姉さん‥‥」"},
{"id": 633, "speaker": 26, "form": "dlg", "jp": "「こんなところで何してるんですか？」"},
{"id": 634, "speaker": 2, "form": "dlg", "jp": "「三田さんまで‥‥」"},
{"id": 635, "speaker": 26, "form": "dlg", "jp": "「プールに行ったんじゃぁ？」"},
{"id": 636, "speaker": 2, "form": "dlg", "jp": "「ああ、ちょっと寄り道‥‥」"},
{"id": 637, "speaker": 2, "form": "dlg", "jp": "「三田さんは？」"},
{"id": 638, "speaker": 26, "form": "dlg", "jp": "「『通り魔』が心配だから、リツコさんのガードを‥‥」"},
{"id": 639, "speaker": 2, "form": "dlg", "jp": "「ふ～ん」"},
{"id": 640, "speaker": 2, "form": "dlg", "jp": "失敗の原因は『運命』に逆らったこと‥‥\n誰も運命に逆らうことはできない\n時には流れに身を任せることも必要"},
{"id": 641, "speaker": 2, "form": "dlg", "jp": "失敗の原因はとっさの判断ができなかったこと‥‥\nもっと自分の力に自信をもって行動するように"}
]
