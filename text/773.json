[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０７／２３／ＰＭ０２：５０"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "「バタン！」"},
{"id": 3, "speaker": 3, "form": "dlg", "jp": "「お客さんは帰ったの？」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「ああ、たった今‥‥」"},
{"id": 5, "speaker": 3, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「で、『シロー』は‥‥」"},
{"id": 7, "speaker": 3, "form": "dlg", "jp": "「ダメ、ぜんぜん話させてくれない‥‥」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「話させてくれないって‥‥？」"},
{"id": 9, "speaker": 3, "form": "dlg", "jp": "「今、シローは不安定だから、\n　これ以上問い詰めると"},
{"id": 10, "speaker": 3, "form": "dlg", "jp": "『暴走』"},
{"id": 11, "speaker": 3, "form": "dlg", "jp": "するかもって‥‥」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「『暴走』ねぇ‥‥」"},
{"id": 13, "speaker": 3, "form": "dlg", "jp": "「このままじゃあ『シロー』、\n　分解されちゃうんじゃあ‥‥」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「『分解』！？」"},
{"id": 15, "speaker": 3, "form": "dlg", "jp": "「そこまでしてでも\n　『父さんの情報』が欲しいでしょうから‥‥」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「でも‥‥‥」"},
{"id": 17, "speaker": 3, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 18, "speaker": 3, "form": "dlg", "jp": "「コン、コン」"},
{"id": 19, "speaker": 3, "form": "dlg", "jp": "「ハイッ！」"},
{"id": 20, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 21, "speaker": 3, "form": "dlg", "jp": "「バタン！」"},
{"id": 22, "speaker": 11, "form": "dlg", "jp": "「失礼します！」"},
{"id": 23, "speaker": 3, "form": "dlg", "jp": "「何か‥‥？」"},
{"id": 24, "speaker": 11, "form": "dlg", "jp": "「いや、私が説明するには難しすぎる話なんで‥‥」"},
{"id": 25, "speaker": 23, "form": "dlg", "jp": "「すみません、ワタシの方から‥‥」"},
{"id": 26, "speaker": 23, "form": "dlg", "jp": "「実は例の『アンドロイド』のプログラムに\n　ついてなんですが‥‥」"},
{"id": 27, "speaker": 3, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 28, "speaker": 23, "form": "dlg", "jp": "「データの呼び出しの"},
{"id": 29, "speaker": 23, "form": "dlg", "jp": "プロテクトの\n　解除方法"},
{"id": 30, "speaker": 23, "form": "dlg", "jp": "をお教えいただきたいのですが‥‥」"},
{"id": 31, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 32, "speaker": 3, "form": "dlg", "jp": "『プロテクト』"},
{"id": 33, "speaker": 3, "form": "dlg", "jp": "！？」"},
{"id": 34, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 35, "speaker": 3, "form": "dlg", "jp": "『プロテクト』"},
{"id": 36, "speaker": 3, "form": "dlg", "jp": "なんてかけていませんが‥‥」"},
{"id": 37, "speaker": 23, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 38, "speaker": 23, "form": "dlg", "jp": "「しかし、実際データを直接読み出そうとすると、\n　"},
{"id": 39, "speaker": 23, "form": "dlg", "jp": "『防御プログラム』"},
{"id": 40, "speaker": 23, "form": "dlg", "jp": "が起動して‥‥」"},
{"id": 41, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 42, "speaker": 3, "form": "dlg", "jp": "『防御プログラム』"},
{"id": 43, "speaker": 3, "form": "dlg", "jp": "？」"},
{"id": 44, "speaker": 3, "form": "dlg", "jp": "「そんなもの『シロー』には‥‥」"},
{"id": 45, "speaker": 21, "form": "dlg", "jp": "「"},
{"id": 46, "speaker": 21, "form": "dlg", "jp": "『自己防衛』"},
{"id": 47, "speaker": 21, "form": "dlg", "jp": "ね‥‥」"},
{"id": 48, "speaker": 3, "form": "dlg", "jp": "「‥‥‥！？」"},
{"id": 49, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 50, "speaker": 3, "form": "dlg", "jp": "「バタン！」"},
{"id": 51, "speaker": 21, "form": "dlg", "jp": "「失礼するわよ‥‥」"},
{"id": 52, "speaker": 11, "form": "dlg", "jp": "「『自己防衛』って‥‥」"},
{"id": 53, "speaker": 21, "form": "dlg", "jp": "「アナタは自分の日記が\n　人に見られそうになったらどうする‥‥？」"},
{"id": 54, "speaker": 11, "form": "dlg", "jp": "「そりゃ、抵抗しますよ！」"},
{"id": 55, "speaker": 21, "form": "dlg", "jp": "「それと、同じこと‥‥」"},
{"id": 56, "speaker": 21, "form": "dlg", "jp": "「彼は今、自分の頭の中が\n　のぞき見されようとしている‥‥」"},
{"id": 57, "speaker": 11, "form": "dlg", "jp": "「だから、抵抗していると‥‥」"},
{"id": 58, "speaker": 21, "form": "dlg", "jp": "「たぶん大袈裟なプログラムでもなんでもなくって、\n　単純に『感情』がジャマをしているんじゃぁ‥‥」"},
{"id": 59, "speaker": 23, "form": "dlg", "jp": "「そうかもしれませんねぇ‥‥」"},
{"id": 60, "speaker": 11, "form": "dlg", "jp": "「じゃあ、彼のデータを取り出すには？」"},
{"id": 61, "speaker": 21, "form": "dlg", "jp": "「彼の『感情』を取り除かないと‥‥」"},
{"id": 62, "speaker": 21, "form": "dlg", "jp": "「とりあえず、彼の『所有者』は\n　目の前にいるんだから」"},
{"id": 63, "speaker": 21, "form": "dlg", "jp": "「彼の感情を取り除くことの『許可』を\n　もらいましょう」"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "（なんてヒドイこと言ってるんだこの人は！）"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "（『感情を取り除く』って『シロー』を\n　ただの『機械』にしちゃうってことじゃないのか！）"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "（それって、つまり‥‥）"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "（『シロー』を‥‥）"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "（『殺す』‥‥！！）"},
{"id": 69, "speaker": 3, "form": "dlg", "jp": "「『許可』できません！」"},
{"id": 70, "speaker": 3, "form": "dlg", "jp": "「そんな人殺しみたいなこと‥‥」"},
{"id": 71, "speaker": 21, "form": "dlg", "jp": "「『人』じゃないでしょう‥‥？」"},
{"id": 72, "speaker": 21, "form": "dlg", "jp": "「とりあえず『データ』を抜き出すだけ‥‥」"},
{"id": 73, "speaker": 21, "form": "dlg", "jp": "「その後でまたプログラムを造り直せば‥‥」"},
{"id": 74, "speaker": 21, "form": "choice", "jp": "「そうか、そうだよね！」"},
{"id": 75, "speaker": 21, "form": "choice", "jp": "「いや、それじゃあ、別人になってしまう！」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「そうか、そうだよね！」"},
{"id": 77, "speaker": 3, "form": "dlg", "jp": "「だまされちゃダメよ、ナゴム！」"},
{"id": 78, "speaker": 3, "form": "dlg", "jp": "「新しくプログラムを載せ直したら、\n　シローは今のシローじゃなくなっちゃう！」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「いや、それじゃあ、別人になってしまう！」"},
{"id": 80, "speaker": 3, "form": "dlg", "jp": "「そうよ！」"},
{"id": 81, "speaker": 3, "form": "dlg", "jp": "「新しくプログラムを載せ直したら、\n　シローは今のシローじゃあなくなっちゃう！」"},
{"id": 82, "speaker": 21, "form": "dlg", "jp": "「アナタたち、どうかしているわ‥‥」"},
{"id": 83, "speaker": 21, "form": "dlg", "jp": "「自分の父親のことを考えずに、\n　『プログラム』の心配なんかして‥‥」"},
{"id": 84, "speaker": 21, "form": "dlg", "jp": "「ドクタージョウコウジは狙われているのよ！」"},
{"id": 85, "speaker": 21, "form": "dlg", "jp": "「そして、\n　あのプログラムはその居場所を隠している‥‥」"},
{"id": 86, "speaker": 21, "form": "dlg", "jp": "「それでもアナタたちは\n　プログラムを守るのですか‥‥」"},
{"id": 87, "speaker": 21, "form": "choice", "jp": "「父さんの方が大事に決まってる！」"},
{"id": 88, "speaker": 21, "form": "choice", "jp": "「どちらが大事とも言えない‥‥」"},
{"id": 89, "speaker": 21, "form": "choice", "jp": "「バックアップを取らせてもらえば‥‥」"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "「父さんの方が大事に決まってる！」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「そうだろ、姉さん‥‥」"},
{"id": 92, "speaker": 3, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 93, "speaker": 3, "form": "dlg", "jp": "「そうだけど‥‥‥」"},
{"id": 94, "speaker": 3, "form": "dlg", "jp": "「彼は命の恩人なんです‥‥‥」"},
{"id": 95, "speaker": 21, "form": "dlg", "jp": "「でも、単なるプログラムよ！」"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "「どちらが大事とも言えない‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「『シロー』は命の恩人なんだし‥‥」"},
{"id": 98, "speaker": 3, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 99, "speaker": 21, "form": "dlg", "jp": "「でも、単なるプログラムよ！」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "「バックアップを取らせてもらえば‥‥」"},
{"id": 101, "speaker": 21, "form": "dlg", "jp": "「データが抜き取れないのに\n　バックアップがとれるわけないでしょう‥‥」"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 103, "speaker": 3, "form": "dlg", "jp": "「彼は命の恩人なんです‥‥‥」"},
{"id": 104, "speaker": 21, "form": "dlg", "jp": "「でも、単なるプログラムよ！」"},
{"id": 105, "speaker": 21, "form": "dlg", "jp": "「だいたい、アナタは\n　どうしてあんな危険なものを造ったの？」"},
{"id": 106, "speaker": 3, "form": "dlg", "jp": "「危険だなんて‥‥」"},
{"id": 107, "speaker": 11, "form": "dlg", "jp": "「たしかに、素手でサイボーグを倒せるなんて‥‥」"},
{"id": 108, "speaker": 3, "form": "dlg", "jp": "「それは父が、私達を守るために‥‥」"},
{"id": 109, "speaker": 21, "form": "dlg", "jp": "「違うわっ！」"},
{"id": 110, "speaker": 21, "form": "dlg", "jp": "「プログラムだけでも十分に危険よ！」"},
{"id": 111, "speaker": 21, "form": "dlg", "jp": "「人間と同じ考えを持つ人間じゃないものなんて‥‥」"},
{"id": 112, "speaker": 21, "form": "dlg", "jp": "「あのまま放って置けば、\n　『暴走』するのは目に見えているでしょう？」"},
{"id": 113, "speaker": 21, "form": "dlg", "jp": "「人間と同じなのに人間じゃない。\n　自分がそんな立場に置かれたらどう思う？」"},
{"id": 114, "speaker": 21, "form": "choice", "jp": "「そんなこと考えたことなかった‥‥」"},
{"id": 115, "speaker": 21, "form": "choice", "jp": "「たしかに、おかしくなりそうだ‥‥」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「そんなこと考えたことなかった‥‥」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「姉さんは？」"},
{"id": 118, "speaker": 3, "form": "dlg", "jp": "「『シロー』は『暴走』なんてしません！」"},
{"id": 119, "speaker": 3, "form": "dlg", "jp": "「そのために情緒教育を‥‥」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「たしかに、おかしくなりそうだ‥‥」"},
{"id": 121, "speaker": 3, "form": "dlg", "jp": "「『シロー』は『暴走』なんてしません！」"},
{"id": 122, "speaker": 3, "form": "dlg", "jp": "「そのために情緒教育を‥‥」"},
{"id": 123, "speaker": 21, "form": "dlg", "jp": "「『所有者の思い通りにならないプログラム』‥‥」"},
{"id": 124, "speaker": 21, "form": "dlg", "jp": "「暴走しているも、同じことね‥‥」"},
{"id": 125, "speaker": 3, "form": "dlg", "jp": "「それは‥‥」"},
{"id": 126, "speaker": 21, "form": "dlg", "jp": "「彼の自我がどんどん大きくなっていってるのでは？」"},
{"id": 127, "speaker": 21, "form": "dlg", "jp": "「もう一度、同じ質問をさせてもらうわ‥‥」"},
{"id": 128, "speaker": 21, "form": "dlg", "jp": "「どうしてあんな危険な『プログラム』を造ったの？」"},
{"id": 129, "speaker": 3, "form": "dlg", "jp": "「私はただ‥‥」"},
{"id": 130, "speaker": 21, "form": "dlg", "jp": "「ただ‥‥？」"},
{"id": 131, "speaker": 3, "form": "dlg", "jp": "「人の役にたちたかっただけです」"},
{"id": 132, "speaker": 21, "form": "dlg", "jp": "「あんなものが役に立つと？」"},
{"id": 133, "speaker": 3, "form": "dlg", "jp": "「人間と同じ考え方のできるプログラムがあれば、\n　ワープロの文字変換や、その他にも‥‥」"},
{"id": 134, "speaker": 3, "form": "dlg", "jp": "「いろいろ、人間にやさしい機械が‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「実際、ボクたちを助けてくれたし‥‥」"},
{"id": 136, "speaker": 21, "form": "dlg", "jp": "「でも、父親の居場所は教えてくれないわよ‥‥」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 138, "speaker": 21, "form": "dlg", "jp": "「ハッキリとわかってもらいたいですね。\n　この事件には世界的な犯罪組織が絡んでいて」"},
{"id": 139, "speaker": 21, "form": "dlg", "jp": "「一刻も早く解決しないと、\n　世界中の人々が困るってことを！」"},
{"id": 140, "speaker": 21, "form": "dlg", "jp": "「わかりました、もう『許可』はいりません！」"},
{"id": 141, "speaker": 21, "form": "dlg", "jp": "「強制的にあのプログラムを排除します！」"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「そんなぁ～」"},
{"id": 143, "speaker": 21, "form": "dlg", "jp": "「これ以上、捜査のジャマをするようなら\n　『公務シッコウ妨害』で逮捕させてもらいます」"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って下さい！」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「そんなのムチャクチャすぎます！」"},
{"id": 146, "speaker": 21, "form": "dlg", "jp": "「アナタたちは機械と人間とどっちが大切なの？」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 148, "speaker": 3, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 149, "speaker": 3, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 150, "speaker": 21, "form": "dlg", "jp": "「‥‥‥？」"},
{"id": 151, "speaker": 3, "form": "dlg", "jp": "「今日、１日だけ時間をください‥‥」"},
{"id": 152, "speaker": 21, "form": "dlg", "jp": "「どうするつもり？」"},
{"id": 153, "speaker": 3, "form": "dlg", "jp": "「心の整理をさせてください」"},
{"id": 154, "speaker": 21, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 155, "speaker": 21, "form": "dlg", "jp": "「明日までユウヨを与えます」"},
{"id": 156, "speaker": 3, "form": "dlg", "jp": "「ありがとうございます‥‥」"},
{"id": 157, "speaker": 3, "form": "dlg", "jp": "こうして『シロー』についての問題は、\n１日ユウヨがもらえることになった。"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「姉さん‥‥」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "「本当にいいの？」"},
{"id": 160, "speaker": 3, "form": "dlg", "jp": "「いいわけないでしょう」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「じゃあ、どうして‥‥」"},
{"id": 162, "speaker": 3, "form": "dlg", "jp": "「時間稼ぎよ‥‥」"},
{"id": 163, "speaker": 3, "form": "dlg", "jp": "「ああでも言わないと、本当にシローは‥‥」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「でも、明日になれば結局‥‥」"},
{"id": 165, "speaker": 3, "form": "dlg", "jp": "「それまでになんとか手を打つのよ！」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "「手を打つ？」"},
{"id": 167, "speaker": 3, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 168, "speaker": 3, "form": "dlg", "jp": "「シローが殺されなくてすむ方法を‥‥」"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "「う～～～～～ん」"},
{"id": 170, "speaker": 3, "form": "dlg", "jp": "「とにかく、父さんの居場所さえわかれば‥‥」"},
{"id": 171, "speaker": 3, "form": "choice", "jp": "「ボクたちで見つけ出そうよ！」"},
{"id": 172, "speaker": 3, "form": "choice", "jp": "「簡単には見つからないだろうね」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「簡単には見つからないだろうね」"},
{"id": 174, "speaker": 3, "form": "dlg", "jp": "「そ、そうだけど‥‥」"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "「素直にシローを説得するっていうのはどう？」"},
{"id": 176, "speaker": 3, "form": "dlg", "jp": "「多分ダメね‥‥」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「どうして？」"},
{"id": 178, "speaker": 3, "form": "dlg", "jp": "「シローは『命令が絶対』だから‥‥」"},
{"id": 179, "speaker": 3, "form": "dlg", "jp": "「これ以上追い詰めると『暴走』するかも‥‥」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 181, "speaker": 2, "form": "choice", "jp": "「やっぱり、父さんを見つけるしか‥‥」"},
{"id": 182, "speaker": 2, "form": "choice", "jp": "「でも、シローを説得するしか‥‥」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「ボクたちで見つけ出そうよ！」"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「シローが教えてくれない以上」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "「やっぱり、父さんを見つけるしか‥‥」"},
{"id": 186, "speaker": 3, "form": "dlg", "jp": "「そ、そうよね！！」"},
{"id": 187, "speaker": 3, "form": "dlg", "jp": "ボクたちは自力で父さんの居場所を見つけることにした。"},
{"id": 188, "speaker": 3, "form": "dlg", "jp": "「問題は警察がどこまで父さんのことを\n　調べたかよね‥‥」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「可能なかぎり、調べてるだろうね？」"},
{"id": 190, "speaker": 3, "form": "dlg", "jp": "「本当にそう思う？」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 192, "speaker": 3, "form": "dlg", "jp": "「警察はいろいろ調べなくても、\n　私たちを見張っていれば」"},
{"id": 193, "speaker": 3, "form": "dlg", "jp": "「そのウチ父さんが見つかると思っているかも‥‥」"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "「それはないだろう？」"},
{"id": 195, "speaker": 3, "form": "dlg", "jp": "「でも、実際‥‥」"},
{"id": 196, "speaker": 3, "form": "dlg", "jp": "「あの夜まで、警察は私たちにさえ、\n　父さんの居場所を聞かなかったし‥‥」"},
{"id": 197, "speaker": 3, "form": "dlg", "jp": "「父さんの部屋とかも全然調べてないでしょう？」"},
{"id": 198, "speaker": 3, "form": "dlg", "jp": "「もしかしたら、日記とかに\n　何か記されているかもしれないのに‥‥」"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "「そう言えばそうだね」"},
{"id": 200, "speaker": 3, "form": "dlg", "jp": "「だから、警察がちゃんと調べてないことが\n　あると思うの‥‥」"},
{"id": 201, "speaker": 3, "form": "choice", "jp": "「職場とか調べたのかな？」"},
{"id": 202, "speaker": 3, "form": "choice", "jp": "「親戚の所とか調べたのかな？」"},
{"id": 203, "speaker": 3, "form": "choice", "jp": "「日記とか調べたのかな？」"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "「職場とか調べたのかな？」"},
{"id": 205, "speaker": 3, "form": "dlg", "jp": "「問い合わせはしたみたいね‥‥」"},
{"id": 206, "speaker": 3, "form": "dlg", "jp": "「ただ‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「ただ？」"},
{"id": 208, "speaker": 3, "form": "dlg", "jp": "「父さんがああ言う人だから‥‥」"},
{"id": 209, "speaker": 3, "form": "dlg", "jp": "「学校の方も、どこに行ったのか\n　全然気にしていないみたいなの‥‥」"},
{"id": 210, "speaker": 3, "form": "choice", "jp": "「親戚の所とか調べたのかな？」"},
{"id": 211, "speaker": 3, "form": "choice", "jp": "「日記とか調べたのかな？」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "「親戚の所とか調べたのかな？」"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "「オジさんの所とか‥‥」"},
{"id": 214, "speaker": 3, "form": "dlg", "jp": "「それは前に刑事さんに聞かれたから\n　さすがに調べたみたいよ‥‥」"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "「じゃあ、そこからは\n　手がかりは出なかったんだね‥‥」"},
