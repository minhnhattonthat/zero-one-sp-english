[
{"id": 0, "speaker": null, "form": "dlg", "jp": "ボクたちは演習が終わるまで、\nここで演習を見学することにした。"},
{"id": 1, "speaker": 31, "form": "dlg", "jp": "「オイ、始まるぞ！」"},
{"id": 2, "speaker": 31, "form": "dlg", "jp": "「ハハハハ‥‥」"},
{"id": 3, "speaker": 31, "form": "dlg", "jp": "「コイツはスゲーや！！」"},
{"id": 4, "speaker": 31, "form": "dlg", "jp": "「日本の軍隊はサイコー！！」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "「‥‥だから、軍じゃないんだって！」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「この国は戦争を放棄してるんだよ！！」"},
{"id": 7, "speaker": 31, "form": "dlg", "jp": "「戦争しないのにあんな兵器いらないじゃん！」"},
{"id": 8, "speaker": 31, "form": "dlg", "jp": "「まあ、いいけど‥‥」"},
{"id": 9, "speaker": 31, "form": "dlg", "jp": "「オレの税金じゃないから」"},
{"id": 10, "speaker": 31, "form": "dlg", "jp": "「で、どう思う？」"},
{"id": 11, "speaker": 31, "form": "dlg", "jp": "「アイツ、仲間になるかなぁ？」"},
{"id": 12, "speaker": 31, "form": "choice", "jp": "「なってくれるんじゃぁ？」"},
{"id": 13, "speaker": 31, "form": "choice", "jp": "「ならないんじゃぁ？」"},
{"id": 14, "speaker": 31, "form": "choice", "jp": "「わかんないよ！」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「なってくれるんじゃぁ？」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「ならないんじゃぁ？」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「わかんないよ！」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「悪い人では、なさそうだけど‥‥」"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "「本人は気付いていないけど、\n　スゴイ能力の持ち主だから」"},
{"id": 20, "speaker": 29, "form": "dlg", "jp": "「何がなんでも仲間になってもらわないと‥‥」"},
{"id": 21, "speaker": 29, "form": "choice", "jp": "【ジーンと話す】"},
{"id": 22, "speaker": 29, "form": "choice", "jp": "【ケネスと話す】"},
{"id": 23, "speaker": 29, "form": "dlg", "jp": "【ジーンと話す】"},
{"id": 24, "speaker": 29, "form": "choice", "jp": "【松尾さんのこと】"},
{"id": 25, "speaker": 29, "form": "choice", "jp": "【ゲーマーのこと】"},
{"id": 26, "speaker": 29, "form": "dlg", "jp": "【松尾さんのこと】"},
{"id": 27, "speaker": 29, "form": "dlg", "jp": "ボクはジーンと松尾さんのことを話した。"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「やっぱ、テレポーテーションってスゴイの？」"},
{"id": 29, "speaker": 29, "form": "dlg", "jp": "「スゴイわね‥‥」"},
{"id": 30, "speaker": 29, "form": "dlg", "jp": "「私たちの組織にはまだ１０人ぐらいしか\n　その能力を持った者はいないわ‥‥」"},
{"id": 31, "speaker": 29, "form": "dlg", "jp": "【ゲーマーのこと】"},
{"id": 32, "speaker": 29, "form": "dlg", "jp": "ボクはジーンとゲーマーのことを話した。"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「早く仲間を集めないと、\n　ゲーマーとの戦いに間に合わないかも‥‥」"},
{"id": 34, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 35, "speaker": 29, "form": "dlg", "jp": "「彼がすんなり仲間になってくれると\n　有り難いんだけど‥‥」"},
{"id": 36, "speaker": 29, "form": "dlg", "jp": "【ケネスと話す】"},
{"id": 37, "speaker": 29, "form": "choice", "jp": "【松尾さんのこと】"},
{"id": 38, "speaker": 29, "form": "choice", "jp": "【ゲーマーのこと】"},
{"id": 39, "speaker": 29, "form": "dlg", "jp": "【松尾さんのこと】"},
{"id": 40, "speaker": 29, "form": "dlg", "jp": "ボクはケネスと松尾さんのことを話した。"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「やっぱ、テレポーテーションってスゴイの？」"},
{"id": 42, "speaker": 31, "form": "dlg", "jp": "「スゴイね‥‥」"},
{"id": 43, "speaker": 31, "form": "dlg", "jp": "「オレたちの組織には何人もいないな‥‥」"},
{"id": 44, "speaker": 31, "form": "dlg", "jp": "【ゲーマーのこと】"},
{"id": 45, "speaker": 31, "form": "dlg", "jp": "ボクはケネスとゲーマーのことを話した。"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「早く仲間を集めないと、\n　ゲーマーとの戦いに間に合わないかも‥‥」"},
{"id": 47, "speaker": 31, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 48, "speaker": 31, "form": "dlg", "jp": "「アイツがすんなり仲間になってくれると\n　有り難いんだけど‥‥」"},
{"id": 49, "speaker": 29, "form": "dlg", "jp": "「それより‥‥」"},
{"id": 50, "speaker": 29, "form": "dlg", "jp": "「さっきから、イヤな感覚を感じるの‥‥」"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "「イヤな感覚って‥‥？」"},
{"id": 52, "speaker": 29, "form": "dlg", "jp": "「わからない！」"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "「能力のせいで、色んなものが見えたり\n　聞こえたりするけど」"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "「それが何なのかわからないことがたまにあるの‥‥」"},
{"id": 55, "speaker": 31, "form": "dlg", "jp": "「オイ、見てみろ！！」"},
{"id": 56, "speaker": 31, "form": "dlg", "jp": "「なんか様子がおかしいぞ！」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "「何っ！？」"},
{"id": 58, "speaker": 2, "form": "choice", "jp": "「スゴイパワーだな～」"},
{"id": 59, "speaker": 2, "form": "choice", "jp": "「スゴイ演習してるんだ‥‥」"},
{"id": 60, "speaker": 2, "form": "choice", "jp": "「本当に演習？」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "「スゴイパワーだな～」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "「スゴイ演習してるんだ‥‥」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「本当に演習？」"},
{"id": 64, "speaker": 29, "form": "dlg", "jp": "「なにノンキなことを言ってるの！」"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "「アレがエンシュウやクンレンに見える！？」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「じゃぁ‥‥」"},
{"id": 67, "speaker": 2, "form": "choice", "jp": "「暴走！？」"},
{"id": 68, "speaker": 2, "form": "choice", "jp": "「クーデター！？」"},
{"id": 69, "speaker": 2, "form": "choice", "jp": "「デモンストレーション！？」"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "「クーデター！？」"},
{"id": 71, "speaker": 31, "form": "dlg", "jp": "「クーデターが\n　起こりそうな雰囲気はあったのか？」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "「う～ん‥‥」"},
{"id": 73, "speaker": 2, "form": "choice", "jp": "「あんまり新聞読まないからな～」"},
{"id": 74, "speaker": 2, "form": "choice", "jp": "「カルト教団とか‥‥」"},
{"id": 75, "speaker": 2, "form": "choice", "jp": "「政府に不満のある国民は多いと‥‥」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「あんまり新聞読まないからな～」"},
{"id": 77, "speaker": 31, "form": "dlg", "jp": "「なんだそりゃ？」"},
{"id": 78, "speaker": 31, "form": "dlg", "jp": "「この国の未来をしょって立つ子供がそんなんなら、\n　クーデターもありうるよな‥‥」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「カルト教団とか‥‥」"},
{"id": 80, "speaker": 31, "form": "dlg", "jp": "「いくらスゴイ兵器だって、あれ１つ盗んだぐらいで\n　クーデターは成功しないだろうに‥‥」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「政府に不満のある国民は多いと‥‥」"},
{"id": 82, "speaker": 31, "form": "dlg", "jp": "「何が不満なんだ？」"},
{"id": 83, "speaker": 31, "form": "dlg", "jp": "「ほとんどの家に水道があって、\n　電気があって、テレビがあって」"},
{"id": 84, "speaker": 31, "form": "dlg", "jp": "「ビデオがあって、ゲーム機があって、\n　子供は学校に行くことが出来て‥‥」"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "「デモンストレーション！？」"},
{"id": 86, "speaker": 31, "form": "dlg", "jp": "「デモンストレーションで、あんな新品の戦車壊すのか？」"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "「それじゃあ‥‥」"},
{"id": 88, "speaker": 2, "form": "choice", "jp": "「暴走！？」"},
{"id": 89, "speaker": 2, "form": "choice", "jp": "「クーデター！？」"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "「暴走！？」"},
{"id": 91, "speaker": 31, "form": "dlg", "jp": "「暴走って誰の？」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「だから‥‥」"},
{"id": 93, "speaker": 2, "form": "choice", "jp": "「隊員が‥‥」"},
{"id": 94, "speaker": 2, "form": "choice", "jp": "「ロボットが‥‥」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「隊員が‥‥」"},
{"id": 96, "speaker": 31, "form": "dlg", "jp": "「‥‥それって、\n　クーデターって言うんじゃないのか？」"},
{"id": 97, "speaker": 31, "form": "dlg", "jp": "「なんか、イヤな場面にでくわしちゃったな‥‥」"},
{"id": 98, "speaker": 31, "form": "dlg", "jp": "「もしかして、さっきのマツオってヤツが\n　暴れてるんだったりして‥‥」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「ロボットが‥‥」"},
{"id": 100, "speaker": 31, "form": "dlg", "jp": "「おい、ホントかよ！？」"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "「とりあえず、さっきの彼をもう一度呼び出して\n　話を聞きましょう！！」"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「今ならどさくさで抜け出せそうだし‥‥」"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "ボクたちは松尾さんをもう一度呼び出すことにした。"},
{"id": 105, "speaker": 35, "form": "dlg", "jp": "「大変だよぉ～～」"},
{"id": 106, "speaker": 31, "form": "dlg", "jp": "「オイ、どうしたんだ？」"},
{"id": 107, "speaker": 35, "form": "dlg", "jp": "「あの『新兵器』が『暴走』しちゃったんだよ！」"},
{"id": 108, "speaker": 29, "form": "dlg", "jp": "「やっぱり！！」"},
{"id": 109, "speaker": 35, "form": "dlg", "jp": "「昨日まではちゃんと動いてたのに‥‥」"},
{"id": 110, "speaker": 31, "form": "dlg", "jp": "「プログラムミスか？」"},
{"id": 111, "speaker": 29, "form": "dlg", "jp": "「そうじゃないわね‥‥」"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "「あの動作を見る限り、\n　デタラメに動いているというより」"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "「明確に目的をもって破壊をしているわ‥‥」"},
{"id": 114, "speaker": 31, "form": "dlg", "jp": "「じゃぁ？」"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "「誰かにコントロールされてるのかも‥‥」"},
{"id": 116, "speaker": 31, "form": "dlg", "jp": "「誰かって？」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "（まさか！！）"},
{"id": 118, "speaker": 2, "form": "choice", "jp": "（シロー‥‥！！）"},
{"id": 119, "speaker": 2, "form": "choice", "jp": "（ゲーマー‥‥！！）"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "（シロー‥‥！！）"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "（米軍の人工衛星を乗っ取ったように、\n　このロボットを‥‥）"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "（でも、なんでそんなことを？）"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "（シローが自衛隊を攻撃する理由が思い付かない！！）"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "（ゲーマー‥‥！！）"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "（確かゲーマーは、\n　『人間以外のものを自由に操れる』‥‥）"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "「わかったわっ！」"},
{"id": 127, "speaker": 31, "form": "dlg", "jp": "「何が？」"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "「ゲーマーの仕業よ！！」"},
{"id": 129, "speaker": 31, "form": "dlg", "jp": "「何だって！？」"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "「忘れたの？\n　ゲーマーの能力！！」"},
{"id": 131, "speaker": 29, "form": "dlg", "jp": "「『人間以外のものを自由に操れる』‥‥」"},
{"id": 132, "speaker": 31, "form": "dlg", "jp": "「じゃあ、いよいよゲーマーの攻撃が始まった！？」"},
{"id": 133, "speaker": 29, "form": "dlg", "jp": "「さっきのイヤな感覚の正体はこれだったのよ！」"},
{"id": 134, "speaker": 35, "form": "dlg", "jp": "「あの‥‥」"},
{"id": 135, "speaker": 29, "form": "dlg", "jp": "「何？」"},
{"id": 136, "speaker": 35, "form": "dlg", "jp": "「ゲーマーって誰？」"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "「私たちの戦う相手よ！」"},
{"id": 138, "speaker": 31, "form": "dlg", "jp": "「この際だから、簡単に説明してやるよ！」"},
{"id": 139, "speaker": 31, "form": "dlg", "jp": "ケネスとジーンはボクの時と同じように\n松尾さんに『ゲーマー』と『Ｅ－ｇｒｏ』の説明をした。"},
{"id": 140, "speaker": 35, "form": "dlg", "jp": "「ウソ！？」"},
{"id": 141, "speaker": 35, "form": "dlg", "jp": "「そんなカッコイイチームのメンバーになれるの？」"},
{"id": 142, "speaker": 29, "form": "dlg", "jp": "「あなたさえ良ければ‥‥」"},
{"id": 143, "speaker": 35, "form": "dlg", "jp": "「なるなる‥‥」"},
{"id": 144, "speaker": 35, "form": "dlg", "jp": "「オレは世の中のためになることをするのが夢なんだ！」"},
{"id": 145, "speaker": 35, "form": "dlg", "jp": "「『世の中のため』っていうと究極型だよね」"},
{"id": 146, "speaker": 15, "form": "dlg", "jp": "（ちょっと、私のこと忘れていない！）"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "（忘れてないよ）"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "（どうかしたの？）"},
{"id": 149, "speaker": 15, "form": "dlg", "jp": "（それはコッチのセリフよ！）"},
{"id": 150, "speaker": 15, "form": "dlg", "jp": "（なんだか騒がしくなってるけど、\n　何かあったの？）"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "（ああ、ちょっとね‥‥）"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "（とりあえず、アイコの言った通り、\n　松尾さんはすんなり仲間になってくれそうだよ‥‥）"},
{"id": 153, "speaker": 15, "form": "dlg", "jp": "（そう‥‥）"},
{"id": 154, "speaker": 16, "form": "dlg", "jp": "（ちょっと、アキラのこと忘れていない！）"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "（忘れてないよ）"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "（どうかしたの？）"},
{"id": 157, "speaker": 16, "form": "dlg", "jp": "（それはコッチのセリフよ！）"},
{"id": 158, "speaker": 16, "form": "dlg", "jp": "（なんだか騒がしくなってるけど、\n　何かあったの？）"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "（ああ、ちょっとね‥‥）"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "（とりあえず、長尾の言った通り、\n　松尾さんはすんなり仲間になってくれそうだよ‥‥）"},
{"id": 161, "speaker": 16, "form": "dlg", "jp": "（そう‥‥）"},
{"id": 162, "speaker": 18, "form": "dlg", "jp": "（ちょっとみなさん、\n　私のこと忘れていないですか？）"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "（忘れてないよ）"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "（どうかしたの？）"},
{"id": 165, "speaker": 18, "form": "dlg", "jp": "（なんだか騒がしくなってるけど、\n　何かあったんですか？）"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "（ああ、ちょっとね‥‥）"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "（とりあえず、キミの言った通り、\n　松尾さんはすんなり仲間になってくれそうだよ‥‥）"},
{"id": 168, "speaker": 18, "form": "dlg", "jp": "（そう‥‥）"}
]
