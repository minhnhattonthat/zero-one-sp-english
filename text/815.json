[
{"id": 0, "speaker": null, "form": "dlg", "jp": "あれから、ボクたちはとにかく\n出口を刺激しないように"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "ただ、おとなしく『ジーン』の『回復』を待った。"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "２００５／０８／０５／ＰＭ０４：００"},
{"id": 3, "speaker": 14, "form": "dlg", "jp": "「オイ、オムカエがきたぜ！」"},
{"id": 4, "speaker": 16, "form": "dlg", "jp": "「もう！」"},
{"id": 5, "speaker": 16, "form": "dlg", "jp": "「また、こんなところでゲームなんかして！！」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「長尾‥‥」"},
{"id": 7, "speaker": 13, "form": "dlg", "jp": "「早く行ってやれよ！」"},
{"id": 8, "speaker": 13, "form": "dlg", "jp": "「アイツうるさいんだから‥‥」"},
{"id": 9, "speaker": 16, "form": "dlg", "jp": "「今日はジーンの退院の日でしょう！？」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 11, "speaker": 13, "form": "dlg", "jp": "「フウフゲンカは他でやってくれ！」"},
{"id": 12, "speaker": 16, "form": "dlg", "jp": "「ちょっとどういうイミよ！？」"},
{"id": 13, "speaker": 14, "form": "dlg", "jp": "「そのことは言ってやるな！」"},
{"id": 14, "speaker": 14, "form": "dlg", "jp": "「実はオレもあやしんでるんだが‥‥」"},
{"id": 15, "speaker": 14, "form": "dlg", "jp": "「親友としてはもう少しそっとしておいてやろうと‥‥」"},
{"id": 16, "speaker": 16, "form": "dlg", "jp": "「何勝手なこと言ってるのよ！」"},
{"id": 17, "speaker": 16, "form": "dlg", "jp": "「アキラたちは共通の知り合いが入院してるから\n　いっしょに行動してただけよ‥‥」"},
{"id": 18, "speaker": 14, "form": "dlg", "jp": "「なんだ、そうだったのか？」"},
{"id": 19, "speaker": 16, "form": "dlg", "jp": "「そうよ！」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「今日がその人の退院の日なんだ‥‥」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「悪いけど、ボクたちはコレで‥‥」"},
{"id": 22, "speaker": 14, "form": "dlg", "jp": "「わるかったな‥‥」"},
{"id": 23, "speaker": 14, "form": "dlg", "jp": "ボクたちは『ジーン』たちのホテルに直行した。"},
{"id": 24, "speaker": 14, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 25, "speaker": 14, "form": "dlg", "jp": "「キーンコーンカーンコーン」"},
{"id": 26, "speaker": 14, "form": "dlg", "jp": "「ナゴムが２日も続けてクラブに顔を出すなんて\n　信じられねえな‥‥」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「長尾にムリやりつきあわされてるんだよ！」"},
{"id": 28, "speaker": 14, "form": "dlg", "jp": "「へえ、\n　オマエ、そんなに付き合いのいいヤツだったっけ？」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「なんか、モンクあるの？」"},
{"id": 30, "speaker": 13, "form": "dlg", "jp": "「って言うか、コイツと長尾あやしいんだよ‥‥」"},
{"id": 31, "speaker": 14, "form": "dlg", "jp": "「オイ！」"},
{"id": 32, "speaker": 14, "form": "dlg", "jp": "「そのことは言ってやるな！」"},
{"id": 33, "speaker": 14, "form": "dlg", "jp": "「実はオレもあやしんでるんだが‥‥」"},
{"id": 34, "speaker": 14, "form": "dlg", "jp": "「親友としてはもう少しそっとしておいてやろうと‥‥」"},
{"id": 35, "speaker": 16, "form": "dlg", "jp": "「何勝手なこと言ってるのよ！」"},
{"id": 36, "speaker": 16, "form": "dlg", "jp": "「アキラたちは共通の知り合いが入院してるから\n　いっしょに行動してただけよ‥‥」"},
{"id": 37, "speaker": 14, "form": "dlg", "jp": "「なんだ、そうだったのか？」"},
{"id": 38, "speaker": 16, "form": "dlg", "jp": "「そうよ！」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「今日がその人の退院の日なんだ‥‥」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「悪いけど、ボクたちはコレで‥‥」"},
{"id": 41, "speaker": 14, "form": "dlg", "jp": "「わるかったな‥‥」"},
{"id": 42, "speaker": 14, "form": "dlg", "jp": "ボクたちは着替えをすませ、\n『ジーン』たちのホテルに直行した。"},
{"id": 43, "speaker": 14, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 44, "speaker": 16, "form": "dlg", "jp": "「退院するってことは、もうキズは直ったの？」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「うん、キズはね‥‥」"},
{"id": 46, "speaker": 16, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 47, "speaker": 16, "form": "dlg", "jp": "「それより、ゴメンね‥‥」"},
{"id": 48, "speaker": 16, "form": "dlg", "jp": "「アキラといっしょにいるせいで\n　ヘンなウワサたてられちゃって‥‥」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「大丈夫、気にしてないから‥‥」"},
{"id": 50, "speaker": 16, "form": "dlg", "jp": "「やっぱり、常光寺くんてやさしいんだね‥‥」"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "「ヤメテくれよ‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「テレくさいから‥‥」"},
{"id": 53, "speaker": 50, "form": "dlg", "jp": "「常光寺くん！」"},
{"id": 54, "speaker": 50, "form": "dlg", "jp": "それは間違いなく、『出口エイジ』の声だった‥‥"},
{"id": 55, "speaker": 16, "form": "dlg", "jp": "「何っ！！！」"},
{"id": 56, "speaker": 16, "form": "dlg", "jp": "「よくもまあ、ノコノコと‥‥」"},
{"id": 57, "speaker": 50, "form": "dlg", "jp": "「ちょっと待ってくれよ！」"},
{"id": 58, "speaker": 50, "form": "dlg", "jp": "「ボクもここの住人だぜ？」"},
{"id": 59, "speaker": 50, "form": "dlg", "jp": "「どこを歩こうがボクの勝手だろう？」"},
{"id": 60, "speaker": 16, "form": "dlg", "jp": "「なんですって～～！」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "「やめろよ！」"},
{"id": 62, "speaker": 50, "form": "dlg", "jp": "「で、二人そろってデートかい？」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「まあ、そんなトコだ‥‥」"},
{"id": 64, "speaker": 50, "form": "dlg", "jp": "「じゃあ、あとの二人によろしくね‥‥」"},
{"id": 65, "speaker": 50, "form": "dlg", "jp": "そう言って、出口は立ち去った。"},
{"id": 66, "speaker": 16, "form": "dlg", "jp": "「アッタマ来るわね！」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「気にするなよ！」"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "「とにかく、\n　ジーンの能力が回復するまでのガマンだよ‥‥」"},
{"id": 69, "speaker": 16, "form": "dlg", "jp": "「そ、そうね‥‥」"},
{"id": 70, "speaker": 16, "form": "dlg", "jp": "「ピリリリリーーー」"},
{"id": 71, "speaker": 17, "form": "dlg", "jp": "「よし、今日の練習はここまで！」"},
{"id": 72, "speaker": 14, "form": "dlg", "jp": "「やっと終わったぁ‥‥！」"},
{"id": 73, "speaker": 14, "form": "dlg", "jp": "「やっぱ、夏休みに\n　学校なんか来るんじゃなかったな‥‥」"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "「まあ、ヨソのクラブなんかは\n　毎日朝レンとかあるんだから」"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "「それに比べたら‥‥」"},
{"id": 76, "speaker": 14, "form": "dlg", "jp": "「そうなんだろうけど‥‥」"},
{"id": 77, "speaker": 15, "form": "dlg", "jp": "「アレエ、めずらしい‥‥」"},
{"id": 78, "speaker": 15, "form": "dlg", "jp": "「コレで、２日も連続して\n　２人がクラブに出るなんて！」"},
{"id": 79, "speaker": 14, "form": "dlg", "jp": "「ナゴムにムリやりつきあわされてるんだよ！」"},
{"id": 80, "speaker": 15, "form": "dlg", "jp": "「へえ～　ナゴムちゃんが‥‥」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「なんか、モンクある？」"},
{"id": 82, "speaker": 15, "form": "dlg", "jp": "「モンクは無いわよ、\n　ホメてあげたいぐらいよ！」"},
{"id": 83, "speaker": 14, "form": "dlg", "jp": "「かなり、ナメられてるなオマエ‥‥」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「そう言えば、この夏の大会で引退なんだろう？」"},
{"id": 85, "speaker": 15, "form": "dlg", "jp": "「何言ってるのよ、\n　もう２回戦でとっくに負けちゃったわよ！」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "「ザンネンだったね‥‥」"},
{"id": 88, "speaker": 15, "form": "dlg", "jp": "「気にしてないけどね‥‥」"},
{"id": 89, "speaker": 15, "form": "dlg", "jp": "「もともとウチのチームは弱いから‥‥」"},
{"id": 90, "speaker": 14, "form": "dlg", "jp": "「それなのにまだ練習に出てるのか？」"},
{"id": 91, "speaker": 15, "form": "dlg", "jp": "「後輩の指導をしに来てるんだけど‥‥」"},
{"id": 92, "speaker": 14, "form": "dlg", "jp": "「ケッコウな身分だね‥‥」"},
{"id": 93, "speaker": 15, "form": "dlg", "jp": "「それより、トモちゃんよ‥‥」"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "「小田がどうかしたのか？」"},
{"id": 95, "speaker": 15, "form": "dlg", "jp": "「知らないの？」"},
{"id": 96, "speaker": 15, "form": "dlg", "jp": "「優勝候補だったのに、予選に出なかったんだって‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「ウソッ！」"},
{"id": 98, "speaker": 14, "form": "dlg", "jp": "「なんだ、ナゴムは知らなかったのか？」"},
{"id": 99, "speaker": 14, "form": "dlg", "jp": "「最近、ずっといっしょだったんじゃないのか？」"},
{"id": 100, "speaker": 15, "form": "dlg", "jp": "「そう言えば、\n　この前も２人で私のとこへ来たわね？」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "「なんだよ、その意味ありげな笑い顔は‥‥」"},
{"id": 102, "speaker": 14, "form": "dlg", "jp": "「三船、オマエもあやしいと思うだろう？」"},
{"id": 103, "speaker": 14, "form": "dlg", "jp": "「やっぱ、\n　女ができると付き合いが悪くなるよなぁ」"},
{"id": 104, "speaker": 51, "form": "dlg", "jp": "「えっ、常光寺に女ができたん？」"},
{"id": 105, "speaker": 15, "form": "dlg", "jp": "「トモちゃん！」"},
{"id": 106, "speaker": 14, "form": "dlg", "jp": "「とぼけるなよ！」"},
{"id": 107, "speaker": 14, "form": "dlg", "jp": "「オマエのことに決まってるだろう？」"},
{"id": 108, "speaker": 51, "form": "dlg", "jp": "「ハァ？」"},
{"id": 109, "speaker": 51, "form": "dlg", "jp": "「なんで、ウチが‥‥」"},
{"id": 110, "speaker": 51, "form": "dlg", "jp": "「常光寺、なんとか言うたってよ！」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "「なんか、言い返すのバカらしくて‥‥」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "（ボクたちはみんなのために戦ってるのに‥‥）"},
{"id": 113, "speaker": 15, "form": "dlg", "jp": "「トモちゃんの反応からすると、\n　ぜんぜんそんな関係じゃなさそうね‥‥」"},
{"id": 114, "speaker": 51, "form": "dlg", "jp": "「あたりまえやろう！」"},
{"id": 115, "speaker": 51, "form": "dlg", "jp": "「ウチかって、選ぶ権利があるって！」"},
{"id": 116, "speaker": 51, "form": "dlg", "jp": "なんか、ヘコむよなぁ～"},
{"id": 117, "speaker": 51, "form": "dlg", "jp": "その言い方‥‥"},
{"id": 118, "speaker": 14, "form": "dlg", "jp": "「ワリィ、ワリィ‥‥」"},
{"id": 119, "speaker": 14, "form": "dlg", "jp": "「オマエがナゴムと遊んでいて\n　大会の予選をほっぽり出したって‥‥」"},
{"id": 120, "speaker": 51, "form": "dlg", "jp": "「誰や、そんなつまらんウワサ流してるのは！」"},
{"id": 121, "speaker": 51, "form": "dlg", "jp": "「ウチらは共通の知り合いが入院してるから\n　いっしょに行動してただけや‥‥」"},
{"id": 122, "speaker": 15, "form": "dlg", "jp": "「なんだ、そうだったの？」"},
{"id": 123, "speaker": 51, "form": "dlg", "jp": "「そうや」"},
{"id": 124, "speaker": 15, "form": "dlg", "jp": "「ゴメンなさい‥‥」"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "「今日がその人の退院の日なんだ‥‥」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「悪いけど、ボクたちはコレで‥‥」"},
{"id": 127, "speaker": 14, "form": "dlg", "jp": "「わるかったなぁ」"},
{"id": 128, "speaker": 14, "form": "dlg", "jp": "ボクたちは着替えをすませ、\n『ジーン』たちのホテルに直行した。"},
{"id": 129, "speaker": 14, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 130, "speaker": 51, "form": "dlg", "jp": "「退院するってことは、もうキズは直ったん？」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「うん、キズはね‥‥」"},
{"id": 132, "speaker": 51, "form": "dlg", "jp": "「そうなんや‥‥」"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "「それより、大会出なかったんだね？」"},
{"id": 134, "speaker": 51, "form": "dlg", "jp": "「まあ、ええねん‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「優勝したかもしれないんだろう？」"},
{"id": 136, "speaker": 51, "form": "dlg", "jp": "「だから、ええねん‥‥」"},
{"id": 137, "speaker": 51, "form": "dlg", "jp": "「どうせ、優勝するのわかってるから、\n　出てもしゃあないねん！」"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "「本当にとんでもないことに巻き込まれちゃったね‥‥」"},
{"id": 139, "speaker": 51, "form": "dlg", "jp": "「でも、コッチの方が『真剣勝負』やし\n　ぜんぜんオモシロイわ！」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「そんなもんなんだ」"},
{"id": 141, "speaker": 51, "form": "dlg", "jp": "「それより、ゴメンな‥‥」"},
{"id": 142, "speaker": 51, "form": "dlg", "jp": "「さっきはキツイこと言うて‥‥」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「大丈夫、気にしてないから‥‥」"},
{"id": 144, "speaker": 51, "form": "dlg", "jp": "「ウチな‥‥」"},
{"id": 145, "speaker": 51, "form": "dlg", "jp": "「本当はな‥‥」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 147, "speaker": 51, "form": "dlg", "jp": "「あのなぁ‥‥」"},
{"id": 148, "speaker": 50, "form": "dlg", "jp": "「常光寺くん！」"},
{"id": 149, "speaker": 50, "form": "dlg", "jp": "それは間違いなく、『出口エイジ』の声だった‥‥"},
{"id": 150, "speaker": 51, "form": "dlg", "jp": "「アンタ！！」"},
{"id": 151, "speaker": 51, "form": "dlg", "jp": "「よくもまあ、ノコノコと‥‥」"},
{"id": 152, "speaker": 50, "form": "dlg", "jp": "「ちょっと待ってくれよ！」"},
{"id": 153, "speaker": 50, "form": "dlg", "jp": "「ボクもここの住人だぜ？」"},
{"id": 154, "speaker": 50, "form": "dlg", "jp": "「どこを歩こうがボクの勝手だろう？」"},
{"id": 155, "speaker": 51, "form": "dlg", "jp": "「なんやてぇ～～！」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「やめろよ！」"},
{"id": 157, "speaker": 50, "form": "dlg", "jp": "「で、二人そろってデートかい？」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「まあ、そんなトコだ‥‥」"},
{"id": 159, "speaker": 50, "form": "dlg", "jp": "「じゃあ、あとの二人によろしくね‥‥」"},
{"id": 160, "speaker": 50, "form": "dlg", "jp": "そう言って、出口は立ち去った。"},
{"id": 161, "speaker": 51, "form": "dlg", "jp": "「腹たつ～～～！」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「気にするなよ！」"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「とにかく、\n　ジーンの能力が回復するまでのガマンだよ‥‥」"},
{"id": 164, "speaker": 51, "form": "dlg", "jp": "「そ、そうやね‥‥」"},
{"id": 165, "speaker": 51, "form": "dlg", "jp": "「コン！コン！」"},
{"id": 166, "speaker": 31, "form": "dlg", "jp": "「開いてるよ！」"},
{"id": 167, "speaker": 31, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「オジャマします」"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "「心配かけたわね‥‥」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「退院して大丈夫なの？」"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "「まだ、あんまり\n　目に負担をかけちゃいけないみたいだけど‥‥」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「じゃあ、見えるんだ？」"},
{"id": 173, "speaker": 29, "form": "dlg", "jp": "「まあね‥‥」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「よかった‥‥」"},
{"id": 175, "speaker": 16, "form": "dlg", "jp": "「そうだ！」"},
{"id": 176, "speaker": 16, "form": "dlg", "jp": "「そう言えば、\n　さっきそこでアイツにあったのよ！」"},
{"id": 177, "speaker": 31, "form": "dlg", "jp": "「何っ、ホントか！？」"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 179, "speaker": 16, "form": "dlg", "jp": "「アッタマきちゃう！」"},
{"id": 180, "speaker": 16, "form": "dlg", "jp": "「でも、ジーンの能力が回復してよかった‥‥」"},
{"id": 181, "speaker": 16, "form": "dlg", "jp": "「これでアイツを\n　ギャフンと言わせることができるわね‥‥」"},
{"id": 182, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 183, "speaker": 29, "form": "dlg", "jp": "「早くしないと\n　『タイムリミット』が近付いてるわ‥‥」"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「『タイムリミット』？」"},
{"id": 185, "speaker": 29, "form": "dlg", "jp": "「『ゲーマー』の攻撃が始まりつつあるのよ」"},
{"id": 186, "speaker": 16, "form": "dlg", "jp": "「ウソ！」"},
{"id": 187, "speaker": 29, "form": "dlg", "jp": "「まだ、規模は小さいけど\n　世界中で地震や洪水がひん発し始めているの‥‥」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「じゃあ、この間のヨーロッパの地震も？」"},
{"id": 189, "speaker": 29, "form": "dlg", "jp": "「そうらしいわ‥‥」"},
{"id": 190, "speaker": 16, "form": "dlg", "jp": "「でも、『ゲーマーの力』って、\n　世界を一瞬で滅ぼせるレベルの力だったんじゃ？」"},
{"id": 191, "speaker": 51, "form": "dlg", "jp": "「そう言えば、\n　さっきそこでアイツにあったんよ！」"},
{"id": 192, "speaker": 31, "form": "dlg", "jp": "「何っ、ホントか！？」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 194, "speaker": 51, "form": "dlg", "jp": "「でも、ジーンの能力が回復してよかった‥‥」"},
{"id": 195, "speaker": 51, "form": "dlg", "jp": "「これでアイツを\n　ギャフンと言わせることができるな‥‥」"},
{"id": 196, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 197, "speaker": 29, "form": "dlg", "jp": "「早くしないと\n　『タイムリミット』が近付いてるわ‥‥」"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "「『タイムリミット』？」"},
{"id": 199, "speaker": 29, "form": "dlg", "jp": "「『ゲーマー』の攻撃が始まりつつあるのよ」"},
{"id": 200, "speaker": 51, "form": "dlg", "jp": "「ウソ！」"},
{"id": 201, "speaker": 29, "form": "dlg", "jp": "「まだ、規模は小さいけど\n　世界中で地震や洪水がひん発し始めているの‥‥」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「じゃあ、この間のヨーロッパの地震も？」"},
{"id": 203, "speaker": 29, "form": "dlg", "jp": "「そうらしいわ‥‥」"},
{"id": 204, "speaker": 51, "form": "dlg", "jp": "「でも、『ゲーマーの力』って、\n　世界を一瞬で滅ぼせるレベルの力だったんじゃ？」"},
{"id": 205, "speaker": 29, "form": "dlg", "jp": "「そうよ‥‥」"},
{"id": 206, "speaker": 29, "form": "dlg", "jp": "「ただ、しょせんは『ゲーム』なのよ‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「『ゲーム』？」"},
{"id": 208, "speaker": 31, "form": "dlg", "jp": "「いきなりやっちゃったら楽しみが減るから\n　じわじわと攻撃してるんだな‥‥」"},
{"id": 209, "speaker": 51, "form": "dlg", "jp": "「出口もハラたつけど、\n　『ゲーマー』もハラたつヤツやなぁ～～」"},
{"id": 210, "speaker": 29, "form": "dlg", "jp": "「とにかく、\n　早急に『ノア』をとりかえさないと‥‥」"},
{"id": 211, "speaker": 31, "form": "dlg", "jp": "「まあ、やっと『ジーン』が帰ってきたんだ‥‥」"},
{"id": 212, "speaker": 31, "form": "dlg", "jp": "「これであのコゾウとまともに勝負できる！」"},
{"id": 213, "speaker": 51, "form": "dlg", "jp": "「どうする？　今すぐ行く？」"},
{"id": 214, "speaker": 16, "form": "dlg", "jp": "「出口も頭くるけど、\n　『ゲーマー』も頭くるわね！」"},
{"id": 215, "speaker": 29, "form": "dlg", "jp": "「とにかく、\n　早急に『ノア』をとりかえさないと‥‥」"},
{"id": 216, "speaker": 31, "form": "dlg", "jp": "「まあ、やっと『ジーン』が帰ってきたんだ‥‥」"},
{"id": 217, "speaker": 31, "form": "dlg", "jp": "「これであのコゾウとまともに勝負できる！」"},
{"id": 218, "speaker": 16, "form": "dlg", "jp": "「どうする？　今すぐ行くの？」"},
{"id": 219, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って‥‥」"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 221, "speaker": 29, "form": "dlg", "jp": "「戦う前に、\n　あのコの『能力』の分析をしておいた方が‥‥」"},
{"id": 222, "speaker": 31, "form": "dlg", "jp": "「何言ってるんだよ！」"},
{"id": 223, "speaker": 31, "form": "dlg", "jp": "「あのコゾウの『能力』は」"},
{"id": 224, "speaker": 31, "form": "dlg", "jp": "「『光線を発射する』のと\n　『姿を消す』の２つじゃないか？」"},
{"id": 225, "speaker": 29, "form": "dlg", "jp": "「いいえ、それはあり得ないのよ‥‥」"},
{"id": 226, "speaker": 29, "form": "dlg", "jp": "「２つ以上の能力を持つなんて‥‥」"},
{"id": 227, "speaker": 31, "form": "dlg", "jp": "「でも、実際にいるじゃないか！？」"},
{"id": 228, "speaker": 29, "form": "dlg", "jp": "「そこにヒミツがあるのよ！」"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "「ヒミツ？」"},
{"id": 230, "speaker": 29, "form": "dlg", "jp": "「例えば、ナゴムは体を『かたくする』ことも\n　『やわらかく』することもできる‥‥」"},
{"id": 231, "speaker": 29, "form": "dlg", "jp": "「しかし『能力』は『体を変質させる』という\n　１つの能力だけ‥‥」"},
{"id": 232, "speaker": 29, "form": "dlg", "jp": "「私も『見えないものが見える』し、\n　『聞こえないものが聞こえる』‥‥」"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "「でも、\n　『能力』は『超感覚』って１つだけなの‥‥」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「じゃあ、出口も？」"},
{"id": 235, "speaker": 29, "form": "dlg", "jp": "「そうじゃないかしら‥‥」"},
{"id": 236, "speaker": 31, "form": "dlg", "jp": "「『光線を発射』できて、\n　『姿を消す』ことができる能力‥‥」"},
{"id": 237, "speaker": 29, "form": "dlg", "jp": "「きっと、何か基本の能力があって\n　それの応用で２つの能力に見せかけているのよ」"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 239, "speaker": 31, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 240, "speaker": 16, "form": "dlg", "jp": "「‥‥‥‥‥」"},
{"id": 241, "speaker": 51, "form": "dlg", "jp": "「アカン、頭いたなってきた‥‥」"},
{"id": 242, "speaker": 29, "form": "dlg", "jp": "「そうね、とりあえず、\n　１つ１つしくみを考えてみましょうか？」"},
{"id": 243, "speaker": 29, "form": "dlg", "jp": "「まず、\n　わかりやすい『光線を発射する能力』について‥‥」"},
{"id": 244, "speaker": 29, "form": "dlg", "jp": "「あの『光線』って\n　どうやって『発射』してるのかしら？」"},
{"id": 245, "speaker": 29, "form": "choice", "jp": "「『強い光源』が目の中にあるとか‥‥」"},
{"id": 246, "speaker": 29, "form": "choice", "jp": "「『反射装置』が目の中にあるとか‥‥」"},
{"id": 247, "speaker": 29, "form": "choice", "jp": "「『光の波』を操る能力を持ってるとか‥‥」"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "「『強い光源』が目の中にあるとか‥‥」"},
{"id": 249, "speaker": 31, "form": "dlg", "jp": "「『強い光源』？」"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "「やっぱり、光の元がどこかにあるんだろう？」"},
{"id": 251, "speaker": 29, "form": "dlg", "jp": "「レーザーって、\n　『光の強さ』とは直接関係ないわよ‥‥」"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "「『反射装置』が目の中にあるとか‥‥」"},
{"id": 254, "speaker": 31, "form": "dlg", "jp": "「『反射装置』？」"},
{"id": 255, "speaker": 2, "form": "dlg", "jp": "「ホラ、\n　鏡で太陽の光を反射させたりするだろう？」"},
{"id": 256, "speaker": 29, "form": "dlg", "jp": "「じゃあ、私は『太陽の光』でケガをしたの？」"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "「でも、虫眼鏡でヤケドしたりするじゃないか」"},
{"id": 258, "speaker": 29, "form": "dlg", "jp": "「ちなみに、私がやられたのは『夜』よ‥‥」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「そうだったね‥‥」"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 261, "speaker": 2, "form": "dlg", "jp": "「『光の波』を操る能力を持ってるとか‥‥」"},
{"id": 262, "speaker": 31, "form": "dlg", "jp": "「『光の波』？」"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "「たしか、『レーザー光線』て\n　特殊な波長の『光』なんだろう？」"},
{"id": 264, "speaker": 29, "form": "dlg", "jp": "「たぶん、それが正解ね‥‥」"},
{"id": 265, "speaker": 29, "form": "dlg", "jp": "「じゃあ、『姿を消す能力』は？」"},
{"id": 266, "speaker": 31, "form": "dlg", "jp": "「問題はそっちだな‥‥」"},
{"id": 267, "speaker": 31, "form": "dlg", "jp": "「やっぱり、\n　『テレポーテーション』じゃないのか？」"},
{"id": 268, "speaker": 29, "form": "dlg", "jp": "「それなら\n　２つの能力を持ってることになるでしょう？」"},
{"id": 269, "speaker": 31, "form": "dlg", "jp": "「じゃあ、どうやってんだ？」"},
{"id": 270, "speaker": 51, "form": "dlg", "jp": "「ほら、よく手品なんかで\n　人が消えるのあるやん」"},
{"id": 271, "speaker": 51, "form": "dlg", "jp": "「あんなんってどうやってんねやろう？」"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "「あれって、たしか‥‥」"},
{"id": 273, "speaker": 16, "form": "dlg", "jp": "「ほら、よく手品なんかで\n　人が消えるのあるじゃない」"},
{"id": 274, "speaker": 16, "form": "dlg", "jp": "「あんなのってどうやってるんだろう？」"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "「あれって、たしか‥‥」"},
{"id": 276, "speaker": 2, "form": "choice", "jp": "「『床がぬける』んだよね‥‥」"},
{"id": 277, "speaker": 2, "form": "choice", "jp": "「『鏡を使ってる』んだよね‥‥」"},
{"id": 278, "speaker": 2, "form": "choice", "jp": "「『はじめからいない』んだよね‥‥」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "「『床がぬける』んだよね‥‥」"},
{"id": 280, "speaker": 31, "form": "dlg", "jp": "「『床がぬける』？」"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "「あのハコの中の人間が消えるヤツだろう？」"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "「あれってハコを置いている床がぬけているんだよ」"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "「『はじめからいない』んだよね‥‥」"},
{"id": 284, "speaker": 31, "form": "dlg", "jp": "「『はじめからいない』？」"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "「あの布の中の人間が消えるヤツだろう？」"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "「あれって布をかけた時には\n　すでに移動しちゃってて」"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "「それを\n　演技でまだ中にいるように見せてるんだよ」"},
{"id": 288, "speaker": 51, "form": "dlg", "jp": "「ウチが言ってるのはその手品ちゃうし‥‥」"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "「じゃあ、アッチの方かな？」"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "「アッチの方は‥‥」"},
{"id": 291, "speaker": 16, "form": "dlg", "jp": "「私が言ってるのはその手品じゃないわ‥‥」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「じゃあ、アッチの方かな？」"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "「アッチの方は‥‥」"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "「『鏡を使ってる』んだよね‥‥」"},
{"id": 295, "speaker": 51, "form": "dlg", "jp": "「『鏡』でなんで消えるの？」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「手品のステージとか、\n　たいてい黒一色だったりするだろう？」"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "「『鏡』をこう、斜めに立てかけると\n　横の景色が『鏡』に写るだろう？」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "「でも、横も前も似たような景色だから\n　客席からは消えたように見えるんだよ‥‥」"},
{"id": 299, "speaker": 51, "form": "dlg", "jp": "「ふーん」"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "「『鏡を使ってる』んだよね‥‥」"},
{"id": 301, "speaker": 16, "form": "dlg", "jp": "「『鏡』でどうして消えるわけ？」"},
{"id": 302, "speaker": 2, "form": "dlg", "jp": "「手品のステージとか、\n　たいてい黒一色だったりするだろう？」"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "「『鏡』をこう、斜めに立てかけると\n　横の景色が『鏡』に写るだろう？」"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "「でも、横も前も似たような景色だから\n　客席からは消えたように見えるんだよ‥‥」"},
{"id": 305, "speaker": 16, "form": "dlg", "jp": "「ふーん」"},
{"id": 306, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 308, "speaker": 29, "form": "dlg", "jp": "「それって、つまり\n　『光』を曲げるってことでしょう？」"},
{"id": 309, "speaker": 2, "form": "dlg", "jp": "「まあ、そういうことなのかな‥‥\n　‥‥‥‥‥うん！？」"},
{"id": 310, "speaker": 2, "form": "dlg", "jp": "「『光』を曲げる？」"},
{"id": 311, "speaker": 2, "form": "dlg", "jp": "「そういうことかっ！！」"},
{"id": 312, "speaker": 31, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "「わかったよ、出口の能力が！！」"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "「アイツの能力は『光を操る』能力なんだ！」"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "「アイツは体の周りの『光』を曲げて\n　見えないようにしてるんだ！」"},
{"id": 316, "speaker": 31, "form": "dlg", "jp": "「なるほど！」"},
{"id": 317, "speaker": 31, "form": "dlg", "jp": "「それなら、『２つの能力』の説明がつく！」"},
{"id": 318, "speaker": 29, "form": "dlg", "jp": "「もしかしたら、私があの程度のケガですんだのは」"},
{"id": 319, "speaker": 29, "form": "dlg", "jp": "「『光』の少ない『夜』だったからかもね‥‥」"},
{"id": 320, "speaker": 31, "form": "dlg", "jp": "「となると、決戦は‥‥」"},
{"id": 321, "speaker": 29, "form": "dlg", "jp": "「『夜』の方がよさそうね‥‥」"},
{"id": 322, "speaker": 29, "form": "dlg", "jp": "「ただ、カン違いしないでね」"},
{"id": 323, "speaker": 29, "form": "dlg", "jp": "「話し合いで済むなら、\n　話し合いで済ませるわよ！」"},
{"id": 324, "speaker": 2, "form": "dlg", "jp": "「でも、話し合いで済まなそうな時は？」"},
{"id": 325, "speaker": 29, "form": "dlg", "jp": "「その時は戦うわよ‥‥」"},
{"id": 326, "speaker": 51, "form": "dlg", "jp": "「で、いつにするん？」"},
{"id": 327, "speaker": 29, "form": "dlg", "jp": "「早い方がいいから、『今夜』ね‥‥」"},
{"id": 328, "speaker": 29, "form": "dlg", "jp": "「場所は‥‥」"},
{"id": 329, "speaker": 51, "form": "dlg", "jp": "「神社のウラとかやったらどうやろう？」"},
{"id": 330, "speaker": 51, "form": "dlg", "jp": "「アソコやったら、暗いし‥‥」"},
{"id": 331, "speaker": 51, "form": "dlg", "jp": "「人目につかへんやろうから‥‥」"},
{"id": 332, "speaker": 16, "form": "dlg", "jp": "「で、いつにするの？」"},
{"id": 333, "speaker": 29, "form": "dlg", "jp": "「早い方がいいから、『今夜』ね‥‥」"},
{"id": 334, "speaker": 29, "form": "dlg", "jp": "「場所は‥‥」"},
{"id": 335, "speaker": 16, "form": "dlg", "jp": "「神社のウラとかだったらどう？」"},
{"id": 336, "speaker": 16, "form": "dlg", "jp": "「アソコだったら、暗いし‥‥」"},
{"id": 337, "speaker": 16, "form": "dlg", "jp": "「人目につかないだろうから‥‥」"},
{"id": 338, "speaker": 29, "form": "dlg", "jp": "「ナゴム、悪いけどあのコを夜の１０時に\n　神社のウラに呼び出してもらえない？」"},
{"id": 339, "speaker": 2, "form": "dlg", "jp": "「わかった、やってみるよ‥‥」"},
{"id": 340, "speaker": 2, "form": "dlg", "jp": "こうしてボクたちはもう一度\n『出口エイジ』に会うことにした。"}
]
