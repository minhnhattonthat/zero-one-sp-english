[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／２４／ＰＭ０３：４０"},
{"id": 1, "speaker": 3, "form": "dlg", "jp": "「ここよ‥‥」"},
{"id": 2, "speaker": 26, "form": "dlg", "jp": "「こりゃまた立派なホテルですねぇ‥‥」"},
{"id": 3, "speaker": 4, "form": "dlg", "jp": "「常光寺さんですね？」"},
{"id": 4, "speaker": 3, "form": "dlg", "jp": "「『シロー』‥‥！？」"},
{"id": 5, "speaker": 4, "form": "dlg", "jp": "「三田さん、お久しぶりです」"},
{"id": 6, "speaker": 26, "form": "dlg", "jp": "「清田くん！！」"},
{"id": 7, "speaker": 3, "form": "dlg", "jp": "「アナタが『清田さん』‥‥？」"},
{"id": 8, "speaker": 37, "form": "dlg", "jp": "「はじめまして、清田ユウリです」"},
{"id": 9, "speaker": 3, "form": "dlg", "jp": "「はじめまして‥‥」"},
{"id": 10, "speaker": 37, "form": "dlg", "jp": "「こちらは弟さんですか？」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「ナゴムです‥‥」"},
{"id": 12, "speaker": 37, "form": "dlg", "jp": "「‥‥どうかしたんですか？」"},
{"id": 13, "speaker": 37, "form": "dlg", "jp": "「お二人とも、様子が変ですけど‥‥」"},
{"id": 14, "speaker": 3, "form": "dlg", "jp": "「いえ、あまりにも知り合いに似てましたので‥‥」"},
{"id": 15, "speaker": 37, "form": "dlg", "jp": "「そうなんですか‥‥」"},
{"id": 16, "speaker": 37, "form": "dlg", "jp": "「じゃあ、お部屋の方へ御案内します‥‥」"},
{"id": 17, "speaker": 3, "form": "dlg", "jp": "「ありがとうございます‥‥」"},
{"id": 18, "speaker": 3, "form": "dlg", "jp": "ボクたちは部屋に案内されることになった。"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「で、清田さんはどんな研究を？」"},
{"id": 20, "speaker": 37, "form": "dlg", "jp": "「ボクは人工知能の研究じゃなく」"},
{"id": 21, "speaker": 37, "form": "dlg", "jp": "「『知能の人工化』を‥‥」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「『知能の人工化』？」"},
{"id": 23, "speaker": 37, "form": "dlg", "jp": "「脳に直接的に信号化された知識を書き込むことで、\n　効率よく知識を得る研究を‥‥」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「何を言っているかさっぱりわからないです」"},
{"id": 25, "speaker": 37, "form": "dlg", "jp": "「例えば本を１冊、丸暗記しようとすると、\n　何度も繰り返し読んだり大変だろう？」"},
{"id": 26, "speaker": 37, "form": "dlg", "jp": "「でも、コンピュータに\n　それを記録するのは簡単なんだよ」"},
{"id": 27, "speaker": 37, "form": "dlg", "jp": "「だから、それと同じように、\n　人間の脳に直接信号を書き込めば‥‥」"},
{"id": 28, "speaker": 37, "form": "dlg", "jp": "「わかるだろう？」"},
{"id": 29, "speaker": 37, "form": "dlg", "jp": "よくはわからないが、とにかくスゴい研究らしい。"},
{"id": 30, "speaker": 37, "form": "dlg", "jp": "「じゃあ、ボクはこれで‥‥」"},
{"id": 31, "speaker": 37, "form": "dlg", "jp": "「明日は９時半にここを出発しますので‥‥」"},
{"id": 32, "speaker": 3, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 33, "speaker": 37, "form": "dlg", "jp": "「じゃあ、失礼します‥‥」"},
{"id": 34, "speaker": 3, "form": "dlg", "jp": "「ありがとうございました」"},
{"id": 35, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 36, "speaker": 3, "form": "dlg", "jp": "「バタン！」"},
{"id": 37, "speaker": 26, "form": "dlg", "jp": "「ねえ、驚いたでしょう？」"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "「いったいどういうこと？」"},
{"id": 39, "speaker": 26, "form": "dlg", "jp": "「シローのマスクを作るときに、\n　彼の顔を型取りさせてもらったんだよ‥‥」"},
{"id": 40, "speaker": 26, "form": "dlg", "jp": "「彼は覚えてないみたいだけど‥‥」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「覚えてないって、そんなに昔のことなの？」"},
{"id": 42, "speaker": 26, "form": "dlg", "jp": "「いや、２年ぐらい前のことだけど‥‥」"},
{"id": 43, "speaker": 26, "form": "dlg", "jp": "「彼、ちょっとした"},
{"id": 44, "speaker": 26, "form": "dlg", "jp": "記憶喪失"},
{"id": 45, "speaker": 26, "form": "dlg", "jp": "に\n　なっちゃったみたいで‥‥」"},
{"id": 46, "speaker": 3, "form": "dlg", "jp": "「記憶喪失？」"},
{"id": 47, "speaker": 26, "form": "dlg", "jp": "「そうなんですよ‥‥」"},
{"id": 48, "speaker": 26, "form": "dlg", "jp": "「ある日、突然、\n　ボクや博士のことも忘れちゃったんですよ‥‥」"},
{"id": 49, "speaker": 26, "form": "dlg", "jp": "「で、しばらくは博士の元にいたんですけど、\n"},
{"id": 50, "speaker": 26, "form": "dlg", "jp": "　まあ飛び出しちゃいまして‥‥」"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "「そうなんですか‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "三田さんの話によると、清田さんは\nかなり優秀な助手だったらしい。"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "それが突然‥‥"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "２００５／０８／２４／ＰＭ０５：１０"},
{"id": 55, "speaker": 26, "form": "dlg", "jp": "「清田くんが元気そうで安心したけどね」"},
{"id": 56, "speaker": 26, "form": "dlg", "jp": "「じゃあ、ボクもこれで引き上げます」"},
{"id": 57, "speaker": 26, "form": "dlg", "jp": "「明日の発表、がんばってくださいね！」"},
{"id": 58, "speaker": 3, "form": "dlg", "jp": "「ありがとうございます」"},
{"id": 59, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 60, "speaker": 3, "form": "dlg", "jp": "「バタン！」"},
{"id": 61, "speaker": 3, "form": "dlg", "jp": "２００５／０８／２４／ＰＭ１１：００"},
{"id": 62, "speaker": 3, "form": "dlg", "jp": "ジャーンジャーンジャーン！"},
{"id": 63, "speaker": 0, "form": "dlg", "jp": "「こんばんは」"},
{"id": 64, "speaker": 0, "form": "dlg", "jp": "「最初のニュースは、最近立て続けに起こっている\n　機械の誤作動のニュースからです」"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "（これって、今日の新幹線のニュース！？）"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "（最近、よくニュース現場に出会っているような‥‥）"},
{"id": 67, "speaker": 1, "form": "dlg", "jp": "「この事故での死傷者はありませんでした」"},
{"id": 68, "speaker": 1, "form": "dlg", "jp": "「なお、すでに新幹線の復旧作業は終了し、\n　明日からは通常通りの運行が再開されます‥‥」"},
{"id": 69, "speaker": 1, "form": "dlg", "jp": "ニュースでは落雷による断線により、\n新幹線は停止したと報道されていた。"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "（落雷じゃない‥‥）"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "（シローのレーザーだ！）"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "多分、米軍の兵器が暴走したなどということは、\nうかつに報道できないのだろう‥‥"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "まあ、報道されたりしない方がいいけど。"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "変に注目されてしまうと、\nシローの存在がバレてしまいかねない。"},
{"id": 75, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～」"},
{"id": 76, "speaker": 3, "form": "dlg", "jp": "隣の部屋で明日の準備をしている姉さんの声だ。"},
{"id": 77, "speaker": 3, "form": "dlg", "jp": "「早く寝なさいよ！」"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "（さてと‥‥）"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "（寝るとするか）"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「カチッ！」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「ガサゴソ‥‥」"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "「ガサゴソ‥‥」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "（なんの音だ‥‥？）"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "（姉さんか？）"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "（‥‥！？）"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "（何だありゃ？）"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "部屋の隅でおかしな生き物が\n姉さんのカバンをかき回していた。"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「カチッ！」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「オイッ！　何をしている！」"},
{"id": 93, "speaker": 4, "form": "dlg", "jp": "「オマエ、オレを見て驚かないのか？」"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "（コイツ、しゃべれるのか！？）"},
{"id": 95, "speaker": 4, "form": "dlg", "jp": "「オレのことが恐くないのか？」"},
{"id": 96, "speaker": 4, "form": "dlg", "jp": "以前のボクなら驚いただろうが、\n今のボクは少々のことでは驚かなくなっていた。"},
{"id": 97, "speaker": 4, "form": "dlg", "jp": "「まあ、いい‥‥」"},
{"id": 98, "speaker": 4, "form": "dlg", "jp": "「オマエのオヤジの研究資料はどこだ？」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「そんなもの持ってきてるわけないだろう！！」"},
{"id": 100, "speaker": 4, "form": "dlg", "jp": "「で、どこにある？」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "（なんでそんなこと知りたがるんだ？）"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "（まさか！！）"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "（ルードのサイボーグ！？）"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "（そんなヤツに\n　父さんの研究資料を渡すわけにはいかない！！）"},
{"id": 105, "speaker": 4, "form": "dlg", "jp": "「知らないのか？」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "（知っているが、こんなヤツに教えられない！）"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "（それに、ボクたちの周りを探しても、\n　見つかりっこないんだ‥‥）"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "（なぜなら、\n　資料はすべて三田さんに渡してしまったからだ‥‥）"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "（とりあえず、ここは知らないと答えておこう‥‥）"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「知らないよ！」"},
{"id": 111, "speaker": 4, "form": "dlg", "jp": "「ウソツキめ‥‥」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「‥‥！？」"},
{"id": 113, "speaker": 4, "form": "dlg", "jp": "「じゃあな‥‥」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "謎の化け物はすんなりと姿を消してしまった。"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "（いったい、何だったんだ？）"},
{"id": 117, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～」"},
{"id": 118, "speaker": 3, "form": "dlg", "jp": "「いつまで、寝てるの！！」"},
{"id": 119, "speaker": 3, "form": "dlg", "jp": "２００５／０８／２５／ＡＭ０８：１０"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 121, "speaker": 3, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「なんだ、夢か‥‥」"},
{"id": 123, "speaker": 3, "form": "dlg", "jp": "「いつまでも寝惚けてないでよ」"},
{"id": 124, "speaker": 3, "form": "dlg", "jp": "「もう出かけるから‥‥」"},
{"id": 125, "speaker": 3, "form": "dlg", "jp": "「ナゴムはどうするの？」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「ボクは‥‥」"},
{"id": 127, "speaker": 2, "form": "choice", "jp": "「後で会場に行くよ！」"},
{"id": 128, "speaker": 2, "form": "choice", "jp": "「適当に大阪見物をするよ！」"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "「後で会場に行くよ！」"},
{"id": 130, "speaker": 3, "form": "dlg", "jp": "「いいわよ、来なくって‥‥」"},
{"id": 131, "speaker": 3, "form": "dlg", "jp": "「それより、せっかくだから\n　大阪見物してらっしゃいよ！」"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 133, "speaker": 3, "form": "dlg", "jp": "「学会の発表なんて、\n　ナゴムが見ても面白くないわよ」"},
{"id": 134, "speaker": 3, "form": "dlg", "jp": "「いってらっしゃいよ‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「じゃあ、そうさせてもらうよ‥‥」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「適当に大阪見物をするよ！」"},
{"id": 137, "speaker": 3, "form": "dlg", "jp": "「それがいいかもね‥‥」"},
{"id": 138, "speaker": 3, "form": "dlg", "jp": "「学会の発表なんて、\n　ナゴムが見ても面白くないだろうし」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「じゃあ、そうさせてもらうよ‥‥」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "姉さんは一人で学会へと出かけた。"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "部屋に残ったボクは夢のことを考えていた。"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "（しかし、気持ち悪い夢だった‥‥）"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "（夢だよな‥‥）"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "ボクはまさかと思い、夢の中で\nあの怪物が探っていた場所を確認した。"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "（やっぱり‥‥）"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "そこは、まったく荒らされた形跡はなかった。"},
{"id": 149, "speaker": 2, "form": "choice", "jp": "（ただの夢か‥‥）"},
{"id": 150, "speaker": 2, "form": "choice", "jp": "（いや、姉さんが片付けたのかも‥‥）"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "（ただの夢か‥‥）"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "（いや、姉さんが片付けたのかも‥‥）"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "（やっぱ、ジーンに知らせておいた方がいいかな？）"},
{"id": 154, "speaker": 2, "form": "choice", "jp": "（いや、余計な心配はさせたくないな‥‥）"},
{"id": 155, "speaker": 2, "form": "choice", "jp": "（とりあえず、報告だけはしておくか‥‥）"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "（いや、余計な心配はさせたくないな‥‥）"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "（単なる夢かもしれないし‥‥）"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "ボクはジーンに知らせないことにした。"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "（とりあえず、報告だけはしておくか‥‥）"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "ボクはジーンにテレパシーを送った。"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "（ジーン‥‥）"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "（ジーン‥‥！！）"},
{"id": 163, "speaker": 29, "form": "dlg", "jp": "（何よ、朝っぱらから？）"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "（いや、ちょっと気になる夢を見たんだ‥‥）"},
{"id": 165, "speaker": 29, "form": "dlg", "jp": "（ちょっと待って‥‥）"},
{"id": 166, "speaker": 29, "form": "dlg", "jp": "（何か勘違いしていない？）"},
{"id": 167, "speaker": 29, "form": "dlg", "jp": "（アナタには予知夢を見る能力はないのよ！）"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "（予知夢とか、そんなんじゃないんだ‥‥）"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "（って言うか、夢かどうかもわからないんだけど‥‥）"},
{"id": 170, "speaker": 29, "form": "dlg", "jp": "（寝惚けてるの？）"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "（違うよ！）"},
{"id": 172, "speaker": 29, "form": "dlg", "jp": "（じゃあ何なのよ？）"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "（とにかく、夢か現実かわからないようなことに\n　でくわしたんだよ！）"},
{"id": 174, "speaker": 29, "form": "dlg", "jp": "（で？）"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "（なんか、映画に出てくる怪物みたいなのを見たんだ！）"},
{"id": 176, "speaker": 29, "form": "dlg", "jp": "（で、ソイツがどうかしたの？）"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "（ただ、父さんの研究資料を探してただけで‥‥）"},
{"id": 178, "speaker": 29, "form": "dlg", "jp": "（なんで、怪物が研究資料なんかを？）"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "（わからない‥‥）"},
{"id": 180, "speaker": 29, "form": "dlg", "jp": "（そんなこといちいち連絡してこないでよ！）"},
{"id": 181, "speaker": 29, "form": "choice", "jp": "（でも、超能力者かもしれないし‥‥）"},
{"id": 182, "speaker": 29, "form": "choice", "jp": "（でも、ゲーマーかもしれないし‥‥）"},
{"id": 183, "speaker": 29, "form": "choice", "jp": "（でも、サイボーグかもしれないし‥‥）"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "（でも、超能力者かもしれないし‥‥）"},
{"id": 185, "speaker": 29, "form": "dlg", "jp": "（いい？）"},
{"id": 186, "speaker": 29, "form": "dlg", "jp": "（超能力者がどうして、研究資料を欲しがるわけ？）"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "（わからないけど‥‥）"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "（でも、ゲーマーかもしれないし‥‥）"},
{"id": 189, "speaker": 29, "form": "dlg", "jp": "（いい？）"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "（ゲーマーがどうして、研究資料を欲しがるわけ？）"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "（わからないけど‥‥）"},
