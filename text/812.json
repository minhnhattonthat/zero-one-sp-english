[
{"id": 0, "speaker": null, "form": "dlg", "jp": "その日、ボクは朝早くから、\nアイコに『写真』の確認をしてもらった。"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "その結果‥‥"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "ボクたちの推理した通り、"},
{"id": 3, "speaker": null, "form": "dlg", "jp": "その『写真の人物』とアイコの見た\n『車の中で寝ていたオジさん』が"},
{"id": 4, "speaker": null, "form": "dlg", "jp": "『同一人物』であることが証明された。"},
{"id": 5, "speaker": null, "form": "dlg", "jp": "そして、ボクたちはいよいよ、その『写真の人物』\n『五島マサシ』の所へ行くことにした。"},
{"id": 6, "speaker": null, "form": "dlg", "jp": "２００５／０７／２８／ＰＭ０４：３０"},
{"id": 7, "speaker": 51, "form": "dlg", "jp": "「やっぱり、コイツが『犯人』やったんね？」"},
{"id": 8, "speaker": 51, "form": "dlg", "jp": "「ゆるせへんなぁ～」"},
{"id": 9, "speaker": 16, "form": "dlg", "jp": "「やっぱり、コイツが『犯人』だったのね？」"},
{"id": 10, "speaker": 16, "form": "dlg", "jp": "「ゆるせないわぁ～」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「で、『ケネス』の容態はどうなの？」"},
{"id": 12, "speaker": 29, "form": "dlg", "jp": "「抗アレルギー剤のせいでまだ眠ってるわ‥‥」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「じゃあ、命には別状はないんだね？」"},
{"id": 14, "speaker": 29, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「で、どうする？」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「このまま、ケネス抜きで踏み込むのかい？」"},
{"id": 17, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 18, "speaker": 29, "form": "dlg", "jp": "「ケネスの能力が使えないのはイタイけど‥‥」"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "「これ以上アイツを放っておけないわね‥‥」"},
{"id": 20, "speaker": 29, "form": "dlg", "jp": "「すでにアイツもコチラのこと\n　気付いているみたいだし‥‥」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "こうしてボクたちは寝込んでいるケネス抜きで\n『五島マサシ』のアパートへ行くことになった。"},
{"id": 23, "speaker": 29, "form": "dlg", "jp": "「『免許証』の住所が本物なら、\n　ソイツはこのアパートに住んでいるハズよ‥‥」"},
{"id": 24, "speaker": 51, "form": "dlg", "jp": "「ちゃんとレターボックスにも『五島』って書いてある！」"},
{"id": 25, "speaker": 16, "form": "dlg", "jp": "「ちゃんとレターボックスにも『五島』って書いてある！」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「じゃあ、本当にここに住んでるんだね？」"},
{"id": 27, "speaker": 29, "form": "dlg", "jp": "「そうみたいね‥‥」"},
{"id": 28, "speaker": 29, "form": "choice", "jp": "「よし、踏み込もう！！」"},
{"id": 29, "speaker": 29, "form": "choice", "jp": "「ジーン、中の様子を確認してくれ！」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "「ジーン、中の様子を確認してくれ！」"},
{"id": 31, "speaker": 29, "form": "dlg", "jp": "「どうして？」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "「もしかしたら、留守かもしれないし‥‥」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「それに、ドアをあけたらいきなり\n　『犬』がとびかかってくるとかあるかも‥‥」"},
{"id": 34, "speaker": 29, "form": "dlg", "jp": "「そうね、わかったわ！」"},
{"id": 35, "speaker": 29, "form": "dlg", "jp": "ジーンは『能力』を使って\n部屋の中を調べ始めた。"},
{"id": 36, "speaker": 29, "form": "dlg", "jp": "「大丈夫よ！」"},
{"id": 37, "speaker": 29, "form": "dlg", "jp": "「中にはそれらしき『男の人』が１人だけ‥‥」"},
{"id": 38, "speaker": 29, "form": "dlg", "jp": "「『犬』も『ネコ』も中にはいないわ！」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「じゃあ、踏み込む？」"},
{"id": 40, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 41, "speaker": 29, "form": "dlg", "jp": "「ガチャ‥‥」"},
{"id": 42, "speaker": 29, "form": "dlg", "jp": "「ガチャ‥‥」"},
{"id": 43, "speaker": 29, "form": "dlg", "jp": "「カギがかかってるわ‥‥」"},
{"id": 44, "speaker": 51, "form": "dlg", "jp": "「カギぐらいまかしといて！」"},
{"id": 45, "speaker": 51, "form": "dlg", "jp": "そう言うと小田はカギ穴に指をそっと当てた。"},
{"id": 46, "speaker": 51, "form": "dlg", "jp": "「ガッ！」"},
{"id": 47, "speaker": 51, "form": "dlg", "jp": "「開いたで‥‥」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「‥‥‥！？」"},
{"id": 49, "speaker": 51, "form": "dlg", "jp": "「カギをこわしたんや！」"},
{"id": 50, "speaker": 29, "form": "dlg", "jp": "「たのもしいわね‥‥」"},
{"id": 51, "speaker": 29, "form": "dlg", "jp": "「トモの『破壊力』とナゴムの『防御力』があれば\n　ケネスがいなくてもどうにかなるかもね‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「じゃあ、行くよ‥‥」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 54, "speaker": 51, "form": "dlg", "jp": "「なんや気味の悪い部屋やなぁ～」"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "（シーッ！　聞こえるよ！）"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 58, "speaker": 29, "form": "dlg", "jp": "「『暗証番号入力式』の『電子ロック』ね‥‥」"},
{"id": 59, "speaker": 16, "form": "dlg", "jp": "「あっ、たぶんアキラ開けれると思うわ！」"},
{"id": 60, "speaker": 16, "form": "dlg", "jp": "そう言うと長尾は番号を入力しはじめた。"},
{"id": 61, "speaker": 16, "form": "dlg", "jp": "「ピンポン！」"},
{"id": 62, "speaker": 16, "form": "dlg", "jp": "「開いたわ‥‥」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「‥‥‥！？」"},
{"id": 64, "speaker": 16, "form": "dlg", "jp": "「夢で『暗証番号』をみたの‥‥」"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "「たのもしいわね‥‥」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「じゃあ、行くよ‥‥」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 68, "speaker": 16, "form": "dlg", "jp": "「キモチワルイ部屋～」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "（シーッ！　聞こえるよ！）"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "その時！"},
{"id": 73, "speaker": 4, "form": "dlg", "jp": "「やっぱり、来たのか？」"},
{"id": 74, "speaker": null, "form": "dlg", "jp": "部屋の陰から１人の中年男性が現れた。"},
{"id": 75, "speaker": 29, "form": "dlg", "jp": "「『五島マサシ』ね？」"},
{"id": 76, "speaker": 33, "form": "dlg", "jp": "「知ってるんだろう？」"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "「まあね‥‥」"},
{"id": 78, "speaker": 33, "form": "dlg", "jp": "「なんだ、昨日の黒いヤツの仕返しか？」"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "「残念ながらそうじゃないのよ‥‥」"},
{"id": 80, "speaker": 29, "form": "dlg", "jp": "「間違ってたらあやまるけど‥‥」"},
{"id": 81, "speaker": 29, "form": "dlg", "jp": "「もしかして、『ノア』って石のこと知らないかな？」"},
{"id": 82, "speaker": 33, "form": "dlg", "jp": "「あやまってもらおうか‥‥」"},
{"id": 83, "speaker": 29, "form": "dlg", "jp": "「じゃぁ？」"},
{"id": 84, "speaker": 33, "form": "dlg", "jp": "「知らないよ‥‥」"},
{"id": 85, "speaker": 29, "form": "dlg", "jp": "「どうやらウソじゃなさそうね‥‥」"},
{"id": 86, "speaker": 29, "form": "dlg", "jp": "「あやまるわ、ゴメンなさい‥‥」"},
{"id": 87, "speaker": 33, "form": "dlg", "jp": "「用がないんなら、帰ってもらえないか？」"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "「まだ用はあるの‥‥」"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "「私たちはアナタと友だちになりに来たのよ‥‥」"},
{"id": 90, "speaker": 33, "form": "dlg", "jp": "「信じられねぇな‥‥」"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "「本当よ‥‥」"},
{"id": 92, "speaker": 33, "form": "dlg", "jp": "「本当なら、カギを勝手にあけたりしないだろう？」"},
{"id": 93, "speaker": 29, "form": "dlg", "jp": "「それはフツーに入ってきたら、\n　アナタに逃げられると思って‥‥」"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "「逃げなきゃいけないようなコトしてるんでしょう？」"},
{"id": 95, "speaker": 33, "form": "dlg", "jp": "「色々、調べたんだろう？」"},
{"id": 96, "speaker": 33, "form": "dlg", "jp": "「こんな人間と仲間になりたいのか？」"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "「まあね‥‥」"},
{"id": 98, "speaker": 33, "form": "dlg", "jp": "「聞かなくても大体は知ってるよ‥‥」"},
{"id": 99, "speaker": 33, "form": "dlg", "jp": "「コッチも、オマエたちのテレパシーを\n　盗み聞きさせてもらったんでな‥‥」"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "「なら、話が早いわね‥‥」"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "「アナタの能力の使い方を見ていると\n　『Ｅ－ｇｒｏ』で保護してあげないと大変なことに‥‥」"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "「その力をもっと有益に使いましょうよ！」"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "「どう、仲間になってもらえるかしら？」"},
{"id": 104, "speaker": 33, "form": "dlg", "jp": "「断わる‥‥」"},
{"id": 105, "speaker": 33, "form": "dlg", "jp": "「オレの『能力』はオレの物であって、\n　他人の為に使うつもりはナーイ！」"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "「仲間にならないっていうなら、\n　私たちはアナタを‥‥」"},
{"id": 107, "speaker": 33, "form": "dlg", "jp": "「ウルサイ！！」"},
{"id": 108, "speaker": 33, "form": "dlg", "jp": "「ソッチにいるのは、昨日のガキだろう？」"},
{"id": 109, "speaker": 33, "form": "dlg", "jp": "「よくも昨日はジャマしてくれたな‥‥」"},
{"id": 110, "speaker": 33, "form": "dlg", "jp": "「オレは２０年もガマンしてきたんだぞ！」"},
{"id": 111, "speaker": 33, "form": "dlg", "jp": "「あと２０年は自由にやらせてもらわないと\n　ワリが合わないんだ！」"},
{"id": 112, "speaker": 33, "form": "dlg", "jp": "「これ以上、オレのことをジャマすると\n　今度こそ‥‥」"},
{"id": 113, "speaker": 51, "form": "dlg", "jp": "「アンタ、自分で何を言ってるかわかってんの？」"},
{"id": 114, "speaker": 16, "form": "dlg", "jp": "「アナタ、自分で何を言ってるかわかってるの？」"},
{"id": 115, "speaker": 33, "form": "dlg", "jp": "「もちろん！」"},
{"id": 116, "speaker": 33, "form": "dlg", "jp": "「それより、オマエたちの方が誰と話してるのか\n　わかってないんじゃないのか？」"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "「わかってるつもりよ！」"},
{"id": 118, "speaker": 33, "form": "dlg", "jp": "「じゃあ、\n　生きて帰れない覚悟はできてるんだろうな？」"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "「強がってもダメよ！」"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "「ここに『犬』がいないのはバレてるのよ‥‥」"},
{"id": 121, "speaker": 33, "form": "dlg", "jp": "「ハハハハハハハ‥‥」"},
{"id": 122, "speaker": 33, "form": "dlg", "jp": "「その通りだよ！」"},
{"id": 123, "speaker": 33, "form": "dlg", "jp": "「ここには『犬』なんていないよ‥‥」"},
{"id": 124, "speaker": 33, "form": "dlg", "jp": "「で、それがどうかしたのか？」"},
{"id": 125, "speaker": 29, "form": "dlg", "jp": "「私たちも『能力者』だって知ってるんでしょう？」"},
{"id": 126, "speaker": 33, "form": "dlg", "jp": "「知ってるよ！」"},
{"id": 127, "speaker": 33, "form": "dlg", "jp": "「特に、ソッチのコゾウは昨日戦ったばっかりだしな‥‥」"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "「じゃあ、わかるでしょう？」"},
{"id": 129, "speaker": 29, "form": "dlg", "jp": "「アナタには勝ち目が無いのよ‥‥」"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "「ここはおとなしく私たちにしたがった方が‥‥」"},
{"id": 131, "speaker": 33, "form": "dlg", "jp": "「ハァ？」"},
{"id": 132, "speaker": 33, "form": "dlg", "jp": "「どうして、オレに勝ち目が無いんだぁ？」"},
{"id": 133, "speaker": 51, "form": "dlg", "jp": "「どうしてって？」"},
{"id": 134, "speaker": 51, "form": "dlg", "jp": "「アンタは『犬』がおらへんと、\n　『能力』が使われへんのやろう？」"},
{"id": 135, "speaker": 51, "form": "dlg", "jp": "「コッチは『能力』がフルで使えるんやで？」"},
{"id": 136, "speaker": 33, "form": "dlg", "jp": "「ハハハハハハハハハ‥‥」"},
{"id": 137, "speaker": 33, "form": "dlg", "jp": "「オマエたちは"},
{"id": 138, "speaker": 33, "form": "dlg", "jp": "カン違い"},
{"id": 139, "speaker": 33, "form": "dlg", "jp": "をしているようだな‥‥」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「カン違い？」"},
{"id": 141, "speaker": 33, "form": "dlg", "jp": "「そうさ‥‥」"},
{"id": 142, "speaker": 33, "form": "dlg", "jp": "「オレの能力は\n　『犬に乗り移る能力』じゃないんだよ！」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 144, "speaker": 51, "form": "dlg", "jp": "「そんなハズないやん！」"},
{"id": 145, "speaker": 51, "form": "dlg", "jp": "「ウチらアレだけ調べたのに‥‥」"},
{"id": 146, "speaker": 16, "form": "dlg", "jp": "「どうしてって？」"},
{"id": 147, "speaker": 16, "form": "dlg", "jp": "「アナタは『犬』が居ないと、\n　『能力』が使えないんじゃないの？」"},
{"id": 148, "speaker": 16, "form": "dlg", "jp": "「コッチは『能力』がフルで使えるのよ？」"},
{"id": 149, "speaker": 33, "form": "dlg", "jp": "「ハハハハハハハハハ‥‥」"},
{"id": 150, "speaker": 33, "form": "dlg", "jp": "「オマエたちは"},
{"id": 151, "speaker": 33, "form": "dlg", "jp": "カン違い"},
{"id": 152, "speaker": 33, "form": "dlg", "jp": "をしているようだな‥‥」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「カン違い？」"},
{"id": 154, "speaker": 33, "form": "dlg", "jp": "「そうさ‥‥」"},
{"id": 155, "speaker": 33, "form": "dlg", "jp": "「オレの能力は\n　『犬に乗り移る能力』じゃないんだよ！」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 157, "speaker": 16, "form": "dlg", "jp": "「そんなハズないわ！」"},
{"id": 158, "speaker": 16, "form": "dlg", "jp": "「私たちアレだけ調べたのに‥‥」"},
{"id": 159, "speaker": 33, "form": "dlg", "jp": "「じゃあ見せてやるよ！」"},
{"id": 160, "speaker": 33, "form": "dlg", "jp": "「オレの『本当の能力』を‥‥」"},
{"id": 161, "speaker": 33, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 162, "speaker": 33, "form": "dlg", "jp": "そう言うと『五島』は隣の部屋へとかけこんだ。"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「待てっ！」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "ボクたちも『五島』を追って隣の部屋に入った。"},
{"id": 165, "speaker": 29, "form": "dlg", "jp": "「逃げてもムダよ！」"},
{"id": 166, "speaker": 33, "form": "dlg", "jp": "「逃げたんじゃないんだよ‥‥」"},
{"id": 167, "speaker": 33, "form": "dlg", "jp": "「さそい出しただけだ‥‥」"},
{"id": 168, "speaker": 29, "form": "dlg", "jp": "「さそい出した？」"},
{"id": 169, "speaker": 33, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 170, "speaker": 33, "form": "dlg", "jp": "「広い場所にな‥‥」"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "「コイツ、なんかたくらんでる！」"},
{"id": 172, "speaker": 29, "form": "dlg", "jp": "「この部屋を出るわよ！」"},
{"id": 173, "speaker": 33, "form": "dlg", "jp": "「おおーっと！」"},
{"id": 174, "speaker": 33, "form": "dlg", "jp": "「バタン！」"},
{"id": 175, "speaker": 33, "form": "dlg", "jp": "背後でドアの閉まる音がした。"},
{"id": 176, "speaker": 33, "form": "dlg", "jp": "「こんなこともあろうかと、\n　ドアに細工をしておいたのさ‥‥」"},
{"id": 177, "speaker": 51, "form": "dlg", "jp": "「大丈夫や、こんなドアぐらい！」"},
{"id": 178, "speaker": 33, "form": "dlg", "jp": "「ドアに『細工』をしたっていっただろう？」"},
{"id": 179, "speaker": 33, "form": "dlg", "jp": "「ムリに開けようとすると\n　"},
{"id": 180, "speaker": 33, "form": "dlg", "jp": "爆弾"},
{"id": 181, "speaker": 33, "form": "dlg", "jp": "が『大爆発』するぜ！」"},
{"id": 182, "speaker": 29, "form": "dlg", "jp": "「爆弾？」"},
{"id": 183, "speaker": 33, "form": "dlg", "jp": "「そうさ‥‥」"},
{"id": 184, "speaker": 33, "form": "dlg", "jp": "「このアパート全体が吹っ飛ぶぐらいの\n　強力なヤツだ‥‥」"},
{"id": 185, "speaker": 51, "form": "dlg", "jp": "「そんなウソをついてもムダやで！」"},
{"id": 186, "speaker": 51, "form": "dlg", "jp": "「そんなことしたらアンタも死んでしまうやん！」"},
{"id": 187, "speaker": 33, "form": "dlg", "jp": "「その通りだが‥‥」"},
{"id": 188, "speaker": 33, "form": "dlg", "jp": "「またガマンする生活が続くぐらいなら、\n　オレは死んだ方がマシだからな‥‥」"},
{"id": 189, "speaker": 51, "form": "dlg", "jp": "「コイツ、イカレてる！」"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "「どうやら、\n　コイツの言ってることは本当みたいよ！」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「なんだって！」"},
{"id": 192, "speaker": 29, "form": "dlg", "jp": "「ドアから『火薬』の反応を感じるわ！」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「バカな！」"},
{"id": 194, "speaker": 33, "form": "dlg", "jp": "「ハハハハハハ‥‥」"},
{"id": 195, "speaker": 33, "form": "dlg", "jp": "「どうした、\n　オレには勝ち目は無いんじゃなかったのか？」"},
{"id": 196, "speaker": 29, "form": "dlg", "jp": "「フフフフフ‥‥」"},
{"id": 197, "speaker": 29, "form": "dlg", "jp": "「その通りよ！」"},
{"id": 198, "speaker": 29, "form": "dlg", "jp": "「出口をふさいだぐらいじゃ、\n　何も状況は変わっていないわよ！」"},
{"id": 199, "speaker": 51, "form": "dlg", "jp": "「ホンマや！\n　逆に『犬』を呼びづらくなっただけやん！」"},
{"id": 200, "speaker": 16, "form": "dlg", "jp": "「こんなドアぐらいたたきこわせるわよね？」"},
{"id": 201, "speaker": 33, "form": "dlg", "jp": "「ドアに『細工』をしたっていっただろう？」"},
{"id": 202, "speaker": 33, "form": "dlg", "jp": "「ムリに開けようとすると\n　"},
{"id": 203, "speaker": 33, "form": "dlg", "jp": "爆弾"},
{"id": 204, "speaker": 33, "form": "dlg", "jp": "が『大爆発』するぜ！」"},
{"id": 205, "speaker": 29, "form": "dlg", "jp": "「爆弾？」"},
{"id": 206, "speaker": 33, "form": "dlg", "jp": "「そうさ‥‥」"},
{"id": 207, "speaker": 33, "form": "dlg", "jp": "「このアパート全体が吹っ飛ぶぐらいの\n　強力なヤツだ‥‥」"},
{"id": 208, "speaker": 16, "form": "dlg", "jp": "「そんなウソをついてもムダよ！」"},
{"id": 209, "speaker": 16, "form": "dlg", "jp": "「そんなことしたらアナタも死んじゃうじゃん！」"},
{"id": 210, "speaker": 33, "form": "dlg", "jp": "「その通りだが‥‥」"},
{"id": 211, "speaker": 33, "form": "dlg", "jp": "「またガマンする生活が続くぐらいなら、\n　オレは死んだ方がマシだからな‥‥」"},
{"id": 212, "speaker": 16, "form": "dlg", "jp": "「もしかして、クルクルパー！？」"},
{"id": 213, "speaker": 29, "form": "dlg", "jp": "「どうやら、\n　コイツの言ってることは本当みたいよ！」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "「なんだって！」"},
{"id": 215, "speaker": 29, "form": "dlg", "jp": "「ドアから『火薬』の反応を感じるわ！」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「バカな！」"},
{"id": 217, "speaker": 33, "form": "dlg", "jp": "「ハハハハハハ‥‥」"},
{"id": 218, "speaker": 33, "form": "dlg", "jp": "「どうした、\n　オレには勝ち目は無いんじゃなかったのか？」"},
{"id": 219, "speaker": 29, "form": "dlg", "jp": "「フフフフフ‥‥」"},
{"id": 220, "speaker": 29, "form": "dlg", "jp": "「その通りよ！」"},
{"id": 221, "speaker": 29, "form": "dlg", "jp": "「出口をふさいだぐらいじゃ、\n　何も状況は変わっていないわよ！」"},
{"id": 222, "speaker": 16, "form": "dlg", "jp": "「そうよ！\n　逆に『犬』を呼びづらくなっただけじゃん！」"},
{"id": 223, "speaker": 33, "form": "dlg", "jp": "「いせいのいいコムスメたちだな‥‥」"},
{"id": 224, "speaker": 33, "form": "dlg", "jp": "「まあ、オマエら２人は後でじっくりと\n　『かみついて』やるよ‥‥」"},
{"id": 225, "speaker": 33, "form": "dlg", "jp": "「その前に、\n　コゾウを始末させてもらうとするか‥‥」"},
{"id": 226, "speaker": 29, "form": "dlg", "jp": "「ムダなことはヤメなさい！」"},
{"id": 227, "speaker": 29, "form": "dlg", "jp": "「一度戦ったんなら知ってるでしょう？\n　ナゴムの能力のこと‥‥」"},
{"id": 228, "speaker": 33, "form": "dlg", "jp": "「ああ、知ってるよ‥‥」"},
{"id": 229, "speaker": 33, "form": "dlg", "jp": "「体をガンジョウにできるんだろう？」"},
{"id": 230, "speaker": 29, "form": "dlg", "jp": "「その通りよ、もしアナタが『犬』じゃなくて\n　『ライオン』を操れたとしても勝てないわよ！」"},
{"id": 231, "speaker": 33, "form": "dlg", "jp": "「あいにく、\n　この部屋には『ライオン』はいないよ‥‥」"},
{"id": 232, "speaker": 33, "form": "dlg", "jp": "「それにオレがかみつきたいのは\n　『女のやわらかいノド』であって‥‥」"},
{"id": 233, "speaker": 33, "form": "dlg", "jp": "「あんなかたいモノにかみつくのは\n　２度とゴメンだからな‥‥」"},
{"id": 234, "speaker": 29, "form": "dlg", "jp": "「じゃあ、あきらめなさいっ！」"},
{"id": 235, "speaker": 33, "form": "dlg", "jp": "「せっかく『能力』を手に入れたのに」"},
{"id": 236, "speaker": 33, "form": "dlg", "jp": "「あきらめたり、\n　ガマンするなんてできるわけないだろう！」"},
{"id": 237, "speaker": 33, "form": "dlg", "jp": "「コイツが\n　"},
{"id": 238, "speaker": 33, "form": "dlg", "jp": "『呼吸せずにいられる』"},
{"id": 239, "speaker": 33, "form": "dlg", "jp": "なら別だがな‥‥」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「『呼吸しない』！？」"},
{"id": 241, "speaker": 33, "form": "dlg", "jp": "「食らえっ！」"},
{"id": 242, "speaker": 33, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 243, "speaker": 33, "form": "dlg", "jp": "五島はいきなり意識を失い\n床に倒れこんだ。"},
{"id": 244, "speaker": 2, "form": "dlg", "jp": "「ど、どうしたんだ？」"},
{"id": 245, "speaker": 29, "form": "dlg", "jp": "「気をつけて！」"},
{"id": 246, "speaker": 29, "form": "dlg", "jp": "「意識を失ったってことは、\n　意識をどこかに移したのかも？」"},
{"id": 247, "speaker": 51, "form": "dlg", "jp": "「でも、この部屋には『犬』は‥‥」"},
{"id": 248, "speaker": 29, "form": "dlg", "jp": "「『犬以外のもの』にも意識を移せるのかも‥‥」"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "「『犬以外のもの』！？」"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "ボクは辺りを見回した。"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "ボクの目につくのは、水槽の中の魚ぐらいだった。"},
{"id": 252, "speaker": 51, "form": "dlg", "jp": "「キャァ！」"},
{"id": 253, "speaker": 29, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 254, "speaker": 51, "form": "dlg", "jp": "「あ、あそこ！！」"},
{"id": 255, "speaker": 16, "form": "dlg", "jp": "「でも、この部屋には『犬』は‥」"},
{"id": 256, "speaker": 29, "form": "dlg", "jp": "「『犬以外のもの』にも意識を移せるのかも‥‥」"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "「『犬以外のもの』！？」"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "ボクは辺りを見回した。"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "ボクの目につくのは、水槽の中の魚ぐらいだった。"},
{"id": 260, "speaker": 16, "form": "dlg", "jp": "「キャァ！」"},
{"id": 261, "speaker": 29, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 262, "speaker": 16, "form": "dlg", "jp": "「あ、あそこ！！」"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "「まさか、このゴキブリに！？」"},
{"id": 264, "speaker": 29, "form": "dlg", "jp": "「ナゴム、口をふさいで！！」"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 266, "speaker": 29, "form": "dlg", "jp": "「さっき『呼吸』がどうのって言ってたでしょう？」"},
{"id": 267, "speaker": 29, "form": "dlg", "jp": "「コイツらに大量に『気管』に入られたら‥‥！」"},
{"id": 268, "speaker": 29, "form": "dlg", "jp": "『呼吸ができなくなる！！』"},
{"id": 269, "speaker": 2, "form": "dlg", "jp": "「ウワッ！」"},
{"id": 270, "speaker": 2, "form": "dlg", "jp": "大量の『ゴキブリ』たちが\nボクの口や鼻を目指して登ってくる。"},
{"id": 271, "speaker": 29, "form": "dlg", "jp": "「早く、口と鼻をふさいで！」"},
{"id": 272, "speaker": 29, "form": "choice", "jp": "【ゴキブリたちを退治する】"},
{"id": 273, "speaker": 29, "form": "choice", "jp": "【とにかく口と鼻をふさぐ】"},
{"id": 274, "speaker": 29, "form": "dlg", "jp": "【とにかく口と鼻をふさぐ】"},
{"id": 275, "speaker": 29, "form": "dlg", "jp": "ボクはゴキブリに窒息させられないように\n自ら口と鼻をふさいだ。"},
{"id": 276, "speaker": 29, "form": "dlg", "jp": "もちろん、これにより\nゴキブリの侵入は防げるが、"},
{"id": 277, "speaker": 29, "form": "dlg", "jp": "呼吸ができないことにはかわりがなかった。"},
{"id": 278, "speaker": 29, "form": "dlg", "jp": "早くコイツらをやっつける方法を考えないと‥‥"},
{"id": 279, "speaker": 29, "form": "choice", "jp": "【とにかく、ニギリつぶしてゆく】"},
{"id": 280, "speaker": 29, "form": "choice", "jp": "【部屋の中を見回してみる】"},
{"id": 281, "speaker": 29, "form": "dlg", "jp": "【部屋の中を見回してみる】"},
{"id": 282, "speaker": 29, "form": "dlg", "jp": "何かコイツらを『一掃』できるものは‥‥"},
{"id": 283, "speaker": 29, "form": "dlg", "jp": "数が多すぎて、１匹１匹相手にしてたら、\nコチラの呼吸がつきてしまう。"},
{"id": 284, "speaker": 29, "form": "dlg", "jp": "『殺虫剤』の様に効果的にコイツらを一掃できるものは‥‥"},
{"id": 285, "speaker": 29, "form": "dlg", "jp": "ボクは足下にあった洗剤を拾い上げ、\nそしてそばにあった水槽にその中身をぶちまけた。"},
{"id": 286, "speaker": 29, "form": "dlg", "jp": "「ナゴム、何してるの！」"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "（いいから見てて！）"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「くらえぇっ！」"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "「ガチャーーン！！」"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "ボクは思いっきり水槽をたたき割った。"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "もちろん、それによってボクは大量の\n『せっけん水』をあびてしまった。"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 293, "speaker": 33, "form": "dlg", "jp": "（ウグググググググ‥‥）"},
{"id": 294, "speaker": 33, "form": "dlg", "jp": "ゴキブリに移っている『五島』の意識たちが\nいっせいに苦しみ始めた。"},
{"id": 295, "speaker": 51, "form": "dlg", "jp": "「いったいどういうこと？」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「こんどはコイツが呼吸困難で苦しんでるんだよ‥‥」"},
{"id": 297, "speaker": 51, "form": "dlg", "jp": "「ハァ？」"},
{"id": 298, "speaker": 51, "form": "dlg", "jp": "「今の『ただの洗剤』やろ？」"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "「昆虫はお腹の横の『気孔』っていう\n　小さな穴で呼吸をしてるんだ‥‥」"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "「で、その穴が『せっけん水』で\n　ふさがれちゃったんだよ‥‥」"},
{"id": 301, "speaker": 2, "form": "dlg", "jp": "「はやく、戻らないと窒息しちゃうよ！」"},
{"id": 302, "speaker": 29, "form": "dlg", "jp": "「もう手おくれみたいね‥‥」"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "「手おくれ？」"},
{"id": 304, "speaker": 33, "form": "dlg", "jp": "「アウアウアワワワ‥‥」"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥！」"},
{"id": 306, "speaker": 29, "form": "dlg", "jp": "「多分、意識を細かく分散させすぎて\n　ちゃんと戻れなくなったみたいね‥‥」"},
{"id": 307, "speaker": 29, "form": "dlg", "jp": "「まあ、自業自得ってやつね‥‥」"},
{"id": 308, "speaker": 51, "form": "dlg", "jp": "「じゃあ、コイツは？」"},
{"id": 309, "speaker": 16, "form": "dlg", "jp": "「いったいどういうこと？」"},
{"id": 310, "speaker": 2, "form": "dlg", "jp": "「こんどはコイツが呼吸困難で苦しんでるんだよ‥‥」"},
{"id": 311, "speaker": 16, "form": "dlg", "jp": "「ヘッ？」"},
{"id": 312, "speaker": 16, "form": "dlg", "jp": "「今の『ただの洗剤』でしょう？」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "「昆虫はお腹の横の『気孔』っていう\n　小さな穴で呼吸をしてるんだ‥‥」"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "「で、その穴が『せっけん水』で\n　ふさがれちゃったんだよ‥‥」"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "「はやく、戻らないと窒息しちゃうよ！」"},
{"id": 316, "speaker": 29, "form": "dlg", "jp": "「もう手おくれみたいね‥‥」"},
{"id": 317, "speaker": 2, "form": "dlg", "jp": "「手おくれ？」"},
{"id": 318, "speaker": 33, "form": "dlg", "jp": "「アウアウアワワワ‥‥」"},
{"id": 319, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥！」"},
{"id": 320, "speaker": 29, "form": "dlg", "jp": "「多分、意識を細かく分散させすぎて\n　ちゃんと戻れなくなったみたいね‥‥」"},
{"id": 321, "speaker": 29, "form": "dlg", "jp": "「まあ、自業自得ってやつね‥‥」"},
{"id": 322, "speaker": 16, "form": "dlg", "jp": "「じゃあ、コイツは？」"},
{"id": 323, "speaker": 29, "form": "dlg", "jp": "「もう能力は使えないでしょうね‥‥」"},
{"id": 324, "speaker": 29, "form": "dlg", "jp": "「まあ、仲間にすることはできなくなったけど、\n　コイツの悪さもここまでってことね」"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "「なんか、悪いことしたのかな‥‥」"},
{"id": 326, "speaker": 29, "form": "dlg", "jp": "「気にしなくていいわよ‥‥」"},
{"id": 327, "speaker": 29, "form": "dlg", "jp": "「コイツをあのままにしてたら、\n　たくさんの被害が出てたんだから‥‥」"},
{"id": 328, "speaker": 29, "form": "dlg", "jp": "「とりあえず、\n　この件についてはこれでオシマイよ！」"},
{"id": 329, "speaker": 29, "form": "dlg", "jp": "「さ、帰りましょう！」"},
{"id": 330, "speaker": 29, "form": "dlg", "jp": "ボクたちはこの部屋を立ち去ることにした。"},
{"id": 331, "speaker": 51, "form": "dlg", "jp": "「あーーっ！」"},
{"id": 332, "speaker": 51, "form": "dlg", "jp": "「このドア、"},
{"id": 333, "speaker": 51, "form": "dlg", "jp": "『爆弾』"},
{"id": 334, "speaker": 51, "form": "dlg", "jp": "がセットされたままやん！」"},
{"id": 335, "speaker": 16, "form": "dlg", "jp": "「あーーっ！」"},
{"id": 336, "speaker": 16, "form": "dlg", "jp": "「このドア、"},
{"id": 337, "speaker": 16, "form": "dlg", "jp": "『爆弾』"},
{"id": 338, "speaker": 16, "form": "dlg", "jp": "がセットされたままなんじゃ！」"},
{"id": 339, "speaker": 29, "form": "dlg", "jp": "「そ、そうだったわね‥‥」"},
{"id": 340, "speaker": 2, "form": "dlg", "jp": "「ねえ、『爆弾』を‥‥」"},
{"id": 341, "speaker": 33, "form": "dlg", "jp": "「アウ、ワウワウ‥‥」"},
{"id": 342, "speaker": 2, "form": "dlg", "jp": "「ダメだ‥‥」"},
{"id": 343, "speaker": 2, "form": "dlg", "jp": "「ど、どうしよう？」"},
{"id": 344, "speaker": 4, "form": "dlg", "jp": "「誰か忘れちゃいませんか？」"},
{"id": 345, "speaker": 4, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 346, "speaker": 4, "form": "dlg", "jp": "閉まっていたドアが突然開かれた。"},
{"id": 347, "speaker": 31, "form": "dlg", "jp": "「『爆弾』ならオレが『能力』で解除してやったよ！」"},
{"id": 348, "speaker": 2, "form": "dlg", "jp": "「ケネス！！」"},
{"id": 349, "speaker": 29, "form": "dlg", "jp": "「もう大丈夫なの？」"},
{"id": 350, "speaker": 31, "form": "dlg", "jp": "「アレルギーぐらいで\n　いつまでも寝込んでられるかってんだ！」"},
{"id": 351, "speaker": 2, "form": "dlg", "jp": "「アリガトウ、助かったよ！」"},
{"id": 352, "speaker": 31, "form": "dlg", "jp": "「で、コイツがあの『犬』の正体だったわけか？」"},
{"id": 353, "speaker": 31, "form": "dlg", "jp": "「マヌケな顔してやがるなぁ？」"},
{"id": 354, "speaker": 29, "form": "dlg", "jp": "「そんなマヌケなヤツにやられたのは\n　どこのマヌケかしら？」"},
{"id": 355, "speaker": 31, "form": "dlg", "jp": "「なあ、オレも一発だけ殴っていいか？」"},
{"id": 356, "speaker": 29, "form": "dlg", "jp": "「やめなさい！」"},
{"id": 357, "speaker": 29, "form": "dlg", "jp": "「私たちだって誰も殴ってないんだから‥‥」"},
{"id": 358, "speaker": 31, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 359, "speaker": 31, "form": "dlg", "jp": "「じゃあ、カンベンしてやるか‥‥」"},
{"id": 360, "speaker": 31, "form": "dlg", "jp": "【とにかく、ニギリつぶしてゆく】"},
{"id": 361, "speaker": 31, "form": "dlg", "jp": "この１匹１匹にアイツの意識が転送されてるハズだ‥‥"},
{"id": 362, "speaker": 31, "form": "dlg", "jp": "ボクは１匹１匹、ゴキブリたちを\nニギリつぶしてゆくことにした。"},
{"id": 363, "speaker": 31, "form": "dlg", "jp": "しかし、一向に数が減る気配がない。"},
{"id": 364, "speaker": 31, "form": "dlg", "jp": "なぜだ！？"},
{"id": 365, "speaker": 29, "form": "dlg", "jp": "「ナゴム、そんなのじゃソイツを倒せないわよ！」"},
{"id": 366, "speaker": 2, "form": "dlg", "jp": "（どうして？）"},
{"id": 367, "speaker": 29, "form": "dlg", "jp": "「ソイツ、自分の意識を細かくわけて移してるの！」"},
{"id": 368, "speaker": 29, "form": "dlg", "jp": "「少しぐらいゴキブリを倒しても、\n　本人にはほとんどダメージが無いの！」"},
{"id": 369, "speaker": 2, "form": "dlg", "jp": "（でも、少しはダメージがあるんだろう？）"},
{"id": 370, "speaker": 29, "form": "dlg", "jp": "「でも、あまりにもダメージは小さすぎるわ！」"},
{"id": 371, "speaker": 29, "form": "dlg", "jp": "そんな‥‥"},
{"id": 372, "speaker": 29, "form": "dlg", "jp": "このままでは\nどちらにしても『窒息』してしまう！"},
{"id": 373, "speaker": 29, "form": "dlg", "jp": "何か‥‥"},
{"id": 374, "speaker": 29, "form": "dlg", "jp": "何か方法があるハズだ‥‥"},
{"id": 375, "speaker": 29, "form": "dlg", "jp": "ダメだ‥‥"},
{"id": 376, "speaker": 29, "form": "dlg", "jp": "このままでは\nどちらにしても『窒息』してしまう！"},
{"id": 377, "speaker": 29, "form": "dlg", "jp": "何か‥‥"},
{"id": 378, "speaker": 29, "form": "dlg", "jp": "何か方法があるハズだ‥‥"},
{"id": 379, "speaker": 29, "form": "choice", "jp": "【とにかく、ニギリつぶしてゆく】"},
{"id": 380, "speaker": 29, "form": "choice", "jp": "【部屋の中を見回してみる】"},
{"id": 381, "speaker": 29, "form": "dlg", "jp": "【とにかく、ニギリつぶしてゆく】"},
{"id": 382, "speaker": 29, "form": "dlg", "jp": "ダメージが小さいといっても\n確実に少しづつはダメージを与えているハズ‥‥"},
{"id": 383, "speaker": 29, "form": "dlg", "jp": "だんだん、ボクの呼吸も限界が近付いている。"},
{"id": 384, "speaker": 29, "form": "dlg", "jp": "ボクは１匹１匹、ゴキブリたちを\nニギリつぶしてゆくことにした。"},
{"id": 385, "speaker": 29, "form": "dlg", "jp": "しかし‥‥"},
{"id": 386, "speaker": 29, "form": "dlg", "jp": "ゴキブリたちの攻撃は一向に治まりそうもない。"},
{"id": 387, "speaker": 29, "form": "dlg", "jp": "なぜなんだ！？"},
{"id": 388, "speaker": 29, "form": "dlg", "jp": "「ナゴム、ダメよ！」"},
{"id": 389, "speaker": 29, "form": "dlg", "jp": "「作戦を切り替えなさい！」"},
{"id": 390, "speaker": 2, "form": "dlg", "jp": "（どうして？）"},
{"id": 391, "speaker": 29, "form": "dlg", "jp": "「ソイツ、\n　やられる瞬間に意識を別のゴキブリに逃がしているわ！」"},
{"id": 392, "speaker": 2, "form": "dlg", "jp": "（なんだって！？）"},
{"id": 393, "speaker": 2, "form": "dlg", "jp": "そんな‥‥"},
{"id": 394, "speaker": 2, "form": "dlg", "jp": "このままでは\nどちらにしても『窒息』してしまう！"},
{"id": 395, "speaker": 2, "form": "dlg", "jp": "何か‥‥"},
{"id": 396, "speaker": 2, "form": "dlg", "jp": "何か方法があるハズだ‥‥"},
{"id": 397, "speaker": 2, "form": "dlg", "jp": "ダメだ‥‥"},
{"id": 398, "speaker": 2, "form": "dlg", "jp": "このままでは\nどちらにしても『窒息』してしまう！"},
{"id": 399, "speaker": 2, "form": "dlg", "jp": "何か‥‥"},
{"id": 400, "speaker": 2, "form": "dlg", "jp": "何か方法があるハズだ‥‥"},
{"id": 401, "speaker": 2, "form": "choice", "jp": "【できるだけ素早くニギリつぶしてゆく】"},
{"id": 402, "speaker": 2, "form": "choice", "jp": "【部屋の中を見回してみる】"},
{"id": 403, "speaker": 2, "form": "dlg", "jp": "【できるだけ素早くニギリつぶしてゆく】"},
{"id": 404, "speaker": 2, "form": "dlg", "jp": "ボクはヤツの意識に逃げるスキを与えないように\nできるだけ素早くゴキブリたちをニギリつぶすことにした。"},
{"id": 405, "speaker": 2, "form": "dlg", "jp": "早くしないともう呼吸が限界になってきている。"},
{"id": 406, "speaker": 2, "form": "dlg", "jp": "ちっくしょう！"},
{"id": 407, "speaker": 2, "form": "dlg", "jp": "これでもか！"},
{"id": 408, "speaker": 2, "form": "dlg", "jp": "ゴキブリたちの攻撃は\n一向に弱まる気配がない。"},
{"id": 409, "speaker": 2, "form": "dlg", "jp": "だんだんくるしくなる‥‥"},
{"id": 410, "speaker": 2, "form": "dlg", "jp": "しかし、今攻撃をやめることはできない。"},
{"id": 411, "speaker": 2, "form": "dlg", "jp": "だめだ‥‥"},
{"id": 412, "speaker": 2, "form": "dlg", "jp": "もう、呼吸を止めてられる限界だ‥‥"},
{"id": 413, "speaker": 2, "form": "dlg", "jp": "これ以上は息を止めてられない！"},
{"id": 414, "speaker": 2, "form": "dlg", "jp": "ボクはふさいでいた口と鼻を解放して\n思いきり息を吸い込もうとした。"},
{"id": 415, "speaker": 2, "form": "dlg", "jp": "その瞬間！！"},
{"id": 416, "speaker": 29, "form": "dlg", "jp": "「ダメっ！！」"},
{"id": 417, "speaker": 29, "form": "dlg", "jp": "その瞬間、解放されたボクの口や鼻めがけて\nゴキブリたちがなだれこんできた。"},
{"id": 418, "speaker": 29, "form": "dlg", "jp": "ボクは必死で吐き出そうとするが、\nすでに口の中はゴキブリだらけで"},
{"id": 419, "speaker": 29, "form": "dlg", "jp": "舌を動かすこともできない。"},
{"id": 420, "speaker": 29, "form": "dlg", "jp": "うっ‥‥"},
{"id": 421, "speaker": 29, "form": "dlg", "jp": "だんだん頭がぼーっとしてきた‥‥"},
{"id": 422, "speaker": 29, "form": "dlg", "jp": "なんとかしないと‥‥"},
{"id": 423, "speaker": 29, "form": "dlg", "jp": "なんとか‥‥"},
{"id": 424, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 425, "speaker": 29, "form": "dlg", "jp": "【ゴキブリたちを退治する】"},
{"id": 426, "speaker": 29, "form": "dlg", "jp": "数は多いかもしれないけど、単なるゴキブリだ。\nそんなに恐れる必要はないだろう‥‥"},
{"id": 427, "speaker": 29, "form": "dlg", "jp": "ボクはかたっぱしからゴキブリたちを\n退治してゆくことにした。"},
{"id": 428, "speaker": 29, "form": "dlg", "jp": "「何してるのっ！」"},
{"id": 429, "speaker": 2, "form": "dlg", "jp": "「コイツらただのゴキブ‥‥\n　ウガガッ‥‥ペッ！」"},
{"id": 430, "speaker": 2, "form": "dlg", "jp": "「ブリだろう‥‥ゴボボ‥‥\n　ペッ、ペッ！」"},
{"id": 431, "speaker": 2, "form": "dlg", "jp": "『ゴキブリ』たちはどんどんボクの口の中へ入ってくる。"},
{"id": 432, "speaker": 29, "form": "dlg", "jp": "「早く口をふさぎなさいっ！」"},
{"id": 433, "speaker": 29, "form": "choice", "jp": "【引き続きゴキブリを攻撃する】"},
{"id": 434, "speaker": 29, "form": "choice", "jp": "【とにかく口と鼻をふさぐ】"},
{"id": 435, "speaker": 29, "form": "dlg", "jp": "【引き続きゴキブリを攻撃する】"},
{"id": 436, "speaker": 29, "form": "dlg", "jp": "ゴキブリに意識を転送してるってことは\nゴキブリを倒せば本体の意識にもダメージが‥‥"},
{"id": 437, "speaker": 29, "form": "dlg", "jp": "「ナゴム、ダメよ！」"},
{"id": 438, "speaker": 29, "form": "dlg", "jp": "「コイツ自分の意識を細かくわけて移してるの！」"},
{"id": 439, "speaker": 29, "form": "dlg", "jp": "「少しぐらいゴキブリを倒しても、\n　コイツ本人にはほとんどダメージは無いわよ！」"},
{"id": 440, "speaker": 2, "form": "dlg", "jp": "「でも、他に‥‥ゲゲボッ！」"},
{"id": 441, "speaker": 2, "form": "dlg", "jp": "「コイツを‥‥ゴボボッ！‥‥」"},
{"id": 442, "speaker": 2, "form": "dlg", "jp": "ボクの口の中はゴキブリだらけで、\nだんだんと会話もままならなくなってきた。"},
{"id": 443, "speaker": 29, "form": "dlg", "jp": "「早く口をふさいで！！」"},
{"id": 444, "speaker": 29, "form": "choice", "jp": "【引き続きゴキブリを攻撃する】"},
{"id": 445, "speaker": 29, "form": "choice", "jp": "【とにかく口と鼻をふさぐ】"},
{"id": 446, "speaker": 29, "form": "dlg", "jp": "【引き続きゴキブリを攻撃する】"},
{"id": 447, "speaker": 29, "form": "dlg", "jp": "例え口をふさいだからといって、\nコイツを倒せるわけではない。"},
{"id": 448, "speaker": 29, "form": "dlg", "jp": "呼吸を止めておかなくてはならないのは同じことだ‥‥"},
{"id": 449, "speaker": 29, "form": "dlg", "jp": "それよりも、少しでもコイツにダメージを与える方が‥‥"},
{"id": 450, "speaker": 29, "form": "dlg", "jp": "「ダメだってば！」"},
{"id": 451, "speaker": 29, "form": "dlg", "jp": "「アンタにニギリ潰される前に\n　コイツの意識は別のゴキブリに移動しているわ！」"},
{"id": 452, "speaker": 2, "form": "dlg", "jp": "（なんだって！？）"},
{"id": 453, "speaker": 29, "form": "dlg", "jp": "「早く、『気道』を確保して！」"},
{"id": 454, "speaker": 2, "form": "dlg", "jp": "「ウグッ‥‥」"},
{"id": 455, "speaker": 2, "form": "dlg", "jp": "ボクは必死で吐き出そうとするが、\nすでに口の中はゴキブリだらけで"},
{"id": 456, "speaker": 2, "form": "dlg", "jp": "舌を動かすこともできない。"},
{"id": 457, "speaker": 2, "form": "dlg", "jp": "うっ‥‥"},
{"id": 458, "speaker": 2, "form": "dlg", "jp": "だんだん頭がぼーっとしてきた‥‥"},
{"id": 459, "speaker": 2, "form": "dlg", "jp": "なんとかしないと‥‥"},
{"id": 460, "speaker": 2, "form": "dlg", "jp": "なんとか‥‥"},
{"id": 461, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 462, "speaker": 2, "form": "dlg", "jp": "ダメだ‥‥"},
{"id": 463, "speaker": 2, "form": "dlg", "jp": "どうしていいのかわからない！"},
{"id": 464, "speaker": 2, "form": "dlg", "jp": "『ゴキブリ』たちはどんどんボクの口の中へ入ってくる。"},
{"id": 465, "speaker": 2, "form": "dlg", "jp": "「オエッ！」"},
{"id": 466, "speaker": 2, "form": "dlg", "jp": "「ペッ！ペッ！」"},
{"id": 467, "speaker": 2, "form": "dlg", "jp": "ボクは必死で吐き出そうとするが、\nぜんぜん間に合わない。"},
{"id": 468, "speaker": 2, "form": "dlg", "jp": "ボクの口の中はあっと言う間に\n『ゴキブリ』だらけになってしまった。"},
{"id": 469, "speaker": 2, "form": "dlg", "jp": "こ、呼吸ができない‥‥"},
{"id": 470, "speaker": 29, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 471, "speaker": 29, "form": "dlg", "jp": "うっ‥‥"},
{"id": 472, "speaker": 29, "form": "dlg", "jp": "だんだん頭がぼーっとしてきた‥‥"},
{"id": 473, "speaker": 29, "form": "dlg", "jp": "なんとかしないと‥‥"},
{"id": 474, "speaker": 29, "form": "dlg", "jp": "なんとか‥‥"},
{"id": 475, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 476, "speaker": 2, "form": "dlg", "jp": "「よし、踏み込もう！！」"},
{"id": 477, "speaker": 2, "form": "dlg", "jp": "ボクたち『五島』の部屋に一気に踏み込むことにした。"},
{"id": 478, "speaker": 2, "form": "dlg", "jp": "「ガチャ！　ガチャ！」"},
{"id": 479, "speaker": 29, "form": "dlg", "jp": "「ダメ、カギがかかってるわ！」"},
{"id": 480, "speaker": 2, "form": "dlg", "jp": "「まかしといて！」"},
{"id": 481, "speaker": 2, "form": "dlg", "jp": "ボクは『能力』を使って、\n自分の右腕をパワーアップした。"},
{"id": 482, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 483, "speaker": 2, "form": "dlg", "jp": "「ガキーン！」"},
{"id": 484, "speaker": 2, "form": "dlg", "jp": "カギのかかっているドアを破壊した。"},
{"id": 485, "speaker": 2, "form": "dlg", "jp": "「これで大丈夫だ‥‥」"},
{"id": 486, "speaker": 2, "form": "dlg", "jp": "「さあ、入るよ‥‥」"},
{"id": 487, "speaker": 2, "form": "dlg", "jp": "ボクは部屋のドアをいきおいよく開いた。"},
{"id": 488, "speaker": 2, "form": "dlg", "jp": "「バーン！！」"},
{"id": 489, "speaker": 2, "form": "dlg", "jp": "その瞬間！！"},
{"id": 490, "speaker": 52, "form": "dlg", "jp": "「ガウガウガウ！！」"},
{"id": 491, "speaker": 52, "form": "dlg", "jp": "部屋の中からキバをむいた『犬』が飛び出してきて\nボクのノドもとにかみついた。"},
{"id": 492, "speaker": 52, "form": "dlg", "jp": "ボクはとっさのできごとに\nまったく対処することができなかった。"},
{"id": 493, "speaker": 29, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 494, "speaker": 29, "form": "dlg", "jp": "目の前が血で真っ赤にそまる。"},
{"id": 495, "speaker": 51, "form": "dlg", "jp": "「しかし、なんか後味の悪い結末やな‥‥」"},
{"id": 496, "speaker": 2, "form": "dlg", "jp": "「結局、\n　『ノア』も持ってなかったし‥‥」"},
{"id": 497, "speaker": 29, "form": "dlg", "jp": "「まあ、\n　そんな簡単に見つかるとは思ってないし‥‥」"},
{"id": 498, "speaker": 29, "form": "dlg", "jp": "「それにイヤな事件が\n　１つ解決したんだからいいんじゃない？」"},
{"id": 499, "speaker": 51, "form": "dlg", "jp": "「まあ、これで\n　残りの１人が『ノア』を持っているって」"},
{"id": 500, "speaker": 51, "form": "dlg", "jp": "「決まったわけやけどな！」"},
{"id": 501, "speaker": 31, "form": "dlg", "jp": "「そうだ、伝えるのを忘れてた！」"},
{"id": 502, "speaker": 29, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 503, "speaker": 31, "form": "dlg", "jp": "「本部から連絡が入ったんだよ！」"},
{"id": 504, "speaker": 29, "form": "dlg", "jp": "「なんて？」"},
{"id": 505, "speaker": 31, "form": "dlg", "jp": "「残りの１人の『念』をキャッチしたって‥‥」"},
{"id": 506, "speaker": 29, "form": "dlg", "jp": "「なんですって！？」"},
{"id": 507, "speaker": 31, "form": "dlg", "jp": "「やっぱり、『法則』通りらしい‥‥」"},
{"id": 508, "speaker": 51, "form": "dlg", "jp": "「『法則』！？」"},
{"id": 509, "speaker": 31, "form": "dlg", "jp": "「『能力者同士はひかれあう』‥‥」"},
{"id": 510, "speaker": 29, "form": "dlg", "jp": "「じゃあ、ソイツも？」"},
{"id": 511, "speaker": 31, "form": "dlg", "jp": "「"},
{"id": 512, "speaker": 31, "form": "dlg", "jp": "この町にいる"},
{"id": 513, "speaker": 31, "form": "dlg", "jp": "みたいだぜ‥‥」"},
{"id": 514, "speaker": 2, "form": "dlg", "jp": "「なんだって！」"},
{"id": 515, "speaker": 29, "form": "dlg", "jp": "「で、いったいどこに！？」"},
{"id": 516, "speaker": 4, "form": "dlg", "jp": "「ここにいるよ！」"},
{"id": 517, "speaker": 4, "form": "dlg", "jp": "ボクたちの頭上から聞き覚えのある声が鳴り響いた。"},
{"id": 518, "speaker": 31, "form": "dlg", "jp": "「誰だっ！」"},
{"id": 519, "speaker": 2, "form": "dlg", "jp": "「で、出口‥‥」"},
{"id": 520, "speaker": 2, "form": "dlg", "jp": "それはとなりのクラスの『転校生』の\n『出口エイジ』だった‥‥"},
{"id": 521, "speaker": 31, "form": "dlg", "jp": "「知り合いか？」"},
{"id": 522, "speaker": 51, "form": "dlg", "jp": "「同じ学校の生徒や‥‥」"},
{"id": 523, "speaker": 16, "form": "dlg", "jp": "「でも、なんだか後味の悪い結末よね‥‥」"},
{"id": 524, "speaker": 2, "form": "dlg", "jp": "「結局、\n　『ノア』も持ってなかったし‥‥」"},
{"id": 525, "speaker": 29, "form": "dlg", "jp": "「まあ、\n　そんな簡単に見つかるとは思ってないし‥‥」"},
{"id": 526, "speaker": 29, "form": "dlg", "jp": "「それにイヤな事件が\n　１つ解決したんだからいいんじゃない？」"},
{"id": 527, "speaker": 16, "form": "dlg", "jp": "「でも、これで\n　残りの１人が『ノア』を持っているって」"},
{"id": 528, "speaker": 16, "form": "dlg", "jp": "「決まっちゃったわけだけどね！」"},
{"id": 529, "speaker": 31, "form": "dlg", "jp": "「そうだ、伝えるのを忘れてた！」"},
{"id": 530, "speaker": 29, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 531, "speaker": 31, "form": "dlg", "jp": "「本部から連絡が入った」"},
{"id": 532, "speaker": 29, "form": "dlg", "jp": "「なんて？」"},
{"id": 533, "speaker": 31, "form": "dlg", "jp": "「残りの１人の『念』をキャッチしたって‥‥」"},
{"id": 534, "speaker": 29, "form": "dlg", "jp": "「なんですって！？」"},
{"id": 535, "speaker": 31, "form": "dlg", "jp": "「やっぱり、『法則』通りらしい‥‥」"},
{"id": 536, "speaker": 16, "form": "dlg", "jp": "「『法則』！？」"},
{"id": 537, "speaker": 31, "form": "dlg", "jp": "「『能力者同士はひかれあう』‥‥」"},
{"id": 538, "speaker": 29, "form": "dlg", "jp": "「じゃあ、ソイツも？」"},
{"id": 539, "speaker": 31, "form": "dlg", "jp": "「"},
{"id": 540, "speaker": 31, "form": "dlg", "jp": "この町にいる"},
{"id": 541, "speaker": 31, "form": "dlg", "jp": "みたいだぜ‥‥」"},
{"id": 542, "speaker": 2, "form": "dlg", "jp": "「なんだって！」"},
{"id": 543, "speaker": 29, "form": "dlg", "jp": "「で、いったいどこに！？」"},
{"id": 544, "speaker": 4, "form": "dlg", "jp": "「ここにいるよ！」"},
{"id": 545, "speaker": 4, "form": "dlg", "jp": "ボクたちの頭上から聞き覚えのある声が鳴り響いた。"},
{"id": 546, "speaker": 31, "form": "dlg", "jp": "「誰だっ！」"},
{"id": 547, "speaker": 2, "form": "dlg", "jp": "「で、出口‥‥」"},
{"id": 548, "speaker": 2, "form": "dlg", "jp": "それはとなりのクラスの『転校生』の\n『出口エイジ』だった‥‥"},
{"id": 549, "speaker": 31, "form": "dlg", "jp": "「知り合いか？」"},
{"id": 550, "speaker": 16, "form": "dlg", "jp": "「同じ学校の生徒よ‥‥」"},
{"id": 551, "speaker": 50, "form": "dlg", "jp": "「ボクを探してるんだろう？」"},
{"id": 552, "speaker": 2, "form": "dlg", "jp": "「キミも『能力者』なのか？」"},
{"id": 553, "speaker": 50, "form": "dlg", "jp": "「そうだよ‥‥」"},
{"id": 554, "speaker": 2, "form": "dlg", "jp": "「ジーン、どうなの？」"},
{"id": 555, "speaker": 29, "form": "dlg", "jp": "「間違いないわ‥‥」"},
{"id": 556, "speaker": 29, "form": "dlg", "jp": "「『能力者』の『波』を感じるわ‥‥」"},
{"id": 557, "speaker": 50, "form": "dlg", "jp": "「さすがは『Ｅ－ｇｒｏ』（イーグル）１の\n　『感知能力者』だね‥‥」"},
{"id": 558, "speaker": 29, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 559, "speaker": 29, "form": "dlg", "jp": "「で、わざわざ出て来たってことは‥‥」"},
{"id": 560, "speaker": 29, "form": "dlg", "jp": "「『ノア』を返す気になったってこと？」"},
{"id": 561, "speaker": 50, "form": "dlg", "jp": "「さあ、どうだろう？」"},
{"id": 562, "speaker": 31, "form": "dlg", "jp": "「オイ、本当に『ノア』を持ってるのか？」"},
{"id": 563, "speaker": 50, "form": "dlg", "jp": "「持っているさ‥‥」"},
{"id": 564, "speaker": 50, "form": "dlg", "jp": "「知ってるだろう？」"},
{"id": 565, "speaker": 50, "form": "dlg", "jp": "「『ノアは能力者のもとを離れない』‥‥」"},
{"id": 566, "speaker": 50, "form": "dlg", "jp": "「まあ、口で言うより見せた方が早いかな？」"},
{"id": 567, "speaker": 29, "form": "dlg", "jp": "「そうね、もし持っているなら\n　とりあえず見せてくれる？」"},
{"id": 568, "speaker": 50, "form": "dlg", "jp": "「じゃあ、見せてやるよ！」"},
{"id": 569, "speaker": 50, "form": "dlg", "jp": "「ちゃんと目を開いて見ろよ！」"},
{"id": 570, "speaker": 50, "form": "dlg", "jp": "「ソラッ！」"},
{"id": 571, "speaker": 29, "form": "dlg", "jp": "「キャッ！」"},
{"id": 572, "speaker": 2, "form": "dlg", "jp": "「ジーン！！」"},
{"id": 573, "speaker": 29, "form": "dlg", "jp": "「目、"},
{"id": 574, "speaker": 29, "form": "dlg", "jp": "目をやられた"},
{"id": 575, "speaker": 29, "form": "dlg", "jp": "わ‥‥」"},
{"id": 576, "speaker": 50, "form": "dlg", "jp": "「それで『感知能力』の\n　うち１つが封じられたわけだ‥‥」"},
{"id": 577, "speaker": 31, "form": "dlg", "jp": "「テメェ、はじめから返すつもりは‥‥」"},
{"id": 578, "speaker": 50, "form": "dlg", "jp": "「当たり前じゃないか‥‥」"},
{"id": 579, "speaker": 50, "form": "dlg", "jp": "「アンタたちはこの『ノアの力』が\n　わかっていないみたいだね‥‥」"},
{"id": 580, "speaker": 51, "form": "dlg", "jp": "「バカにせんといて！」"},
{"id": 581, "speaker": 51, "form": "dlg", "jp": "「それぐらい知ってるわ！」"},
{"id": 582, "speaker": 51, "form": "dlg", "jp": "「『人類を亡びから守る』んやろう！」"},
{"id": 583, "speaker": 16, "form": "dlg", "jp": "「バカにしないで！」"},
{"id": 584, "speaker": 16, "form": "dlg", "jp": "「それぐらい知ってるわよ！」"},
{"id": 585, "speaker": 16, "form": "dlg", "jp": "「『人類を亡びから守る』んでしょ！」"},
{"id": 586, "speaker": 50, "form": "dlg", "jp": "「そんなムダな使い方しか思い付かないんじゃ\n　やっぱりボクが持っておく方がいいみたいだね‥‥」"},
{"id": 587, "speaker": 50, "form": "dlg", "jp": "「じゃあ、失礼するよ‥‥」"},
{"id": 588, "speaker": 50, "form": "dlg", "jp": "「シュン！」"},
{"id": 589, "speaker": 2, "form": "dlg", "jp": "「消えた！」"},
{"id": 590, "speaker": 2, "form": "dlg", "jp": "「シュン！」"},
{"id": 591, "speaker": 50, "form": "dlg", "jp": "「おっと、忘れていた‥‥」"},
{"id": 592, "speaker": 31, "form": "dlg", "jp": "「何っ！」"},
{"id": 593, "speaker": 31, "form": "dlg", "jp": "エイジはいつの間にかボクたちの背後に回っていた。"},
{"id": 594, "speaker": 50, "form": "dlg", "jp": "「ボクは逃げも隠れもしない‥‥」"},
{"id": 595, "speaker": 50, "form": "dlg", "jp": "「ボクと話がしたければいつでも\n　ボクのところへくればいい‥‥」"},
{"id": 596, "speaker": 50, "form": "dlg", "jp": "「じゃあね、常光寺くん‥‥」"},
{"id": 597, "speaker": 50, "form": "dlg", "jp": "「シュン！」"},
{"id": 598, "speaker": 31, "form": "dlg", "jp": "「まちやがれ！」"},
{"id": 599, "speaker": 2, "form": "dlg", "jp": "「ケネス！」"},
{"id": 600, "speaker": 2, "form": "dlg", "jp": "「ジーンを医者に見せる方が先決だよ！」"},
{"id": 601, "speaker": 31, "form": "dlg", "jp": "「そ、そうだな‥‥」"},
{"id": 602, "speaker": 29, "form": "dlg", "jp": "「私は大丈夫だから、\n　『ノア』を取りかえすのよ！」"},
{"id": 603, "speaker": 2, "form": "dlg", "jp": "「そんなの明日でも取りかえしてやるよ！」"},
{"id": 604, "speaker": 2, "form": "dlg", "jp": "「とにかく、病院へ‥‥」"},
{"id": 605, "speaker": 2, "form": "dlg", "jp": "ボクたちはジーンをつれて病院へとかけこんだ。"},
{"id": 606, "speaker": 2, "form": "dlg", "jp": "失敗の原因は判断ミス。\nゴキブリをまとめて退治しないかぎり解決はしない。"},
{"id": 607, "speaker": 2, "form": "dlg", "jp": "失敗の原因はゴキブリ退治にこだわったこと\n１匹１匹退治していても効果はうすい"},
{"id": 608, "speaker": 2, "form": "dlg", "jp": "失敗の原因は慎重さが足りなかったこと\n事前に敵の様子を探ることができたハズ。"}
]
