{"id": 28, "speaker": null, "form": "choice", "jp": "【ナナセ】"},
{"id": 29, "speaker": null, "form": "dlg", "jp": "アイコです。"},
{"id": 30, "speaker": null, "form": "dlg", "jp": "アキラです。"},
{"id": 31, "speaker": null, "form": "dlg", "jp": "ナナセです。"},
{"id": 32, "speaker": null, "form": "dlg", "jp": "誰か死んでますか？"},
{"id": 33, "speaker": null, "form": "choice", "jp": "【死んでる】"},
{"id": 34, "speaker": null, "form": "choice", "jp": "【しんでない】"},
{"id": 35, "speaker": null, "form": "dlg", "jp": "誰も死んでません。"},
{"id": 36, "speaker": null, "form": "dlg", "jp": "誰か死んでます。"},
{"id": 37, "speaker": null, "form": "dlg", "jp": "誰が死んでますか？"},
{"id": 38, "speaker": null, "form": "choice", "jp": "【アイコ】"},
{"id": 39, "speaker": null, "form": "choice", "jp": "【アキラ】"},
{"id": 40, "speaker": null, "form": "choice", "jp": "【ナナセ】"},
{"id": 41, "speaker": null, "form": "dlg", "jp": "アイコが死んでます。"},
{"id": 42, "speaker": null, "form": "dlg", "jp": "アキラが死んでます。"},
{"id": 43, "speaker": null, "form": "dlg", "jp": "ナナセが死んでます。"},
{"id": 44, "speaker": null, "form": "dlg", "jp": "ジーンを気にする？"},
{"id": 45, "speaker": null, "form": "choice", "jp": "【しない】"},
{"id": 46, "speaker": null, "form": "choice", "jp": "【する】"},
{"id": 47, "speaker": null, "form": "dlg", "jp": "【しない】"},
{"id": 48, "speaker": null, "form": "dlg", "jp": "【する】"},
{"id": 49, "speaker": null, "form": "dlg", "jp": "ではゲームスタート！"},
{"id": 50, "speaker": 31, "form": "dlg", "jp": "「よし、終了！！」"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "「また、追加が来なければね‥‥」"},
{"id": 52, "speaker": 29, "form": "dlg", "jp": "「来ないわよ！」"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "「アリスが上手くやってくれているハズだから‥‥」"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "「とにかく、一旦本部に戻りましょう！」"},
{"id": 55, "speaker": 29, "form": "dlg", "jp": "ＵＦＯの事件以降、\n世界中の軍事兵器の暴走が激しくなっていた。"},
{"id": 56, "speaker": 29, "form": "dlg", "jp": "一応『アリス』が『世界中の首脳』に兵器の燃料を\n抜くように『交渉』＆『洗脳』を行っているのだが‥‥"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "世界中にある兵器の量は、\n『アリス』１人では追い付かない状態だった。"},
{"id": 58, "speaker": 35, "form": "dlg", "jp": "「遅かったな？」"},
{"id": 59, "speaker": 31, "form": "dlg", "jp": "「バカ野郎！」"},
{"id": 60, "speaker": 31, "form": "dlg", "jp": "「破壊しても破壊しても次から次と来るんだぞ！」"},
{"id": 61, "speaker": 31, "form": "dlg", "jp": "「アリスが動いてくれなかったら、\n　１００年かけても終わらなかったよ！」"},
{"id": 62, "speaker": 29, "form": "dlg", "jp": "「で、アンタの方はどうなのよ！」"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "「少しは集まったの？」"},
{"id": 64, "speaker": 29, "form": "dlg", "jp": "「『優秀なプログラマー』は？」"},
{"id": 65, "speaker": 35, "form": "dlg", "jp": "「トーゼン！！」"},
{"id": 66, "speaker": 35, "form": "dlg", "jp": "「バッチリだよ！」"},
{"id": 67, "speaker": 35, "form": "dlg", "jp": "「すでに解析の方も順調にすすんでいるよ！」"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "「『解析が進んでる』ってことは\n　『ツトムの考え』が当たってるってこと？」"},
{"id": 69, "speaker": 35, "form": "dlg", "jp": "「なんかそんな感じだね‥‥」"},
{"id": 70, "speaker": 35, "form": "dlg", "jp": "「そうだ、ナゴムくん！」"},
{"id": 71, "speaker": 35, "form": "dlg", "jp": "「コンピュータルームに行ってみろよ！」"},
{"id": 72, "speaker": 35, "form": "dlg", "jp": "「ビックリする人に会えるから‥‥」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「ビックリする人？」"},
{"id": 74, "speaker": 35, "form": "dlg", "jp": "「迷わず行けよ！」"},
{"id": 75, "speaker": 35, "form": "dlg", "jp": "「行けばわかるさ！」"},
{"id": 76, "speaker": 35, "form": "dlg", "jp": "ボクはプログラマーたちが集まっているという\n『コンピュータルーム』に行ってみることにした。"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "「スゴイじゃないですか！」"},
{"id": 78, "speaker": 35, "form": "dlg", "jp": "「どう、スゴイだろう？」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「で、『ビックリする人』って？」"},
{"id": 80, "speaker": 3, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「ね、姉さん！！」"},
{"id": 82, "speaker": 3, "form": "dlg", "jp": "「無事だったのね？」"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "「まあ、今のところね‥‥」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「で、なんで姉さんがここに？」"},
{"id": 85, "speaker": 35, "form": "dlg", "jp": "「世界中の『優秀なプログラマー』を『検索』したら\n　キミのお姉さんもその中にいたんだよ！」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "「やっぱり、姉さんってスゴイんだね！」"},
{"id": 88, "speaker": 4, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「この声は‥‥」"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "「まさか！？」"},
{"id": 91, "speaker": 27, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「父さん！？」"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "「どうして‥‥！？」"},
{"id": 94, "speaker": 27, "form": "dlg", "jp": "「心配かけてすまなかった‥‥」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「本当にホンモノの『父さん』なの？」"},
{"id": 96, "speaker": 27, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「爆発にまきこまれたんじゃぁ？」"},
{"id": 98, "speaker": 27, "form": "dlg", "jp": "「アレは"},
{"id": 99, "speaker": 27, "form": "dlg", "jp": "『ロボット』"},
{"id": 100, "speaker": 27, "form": "dlg", "jp": "だよ‥‥」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "『ロボット』"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "？」"},
{"id": 104, "speaker": 27, "form": "dlg", "jp": "「多分『ルード』は私が死なない限り、\n　ナゴムたちを襲うと思ったから‥‥」"},
{"id": 105, "speaker": 27, "form": "dlg", "jp": "「自分に似せたロボットを爆発させて、\n　"},
{"id": 106, "speaker": 27, "form": "dlg", "jp": "『死んだフリ』"},
{"id": 107, "speaker": 27, "form": "dlg", "jp": "をするしかないと思ってな‥‥」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "「でも、父さんの"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "『歯』"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "が‥‥」"},
{"id": 111, "speaker": 27, "form": "dlg", "jp": "「この歳になると『歯』ぐらい簡単に抜けるよ！」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「そんなぁ～～」"},
{"id": 113, "speaker": 3, "form": "dlg", "jp": "「ちょっと！」"},
{"id": 114, "speaker": 3, "form": "dlg", "jp": "「ナゴムは父さんが生きていて、うれしくないの？」"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "「うれしくないハズないじゃないか！」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「父さんは『プログラマー』じゃないだろう？」"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「どうしてココに？」"},
{"id": 119, "speaker": 5, "form": "dlg", "jp": "「ボクが呼んでもらったんだよ」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「どうして？」"},
{"id": 121, "speaker": 5, "form": "dlg", "jp": "「こちらから『信号』を送り返すのに\n　『接続コネクター』が必要だろう？」"},
{"id": 122, "speaker": 5, "form": "dlg", "jp": "「それを博士に作ってもらおうと思って‥‥」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「って、いうより」"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "「なんで、シローまで‥‥」"},
{"id": 126, "speaker": 5, "form": "dlg", "jp": "「どうやら、この体の前の持ち主は\n　優秀な科学者だったみたいだね‥‥」"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「じゃあ、シローは関係ないじゃないか！」"},
{"id": 128, "speaker": 5, "form": "dlg", "jp": "「関係あるよ！」"},
{"id": 129, "speaker": 5, "form": "dlg", "jp": "「たしかに、前の持ち主の『意識』は消滅しているけど」"},
{"id": 130, "speaker": 5, "form": "dlg", "jp": "「『知識』は消滅していないからね！」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「そういうものなの？」"},
{"id": 132, "speaker": 5, "form": "dlg", "jp": "「そういうものみたいだね」"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "「で、そのコネクターは作れそうなの？」"},
{"id": 134, "speaker": 27, "form": "dlg", "jp": "「正直、難しいな‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「そうなの？」"},
{"id": 136, "speaker": 27, "form": "dlg", "jp": "「いや、シローの言う通りのタイプの信号なら\n　装置を作るのはそんなに難しくはなさそうなんだが‥‥」"},
{"id": 137, "speaker": 27, "form": "dlg", "jp": "「『接続方法』が‥‥」"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 139, "speaker": 27, "form": "dlg", "jp": "「あの『アカシックレコード』は\n　"},
{"id": 140, "speaker": 27, "form": "dlg", "jp": "『破壊することができない』"},
{"id": 141, "speaker": 27, "form": "dlg", "jp": "んだ‥‥」"},
{"id": 142, "speaker": 27, "form": "dlg", "jp": "「キズをつけることさえも‥‥」"},
{"id": 143, "speaker": 27, "form": "dlg", "jp": "「つまり、"},
{"id": 144, "speaker": 27, "form": "dlg", "jp": "接続端子を取り付ける方法がない"},
{"id": 145, "speaker": 27, "form": "dlg", "jp": "んだよ」"},
{"id": 146, "speaker": 27, "form": "dlg", "jp": "「現時点では‥‥」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 148, "speaker": 27, "form": "dlg", "jp": "「まあ、時間の許すかぎり方法を考えてみるがな‥‥」"},
{"id": 149, "speaker": 35, "form": "dlg", "jp": "「がんばってください！」"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "「ナゴム、とりあえずここは彼らにまかせて\n　私たちは次の出動に向けて少し体を休ませましょう！」"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「じゃあ、少し休んでくるから‥‥」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「また後で‥‥」"},
{"id": 154, "speaker": 27, "form": "dlg", "jp": "「ああ、そうしなさい‥‥」"},
{"id": 155, "speaker": 27, "form": "dlg", "jp": "ボクたちは宿泊棟に戻って休憩することにした。"},
{"id": 156, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん！」"},
{"id": 157, "speaker": 15, "form": "dlg", "jp": "「お疲れさま‥‥」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "「どう、なにか『夢』見た？」"},
{"id": 160, "speaker": 15, "form": "dlg", "jp": "「それが、全然なの‥‥」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 162, "speaker": 15, "form": "dlg", "jp": "「今から休むとこなんでしょう？」"},
{"id": 163, "speaker": 15, "form": "dlg", "jp": "「十分に体を休めてね！」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「アリガト‥‥」"},
{"id": 165, "speaker": 16, "form": "dlg", "jp": "「常光寺くん！」"},
{"id": 166, "speaker": 16, "form": "dlg", "jp": "「お疲れさま‥‥」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「どう、なにか『夢』見た？」"},
{"id": 169, "speaker": 16, "form": "dlg", "jp": "「それが、全然なの‥‥」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 171, "speaker": 16, "form": "dlg", "jp": "「今から休むとこなんでしょう？」"},
{"id": 172, "speaker": 16, "form": "dlg", "jp": "「十分に体を休めてね！」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「アリガト‥‥」"},
{"id": 174, "speaker": 18, "form": "dlg", "jp": "「常光寺くん！」"},
{"id": 175, "speaker": 18, "form": "dlg", "jp": "「お疲れさま‥‥」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「どう、なにか『夢』見た？」"},
{"id": 178, "speaker": 18, "form": "dlg", "jp": "「それが、全然なの‥‥」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 180, "speaker": 18, "form": "dlg", "jp": "「今から休むとこなんでしょう？」"},
{"id": 181, "speaker": 18, "form": "dlg", "jp": "「十分に体を休めてね！」"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "「アリガト‥‥」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 185, "speaker": 29, "form": "dlg", "jp": "「しっかり休んでね‥‥」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 187, "speaker": 29, "form": "dlg", "jp": "「じゃあ、４時間後に呼びに来るから‥‥」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「うん」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "「ちゃんと休むのよ！」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「わかってるって！」"},
{"id": 192, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "（じゃあ休むとするか‥‥）"},
{"id": 195, "speaker": 2, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "ベッドに横になったボクは父さんや姉さんのコトを考えた。"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "（父さんが生きていたのはウレシイけど‥‥）"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "（また家族全員、事件に巻き込まれてるんだよな‥‥）"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "（なんなんだろう、ウチの一家って？）"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "（‥‥‥）"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "（まあ、父さんが生きていただけでも感謝しないとな‥‥）"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "（とにかく、姉さんたちもがんばってるんだ）"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "（ボクもがんばらないとな‥‥）"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "（そのためにも少し眠るとするか‥‥）"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "ボクは体調を整えるために少し眠ることにした。"}
]
