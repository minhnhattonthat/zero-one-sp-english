[
{"id": 0, "speaker": null, "form": "dlg", "jp": "「バタン！」"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "そこにはおかしな機械につながったまま\n気絶した清田さんの姿があった。"},
{"id": 2, "speaker": 2, "form": "dlg", "jp": "「清田さん！」"},
{"id": 3, "speaker": 29, "form": "dlg", "jp": "「かなり、ひどくやられてるみたいね‥‥」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「なんで機械につながってるんだろう？」"},
{"id": 5, "speaker": 29, "form": "dlg", "jp": "「あの機械ってもしかして？」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「たぶんそうだと思うよ‥‥」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥！？」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「もしかして！」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "「この機械を使って『精神』を\n　『バックアップ』したんじゃ？」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「それで『精神の形』が変わったとか？」"},
{"id": 11, "speaker": 29, "form": "dlg", "jp": "「違うわね！」"},
{"id": 12, "speaker": 29, "form": "dlg", "jp": "「あの時はこんな機械はなかったもの！」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「小型化に成功したって言ってたけど‥‥」"},
{"id": 14, "speaker": 29, "form": "dlg", "jp": "「機械に精神を送り込めても、\n　今度は転送する側の入れ物となる人間がいるでしょう？」"},
{"id": 15, "speaker": 29, "form": "dlg", "jp": "「それがいなかったのよ？」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「清田さんがマイちゃんに転送できたのは\n　側にマイちゃんをスタンバイさせてたからなんだ」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「じゃあ、別の方法で形を変えてると‥‥」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「どう、やっぱりまだ『イメージ』をキャッチできない？」"},
{"id": 20, "speaker": 29, "form": "dlg", "jp": "「ダメね‥‥」"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "「それよりこの音、気にならない？」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「機械の音だろう？」"},
{"id": 23, "speaker": 29, "form": "dlg", "jp": "「違うわ！」"},
{"id": 24, "speaker": 29, "form": "dlg", "jp": "「それとは別の小さな音が聞こえるでしょう？」"},
{"id": 25, "speaker": 29, "form": "dlg", "jp": "たしかに、うっすらとだかジーンの言う通り\n背筋がゾっとするような音が聞こえる。"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「本当だ！」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「この辺から聞こえるね‥‥」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "ボクは音のする方をのぞきこんだ。"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "すると！"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥！！」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "とつぜん、\n物陰からゴキブリがボクに襲いかかってきた。"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "「まさか、このゴキブリに！？」"},
{"id": 33, "speaker": 29, "form": "dlg", "jp": "「そうか、人間以外のものにも意識を移せたのね！」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「人間以外の形になってたから\n　ジーンのレーダーが感知できなかったんだ！」"},
{"id": 35, "speaker": 33, "form": "dlg", "jp": "（ハハハハハ‥‥）"},
{"id": 36, "speaker": 33, "form": "dlg", "jp": "（ひっかかったな！）"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "「テレパシーが使えるのか？」"},
{"id": 38, "speaker": 33, "form": "dlg", "jp": "（使えるさ！！）"},
{"id": 39, "speaker": 33, "form": "dlg", "jp": "（オレが『精神攻撃』だけしかできないと思ったのか？）"},
{"id": 40, "speaker": 33, "form": "dlg", "jp": "（オレはライオンだろうがオオカミだろうが\n　自由にあやつれるんだよ！）"},
{"id": 41, "speaker": 29, "form": "dlg", "jp": "「じゃあ、あの時も？」"},
{"id": 42, "speaker": 33, "form": "dlg", "jp": "（近くに犬が何匹かいただろう？）"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「ハハハハハハハハ‥‥」"},
{"id": 44, "speaker": 33, "form": "dlg", "jp": "（何がおかしい？）"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「ライオンやオオカミならともかく、\n　ゴキブリが人間を倒せるとでも？」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「じゃあね！」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「グチャ！」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "ボクはゴキブリを踏みつぶした。"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "しかし‥‥"},
{"id": 50, "speaker": 33, "form": "dlg", "jp": "（イタクもカユクもないぜ！！）"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 52, "speaker": 33, "form": "dlg", "jp": "（オレのように頭のいい人間の『精神』が\n　１匹の虫に入ると思ったのか？）"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「コ、コレは！」"},
{"id": 54, "speaker": 33, "form": "dlg", "jp": "（コイツらすべてでオレなんだよ！）"},
{"id": 55, "speaker": 33, "form": "dlg", "jp": "（今、オマエが踏みつぶしたのは\n　髪の毛を一本抜かれた程度なんだよ！）"},
{"id": 56, "speaker": 33, "form": "dlg", "jp": "（じゃあ、反撃させてもらうぜ！）"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "「ナゴム、口をふさいで！！」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 59, "speaker": 29, "form": "dlg", "jp": "「コイツらに大量に『気管』に入られたら‥‥！」"},
{"id": 60, "speaker": 29, "form": "dlg", "jp": "『呼吸ができなくなる！！』"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "「ウワッ！」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "大量の『ゴキブリ』たちが\nボクの口や鼻を目指して登ってくる。"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "「早く、口と鼻をふさいで！」"},
{"id": 64, "speaker": 29, "form": "choice", "jp": "【ゴキブリたちを退治する。】"},
{"id": 65, "speaker": 29, "form": "choice", "jp": "【とにかく口と鼻をふさぐ。】"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "【ゴキブリたちを退治する。】"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "数は多いかもしれないけど、単なるゴキブリだ。\nそんなに恐れる必要はないだろう‥‥"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "ボクはかたっぱしからゴキブリたちを\n退治してゆくことにした。"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "「何してるのっ！」"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "「コイツらただのゴキブ‥‥\n　ウガガッ‥‥ペッ！」"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "「ブリだろう‥‥ゴボボ‥‥\n　ペッ！　ペッ！」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "『ゴキブリ』たちはどんどんボクの口の中へ入ってくる。"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「早く口をふさぎなさいっ！」"},
{"id": 74, "speaker": 29, "form": "choice", "jp": "【引き続きゴキブリを攻撃する。】"},
{"id": 75, "speaker": 29, "form": "choice", "jp": "【とにかく口と鼻をふさぐ。】"},
{"id": 76, "speaker": 29, "form": "dlg", "jp": "【引き続きゴキブリを攻撃する。】"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "ゴキブリに意識を転送してるってことは\nゴキブリを倒せば本体の意識にもダメージが‥‥"},
{"id": 78, "speaker": 29, "form": "dlg", "jp": "「ナゴム、ダメよ！」"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "「コイツ自分の意識を細かくわけて移してるの！」"},
{"id": 80, "speaker": 29, "form": "dlg", "jp": "「少しぐらいゴキブリを倒しても、\n　コイツ本人にはほとんどダメージは無いわよ！」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「でも、他に‥‥ゲゲボッ！」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「コイツを‥‥ゴボボッ！‥‥」"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "ボクの口の中はゴキブリだらけで、\nだんだんと会話もままならなくなってきた。"},
{"id": 84, "speaker": 29, "form": "dlg", "jp": "「早く口をふさいで！！」"},
{"id": 85, "speaker": 29, "form": "choice", "jp": "【引き続きゴキブリを攻撃する】"},
{"id": 86, "speaker": 29, "form": "choice", "jp": "【とにかく口と鼻をふさぐ。】"},
{"id": 87, "speaker": 29, "form": "dlg", "jp": "【引き続きゴキブリを攻撃する。】"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "例え口をふさいだからといって、\nコイツを倒せるわけではない。"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "呼吸を止めておかなくてはならないのは同じことだ‥‥"},
{"id": 90, "speaker": 29, "form": "dlg", "jp": "それよりも、少しでもコイツにダメージを与える方が‥‥"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "「ダメだってば！」"},
{"id": 92, "speaker": 29, "form": "dlg", "jp": "「アンタにニギリ潰される前に\n　コイツの意識は別のゴキブリに移動しているわ！」"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "（なんだって！？）"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "「早く、『気道』を確保して！」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「ウグッ‥‥」"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "ボクは必死で吐き出そうとするが、\nすでに口の中はゴキブリだらけで"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "舌を動かすこともできない。"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "うっ‥‥"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "だんだん頭がぼーっとしてきた‥‥"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "なんとかしないと‥‥"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "なんとか‥‥"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "ダメだ‥‥"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "どうしていいのかわからない！"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "『ゴキブリ』たちはどんどんボクの口の中へ入ってくる。"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「オエッ！」"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「ペッ！　ペッ！」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "ボクは必死で吐き出そうとするが、\nぜんぜん間に合わない。"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "ボクの口の中はあっと言う間に\n『ゴキブリ』だらけになってしまった。"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "こ、呼吸ができない‥‥"},
{"id": 111, "speaker": 29, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "うっ‥‥"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "だんだん頭がぼーっとしてきた‥‥"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "なんとかしないと‥‥"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "なんとか‥‥"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "【とにかく口と鼻をふさぐ。】"},
{"id": 118, "speaker": 29, "form": "dlg", "jp": "ボクはゴキブリに窒息させられないように\n自ら口と鼻をふさいだ。"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "もちろん、これにより\nゴキブリの侵入は防げるが、"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "呼吸ができないことにはかわりがなかった。"},
{"id": 121, "speaker": 29, "form": "dlg", "jp": "早くコイツらをやっつける方法を考えないと‥‥"},
{"id": 122, "speaker": 29, "form": "choice", "jp": "【『殺虫剤』があれば‥‥】"},
{"id": 123, "speaker": 29, "form": "choice", "jp": "【『粘着テープ』があれば‥‥】"},
{"id": 124, "speaker": 29, "form": "dlg", "jp": "【『粘着テープ』があれば‥‥】"},
{"id": 125, "speaker": 29, "form": "dlg", "jp": "コイツらを動けなくしてやるのに！"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "『ゴキブリ』たちはどんどんボクの口の中へ入ってくる。"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「オエッ！」"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "「ペッ！　ペッ！」"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "ボクは必死で吐き出そうとするが、\nぜんぜん間に合わない。"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "ボクの口の中はあっと言う間に\n『ゴキブリ』だらけになってしまった。"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "こ、呼吸ができない‥‥"},
{"id": 132, "speaker": 29, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 133, "speaker": 29, "form": "dlg", "jp": "うっ‥‥"},
{"id": 134, "speaker": 29, "form": "dlg", "jp": "だんだん頭がぼーっとしてきた‥‥"},
{"id": 135, "speaker": 29, "form": "dlg", "jp": "なんとかしないと‥‥"},
{"id": 136, "speaker": 29, "form": "dlg", "jp": "なんとか‥‥"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "（『殺虫剤』があれば‥‥）"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥！？）"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "（『殺虫剤』！！）"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "（たしか、１階の準備室に『殺虫剤』が！！）"},
{"id": 142, "speaker": 2, "form": "choice", "jp": "【『１階の準備室』に行く】"},
{"id": 143, "speaker": 2, "form": "choice", "jp": "【この部屋の床を破壊する】"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "【『１階の準備室』に行く】"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "ボクは『１階の準備室』に行くことにした。"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "『ゴキブリ』たちはどんどんボクの口の中へ入ってくる。"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「オエッ！」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「ペッ！　ペッ！」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "ボクは必死で吐き出そうとするが、\nぜんぜん間に合わない。"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "（急がないと！）"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "ボクは必死で『１階の準備室』を目指した。"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "しかし、移動している間に口の中はあっと言う間に\n『ゴキブリ』だらけになってしまった。"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "こ、呼吸ができない‥‥"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "うっ‥‥"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "だんだん頭がぼーっとしてきた‥‥"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "なんとかしないと‥‥"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "なんとか‥‥"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "【この部屋の床を破壊する】"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "（たしか、１階の準備室はこの部屋の真下だ‥‥）"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "（『床』をこわせば今すぐにでも！！）"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "ボクは能力を使って『拳』を硬くし、\n筋力をパワーアップさせた。"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "（ええっい！！）"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "「ガツン！」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "（ええっい！！）"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「ドカーン！」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "（やった！！）"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "ボクのパンチで『床』には大きな穴があき、\nボクはその『穴』に飛び込んだ。"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "（ナゴム！！）"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "（大丈夫だよ！）"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "ボクは机の上にあった\n『速攻性ゴキブロンＳＰ』を手にとった。"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「コレでもくらえ！！」"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "「シューーーーッ！」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "ボクはボクの体や辺り１面に『殺虫剤』をバラまいた。"},
{"id": 177, "speaker": 4, "form": "dlg", "jp": "（ウギャァ～～～～～～～～！！）"},
{"id": 178, "speaker": 4, "form": "dlg", "jp": "ボクの体にまとわりついていた\nゴキブリたちがボロボロと床に落ちて行く。"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「どうだ！　『キキメバツグン！\n　コウカソッコウ！　ゴキブロンＳＰ』！」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "速攻性をうたっている殺虫剤だけあって、\nほとんどのゴキブリがもう動かなくなってしまった。"},
{"id": 181, "speaker": 29, "form": "dlg", "jp": "（ナゴム、『ゴキブリの精神イメージ』が消えたわ！）"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "（うん‥‥）"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "（一応、ゴキブリは退治したよ‥‥）"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "（ただ‥‥アイツの『精神』は逃げたかも‥‥）"},
{"id": 185, "speaker": 29, "form": "dlg", "jp": "（たぶん、大丈夫じゃないかしら‥‥）"},
{"id": 186, "speaker": 29, "form": "dlg", "jp": "（何匹かのゴキブリは逃げたみたいだけど\n　その中にはまだアイツのイメージが残ってるから‥‥）"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "（何匹か逃げたの！？）"},
{"id": 188, "speaker": 29, "form": "dlg", "jp": "（大丈夫よ！）"},
{"id": 189, "speaker": 29, "form": "dlg", "jp": "（１匹２匹殺しても\n　アイツにダメージがなかったのと同じで）"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "（１匹２匹逃がしても\n　もう人間１人分の『精神』には戻れないわ‥‥）"},
{"id": 191, "speaker": 29, "form": "dlg", "jp": "（それより、早くここから出た方がいいわね‥‥）"},
{"id": 192, "speaker": 29, "form": "dlg", "jp": "（数人の人間がここへ向かってるわ！）"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "（忘れてた、\n　姉さんたちが警察に相談しに行ってたんだ！）"},
{"id": 194, "speaker": 29, "form": "dlg", "jp": "（警察！？）"},
{"id": 195, "speaker": 29, "form": "dlg", "jp": "（この状況を見られるとやっかいよ）"},
{"id": 196, "speaker": 29, "form": "dlg", "jp": "（とりあえず、ここを出ましょう！）"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "（清田さんはどうするの？）"},
{"id": 198, "speaker": 29, "form": "dlg", "jp": "（警察にまかせましょう‥‥）"},
{"id": 199, "speaker": 29, "form": "dlg", "jp": "（どっちにしろ私たちには‥‥）"},
{"id": 200, "speaker": 29, "form": "dlg", "jp": "（とにかく早くここを出るのよ！）"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "（あ、ああ‥‥）"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "ボクたちは急いで建物から外に出た。"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "２００５／０８／２３／ＡＭ１０：１０"},
{"id": 206, "speaker": 16, "form": "dlg", "jp": "「もう大丈夫なの？」"},
{"id": 207, "speaker": 31, "form": "dlg", "jp": "「まあ、急所はぜんぜん外れてたし‥‥」"},
{"id": 208, "speaker": 2, "form": "dlg", "jp": "「急所は外れても‥‥」"},
{"id": 209, "speaker": 31, "form": "dlg", "jp": "「応急処置が良かったんだよ‥‥」"},
{"id": 210, "speaker": 16, "form": "dlg", "jp": "「応急処置？」"},
{"id": 211, "speaker": 31, "form": "dlg", "jp": "「『能力』で傷口をふさいでやったんだよ‥‥」"},
{"id": 212, "speaker": 31, "form": "dlg", "jp": "「もちろん、医者には何も言ってないけどな‥‥」"},
{"id": 213, "speaker": 29, "form": "dlg", "jp": "「そんなことより、\n　『清田』って人の行方よねぇ‥‥」"},
{"id": 214, "speaker": 29, "form": "dlg", "jp": "あの後、姉さんの相談を受けた警察が\nあの建物に入ったんだけど、"},
{"id": 215, "speaker": 29, "form": "dlg", "jp": "『清田さん』はどこにもいなかったらしい。"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「やっぱり逃がしたゴキブリの中の\n　『ゴトウマサシ』の精神が？」"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "「その程度の精神で\n　人間がコントロールできるとは思えないけど‥‥」"},
{"id": 218, "speaker": 31, "form": "dlg", "jp": "「で、妹さんはどうなったんだ？」"},
{"id": 219, "speaker": 31, "form": "dlg", "jp": "マイちゃんはとりあえず、清田さんが帰ってくるまで\n三田さんの家で面倒をみることになった。"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「とりあえず、知り合いが引き取って面倒を‥‥」"},
{"id": 221, "speaker": 31, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 222, "speaker": 16, "form": "dlg", "jp": "「そういえば、あの『ゴトウ』に\n　『脳を破壊された子たち』は？」"},
{"id": 223, "speaker": 16, "form": "dlg", "jp": "「清田さんの機械で元に戻るんじゃぁ？」"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "「清田さん以外にあの機械を操れる人がいないんだ‥‥」"},
{"id": 225, "speaker": 31, "form": "dlg", "jp": "「ナゴムの姉さんでもムリなのか？」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「機械を動かすだけなら結構簡単らしいんだけど、\n　肝心の情報の復元が‥‥」"},
{"id": 227, "speaker": 31, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 229, "speaker": 16, "form": "dlg", "jp": "「ねえ？」"},
{"id": 230, "speaker": 16, "form": "dlg", "jp": "「ジーンの能力を使って、\n　清田さんを探せないの？」"},
{"id": 231, "speaker": 18, "form": "dlg", "jp": "「もう大丈夫なの？」"},
