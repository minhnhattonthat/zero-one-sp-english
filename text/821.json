[
{"id": 0, "speaker": null, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 1, "speaker": 51, "form": "dlg", "jp": "「常光寺ぃ！！」"},
{"id": 2, "speaker": 2, "form": "dlg", "jp": "「小田！！」"},
{"id": 3, "speaker": 51, "form": "dlg", "jp": "「どうしたん？\n　そんなに急いで‥‥」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「うんちょっとね‥‥」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "「じゃあ急いでるから‥‥」"},
{"id": 6, "speaker": 51, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 7, "speaker": 18, "form": "dlg", "jp": "「アラ、常光寺くん！」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「堤さん！」"},
{"id": 9, "speaker": 18, "form": "dlg", "jp": "「どうしたの？\n　そんなに急いで‥‥」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「うんちょっとね‥‥」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「じゃあ急いでるから‥‥」"},
{"id": 12, "speaker": 18, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "（ジーンたちいるかな？）"},
{"id": 14, "speaker": 29, "form": "dlg", "jp": "（いるわよ！）"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "（ジーン！！）"},
{"id": 16, "speaker": 29, "form": "dlg", "jp": "（早くあがってらっしゃい！）"},
{"id": 17, "speaker": 29, "form": "dlg", "jp": "「コン！コン！」"},
{"id": 18, "speaker": 31, "form": "dlg", "jp": "「開いてるよ！」"},
{"id": 19, "speaker": 31, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 20, "speaker": 31, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「うん、ちょっとした手がかりを手に入れたんだよ！」"},
{"id": 22, "speaker": 31, "form": "dlg", "jp": "「手がかり？」"},
{"id": 23, "speaker": 29, "form": "dlg", "jp": "「なんの？」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「例の『邪悪なイメージ』のだよ！」"},
{"id": 25, "speaker": 31, "form": "dlg", "jp": "「本当なのか？」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「うん、多分‥‥」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「ジーンたちがＥ－ｇｒｏ本部から手にいれた情報によると\n　この町で確認された『邪悪なイメージ』は」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「７月２０日の夜にボクの学校と\n　昨日の夜に２丁目の４番地で確認されたんだろう？」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「実はそれに共通する『事件』があったんだよ！」"},
{"id": 30, "speaker": 29, "form": "dlg", "jp": "「共通する事件！？」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「ウン、知り合いが昨日の夜に２丁目の４番地で\n　『野良犬』に襲われたんだけど‥‥」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "「実はボクも７月２０日の夜に学校で\n　『野良犬』に襲われたんだよ！」"},
{"id": 33, "speaker": 31, "form": "dlg", "jp": "「でもこの前はルードに襲われたって‥‥」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「うん、だから両方に襲われたんだよ！」"},
{"id": 35, "speaker": 29, "form": "dlg", "jp": "「その話、本当なの！？」"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "「ウン‥‥」"},
{"id": 37, "speaker": 31, "form": "dlg", "jp": "「ってことは‥‥」"},
{"id": 38, "speaker": 31, "form": "choice", "jp": "「『犬』の『超能力者』かも！」"},
{"id": 39, "speaker": 31, "form": "choice", "jp": "「『犬を操る超能力者』かも！」"},
{"id": 40, "speaker": 31, "form": "choice", "jp": "「『ルード』の中に『超能力者』がいるかも！」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「『犬』の『超能力者』かも！」"},
{"id": 42, "speaker": 31, "form": "dlg", "jp": "「それはないんじゃないか？」"},
{"id": 43, "speaker": 31, "form": "dlg", "jp": "「『能力』を使うには『想像力』が重要だからな‥‥」"},
{"id": 44, "speaker": 31, "form": "dlg", "jp": "「『犬』に『想像力』があるとはとても思えない‥‥」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「『犬を操る超能力者』かも！」"},
{"id": 46, "speaker": 31, "form": "dlg", "jp": "「うん、そうだな‥‥」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「『ルード』の中に『超能力者』がいるかも！」"},
{"id": 48, "speaker": 31, "form": "dlg", "jp": "「ちょっと待てよ！」"},
{"id": 49, "speaker": 31, "form": "dlg", "jp": "「ルードに襲われたのはナゴムだけだろう？」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「まあ、そうだけど‥‥」"},
{"id": 51, "speaker": 29, "form": "dlg", "jp": "「一番重要なのは、『動機』よね‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「『動機』！？」"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "「その『野良犬』がひんぱんに事件を起してるなら、\n　『無差別』な行動なんでしょうけど‥‥」"},
{"id": 55, "speaker": 29, "form": "dlg", "jp": "「データを見る限り、\n　そうひんぱんに人を襲ってるわけじゃなさそうだし‥‥」"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "「じゃあ？」"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "「『計画的な行動』‥‥」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「つまり‥‥」"},
{"id": 59, "speaker": 2, "form": "choice", "jp": "「『犬』の『超能力者』じゃない！」"},
{"id": 60, "speaker": 2, "form": "choice", "jp": "「何か『動機』がある！」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "「『犬』の『超能力者』じゃない！」"},
{"id": 62, "speaker": 29, "form": "dlg", "jp": "「当たり前でしょう！」"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "「犬が計画的に動くとは思えないし‥‥」"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "「何か『動機』がある！」"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "「そうじゃないかしら‥‥」"},
{"id": 66, "speaker": 31, "form": "dlg", "jp": "「ナゴム、なんか心当たりは？」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「あのころは『ルード』にも狙われてたから‥‥」"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "「ナゴムは有名な科学者の子供だし、\n　能力者でもあるから狙われる理由はいくらでもあるわね」"},
{"id": 70, "speaker": 31, "form": "dlg", "jp": "「じゃあ、その知り合いってヤツの方が気になるな‥‥」"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "「父さんの助手だよ‥‥」"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "「狙われる理由は？」"},
{"id": 73, "speaker": 29, "form": "choice", "jp": "「ケンカが弱そう！」"},
{"id": 74, "speaker": 29, "form": "choice", "jp": "「ルードなら狙うかも！」"},
{"id": 75, "speaker": 29, "form": "choice", "jp": "「ライバルの科学者とか！」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「ケンカが弱そう！」"},
{"id": 77, "speaker": 31, "form": "dlg", "jp": "「なるほど！」"},
{"id": 78, "speaker": 31, "form": "dlg", "jp": "「ナゴムもケンカが弱そうだしな‥‥」"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "「ケンカの弱そうなのにワザワザ能力を使うかしら？」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「じゃあ、やっぱり『ルード』かな‥‥」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「ルードなら狙うかも！」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「こないだも父さんといっしょにさらわれたし‥‥」"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "「ライバルの科学者とか！」"},
{"id": 84, "speaker": 29, "form": "dlg", "jp": "「でも、それだとナゴムとの接点がないでしょう？」"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "「じゃあ、やっぱり『ルード』かな‥‥」"},
{"id": 86, "speaker": 29, "form": "dlg", "jp": "「まあ、あの連中がナゴムたちを狙うっていうのは\n　十分理解できるわね‥‥」"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "「でも、『ルード』は壊滅状態だって‥‥」"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "「組織が壊滅したからって、\n　全員が逮捕されたわけでもないでしょうし‥‥」"},
{"id": 89, "speaker": 31, "form": "dlg", "jp": "「て、ことはルードの残党が怪しいってことか？」"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って、それじゃあ\n　『ルードの残党』がこの町にいるってこと？」"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "「可能性は０ではないわね‥‥」"},
{"id": 92, "speaker": 31, "form": "dlg", "jp": "「とにかく、\n　ナゴムの家族は気をつけた方がいいな‥‥」"},
{"id": 93, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "「『邪悪なイメージ』が観測されてるってことは\n　間違いなくナゴムたちに敵意をもってるでしょうし‥‥」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「そんなぁ～」"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "「とにかく、十分気をつけなさい‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "２００５／０８／１３／ＰＭ０６：３０"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "「ただいまぁ～～」"},
{"id": 101, "speaker": 3, "form": "dlg", "jp": "「おかえりなさい‥‥」"},
{"id": 102, "speaker": 26, "form": "dlg", "jp": "「もう用事はすんだのかい？」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "「アレ？」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「父さんは？」"},
{"id": 106, "speaker": 26, "form": "dlg", "jp": "「疲れたから、もう寝るって‥‥」"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「ふーん‥‥」"},
{"id": 108, "speaker": 26, "form": "dlg", "jp": "「じゃあ、ボクもコレで‥‥」"},
{"id": 109, "speaker": 3, "form": "dlg", "jp": "「今日はありがとうございました」"},
{"id": 110, "speaker": 26, "form": "dlg", "jp": "「気にしないでくださいよ‥‥」"},
{"id": 111, "speaker": 26, "form": "dlg", "jp": "「いつも世話になってるのは\n　ボクの方なんですから‥‥」"},
{"id": 112, "speaker": 26, "form": "dlg", "jp": "「じゃあ、失礼します‥‥」"},
{"id": 113, "speaker": 26, "form": "dlg", "jp": "三田さんは自分の家に帰っていった。"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "（さて、ボクはどうしようかな‥‥）"},
{"id": 115, "speaker": 2, "form": "choice", "jp": "【話す】"},
{"id": 116, "speaker": 2, "form": "choice", "jp": "【移動】"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "【話す】"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "ボクは姉さんにルードの残党が\nボクたちが狙っている可能性があることを話した。"},
{"id": 119, "speaker": 3, "form": "dlg", "jp": "「その話本当なの？」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「はっきりと言い切れないけど‥‥」"},
{"id": 121, "speaker": 3, "form": "dlg", "jp": "「で、ナゴムはそんな情報どこから手にいれたの？」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「えっ！！」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「まあ、ウワサだけど‥‥」"},
{"id": 124, "speaker": 3, "form": "dlg", "jp": "「たしかに、ルードがまだ活動している\n　って可能性は十分あるわね‥‥」"},
{"id": 125, "speaker": 3, "form": "dlg", "jp": "「ちょっとシローに聞いてみる？」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「『シロー』！？」"},
{"id": 127, "speaker": 3, "form": "dlg", "jp": "「未だにルードのことを監視しているみたいよ‥‥」"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "（さすがシロー！！）"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "「ねえ、ちょっとシローと話させてよ！」"},
{"id": 130, "speaker": 3, "form": "dlg", "jp": "「いいわよ、別に‥‥」"},
{"id": 131, "speaker": 3, "form": "dlg", "jp": "ボクは姉さんといっしょに研究室に入ることにした。"},
{"id": 132, "speaker": 3, "form": "dlg", "jp": "【移動】"},
{"id": 133, "speaker": 3, "form": "dlg", "jp": "どこに行こうかな？"},
{"id": 134, "speaker": 3, "form": "choice", "jp": "【大人しく部屋に戻ろう】"},
{"id": 135, "speaker": 3, "form": "choice", "jp": "【研究室に行ってみよう】"},
{"id": 136, "speaker": 3, "form": "dlg", "jp": "【研究室に行ってみよう】"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「姉さん、ちょっとパソコン借りるよ」"},
{"id": 138, "speaker": 3, "form": "dlg", "jp": "「自分のパソコンがあるでしょう？」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「実は‥‥」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「シローと話がしたいんだ‥‥」"},
{"id": 141, "speaker": 3, "form": "dlg", "jp": "「シローと？」"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「うん、もしかしたらルードの残党がまだ\n　ボクたちを狙っているかもしれないんだ！」"},
{"id": 143, "speaker": 3, "form": "dlg", "jp": "「その話本当なの？」"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "「はっきりと言い切れないけど‥‥」"},
{"id": 145, "speaker": 3, "form": "dlg", "jp": "「で、ナゴムはそんな情報どこから手にいれたの？」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「えっ！！」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「まあ、ウワサだけど‥‥」"},
{"id": 148, "speaker": 3, "form": "dlg", "jp": "「たしかに、ルードがまだ活動している\n　って可能性は十分あるわね‥‥」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「シローなら知ってるかもしれないろう？」"},
{"id": 150, "speaker": 3, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 151, "speaker": 3, "form": "dlg", "jp": "「未だにルードのことを監視しているみたいだし‥‥」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "（さすがシロー！！）"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「ねえ、ちょっとシローと話させてよ！」"},
{"id": 154, "speaker": 3, "form": "dlg", "jp": "「いいわよ、別に‥‥」"},
{"id": 155, "speaker": 3, "form": "dlg", "jp": "ボクは姉さんといっしょに研究室に入ることにした。"},
{"id": 156, "speaker": 3, "form": "dlg", "jp": "【大人しく部屋に戻ろう‥‥】"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "「じゃあ、部屋に戻るよ」"},
{"id": 158, "speaker": 3, "form": "dlg", "jp": "「ちゃんと宿題は進んでるの？」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "「ほどほどにね‥‥」"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "ボクは自分の部屋に戻ることにした。"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "（『ルード』がまだこの町で活動している‥‥）"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "（それも『超能力』を使って‥‥）"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "（いったい何のために？）"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "（一番考えられるのは‥‥）"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "（『復讐』！！）"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "（それなら三田さんが襲われた理由も納得できる！！）"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "（ルードの工場があんな風になったのは\n　三田さんとシローの活躍があったから‥‥）"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "（シローは攻撃しようがないけど、\n　三田さんなら簡単に！！）"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "（三田さんが危ない！！）"},
{"id": 174, "speaker": 2, "form": "choice", "jp": "（とにかく、電話してみよう！）"},
{"id": 175, "speaker": 2, "form": "choice", "jp": "（今ならまだ間に合う！）"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "（とにかく、電話してみよう！）"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "三田さんの携帯電話に連絡をとってみることにした。"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「ピポパポピ‥‥」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「ピッ！」"},
{"id": 180, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 181, "speaker": 26, "form": "dlg", "jp": "（はい‥‥）"},
{"id": 182, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「もしもし、三田さん？」"},
{"id": 184, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 185, "speaker": 26, "form": "dlg", "jp": "（ナゴムくんかい？）"},
{"id": 186, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 187, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 188, "speaker": 26, "form": "dlg", "jp": "（どうかしたの？）"},
{"id": 189, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "「うん、ちょっと気になることがあって‥‥」"},
{"id": 191, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 192, "speaker": 26, "form": "dlg", "jp": "（気になること？）"},
{"id": 193, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 195, "speaker": 2, "form": "dlg", "jp": "「実は‥‥」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「『ルードの残党』が三田さんのことを\n　狙ってるかもしれないんだ！」"},
{"id": 197, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 198, "speaker": 26, "form": "dlg", "jp": "（ええっ、それ本当なの？）"},
{"id": 199, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "「とにかく、夜の一人歩きはキケンだから\n　なるべく人通りの多い道で帰ってください！」"},
{"id": 201, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 202, "speaker": 26, "form": "dlg", "jp": "（うん、そうするよ！）"},
{"id": 203, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 204, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 205, "speaker": 26, "form": "dlg", "jp": "（心配してくれてアリガトウ！）"},
{"id": 206, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「それじゃあ‥‥」"},
{"id": 208, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 209, "speaker": 26, "form": "dlg", "jp": "（うん！）"},
{"id": 210, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 211, "speaker": 26, "form": "dlg", "jp": "「ピッ！」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "（これでとりあえず、安心だ‥‥）"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "（三田さんがものわかりのいい人で良かった‥‥）"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "（とにかく、\n　もう少し『ルードの残党』の情報が欲しいな‥‥）"},
{"id": 215, "speaker": 2, "form": "choice", "jp": "【姉さんと話してみようか‥‥】"},
{"id": 216, "speaker": 2, "form": "choice", "jp": "【シローに相談してみようか‥‥】"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "【シローに相談してみようか‥‥】"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "ボクは自分のパソコンから\nシローに連絡をとってみることにした。"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "「シロー起きてる？」"},
{"id": 220, "speaker": 5, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 221, "speaker": 5, "form": "dlg", "jp": "「何か用かい？」"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "「シロー、ルードの情報って何かもっていない？」"},
{"id": 223, "speaker": 5, "form": "dlg", "jp": "「どうかしたのかい？」"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "「ルードの残党がまだ活動してるかもしれないんだ‥‥」"},
{"id": 225, "speaker": 5, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 226, "speaker": 5, "form": "dlg", "jp": "「ボクの知ってる限りでは\n　大幹部のほとんどは逮捕されて」"},
{"id": 227, "speaker": 5, "form": "dlg", "jp": "「実際のところ組織としては\n　ほとんど壊滅状態だよ‥‥」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「残党とかは？」"},
{"id": 229, "speaker": 5, "form": "dlg", "jp": "「若干の残党が抵抗活動はしてるみたいだけど、\n　工場は全部閉鎖してるから大した活動は‥‥」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「日本に来ている残党っているの？」"},
{"id": 231, "speaker": 5, "form": "dlg", "jp": "「インターポールの情報をハックしたところによると\n　２～３人ぐらいはいるみたいだね‥‥」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「やっぱり！！」"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "「ソイツらは危なくないの？」"},
{"id": 234, "speaker": 5, "form": "dlg", "jp": "「逃げ隠れしている連中だから\n　そんな大それた活動はできないよ」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "（違う！\n　『能力』があればできるハズだ‥‥）"},
{"id": 236, "speaker": 5, "form": "dlg", "jp": "「とにかく、ルードについてはボクが見張っているから\n　心配しなくて大丈夫だよ！」"},
{"id": 237, "speaker": 5, "form": "dlg", "jp": "「なにかあったらこの『レーザー』で‥‥」"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "「ダメだよ！」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「あんまり、目立つ行動をとっちゃ‥‥」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「軍だってシローのことを駆除しようとするだろう！」"},
{"id": 241, "speaker": 5, "form": "dlg", "jp": "「まあ、もしもの場合の話だよ‥‥」"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "「くれぐれもウカツな行動は‥‥」"},
{"id": 243, "speaker": 5, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 244, "speaker": 5, "form": "dlg", "jp": "「とにかく、今のところルードの残党については\n　心配しなくても大丈夫だよ‥‥」"},
{"id": 245, "speaker": 5, "form": "dlg", "jp": "「もう、ルードのことは忘れて\n　夏休みを楽しんだらどうだい？」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「あ、ああ‥‥」"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "（ダメだ‥‥）"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "（まあ、シローは能力のことを\n　知らないからしかたないけど‥‥）"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "（とにかく、２～３人の残党が日本に来ているのは\n　間違いなさそうだな‥‥）"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "（その辺を独自に調べた方が良さそうだな‥‥）"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "「うん、ありがとう！！」"},
{"id": 252, "speaker": 5, "form": "dlg", "jp": "「うん、じゃあね！」"},
{"id": 253, "speaker": 5, "form": "dlg", "jp": "【姉さんと話してみようか‥‥】"},
{"id": 254, "speaker": 5, "form": "dlg", "jp": "ボクは姉さんに聞いてみることにした"},
{"id": 255, "speaker": 5, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 256, "speaker": 5, "form": "dlg", "jp": "「バタン！」"},
{"id": 257, "speaker": 5, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 258, "speaker": 3, "form": "dlg", "jp": "「どうしたの？」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「姉さん、ルードの残党について何か情報持ってない？」"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "「もしかしたら、また日本で悪さをしてるかもしれないんだ‥‥」"},
{"id": 261, "speaker": 3, "form": "dlg", "jp": "「ナゴムはそんな情報どこから手にいれたの？」"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "「えっ！！」"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "「まあ、ウワサだけど‥‥」"},
{"id": 264, "speaker": 3, "form": "dlg", "jp": "「たしかに、ルードがまだ活動している\n　って可能性は十分あるわね‥‥」"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "「そ、そうだろう？」"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "「もしそのウワサが本当なら、\n　またボクたちが狙われるかもしれないだろう？」"},
{"id": 267, "speaker": 3, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "「姉さん、その辺りの情報って\n　手に入らないかな？」"},
{"id": 269, "speaker": 3, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 270, "speaker": 3, "form": "dlg", "jp": "「シローなら知ってるかも‥‥」"},
{"id": 271, "speaker": 2, "form": "dlg", "jp": "「シロー！？」"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "「どうして『シロー』が？」"},
{"id": 273, "speaker": 3, "form": "dlg", "jp": "「未だにルードのことを監視しているみたいよ‥‥」"},
{"id": 274, "speaker": 2, "form": "dlg", "jp": "（さすがシロー！！）"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "「ねえ、ちょっとシローと話させてよ！」"},
{"id": 276, "speaker": 3, "form": "dlg", "jp": "「いいわよ、別に‥‥」"},
{"id": 277, "speaker": 3, "form": "dlg", "jp": "ボクは姉さんといっしょに研究室に入ることにした。"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "（今ならまだ間に合う！）"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "ボクは三田さんを追いかけることにした。"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 283, "speaker": 3, "form": "dlg", "jp": "「どうしたの？」"},
{"id": 284, "speaker": 2, "form": "dlg", "jp": "「うん、もしかしたらルードの残党が\n　三田さんを狙っているかもしれないんだ！」"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "「心配だから追いかけようと‥‥」"},
{"id": 286, "speaker": 3, "form": "dlg", "jp": "「その話本当なの？」"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "「はっきりと言い切れないけど‥‥」"},
{"id": 288, "speaker": 3, "form": "dlg", "jp": "「とにかく、今から追いかけても会えるかどうか\n　わからないでしょう？」"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 290, "speaker": 3, "form": "dlg", "jp": "「そんなに心配なら、電話してみたら？」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥！！」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "三田さんの携帯電話に連絡をとってみることにした。"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "「ピポパポピ‥‥」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "「ピッ！」"},
{"id": 296, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 297, "speaker": 26, "form": "dlg", "jp": "（はい‥‥）"},
{"id": 298, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "「もしもし、三田さん？」"},
{"id": 300, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 301, "speaker": 26, "form": "dlg", "jp": "（ナゴムくんかい？）"},
{"id": 302, "speaker": 26, "form": "dlg", "jp": "」"},
