{"id": 304, "speaker": 26, "form": "dlg", "jp": "（どうかしたの？）"},
{"id": 305, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "「うん、ちょっと気になることがあって‥‥」"},
{"id": 307, "speaker": 26, "form": "dlg", "jp": "「"},
