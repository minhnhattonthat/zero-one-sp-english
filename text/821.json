{"id": 575, "speaker": 29, "form": "dlg", "jp": "（間違いないでしょうね‥‥）"},
{"id": 576, "speaker": 2, "form": "dlg", "jp": "（どうすればいい？）"},
{"id": 577, "speaker": 29, "form": "dlg", "jp": "（そうね‥‥）"},
{"id": 578, "speaker": 31, "form": "dlg", "jp": "（そっちはオレが引き付けておいてやるよ！）"},
{"id": 579, "speaker": 2, "form": "dlg", "jp": "（ケネス！！）"},
{"id": 580, "speaker": 31, "form": "dlg", "jp": "（今、ホテルの１階についた）"},
{"id": 581, "speaker": 31, "form": "dlg", "jp": "（警察の警備がじゃまで苦労したがもう大丈夫だ！）"},
{"id": 582, "speaker": 31, "form": "dlg", "jp": "（今から、そっちへ向かう）"},
{"id": 583, "speaker": 2, "form": "dlg", "jp": "（向かうってどうやって？）"},
{"id": 584, "speaker": 2, "form": "dlg", "jp": "（階段には見張りが‥‥）"},
{"id": 585, "speaker": 31, "form": "dlg", "jp": "（そのコが閉じ込められていたエレべーターを使う）"},
{"id": 586, "speaker": 2, "form": "dlg", "jp": "（エレベーターは止まってるよ！）"},
{"id": 587, "speaker": 31, "form": "dlg", "jp": "（オレの『能力』をあまくみるなよ\n　エレベーターぐらい‥‥）"},
{"id": 588, "speaker": 29, "form": "dlg", "jp": "（そうね、ケネスが『エレベーターホール』で\n　騒ぎをおこせば見張りはそっちへ行くでしょうね‥‥）"},
{"id": 589, "speaker": 2, "form": "dlg", "jp": "（もし、その作戦がうまくいかなかったら？）"},
{"id": 590, "speaker": 29, "form": "dlg", "jp": "（そのときは見張りの１人や２人、\n　ナゴムが倒しちゃいなさい！）"},
{"id": 591, "speaker": 15, "form": "dlg", "jp": "（ちょっと待って、\n　相手は銃を持ってるんでしょう？）"},
{"id": 592, "speaker": 29, "form": "dlg", "jp": "（たぶん、銃ぐらい大丈夫よ！）"},
{"id": 593, "speaker": 15, "form": "dlg", "jp": "（どういうこと？）"},
{"id": 594, "speaker": 29, "form": "dlg", "jp": "（ナゴムも『能力者』なのよ‥‥）"},
{"id": 595, "speaker": 2, "form": "dlg", "jp": "（くわしいことは、後で説明してあげるよ！）"},
{"id": 596, "speaker": 2, "form": "dlg", "jp": "（とにかく、夢でみた爆弾の場所に連れてって！）"},
{"id": 597, "speaker": 15, "form": "dlg", "jp": "（え、ええ‥‥）"},
{"id": 598, "speaker": 15, "form": "dlg", "jp": "こうしてボクたちは\nアイコが夢で爆弾をみた場所へ行くことにした。"},
{"id": 599, "speaker": 15, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 600, "speaker": 16, "form": "dlg", "jp": "（ちょっと待って、\n　相手は銃を持ってるんでしょう？）"},
{"id": 601, "speaker": 29, "form": "dlg", "jp": "（たぶん、銃ぐらい大丈夫よ！）"},
{"id": 602, "speaker": 16, "form": "dlg", "jp": "（どういうこと？）"},
{"id": 603, "speaker": 29, "form": "dlg", "jp": "（ナゴムも『能力者』なのよ‥‥）"},
{"id": 604, "speaker": 2, "form": "dlg", "jp": "（くわしいことは、後で説明してあげるよ！）"},
{"id": 605, "speaker": 2, "form": "dlg", "jp": "（とにかく、夢でみた爆弾の場所に連れてってよ！）"},
{"id": 606, "speaker": 16, "form": "dlg", "jp": "（う、うん）"},
{"id": 607, "speaker": 16, "form": "dlg", "jp": "こうしてボクたちは\n長尾が夢で爆弾をみた場所へ行くことにした。"},
{"id": 608, "speaker": 16, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 609, "speaker": 2, "form": "dlg", "jp": "「さっそく『パーティーホールの入り口』に行こう！」"},
{"id": 610, "speaker": 2, "form": "dlg", "jp": "ボクは爆弾を解体するために、\n『パーティーホールの入り口』へ向かった。"},
{"id": 611, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 612, "speaker": 4, "form": "dlg", "jp": "「おい、コゾウ！！」"},
{"id": 613, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥！？」"},
{"id": 614, "speaker": 2, "form": "dlg", "jp": "しまった！"},
{"id": 615, "speaker": 2, "form": "dlg", "jp": "ヤツらは『パーティーホール』を占拠してるんだった。"},
{"id": 616, "speaker": 4, "form": "dlg", "jp": "「どっから逃げ出したんだ！」"},
{"id": 617, "speaker": 4, "form": "dlg", "jp": "「逃げられると思ってるのか？」"},
{"id": 618, "speaker": 4, "form": "dlg", "jp": "「死ねぇい！！」"},
{"id": 619, "speaker": 4, "form": "dlg", "jp": "「バキューン！」"},
{"id": 620, "speaker": 2, "form": "dlg", "jp": "「うわぁ～～～～～～～！」"},
{"id": 621, "speaker": 2, "form": "dlg", "jp": "失敗の原因は道を間違えたこと\n本当に階段へ行く必要があったのか？"},
{"id": 622, "speaker": 2, "form": "dlg", "jp": "失敗の原因はあせって行動したこと。\nジーンの能力を利用するべきだったのは？"}
