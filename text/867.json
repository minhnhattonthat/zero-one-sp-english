{"id": 44, "speaker": 3, "form": "dlg", "jp": "「アラ、アキラちゃん！！」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "（やっぱり‥‥）"},
{"id": 46, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「長尾だろう？」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「あがってもらって！」"},
