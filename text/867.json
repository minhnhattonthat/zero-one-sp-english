{"id": 59, "speaker": 15, "form": "dlg", "jp": "「おじゃまします」"},
{"id": 60, "speaker": 15, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 61, "speaker": 15, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 62, "speaker": 15, "form": "dlg", "jp": "「アレ？」"},
{"id": 63, "speaker": 15, "form": "dlg", "jp": "「ジーンたちは？」"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "「来てないよ！」"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "「いったい何を考えてるんだか‥‥」"},
{"id": 66, "speaker": 35, "form": "dlg", "jp": "「呼んであげようか？」"},
{"id": 67, "speaker": 35, "form": "dlg", "jp": "「もうジーンのイメージは覚えたから、\n　たぶん瞬間移動させられるよ！」"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "「キャッ！」"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "『バカ～～～～～～ッ！』"},
{"id": 70, "speaker": 29, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 72, "speaker": 3, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「ちょ、ちょっとテレビのボリュームを‥‥」"},
{"id": 74, "speaker": 3, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 75, "speaker": 3, "form": "dlg", "jp": "「ビックリさせないでよ」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "「ふう‥‥」"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "「松尾さん！！」"},
{"id": 79, "speaker": 35, "form": "dlg", "jp": "「だ、だって‥‥」"},
{"id": 80, "speaker": 15, "form": "dlg", "jp": "「血の雨がふるわね‥‥」"},
{"id": 81, "speaker": 18, "form": "dlg", "jp": "「血の雨がふるわね‥‥」"},
{"id": 82, "speaker": 51, "form": "dlg", "jp": "「血の雨がふるなぁ‥‥」"},
{"id": 83, "speaker": 16, "form": "dlg", "jp": "「血の雨がふるわね‥‥」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「たぶんね‥‥」"},
{"id": 85, "speaker": 35, "form": "dlg", "jp": "「お、おどかさないでくれよ‥‥」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「オドシならいいんだけど‥‥」"},
{"id": 87, "speaker": 29, "form": "dlg", "jp": "（アスカ！！）"},
{"id": 88, "speaker": 35, "form": "dlg", "jp": "「ジーンからだ！！」"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "（着替え終わったから、私とケネスをそっちに運んで！）"},
{"id": 90, "speaker": 35, "form": "dlg", "jp": "「ど、どうしよう‥‥」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「素直にしたがった方がいいと思うよ‥‥」"},
{"id": 92, "speaker": 35, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 93, "speaker": 35, "form": "dlg", "jp": "こうして、\n松尾さんはもう一度ジーンを呼び出すことになった。"},
{"id": 94, "speaker": 35, "form": "dlg", "jp": "「ゴ、ゴメンなさい‥‥」"},
{"id": 95, "speaker": 31, "form": "dlg", "jp": "（ハハハハハハハハハハ！）"},
{"id": 96, "speaker": 31, "form": "dlg", "jp": "（ジーンもうゆるしてやれよ！）"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "（今度やったらただじゃすまないわよ！）"},
{"id": 98, "speaker": 35, "form": "dlg", "jp": "「ゴメンなさい‥‥」"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "（声を出さないで！！）"},
{"id": 100, "speaker": 35, "form": "dlg", "jp": "（オレ、『テレパシー』ニガテなんだ‥‥）"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "（ニガテなら克服してもらうだけよ！）"},
{"id": 102, "speaker": 15, "form": "dlg", "jp": "（で、今日は何の集まりなの？）"},
{"id": 103, "speaker": 16, "form": "dlg", "jp": "（で、今日は何の集まりなの？）"},
{"id": 104, "speaker": 18, "form": "dlg", "jp": "（で、今日は何の集まりなの？）"},
{"id": 105, "speaker": 51, "form": "dlg", "jp": "（で、今日は何の集まりなん？）"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "（ダレかさんみたいに、\n　ウカツに能力を使っちゃう人がいるから）"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "（心構えを教えに来たのよ！）"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "（心構え？）"},
{"id": 109, "speaker": 29, "form": "dlg", "jp": "（とにかく、アスカが仲間になったんだから、\n　『仲間探し』はおしまい‥‥）"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "（いよいよこれからは来るべき『クリエーター』との\n　戦いが始まるの‥‥）"},
{"id": 111, "speaker": 31, "form": "dlg", "jp": "（まあ、こないだのロボットの件を見る限り\n　『クリエーター』も本気を出し始めてるようだしな‥‥）"},
{"id": 112, "speaker": 35, "form": "dlg", "jp": "（ちょっと待って、『仲間』って何？）"},
{"id": 113, "speaker": 35, "form": "dlg", "jp": "（『クリエーター』って？）"},
{"id": 114, "speaker": 15, "form": "dlg", "jp": "（知らないの？）"},
{"id": 115, "speaker": 15, "form": "dlg", "jp": "（ジーンから何も聞いてないの？）"},
{"id": 116, "speaker": 16, "form": "dlg", "jp": "（知らないの？）"},
{"id": 117, "speaker": 16, "form": "dlg", "jp": "（ジーンから何も聞いてないの？）"},
{"id": 118, "speaker": 18, "form": "dlg", "jp": "（知らないんですか？）"},
{"id": 119, "speaker": 18, "form": "dlg", "jp": "（ジーンから何も聞いてないんですか？）"},
{"id": 120, "speaker": 51, "form": "dlg", "jp": "（知らんの？）"},
{"id": 121, "speaker": 51, "form": "dlg", "jp": "（ジーンから何も聞いてないの？）"},
{"id": 122, "speaker": 29, "form": "dlg", "jp": "（教えてないわよ！）"},
{"id": 123, "speaker": 29, "form": "dlg", "jp": "（アスカはテレパシーがニガテだから、\n　離れた距離で伝えようとすると大変なの！）"},
{"id": 124, "speaker": 35, "form": "dlg", "jp": "（ゴメン‥‥）"},
{"id": 125, "speaker": 29, "form": "dlg", "jp": "（だから、アスカにはこうして\n　近い距離でテイネイに教えてあげる時間が必要なの！）"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "（とにかく、私１人じゃつかれるから、\n　みんなも手伝って‥‥）"},
{"id": 127, "speaker": 29, "form": "dlg", "jp": "こうして、ボクたちは全員で松尾さんに\n『Ｅ－ｇｒｏ』や『クリエーター』の説明をした。"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "そして‥‥"},
{"id": 129, "speaker": 29, "form": "dlg", "jp": "（どう、理解してくれた）"},
{"id": 130, "speaker": 35, "form": "dlg", "jp": "（まあ、なんとなくは‥‥）"},
{"id": 131, "speaker": 31, "form": "dlg", "jp": "（これだけ説明して『なんとなく』かよ‥‥）"},
{"id": 132, "speaker": 31, "form": "dlg", "jp": "（今回の仲間探しで一番の強敵だぜ！）"},
{"id": 133, "speaker": 35, "form": "dlg", "jp": "（とにかく、みんなは『クリエーター』っていう\n　『悪』と戦うメンバーなんだろう？）"},
{"id": 134, "speaker": 35, "form": "dlg", "jp": "（つまり、『正義の味方』ってことだよね！）"},
{"id": 135, "speaker": 15, "form": "dlg", "jp": "（まあ、そうね‥‥）"},
{"id": 136, "speaker": 16, "form": "dlg", "jp": "（当たり前じゃない！）"},
{"id": 137, "speaker": 18, "form": "dlg", "jp": "（まあ、そうかも‥‥）"},
{"id": 138, "speaker": 51, "form": "dlg", "jp": "（その通り！）"},
{"id": 139, "speaker": 35, "form": "dlg", "jp": "（つまり、\n　オレも『正義の味方』のメンバーになるってことだね！）"},
{"id": 140, "speaker": 35, "form": "dlg", "jp": "（オレ、一番好きな言葉は『正義』なんだよ！）"},
{"id": 141, "speaker": 35, "form": "dlg", "jp": "（だから、『自衛隊』に入隊したんだけど‥‥）"},
{"id": 142, "speaker": 35, "form": "dlg", "jp": "（自衛隊って『悪』と戦うチャンスがなくって‥‥）"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "（そんなチャンスあったら大変だよ‥‥）"},
{"id": 144, "speaker": 29, "form": "dlg", "jp": "（どう？）"},
{"id": 145, "speaker": 29, "form": "dlg", "jp": "（仲間になってくれる？）"},
{"id": 146, "speaker": 35, "form": "dlg", "jp": "（もちろんだよ！）"},
{"id": 147, "speaker": 35, "form": "dlg", "jp": "（さしずめ、オレは『イーグルブラック』ってとこかな？）"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "（たぶん『イエロー』じゃないかな？）"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "こうして、ボクたちの探していた最後の超能力者、\n『松尾さん』が無事仲間になった。"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "『クリエーター』の攻撃も本格的になりつつある‥‥"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "つまり‥‥"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "いよいよ『決戦』が近付いているということだ。"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "ボクたちは本当に\n『クリエーター』と戦うことができるんだろうか？"}
]
