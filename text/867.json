{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／２６／ＡＭ１０：１０"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「ピンポーン！！」"},
{"id": 2, "speaker": 3, "form": "dlg", "jp": "「ハ～イ！」"},
{"id": 3, "speaker": 3, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 4, "speaker": 3, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 5, "speaker": 35, "form": "dlg", "jp": "「常光寺ナゴムくんはいますか？」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "（この声は『松尾さん』！？）"},
{"id": 7, "speaker": 3, "form": "dlg", "jp": "「ナゴムになにか？」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "（マズイ！！）"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 10, "speaker": 3, "form": "dlg", "jp": "「ハア？」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「松尾さん！！」"},
{"id": 12, "speaker": 35, "form": "dlg", "jp": "「ナゴムくん！！」"},
{"id": 13, "speaker": 3, "form": "dlg", "jp": "「ナゴムの知り合い？」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「う、うん‥‥」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「と、とにかくあがってよ！！」"},
{"id": 16, "speaker": 35, "form": "dlg", "jp": "「オジャマシマス‥‥」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「いったいどうしてウチに？」"},
{"id": 18, "speaker": 35, "form": "dlg", "jp": "「ジーンがここに集合って‥‥」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "（本当にかってなんだから‥‥）"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「『集合』ってことは？」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「ピンポーン！！」"},
{"id": 22, "speaker": 3, "form": "dlg", "jp": "「ハ～イ！」"},
{"id": 23, "speaker": 3, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 24, "speaker": 3, "form": "dlg", "jp": "「アラ、小田さん！！」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "（やっぱり‥‥）"},
{"id": 26, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「小田だろう？」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「あがってもらって！」"},
{"id": 29, "speaker": 51, "form": "dlg", "jp": "「おじゃまします」"},
{"id": 30, "speaker": 51, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
