[
{"id": 0, "speaker": null, "form": "dlg", "jp": "「コン、コン」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "「姉さん、入るよ」"},
{"id": 2, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 4, "speaker": 3, "form": "dlg", "jp": "「どうしたの？」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "「うん、ちょっと涼ませてもらおうと思って‥‥」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「姉さんは論文のまとめ？」"},
{"id": 7, "speaker": 3, "form": "dlg", "jp": "「ううん‥‥」"},
{"id": 8, "speaker": 3, "form": "dlg", "jp": "「シローと話していたの‥‥」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "「ウソ！？」"},
{"id": 10, "speaker": 3, "form": "dlg", "jp": "「ホントウよ！」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「で、シローはどこにいるの？」"},
{"id": 12, "speaker": 3, "form": "dlg", "jp": "「ココよ！！」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「えっ、コンピューターの中？」"},
{"id": 14, "speaker": 3, "form": "dlg", "jp": "「正確には違うけど‥‥」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「‥‥‥！？」"},
{"id": 16, "speaker": 5, "form": "dlg", "jp": "「キミたちの頭の上だよ‥‥」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「シロー！？」"},
{"id": 18, "speaker": 3, "form": "dlg", "jp": "「人工衛星の中から連絡してきてるのよ‥‥」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「人工衛星？」"},
{"id": 20, "speaker": 3, "form": "dlg", "jp": "「あの時の『軍事衛星』よ！」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「どうして、そんな所に‥‥？」"},
{"id": 22, "speaker": 5, "form": "dlg", "jp": "「『あの体』じゃ、\n　ルードの基地なんて破壊できないだろう？」"},
{"id": 23, "speaker": 5, "form": "dlg", "jp": "「だから、\n　米軍の軍事衛星をジャックしたんだよ‥‥」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「つまり‥‥」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「『シロー』は自分の意識を"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "電話回線を使って\n　"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "米軍の人工衛星に"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "移動させちゃった‥‥」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「‥‥てこと？」"},
{"id": 30, "speaker": 5, "form": "dlg", "jp": "「うん、その通りだよ‥‥」"},
{"id": 31, "speaker": 5, "form": "dlg", "jp": "「あと、１ヶ月はあの体は返してもらえないみたいだし」"},
{"id": 32, "speaker": 5, "form": "dlg", "jp": "「もうしばらくここにいるつもりだよ‥‥」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「そ、そうなんだ‥‥」"},
{"id": 34, "speaker": 5, "form": "dlg", "jp": "「そんなことより、『宿題』は順調なのかい？」"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "「アハハハハハハ‥‥」"},
{"id": 36, "speaker": 5, "form": "dlg", "jp": "「笑うってことは順調なんだね？」"},
{"id": 37, "speaker": 3, "form": "dlg", "jp": "「笑ってごまかしてるのよ！」"},
{"id": 38, "speaker": 3, "form": "dlg", "jp": "「もう少し、\n　人間の感情を勉強しないといけないわね‥‥」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「で、今日は父さんから連絡はあったの？」"},
{"id": 40, "speaker": 3, "form": "dlg", "jp": "「ないわよ！」"},
{"id": 41, "speaker": 3, "form": "dlg", "jp": "「一応、三田さんには連絡してくるように\n　伝言頼んでおいたけど‥‥」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "「明後日の『パーティー』の準備とか大丈夫なの？」"},
{"id": 43, "speaker": 3, "form": "dlg", "jp": "「さあ‥‥」"},
{"id": 44, "speaker": 3, "form": "dlg", "jp": "「あのヒゲのまま出席するつもりじゃないの‥‥」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「うわぁ、その可能性大だね‥‥」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「コン、コン」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「姉さん、入るよ」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 50, "speaker": 3, "form": "dlg", "jp": "「ナゴム、よろこんで！」"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "「何だよいきなり？」"},
{"id": 52, "speaker": 3, "form": "dlg", "jp": "「『シロー』は生きているわ！」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「ウソ！？」"},
{"id": 54, "speaker": 3, "form": "dlg", "jp": "「電話会社のデータベースをのぞいてみたの‥‥」"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「ちょっと、それって『ハッキング』じゃあ‥‥？」"},
{"id": 56, "speaker": 3, "form": "dlg", "jp": "「事件解決のためよ！！」"},
{"id": 57, "speaker": 3, "form": "dlg", "jp": "「しかたないわ‥‥」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「で、何がわかったの？」"},
{"id": 59, "speaker": 3, "form": "dlg", "jp": "「シローが父さんのところに電話をかけた後、父さんの\n　所からアメリカの大学に電話がかけられてたの‥‥」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「それがどうかしたの‥‥？」"},
{"id": 61, "speaker": 3, "form": "dlg", "jp": "「その後、同じ回線から米軍のコンピュータに\n　アクセスされているのよ‥‥」"},
{"id": 62, "speaker": 3, "form": "choice", "jp": "「だから‥‥？」"},
{"id": 63, "speaker": 3, "form": "choice", "jp": "「えっ、ホント！」"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "「だから‥‥？」"},
{"id": 65, "speaker": 3, "form": "dlg", "jp": "「まだわからないの‥‥？」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「えっ、ホント！」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「‥‥って、ことは‥‥？」"},
{"id": 68, "speaker": 3, "form": "dlg", "jp": "「あの工場での"},
{"id": 69, "speaker": 3, "form": "dlg", "jp": "『館内放送』"},
{"id": 70, "speaker": 3, "form": "dlg", "jp": "を憶えてる？」"},
{"id": 71, "speaker": 3, "form": "dlg", "jp": "「あの時、あの放送は明らかに\n　私たちの名前を呼んだわ‥‥」"},
{"id": 72, "speaker": 3, "form": "dlg", "jp": "「つまり‥‥」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「あの放送は『シロー』だっていうの？」"},
{"id": 74, "speaker": 3, "form": "dlg", "jp": "「多分ね‥‥」"},
{"id": 75, "speaker": 3, "form": "dlg", "jp": "「シローは\n　あのままでは警察に消されてしまうと思って」"},
{"id": 76, "speaker": 3, "form": "dlg", "jp": "「自分のデータを電話回線を使って\n　一旦父さんの所に退避させ‥‥」"},
{"id": 77, "speaker": 3, "form": "dlg", "jp": "「そこからアメリカの大学を経由して\n　米軍のコンピュータに逃げ込んだんじゃないかしら？」"},
{"id": 78, "speaker": 3, "form": "dlg", "jp": "「さすがに軍の中までは警察も入れないでしょうし‥‥」"},
{"id": 79, "speaker": 3, "form": "choice", "jp": "「じゃあ、今、シローは軍のコンピュータに？」"},
{"id": 80, "speaker": 3, "form": "choice", "jp": "「でもどうやって、あの基地へ？」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「じゃあ、今、シローは軍のコンピュータに？」"},
{"id": 82, "speaker": 3, "form": "dlg", "jp": "「いえ、そうじゃないわ！」"},
{"id": 83, "speaker": 3, "form": "dlg", "jp": "「軍のコンピュータにいつまでも\n　いるとは考えられない‥‥」"},
{"id": 84, "speaker": 3, "form": "dlg", "jp": "「第一、そんな所に長時間いたら、\n　ウイルス駆除ソフトに駆逐されてしまうわ‥‥」"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "「じゃあ、どこに‥‥？」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「まさか、姉さん‥‥」"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "「あの『ルード』の基地にいたって言うんじゃぁ‥‥」"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "「それなら、やっぱり『シロー』は\n　消されちゃったんじゃぁないかな‥‥」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「工場はあの『軍事衛星』に\n　メチャメチャに破壊されちゃったし‥‥」"},
{"id": 90, "speaker": 3, "form": "dlg", "jp": "「ナゴム、それよ！！」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「姉さん、まさかっ！」"},
{"id": 92, "speaker": 3, "form": "dlg", "jp": "「そう、あの"},
{"id": 93, "speaker": 3, "form": "dlg", "jp": "『軍事衛星』"},
{"id": 94, "speaker": 3, "form": "dlg", "jp": "の中よ！」"},
{"id": 95, "speaker": 3, "form": "dlg", "jp": "「あの中から、"},
{"id": 96, "speaker": 3, "form": "dlg", "jp": "衛星回線"},
{"id": 97, "speaker": 3, "form": "dlg", "jp": "を使って、\n　館内放送を流したんじゃぁないかしら？」"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "「じゃあ、あの攻撃も‥‥」"},
{"id": 99, "speaker": 3, "form": "dlg", "jp": "「多分、『シロー』ね‥‥」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "「でもどうやって、あの基地へ？」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "「それに、もし、あの基地にいたんなら\n　今はもう消されちゃったんじゃぁ‥‥」"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「工場はあの『軍事衛星』に\n　メチャメチャに破壊されちゃったし‥‥」"},
{"id": 103, "speaker": 3, "form": "dlg", "jp": "「ナゴム、それよ！！」"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "「姉さん、まさかっ！」"},
{"id": 105, "speaker": 3, "form": "dlg", "jp": "「そう、あの"},
{"id": 106, "speaker": 3, "form": "dlg", "jp": "『軍事衛星』"},
{"id": 107, "speaker": 3, "form": "dlg", "jp": "の中よ！」"},
{"id": 108, "speaker": 3, "form": "dlg", "jp": "「あの中から、"},
{"id": 109, "speaker": 3, "form": "dlg", "jp": "衛星回線"},
{"id": 110, "speaker": 3, "form": "dlg", "jp": "を使って、\n　館内放送を流したんじゃぁないかしら？」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "「じゃあ、あの攻撃も‥‥」"},
{"id": 112, "speaker": 3, "form": "dlg", "jp": "「多分、『シロー』ね‥‥」"},
{"id": 113, "speaker": 3, "form": "dlg", "jp": "「軍のコンピュータにいつまでも\n　いるとは考えられないわ‥‥」"},
{"id": 114, "speaker": 3, "form": "dlg", "jp": "「第一、そんな所に長時間いたら、\n　ウイルス駆除ソフトに駆逐されてしまうでしょうし‥‥」"},
{"id": 115, "speaker": 3, "form": "dlg", "jp": "「だから、軍の回線を使って\n　あの軍事衛星まで逃げ込んだ‥‥」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「つまり‥‥」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「『シロー』は自分の意識を"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "電話回線を使って\n　"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "米軍の人工衛星に"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "移動させちゃった‥‥」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「‥‥てこと？」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「でも、ずいぶん大胆な推理だね‥‥」"},
{"id": 123, "speaker": 3, "form": "dlg", "jp": "「そうかしら‥‥？」"},
{"id": 124, "speaker": 3, "form": "dlg", "jp": "「だって、おかしいと思わない？」"},
{"id": 125, "speaker": 3, "form": "dlg", "jp": "「あれだけ、大掛かりな攻撃を『軍事衛星』まで使って\n　やっておきながら一切の発表がないのよ‥‥」"},
{"id": 126, "speaker": 3, "form": "dlg", "jp": "「軍の判断でしたことなら、\n　きちんと発表されるハズでしょう？」"},
{"id": 127, "speaker": 3, "form": "dlg", "jp": "「それがないってことは、\n　きっと軍とは無関係に行われた攻撃だと思うの‥‥」"},
{"id": 128, "speaker": 3, "form": "dlg", "jp": "「ネット上にも、"},
{"id": 129, "speaker": 3, "form": "dlg", "jp": "『軍事衛星が暴走した』"},
{"id": 130, "speaker": 3, "form": "dlg", "jp": "って\n　噂が最近ふえてきているの‥‥」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「じゃあ、やっぱり『シロー』が‥‥」"},
{"id": 132, "speaker": 3, "form": "dlg", "jp": "「私はそう信じるわ‥‥」"},
{"id": 133, "speaker": 3, "form": "choice", "jp": "「そうかなぁ‥‥」"},
{"id": 134, "speaker": 3, "form": "choice", "jp": "「ボクもそう思うよ‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「そうかなぁ‥‥」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「ボクもそう思うよ‥‥」"},
{"id": 137, "speaker": 3, "form": "dlg", "jp": "「ところで、何か用があったんじゃないの？」"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "「いや、別に‥‥」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「ただ、涼ませてもらおうと‥‥」"},
{"id": 140, "speaker": 3, "form": "dlg", "jp": "「そう‥‥」"}
]
