{"id": 41, "speaker": null, "form": "dlg", "jp": "アイコが死んでます。"},
{"id": 42, "speaker": null, "form": "dlg", "jp": "アキラが死んでます。"},
{"id": 43, "speaker": null, "form": "dlg", "jp": "ナナセが死んでます。"},
{"id": 44, "speaker": null, "form": "dlg", "jp": "ではゲームスタート！"},
{"id": 45, "speaker": null, "form": "dlg", "jp": "２００５／０７／２２／ＡＭ０９：２０"},
{"id": 46, "speaker": null, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 47, "speaker": null, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 48, "speaker": null, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 49, "speaker": 3, "form": "dlg", "jp": "「ハイ、常光寺です‥‥」"},
{"id": 50, "speaker": 3, "form": "dlg", "jp": "「えっ、ナゴム？」"},
{"id": 51, "speaker": 3, "form": "dlg", "jp": "「ええ、ちょっと待ってね‥‥」"},
{"id": 52, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～」"},
{"id": 53, "speaker": 3, "form": "dlg", "jp": "「『アキラちゃん』から電話よ‥‥」"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "「いま行くよ‥‥」"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 56, "speaker": 3, "form": "dlg", "jp": "「ダメよ、夏休みでも早起きしなくちゃ！」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "「ハイハイ‥‥」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「もしもし‥‥」"},
{"id": 59, "speaker": 16, "form": "dlg", "jp": "「"},
{"id": 60, "speaker": 16, "form": "dlg", "jp": "（あっ、アキラ‥‥）"},
{"id": 61, "speaker": 16, "form": "dlg", "jp": "」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "「うん、どうかしたの？」"},
{"id": 63, "speaker": 16, "form": "dlg", "jp": "「"},
{"id": 64, "speaker": 16, "form": "dlg", "jp": "（ねえ、常光寺くん、今日はヒマ？）"},
{"id": 65, "speaker": 16, "form": "dlg", "jp": "」"},
{"id": 66, "speaker": 16, "form": "dlg", "jp": "まあ、ヒマと言えばヒマだけど‥‥"},
{"id": 67, "speaker": 16, "form": "dlg", "jp": "いつジーンたちから\n連絡があるかわからないし‥‥"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "「今日はちょっと‥‥」"},
{"id": 69, "speaker": 16, "form": "dlg", "jp": "「"},
{"id": 70, "speaker": 16, "form": "dlg", "jp": "（えっ、大事な用事でもあるの？）"},
{"id": 71, "speaker": 16, "form": "dlg", "jp": "」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "「いや、別に‥‥」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "『ジーンたちのこと』を言うわけには‥‥"},
{"id": 74, "speaker": 16, "form": "dlg", "jp": "「"},
{"id": 75, "speaker": 16, "form": "dlg", "jp": "（じゃあ、どうしたの？）"},
{"id": 76, "speaker": 16, "form": "dlg", "jp": "」"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "「ううん、なんでもないよ‥‥」"},
{"id": 78, "speaker": 16, "form": "dlg", "jp": "「"},
{"id": 79, "speaker": 16, "form": "dlg", "jp": "（じゃあ、ちょっと付き合ってくれない！）"},
{"id": 80, "speaker": 16, "form": "dlg", "jp": "」"},
{"id": 81, "speaker": 16, "form": "dlg", "jp": "結局そうなっちゃうんだよな‥‥"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「いいけど‥‥」"},
{"id": 83, "speaker": 16, "form": "dlg", "jp": "「"},
{"id": 84, "speaker": 16, "form": "dlg", "jp": "（じゃあ、後でそっち行くから‥‥）"},
{"id": 85, "speaker": 16, "form": "dlg", "jp": "」"},
{"id": 86, "speaker": 16, "form": "dlg", "jp": "「"},
{"id": 87, "speaker": 16, "form": "dlg", "jp": "（うん、お昼すぎぐらいね！）"},
{"id": 88, "speaker": 16, "form": "dlg", "jp": "」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「うん、わかった‥‥」"},
{"id": 90, "speaker": 3, "form": "dlg", "jp": "「『小田さん』から電話よ‥‥」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「いま行くよ‥‥」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 93, "speaker": 3, "form": "dlg", "jp": "「ダメよ、夏休みでも早起きしなくちゃ！」"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "「ハイハイ‥‥」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「もしもし‥‥」"},
{"id": 96, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 97, "speaker": 51, "form": "dlg", "jp": "（あっ、小田やけど‥‥）"},
{"id": 98, "speaker": 51, "form": "dlg", "jp": "」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「うん、どうかしたの？」"},
{"id": 100, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 101, "speaker": 51, "form": "dlg", "jp": "（あんな～、ジブン今日カラダあいてへん？）"},
{"id": 102, "speaker": 51, "form": "dlg", "jp": "」"},
{"id": 103, "speaker": 51, "form": "dlg", "jp": "これって‥‥"},
{"id": 104, "speaker": 51, "form": "dlg", "jp": "『あのね、アナタは今日はヒマですか？』\nってことだよな？"},
{"id": 105, "speaker": 51, "form": "dlg", "jp": "まあ、ヒマと言えばヒマだけど‥‥"},
{"id": 106, "speaker": 51, "form": "dlg", "jp": "いつジーンたちから\n連絡があるかわからないし‥‥"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「今日はちょっと‥‥」"},
{"id": 108, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 109, "speaker": 51, "form": "dlg", "jp": "（ちょっとどうしたん？）"},
{"id": 110, "speaker": 51, "form": "dlg", "jp": "」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "「いや、別に‥‥」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "『ジーンたちのこと』を言うわけには‥‥"},
{"id": 113, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 114, "speaker": 51, "form": "dlg", "jp": "（別にってことは何もないんやね？）"},
{"id": 115, "speaker": 51, "form": "dlg", "jp": "」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「ま、まあ‥‥」"},
{"id": 117, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 118, "speaker": 51, "form": "dlg", "jp": "（じゃあ、ちょっと付き合ってよ‥‥）"},
{"id": 119, "speaker": 51, "form": "dlg", "jp": "」"},
{"id": 120, "speaker": 51, "form": "dlg", "jp": "結局そうなっちゃうんだよな‥‥"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「いいけど‥‥」"},
{"id": 122, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 123, "speaker": 51, "form": "dlg", "jp": "（じゃあ、後でそっち行くから‥‥）"},
{"id": 124, "speaker": 51, "form": "dlg", "jp": "」"},
{"id": 125, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 126, "speaker": 51, "form": "dlg", "jp": "（たぶん、お昼すぎぐらい‥‥）"},
{"id": 127, "speaker": 51, "form": "dlg", "jp": "」"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "「うん、わかった‥‥」"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "「ガチャン！」"},
{"id": 130, "speaker": 3, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「昼すぎにこっちに来るって‥‥」"},
{"id": 132, "speaker": 3, "form": "dlg", "jp": "「もしかしてデート？」"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "「そんなんじゃないよ‥‥」"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "ボクはてきとうに返事をして\n自分の部屋に戻ろうとした。"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "その時‥‥"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "またか‥‥"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "「ボクがでるよ！」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "「モシモシ‥‥」"},
{"id": 142, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 143, "speaker": 29, "form": "dlg", "jp": "（その声はナゴムね‥‥）"},
{"id": 144, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「ジーン！？」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「どうして、電話番号を‥‥」"},
{"id": 147, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 148, "speaker": 29, "form": "dlg", "jp": "（調べたのよ！）"},
{"id": 149, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 151, "speaker": 29, "form": "dlg", "jp": "（そんなことより、ちょっと出て来れない？）"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「午後から友だちと会う約束が‥‥」"},
{"id": 154, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 155, "speaker": 29, "form": "dlg", "jp": "（何言ってるの！）"},
{"id": 156, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 157, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 158, "speaker": 29, "form": "dlg", "jp": "（今、出て来なさいよ！）"},
{"id": 159, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "「今‥‥！？」"},
{"id": 161, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 162, "speaker": 29, "form": "dlg", "jp": "（じゃあ、外で待ってるわよ！）"},
{"id": 163, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「ちょっと待ってよ！」"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "「ガチャン！」"},
{"id": 166, "speaker": 3, "form": "dlg", "jp": "「誰から？」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「ちょっとね‥‥」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ちょっと出かけてくるよ！」"},
{"id": 169, "speaker": 3, "form": "dlg", "jp": "「朝ゴハンは？」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「いいよ！」"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "外に出るとすでにジーンとケネスの２人がそこにいた。"},
{"id": 175, "speaker": 31, "form": "dlg", "jp": "「オハヨウ！」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「オハヨウ‥‥」"},
{"id": 177, "speaker": 31, "form": "dlg", "jp": "「ちゃんと眠れたか？」"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「眠れるわけないだろう！」"},
{"id": 179, "speaker": 29, "form": "dlg", "jp": "「もっと精神をきたえなさいよ！」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "「なんでそんな風になるのさ‥‥」"},
{"id": 181, "speaker": 29, "form": "dlg", "jp": "「私たち『能力者』の一番の『力』は精神力よ‥‥」"},
{"id": 182, "speaker": 31, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 183, "speaker": 31, "form": "dlg", "jp": "「強いイメージができるモノが\n　もっとも強い『能力者』だからな‥‥」"},
{"id": 184, "speaker": 29, "form": "dlg", "jp": "「こんなところで重要な話もできないし」"},
{"id": 185, "speaker": 29, "form": "dlg", "jp": "「とりあえず、\n　私たちのホテルに来て‥‥」"},
{"id": 186, "speaker": 29, "form": "dlg", "jp": "ボクはジーンたちが宿泊しているホテルに\n行くことになった。"},
{"id": 187, "speaker": 29, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「で、用は何なの？」"},
{"id": 189, "speaker": 29, "form": "dlg", "jp": "「用も何も、私たちの使命は１つだけよ‥‥」"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "「『ノア』を取りもどすこと‥‥」"},
{"id": 191, "speaker": 31, "form": "dlg", "jp": "「で、今重要なのは‥‥」"},
{"id": 192, "speaker": 29, "form": "dlg", "jp": "「『ノアを盗んだ犯人』を見つけること‥‥」"},
{"id": 193, "speaker": 29, "form": "dlg", "jp": "「つまり、\n　残りの４人の『能力者』を見つけるってこと‥‥」"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "「だから‥‥」"},
{"id": 195, "speaker": 29, "form": "dlg", "jp": "「情報を集めて欲しいのよ‥‥」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「『情報』‥‥？」"},
{"id": 197, "speaker": 29, "form": "dlg", "jp": "「本部から１つ情報が送られて来たの‥‥」"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "「どんな？」"},
{"id": 199, "speaker": 29, "form": "dlg", "jp": "「『日本』に\n　『能力を悪用している能力者』がいるって‥‥」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "『能力を悪用している能力者』"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "！？」"},
{"id": 203, "speaker": 29, "form": "dlg", "jp": "「詳しいことは本部でも\n　わかっていないみたい‥‥」"},
{"id": 204, "speaker": 29, "form": "dlg", "jp": "「とにかく、ただ"},
{"id": 205, "speaker": 29, "form": "dlg", "jp": "『邪悪なイメージ』"},
{"id": 206, "speaker": 29, "form": "dlg", "jp": "が\n　本部でキャッチされたみたいなの‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 208, "speaker": 2, "form": "dlg", "jp": "『邪悪なイメージ』"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "？」"},
{"id": 210, "speaker": 29, "form": "dlg", "jp": "「『能力』を使うには『念じる』わけだから\n　『テレパシー』みたいなものが発生するの‥‥」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「なら、\n　その『テレパシー』を逆探知すれば‥‥」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "「ジーンなら簡単にできるんじゃないの？」"},
{"id": 213, "speaker": 31, "form": "dlg", "jp": "「『テレパシー』を\n　感知できたら可能だろうな‥‥」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "「じゃあ、できないの？」"},
{"id": 215, "speaker": 29, "form": "dlg", "jp": "「私の能力も普通の人間の聴力も\n　同じようなものなのよ‥‥」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「どういう意味？」"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "「意識した物しか\n　聞こえないし、見えないの‥‥」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 219, "speaker": 31, "form": "dlg", "jp": "「たとえば、世の中には色んな音がなってるけど\n　それをすべて聞き分けてるわけじゃないだろう？」"},
{"id": 220, "speaker": 31, "form": "dlg", "jp": "「授業中に教師が説明をしていても、\n　耳に入ってこないことってあるだろう？」"},
{"id": 221, "speaker": 31, "form": "dlg", "jp": "「それと同じさ‥‥」"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "「つまり、まずその『テレパシー』を\n　キャッチしないとダメってこと？」"},
{"id": 223, "speaker": 29, "form": "dlg", "jp": "「そうよ‥‥」"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "「で、ボクにも『情報』を集めろと‥‥」"},
{"id": 225, "speaker": 31, "form": "dlg", "jp": "「まあ、そういうことだ‥‥」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「ボクにできるのかな？」"},
{"id": 227, "speaker": 29, "form": "dlg", "jp": "「この中ではナゴムが\n　一番情報を集めやすいハズよ‥‥」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「どうして？」"},
{"id": 229, "speaker": 31, "form": "dlg", "jp": "「オマエだけが『日本人』だろう！」"},
{"id": 230, "speaker": 29, "form": "dlg", "jp": "「当然、顔見知りも多いし、\n　いろいろ動き回っても怪しまれないし‥‥」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「『日本』って言っても広いわけだし‥‥」"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "「それなら大丈夫‥‥」"},
{"id": 234, "speaker": 29, "form": "dlg", "jp": "「すでにある程度目星はついているから‥‥」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「目星？」"},
{"id": 236, "speaker": 29, "form": "dlg", "jp": "「私たち『能力者』には\n　ある種の『ルール』があるの‥‥」"},
{"id": 237, "speaker": 29, "form": "dlg", "jp": "「『能力者同士は引かれあう』っていう」"},
{"id": 238, "speaker": 31, "form": "dlg", "jp": "「つまり、バラバラでいるようで\n　実はいつのまにか集まってしまうものなんだ‥‥」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「じゃあ、探しまわらなくても‥‥」"},
{"id": 240, "speaker": 31, "form": "dlg", "jp": "「集まるっていってもグウゼン出会う程度だ‥‥」"},
{"id": 241, "speaker": 31, "form": "dlg", "jp": "「意識しなければ、\n　出会えてないのと同じなんだよ‥‥」"},
{"id": 242, "speaker": 29, "form": "dlg", "jp": "「それに放っておけば、\n　『能力の悪用』で手がつけられなくなるしね‥‥」"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「ふーん‥‥」"},
{"id": 244, "speaker": 29, "form": "dlg", "jp": "「とにかく、『能力者同士は引かれあう』\n　ってルールがあるかぎり‥‥」"},
{"id": 245, "speaker": 29, "form": "dlg", "jp": "「いつかはソイツと出会うことになるのよ‥‥」"},
{"id": 246, "speaker": 31, "form": "dlg", "jp": "「そこでだ‥‥」"},
{"id": 247, "speaker": 31, "form": "dlg", "jp": "「それらをひっくるめて推理すると、\n　こういうことになる‥‥」"},
{"id": 248, "speaker": 31, "form": "dlg", "jp": "「この『日本』って国で\n　『能力が悪用されている』‥‥」"},
{"id": 249, "speaker": 31, "form": "dlg", "jp": "「つまり、普通じゃない事件が起きている‥‥」"},
{"id": 250, "speaker": 31, "form": "dlg", "jp": "「そして、その犯人はいずれオレたちと\n　出会うことになるってことだ」"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "「それがどうかしたの？」"},
{"id": 252, "speaker": 29, "form": "dlg", "jp": "「つまり、日本で起きている不思議な事件で\n　この近くで発生している事件を調べれば‥‥」"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "「犯人の『能力者』に出会えるかもしれない！」"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "「そういうことよ‥‥」"},
{"id": 255, "speaker": 31, "form": "dlg", "jp": "「そこでだ、オレたちは最近この国で起こっている\n　"},
{"id": 256, "speaker": 31, "form": "dlg", "jp": "『不思議な事件』"},
{"id": 257, "speaker": 31, "form": "dlg", "jp": "をいろいろ調べてみたんだ」"},
{"id": 258, "speaker": 31, "form": "dlg", "jp": "「で、１つ気になる事件を見つけたわけだ‥‥」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「気になる事件？」"},
{"id": 260, "speaker": 31, "form": "dlg", "jp": "「ナゴムも知ってるだろう？」"},
{"id": 261, "speaker": 31, "form": "dlg", "jp": "「"},
{"id": 262, "speaker": 31, "form": "dlg", "jp": "『犬』"},
{"id": 263, "speaker": 31, "form": "dlg", "jp": "が"},
{"id": 264, "speaker": 31, "form": "dlg", "jp": "『人間を襲う』"},
{"id": 265, "speaker": 31, "form": "dlg", "jp": "って事件‥‥」"},
{"id": 266, "speaker": 31, "form": "dlg", "jp": "そういえば、最近そんな事件が\n立て続けに起こってるよな‥‥"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "「でも、それって"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "『犬』"},
{"id": 269, "speaker": 2, "form": "dlg", "jp": "がやってることで、\n　別に人間は‥‥」"},
{"id": 270, "speaker": 29, "form": "dlg", "jp": "「そうなんだけど、この事件が不思議なのは」"},
{"id": 271, "speaker": 29, "form": "dlg", "jp": "「人間を襲った犬はすべて、\n　まともな犬だったってこと‥‥」"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "「まとも？」"},
{"id": 273, "speaker": 29, "form": "dlg", "jp": "「そう‥‥、狂犬病とか\n　乱暴な性格とかそういうのじゃないの‥‥」"},
{"id": 274, "speaker": 29, "form": "dlg", "jp": "「事件が起きるまでは\n　大人しい飼い犬ばかりなの‥‥」"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "「でも、\n　それって別に『能力』と関係あるとは‥‥」"},
{"id": 277, "speaker": 29, "form": "dlg", "jp": "「もうひとつ注目して欲しいのが\n　事件の発生日時と場所よ‥‥」"},
{"id": 278, "speaker": 29, "form": "dlg", "jp": "「最初にこの手の事件で記録に残ってるのが\n　今年の４月２４日、場所はＣ市‥‥」"},
{"id": 279, "speaker": 29, "form": "dlg", "jp": "「続いて、５月にＣ市で４件同様の事件があって\n　６月にＢ市で４件発生‥‥」"},
{"id": 280, "speaker": 29, "form": "dlg", "jp": "「さらに今月に入って３件発生してるんだけど、\n　それがすべてＡ市‥‥」"},
{"id": 281, "speaker": 31, "form": "dlg", "jp": "「つまり、だんだんこの町に\n　近付いて来てるんだ‥‥」"},
{"id": 282, "speaker": 29, "form": "dlg", "jp": "「この事件が狂犬病のように\n　伝染する病気ならば‥‥」"},
{"id": 283, "speaker": 29, "form": "dlg", "jp": "「Ｃ市を中心に同心円状に\n　各地に広がって行くはず」"},
{"id": 284, "speaker": 29, "form": "dlg", "jp": "「しかし、実際はＣ市から一直線で\n　Ａ市つまりこの町に近付いて来ているの‥‥」"},
{"id": 285, "speaker": 29, "form": "dlg", "jp": "「これってゼッタイおかしいでしょう？」"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "「だからと言って、\n　『超能力者』の仕業だとは‥‥」"},
{"id": 287, "speaker": 29, "form": "dlg", "jp": "「さっきの"},
{"id": 288, "speaker": 29, "form": "dlg", "jp": "『ルール』"},
{"id": 289, "speaker": 29, "form": "dlg", "jp": "を忘れたの？」"},
{"id": 290, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 291, "speaker": 29, "form": "dlg", "jp": "『能力者同士は引かれあう』"},
{"id": 292, "speaker": 29, "form": "dlg", "jp": "‥‥」"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "「じゃあ、犬たちは『超能力者』に操られて\n　人間を襲ってるってこと？」"},
{"id": 294, "speaker": 31, "form": "dlg", "jp": "「たぶんな‥‥」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "「でも、そんなことして何か意味があるの？」"},
{"id": 296, "speaker": 29, "form": "dlg", "jp": "「それよ！」"},
{"id": 297, "speaker": 29, "form": "dlg", "jp": "「意味よ、意味！！」"},
{"id": 298, "speaker": 29, "form": "dlg", "jp": "「その意味さえわかれば、犯人がわかるハズ」"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "「なんで？」"},
{"id": 300, "speaker": 31, "form": "dlg", "jp": "「たとえば、ウラミがあって人を\n　襲わせてるんならウラミを持ってるヤツが犯人」"},
{"id": 301, "speaker": 31, "form": "dlg", "jp": "「物取り目的でやったんなら、\n　なにか証拠になるものをうばってるハズ‥‥」"},
{"id": 302, "speaker": 2, "form": "dlg", "jp": "「なるほど！！」"},
{"id": 303, "speaker": 29, "form": "dlg", "jp": "「これらの事件に何かかならず\n　共通するものがあるハズだから」"},
{"id": 304, "speaker": 29, "form": "dlg", "jp": "「それを手がかりにすれば‥‥」"},
{"id": 305, "speaker": 31, "form": "dlg", "jp": "「ナゴムはこの町の人間なんだから、\n　知り合いにこの事件の関係者がいるかも‥‥」"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "「でも、ソイツが『ノア』を盗み出したんだとしたら」"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "「素直に返してくれるかな？」"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "「能力を悪用するヤツなんだろう？」"},
{"id": 309, "speaker": 29, "form": "dlg", "jp": "「まずは説得ね‥‥」"},
{"id": 310, "speaker": 29, "form": "dlg", "jp": "「例え悪人であっても、人類存亡の為なら\n　協力するかもしれないでしょう？」"},
{"id": 311, "speaker": 29, "form": "dlg", "jp": "「それでも、協力しないような悪人なら\n　『死んでもらう』しかないわね‥‥」"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥」"},
{"id": 313, "speaker": 29, "form": "dlg", "jp": "「とにかく、そいつを見つけないと\n　意味がないし‥‥」"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "「じゃあ、もう帰っていいかな？」"},
{"id": 316, "speaker": 2, "form": "dlg", "jp": "「友だちが来るんだよ‥‥」"},
{"id": 317, "speaker": 29, "form": "dlg", "jp": "「かまわないわよ‥‥」"},
{"id": 318, "speaker": 29, "form": "dlg", "jp": "「じゃ、情報収集たのんだわよ‥‥」"},
{"id": 319, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 320, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 321, "speaker": 2, "form": "dlg", "jp": "情報収集か‥‥"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "いったい、\n何のために『犬』なんて操るんだろう？"}
]
