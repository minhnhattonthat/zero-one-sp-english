[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／１７／ＡＭ０８：２０"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「コン！コン！」"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 3, "speaker": 3, "form": "dlg", "jp": "「ナゴム！」"},
{"id": 4, "speaker": 3, "form": "dlg", "jp": "「ナゴムってば！！」"},
{"id": 5, "speaker": 3, "form": "dlg", "jp": "「もう！　いいかげん起きなさい！！」"},
{"id": 6, "speaker": 3, "form": "dlg", "jp": "「夏休みだからって、ダラダラすごさないの！！」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「ネエサン‥‥」　"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「おはよう‥‥」　"},
{"id": 9, "speaker": 3, "form": "dlg", "jp": "「もう‥‥　シャキッとしなさい！」"},
{"id": 10, "speaker": 3, "form": "dlg", "jp": "「朝ごはん、さめちゃったわよ！」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」　"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "『不眠症』は克服出来たのだけど、\n逆に最近はなかなか起きられない。"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "原因はあの２人が夜遅くにやって来て、\n長時間粘るからだ‥‥"},
{"id": 14, "speaker": 3, "form": "dlg", "jp": "「姉さんもう出かけるから‥‥」"},
{"id": 15, "speaker": 3, "form": "dlg", "jp": "「食べ終わったら、お皿かたづけといてね！」"},
{"id": 16, "speaker": 3, "form": "dlg", "jp": "「じゃあ、もう出るわ！」"},
{"id": 17, "speaker": 3, "form": "dlg", "jp": "「バタン！」"},
{"id": 18, "speaker": 3, "form": "dlg", "jp": "さあ、もう起きるとするか‥‥"},
{"id": 19, "speaker": 3, "form": "dlg", "jp": "ボクは朝食を食べながら、\n『通り魔』のことを考えていた。"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "（『情報を集めろ』っていってもなぁ‥‥）"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "（だいたい‥‥）"},
{"id": 22, "speaker": 2, "form": "choice", "jp": "（本当に『超能力者』の仕業かどうか‥‥）"},
{"id": 23, "speaker": 2, "form": "choice", "jp": "（警察も捕まえられないのに‥‥）"},
{"id": 24, "speaker": 2, "form": "choice", "jp": "（あんまりかかわりたくないなぁ‥‥）"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "（本当に『超能力者』の仕業かどうか‥‥）"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "（それに正直いって、自分が『超能力者』だっていう\n　実感もないんだけど‥‥）"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "（警察も捕まえられないのに‥‥）"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "（ボクがどうにかできるとは‥‥）"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "（あんまりかかわりたくないなぁ‥‥）"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "（最近、どんどん面倒な問題に\n　巻き込まれていっている気がする）"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "（だいたい、『通り魔』なんかが『仲間』になるハズが‥‥）"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "（‥‥‥）"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "（確かに、同じ町に『キケンな人間』がいるってのは、\n　気になるけど‥‥）"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "（まっ）"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "（とりあえず、今ある情報をまとめてみよう！）"},
{"id": 36, "speaker": 2, "form": "choice", "jp": "（事件が発生してからもう５日‥‥）"},
{"id": 37, "speaker": 2, "form": "choice", "jp": "（事件が発生してからもう２ヶ月‥‥）"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "（事件が発生してからもう５日‥‥）"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "（いやいや、昨日『５日前』って話をしていたから‥‥）"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "（正確には『６日前』‥‥）"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "（それも、この町で事件が起きたのが『６日前』で、\n　似たような事件はたしか『２ヶ月』前から‥‥）"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "（事件が発生してからもう２ヶ月‥‥）"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "（で、この町で事件が起こったのが‥‥）"},
{"id": 44, "speaker": 2, "form": "choice", "jp": "（５日前‥‥）"},
{"id": 45, "speaker": 2, "form": "choice", "jp": "（６日前‥‥）"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "（５日前‥‥）"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "（いやいや、昨日『５日前』って話をしていたから‥‥）"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "（正確には『６日前』‥‥）"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "（６日前‥‥）"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "（でもって、普通では考えられない犯行手口‥‥）"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "（まるで、『超能力者』の仕業の様な‥‥）"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "（となると、一番怪しいのは‥‥）"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "（『６日前』にこの町に来た『超能力者』‥‥）"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "（‥‥‥！！）"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "（それって、『ジーンたち』じゃないか！？）"},
{"id": 56, "speaker": 2, "form": "choice", "jp": "（『ジーンたち』が『通り魔』！？）"},
{"id": 57, "speaker": 2, "form": "choice", "jp": "（そんなワケないか‥‥）"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "（『ジーンたち』が『通り魔』！？）"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "（十分考えられるぞ！！）"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "（そういえば、ボクが襲われた時も\n　『通り魔的』にいきなり襲われた‥‥）"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "（ちくしょう！）"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "（とりあえず、『ジーンたち』を問いただしてやろう‥‥）"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "（たしか、『ジーンたち』の泊まっているホテルは‥‥）"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "ボクは、以前ジーンからもらった\n連絡先の書いたメモを取り出し、"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "『ジーンたち』のいるホテルの場所を確認した。"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "（よし、この『ホテル』ならすぐ近くだ）"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "（さっそく行ってみよう！）"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "ボクは『ジーンたち』のいる『ホテル』に\n行くことにした。"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 70, "speaker": 29, "form": "dlg", "jp": "「バッカじゃないの！」"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "「なら、アナタに自分たちの正体をバラしたり」"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "「アナタの能力を目覚めさせたりするわけないでしょ！」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "怒られてしまった。"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "ボクは戻って考え直すことにした。"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "（やっぱり、\n　『ジーンたちが通り魔』のハズないよな‥‥）"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "（そんなワケないか‥‥）"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "（まあ、どっちにしろ、最近この町にやって来たヤツが\n　怪しいってことだよな‥‥）"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "（その点に絞って、情報を集めてみるか！）"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "（さて、こういうのって誰に聞くのがいいんだろう？）"},
{"id": 82, "speaker": 2, "form": "choice", "jp": "（やっぱり、警察かなぁ？）"},
{"id": 83, "speaker": 2, "form": "choice", "jp": "（三田さんってのもアリかも‥‥）"},
{"id": 84, "speaker": 2, "form": "choice", "jp": "（案外『先生』ってのもありかも‥‥）"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "（ちゃんと『情報』を集めておかないと\n　怒りだすんだろうな、ジーン‥‥）"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "（あと、聞くとしたら‥‥）"},
{"id": 87, "speaker": 2, "form": "choice", "jp": "（やっぱり、警察かなぁ？）"},
{"id": 88, "speaker": 2, "form": "choice", "jp": "（三田さんってのもアリかも‥‥"},
{"id": 89, "speaker": 2, "form": "choice", "jp": "（案外『先生』ってのもありかも‥‥）"},
{"id": 90, "speaker": 2, "form": "choice", "jp": "（やっぱり、警察かなぁ？）"},
{"id": 91, "speaker": 2, "form": "choice", "jp": "（三田さんってのもアリかも‥‥）"},
{"id": 92, "speaker": 2, "form": "choice", "jp": "（案外『先生』ってのもありかも‥‥）"},
{"id": 93, "speaker": 2, "form": "choice", "jp": "（三田さんってのもアリかも‥‥）"},
{"id": 94, "speaker": 2, "form": "choice", "jp": "（案外『先生』ってのもありかも‥‥）"},
{"id": 95, "speaker": 2, "form": "choice", "jp": "（案外『先生』ってのもありかも‥‥）"},
{"id": 96, "speaker": 2, "form": "choice", "jp": "（いや、あの先生には聞いてもムダだな‥‥）"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "（いや、あの先生には聞いてもムダだな‥‥）"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "（まあ、これだけ情報を集めれば十分だろう‥‥）"},
{"id": 99, "speaker": 2, "form": "choice", "jp": "（やっぱり、警察かなぁ？）"},
{"id": 100, "speaker": 2, "form": "choice", "jp": "（案外『先生』ってのもありかも‥‥）"},
{"id": 101, "speaker": 2, "form": "choice", "jp": "（やっぱり、警察かなぁ？）"},
{"id": 102, "speaker": 2, "form": "choice", "jp": "（三田さんってのもアリかも‥‥）"},
{"id": 103, "speaker": 2, "form": "choice", "jp": "（やっぱり、警察かなぁ？）"},
{"id": 104, "speaker": 2, "form": "choice", "jp": "（案外『先生』ってのもありかも‥‥）"},
{"id": 105, "speaker": 2, "form": "choice", "jp": "（やっぱり、警察かなぁ？）"},
{"id": 106, "speaker": 2, "form": "choice", "jp": "（三田さんってのもアリかも‥‥）"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "（まあ、これだけ情報を集めれば十分だろう‥‥）"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "（やっぱり、警察かなぁ？）"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "（でも、警察も捕まえられていないしなぁ‥‥）"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "（それに、どうやって警察に聞けばいいんだか‥‥）"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "（まさか、１１０番の電話して聞くワケにもいかないし）"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "（とりあえず、警察に行ってみよう）"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "ボクは警察に行ってみることにした。"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥）"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "（ここに来るとどうしても、\n　『シロー』のことを思い出しちゃうな‥‥）"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥）"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "（警部さん、いるかな？）"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「失礼します‥‥」"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "（警部さんはどこだ？）"},
{"id": 126, "speaker": 20, "form": "dlg", "jp": "「ひさしぶり！」"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「警部さんは？」"},
{"id": 128, "speaker": 20, "form": "dlg", "jp": "「いま、『通り魔事件』の聞き込みに出ているよ！」"},
{"id": 129, "speaker": 20, "form": "dlg", "jp": "「どうかしたのかい？」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「いえ、別に‥‥」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「じゃあ、失礼しました！」"},
{"id": 132, "speaker": 20, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 133, "speaker": 20, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 134, "speaker": 20, "form": "dlg", "jp": "「バタン！」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "（警部さんもいそがしいみたいだな‥‥）"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "（一旦、家に帰るか‥‥）"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "（やっぱり、警察かなぁ？）"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "（警部さんに話が聞けると一番いいんだけど‥‥）"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "（警部さんは留守みたいだし‥‥）"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥）"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "（ジーンに怒られるよりマシか‥‥）"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "（とにかく、もう一度警察に行ってみるか‥‥）"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「ピンポーン！！」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "（誰だろう？）"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「ハイ！」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 151, "speaker": 11, "form": "dlg", "jp": "「ひさしぶり！」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「警部さん！」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「今日は何の用ですか？」"},
{"id": 154, "speaker": 11, "form": "dlg", "jp": "「例の『通り魔』の件で、\n　この辺りの聞き込みをさせられてるんだ」"},
{"id": 155, "speaker": 11, "form": "dlg", "jp": "「『ルードの事件』で失敗続きだったから、\n　コッチの方にまわされちまってなあ‥‥」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 157, "speaker": 11, "form": "dlg", "jp": "「で、お姉さんは？」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「出かけています。　多分、大学じゃぁ‥‥」"},
{"id": 159, "speaker": 11, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 160, "speaker": 11, "form": "dlg", "jp": "「まあ、ナゴムくんでもいいんだけど‥‥」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「暑い中　大変でしょう？」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「とりあえず、上がってください」"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「冷たい飲み物入れますから‥‥」"},
{"id": 164, "speaker": 11, "form": "dlg", "jp": "「ありがとう。\n　じゃ、お言葉にあまえて‥‥」"},
{"id": 165, "speaker": 11, "form": "dlg", "jp": "「バタン！」"},
{"id": 166, "speaker": 11, "form": "dlg", "jp": "ボクは警部さんからじっくりと\n情報を聞き出すことにした。"},
{"id": 167, "speaker": 11, "form": "dlg", "jp": "「最近、この辺に怪しいヤツが\n　引っ越して来たってことはないかい？」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "（やっぱり、警察も同じこと考えてるんだ！）"},
{"id": 169, "speaker": 11, "form": "dlg", "jp": "「なあ、知らないかな？」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「ハイ、ちょっと‥‥」"},
{"id": 171, "speaker": 11, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「その様子じゃぁ、\n　まだ有力な情報がなさそうですね？」"},
{"id": 173, "speaker": 11, "form": "dlg", "jp": "「ううん‥‥」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「目撃者とかいるんでしょう？」"},
{"id": 175, "speaker": 11, "form": "dlg", "jp": "「ああ、いるにはいるんだが‥‥」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「信用できないんですか？」"},
{"id": 177, "speaker": 11, "form": "dlg", "jp": "「いや、そういうわけでもないんだが‥‥」"},
{"id": 178, "speaker": 11, "form": "dlg", "jp": "「とりあえず、\n　目撃証言がとんでもなくってだな‥‥」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「とんでもないって？」"},
{"id": 180, "speaker": 11, "form": "dlg", "jp": "「『目の前で突然被害者が消えた』って言うんだよ‥‥」"},
{"id": 181, "speaker": 11, "form": "dlg", "jp": "「信じられないだろう‥‥？」"},
{"id": 182, "speaker": 11, "form": "dlg", "jp": "「そんな話‥‥」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「ちょっと詳しく聞かせてくださいよ！」"},
{"id": 184, "speaker": 11, "form": "dlg", "jp": "「キミに聞かせてもなぁ‥‥」"},
{"id": 185, "speaker": 11, "form": "choice", "jp": "「お力になれるかも知れませんよ！」"},
{"id": 186, "speaker": 11, "form": "choice", "jp": "「ボクと警部さんの仲じゃないですかぁ～」"},
{"id": 187, "speaker": 11, "form": "choice", "jp": "「お願い、チュッ！」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「お力になれるかも知れませんよ！」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「ボクと警部さんの仲じゃないですかぁ～」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "「お願い、チュッ！」"},
{"id": 191, "speaker": 11, "form": "dlg", "jp": "「ハァ？」"},
{"id": 192, "speaker": 11, "form": "dlg", "jp": "「なんだそれは？」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「今、大人気のマンガ\n　『お願い、チュッ！』を知らないんですか？」"},
{"id": 194, "speaker": 11, "form": "dlg", "jp": "「いや、そうじゃなくて‥‥」"},
{"id": 195, "speaker": 11, "form": "dlg", "jp": "「そのマンガがどうしたんだってコト‥‥」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「そのマンガを貸してあげるから、\n　詳しい話を聞かせてくださいよ～」"},
{"id": 197, "speaker": 11, "form": "dlg", "jp": "「しかたないなぁ～～」"},
{"id": 198, "speaker": 11, "form": "dlg", "jp": "「詳しいも、何も、\n　ちっとも意味のわからない証言なんだけどな‥‥」"},
{"id": 199, "speaker": 11, "form": "dlg", "jp": "「目撃者が言うには目の前でいきなり\n　斬り付けられたそうなんだ‥‥」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "「斬り付けられた！？」"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "「ってことは、斬り付けた相手も見たんでしょ？」"},
{"id": 202, "speaker": 11, "form": "dlg", "jp": "「それが見てないらしいんだよ‥‥」"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "「顔を隠してたんですか？」"},
{"id": 204, "speaker": 11, "form": "dlg", "jp": "「いや、顔どころか、姿もだよ！！」"},
{"id": 205, "speaker": 11, "form": "dlg", "jp": "「目撃者がいうには目の前で\n　女の人の体に切り傷ができて」"},
{"id": 206, "speaker": 11, "form": "dlg", "jp": "「そこから血が吹き出して、\n　悲鳴をあげて『姿を消した』って‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 208, "speaker": 2, "form": "dlg", "jp": "「それって、目撃者がウソをついてるんじゃあ？」"},
{"id": 209, "speaker": 11, "form": "dlg", "jp": "「と思うだろう？」"},
{"id": 210, "speaker": 11, "form": "dlg", "jp": "「でも、そんな証言をしているのは\n　１人だけじゃないんだ」"},
{"id": 211, "speaker": 11, "form": "dlg", "jp": "「それに‥‥」"},
{"id": 212, "speaker": 11, "form": "dlg", "jp": "「ちゃんと証言の現場に血痕は残ってるし‥‥」"},
{"id": 213, "speaker": 11, "form": "dlg", "jp": "「被害者が消えてから、数日後には\n　ちゃんと現場に『死体』が現れるんだ‥‥」"},
{"id": 214, "speaker": 11, "form": "choice", "jp": "「まるで、『手品』ですね」"},
{"id": 215, "speaker": 11, "form": "choice", "jp": "「『宇宙人』の仕業じゃぁ？」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「まるで、『手品』ですね」"},
{"id": 217, "speaker": 11, "form": "dlg", "jp": "「そう思うだろう？」"},
{"id": 218, "speaker": 11, "form": "dlg", "jp": "「だから、『手品師』を調べさせているんだけど‥‥」"},
{"id": 219, "speaker": 11, "form": "dlg", "jp": "「なかなか手がかりが‥‥」"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「『宇宙人』の仕業じゃぁ？」"},
{"id": 221, "speaker": 11, "form": "dlg", "jp": "「そう思うだろう？」"},
{"id": 222, "speaker": 11, "form": "dlg", "jp": "「だから、ケイト警視にインターポールから、\n　『ＦＢＩ』を紹介してもらって、」"},
{"id": 223, "speaker": 11, "form": "dlg", "jp": "「さらに『ＦＢＩ』から\n　『マジェスティックトゥエルブ』を紹介してくれって」"},
{"id": 224, "speaker": 11, "form": "dlg", "jp": "「頼んだんだけど、\n　『そんな機関はナイ！』って怒られちゃったよ！！」"},
{"id": 225, "speaker": 11, "form": "dlg", "jp": "「せめて、モルダー捜査官だけでも、\n　紹介してくれたら‥‥」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「そういえば、被害者は若い女性ばかりなんでしょう？」"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「その辺りに手がかりは？」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「同一人物の犯行だと思うのには\n　なんらかの共通項があるんでしょう？」"},
{"id": 229, "speaker": 11, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 230, "speaker": 11, "form": "dlg", "jp": "「実は、現場に戻される『死体』全部、\n　『身体中に切り傷がある』のと‥‥」"},
{"id": 231, "speaker": 11, "form": "dlg", "jp": "「"},
{"id": 232, "speaker": 11, "form": "dlg", "jp": "『目玉が切り取られている』"},
{"id": 233, "speaker": 11, "form": "dlg", "jp": "んだ‥‥」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「『目玉が切り取られている』！？」"},
{"id": 235, "speaker": 11, "form": "dlg", "jp": "「このことはまだ、\n　マスコミには公表していないんだが‥‥」"},
{"id": 236, "speaker": 11, "form": "dlg", "jp": "「今のところ、全員まだ『目』が\n　発見されていないんだ‥‥」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「いったい、なんのために‥‥」"},
{"id": 238, "speaker": 11, "form": "dlg", "jp": "「さあ、\n　案外『コレクション』してるんじゃあないかな‥‥」"},
{"id": 239, "speaker": 11, "form": "dlg", "jp": "「『戦利品』として‥‥」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「なんだか、キモチワルクなってきた‥‥」"},
{"id": 241, "speaker": 11, "form": "dlg", "jp": "「余計なことを聞きたがるからだよ！」"},
{"id": 242, "speaker": 11, "form": "dlg", "jp": "「あと、共通点は被害者はみんな、\n　美少女ばっかりってことだ‥‥」"},
{"id": 243, "speaker": 11, "form": "choice", "jp": "「なんか、『変質者』っぽいですね‥‥」"},
{"id": 244, "speaker": 11, "form": "choice", "jp": "「なんか外国の事件みたいですね‥‥」"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "「なんか、『変質者』っぽいですね‥‥」"},
{"id": 246, "speaker": 11, "form": "dlg", "jp": "「まあ、『変質者』の仕業に見せ掛けようと\n　しているだけかもしれないしな‥‥」"},
{"id": 247, "speaker": 11, "form": "dlg", "jp": "「この手の『猟奇事件』って、\n　よく小説やドラマの題材になるけど‥‥」"},
{"id": 248, "speaker": 11, "form": "dlg", "jp": "「実際は、\n　そうそう発生するもんじゃないんだよ」"},
{"id": 249, "speaker": 11, "form": "dlg", "jp": "「ただ、\n　インパクトが強いから記憶に残ってるだけで‥‥」"},
{"id": 250, "speaker": 11, "form": "dlg", "jp": "「さらに日本だけに絞って言えば‥‥」"},
{"id": 251, "speaker": 11, "form": "dlg", "jp": "「これだけの大量殺人ってのも\n　歴史上ほとんどないんだよ」"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "「じゃぁ、犯人は『外国人』？？」"},
{"id": 253, "speaker": 11, "form": "dlg", "jp": "「それは問題ある発言だな‥‥」"},
{"id": 254, "speaker": 11, "form": "dlg", "jp": "「『猟奇殺人』や『大量殺人』ってのが、\n　日本の『村社会』では起こりにくいってだけで」"},
{"id": 255, "speaker": 11, "form": "dlg", "jp": "「『日本人』がそうした犯罪を\n　起こさないってワケじゃないし、」"},
{"id": 256, "speaker": 11, "form": "dlg", "jp": "「『外国人』だからって、そうした犯罪を\n　起こすってワケじゃないんだよ！」"},
{"id": 257, "speaker": 11, "form": "dlg", "jp": "「オレが言いたいのは、単なる『猟奇殺人』だと\n　決めつけない方がいいってことだよ‥‥」"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "「なんか外国の事件みたいですね‥‥」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「もしかして、犯人は『外国人』？？」"},
{"id": 260, "speaker": 11, "form": "dlg", "jp": "「それは問題ある発言だな‥‥」"},
{"id": 261, "speaker": 11, "form": "dlg", "jp": "「『猟奇殺人』や『大量殺人』ってのが、\n　日本の『村社会』では起こりにくいってだけで」"},
{"id": 262, "speaker": 11, "form": "dlg", "jp": "「『日本人』がそうした犯罪を\n　起こさないってワケじゃないし、」"},
{"id": 263, "speaker": 11, "form": "dlg", "jp": "「『外国人』だからって、そうした犯罪を\n　起こすってワケじゃないんだよ！」"},
{"id": 264, "speaker": 11, "form": "dlg", "jp": "「この手の『猟奇事件』って、\n　よく小説やドラマの題材になるけど‥‥」"},
{"id": 265, "speaker": 11, "form": "dlg", "jp": "「実際は、そうそう発生するもんじゃないんだよ」"},
{"id": 266, "speaker": 11, "form": "dlg", "jp": "「ただ、インパクトが強いから記憶に残ってるだけで‥‥」"},
{"id": 267, "speaker": 11, "form": "dlg", "jp": "「海外でこの手の事件が多い様に思うかもしれないけど、\n　国の広さや、人口が違うから‥‥」"},
{"id": 268, "speaker": 11, "form": "dlg", "jp": "「単純に１０倍の人間がいたら、\n　１０倍のおかしな人間もいるってだけだよ！」"},
{"id": 269, "speaker": 11, "form": "dlg", "jp": "「それに、『変質者』の仕業に見せ掛けようと\n　している可能性もあるしな！」"},
{"id": 270, "speaker": 11, "form": "dlg", "jp": "「オレが言いたいのは、単なる『猟奇殺人』だと\n　決めつけない方がいいってことだよ‥‥」"},
{"id": 271, "speaker": 2, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 272, "speaker": 11, "form": "dlg", "jp": "「おっと、もうこんな時間だ！！」"},
{"id": 273, "speaker": 11, "form": "dlg", "jp": "「次をまわらないと‥‥」"},
{"id": 274, "speaker": 11, "form": "dlg", "jp": "「じゃあ、もう行くよ」"},
{"id": 275, "speaker": 11, "form": "dlg", "jp": "「お姉さんによろしくな！」"},
{"id": 276, "speaker": 11, "form": "dlg", "jp": "「ごちそうさま‥‥」"},
{"id": 277, "speaker": 11, "form": "dlg", "jp": "警部さんは忙しそうに出ていった。"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "（三田さんってのもアリかも‥‥）"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "（こないだも、いろいろ話していたし‥‥）"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "（三田さんのところに行ってみるか‥‥）"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "ボクは三田さんのところへ行ってみることにした。"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 284, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 285, "speaker": 26, "form": "dlg", "jp": "「ナゴムく～ん」"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "「三田さん！！」"},
{"id": 287, "speaker": 26, "form": "dlg", "jp": "「お出かけかい？」"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「丁度よかった、今、三田さんに\n　会いに行こうとしてたんですよ！」"},
{"id": 289, "speaker": 26, "form": "dlg", "jp": "「へっ？　ボクになんか用？」"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "「こないだの『通り魔』の話、\n　詳しく聞かせてもらおうと思って‥‥」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "ボクは家で、三田さんから情報を聞き出すことにした。"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "「それで、『通り魔』のことなんだけど‥‥」"},
{"id": 295, "speaker": 26, "form": "dlg", "jp": "「おいおい、『探偵ゴッコ』かい？」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「違うよ！」"},
{"id": 297, "speaker": 26, "form": "dlg", "jp": "「なんで、そんなこと知りたがるの？」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "「まあ、こないだから事件に\n　巻き込まれ続けてきたから不安なんだよ‥‥」"},
{"id": 299, "speaker": 26, "form": "dlg", "jp": "「そうだよね、ボクもリツコさんが\n　襲われるんじゃないかって心配してるんだよ‥‥」"},
{"id": 300, "speaker": 26, "form": "dlg", "jp": "「なんたって、『通り魔』は\n　『美人』や『美少女』ばかり襲うらしいから‥‥」"},
{"id": 301, "speaker": 2, "form": "dlg", "jp": "「『美人』や『美少女』ばかり！？」"},
{"id": 302, "speaker": 26, "form": "dlg", "jp": "「らしいよ‥‥」"},
{"id": 303, "speaker": 26, "form": "dlg", "jp": "「いったい何考えているんだか‥‥」"},
{"id": 304, "speaker": 26, "form": "choice", "jp": "「やっぱ、『変質者』の仕業かな？」"},
{"id": 305, "speaker": 26, "form": "choice", "jp": "「モテナイ男の仕業かな？」"},
{"id": 306, "speaker": 26, "form": "choice", "jp": "「それとも、『ホラーマニア』？」"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "「やっぱ、『変質者』の仕業かな？」"},
{"id": 308, "speaker": 26, "form": "dlg", "jp": "「まあ、まともな人間は\n　人殺しなんてしないよ‥‥」"},
{"id": 309, "speaker": 2, "form": "dlg", "jp": "「そうだよね‥‥」"},
{"id": 310, "speaker": 2, "form": "dlg", "jp": "「モテナイ男の仕業かな？」"},
{"id": 311, "speaker": 26, "form": "dlg", "jp": "「オイオイ！\n　ボクへのイヤミですか？」"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "「いや、そんなつもりは‥‥」"},
{"id": 313, "speaker": 26, "form": "dlg", "jp": "「まあ、モテないボクに言わせると‥‥」"},
{"id": 314, "speaker": 26, "form": "dlg", "jp": "「本当にモテない男は、\n　女の人を殺したりしないと思うんだけどなぁ‥‥」"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "「どうして‥‥」"},
{"id": 316, "speaker": 26, "form": "dlg", "jp": "「だって、女の人を殺しちゃうと、\n　世の中から女の人が減っちゃうだろう？」"},
{"id": 317, "speaker": 26, "form": "dlg", "jp": "「それでなくてもモテないのに\n　さらにターゲットを減らすようなことは‥‥」"},
{"id": 318, "speaker": 2, "form": "dlg", "jp": "「でも、フラれた腹いせとかの事件ってあるじゃん！」"},
{"id": 319, "speaker": 26, "form": "dlg", "jp": "「本当にモテないとフラれることもないよ！」"},
{"id": 320, "speaker": 26, "form": "dlg", "jp": "「フラれるってことはすでにつきあっているか、\n　告白しようとするからだろう？」"},
{"id": 321, "speaker": 26, "form": "dlg", "jp": "「本当にモテないと、つきあうどころか\n　告白する勇気すらもなくなるから‥‥」"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "「なんか、悲しい話だね‥‥」"},
{"id": 323, "speaker": 2, "form": "dlg", "jp": "「それとも、『ホラーマニア』？」"},
{"id": 324, "speaker": 26, "form": "dlg", "jp": "「なんか、安物の学者や\n　マスコミみたいなこと考えるんだね」"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "「だって‥‥」"},
{"id": 326, "speaker": 26, "form": "dlg", "jp": "「確かに、『殺人をしようとした時』に、\n　『映画』を手本にするのは十分ありうる事だけど」"},
{"id": 327, "speaker": 26, "form": "dlg", "jp": "「『映画』を見たからって、\n　『殺人をしよう！』と思うワケじゃないだろう？」"},
{"id": 328, "speaker": 26, "form": "dlg", "jp": "「おかしな事件が起きた時に\n　インチキな連中が原因を見つけようとして」"},
{"id": 329, "speaker": 26, "form": "dlg", "jp": "「目の前に『わかりやすいモノ』があったら、\n　それのせいにしているだけなんだよ」"},
{"id": 330, "speaker": 26, "form": "dlg", "jp": "「わかり易いだろう？　殺人犯の家に\n　『殺人シーンのある映画のビデオ』があったら‥‥」"},
{"id": 331, "speaker": 26, "form": "dlg", "jp": "「でも、人間って『映画』を見たぐらいじゃぁ\n　人殺しなんてできないんだよ！」"},
{"id": 332, "speaker": 26, "form": "dlg", "jp": "「『スプーン曲げのテレビ』を観て\n　自分もチャレンジするって連中は多いけど」"},
{"id": 333, "speaker": 26, "form": "dlg", "jp": "「『殺人シーンのある映画』を観て\n　人殺しをしたくなるなんてありえないんだよ！」"},
{"id": 334, "speaker": 26, "form": "dlg", "jp": "「『映画を観たら人殺しをしたくなった』\n　ってヤツがいたら‥‥」"},
{"id": 335, "speaker": 26, "form": "dlg", "jp": "「そういう考えを持つようになった原因を\n　調べないといけないんだけどねぇ」"},
{"id": 336, "speaker": 26, "form": "dlg", "jp": "「『ホラー』を好きなら\n　『殺人を犯す』っていうなら‥‥」"},
{"id": 337, "speaker": 26, "form": "dlg", "jp": "「『コガンさん』は日本一の『殺人鬼』だよ‥‥」"},
{"id": 338, "speaker": 2, "form": "dlg", "jp": "「誰なんですか？　『コガンさん』って‥‥」"},
{"id": 339, "speaker": 26, "form": "dlg", "jp": "「『ガンノスケさん』の弟だよ！」"},
{"id": 340, "speaker": 2, "form": "dlg", "jp": "「なんだかよくわかんないよ‥‥」"},
{"id": 341, "speaker": 26, "form": "dlg", "jp": "「‥‥まあ、\n　どのみち普通の精神の持ち主じゃないよね」"},
{"id": 342, "speaker": 2, "form": "dlg", "jp": "「そう言えば、\n　こないだ目撃証言がどうのって言ってたけど‥‥」"},
{"id": 343, "speaker": 26, "form": "dlg", "jp": "「ああ、\n　例の『目の前で被害者』が消えるってヤツね」"},
{"id": 344, "speaker": 26, "form": "dlg", "jp": "「まあ、ボクは警察じゃないから、\n　詳しいことまでは知らないけど‥‥」"},
{"id": 345, "speaker": 2, "form": "dlg", "jp": "「実は、さっき刑事さんから聞いた話なんだけど‥‥」"},
{"id": 346, "speaker": 26, "form": "dlg", "jp": "「なんだ、\n　本当に『探偵』みたいなことするんだね？」"},
{"id": 347, "speaker": 2, "form": "dlg", "jp": "「被害者だけじゃなく、\n　犯人の姿も見えないんだって‥‥」"},
{"id": 348, "speaker": 26, "form": "dlg", "jp": "「不思議な話だね‥‥」"},
{"id": 349, "speaker": 26, "form": "choice", "jp": "「そうでしょう？」"},
{"id": 350, "speaker": 26, "form": "choice", "jp": "「やっぱり、『透明人間』の仕業かな？」"},
{"id": 351, "speaker": 2, "form": "dlg", "jp": "「そうでしょう？」"},
{"id": 352, "speaker": 26, "form": "dlg", "jp": "「世の中、\n　不思議なことがまだまだあるってことだよね‥‥」"},
{"id": 353, "speaker": 2, "form": "dlg", "jp": "「やっぱり、『透明人間』の仕業かな？」"},
{"id": 354, "speaker": 26, "form": "dlg", "jp": "「ありえないね‥‥」"},
{"id": 355, "speaker": 26, "form": "dlg", "jp": "「『透明』っていっても\n　ガラズや水程度なら見えるだろうし‥‥」"},
{"id": 356, "speaker": 26, "form": "dlg", "jp": "「空気みたいに透明だったら、\n　光が通りぬけちゃうから‥‥」"},
{"id": 357, "speaker": 26, "form": "dlg", "jp": "「目の中で像が結びつかずに\n　自分も物が見えないだろうからね‥‥」"},
{"id": 358, "speaker": 26, "form": "choice", "jp": "「やっぱり、そうだよね‥‥」"},
{"id": 359, "speaker": 26, "form": "choice", "jp": "「だから、『目』を盗むのかな？」"},
{"id": 360, "speaker": 2, "form": "dlg", "jp": "「やっぱり、そうだよね‥‥」"},
{"id": 361, "speaker": 26, "form": "dlg", "jp": "「まあ‥‥」"},
{"id": 362, "speaker": 26, "form": "dlg", "jp": "「世の中、\n　不思議なことがまだまだあるってことだよね‥‥」"},
{"id": 363, "speaker": 2, "form": "dlg", "jp": "「だから、『目』を盗むのかな？」"},
{"id": 364, "speaker": 26, "form": "dlg", "jp": "「目を盗む？」"},
{"id": 365, "speaker": 2, "form": "dlg", "jp": "「刑事さんの話だと、\n　被害者は全員、『目』がとられてるんだって‥‥」"},
{"id": 366, "speaker": 2, "form": "dlg", "jp": "「きっと、『透明人間』は『透明じゃない目』が\n　欲しいんじゃないかな？」"},
{"id": 367, "speaker": 26, "form": "dlg", "jp": "「おかしいよ、その推理‥‥」"},
{"id": 368, "speaker": 26, "form": "dlg", "jp": "「目が見えないのに、\n　正確に『目』を奪うなんてできないだろう？」"},
{"id": 369, "speaker": 26, "form": "dlg", "jp": "「それに『透明じゃない目』を手に入れた時点で\n　目だけ透明人間じゃなくなっちゃうし‥‥」"},
{"id": 370, "speaker": 26, "form": "dlg", "jp": "「『グラスフィッシュ』っていう\n　『透明な魚』がいるんだけど‥‥」"},
{"id": 371, "speaker": 26, "form": "dlg", "jp": "「体が透明でも、\n　食べたものとかは見えてるからね‥‥」"},
{"id": 372, "speaker": 2, "form": "dlg", "jp": "「じゃあ、透明人間じゃないんだ‥‥」"},
{"id": 373, "speaker": 26, "form": "dlg", "jp": "「まあ‥‥」"},
{"id": 374, "speaker": 26, "form": "dlg", "jp": "「世の中、\n　不思議なことがまだまだあるってことだよね‥‥」"},
{"id": 375, "speaker": 26, "form": "dlg", "jp": "結局、三田さんからは\nたいした情報を聞き出すことはできなかった。"},
{"id": 376, "speaker": 2, "form": "dlg", "jp": "（さてと‥‥）"},
{"id": 377, "speaker": 2, "form": "dlg", "jp": "（案外『先生』ってのもありかも‥‥）"},
{"id": 378, "speaker": 2, "form": "dlg", "jp": "（よし、学校に行ってみよう！！）"},
{"id": 379, "speaker": 2, "form": "dlg", "jp": "ボクは、先生に会いに学校へ向かった。"},
{"id": 380, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 381, "speaker": 2, "form": "dlg", "jp": "（あっ、『先生』だ！）"},
{"id": 382, "speaker": 2, "form": "dlg", "jp": "「先生！\n　ちょっと聞きたいことがあるんですけど‥‥」"},
{"id": 383, "speaker": 17, "form": "dlg", "jp": "「ああ、心配するな、\n　それは大人になった証拠だ‥‥」"},
{"id": 384, "speaker": 2, "form": "dlg", "jp": "「ハァ？\n　まだ何も聞いてないですけど‥‥」"},
{"id": 385, "speaker": 17, "form": "dlg", "jp": "「なんだ、早く言ってくれ、\n　オレはもう帰るところなんだから‥‥」"},
{"id": 386, "speaker": 2, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 387, "speaker": 2, "form": "dlg", "jp": "「先生は『通り魔』について何か知りませんか？」"},
{"id": 388, "speaker": 17, "form": "dlg", "jp": "「難しいことを聞くな！」"},
{"id": 389, "speaker": 2, "form": "dlg", "jp": "「いや、別に難しいとかそんな問題じゃないと‥‥」"},
{"id": 390, "speaker": 17, "form": "dlg", "jp": "「そういう、新聞に書いてあるようなことは\n　全部『難しい』んだよ！！」"},
{"id": 391, "speaker": 2, "form": "dlg", "jp": "「先生、『教師』でしょう？」"},
{"id": 392, "speaker": 17, "form": "dlg", "jp": "「教師っていっても、『体育教師』だ！」"},
{"id": 393, "speaker": 17, "form": "dlg", "jp": "「新聞に載ってるようなことは\n　『社会の教師』に聞け！」"},
{"id": 394, "speaker": 17, "form": "choice", "jp": "（ダメだコリャ‥‥）"},
{"id": 395, "speaker": 17, "form": "choice", "jp": "（もうちょっと粘ってみよう！）"},
{"id": 396, "speaker": 2, "form": "dlg", "jp": "（もうちょっと粘ってみよう！）"},
{"id": 397, "speaker": 2, "form": "dlg", "jp": "「社会の先生は休みですよ！」"},
{"id": 398, "speaker": 17, "form": "dlg", "jp": "「オレをそこいらにいる\n　『立派な体育教師』と一緒にするんじゃない！」"},
{"id": 399, "speaker": 17, "form": "dlg", "jp": "「子供のころから、スポーツひとすじの人間だぞ」"},
{"id": 400, "speaker": 17, "form": "dlg", "jp": "「受験だって、スポーツ推薦だし、\n　企業にも入れないから教師をしているんだ！」"},
{"id": 401, "speaker": 17, "form": "dlg", "jp": "「そんなオレに難しいこと質問するな！\n　オレはオマエの友達じゃないんだぞ！」"},
{"id": 402, "speaker": 2, "form": "dlg", "jp": "「先生、ふざけないでくださいよ！！」"},
{"id": 403, "speaker": 2, "form": "dlg", "jp": "「もっと教師らしいことを言ってください！」"},
{"id": 404, "speaker": 17, "form": "dlg", "jp": "「すまんな、\n　教師らしいことを言わないとな‥‥」"},
{"id": 405, "speaker": 17, "form": "dlg", "jp": "「遠足は、おウチに帰るまでが遠足です‥‥」"},
{"id": 406, "speaker": 17, "form": "dlg", "jp": "「みんながキチンとすれば、１回で終わります‥‥」"},
{"id": 407, "speaker": 17, "form": "dlg", "jp": "「これでいいか？」"},
{"id": 408, "speaker": 2, "form": "dlg", "jp": "（ダメだコリャ‥‥）"},
{"id": 409, "speaker": 2, "form": "dlg", "jp": "「アリガトウゴザイマシタッ！」"},
{"id": 410, "speaker": 17, "form": "dlg", "jp": "「よし、よし、\n　これからは先生に難しいことは聞かないように！」"},
{"id": 411, "speaker": 17, "form": "dlg", "jp": "「今度、聞いたら『体罰』だぞ！」"},
{"id": 412, "speaker": 2, "form": "dlg", "jp": "「ハイッ、ワカリマシタ！」"},
{"id": 413, "speaker": 2, "form": "dlg", "jp": "「デハ、シツレイシマスッ！！」"},
{"id": 414, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 415, "speaker": 2, "form": "dlg", "jp": "（なんか、イヤになっちゃったな‥‥）"},
{"id": 416, "speaker": 2, "form": "dlg", "jp": "（帰ろう‥‥）"},
{"id": 417, "speaker": 2, "form": "dlg", "jp": "（さてと‥‥）"},
{"id": 418, "speaker": 2, "form": "dlg", "jp": "（しかし、気味の悪い事件だなぁ‥‥）"},
{"id": 419, "speaker": 2, "form": "choice", "jp": "（姉さんのことが心配になってきた‥‥）"},
{"id": 420, "speaker": 2, "form": "choice", "jp": "（いや、姉さんは大丈夫だろう‥‥）"},
{"id": 421, "speaker": 2, "form": "dlg", "jp": "（姉さんのことが心配になってきた‥‥）"},
{"id": 422, "speaker": 2, "form": "dlg", "jp": "（最近、事件にばかり巻き込まれているし‥‥）"},
{"id": 423, "speaker": 2, "form": "dlg", "jp": "（いや、姉さんは大丈夫だろう‥‥）"},
{"id": 424, "speaker": 2, "form": "dlg", "jp": "（いろいろ事件に巻き込まれたけど、\n　いつも間一髪で助かってるもんな‥‥）"},
{"id": 425, "speaker": 2, "form": "dlg", "jp": "（運がいいのか、悪いのか‥‥）"},
{"id": 426, "speaker": 2, "form": "dlg", "jp": "（それに、姉さんのことは、\n　『シロー』が空から見守ってくれてるし‥‥）"},
{"id": 427, "speaker": 2, "form": "dlg", "jp": "（しかし、同じ町に『通り魔』がいるかもしれないって\n　イヤな感じだよな）"},
{"id": 428, "speaker": 2, "form": "dlg", "jp": "（他のみんなは大丈夫なんだろうか？）"},
{"id": 429, "speaker": 2, "form": "choice", "jp": "（『堤さん』とか狙われそうだな‥‥）"},
{"id": 430, "speaker": 2, "form": "choice", "jp": "（案外、『アイコ』とかも‥‥）"},
{"id": 431, "speaker": 2, "form": "choice", "jp": "（いや『長尾』だって襲われるかも‥‥）"},
{"id": 432, "speaker": 2, "form": "dlg", "jp": "（『堤さん』とか狙われそうだな‥‥）"},
{"id": 433, "speaker": 2, "form": "dlg", "jp": "（典型的な『美少女』って感じだし‥‥）"},
{"id": 434, "speaker": 2, "form": "choice", "jp": "（『堤さん』が襲われたらイヤだな‥‥）"},
{"id": 435, "speaker": 2, "form": "choice", "jp": "（『アイコ』が殺されても悲しいけど‥‥）"},
{"id": 436, "speaker": 2, "form": "choice", "jp": "（『長尾』のことだって‥‥）"},
{"id": 437, "speaker": 2, "form": "dlg", "jp": "（『堤さん』が襲われたらイヤだな‥‥）"},
{"id": 438, "speaker": 2, "form": "dlg", "jp": "（『アイコ』が殺されても悲しいけど‥‥）"},
{"id": 439, "speaker": 2, "form": "dlg", "jp": "（イヤ、別に『アイコ』のことが\n　好きだとかそんなんじゃぁなくて‥‥）"},
{"id": 440, "speaker": 2, "form": "dlg", "jp": "（『アイコ』とは小さいころから一緒だったから‥‥）"},
{"id": 441, "speaker": 2, "form": "dlg", "jp": "（まあ、キョウダイみたいなもんだし‥‥）"},
{"id": 442, "speaker": 2, "form": "dlg", "jp": "（‥‥って、なんで言い訳してるんだ？）"},
{"id": 443, "speaker": 2, "form": "dlg", "jp": "（『長尾』のことだって‥‥）"},
{"id": 444, "speaker": 2, "form": "dlg", "jp": "（ちょっとウザイとこあるけど、\n　いないとさみしいんだろうなぁ‥‥）"},
{"id": 445, "speaker": 2, "form": "dlg", "jp": "（ああいうタイプのコって‥‥）"},
{"id": 446, "speaker": 2, "form": "dlg", "jp": "（案外、『アイコ』とかも‥‥）"},
{"id": 447, "speaker": 2, "form": "dlg", "jp": "（アイツ、結構目立つタイプだし‥‥）"},
{"id": 448, "speaker": 2, "form": "dlg", "jp": "（まあ、知らないヤツから見たら、\n　カワイイく見えると思うし‥‥）"},
{"id": 449, "speaker": 2, "form": "choice", "jp": "（『アイコ』が死んだら悲しいんだろうな‥‥）"},
{"id": 450, "speaker": 2, "form": "choice", "jp": "（『堤さん』が襲われたらイヤだな‥‥）"},
{"id": 451, "speaker": 2, "form": "choice", "jp": "（『長尾』のことだって‥‥）"},
{"id": 452, "speaker": 2, "form": "dlg", "jp": "（『アイコ』が死んだら悲しいんだろうな‥‥）"},
{"id": 453, "speaker": 2, "form": "dlg", "jp": "（きっと‥‥）"},
{"id": 454, "speaker": 2, "form": "dlg", "jp": "（いつもは口ゲンカばっかしてるけど、\n　キョウダイみたいなもんだからな‥‥）"},
{"id": 455, "speaker": 2, "form": "dlg", "jp": "（『堤さん』が襲われたらイヤだな‥‥）"},
{"id": 456, "speaker": 2, "form": "dlg", "jp": "（彼女、あんなにしっかりしているのに、\n　なぜだかほっておけないんだよな‥‥）"},
{"id": 457, "speaker": 2, "form": "dlg", "jp": "（いや『長尾』だって襲われるかも‥‥）"},
{"id": 458, "speaker": 2, "form": "dlg", "jp": "（確かにウルサイところはあるけど、\n　結構かわいいとこあるし‥‥）"},
{"id": 459, "speaker": 2, "form": "dlg", "jp": "（なんたって、『グラマー』だもんな‥‥）"},
{"id": 460, "speaker": 2, "form": "choice", "jp": "（『長尾』が襲われたらイヤだな‥‥）"},
{"id": 461, "speaker": 2, "form": "choice", "jp": "（『堤さん』が襲われたらイヤだな‥‥）"},
{"id": 462, "speaker": 2, "form": "choice", "jp": "（『アイコ』が殺されても悲しいけど‥‥）"},
{"id": 463, "speaker": 2, "form": "dlg", "jp": "（『長尾』が襲われたらイヤだな‥‥）"},
{"id": 464, "speaker": 2, "form": "dlg", "jp": "（ムチャクチャなコだけど、\n　なんかほおっておけないんだよな‥‥）"},
{"id": 465, "speaker": 2, "form": "dlg", "jp": "（アイツ‥‥）"},
{"id": 466, "speaker": 2, "form": "dlg", "jp": "（もちろん、誰が殺されてもイヤだけど‥‥）"},
{"id": 467, "speaker": 2, "form": "dlg", "jp": "（もう、ソイツが『超能力者』かどうかなんて\n　どうでもいいや！）"},
{"id": 468, "speaker": 2, "form": "dlg", "jp": "（早く『通り魔』を捕まえないと！）"},
{"id": 469, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 470, "speaker": 3, "form": "dlg", "jp": "「ただいまぁ‥‥」"},
{"id": 471, "speaker": 2, "form": "dlg", "jp": "「なんだ、もう帰ってきたの‥‥？」"},
{"id": 472, "speaker": 3, "form": "dlg", "jp": "「ナゴムのお昼用意しに戻って来たのよ！」"},
{"id": 473, "speaker": 3, "form": "dlg", "jp": "「もうっ、お皿片付けてないじゃないの！」"},
{"id": 474, "speaker": 3, "form": "choice", "jp": "「ゴメン‥‥」"},
{"id": 475, "speaker": 3, "form": "choice", "jp": "「そんな選択肢なかったし‥‥」"},
{"id": 476, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 477, "speaker": 2, "form": "dlg", "jp": "「そんな選択肢なかったし‥‥」"},
{"id": 478, "speaker": 3, "form": "dlg", "jp": "「何わけのわからないこと言ってるのよ！」"},
{"id": 479, "speaker": 3, "form": "dlg", "jp": "「２人しかいない家族なんだから、\n　ちゃんと家事も手伝ってくれないと‥‥」"},
{"id": 480, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 481, "speaker": 3, "form": "dlg", "jp": "「お昼、『サンドイッチ』買って来たから、\n　それでガマンしてね‥‥」"},
{"id": 482, "speaker": 3, "form": "dlg", "jp": "「私、またすぐに大学に戻るから‥‥」"},
{"id": 483, "speaker": 3, "form": "choice", "jp": "「ＯＫ！」"},
{"id": 484, "speaker": 3, "form": "choice", "jp": "「ええ～『サンドイッチ』～？」"},
{"id": 485, "speaker": 3, "form": "choice", "jp": "「なんで『サンドイッチ』っていうか知ってる？」"},
{"id": 486, "speaker": 2, "form": "dlg", "jp": "「ＯＫ！」"},
{"id": 487, "speaker": 2, "form": "dlg", "jp": "「ええ～『サンドイッチ』～？」"},
{"id": 488, "speaker": 3, "form": "dlg", "jp": "「グズグズ言わないの！！」"},
{"id": 489, "speaker": 2, "form": "dlg", "jp": "「なんで『サンドイッチ』っていうか知ってる？」"},
{"id": 490, "speaker": 3, "form": "dlg", "jp": "「『サンドウィッチ伯爵』が発明したんでしょ‥‥」"},
{"id": 491, "speaker": 2, "form": "dlg", "jp": "「なんだ、知ってるんだ‥‥」"},
{"id": 492, "speaker": 3, "form": "dlg", "jp": "「でも、そう言われているだけで\n　本当かどうかはわからないのよ？」"},
{"id": 493, "speaker": 2, "form": "dlg", "jp": "「そうなの？」"},
{"id": 494, "speaker": 3, "form": "dlg", "jp": "「だって、ただパンに物をはさんだだけで、\n　たいした発明じゃないから」"},
{"id": 495, "speaker": 3, "form": "dlg", "jp": "「ちゃんとした記録なんて、\n　残ってないでしょう‥‥？」"},
{"id": 496, "speaker": 2, "form": "dlg", "jp": "「そりゃ、そうだね‥‥」"},
{"id": 497, "speaker": 2, "form": "dlg", "jp": "「その程度で発明っていうなら、\n　『ネコマンマ』も大発明になっちゃうし‥‥」"},
{"id": 498, "speaker": 3, "form": "dlg", "jp": "「案外『ネコ』が発明したのかもね？」"},
{"id": 499, "speaker": 2, "form": "dlg", "jp": "「そんなこと言ったら、『トイレ』は\n　『御手洗（ミタライ）さん』が発明したことに‥‥」"},
{"id": 500, "speaker": 3, "form": "dlg", "jp": "「ふふふ、くだらないこと言ってないで‥‥」"},
{"id": 501, "speaker": 3, "form": "dlg", "jp": "「じゃぁ、大学に戻るから‥‥」"},
{"id": 502, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 503, "speaker": 3, "form": "dlg", "jp": "「食べ終わったらちゃんと片づけるのよ！」"},
{"id": 504, "speaker": 2, "form": "dlg", "jp": "「ハイハイ‥‥」"},
{"id": 505, "speaker": 2, "form": "dlg", "jp": "姉さんは忙しそうに大学へ戻っていった。"},
{"id": 506, "speaker": 2, "form": "dlg", "jp": "（さてと‥‥）"},
{"id": 507, "speaker": 2, "form": "dlg", "jp": "（昼飯も食べたことだし‥‥）"},
{"id": 508, "speaker": 2, "form": "choice", "jp": "（食器でも片付けるか‥‥）"},
{"id": 509, "speaker": 2, "form": "choice", "jp": "（いや、それはめんどうだ‥‥）"},
{"id": 510, "speaker": 2, "form": "dlg", "jp": "（食器でも片付けるか‥‥）"},
{"id": 511, "speaker": 2, "form": "dlg", "jp": "ボクは食器を片付けた。"},
{"id": 512, "speaker": 2, "form": "dlg", "jp": "（いや、それはめんどうだ‥‥）"},
{"id": 513, "speaker": 2, "form": "dlg", "jp": "（‥‥とりあえず、『サンドイッチ』のゴミだけでも\n　片付けておこう‥‥）"}
]
