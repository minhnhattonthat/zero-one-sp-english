[
{"id": 0, "speaker": null, "form": "dlg", "jp": "「シュン！」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "「おまたせ‥‥」"},
{"id": 2, "speaker": 29, "form": "dlg", "jp": "「彼が『ナゴム』よ‥‥」"},
{"id": 3, "speaker": 4, "form": "dlg", "jp": "「『ピリ・ライナニ』だ‥‥」"},
{"id": 4, "speaker": 45, "form": "dlg", "jp": "「よろしく‥‥」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "「『常光寺ナゴム』です‥‥」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「ピリさんが『別のテレポーター』なの？」"},
{"id": 7, "speaker": 29, "form": "dlg", "jp": "「そうよ！」"},
{"id": 8, "speaker": 35, "form": "dlg", "jp": "「どうでもいいけど、ここ空気薄くない？」"},
{"id": 9, "speaker": 29, "form": "dlg", "jp": "「薄いわよ‥‥」"},
{"id": 10, "speaker": 29, "form": "dlg", "jp": "「だって、"},
{"id": 11, "speaker": 29, "form": "dlg", "jp": "『空中都市』"},
{"id": 12, "speaker": 29, "form": "dlg", "jp": "だから‥‥」"},
{"id": 13, "speaker": 35, "form": "dlg", "jp": "「『空中都市』？」"},
{"id": 14, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「もしかして、『浮いてる』の？」"},
{"id": 16, "speaker": 31, "form": "dlg", "jp": "「そんなわけないだろう！！」"},
{"id": 17, "speaker": 31, "form": "dlg", "jp": "「遺跡だよ、遺跡‥‥」"},
{"id": 18, "speaker": 31, "form": "dlg", "jp": "「オマエ、"},
{"id": 19, "speaker": 31, "form": "dlg", "jp": "『マチュピチュ』"},
{"id": 20, "speaker": 31, "form": "dlg", "jp": "を知らないのか？」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "『マチュピチュ』"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "！！」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "『マチュピチュ』‥‥"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "アンデス山脈の標高２４００ｍにあるインカ文明の遺跡。"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "１６世紀にインカ人がスペイン人から逃れるために築いた\n要塞都市と言われている。"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "しかし、遺跡の古いものは２０００年前のものもあり、\n真実は未だ解明されていない。"},
{"id": 28, "speaker": 35, "form": "dlg", "jp": "「ねえ、こんな所に本当に本部なんてあるの？」"},
{"id": 29, "speaker": 35, "form": "dlg", "jp": "「ここ観光客いっぱいいるじゃん！」"},
{"id": 30, "speaker": 29, "form": "dlg", "jp": "「こんな目立つ場所にあるわけないでしょ！」"},
{"id": 31, "speaker": 35, "form": "dlg", "jp": "「ここにあるって言ったじゃないか！」"},
{"id": 32, "speaker": 29, "form": "dlg", "jp": "「あるのはこの"},
{"id": 33, "speaker": 29, "form": "dlg", "jp": "地下"},
{"id": 34, "speaker": 29, "form": "dlg", "jp": "よ！」"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "「地下！？」"},
{"id": 36, "speaker": 29, "form": "dlg", "jp": "「そうよ‥‥」"},
{"id": 37, "speaker": 29, "form": "dlg", "jp": "「ついてきて‥‥」"},
{"id": 38, "speaker": 29, "form": "dlg", "jp": "ジーンはボクたちを遺跡のウラへ案内した。"},
{"id": 39, "speaker": 29, "form": "dlg", "jp": "ボクたちはそこから地下へつながる\n『エレベーター』に乗り込んだ。"},
{"id": 40, "speaker": 15, "form": "dlg", "jp": "「なんでこんなところにエレベーターが？」"},
{"id": 41, "speaker": 31, "form": "dlg", "jp": "「あった方がベンリだろう？」"},
{"id": 42, "speaker": 15, "form": "dlg", "jp": "「そうじゃなくて‥‥」"},
{"id": 43, "speaker": 29, "form": "dlg", "jp": "「後からつけたのよ！」"},
{"id": 44, "speaker": 16, "form": "dlg", "jp": "「なんでこんなところにエレベーターが？」"},
{"id": 45, "speaker": 31, "form": "dlg", "jp": "「あった方がベンリだろう？」"},
{"id": 46, "speaker": 16, "form": "dlg", "jp": "「そうじゃなくて‥‥」"},
{"id": 47, "speaker": 29, "form": "dlg", "jp": "「後からつけたのよ！」"},
{"id": 48, "speaker": 18, "form": "dlg", "jp": "「なんでこんなところにエレベーターが？」"},
{"id": 49, "speaker": 31, "form": "dlg", "jp": "「あった方がベンリだろう？」"},
{"id": 50, "speaker": 18, "form": "dlg", "jp": "「そうじゃなくて‥‥」"},
{"id": 51, "speaker": 29, "form": "dlg", "jp": "「後からつけたのよ！」"},
{"id": 52, "speaker": 51, "form": "dlg", "jp": "「なんでこんなところにエレベーターが？」"},
{"id": 53, "speaker": 31, "form": "dlg", "jp": "「あった方がベンリだろう？」"},
{"id": 54, "speaker": 51, "form": "dlg", "jp": "「そうじゃなくて‥‥」"},
{"id": 55, "speaker": 29, "form": "dlg", "jp": "「後からつけたのよ！」"},
{"id": 56, "speaker": 51, "form": "dlg", "jp": "「『大坂城』のエレベーターみたいなもんか‥‥」"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "「さあ、ついたわよ！」"},
{"id": 58, "speaker": 29, "form": "dlg", "jp": "「ここが『Ｅ－ｇｒｏ』の本部よ‥‥」"},
{"id": 59, "speaker": 51, "form": "dlg", "jp": "「どうして、こんなトコに？」"},
{"id": 60, "speaker": 15, "form": "dlg", "jp": "「どうして、こんなところに？」"},
{"id": 61, "speaker": 16, "form": "dlg", "jp": "「どうして、こんなところに？」"},
{"id": 62, "speaker": 18, "form": "dlg", "jp": "「どうして、こんなところに？」"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "「私たちは本部をどうしても\n　ここに作らなきゃいけなかった理由があるのよ‥‥」"},
{"id": 64, "speaker": 29, "form": "dlg", "jp": "「というより、もともとここに『本部』があって」"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "「そこに『Ｅ－ｇｒｏ』が結成されたって感じなの」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「その理由って？」"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "「それは後で説明するわ‥‥」"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "「それより、まず"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "『リーダー』"},
{"id": 70, "speaker": 29, "form": "dlg", "jp": "に紹介しないとね‥‥」"},
{"id": 71, "speaker": 45, "form": "dlg", "jp": "「『リーダー』なら、\n　アメリカの暴走を止めに行ってるよ‥‥」"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "「そうなの‥‥」"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「ということよ‥‥」"},
{"id": 74, "speaker": 45, "form": "dlg", "jp": "「まあ、すぐに戻ってくるよ‥‥」"},
{"id": 75, "speaker": 29, "form": "dlg", "jp": "「そうね、その程度の用事なら‥‥」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「その程度って‥‥」"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "「私たちとは違うのよ‥‥」"},
{"id": 78, "speaker": 29, "form": "dlg", "jp": "「私たちよりずっとスマートに\n　解決するにきまってるでしょう？」"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "「とりあえず、『メインホール』に行きましょう！」"},
{"id": 80, "speaker": 29, "form": "dlg", "jp": "ジーンはそう言って歩き続けた。"},
{"id": 81, "speaker": 29, "form": "dlg", "jp": "「ここが『Ｅ－ｇｒｏ』の『指令室』‥‥」"},
{"id": 82, "speaker": 29, "form": "dlg", "jp": "「『メインホール』よ」"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "「遺跡の中にこんな近代的な設備があるなんて‥‥」"},
{"id": 84, "speaker": 29, "form": "dlg", "jp": "「近代的っていうより、『超近代的』ね‥‥」"},
{"id": 85, "speaker": 29, "form": "dlg", "jp": "「さっきも話したでしょう！」"},
{"id": 86, "speaker": 4, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』には識者や\n　富豪のスポンサーがついてるからね！」"},
{"id": 87, "speaker": 18, "form": "dlg", "jp": "「えっ！！」"},
{"id": 88, "speaker": 18, "form": "dlg", "jp": "「アナタは！？」"},
{"id": 89, "speaker": 16, "form": "dlg", "jp": "「えっ！！」"},
{"id": 90, "speaker": 16, "form": "dlg", "jp": "「なんで！？」"},
{"id": 91, "speaker": 15, "form": "dlg", "jp": "「あっ！！」"},
{"id": 92, "speaker": 15, "form": "dlg", "jp": "「キミは！！」"},
{"id": 93, "speaker": 51, "form": "dlg", "jp": "「あっ！！」"},
{"id": 94, "speaker": 51, "form": "dlg", "jp": "「アンタ！！」"},
{"id": 95, "speaker": 50, "form": "dlg", "jp": "「やっとキミたちも来たんだね？」"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "「出口っ！！」"},
{"id": 97, "speaker": 2, "form": "choice", "jp": "「なんで、こんな所に！？」"},
{"id": 98, "speaker": 2, "form": "choice", "jp": "「キミが『リーダー』！？」"},
{"id": 99, "speaker": 2, "form": "choice", "jp": "「『リーダー』って女の子じゃなかったの？」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "「なんで、こんな所に！？」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "「キミが『リーダー』！？」"},
{"id": 102, "speaker": 50, "form": "dlg", "jp": "「違うよ！」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「じゃあ、どうしてここに？」"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "「『リーダー』って女の子じゃなかったの？」"},
{"id": 105, "speaker": 50, "form": "dlg", "jp": "「よく知ってるね？」"},
{"id": 106, "speaker": 50, "form": "dlg", "jp": "「どうしてそれを？」"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「ええっ！！」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "「いや、なんとなくだよ‥‥」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「それより、なんでここにいるんだよ‥‥」"},
{"id": 110, "speaker": 50, "form": "dlg", "jp": "「ボクも超能力者だからだよ‥‥」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "「そんな！」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「日本には５人しか超能力者はいないって‥‥」"},
{"id": 113, "speaker": 31, "form": "dlg", "jp": "「オレたちが行った時には\n　日本にはいなかっただろう？」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「なんだよそれ‥‥」"},
{"id": 115, "speaker": 50, "form": "dlg", "jp": "「キミの活躍は聞いているよ！」"},
{"id": 116, "speaker": 50, "form": "dlg", "jp": "「スゴイじゃないか‥‥」"},
{"id": 117, "speaker": 50, "form": "dlg", "jp": "「さすがは『伝説のチャネラー』、\n　『常光寺タイラ』の息子だね‥‥」"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「母さんを知ってるの！？」"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "「ナゴムのお母さんは有名なのよ！」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「そう言えば‥‥」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「どうして、今まで出口のことを？」"},
{"id": 123, "speaker": 29, "form": "dlg", "jp": "「それは‥‥」"},
{"id": 124, "speaker": 31, "form": "dlg", "jp": "「オマエの精神力が弱いからだよ！」"},
{"id": 125, "speaker": 31, "form": "dlg", "jp": "「仲間に、知り合いがいると甘えるだろう！」"},
{"id": 126, "speaker": 31, "form": "dlg", "jp": "「全てオマエのためだ‥‥」"},
{"id": 127, "speaker": 50, "form": "dlg", "jp": "「じゃあ、ボクはこれで‥‥」"},
{"id": 128, "speaker": 50, "form": "dlg", "jp": "「つもる話はまた後で‥‥」"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "「おいっ！」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "出口はそのままメインルームから出ていった。"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "（あいかわらずクールなヤツだな‥‥）"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "「アイツ、どこへ行ったの？」"},
{"id": 133, "speaker": 31, "form": "dlg", "jp": "「多分、暴走した兵器を止めに出撃したんだろう？」"},
{"id": 134, "speaker": 31, "form": "dlg", "jp": "「心配するな‥‥」"},
{"id": 135, "speaker": 31, "form": "dlg", "jp": "「アイツはナゴムなんかより、\n　ずっと戦いなれてるから‥‥」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「そ、そう‥‥」"},
{"id": 137, "speaker": 51, "form": "dlg", "jp": "「常光寺のお母さんも超能力者やったん？」"},
{"id": 138, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃんのお母さんも超能力者だったの？」"},
{"id": 139, "speaker": 16, "form": "dlg", "jp": "「常光寺くんのお母さんも超能力者だったの？」"},
{"id": 140, "speaker": 18, "form": "dlg", "jp": "「常光寺くんのお母さんも超能力者だったの？」"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "「そうよ！」"},
{"id": 142, "speaker": 29, "form": "dlg", "jp": "「それもかなりエリートの‥‥」"},
{"id": 143, "speaker": 35, "form": "dlg", "jp": "「『伝説のチャネラー』って言ってたね？」"},
{"id": 144, "speaker": 35, "form": "dlg", "jp": "「『チャネラー』って何？」"},
{"id": 145, "speaker": 35, "form": "dlg", "jp": "「クイズ番組の回答者？」"},
{"id": 146, "speaker": 18, "form": "dlg", "jp": "「ネットの掲示板とかの住人のことだったっけ？」"},
{"id": 147, "speaker": 16, "form": "dlg", "jp": "「違うわよ！」"},
{"id": 148, "speaker": 16, "form": "dlg", "jp": "「他人の『思念』なんかの『波動』を\n　受信したりできる能力よ！」"},
{"id": 149, "speaker": 51, "form": "dlg", "jp": "「『チャネラー』ってよりによって\n　ウサンクサイ能力やな‥‥」"},
{"id": 150, "speaker": 15, "form": "dlg", "jp": "「『チャネラー』って『霊媒師』みたいなヤツよね？」"},
{"id": 151, "speaker": 31, "form": "dlg", "jp": "「わかりやすく言えば『イタコ』だな‥‥」"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "「中学生に『イタコ』も難しいわね‥‥」"},
{"id": 153, "speaker": 31, "form": "dlg", "jp": "「そうか、水郷地区と間違えるか‥‥」"},
{"id": 154, "speaker": 35, "form": "dlg", "jp": "「そっちの方が難しいよ‥‥」"},
{"id": 155, "speaker": 35, "form": "dlg", "jp": "「子供の頃、イタコのなんとか太郎って歌は\n　『霊媒師』の歌だと思ったもん」"},
{"id": 156, "speaker": 31, "form": "dlg", "jp": "「とにかく、その『霊媒師』みたいなもんだ！」"},
{"id": 157, "speaker": 29, "form": "dlg", "jp": "「タイラは他人の意識を自分に転送したり、\n　自分の意識を他人に転送できたりしたそうよ‥‥」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「ぜんぜん知らなかった‥‥」"},
{"id": 159, "speaker": 31, "form": "dlg", "jp": "「まあ、知る必要はないな‥‥」"},
{"id": 160, "speaker": 31, "form": "dlg", "jp": "「子供にとって重要なのは『良い親』か\n　そうでないかだけで十分だから‥‥」"},
{"id": 161, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 162, "speaker": 29, "form": "dlg", "jp": "「世界中には親の顔も知らない子供も\n　たくさんいるものね‥‥」"},
{"id": 163, "speaker": 31, "form": "dlg", "jp": "「とにかく、センチになってる場合はないんだ‥‥」"},
{"id": 164, "speaker": 31, "form": "dlg", "jp": "「もっと、ポジティブに！！」"},
{"id": 165, "speaker": 31, "form": "dlg", "jp": "「平和をラブな振動で！！」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "「言ってるイミがよくわかんないよ‥‥」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 168, "speaker": 4, "form": "dlg", "jp": "「ジーンたちが戻って来たのですね？」"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "「？？？」"},
{"id": 170, "speaker": 4, "form": "dlg", "jp": "「彼らですね、新しいメンバーというのは‥‥？」"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "「ハイ！」"},
{"id": 172, "speaker": 15, "form": "dlg", "jp": "「この子は？」"},
{"id": 173, "speaker": 4, "form": "dlg", "jp": "「『アリス・アティック』です‥‥」"},
{"id": 174, "speaker": 45, "form": "dlg", "jp": "「ワレワレのリーダーだ‥‥」"},
{"id": 175, "speaker": 15, "form": "dlg", "jp": "「『リーダー』！？」"},
{"id": 176, "speaker": 15, "form": "dlg", "jp": "「こんな小さなコが！？」"},
{"id": 177, "speaker": 46, "form": "dlg", "jp": "「アナタがアイコさんですね？」"},
{"id": 178, "speaker": 46, "form": "dlg", "jp": "「よろしく‥‥」"},
{"id": 179, "speaker": 15, "form": "dlg", "jp": "「ハァ‥‥」"},
{"id": 180, "speaker": 16, "form": "dlg", "jp": "「この子は？」"},
{"id": 181, "speaker": 4, "form": "dlg", "jp": "「『アリス・アティック』です‥‥」"},
