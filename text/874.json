{"id": 189, "speaker": 4, "form": "dlg", "jp": "「『アリス・アティック』です‥‥」"},
{"id": 190, "speaker": 45, "form": "dlg", "jp": "「ワレワレのリーダーだ‥‥」"},
{"id": 191, "speaker": 18, "form": "dlg", "jp": "「『リーダー』！？」"},
{"id": 192, "speaker": 18, "form": "dlg", "jp": "「こんな小さなコが！？」"},
