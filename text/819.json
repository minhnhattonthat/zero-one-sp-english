{"id": 16, "speaker": null, "form": "dlg", "jp": "文化部の何部？"},
{"id": 17, "speaker": null, "form": "choice", "jp": "【科学部】"},
{"id": 18, "speaker": null, "form": "choice", "jp": "【マンガ部】"},
{"id": 19, "speaker": null, "form": "dlg", "jp": "【科学部】"},
{"id": 20, "speaker": null, "form": "dlg", "jp": "科学部に入っています。"},
{"id": 21, "speaker": null, "form": "dlg", "jp": "【マンガ部】"},
{"id": 22, "speaker": null, "form": "dlg", "jp": "マンガ部に入っています。"},
{"id": 23, "speaker": null, "form": "dlg", "jp": "【入らない】"},
{"id": 24, "speaker": null, "form": "dlg", "jp": "クラブには入っていません。"},
{"id": 25, "speaker": null, "form": "dlg", "jp": "パートナーを選びます。"},
{"id": 26, "speaker": null, "form": "dlg", "jp": "運動部以外は次の３人が候補です。"},
{"id": 27, "speaker": null, "form": "choice", "jp": "【アイコ】"},
{"id": 28, "speaker": null, "form": "choice", "jp": "【アキラ】"},
{"id": 29, "speaker": null, "form": "choice", "jp": "【ナナセ】"},
{"id": 30, "speaker": null, "form": "dlg", "jp": "パートナーを選びます。"},
{"id": 31, "speaker": null, "form": "dlg", "jp": "運動部の場合は次の３人が候補です。"},
{"id": 32, "speaker": null, "form": "choice", "jp": "【アイコ】"},
{"id": 33, "speaker": null, "form": "choice", "jp": "【アキラ】"},
{"id": 34, "speaker": null, "form": "choice", "jp": "【トモ】"},
{"id": 35, "speaker": null, "form": "dlg", "jp": "アイコです。"},
{"id": 36, "speaker": null, "form": "dlg", "jp": "アキラです。"},
{"id": 37, "speaker": null, "form": "dlg", "jp": "トモです。"},
{"id": 38, "speaker": null, "form": "dlg", "jp": "ナナセです。"},
{"id": 39, "speaker": null, "form": "dlg", "jp": "ジーンを気にする？"},
{"id": 40, "speaker": null, "form": "choice", "jp": "【しない】"},
{"id": 41, "speaker": null, "form": "choice", "jp": "【する】"},
{"id": 42, "speaker": null, "form": "dlg", "jp": "【しない】"},
{"id": 43, "speaker": null, "form": "dlg", "jp": "【する】"},
{"id": 44, "speaker": null, "form": "dlg", "jp": "ではゲームスタート！"},
{"id": 45, "speaker": null, "form": "dlg", "jp": "２００５／０８／１３／ＡＭ０８：３０"},
{"id": 46, "speaker": null, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 47, "speaker": null, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 48, "speaker": 3, "form": "dlg", "jp": "「ナゴム、ちょっと出てくれる？」"},
{"id": 49, "speaker": 3, "form": "dlg", "jp": "その日は父さんのパーティーがあるということで\n姉さんは朝から準備に追われていた。"},
{"id": 50, "speaker": 3, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 51, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「モシモシ‥‥」"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "（その声はナゴムね‥‥）"},
{"id": 55, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "「ジーン！？」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "「どうして、電話番号を‥‥」"},
{"id": 58, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 59, "speaker": 29, "form": "dlg", "jp": "（調べたのよ！）"},
{"id": 60, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 61, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 62, "speaker": 29, "form": "dlg", "jp": "（そんなことより、ちょっと出て来れない？）"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 64, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "（じゃあ、外で待ってるわよ！）"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「ちょっと待ってよ！」"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 69, "speaker": 3, "form": "dlg", "jp": "「誰から？」"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "「ちょっとね‥‥」"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ちょっと出かけてくるよ！」"},
{"id": 72, "speaker": 3, "form": "dlg", "jp": "「朝ゴハンは？」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「いいよ！」"},
{"id": 74, "speaker": 3, "form": "dlg", "jp": "「ちゃんと出発までに戻ってくるのよ！」"},
{"id": 75, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 76, "speaker": 3, "form": "dlg", "jp": "「バタン！」"},
{"id": 77, "speaker": 3, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 78, "speaker": 3, "form": "dlg", "jp": "外にはジーンとケネスの２人が立っていた。"},
{"id": 79, "speaker": 31, "form": "dlg", "jp": "「オハヨウ！」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「オハヨウ‥‥」"},
{"id": 81, "speaker": 31, "form": "dlg", "jp": "「ちゃんと眠れたか？」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「眠れるわけないだろう！」"},
{"id": 83, "speaker": 29, "form": "dlg", "jp": "「もっと精神をきたえなさいよ！」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「なんでそんな風になるのさ‥‥」"},
{"id": 85, "speaker": 29, "form": "dlg", "jp": "「私たち『能力者』の一番の『力』は精神力よ‥‥」"},
{"id": 86, "speaker": 31, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 87, "speaker": 31, "form": "dlg", "jp": "「強いイメージができるモノが\n　もっとも強い『能力者』だからな‥‥」"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "「こんなところで重要な話もできないし」"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "「とりあえず、\n　私たちのホテルに来て‥‥」"},
{"id": 90, "speaker": 29, "form": "dlg", "jp": "ボクはジーンたちが宿泊しているホテルに\n行くことになった。"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「で、用は何なの？」"},
{"id": 93, "speaker": 29, "form": "dlg", "jp": "「用も何も、私たちの使命は２つだけよ‥‥」"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "「『クリエーターから人類を守る』こと、\n　そのために『仲間を集める』こと‥‥」"},
{"id": 95, "speaker": 31, "form": "dlg", "jp": "「で、今重要なのは‥‥」"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "「『仲間を集める』こと‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「だから‥‥」"},
{"id": 98, "speaker": 29, "form": "dlg", "jp": "「情報を集めて欲しいのよ‥‥」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「『情報』‥‥？」"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "「本部から１つ情報が送られて来たの‥‥」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "「どんな？」"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "「『日本』に\n　"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "『無意識の能力者』"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "がいるって‥‥」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「『無意識の能力者』！？」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「何それ！？」"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "「本人が自覚せずに"},
{"id": 108, "speaker": 29, "form": "dlg", "jp": "『能力が発動している者』"},
{"id": 109, "speaker": 29, "form": "dlg", "jp": "よ‥‥」"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「そんなことできるの？」"},
{"id": 111, "speaker": 29, "form": "dlg", "jp": "「ナゴムもこないだはほとんど無意識だったでしょう？」"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "「とにかく、"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "『能力のイメージ』"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "が\n　"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "本部でキャッチされた"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "みたいなの‥‥」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "『能力のイメージ』"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "？」"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "「『能力』を使うには『念じる』わけだから\n　『テレパシー』みたいなものが発生するの‥‥」"},
{"id": 121, "speaker": 29, "form": "dlg", "jp": "「今回、本部がキャッチしたのは、\n　『念じていないイメージ』‥‥」"},
{"id": 122, "speaker": 31, "form": "dlg", "jp": "「普通の人間で言うと\n　『寝言』みたいなもんだ‥‥」"},
{"id": 123, "speaker": 29, "form": "dlg", "jp": "「『日本』に\n　"},
{"id": 124, "speaker": 29, "form": "dlg", "jp": "『能力を悪用している能力者』"},
{"id": 125, "speaker": 29, "form": "dlg", "jp": "がいるって‥‥」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "『能力を悪用している能力者』"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "！？」"},
{"id": 129, "speaker": 29, "form": "dlg", "jp": "「詳しいことは本部でも\n　わかっていないみたい‥‥」"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "「とにかく、ただ"},
{"id": 131, "speaker": 29, "form": "dlg", "jp": "『邪悪なイメージ』"},
{"id": 132, "speaker": 29, "form": "dlg", "jp": "が\n　"},
{"id": 133, "speaker": 29, "form": "dlg", "jp": "本部でキャッチされた"},
{"id": 134, "speaker": 29, "form": "dlg", "jp": "みたいなの‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "『邪悪なイメージ』"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "？」"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "「『能力』を使うには『念じる』わけだから\n　『テレパシー』みたいなものが発生するの‥‥」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「で、それはどこで？」"},
{"id": 140, "speaker": 29, "form": "dlg", "jp": "「何度か感知されてるんだけど、\n　一番最近は"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "『この町』"},
{"id": 142, "speaker": 29, "form": "dlg", "jp": "よ‥‥」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「この町！？」"},
{"id": 144, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 145, "speaker": 31, "form": "dlg", "jp": "「夕べ１１時に、\n　２丁目の４番地辺りで確認されたらしい‥‥」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「２丁目の４番地！？」"},
{"id": 147, "speaker": 29, "form": "dlg", "jp": "「その前だと、\n　７月２１日の夜０時に１丁目の３３番地とか‥‥」"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「１丁目の３３番地！？」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「それ、ウチの学校だよ！」"},
{"id": 150, "speaker": 31, "form": "dlg", "jp": "「ナゴムの学校！？」"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「それに、その夜なら‥‥たしか‥‥」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「ボクは学校にいたよ！！」"},
{"id": 153, "speaker": 29, "form": "dlg", "jp": "「それは本当なの？」"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "「うん！！」"},
{"id": 155, "speaker": 31, "form": "dlg", "jp": "「なんで夜中に学校なんか？」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「友だちと『キモダメシ』を‥‥」"},
{"id": 157, "speaker": 31, "form": "dlg", "jp": "「小心モノのナゴムにピッタリの遊びだな‥‥」"},
{"id": 158, "speaker": 29, "form": "dlg", "jp": "「で、何か変わったことは？」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "「変わったことも何も、\n　あの夜はルードに襲われた夜だよ‥‥」"},
{"id": 160, "speaker": 29, "form": "dlg", "jp": "「他には？」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「それ以上に\n　変わったことなんてあるわけないだろう！」"},
{"id": 162, "speaker": 31, "form": "dlg", "jp": "「とにかく、この町のことだから、\n　ナゴムが一番動きやすいだろう」"},
{"id": 163, "speaker": 31, "form": "dlg", "jp": "「がんばって情報を集めてくれないか？」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「いいけど‥‥」"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "「じゃあ、もう帰っていいかな？」"},
{"id": 166, "speaker": 31, "form": "dlg", "jp": "「どうした、あわててるみたいだが？」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「うん、父さんが招待されているパーティーに\n　ボクも出席するんだよ‥‥」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「じゃあ、帰るねっ？」"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "「情報収集頼んだわよ！」"},
{"id": 170, "speaker": 29, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "情報収集か‥‥"}
]
