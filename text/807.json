[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０７／２４／ＰＭ０２：００"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 3, "speaker": null, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「ハイ、常光寺です‥‥」"},
{"id": 5, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 6, "speaker": 51, "form": "dlg", "jp": "（あっ、ウチ！）"},
{"id": 7, "speaker": 51, "form": "dlg", "jp": "」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「小田？」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "「昨日は家族の人にしかられなかったか？」"},
{"id": 10, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 11, "speaker": 51, "form": "dlg", "jp": "（お姉さんが電話くれてたみたい‥‥）"},
{"id": 12, "speaker": 51, "form": "dlg", "jp": "」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 14, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 15, "speaker": 51, "form": "dlg", "jp": "（で、出られるの？）"},
{"id": 16, "speaker": 51, "form": "dlg", "jp": "」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 18, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 19, "speaker": 51, "form": "dlg", "jp": "（じゃあ、１０分後にそっち行くから‥‥）"},
{"id": 20, "speaker": 51, "form": "dlg", "jp": "」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「ＯＫ！」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "２００５／０７／２４／ＰＭ０２：１０"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「はい‥‥」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 26, "speaker": 51, "form": "dlg", "jp": "「オッス！」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「早かったね‥‥」"},
{"id": 28, "speaker": 51, "form": "dlg", "jp": "「お姉さんは？」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「大学に行ったよ‥‥」"},
{"id": 30, "speaker": 51, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 31, "speaker": 51, "form": "dlg", "jp": "「お礼言おう思たのに‥‥」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "「いいよ、ボクから伝えておくよ‥‥」"},
{"id": 33, "speaker": 51, "form": "dlg", "jp": "「じゃあ、行こか？」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って、まずジーンたちと合流しよう」"},
{"id": 35, "speaker": 51, "form": "dlg", "jp": "「そ、そうやな‥‥」"},
{"id": 36, "speaker": 51, "form": "dlg", "jp": "２００５／０７／２４／ＰＭ０３：００"},
{"id": 37, "speaker": 51, "form": "dlg", "jp": "しばらくしてジーンたちがやってきた。"},
{"id": 38, "speaker": 29, "form": "dlg", "jp": "「お待たせ‥‥」"},
{"id": 39, "speaker": 31, "form": "dlg", "jp": "「で、その倉庫ってのはどこなんだ？」"},
{"id": 40, "speaker": 51, "form": "dlg", "jp": "「すぐ近くやけど‥‥」"},
{"id": 41, "speaker": 29, "form": "dlg", "jp": "「じゃ、行きましょう！」"},
{"id": 42, "speaker": 29, "form": "dlg", "jp": "２００５／０７／２４／ＰＭ０１：４０"},
{"id": 43, "speaker": 29, "form": "dlg", "jp": "その日は昼間からジーンたちがやってきた。"},
{"id": 44, "speaker": 31, "form": "dlg", "jp": "（なんだって！？）"},
{"id": 45, "speaker": 31, "form": "dlg", "jp": "（『ゾンビ』に襲われた？）"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "（長尾が間違いなく、死んだ人だって‥‥）"},
{"id": 48, "speaker": 29, "form": "dlg", "jp": "（どうやら、『敵』は\n　『ナゴム』をターゲットにしてるみたいね‥‥）"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "（まさか‥‥！）"},
{"id": 50, "speaker": 31, "form": "dlg", "jp": "（そうだな‥‥）"},
{"id": 51, "speaker": 31, "form": "dlg", "jp": "（なんだか、\n　ナゴムばかり狙ってるようだな‥‥）"},
{"id": 52, "speaker": 29, "form": "dlg", "jp": "（まさか、人前で『能力』とか\n　使ったんじゃないでしょうね！？）"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "（使ってないよ！）"},
{"id": 54, "speaker": 31, "form": "dlg", "jp": "（じゃあ、なんでオレたちのことがバレたり、\n　ナゴムが狙われたりするんだ‥‥？）"},
{"id": 55, "speaker": 29, "form": "dlg", "jp": "（とにかく、なんかの『キッカケ』で\n　ナゴムが目をつけられたのは間違いなさそうね）"},
{"id": 56, "speaker": 31, "form": "dlg", "jp": "（その『キッカケ』がわかれば、\n　『死体を操ってるヤツ』がわかりそうだな‥‥）"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "（なんか『心当たり』はないの？）"},
{"id": 58, "speaker": 29, "form": "choice", "jp": "（もしかして、『長尾』が操ってるのかも！）"},
{"id": 59, "speaker": 29, "form": "choice", "jp": "（そういえば、『学校』があやしいかも！）"},
{"id": 60, "speaker": 29, "form": "choice", "jp": "（そういえば、あの『倉庫』の‥‥！）"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "（そういえば、『学校』があやしいかも！）"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "（襲われたのも『学校』だし‥‥）"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "（『学校』の何があやしいと思うの？）"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "（だから、誰か『学校関係者』だよ‥‥）"},
{"id": 65, "speaker": 31, "form": "dlg", "jp": "（『学校関係者』がどうして、\n　ナゴムだけを狙うんだ？）"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "（そこまではわかんないけど‥‥）"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "（たぶん、『逆』ね‥‥）"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "（『逆』‥‥？？）"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "（ナゴムがマークされたから、\n　『学校』が利用されたんじゃないかしら？）"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "（じゃあ‥‥）"},
{"id": 71, "speaker": 2, "form": "choice", "jp": "（ジーンたちのホテルの従業員とか‥‥）"},
{"id": 72, "speaker": 2, "form": "choice", "jp": "（お寺のお坊さんとか‥‥）"},
{"id": 73, "speaker": 2, "form": "choice", "jp": "（もしかして、『長尾』が操ってるのかも！）"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "（もしかして、『長尾』が操ってるのかも！）"},
{"id": 75, "speaker": 29, "form": "dlg", "jp": "（『長尾』って、さっき言ってた？）"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "（もともと、『生きてる死体』のことを\n　言い出したのも『長尾』だし‥‥）"},
{"id": 78, "speaker": 31, "form": "dlg", "jp": "（オイ、それはありえないんじゃないか？）"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "（なんでだよ！？）"},
{"id": 80, "speaker": 31, "form": "dlg", "jp": "（そのコも襲われたんだろう？）"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "（まあ、そうだけど‥‥）"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "（じゃあ‥‥）"},
{"id": 83, "speaker": 2, "form": "choice", "jp": "（ジーンたちのホテルの従業員とか‥‥）"},
{"id": 84, "speaker": 2, "form": "choice", "jp": "（お寺のお坊さんとか‥‥）"},
{"id": 85, "speaker": 2, "form": "choice", "jp": "（そういえば、あの『倉庫』の‥‥！）"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "（お寺のお坊さんとか‥‥）"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "（それなら、\n　お墓から簡単に『死体』とか手に入るだろうし‥‥）"},
{"id": 88, "speaker": 31, "form": "dlg", "jp": "（バカ、日本は『火葬』しちゃうんだろう？）"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "（もっとマジメに考えてよ！）"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "（じゃあ‥‥）"},
{"id": 91, "speaker": 2, "form": "choice", "jp": "（もしかして、『長尾』が操ってるのかも！）"},
{"id": 92, "speaker": 2, "form": "choice", "jp": "（そういえば、『学校』があやしいかも！）"},
{"id": 93, "speaker": 2, "form": "choice", "jp": "（そういえば、あの『倉庫』の‥‥！）"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "（ジーンたちのホテルの従業員とか‥‥）"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "（最初に襲って来た時は\n　ホテルの従業員のフリをしてたんだし‥‥）"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "（何言ってるのよ！）"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "（もしそうなら、ナゴムより私たちの方が\n　狙われるハズでしょう！？）"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "（まあ、そうだけど‥‥）"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "（じゃあ‥‥）"},
{"id": 100, "speaker": 2, "form": "choice", "jp": "（もしかして、『長尾』が操ってるのかも！）"},
{"id": 101, "speaker": 2, "form": "choice", "jp": "（そういえば、『学校』があやしいかも！）"},
{"id": 102, "speaker": 2, "form": "choice", "jp": "（そういえば、あの『倉庫』の‥‥！）"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "（そういえば、あの『倉庫』の‥‥）"},
{"id": 104, "speaker": 31, "form": "dlg", "jp": "（なんだよ、『倉庫』って‥‥？）"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "（長尾が初めて『生きてる死体』を見つけた時、\n　ソイツ、『倉庫』に入っていったらしいんだよ‥‥）"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "（で、別の日に長尾とその『倉庫』に行ったら‥‥）"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "（使ってない倉庫みたいなのに、\n　中から男の人が出てきたんだ‥‥）"},
{"id": 108, "speaker": 29, "form": "dlg", "jp": "（ソイツ、あやしいわね‥‥）"},
{"id": 109, "speaker": 31, "form": "dlg", "jp": "（マズイな‥‥）"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "（何が？）"},
{"id": 111, "speaker": 31, "form": "dlg", "jp": "（もし、ソイツが『ネクロマンサー』なら、\n　その『長尾』って子も狙われるかもしれないな‥‥）"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "（そうね‥‥）"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "（とにかく、その倉庫に行ってみましょう！）"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "その時！"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "「タン、タン、タン、タン、タン‥‥」"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 117, "speaker": 16, "form": "dlg", "jp": "「行っちゃダメ！！」"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「長尾！！」"},
{"id": 119, "speaker": 16, "form": "dlg", "jp": "「ゴメンなさい、呼び鈴鳴らしても\n　誰も出なかったから‥‥」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「鳴ったの気付かなかったよ‥‥」"},
{"id": 121, "speaker": 31, "form": "dlg", "jp": "「この子が、言ってた『長尾』って子か？」"},
{"id": 122, "speaker": 16, "form": "dlg", "jp": "「初めまして‥‥」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「で、行っちゃダメって？」"},
{"id": 124, "speaker": 16, "form": "dlg", "jp": "「『倉庫』に行くつもりなんでしょう？」"},
{"id": 125, "speaker": 29, "form": "dlg", "jp": "「なんで、そのこと知ってるの？」"},
{"id": 126, "speaker": 16, "form": "dlg", "jp": "「聞こえたのよ‥‥」"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「聞こえた？」"},
{"id": 128, "speaker": 16, "form": "dlg", "jp": "「うん、常光寺くんたちの会話が\n　頭の中で聞こえたの‥‥」"},
{"id": 129, "speaker": 31, "form": "dlg", "jp": "「それって、もしかして‥‥？」"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "「かも、しれないわね‥‥」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「ま、まさか、『長尾』が‥‥？」"},
{"id": 132, "speaker": 29, "form": "dlg", "jp": "（ねえ、今は聞こえてる？）"},
{"id": 133, "speaker": 16, "form": "dlg", "jp": "「聞こえるわよ？」"},
{"id": 134, "speaker": 31, "form": "dlg", "jp": "「どうやらそうみたいだな‥‥」"},
{"id": 135, "speaker": 31, "form": "dlg", "jp": "（じゃあ、\n　今度は声を出さずに返事してくれないか？）"},
{"id": 136, "speaker": 16, "form": "dlg", "jp": "（声を出さずに返事なんて‥‥）"},
{"id": 137, "speaker": 31, "form": "dlg", "jp": "（いや、それでいいんだ！！）"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "（じゃあ、長尾も‥‥？）"},
{"id": 139, "speaker": 29, "form": "dlg", "jp": "（『能力者』みたいね‥‥）"},
{"id": 140, "speaker": 16, "form": "dlg", "jp": "「ねえ、いったいみんな何話してるのよ！？」"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "「ごめんなさい‥‥」"},
{"id": 142, "speaker": 29, "form": "dlg", "jp": "「新しい仲間がこんなに簡単に見つかるとは\n　思ってもいなかったから‥‥」"},
{"id": 143, "speaker": 16, "form": "dlg", "jp": "「『仲間』？」"},
{"id": 144, "speaker": 31, "form": "dlg", "jp": "「キミは『超能力者』なんだよ‥‥」"},
{"id": 145, "speaker": 16, "form": "dlg", "jp": "「『超能力者』ぁ？」"},
{"id": 146, "speaker": 29, "form": "dlg", "jp": "「本当よ‥‥」"},
{"id": 147, "speaker": 29, "form": "dlg", "jp": "ジーンはボクの時と同じように、"},
{"id": 148, "speaker": 29, "form": "dlg", "jp": "『Ｅ－ｇｒｏ』や『ゲーマー』、\n『ノア』のことなんかを説明した。"},
{"id": 149, "speaker": 31, "form": "dlg", "jp": "「どうだ、仲間になってもらえないか？」"},
{"id": 150, "speaker": 16, "form": "dlg", "jp": "「喜んで！！」"},
{"id": 151, "speaker": 16, "form": "dlg", "jp": "「アキラ、そういうの憧れてたんだぁ～」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「そ、そう‥‥」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「よかったね‥‥」"},
{"id": 154, "speaker": 16, "form": "dlg", "jp": "「で、アキラのシモベは？」"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "「シモベ？」"},
{"id": 156, "speaker": 16, "form": "dlg", "jp": "「アキラの手足になって動いてくれる家来よ！」"},
{"id": 157, "speaker": 16, "form": "dlg", "jp": "「『黒ヒョウ』とか、『巨大な鳥』とか‥‥」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「そんなのいないよ！」"},
{"id": 159, "speaker": 31, "form": "dlg", "jp": "「もし、なんならナゴムを自由に使ってくれ！」"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "「何、かってなこと言ってるんだよ！」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「そんなことより、\n　なんで『倉庫』に行っちゃダメなんだよ？」"},
{"id": 162, "speaker": 16, "form": "dlg", "jp": "「『ゾンビ』よ、『ゾンビ』！！」"},
{"id": 163, "speaker": 31, "form": "dlg", "jp": "「『ゾンビ』がどうかしたのか？」"},
{"id": 164, "speaker": 16, "form": "dlg", "jp": "「常光寺くんが、倉庫でたくさんの"},
{"id": 165, "speaker": 16, "form": "dlg", "jp": "『ゾンビ』に\n　襲われる『夢』"},
{"id": 166, "speaker": 16, "form": "dlg", "jp": "を見たのよ！」"},
{"id": 167, "speaker": 31, "form": "dlg", "jp": "「なんだ、『夢』か‥‥」"},
{"id": 168, "speaker": 29, "form": "dlg", "jp": "「『夢』かじゃないでしょう！」"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "「なんで、この子が"},
{"id": 170, "speaker": 29, "form": "dlg", "jp": "私たちが\n　『倉庫』に行くこと"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "を知ってるのよ？」"},
{"id": 172, "speaker": 31, "form": "dlg", "jp": "「それは"},
{"id": 173, "speaker": 31, "form": "dlg", "jp": "『テレパシー』が聞こえた"},
{"id": 174, "speaker": 31, "form": "dlg", "jp": "からだろう？」"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "「じゃあ、なんで"},
{"id": 176, "speaker": 29, "form": "dlg", "jp": "『テレパシー』が通じた"},
{"id": 177, "speaker": 29, "form": "dlg", "jp": "のよ？」"},
{"id": 178, "speaker": 31, "form": "dlg", "jp": "「それは"},
{"id": 179, "speaker": 31, "form": "dlg", "jp": "『能力者』"},
{"id": 180, "speaker": 31, "form": "dlg", "jp": "だからだろう？」"},
{"id": 181, "speaker": 29, "form": "dlg", "jp": "「じゃあ、なんの『能力』があるというの？」"},
{"id": 182, "speaker": 31, "form": "dlg", "jp": "「それは‥‥」"},
{"id": 183, "speaker": 31, "form": "dlg", "jp": "「ホントだ！」"},
{"id": 184, "speaker": 31, "form": "dlg", "jp": "「キミはいったい何の能力が？」"},
{"id": 185, "speaker": 29, "form": "dlg", "jp": "「だから、それが"},
{"id": 186, "speaker": 29, "form": "dlg", "jp": "『予知夢』"},
{"id": 187, "speaker": 29, "form": "dlg", "jp": "じゃないの！」"},
{"id": 188, "speaker": 31, "form": "dlg", "jp": "「"},
{"id": 189, "speaker": 31, "form": "dlg", "jp": "『予知夢』"},
{"id": 190, "speaker": 31, "form": "dlg", "jp": "？」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 192, "speaker": 2, "form": "dlg", "jp": "『予知夢』"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "だって！？」"},
{"id": 194, "speaker": 29, "form": "dlg", "jp": "「そうなんでしょう？」"},
{"id": 195, "speaker": 16, "form": "dlg", "jp": "「よくわかんないわ‥‥」"},
{"id": 196, "speaker": 29, "form": "dlg", "jp": "「『夢』が現実になっておどろいたりすることない？」"},
{"id": 197, "speaker": 16, "form": "dlg", "jp": "「それはよくある！」"},
{"id": 198, "speaker": 16, "form": "dlg", "jp": "「だってアキラ、アナタたちのことも知ってるし‥‥」"},
{"id": 199, "speaker": 16, "form": "dlg", "jp": "「『ジーン』と『ケネス』でしょう？」"},
{"id": 200, "speaker": 31, "form": "dlg", "jp": "「そういえば、自己紹介したっけ‥‥」"},
{"id": 201, "speaker": 29, "form": "dlg", "jp": "「してないわよ！」"},
{"id": 202, "speaker": 31, "form": "dlg", "jp": "「じゃあ、やっぱり‥‥」"},
{"id": 203, "speaker": 16, "form": "dlg", "jp": "「ウソっ！」"},
{"id": 204, "speaker": 16, "form": "dlg", "jp": "「じゃあ、アキラは『予言者』なの？」"},
{"id": 205, "speaker": 29, "form": "dlg", "jp": "「『予言者』とは言えないかもしれないけど‥‥」"},
{"id": 206, "speaker": 29, "form": "dlg", "jp": "「『未来』が見えるのは間違いなさそうね！」"},
{"id": 207, "speaker": 16, "form": "dlg", "jp": "「じゃあ、『競馬』とかやったら\n　大金持ちになれるわね！」"},
{"id": 208, "speaker": 29, "form": "dlg", "jp": "「それはどうかしら？」"},
{"id": 209, "speaker": 29, "form": "dlg", "jp": "「そのためにはまず、『競馬』の\n　『夢』を見ないといけないんじゃない？」"},
{"id": 210, "speaker": 16, "form": "dlg", "jp": "「自由に『夢』なんて選べないわよ！」"},
{"id": 211, "speaker": 29, "form": "dlg", "jp": "「じゃあ、ダメね‥‥」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "「それに、\n　日本じゃ学生は馬券を買えないし‥‥」"},
{"id": 213, "speaker": 16, "form": "dlg", "jp": "「なんか、つまんない『能力』ね‥‥」"},
{"id": 214, "speaker": 16, "form": "dlg", "jp": "「アキラ、\n　もっとハデな能力の方がよかったわ‥‥」"},
{"id": 215, "speaker": 29, "form": "dlg", "jp": "「そんなことより、\n　この子の『能力』が本当だとしたら‥‥」"},
{"id": 216, "speaker": 29, "form": "dlg", "jp": "「その『倉庫』に行けば、とりあえず\n　『ゾンビ』たちには会えるって言うことよね‥‥」"},
{"id": 217, "speaker": 31, "form": "dlg", "jp": "「そういうことになるな！！」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「ちょっと待ってよ！」"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "『倉庫』に行ったら襲われる"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "んだろう？」"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "「そんなのヤだよ‥‥」"},
{"id": 223, "speaker": 29, "form": "dlg", "jp": "「カン違いしないで‥‥」"},
{"id": 224, "speaker": 29, "form": "dlg", "jp": "「この子の能力は『未来を見る』能力よ！」"},
{"id": 225, "speaker": 29, "form": "dlg", "jp": "「『倉庫に行ったら襲われる』じゃなくて、\n　『倉庫に行って襲われる』ってことよ‥‥」"},
{"id": 226, "speaker": 29, "form": "dlg", "jp": "「つまり、ナゴムは必ず『倉庫』に行って\n　たくさんのゾンビに『襲われる』運命なの‥‥」"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「そんなぁ～～～」"},
{"id": 228, "speaker": 29, "form": "dlg", "jp": "「例え今、ナゴムがどんなにイヤがっても、\n　ナゴムの未来はもう決まってるの‥‥」"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ボクは絶対助からないの？」"},
{"id": 230, "speaker": 29, "form": "dlg", "jp": "「さあ、それはどうかしら？」"},
{"id": 231, "speaker": 29, "form": "dlg", "jp": "「アナタの『夢』では襲われたナゴムは\n　どうなったの？」"},
{"id": 232, "speaker": 16, "form": "dlg", "jp": "「さあ、\n　襲われたところで目が覚めちゃったから‥‥」"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "「ってことよ！」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「どういうことなんだよ！」"},
{"id": 235, "speaker": 29, "form": "dlg", "jp": "「襲われることは決まってるけど、\n　襲われてどうなるかはわからないってことよ！」"},
{"id": 236, "speaker": 31, "form": "dlg", "jp": "「ゴチャゴチャ言っていても仕方ないだろう」"},
{"id": 237, "speaker": 31, "form": "dlg", "jp": "「運命なんだから、さあ行こうぜ！」"},
{"id": 238, "speaker": 31, "form": "dlg", "jp": "こうしてボクたちは\nあの『倉庫』に行くことになった。"},
{"id": 239, "speaker": 31, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 240, "speaker": 31, "form": "dlg", "jp": "２００５／０７／２４／ＰＭ０４：５０"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "「ココだよ‥‥」"},
{"id": 242, "speaker": 31, "form": "dlg", "jp": "「この中にその"},
{"id": 243, "speaker": 31, "form": "dlg", "jp": "『あやしいオヤジ』"},
{"id": 244, "speaker": 31, "form": "dlg", "jp": "がいるんだな？」"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "「今日もいるとはかぎらないけど‥‥」"},
{"id": 246, "speaker": 31, "form": "dlg", "jp": "「入ってみるか？」"},
{"id": 247, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 248, "speaker": 29, "form": "dlg", "jp": "「本当にソイツが犯人なら、\n　こっちの『テレパシー』を聞かれるかも‥‥」"},
{"id": 249, "speaker": 31, "form": "dlg", "jp": "「聞かれたってかまわないよ！」"},
{"id": 250, "speaker": 31, "form": "dlg", "jp": "「どうせこっちにはなんの『策』もないんだし‥‥」"},
{"id": 251, "speaker": 29, "form": "dlg", "jp": "「ちょっと落ち着きなさい！」"},
{"id": 252, "speaker": 31, "form": "dlg", "jp": "「なんだよ？」"},
{"id": 253, "speaker": 29, "form": "dlg", "jp": "「私たちは別に戦いに来たわけじゃないのよ！」"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "「『ノア』さえ取りもどせたらそれで‥‥」"},
{"id": 255, "speaker": 31, "form": "dlg", "jp": "「わかってるよ！！」"},
{"id": 256, "speaker": 29, "form": "dlg", "jp": "「ナゴムたちもよ‥‥」"},
{"id": 257, "speaker": 51, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "「ああ、わかった‥‥」"},
{"id": 259, "speaker": 29, "form": "dlg", "jp": "「じゃあ、入りましょうか？」"},
{"id": 260, "speaker": 29, "form": "dlg", "jp": "ボクたちは倉庫に入ることにした。"},
{"id": 261, "speaker": 29, "form": "dlg", "jp": "「あの‥‥」"},
{"id": 262, "speaker": 29, "form": "dlg", "jp": "「誰か‥‥？」"},
{"id": 263, "speaker": 4, "form": "dlg", "jp": "「いるよ！」"},
{"id": 264, "speaker": 4, "form": "dlg", "jp": "倉庫の奥からこの前の男が現れた。"},
{"id": 265, "speaker": 4, "form": "dlg", "jp": "「オマエが『ジーン』か？」"},
{"id": 266, "speaker": 29, "form": "dlg", "jp": "「‥‥‥！？」"},
{"id": 267, "speaker": 29, "form": "dlg", "jp": "男は平然と『ジーン』の名前を言い当てた。"},
{"id": 268, "speaker": 31, "form": "dlg", "jp": "「なんで名前を知ってるんだ？」"},
{"id": 269, "speaker": 4, "form": "dlg", "jp": "「オマエが『ケネス』だな‥‥」"},
{"id": 270, "speaker": 51, "form": "dlg", "jp": "「自己紹介の必要がないってことね‥‥」"},
{"id": 271, "speaker": 29, "form": "dlg", "jp": "「そんなことないわよ！」"},
{"id": 272, "speaker": 29, "form": "dlg", "jp": "「とりあえず、\n　アンタにも名乗ってもらわないとね‥‥」"},
{"id": 273, "speaker": 4, "form": "dlg", "jp": "「『秋山』だ‥‥」"},
{"id": 274, "speaker": 22, "form": "dlg", "jp": "「まんぞくしたか？」"},
{"id": 275, "speaker": 29, "form": "dlg", "jp": "「私たちが何しに来たかわかってるわよね？」"},
{"id": 276, "speaker": 22, "form": "dlg", "jp": "「わかってる‥‥」"},
{"id": 277, "speaker": 29, "form": "dlg", "jp": "「『ノア』を返してもらえるかしら？」"},
{"id": 278, "speaker": 22, "form": "dlg", "jp": "「ザンネンながら、\n　その犯人はオレじゃない‥‥」"},
{"id": 279, "speaker": 22, "form": "dlg", "jp": "「さっ、用はすんだだろう‥‥」"},
{"id": 280, "speaker": 29, "form": "dlg", "jp": "「まだよ！」"},
{"id": 281, "speaker": 22, "form": "dlg", "jp": "「まだなんか用があるのか？」"},
{"id": 282, "speaker": 29, "form": "dlg", "jp": "「アナタにも\n　『Ｅ－ｇｒｏ』のメンバーになってもらいたいの‥‥」"},
{"id": 283, "speaker": 29, "form": "dlg", "jp": "「アナタのような能力の持ち主を\n　放っておくことはできないし‥‥」"},
{"id": 284, "speaker": 31, "form": "dlg", "jp": "「仲間になってもらえないか？」"},
{"id": 285, "speaker": 22, "form": "dlg", "jp": "「オレの仲間になりたいのなら、\n　仲間にしてやってもいいぜ！」"},
{"id": 286, "speaker": 29, "form": "dlg", "jp": "「違うわよ！」"},
{"id": 287, "speaker": 29, "form": "dlg", "jp": "「アンタに私たちの仲間になってほしいのよ‥‥」"},
{"id": 288, "speaker": 22, "form": "dlg", "jp": "「断わるよ‥‥」"},
{"id": 289, "speaker": 22, "form": "dlg", "jp": "「この『能力』はオレのものだ‥‥」"},
{"id": 290, "speaker": 22, "form": "dlg", "jp": "「他人のために使うつもりはない‥‥」"},
{"id": 291, "speaker": 29, "form": "dlg", "jp": "「『ゲーマー』のことは知ってるんでしょう？」"},
{"id": 292, "speaker": 22, "form": "dlg", "jp": "「オマエたちのおかげでな‥‥」"},
{"id": 293, "speaker": 31, "form": "dlg", "jp": "「なら、わかるだろう？」"},
{"id": 294, "speaker": 31, "form": "dlg", "jp": "「オレたちが力をあわせてないと、\n　たくさんの人間が死ぬことになるんだぞ？」"},
{"id": 295, "speaker": 22, "form": "dlg", "jp": "「ハッハハハハハハ‥‥」"},
{"id": 296, "speaker": 22, "form": "dlg", "jp": "「"},
{"id": 297, "speaker": 22, "form": "dlg", "jp": "いっぱい死ぬ"},
{"id": 298, "speaker": 22, "form": "dlg", "jp": "ってことは、\n　オレの"},
{"id": 299, "speaker": 22, "form": "dlg", "jp": "手下がいっぱいできる"},
{"id": 300, "speaker": 22, "form": "dlg", "jp": "ってことだろう？」"},
{"id": 301, "speaker": 31, "form": "dlg", "jp": "「『能力』を悪用するつもりか？」"},
{"id": 302, "speaker": 22, "form": "dlg", "jp": "「他人からすれば『悪用』かもな‥‥」"},
{"id": 303, "speaker": 51, "form": "dlg", "jp": "「ケネス、あかんでコイツ‥‥」"},
{"id": 304, "speaker": 31, "form": "dlg", "jp": "「オレもそう思う‥‥」"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「ジーンは‥‥？」"},
{"id": 306, "speaker": 29, "form": "dlg", "jp": "「い、いったん引き上げた方がよさそうよ‥‥」"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "「ジーンまで？」"},
{"id": 308, "speaker": 29, "form": "dlg", "jp": "「私には見えるのよ‥‥\n　後ろに隠れてるヤツらが‥‥」"},
{"id": 309, "speaker": 2, "form": "dlg", "jp": "「なんだって！！」"},
{"id": 310, "speaker": 29, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 311, "speaker": 29, "form": "dlg", "jp": "「今日はこれで帰るから‥‥」"},
{"id": 312, "speaker": 29, "form": "dlg", "jp": "「また、気が変わったら連絡ちょうだい‥‥」"},
{"id": 313, "speaker": 22, "form": "dlg", "jp": "「なんだ、一方的なお嬢さんだな‥‥」"},
{"id": 314, "speaker": 22, "form": "dlg", "jp": "「そっちはあきらめたかも知れないけど‥‥」"},
{"id": 315, "speaker": 22, "form": "dlg", "jp": "「こっちはまだあきらめてないんだぜ？」"},
{"id": 316, "speaker": 22, "form": "dlg", "jp": "「仲間になってくれるんだろう？」"},
{"id": 317, "speaker": 51, "form": "dlg", "jp": "「ちょっと聞くけど‥‥」"},
{"id": 318, "speaker": 51, "form": "dlg", "jp": "「仲間になれっていうのは、もしかして‥‥」"},
{"id": 319, "speaker": 22, "form": "dlg", "jp": "「死ねってゆうことさ！」"},
{"id": 320, "speaker": 22, "form": "dlg", "jp": "‥‥‥‥‥‥‥！！"},
{"id": 321, "speaker": 22, "form": "dlg", "jp": "その秋山の声と同時に倉庫の物かげから\n大勢の人影が姿を現した。"},
{"id": 322, "speaker": 51, "form": "dlg", "jp": "「何これ？」"},
{"id": 323, "speaker": 51, "form": "dlg", "jp": "「これ全部『死人』なの？」"},
{"id": 324, "speaker": 29, "form": "dlg", "jp": "「そうみたいよ！」"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "「どうやって、こんなたくさんの死体を？」"},
{"id": 326, "speaker": 22, "form": "dlg", "jp": "「"},
{"id": 327, "speaker": 22, "form": "dlg", "jp": "『死体の元』"},
{"id": 328, "speaker": 22, "form": "dlg", "jp": "なんて、たくさんいるだろう？」"},
{"id": 329, "speaker": 31, "form": "dlg", "jp": "「コイツ、とんでもないヤロウだ！」"},
{"id": 330, "speaker": 22, "form": "dlg", "jp": "「さあ、オマエたち‥‥」"},
{"id": 331, "speaker": 22, "form": "dlg", "jp": "「その４人も"},
{"id": 332, "speaker": 22, "form": "dlg", "jp": "『仲間』"},
{"id": 333, "speaker": 22, "form": "dlg", "jp": "にしてやるんだ！」"},
{"id": 334, "speaker": 22, "form": "dlg", "jp": "死体たちは一斉にボクたちに\n襲いかかってきた。"},
{"id": 335, "speaker": 22, "form": "dlg", "jp": "もうダメか！！"},
{"id": 336, "speaker": 22, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 337, "speaker": 22, "form": "dlg", "jp": "しかし、なぜだか、死体たちは\nボクたちを取り囲むだけで、"},
{"id": 338, "speaker": 22, "form": "dlg", "jp": "ある一定距離以上近付いてこない。"},
{"id": 339, "speaker": 2, "form": "dlg", "jp": "「ど、どうしたんだ？」"},
{"id": 340, "speaker": 29, "form": "dlg", "jp": "「ケネスよ！」"},
{"id": 341, "speaker": 31, "form": "dlg", "jp": "「ウググググ‥‥‥」"},
{"id": 342, "speaker": 31, "form": "dlg", "jp": "「オレが止めてるんだよォ‥‥」"},
{"id": 343, "speaker": 31, "form": "dlg", "jp": "どうやら、ケネスが『サイコキネシス』で\n『ゾンビ』たちを押さえ付けてくれているようだ。"},
{"id": 344, "speaker": 31, "form": "dlg", "jp": "「ググググググググ‥‥‥」"},
{"id": 345, "speaker": 22, "form": "dlg", "jp": "「ほう、なかなかやるじゃないか‥‥」"},
{"id": 346, "speaker": 22, "form": "dlg", "jp": "「しかし、いつまでもつのかな？」"},
{"id": 347, "speaker": 31, "form": "dlg", "jp": "「早くなんとかしてくれ‥‥」"},
{"id": 348, "speaker": 31, "form": "dlg", "jp": "「グググググ‥‥」"},
{"id": 349, "speaker": 2, "form": "dlg", "jp": "「なんとかって言っても‥‥」"},
{"id": 350, "speaker": 2, "form": "dlg", "jp": "「コイツらにボクの攻撃は‥‥」"},
{"id": 351, "speaker": 29, "form": "dlg", "jp": "「その通りね‥‥」"},
{"id": 352, "speaker": 29, "form": "dlg", "jp": "「コイツらを攻撃してもキリがないわ！」"},
{"id": 353, "speaker": 29, "form": "dlg", "jp": "「攻撃するなら、\n　あの秋山ってヤツを気絶させないと‥‥」"},
{"id": 354, "speaker": 2, "form": "dlg", "jp": "「でも、どうやってアイツを攻撃するんだよ！」"},
{"id": 355, "speaker": 2, "form": "dlg", "jp": "「遠距離攻撃のできるケネスはこの状態だぜ？」"},
{"id": 356, "speaker": 29, "form": "dlg", "jp": "「ナゴム、アナタがやるのよ‥‥」"},
{"id": 357, "speaker": 2, "form": "dlg", "jp": "「ボクが？」"},
{"id": 358, "speaker": 2, "form": "dlg", "jp": "「でも、ボクの能力は遠距離攻撃の能力は‥‥」"},
{"id": 359, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 360, "speaker": 29, "form": "dlg", "jp": "突破"},
{"id": 361, "speaker": 29, "form": "dlg", "jp": "するのよっ！」"},
{"id": 362, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 363, "speaker": 2, "form": "dlg", "jp": "『突破』"},
{"id": 364, "speaker": 2, "form": "dlg", "jp": "！？」"},
{"id": 365, "speaker": 29, "form": "dlg", "jp": "「そうよ！」"},
{"id": 366, "speaker": 29, "form": "dlg", "jp": "「ナゴムの能力なら、\n　脚力をアップさせるぐらいできるでしょう？」"},
{"id": 367, "speaker": 29, "form": "dlg", "jp": "「コイツらを"},
{"id": 368, "speaker": 29, "form": "dlg", "jp": "ジャンプして"},
{"id": 369, "speaker": 29, "form": "dlg", "jp": "\n　飛び越えるのよ！！」"},
{"id": 370, "speaker": 2, "form": "dlg", "jp": "「そんなにうまくいくかなぁ？」"},
{"id": 371, "speaker": 29, "form": "dlg", "jp": "「うまく行かなきゃ全滅するだけよ！」"},
{"id": 372, "speaker": 31, "form": "dlg", "jp": "「なんでもいいから‥‥\n　早くしてくれ‥‥」"},
{"id": 373, "speaker": 31, "form": "dlg", "jp": "ええい、やるしかないのか‥‥"},
{"id": 374, "speaker": 2, "form": "dlg", "jp": "「わかった、やってみるよ！」"},
{"id": 375, "speaker": 2, "form": "dlg", "jp": "ボクは足の筋力をアップさせた。"},
{"id": 376, "speaker": 2, "form": "dlg", "jp": "失敗したら、４人とも死んじゃうことに‥‥"},
{"id": 377, "speaker": 2, "form": "dlg", "jp": "「うわっ！」"},
{"id": 378, "speaker": 22, "form": "dlg", "jp": "「何ふざけてるんだ？」"},
{"id": 379, "speaker": 31, "form": "dlg", "jp": "「も、もうダメだ‥‥」"},
{"id": 380, "speaker": 22, "form": "dlg", "jp": "「全員まとめて始末しろ！！」"},
{"id": 381, "speaker": 2, "form": "dlg", "jp": "「うわぁぁぁぁぁぁぁぁ～」"},
{"id": 382, "speaker": 2, "form": "dlg", "jp": "「とーーーっ！」"},
{"id": 383, "speaker": 2, "form": "dlg", "jp": "「バシッ！」"},
{"id": 384, "speaker": 22, "form": "dlg", "jp": "「うぐっ！」"},
{"id": 385, "speaker": 22, "form": "dlg", "jp": "や、やったのか‥‥"},
{"id": 386, "speaker": 22, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 387, "speaker": 22, "form": "dlg", "jp": "秋山が意識を失ったとたん、\n『死体』たちはその場に倒れふした。"},
{"id": 388, "speaker": 29, "form": "dlg", "jp": "「やったじゃない！！」"},
{"id": 389, "speaker": 51, "form": "dlg", "jp": "「スゴイやん、常光寺！！」"},
{"id": 390, "speaker": 31, "form": "dlg", "jp": "「オイ、少しはオレのこともホメてくれよな‥‥」"},
{"id": 391, "speaker": 51, "form": "dlg", "jp": "「ゴメン、ゴメン‥‥」"},
{"id": 392, "speaker": 51, "form": "dlg", "jp": "「ケネスも、スゴかったで～～！」"},
{"id": 393, "speaker": 2, "form": "dlg", "jp": "「そんなコトより、コイツどうするんだ？」"},
{"id": 394, "speaker": 2, "form": "dlg", "jp": "「気がついたらあぶないんじゃないか？」"},
{"id": 395, "speaker": 31, "form": "dlg", "jp": "「ああそうだな‥‥」"},
{"id": 396, "speaker": 31, "form": "dlg", "jp": "「コイツに関してはあきらめた方が‥‥」"},
{"id": 397, "speaker": 29, "form": "dlg", "jp": "「そ、そうね‥‥」"},
{"id": 398, "speaker": 2, "form": "dlg", "jp": "「あきらめるって、どうするのさ‥‥」"},
{"id": 399, "speaker": 29, "form": "dlg", "jp": "「これを使うのよ‥‥」"},
{"id": 400, "speaker": 51, "form": "dlg", "jp": "「まさか、殺してしまうん？」"},
{"id": 401, "speaker": 29, "form": "dlg", "jp": "「イヤな仕事よ‥‥」"},
{"id": 402, "speaker": 2, "form": "dlg", "jp": "「警察に引き渡せば‥‥」"},
{"id": 403, "speaker": 29, "form": "dlg", "jp": "「警察がコイツをどうにかできると思う？」"},
{"id": 404, "speaker": 29, "form": "dlg", "jp": "「私だって、人殺しなんかしたくないわよ‥‥」"},
{"id": 405, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 406, "speaker": 29, "form": "dlg", "jp": "「コイツを放っておいたら、\n　もっと大勢の人が死ぬことになるのよ！」"},
{"id": 407, "speaker": 2, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 408, "speaker": 22, "form": "dlg", "jp": "「もめるなら、オレが預かってやるぜ！」"},
{"id": 409, "speaker": 22, "form": "dlg", "jp": "「バシッ！」"},
{"id": 410, "speaker": 29, "form": "dlg", "jp": "「何っ！？」"},
{"id": 411, "speaker": 29, "form": "dlg", "jp": "秋山はジーンの持っていた拳銃をうばい取った。"},
{"id": 412, "speaker": 2, "form": "dlg", "jp": "「き、気がついたのか？」"},
{"id": 413, "speaker": 22, "form": "dlg", "jp": "「ハハハハハハ‥‥」"},
{"id": 414, "speaker": 22, "form": "dlg", "jp": "「アレぐらいで本当に気絶すると思ったのか？」"},
{"id": 415, "speaker": 22, "form": "dlg", "jp": "「じゃあ、死んでもらうよ！」"},
{"id": 416, "speaker": 22, "form": "dlg", "jp": "秋山はジーンに向かって引き金を引いた。"},
{"id": 417, "speaker": 22, "form": "dlg", "jp": "「カチッ！」"},
{"id": 418, "speaker": 22, "form": "dlg", "jp": "「バーーーン！」"},
{"id": 419, "speaker": 22, "form": "dlg", "jp": "銃声が倉庫中に響き渡った。"},
{"id": 420, "speaker": 22, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 421, "speaker": 22, "form": "dlg", "jp": "鈍い音をたてて、秋山が地面に倒れた‥‥"},
{"id": 422, "speaker": 51, "form": "dlg", "jp": "「どうしたの？」"},
{"id": 423, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 424, "speaker": 29, "form": "dlg", "jp": "『暴発』"},
{"id": 425, "speaker": 29, "form": "dlg", "jp": "よ‥‥」"},
{"id": 426, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 427, "speaker": 2, "form": "dlg", "jp": "『暴発』"},
{"id": 428, "speaker": 2, "form": "dlg", "jp": "？」"},
{"id": 429, "speaker": 29, "form": "dlg", "jp": "「コイツ改心するとは思わなかったから‥‥」"},
{"id": 430, "speaker": 29, "form": "dlg", "jp": "「『銃』に"},
{"id": 431, "speaker": 29, "form": "dlg", "jp": "細工"},
{"id": 432, "speaker": 29, "form": "dlg", "jp": "しておいたのよ！」"},
{"id": 433, "speaker": 51, "form": "dlg", "jp": "「で、コイツ死んでしもたん？」"},
{"id": 434, "speaker": 16, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 435, "speaker": 2, "form": "dlg", "jp": "「ああ、わかった‥‥」"},
{"id": 436, "speaker": 29, "form": "dlg", "jp": "「じゃあ、入りましょうか？」"},
{"id": 437, "speaker": 29, "form": "dlg", "jp": "ボクたちは倉庫に入ることにした。"},
{"id": 438, "speaker": 31, "form": "dlg", "jp": "「アキラ、ちょっといいか？」"},
{"id": 439, "speaker": 16, "form": "dlg", "jp": "「何？」"},
{"id": 440, "speaker": 31, "form": "dlg", "jp": "「ナゴムはいつゾンビたちに襲われるんだ？」"},
{"id": 441, "speaker": 16, "form": "dlg", "jp": "「えっ、今すぐよ‥‥」"},
{"id": 442, "speaker": 2, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 443, "speaker": 2, "form": "dlg", "jp": "その瞬間、モノ陰からたくさんの人影が姿を現し、\nボクたちを取り囲んだ‥‥"},
{"id": 444, "speaker": 2, "form": "dlg", "jp": "「これ全部『死人』なのか？」"},
{"id": 445, "speaker": 29, "form": "dlg", "jp": "「そうみたいよ！」"},
{"id": 446, "speaker": 4, "form": "dlg", "jp": "（やっぱり、来たのか‥‥）"},
{"id": 447, "speaker": 4, "form": "dlg", "jp": "何ものかが『テレパシー』で\nボクたちに語りかけて来た。"},
{"id": 448, "speaker": 2, "form": "dlg", "jp": "「ジーン、聞こえた？」"},
{"id": 449, "speaker": 29, "form": "dlg", "jp": "「聞こえたわ！」"},
{"id": 450, "speaker": 29, "form": "dlg", "jp": "「どうやら、\n　この中にこれを操っているヤツがいるみたいね‥‥」"},
{"id": 451, "speaker": 4, "form": "dlg", "jp": "（その通り！！）"},
{"id": 452, "speaker": 4, "form": "dlg", "jp": "（ヒャッヒャヒャヒャヒャ‥‥）"},
{"id": 453, "speaker": 29, "form": "dlg", "jp": "「私たちが来るのを知ってるってことは\n　なんで来たのか知ってるんでしょう？」"},
{"id": 454, "speaker": 4, "form": "dlg", "jp": "（知ってるよ‥‥）"},
{"id": 455, "speaker": 4, "form": "dlg", "jp": "（でも、\n　オレは『ノア』なんて盗んじゃいないよ‥‥）"},
{"id": 456, "speaker": 16, "form": "dlg", "jp": "「それって本当なの！？」"},
{"id": 457, "speaker": 4, "form": "dlg", "jp": "（テレパシーじゃあウソはつけないだろう？）"},
{"id": 458, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 459, "speaker": 29, "form": "dlg", "jp": "「どうやら、\n　『ノア』を盗んだのはアナタじゃなさそうね‥‥」"},
{"id": 460, "speaker": 29, "form": "dlg", "jp": "「でも、アナタのような能力の持ち主を\n　放っておくことはできないわ‥‥」"},
{"id": 461, "speaker": 29, "form": "dlg", "jp": "「今すぐ能力を悪用するのをやめて\n　『Ｅ－ｇｒｏ』のメンバーになりなさい」"},
{"id": 462, "speaker": 31, "form": "dlg", "jp": "「どうだ、\n　オレたちの仲間になってもらえないか？」"},
{"id": 463, "speaker": 31, "form": "dlg", "jp": "「これ以上、能力を悪用するっていうのなら、\n　コッチにも考えが‥‥」"},
{"id": 464, "speaker": 29, "form": "dlg", "jp": "「返事を聞かせてもらえる？」"},
{"id": 465, "speaker": 29, "form": "dlg", "jp": "「私たちの仲間になるの？\n　それともならないの？」"},
{"id": 466, "speaker": 4, "form": "dlg", "jp": "（オマエたちに『仲間』になってもらうのは\n　大賛成だよ‥‥）"},
{"id": 467, "speaker": 16, "form": "dlg", "jp": "「よかったわ、話の通じる人で‥‥」"},
{"id": 468, "speaker": 31, "form": "dlg", "jp": "「じゃあ、この『ゾンビ』たちを\n　とっぱらってくれるかな‥‥」"},
{"id": 469, "speaker": 4, "form": "dlg", "jp": "（何かカン違いしていないか？）"},
{"id": 470, "speaker": 4, "form": "dlg", "jp": "（オレはオマエたちに『仲間』になれって\n　言ってるんだぞ？）"},
{"id": 471, "speaker": 16, "form": "dlg", "jp": "「だったら仲良くしましょうよ！」"},
{"id": 472, "speaker": 4, "form": "dlg", "jp": "（"},
{"id": 473, "speaker": 4, "form": "dlg", "jp": "そのままじゃあダメ"},
{"id": 474, "speaker": 4, "form": "dlg", "jp": "だろう？）"},
{"id": 475, "speaker": 16, "form": "dlg", "jp": "「"},
{"id": 476, "speaker": 16, "form": "dlg", "jp": "『このままじゃダメ』"},
{"id": 477, "speaker": 16, "form": "dlg", "jp": "って？」"},
{"id": 478, "speaker": 4, "form": "dlg", "jp": "（コイツらの"},
{"id": 479, "speaker": 4, "form": "dlg", "jp": "『仲間』"},
{"id": 480, "speaker": 4, "form": "dlg", "jp": "になるには\n　"},
{"id": 481, "speaker": 4, "form": "dlg", "jp": "『死んで』"},
{"id": 482, "speaker": 4, "form": "dlg", "jp": "もらわなくちゃな！）"},
{"id": 483, "speaker": 2, "form": "dlg", "jp": "「なんだって！！」"},
{"id": 484, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 485, "speaker": 2, "form": "dlg", "jp": "しかし、なぜだか、死体たちは\nボクたちを取り囲むだけで、"},
{"id": 486, "speaker": 2, "form": "dlg", "jp": "ある一定距離以上近付いてこない。"},
{"id": 487, "speaker": 2, "form": "dlg", "jp": "「ど、どうしたんだ？」"},
{"id": 488, "speaker": 29, "form": "dlg", "jp": "「ケネスよ！」"},
{"id": 489, "speaker": 31, "form": "dlg", "jp": "「ウググググ‥‥‥」"},
{"id": 490, "speaker": 31, "form": "dlg", "jp": "「オレが止めてるんだよォ‥‥」"},
{"id": 491, "speaker": 31, "form": "dlg", "jp": "どうやら、ケネスが『サイコキネシス』で\n『ゾンビ』たちを押さえ付けてくれているようだ。"},
{"id": 492, "speaker": 31, "form": "dlg", "jp": "「ググググググググ‥‥‥」"},
{"id": 493, "speaker": 4, "form": "dlg", "jp": "（ほう、なかなかやるじゃないか‥‥）"},
{"id": 494, "speaker": 4, "form": "dlg", "jp": "（しかし、いつまでもつのかな？）"},
{"id": 495, "speaker": 31, "form": "dlg", "jp": "「早くなんとかしてくれ‥‥」"},
{"id": 496, "speaker": 31, "form": "dlg", "jp": "「グググググ‥‥」"},
{"id": 497, "speaker": 2, "form": "dlg", "jp": "「なんとかって言っても‥‥」"},
{"id": 498, "speaker": 2, "form": "dlg", "jp": "「コイツらにはボクの攻撃は効かないんだよ！」"},
{"id": 499, "speaker": 16, "form": "dlg", "jp": "「この中に操っているヤツが混ざってるんでしょう？」"},
{"id": 500, "speaker": 16, "form": "dlg", "jp": "「ソイツを気絶させちゃえば！！」"},
{"id": 501, "speaker": 29, "form": "dlg", "jp": "「そう言えば、アンタたち２人‥‥」"},
{"id": 502, "speaker": 29, "form": "dlg", "jp": "「前にここであやしいヤツを見たんじゃあ？」"},
{"id": 503, "speaker": 16, "form": "dlg", "jp": "「いないのよ、この中には‥‥」"},
{"id": 504, "speaker": 16, "form": "dlg", "jp": "「でしょう、常光寺くん」"},
{"id": 505, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 506, "speaker": 2, "form": "dlg", "jp": "たしかに、このゾンビたちの中には\nボクたちが見た男の人の姿はなかった。"},
{"id": 507, "speaker": 29, "form": "dlg", "jp": "「変装してるのね‥‥」"},
{"id": 508, "speaker": 4, "form": "dlg", "jp": "（ハハハハハハ‥‥）"},
{"id": 509, "speaker": 4, "form": "dlg", "jp": "（ザンネンだったな‥‥）"},
{"id": 510, "speaker": 31, "form": "dlg", "jp": "「は、早くなんとかしてくれ‥‥」"},
{"id": 511, "speaker": 2, "form": "dlg", "jp": "「なんとかって言っても‥‥」"},
{"id": 512, "speaker": 2, "form": "choice", "jp": "「ジーン！！」"},
{"id": 513, "speaker": 2, "form": "choice", "jp": "「ケネス！！」"},
{"id": 514, "speaker": 2, "form": "choice", "jp": "「長尾ぉ！！」"},
{"id": 515, "speaker": 2, "form": "dlg", "jp": "「長尾ぉ！！」"},
{"id": 516, "speaker": 16, "form": "dlg", "jp": "「えっ？　何？」"},
{"id": 517, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 518, "speaker": 2, "form": "choice", "jp": "「ジーン！！」"},
{"id": 519, "speaker": 2, "form": "choice", "jp": "「ケネス！！」"},
{"id": 520, "speaker": 2, "form": "dlg", "jp": "「ジーン！！」"},
{"id": 521, "speaker": 29, "form": "dlg", "jp": "「私にどうしろって言うのよ！」"},
{"id": 522, "speaker": 2, "form": "dlg", "jp": "「ゴメン！」"},
{"id": 523, "speaker": 2, "form": "choice", "jp": "「ジーン！！」"},
{"id": 524, "speaker": 2, "form": "choice", "jp": "「ケネス！！」"},
{"id": 525, "speaker": 2, "form": "choice", "jp": "「長尾ぉ！！」"},
{"id": 526, "speaker": 2, "form": "dlg", "jp": "「ジーン！！」"},
{"id": 527, "speaker": 29, "form": "dlg", "jp": "「だから、私の能力じゃぁ？」"},
{"id": 528, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 529, "speaker": 2, "form": "dlg", "jp": "『テレパシー』"},
{"id": 530, "speaker": 2, "form": "dlg", "jp": "の"},
{"id": 531, "speaker": 2, "form": "dlg", "jp": "『逆探知』"},
{"id": 532, "speaker": 2, "form": "dlg", "jp": "とかできないの？」"},
{"id": 533, "speaker": 29, "form": "dlg", "jp": "「そ、そうね！！」"},
{"id": 534, "speaker": 29, "form": "dlg", "jp": "「なんとかやってみる！！」"},
{"id": 535, "speaker": 31, "form": "dlg", "jp": "「早くしてくれよ！」"},
{"id": 536, "speaker": 31, "form": "dlg", "jp": "「オレもそろそろ限界が‥‥」"},
{"id": 537, "speaker": 29, "form": "dlg", "jp": "「もうちょっとがんばって‥‥」"},
{"id": 538, "speaker": 29, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥）"},
{"id": 539, "speaker": 29, "form": "dlg", "jp": "ジーンは『能力』を使って、\n『テレパシー』の逆探知を始めた。"},
{"id": 540, "speaker": 31, "form": "dlg", "jp": "「ま、まだか‥‥」"},
{"id": 541, "speaker": 29, "form": "dlg", "jp": "「わかったわ！」"},
{"id": 542, "speaker": 29, "form": "dlg", "jp": "「ナゴム、その正面のヤツをぶん殴って！！」"},
{"id": 543, "speaker": 29, "form": "choice", "jp": "「わかった、正直そうなヤツだね‥‥」"},
{"id": 544, "speaker": 29, "form": "choice", "jp": "「わかった、正面のヤツだね‥‥」"},
{"id": 545, "speaker": 29, "form": "choice", "jp": "「わかった、正面右のヤツだね‥‥」"},
{"id": 546, "speaker": 2, "form": "dlg", "jp": "「わかった、正面右のヤツだね‥‥」"},
{"id": 547, "speaker": 2, "form": "dlg", "jp": "ボクは腕の筋力をアップさせて、\n正面右のゾンビを思いっきりなぐりつけた。"},
{"id": 548, "speaker": 2, "form": "dlg", "jp": "「バシッ！」"},
{"id": 549, "speaker": 2, "form": "dlg", "jp": "「ヘっ？」"},
{"id": 550, "speaker": 2, "form": "dlg", "jp": "「わかった、正直そうなヤツだね‥‥」"},
{"id": 551, "speaker": 2, "form": "dlg", "jp": "ボクは腕の筋力をアップさせて、\n正直そうな左のゾンビを思いっきりなぐりつけた。"},
{"id": 552, "speaker": 2, "form": "dlg", "jp": "「バシッ！」"},
{"id": 553, "speaker": 2, "form": "dlg", "jp": "「ヘっ？」"},
{"id": 554, "speaker": 29, "form": "dlg", "jp": "「ソイツじゃないわよ！」"},
{"id": 555, "speaker": 2, "form": "dlg", "jp": "「わかった、正面のヤツだね‥‥」"},
{"id": 556, "speaker": 2, "form": "dlg", "jp": "ボクは腕の筋力をアップさせて、\n正面のゾンビを思いっきりなぐりつけた。"},
{"id": 557, "speaker": 2, "form": "dlg", "jp": "「バシッ！」"},
{"id": 558, "speaker": 4, "form": "dlg", "jp": "「ウガァッ！」"},
{"id": 559, "speaker": 4, "form": "dlg", "jp": "や、やったのか‥‥"},
{"id": 560, "speaker": 4, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 561, "speaker": 4, "form": "dlg", "jp": "『ゾンビ』たちはその場に倒れふした。"},
{"id": 562, "speaker": 29, "form": "dlg", "jp": "「やったじゃない！！」"},
{"id": 563, "speaker": 16, "form": "dlg", "jp": "「スゴイわよ、常光寺くん！！」"},
{"id": 564, "speaker": 31, "form": "dlg", "jp": "「オイ、少しはオレのこともホメてくれよな‥‥」"},
{"id": 565, "speaker": 16, "form": "dlg", "jp": "「もちろんよ、ケネスが一番カッコよかったわよ！」"},
{"id": 566, "speaker": 29, "form": "dlg", "jp": "「さあ、カンネンしなさい‥‥」"},
{"id": 567, "speaker": 4, "form": "dlg", "jp": "「くっくっ‥‥」"},
{"id": 568, "speaker": 4, "form": "dlg", "jp": "殴られた衝撃で変装がとけたソイツは\n間違いなく、あの時の男だった。"},
{"id": 569, "speaker": 29, "form": "dlg", "jp": "「さあ、どうするつもり？」"},
{"id": 570, "speaker": 4, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 571, "speaker": 4, "form": "dlg", "jp": "「私の負けだ‥‥」"},
{"id": 572, "speaker": 29, "form": "dlg", "jp": "「って、ことは仲間になるのね‥‥」"},
{"id": 573, "speaker": 4, "form": "dlg", "jp": "「この状態で断わるほどの根性はないよ‥‥」"},
{"id": 574, "speaker": 4, "form": "dlg", "jp": "「『秋山』だ‥‥」"},
{"id": 575, "speaker": 22, "form": "dlg", "jp": "「よろしく‥‥」"},
{"id": 576, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥」"},
{"id": 577, "speaker": 22, "form": "dlg", "jp": "「とにかく、銃を下ろしてくれよ‥‥」"},
{"id": 578, "speaker": 29, "form": "dlg", "jp": "「ダメよ‥‥」"},
{"id": 579, "speaker": 29, "form": "dlg", "jp": "「まだ、信用できないわ‥‥」"},
{"id": 580, "speaker": 16, "form": "dlg", "jp": "「ねえ、１つ質問してもいい？」"},
{"id": 581, "speaker": 16, "form": "dlg", "jp": "「日本って『火葬』しちゃう国でしょう？」"},
{"id": 582, "speaker": 16, "form": "dlg", "jp": "「どうやって、あんなにたくさん死体を集めたの？」"},
{"id": 583, "speaker": 22, "form": "dlg", "jp": "「『死体』の元なんて、どこにでもいるだろう？」"},
{"id": 584, "speaker": 16, "form": "dlg", "jp": "「何よ、死体の元って‥‥」"},
{"id": 585, "speaker": 29, "form": "dlg", "jp": "「『生きてる人間』よ‥‥」"},
{"id": 586, "speaker": 16, "form": "dlg", "jp": "「まさか、この人！！」"},
{"id": 587, "speaker": 22, "form": "dlg", "jp": "「そうだよ、オレが殺したのさ‥‥」"},
{"id": 588, "speaker": 16, "form": "dlg", "jp": "「アンタ、人殺しじゃない！！」"},
{"id": 589, "speaker": 22, "form": "dlg", "jp": "「そうだよ‥‥」"},
{"id": 590, "speaker": 22, "form": "dlg", "jp": "「しかし、オマエらはそんな人殺しのオレを\n　どうしても『仲間』にしたいんだよな‥‥」"},
{"id": 591, "speaker": 16, "form": "dlg", "jp": "「ダメよ、こんなヤツ警察に突き出さないと‥‥」"},
{"id": 592, "speaker": 31, "form": "dlg", "jp": "「ダメなんだよ‥‥」"},
{"id": 593, "speaker": 16, "form": "dlg", "jp": "「どうして‥‥」"},
{"id": 594, "speaker": 16, "form": "dlg", "jp": "「この人、こんなにたくさん殺したのよ！？」"},
{"id": 595, "speaker": 31, "form": "dlg", "jp": "「警察になんて説明するんだよ‥‥」"},
{"id": 596, "speaker": 16, "form": "dlg", "jp": "「ありのまま話せば‥‥」"},
{"id": 597, "speaker": 29, "form": "dlg", "jp": "「そんなことしたら、\n　『Ｅ－ｇｒｏ』のことがバレちゃうでしょう？」"},
{"id": 598, "speaker": 16, "form": "dlg", "jp": "「そんなぁ～！」"},
{"id": 599, "speaker": 16, "form": "dlg", "jp": "「常光寺くん、なんとか言ってよ！」"},
{"id": 600, "speaker": 16, "form": "choice", "jp": "「しかたないよ‥‥」"},
{"id": 601, "speaker": 16, "form": "choice", "jp": "「ボクも納得できない‥‥」"},
{"id": 602, "speaker": 16, "form": "choice", "jp": "「ゆるせないよ‥‥」"},
{"id": 603, "speaker": 2, "form": "dlg", "jp": "「ボクも納得できない‥‥」"},
{"id": 604, "speaker": 16, "form": "dlg", "jp": "「そうでしょう！！」"},
{"id": 605, "speaker": 2, "form": "dlg", "jp": "「でも、こうするしか‥‥」"},
{"id": 606, "speaker": 2, "form": "dlg", "jp": "「ゆるせないよ‥‥」"},
{"id": 607, "speaker": 16, "form": "dlg", "jp": "「そうでしょう！！」"},
{"id": 608, "speaker": 2, "form": "dlg", "jp": "「でも、こうするしか‥‥」"},
{"id": 609, "speaker": 2, "form": "dlg", "jp": "「しかたないよ‥‥」"},
{"id": 610, "speaker": 16, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 611, "speaker": 16, "form": "dlg", "jp": "「常光寺くんまで‥‥」"},
{"id": 612, "speaker": 16, "form": "dlg", "jp": "「イヤよ、\n　アキラはこんなヤツ仲間にするの！」"},
{"id": 613, "speaker": 22, "form": "dlg", "jp": "「ヒヒヒヒヒ‥‥」"},
{"id": 614, "speaker": 22, "form": "dlg", "jp": "「仲良くやろうよ‥‥」"},
{"id": 615, "speaker": 16, "form": "dlg", "jp": "「イヤぁぁぁぁぁぁぁぁぁ！」"},
{"id": 616, "speaker": 16, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 617, "speaker": 16, "form": "dlg", "jp": "長尾はその場からかけだした。"},
{"id": 618, "speaker": 31, "form": "dlg", "jp": "「オイ、待てッ！」"},
{"id": 619, "speaker": 29, "form": "dlg", "jp": "「勝手に動いちゃダメ！」"},
{"id": 620, "speaker": 16, "form": "dlg", "jp": "「キャッ！」"},
{"id": 621, "speaker": 22, "form": "dlg", "jp": "「ナイスキャッチ！！」"},
{"id": 622, "speaker": 22, "form": "dlg", "jp": "倉庫から立ち去ろうとする長尾を\n『ゾンビ』の１人がつかまえた。"},
{"id": 623, "speaker": 31, "form": "dlg", "jp": "「ありがとう、つかまえてくれて‥‥」"},
{"id": 624, "speaker": 22, "form": "dlg", "jp": "「ヒヒヒヒヒ‥‥」"},
{"id": 625, "speaker": 22, "form": "dlg", "jp": "「礼にはおよばないよ‥‥」"},
{"id": 626, "speaker": 22, "form": "dlg", "jp": "「オレは"},
{"id": 627, "speaker": 22, "form": "dlg", "jp": "人質"},
{"id": 628, "speaker": 22, "form": "dlg", "jp": "を確保しただけだからな‥‥」"},
{"id": 629, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 630, "speaker": 2, "form": "dlg", "jp": "『人質』"},
{"id": 631, "speaker": 2, "form": "dlg", "jp": "！？」"},
{"id": 632, "speaker": 22, "form": "dlg", "jp": "「さあ、銃をすてるんだ！」"},
{"id": 633, "speaker": 29, "form": "dlg", "jp": "「な、何いってんの！」"},
{"id": 634, "speaker": 22, "form": "dlg", "jp": "「アンタが引き金をひくのと、\n　オレがあの子の首根っこをへし折るの‥‥」"},
{"id": 635, "speaker": 22, "form": "dlg", "jp": "「どっちが早いか試してみるか？」"},
{"id": 636, "speaker": 31, "form": "dlg", "jp": "「ジーン‥‥」"},
{"id": 637, "speaker": 29, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 638, "speaker": 29, "form": "dlg", "jp": "「カラカラ‥‥」"},
{"id": 639, "speaker": 29, "form": "dlg", "jp": "ジーンは拳銃を地面に捨てた‥‥"},
{"id": 640, "speaker": 22, "form": "dlg", "jp": "「ちょっとは\n　ものわかりがいいみたいだな‥‥」"},
{"id": 641, "speaker": 22, "form": "dlg", "jp": "男はそう言うと拳銃を拾い上げた‥‥"},
{"id": 642, "speaker": 31, "form": "dlg", "jp": "「アキラを放してやってくれ‥‥」"},
{"id": 643, "speaker": 22, "form": "dlg", "jp": "「そらよっ！」"},
{"id": 644, "speaker": 16, "form": "dlg", "jp": "「ゴメンナサイ、アキラのせいで‥‥」"},
{"id": 645, "speaker": 31, "form": "dlg", "jp": "「気にするな‥‥」"},
{"id": 646, "speaker": 22, "form": "dlg", "jp": "「どうだ、\n　お互い干渉しないってとこで手をうたないか？」"},
{"id": 647, "speaker": 22, "form": "dlg", "jp": "「オレもオマエたちのジャマしないし‥‥」"},
{"id": 648, "speaker": 22, "form": "dlg", "jp": "「オマエたちも\n　オレのジャマをしないってことで‥‥」"},
{"id": 649, "speaker": 29, "form": "dlg", "jp": "「イヤよ！」"},
{"id": 650, "speaker": 22, "form": "dlg", "jp": "「状況が飲み込めてないようだな‥‥」"},
{"id": 651, "speaker": 22, "form": "dlg", "jp": "「穴だらけになりたいのか？」"},
{"id": 652, "speaker": 29, "form": "dlg", "jp": "「撃てるものなら撃ってみなさい‥‥」"},
{"id": 653, "speaker": 22, "form": "dlg", "jp": "「ヘヘヘヘヘ‥‥」"},
{"id": 654, "speaker": 22, "form": "dlg", "jp": "「オレはオマエたちと違って、\n　人を殺すのなんて平気なんだぞ‥‥」"},
{"id": 655, "speaker": 29, "form": "dlg", "jp": "「なら、さっさとうちなさいよ！！」"},
{"id": 656, "speaker": 2, "form": "dlg", "jp": "「ヤメロ、ジーン！！」"},
{"id": 657, "speaker": 2, "form": "dlg", "jp": "「コイツ、本気だ！！」"},
{"id": 658, "speaker": 22, "form": "dlg", "jp": "「そんなに『仲間』になりたいなら\n　『仲間』にしてやるぜ‥‥」"},
{"id": 659, "speaker": 22, "form": "dlg", "jp": "「死ねぇ～～！」"},
{"id": 660, "speaker": 22, "form": "dlg", "jp": "「バーーーン！」"},
{"id": 661, "speaker": 22, "form": "dlg", "jp": "銃声が倉庫中に響き渡った。"},
{"id": 662, "speaker": 22, "form": "dlg", "jp": "鈍い音をたてて、男が地面に倒れた‥‥"},
{"id": 663, "speaker": 16, "form": "dlg", "jp": "「どうしたの？」"},
{"id": 664, "speaker": 29, "form": "dlg", "jp": "「『暴発』よ‥‥」"},
{"id": 665, "speaker": 2, "form": "dlg", "jp": "「『暴発』？」"},
{"id": 666, "speaker": 29, "form": "dlg", "jp": "「『銃』に"},
{"id": 667, "speaker": 29, "form": "dlg", "jp": "細工"},
{"id": 668, "speaker": 29, "form": "dlg", "jp": "しておいたのよ！」"},
{"id": 669, "speaker": 29, "form": "dlg", "jp": "「『銃』を置く時にね‥‥」"},
{"id": 670, "speaker": 16, "form": "dlg", "jp": "「で、コイツ死んじゃったの？」"},
{"id": 671, "speaker": 31, "form": "dlg", "jp": "「これ以上オレが何をするって言うんだよ！！」"},
{"id": 672, "speaker": 31, "form": "choice", "jp": "「ジーン！！」"},
{"id": 673, "speaker": 31, "form": "choice", "jp": "「ケネス！！」"},
{"id": 674, "speaker": 31, "form": "choice", "jp": "「長尾ぉ！！」"},
{"id": 675, "speaker": 2, "form": "dlg", "jp": "「ケネス！！」"},
{"id": 676, "speaker": 31, "form": "dlg", "jp": "「オレは手一杯だよ！」"},
{"id": 677, "speaker": 31, "form": "choice", "jp": "「ジーン！！」"},
{"id": 678, "speaker": 31, "form": "choice", "jp": "「ケネス！！」"},
{"id": 679, "speaker": 31, "form": "choice", "jp": "「長尾ぉ！！」"},
{"id": 680, "speaker": 31, "form": "dlg", "jp": "「さあ、頭ふっとんじゃってるしな‥‥」"},
{"id": 681, "speaker": 31, "form": "dlg", "jp": "「もし生きてても、\n　もう『能力』は使えないだろうな‥‥」"},
{"id": 682, "speaker": 29, "form": "dlg", "jp": "「さぁ、とっとと帰りましょう‥‥」"},
{"id": 683, "speaker": 31, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 684, "speaker": 31, "form": "dlg", "jp": "「こんな『死体だらけの場所』、さっさとずらかろうぜ‥‥」"},
{"id": 685, "speaker": 31, "form": "dlg", "jp": "『死体だらけの場所』‥‥"},
{"id": 686, "speaker": 31, "form": "dlg", "jp": "ボクたちの周りには大量の死体が転がっていた。"},
{"id": 687, "speaker": 29, "form": "dlg", "jp": "「どうしたの‥‥？」"},
{"id": 688, "speaker": 2, "form": "dlg", "jp": "「これって、全部死体なんだよね‥‥」"},
{"id": 689, "speaker": 29, "form": "dlg", "jp": "「これぐらいの死体でおどろいていたら\n　この先、戦ってゆけないわよ‥‥」"},
{"id": 690, "speaker": 29, "form": "dlg", "jp": "「しっかりしなさい！」"},
{"id": 691, "speaker": 2, "form": "dlg", "jp": "「あ、ああ‥‥」"},
{"id": 692, "speaker": 2, "form": "dlg", "jp": "こうしてボクたちは倉庫を後にした。"},
{"id": 693, "speaker": 2, "form": "dlg", "jp": "「ごちそうさま‥‥」"},
{"id": 694, "speaker": 3, "form": "dlg", "jp": "「どうしたの、ぜんぜん食べてないじゃない？」"},
{"id": 695, "speaker": 3, "form": "dlg", "jp": "食欲なんてとても‥‥"},
{"id": 696, "speaker": 3, "form": "dlg", "jp": "あんなにたくさんの『死体』を見たんだから‥‥"},
{"id": 697, "speaker": 3, "form": "dlg", "jp": "「もしかして、夏バテ？」"},
{"id": 698, "speaker": 2, "form": "dlg", "jp": "「あ、ああ‥‥」"},
{"id": 699, "speaker": 2, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 700, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 701, "speaker": 31, "form": "dlg", "jp": "（よっ！）"},
{"id": 702, "speaker": 2, "form": "dlg", "jp": "（ケネス！？）"},
{"id": 703, "speaker": 2, "form": "dlg", "jp": "（ジーンは？）"},
{"id": 704, "speaker": 31, "form": "dlg", "jp": "（オレだけだ‥‥）"},
{"id": 705, "speaker": 2, "form": "dlg", "jp": "（どうして？）"},
{"id": 706, "speaker": 31, "form": "dlg", "jp": "（なんだ、ジーンがいないと不満か？）"},
{"id": 707, "speaker": 2, "form": "dlg", "jp": "（そうじゃないけど‥‥）"},
{"id": 708, "speaker": 31, "form": "dlg", "jp": "（じゃあ、いいじゃないか！）"},
{"id": 709, "speaker": 2, "form": "dlg", "jp": "（で、なんの用だよ‥‥）"},
{"id": 710, "speaker": 31, "form": "dlg", "jp": "（用と呼べるような用はないよ‥‥）"},
{"id": 711, "speaker": 31, "form": "dlg", "jp": "（ちょっと『心構え』を伝えにきただけだ‥‥）"},
{"id": 712, "speaker": 2, "form": "dlg", "jp": "（『心構え』？）"},
{"id": 713, "speaker": 31, "form": "dlg", "jp": "（あれだけの死体をみたから\n　ショックを受けてるんじゃないかと思ってな‥‥）"},
{"id": 714, "speaker": 2, "form": "dlg", "jp": "（あたりまえじゃないか‥‥）"},
{"id": 715, "speaker": 31, "form": "dlg", "jp": "（そうさ、あたりまえなんだよ！）"},
{"id": 716, "speaker": 2, "form": "dlg", "jp": "（いちいち死体を見て\n　ショックを受けちゃいけないの？）"},
{"id": 717, "speaker": 31, "form": "dlg", "jp": "（そんなことはない、人が死ぬことに\n　平気になっちゃいけないな‥‥）"},
{"id": 718, "speaker": 31, "form": "dlg", "jp": "（ただ、『人が死ぬ』ことに\n　『覚悟』だけはしておいた方がいいな‥‥）"},
{"id": 719, "speaker": 2, "form": "dlg", "jp": "（『覚悟』？）"},
{"id": 720, "speaker": 31, "form": "dlg", "jp": "（強くなれっていうことだ‥‥）"},
{"id": 721, "speaker": 31, "form": "dlg", "jp": "（わかるだろう、オレのいいたいこと‥‥）"},
{"id": 722, "speaker": 2, "form": "dlg", "jp": "（なんとなく‥‥）"},
{"id": 723, "speaker": 31, "form": "dlg", "jp": "（オレたちのガンバリ次第で\n　『人が死ぬ』ことを防ぐことができるんだ‥‥）"},
{"id": 724, "speaker": 31, "form": "dlg", "jp": "（とにかく、強くなれ！！）"},
{"id": 725, "speaker": 31, "form": "dlg", "jp": "（わかったな‥‥）"},
{"id": 726, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥）"},
{"id": 727, "speaker": 31, "form": "dlg", "jp": "（まあ、\n　オレのいいたいことはそれだけだ‥‥）"},
{"id": 728, "speaker": 31, "form": "dlg", "jp": "（じゃあな‥‥）"},
{"id": 729, "speaker": 2, "form": "dlg", "jp": "（アリガトウ‥‥）"},
{"id": 730, "speaker": 2, "form": "dlg", "jp": "ケネスは窓から飛び立って行った。"},
{"id": 731, "speaker": 29, "form": "dlg", "jp": "「何してるの、正面のヤツよ！！」"},
{"id": 732, "speaker": 2, "form": "dlg", "jp": "「ゴ、ゴメン‥‥」"},
{"id": 733, "speaker": 31, "form": "dlg", "jp": "「わるい、もうダメだ‥‥」"},
{"id": 734, "speaker": 31, "form": "dlg", "jp": "とたん、ボクたちを取り囲んでいた『ゾンビ』たちが\n一斉に飛びかかってきた‥‥"},
{"id": 735, "speaker": 2, "form": "dlg", "jp": "「ウワ～～～～～ッ！」"},
{"id": 736, "speaker": 2, "form": "dlg", "jp": "失敗の原因はタイミングを間違えたこと。\n後になるほどタイミングは難しくなるぞ！"},
{"id": 737, "speaker": 2, "form": "dlg", "jp": "失敗の原因は相手のことをあまくみたこと。\n相手を見抜く力をつけろ！"}
]
