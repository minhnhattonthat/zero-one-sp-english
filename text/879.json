{"id": 20, "speaker": 18, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 21, "speaker": 31, "form": "dlg", "jp": "「ジーン、どうなんだ？」"},
{"id": 22, "speaker": 29, "form": "dlg", "jp": "「『邪悪な感覚』は消えたわ！」"},
{"id": 23, "speaker": 35, "form": "dlg", "jp": "「って、ことは？」"},
{"id": 24, "speaker": 18, "form": "dlg", "jp": "「私たちが『勝った』のね！」"},
{"id": 25, "speaker": 18, "form": "dlg", "jp": "「やった～～～～～！」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「結局、ボクたち何の役にも立てなかったね‥‥」"},
{"id": 27, "speaker": 18, "form": "dlg", "jp": "「いいんじゃないかな、それでも‥‥」"},
{"id": 28, "speaker": 16, "form": "dlg", "jp": "「アキラたちが『勝った』のね！」"},
{"id": 29, "speaker": 16, "form": "dlg", "jp": "「やった～～～～～！」"},
{"id": 30, "speaker": 16, "form": "dlg", "jp": "「結局、\n　アキラたち何の役にも立てなかったわね‥‥」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「いいんじゃないかな、それでも‥‥」"},
{"id": 32, "speaker": 16, "form": "dlg", "jp": "「でも、もっと活躍したかったな‥‥」"},
{"id": 33, "speaker": 51, "form": "dlg", "jp": "「ウチらの『勝ち』やね！」"},
{"id": 34, "speaker": 51, "form": "dlg", "jp": "「やった～～～～～！」"},
{"id": 35, "speaker": 51, "form": "dlg", "jp": "「結局、\n　ウチら何の役にも立てへんかったなぁ‥‥」"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "「いいんじゃないかな、それでも‥‥」"},
{"id": 37, "speaker": 15, "form": "dlg", "jp": "「私たちが『勝った』のね！」"},
{"id": 38, "speaker": 15, "form": "dlg", "jp": "「やった～～～～～！」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「結局、ボクたち何の役にも立てなかったね‥‥」"},
{"id": 40, "speaker": 15, "form": "dlg", "jp": "「いいんじゃない？　それでも‥‥」"},
{"id": 41, "speaker": 15, "form": "dlg", "jp": "こうして、ボクたちと『クリエーター』の戦いは\n終わったように思えた。"},
{"id": 42, "speaker": 15, "form": "dlg", "jp": "しかし‥‥"},
{"id": 43, "speaker": 46, "form": "dlg", "jp": "「まだです‥‥」"},
{"id": 44, "speaker": 29, "form": "dlg", "jp": "「リーダー！？」"},
{"id": 45, "speaker": 46, "form": "dlg", "jp": "「私たちはまだ、\n　『遠隔攻撃』の手段を防いだだけです‥‥」"},
{"id": 46, "speaker": 13, "form": "dlg", "jp": "「うん、その通りだな‥‥」"},
{"id": 47, "speaker": 13, "form": "dlg", "jp": "「『遠隔攻撃』が使えなくなったんだから、\n　次は"},
{"id": 48, "speaker": 13, "form": "dlg", "jp": "『直接攻撃』に転じる"},
{"id": 49, "speaker": 13, "form": "dlg", "jp": "だろうな‥‥」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「直接攻撃！？」"},
{"id": 51, "speaker": 13, "form": "dlg", "jp": "「たぶんな‥‥」"},
{"id": 52, "speaker": 51, "form": "dlg", "jp": "「なあ、ずっと気になってたんやけど‥‥」"},
{"id": 53, "speaker": 13, "form": "dlg", "jp": "「なんだよ？」"},
{"id": 54, "speaker": 51, "form": "dlg", "jp": "「角川は、人類が滅亡することは恐くないんか？」"},
{"id": 55, "speaker": 51, "form": "dlg", "jp": "「なんか、スゴク冷静に見えるんやけど‥‥」"},
{"id": 56, "speaker": 15, "form": "dlg", "jp": "「ねえ、ずっと気になってたんだけど‥‥」"},
{"id": 57, "speaker": 13, "form": "dlg", "jp": "「なんだよ？」"},
{"id": 58, "speaker": 15, "form": "dlg", "jp": "「角川くんは、人類が滅亡することは恐くないの？」"},
{"id": 59, "speaker": 15, "form": "dlg", "jp": "「なんか、スゴク冷静に見えるんだけど‥‥」"},
{"id": 60, "speaker": 16, "form": "dlg", "jp": "「ねえ、ずっと気になってたんだけど‥‥」"},
{"id": 61, "speaker": 13, "form": "dlg", "jp": "「なんだよ？」"},
{"id": 62, "speaker": 16, "form": "dlg", "jp": "「角川くんは、人類が滅亡することは恐くないの？」"},
{"id": 63, "speaker": 16, "form": "dlg", "jp": "「なんか、スゴク冷静に見えるんだけど‥‥」"},
{"id": 64, "speaker": 18, "form": "dlg", "jp": "「ねえ、ずっと気になってたんだけど‥‥」"},
{"id": 65, "speaker": 13, "form": "dlg", "jp": "「何？」"},
{"id": 66, "speaker": 18, "form": "dlg", "jp": "「角川くんは、人類が滅亡することは恐くないの？」"},
{"id": 67, "speaker": 18, "form": "dlg", "jp": "「なんか、スゴク冷静に見えるんだけど‥‥」"},
{"id": 68, "speaker": 13, "form": "dlg", "jp": "「コワイに決まってるだろう！！」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「じゃあ、どうして？」"},
{"id": 70, "speaker": 13, "form": "dlg", "jp": "「ゲームできたえられているからな‥‥」"},
{"id": 71, "speaker": 13, "form": "dlg", "jp": "「ゲームは冷静さを欠いた時点で負けなんだよ！」"},
{"id": 72, "speaker": 13, "form": "dlg", "jp": "「ピンチの時ほど、冷静に動かないと、\n　つまらないミスで自滅するんだよ！」"},
{"id": 73, "speaker": 35, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 74, "speaker": 35, "form": "dlg", "jp": "「キミはいいコマンダーになれると思うよ！」"},
{"id": 75, "speaker": 13, "form": "dlg", "jp": "「ありがとう！」"},
{"id": 76, "speaker": 29, "form": "dlg", "jp": "「そんなコトより、\n　本当に『直接攻撃』ってあるのかしら？」"},
{"id": 77, "speaker": 46, "form": "dlg", "jp": "「わかりません‥‥」"},
{"id": 78, "speaker": 46, "form": "dlg", "jp": "「過去、人類とクリエーターの戦いにおいて\n　ここまでの戦果をあげたことはないですから‥‥」"},
{"id": 79, "speaker": 31, "form": "dlg", "jp": "「ついにオレたちは"},
{"id": 80, "speaker": 31, "form": "dlg", "jp": "『未知の領域』"},
{"id": 81, "speaker": 31, "form": "dlg", "jp": "に\n　到達したってことか‥‥」"},
{"id": 82, "speaker": 31, "form": "dlg", "jp": "「アキラ、\n　この先のこと何か『夢』を見ていないのか？」"},
{"id": 83, "speaker": 16, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 84, "speaker": 16, "form": "dlg", "jp": "「ぜんぜん関係ない夢しか‥‥」"},
{"id": 85, "speaker": 29, "form": "dlg", "jp": "「関係ない夢って？」"},
{"id": 86, "speaker": 16, "form": "dlg", "jp": "「"},
{"id": 87, "speaker": 16, "form": "dlg", "jp": "アスカさんの誕生日を祝ってる夢"},
{"id": 88, "speaker": 16, "form": "dlg", "jp": "‥‥」"},
{"id": 89, "speaker": 31, "form": "dlg", "jp": "「アイコ、\n　この先のこと何か『夢』を見ていないのか？」"},
{"id": 90, "speaker": 15, "form": "dlg", "jp": "「ゴメンなさい‥‥」"},
{"id": 91, "speaker": 15, "form": "dlg", "jp": "「ぜんぜん関係ない夢しか‥‥」"},
{"id": 92, "speaker": 29, "form": "dlg", "jp": "「関係ない夢って？」"},
{"id": 93, "speaker": 15, "form": "dlg", "jp": "「"},
{"id": 94, "speaker": 15, "form": "dlg", "jp": "松尾さんの誕生日を祝ってる夢"},
{"id": 95, "speaker": 15, "form": "dlg", "jp": "‥‥」"},
{"id": 96, "speaker": 18, "form": "dlg", "jp": "「『未知の領域』‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 98, "speaker": 18, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』には\n　『未来予知』の能力を持った『能力者』とかは‥‥？」"},
{"id": 99, "speaker": 46, "form": "dlg", "jp": "「２名ほどいます‥‥」"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "「『エドガー』や『ミッシェル』のことですね‥‥」"},
{"id": 101, "speaker": 46, "form": "dlg", "jp": "「ただ彼等は『近い未来』の『予知夢』を見るだけで‥‥」"},
{"id": 102, "speaker": 46, "form": "dlg", "jp": "「都合よく任意の時間の未来は見えません」"},
{"id": 103, "speaker": 18, "form": "dlg", "jp": "「『近い未来』ってどれくらいですか？」"},
{"id": 104, "speaker": 46, "form": "dlg", "jp": "「最近の報告では‥‥」"},
{"id": 105, "speaker": 46, "form": "dlg", "jp": "「エドガーはもう何日も夢を見てないそうです‥‥」"},
{"id": 106, "speaker": 31, "form": "dlg", "jp": "「ミッシェルはどんな夢を？」"},
{"id": 107, "speaker": 46, "form": "dlg", "jp": "「"},
{"id": 108, "speaker": 46, "form": "dlg", "jp": "アスカの誕生日を祝ってる夢"},
{"id": 109, "speaker": 46, "form": "dlg", "jp": "を‥‥」"},
{"id": 110, "speaker": 51, "form": "dlg", "jp": "「『未知の領域』ねぇ‥‥」"},
{"id": 111, "speaker": 51, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』には\n　『未来予知』の能力を持った『能力者』はおらへんの？」"},
{"id": 112, "speaker": 46, "form": "dlg", "jp": "「２名ほどいます‥‥」"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "「『エドガー』や『ミッシェル』のことですね‥‥」"},
{"id": 114, "speaker": 46, "form": "dlg", "jp": "「ただ彼等は『近い未来』の『予知夢』を見るだけで‥‥」"},
{"id": 115, "speaker": 46, "form": "dlg", "jp": "「都合よく任意の時間の未来は見えません」"},
{"id": 116, "speaker": 51, "form": "dlg", "jp": "「『近い未来』ってどれくらい？」"},
{"id": 117, "speaker": 46, "form": "dlg", "jp": "「最近の報告では‥‥」"},
{"id": 118, "speaker": 46, "form": "dlg", "jp": "「エドガーはもう何日も夢を見てないそうです‥‥」"},
{"id": 119, "speaker": 31, "form": "dlg", "jp": "「ミッシェルはどんな夢を？」"},
{"id": 120, "speaker": 46, "form": "dlg", "jp": "「"},
{"id": 121, "speaker": 46, "form": "dlg", "jp": "アスカの誕生日を祝ってる夢"},
{"id": 122, "speaker": 46, "form": "dlg", "jp": "を‥‥」"},
{"id": 123, "speaker": 29, "form": "dlg", "jp": "「全然、関係ない『夢』ね‥‥」"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "「関係あるんじゃない？」"},
{"id": 126, "speaker": 13, "form": "dlg", "jp": "「うん、あるな‥‥」"},
{"id": 127, "speaker": 31, "form": "dlg", "jp": "「どう関係あるんだ？」"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "「つまり‥‥」"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "松尾さんの誕生日までは\n　『クリエーター』は襲ってこない"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "ってことだろう？」"},
{"id": 132, "speaker": 46, "form": "dlg", "jp": "「そうなりますね！」"},
{"id": 133, "speaker": 13, "form": "dlg", "jp": "「つまり、アレだな‥‥」"},
{"id": 134, "speaker": 13, "form": "dlg", "jp": "「『直接攻撃』の有無に関係なく、\n　それまでは安全なんだ‥‥」"},
{"id": 135, "speaker": 31, "form": "dlg", "jp": "「それまでが、\n　とりあえずの『猶予（ユウヨ）』ってわけか‥‥」"},
{"id": 136, "speaker": 31, "form": "dlg", "jp": "「で、アスカ、誕生日はいつなんだ？」"},
{"id": 137, "speaker": 31, "form": "dlg", "jp": "「３月か？」"},
{"id": 138, "speaker": 31, "form": "dlg", "jp": "「１月か？」"},
{"id": 139, "speaker": 35, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 140, "speaker": 35, "form": "dlg", "jp": "「"},
{"id": 141, "speaker": 35, "form": "dlg", "jp": "明日"},
{"id": 142, "speaker": 35, "form": "dlg", "jp": "‥‥」"},
{"id": 143, "speaker": 29, "form": "dlg", "jp": "「なんですって！？」"},
{"id": 144, "speaker": 31, "form": "dlg", "jp": "「バカヤロウ！」"},
{"id": 145, "speaker": 31, "form": "dlg", "jp": "「ぜんぜん、『猶予（ユウヨ）』がないじゃないか！！」"},
{"id": 146, "speaker": 35, "form": "dlg", "jp": "「オレのせいじゃないだろう！！」"},
{"id": 147, "speaker": 46, "form": "dlg", "jp": "「そうですね‥‥」"},
{"id": 148, "speaker": 46, "form": "dlg", "jp": "「それに、たった１日でも『猶予（ユウヨ）』が出来たのは\n　よろこばしいことです」"},
{"id": 149, "speaker": 46, "form": "dlg", "jp": "「今のうちに『直接攻撃』に備えて、\n　コンディションを整えられますし‥‥」"},
{"id": 150, "speaker": 46, "form": "dlg", "jp": "「特に、ジーンのチームは最近働きっぱなしですから、\n　今のうちに休養をとって下さい」"},
{"id": 151, "speaker": 13, "form": "dlg", "jp": "「そういうこった‥‥」"},
{"id": 152, "speaker": 31, "form": "dlg", "jp": "「ツトムはドライだね‥‥」"},
{"id": 153, "speaker": 31, "form": "dlg", "jp": "こうして、\nボクたちは丸一日の休暇をもらえることになった。"}
]
