[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／２９／ＡＭ１０：２０"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "（なんだい、急に集合かけたりして？）"},
{"id": 2, "speaker": 29, "form": "dlg", "jp": "（本部から、\n　アナタたちの『スーツ』が届いたのよ‥‥）"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "（『スーツ』？）"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "（もしかして、いまジーンたちが着ているそれ？）"},
{"id": 5, "speaker": 29, "form": "dlg", "jp": "（そうよ‥‥）"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "（『Ｅ－ｇｒｏ』のユニフォームみたいなものよ！）"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "（ユニフォーム？）"},
{"id": 8, "speaker": 31, "form": "dlg", "jp": "（まあ、戦闘服みたいなもんだ！）"},
{"id": 9, "speaker": 31, "form": "dlg", "jp": "（『Ｅ－ｇｒｏ』は秘密の組織だけど、優秀な科学者や\n　大手企業がバックアップしてくれてるから）"},
{"id": 10, "speaker": 31, "form": "dlg", "jp": "（超能力だけでなく、科学力もスゴイんだよ）"},
{"id": 11, "speaker": 31, "form": "dlg", "jp": "（このスーツには\n　そのスゴイ科学がいっぱい詰まってるんだ！）"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "（例えば？）"},
{"id": 13, "speaker": 29, "form": "dlg", "jp": "（温度調節機能とか‥‥）"},
{"id": 14, "speaker": 29, "form": "dlg", "jp": "（どんな気温の場所でも体温を一定に保てる機能よ）"},
{"id": 15, "speaker": 29, "form": "dlg", "jp": "（さらに‥‥）"},
{"id": 16, "speaker": 29, "form": "dlg", "jp": "（一番の特徴が『ステルス効果』ね‥‥）"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "（ステルス効果？）"},
{"id": 18, "speaker": 29, "form": "dlg", "jp": "（このスーツには光の乱反射機能が付いていて、\n　カメラやレーダーなんかに捕らえられにくいの‥‥）"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "（この前のロボットの時みたいな行動をしてたら、\n　カメラなんかに写っちゃうかもしれないでしょう？）"},
{"id": 20, "speaker": 31, "form": "dlg", "jp": "（そうだな、あの時は誰かに見られるんじゃあって\n　ドキドキしたからな‥‥）"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "（とにかく、これからは\n　行動する時にはコレを着てちょうだい！）"},
{"id": 22, "speaker": 16, "form": "dlg", "jp": "（エ～っ！）"},
{"id": 23, "speaker": 31, "form": "dlg", "jp": "（不満なのか？）"},
{"id": 24, "speaker": 16, "form": "dlg", "jp": "（だって、アキラ‥‥）"},
{"id": 25, "speaker": 16, "form": "dlg", "jp": "（実は、自分専用の『バトルスーツ』を\n　作って来たのに‥‥）"},
{"id": 26, "speaker": 35, "form": "dlg", "jp": "（ホント？）"},
{"id": 27, "speaker": 35, "form": "dlg", "jp": "（アキラちゃん、スゴイや！！）"},
{"id": 28, "speaker": 16, "form": "dlg", "jp": "（でしょう？）"},
{"id": 29, "speaker": 16, "form": "dlg", "jp": "（常光寺くん、ちょっとトイレ借りるわね？）"},
{"id": 30, "speaker": 16, "form": "dlg", "jp": "（着替えてくるわ！）"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "（いいけど、姉さんに見つかるなよ！）"},
{"id": 32, "speaker": 16, "form": "dlg", "jp": "（わかってるって！）"},
{"id": 33, "speaker": 16, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 34, "speaker": 16, "form": "dlg", "jp": "「バタン！」"},
{"id": 35, "speaker": 16, "form": "dlg", "jp": "長尾は紙袋を抱えて部屋を出ていった。"},
{"id": 36, "speaker": 35, "form": "dlg", "jp": "（アキラちゃんってスゴイんだね‥‥）"},
{"id": 37, "speaker": 31, "form": "dlg", "jp": "（たしかに、そこらへんにいる女の子とは\n　違った感じがするもんな）"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "（多分、期待しない方がいいよ‥‥）"},
{"id": 39, "speaker": 16, "form": "dlg", "jp": "（お待たせ～～）"},
{"id": 40, "speaker": 16, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 41, "speaker": 29, "form": "dlg", "jp": "（何よ、その格好は！）"},
{"id": 42, "speaker": 16, "form": "dlg", "jp": "（どう？）"},
{"id": 43, "speaker": 31, "form": "dlg", "jp": "（いいぞ、アキラ！！）"},
{"id": 44, "speaker": 29, "form": "dlg", "jp": "（いいわけないでしょう！）"},
{"id": 45, "speaker": 29, "form": "dlg", "jp": "（着替えてらっしゃい！）"},
{"id": 46, "speaker": 16, "form": "dlg", "jp": "（なんで？）"},
{"id": 47, "speaker": 29, "form": "dlg", "jp": "（いいからっ！！）"},
{"id": 48, "speaker": 16, "form": "dlg", "jp": "（わかったわよ！）"},
{"id": 49, "speaker": 16, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 50, "speaker": 16, "form": "dlg", "jp": "「バタン！」"},
{"id": 51, "speaker": 16, "form": "dlg", "jp": "長尾は再び着替えに行った。"},
{"id": 52, "speaker": 16, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 53, "speaker": 16, "form": "dlg", "jp": "（ハイ、コレでいいんでしょ！）"},
{"id": 54, "speaker": 31, "form": "dlg", "jp": "（いや、オレはさっきの方が面白かったぜ！）"},
{"id": 55, "speaker": 29, "form": "dlg", "jp": "（そう言う問題じゃないでしょ！！）"},
{"id": 56, "speaker": 29, "form": "dlg", "jp": "（あんな格好じゃぁ、\n　目立ってしょうがないじゃないの！）"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "（それにあんなに肌が出ていたら\n　危ないでしょう！）"},
{"id": 58, "speaker": 16, "form": "dlg", "jp": "（でも、超能力で戦うなら、\n　フツウあんな感じでしょう？）"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "（フツウは超能力では戦わないな‥‥）"},
{"id": 60, "speaker": 29, "form": "dlg", "jp": "（とにかく、本部からの\n　コッチのユニフォームを着てもらうから‥‥）"},
{"id": 61, "speaker": 51, "form": "dlg", "jp": "（なんかちょっとハズかしいなぁ‥‥）"},
{"id": 62, "speaker": 51, "form": "dlg", "jp": "（コレ‥‥）"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "（機能優先なの、ガマンしなさい！）"},
{"id": 64, "speaker": 15, "form": "dlg", "jp": "（コレってピチピチの素材だから‥‥）"},
{"id": 65, "speaker": 15, "form": "dlg", "jp": "（体のラインが出ちゃうんじゃ？）"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "（子供のクセにマセたこと言わないで！）"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "（生きるか死ぬかの戦いなのよ！）"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "（機能優先には目をつぶりなさい！）"},
{"id": 69, "speaker": 16, "form": "dlg", "jp": "（コレってピチピチの素材だから‥‥）"},
{"id": 70, "speaker": 16, "form": "dlg", "jp": "（体のラインが出ちゃうんじゃない？）"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "（アンタのコスプレよりぜんぜんマシでしょう！）"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "（生きるか死ぬかの戦いなのよ！）"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "（機能優先には目をつぶりなさい！）"},
{"id": 74, "speaker": 18, "form": "dlg", "jp": "（コレってピチッとした素材だから‥‥）"},
{"id": 75, "speaker": 18, "form": "dlg", "jp": "（体のラインが出ちゃうんじゃ‥‥？）"},
{"id": 76, "speaker": 29, "form": "dlg", "jp": "（生きるか死ぬかの戦いなの）"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "（機能優先には目をつぶってちょうだい‥‥）"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "（で、さぁ～）"},
{"id": 79, "speaker": 2, "form": "choice", "jp": "（なんで今頃こんなものを？）"},
{"id": 80, "speaker": 2, "form": "choice", "jp": "（もう仲間探しは終わったんじゃ？）"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "（なんで今頃こんなものを？）"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "（それこそ、こないだのロボットの時に\n　送ってくれたら良かったのに！）"},
{"id": 83, "speaker": 29, "form": "dlg", "jp": "（アナタたちの体のサイズにあわせて、\n　カスタマイズしてたのよ！）"},
{"id": 84, "speaker": 29, "form": "dlg", "jp": "（それと、\n　仲間探しが一段落ついたってこともあるしね）"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "（もう仲間探しは終わったんじゃ？）"},
{"id": 86, "speaker": 29, "form": "dlg", "jp": "（私たちの目的は\n　仲間探しじゃぁないでしょう！）"},
{"id": 87, "speaker": 29, "form": "dlg", "jp": "（仲間探しが終わったってことは、いよいよ\n　ゲーマーとの応戦体制を整えていかないと‥‥）"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "（結局、３人だけしか集まらなかったけど‥‥）"},
{"id": 89, "speaker": 31, "form": "dlg", "jp": "（気にするな！）"},
{"id": 90, "speaker": 31, "form": "dlg", "jp": "（確率的には\n　半分以上が仲間になったんだから優秀な方だ！）"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "（それに、本部はアナタたち３人の能力を\n　高く評価しているわ！）"},
{"id": 92, "speaker": 29, "form": "dlg", "jp": "（それに、だんだんクリエーターの攻撃も\n　本格的になりつつあるみたいだし‥‥）"},
{"id": 93, "speaker": 29, "form": "dlg", "jp": "ジーンは新聞の束を差し出した。"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "「バサ‥‥」"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "そこには、こないだのロボットの\nニュースが大々的に書かれていた。"},
{"id": 96, "speaker": 31, "form": "dlg", "jp": "（いよいよって思ったんだろうな‥‥）"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "（だから本部も召集をかけたみたいね‥‥）"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "（『召集』！！）"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "（そうよ、\n　ナゴムたちにもすぐにペルーの本部に‥‥）"},
{"id": 100, "speaker": 51, "form": "dlg", "jp": "（すぐは難しいなあ‥‥）"},
{"id": 101, "speaker": 51, "form": "dlg", "jp": "（父ちゃんに何て説明したらええんか‥‥）"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "（心配しないで！）"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "（これからは本格的な戦いになるから、\n　家族ぐらいになら話しちゃってかまわないから‥‥）"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "（ありのままを説明してあげて‥‥）"},
{"id": 105, "speaker": 51, "form": "dlg", "jp": "（そんなん信じてくれるワケないやん！）"},
{"id": 106, "speaker": 51, "form": "dlg", "jp": "（救急車呼ばれるわ！！）"},
{"id": 107, "speaker": 51, "form": "dlg", "jp": "（それに‥‥）"},
{"id": 108, "speaker": 51, "form": "dlg", "jp": "（信じてくれたとしても‥‥）"},
{"id": 109, "speaker": 15, "form": "dlg", "jp": "（すぐになんて、無理よ！）"},
{"id": 110, "speaker": 15, "form": "dlg", "jp": "（お母さんたちになんて説明すればいいのよ！）"},
{"id": 111, "speaker": 29, "form": "dlg", "jp": "（心配しないで！）"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "（これからは本格的な戦いになるから、\n　家族ぐらいになら話しちゃってかまわないから‥‥）"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "（ありのままを説明してあげて‥‥）"},
{"id": 114, "speaker": 15, "form": "dlg", "jp": "（そんなの信じてくれるわけないじゃない！）"},
{"id": 115, "speaker": 15, "form": "dlg", "jp": "（それに‥‥）"},
{"id": 116, "speaker": 16, "form": "dlg", "jp": "（すぐになんて、無理！）"},
{"id": 117, "speaker": 16, "form": "dlg", "jp": "（絶対ダメ！）"},
{"id": 118, "speaker": 16, "form": "dlg", "jp": "（家族になんて説明すればいいのよ！）"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "（心配しないで！）"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "（これからは本格的な戦いになるから、\n　家族ぐらいになら話しちゃってかまわないから‥‥）"},
{"id": 121, "speaker": 29, "form": "dlg", "jp": "（ありのままを説明してあげて‥‥）"},
{"id": 122, "speaker": 16, "form": "dlg", "jp": "（そんなの信じてくれるわけないじゃない！）"},
{"id": 123, "speaker": 16, "form": "dlg", "jp": "（それに‥‥）"},
{"id": 124, "speaker": 18, "form": "dlg", "jp": "（そんな、すぐになんて‥‥）"},
{"id": 125, "speaker": 18, "form": "dlg", "jp": "（家族になんて説明すればいいの？）"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "（心配しないで！）"},
{"id": 127, "speaker": 29, "form": "dlg", "jp": "（これからは本格的な戦いになるから、\n　家族ぐらいになら話しちゃってかまわないから‥‥）"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "（ありのままを説明してあげて‥‥）"},
{"id": 129, "speaker": 18, "form": "dlg", "jp": "（そんなの信じてくれるわけないわ！）"},
{"id": 130, "speaker": 18, "form": "dlg", "jp": "（それに‥‥）"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "（そんな危険な戦いに参加していいっていう親も\n　この国にはいないよな‥‥）"},
{"id": 132, "speaker": 29, "form": "dlg", "jp": "（ナゴムのところもそうなの？）"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "（当たり前だろう！）"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "（中学生が\n　そんなワケのわからない理由で海外旅行なんて！）"},
{"id": 135, "speaker": 35, "form": "dlg", "jp": "（オレはぜんぜんかまわないよ‥‥）"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "（松尾さん、仕事は大丈夫なの？）"},
{"id": 137, "speaker": 35, "form": "dlg", "jp": "（もう除隊したよ！）"},
{"id": 138, "speaker": 35, "form": "dlg", "jp": "（日本の平和より、人類の平和の方が大事だからね‥‥）"},
{"id": 139, "speaker": 31, "form": "dlg", "jp": "（立派だねぇ～～）"},
{"id": 140, "speaker": 29, "form": "dlg", "jp": "（とにかく、何がなんでも話をつけてちょうだい！）"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "（アナタたちの力が必要なのよ！）"},
{"id": 142, "speaker": 29, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 143, "speaker": 29, "form": "dlg", "jp": "ヤバイ！"},
{"id": 144, "speaker": 29, "form": "dlg", "jp": "姉さんだっ！"},
{"id": 145, "speaker": 29, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 146, "speaker": 3, "form": "dlg", "jp": "「へっ、お客さん？」"},
{"id": 147, "speaker": 3, "form": "dlg", "jp": "「いつのまに？」"},
{"id": 148, "speaker": 31, "form": "dlg", "jp": "「おじゃましてます‥‥」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「どうしたの？」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「そんなにあわてて？」"},
{"id": 151, "speaker": 3, "form": "dlg", "jp": "「ナゴム、テレビをつけてみて！！」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「なんだよ、いったい‥‥」"},
{"id": 153, "speaker": 3, "form": "dlg", "jp": "「いいから早く‥‥」"},
{"id": 154, "speaker": 44, "form": "dlg", "jp": "「これは決してドラマでもフィクションでもありません！」"},
{"id": 155, "speaker": 44, "form": "dlg", "jp": "「今、現実に起きている事件です」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「一体、何のニュース？？」"},
{"id": 157, "speaker": 3, "form": "dlg", "jp": "「‥‥‥‥‥」"},
{"id": 158, "speaker": 44, "form": "dlg", "jp": "「また、動きだした模様です‥‥」"},
{"id": 159, "speaker": 31, "form": "dlg", "jp": "「ア、アレ！？」"},
{"id": 160, "speaker": 31, "form": "dlg", "jp": "「こないだの少女誘拐犯ヤロウじゃ！？」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「ちがう、シローだ‥‥」"},
{"id": 162, "speaker": 31, "form": "dlg", "jp": "「シロー‥‥？」"},
{"id": 163, "speaker": 29, "form": "dlg", "jp": "「誰よそれ？」"},
{"id": 164, "speaker": 29, "form": "dlg", "jp": "ボクはみんなにシローのことを説明した。"},
{"id": 165, "speaker": 35, "form": "dlg", "jp": "「ナゴムくんって、いろいろ大変な目に\n　あってるんだね‥‥」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥」"},
{"id": 167, "speaker": 29, "form": "dlg", "jp": "「くだらないことにカンシンしないで！」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「それに、清田さんの体じゃ、\n　あんな人間離れした力は出ないだろうし‥‥」"},
{"id": 169, "speaker": 44, "form": "dlg", "jp": "「今、入りました情報によりますと、\n　あの『怪物』は‥‥」"},
{"id": 170, "speaker": 44, "form": "dlg", "jp": "「『ルードの事件』の証拠品として、\n　警察が保管していたアンドロイドだそうです‥‥」"},
{"id": 171, "speaker": 3, "form": "dlg", "jp": "「きっと、警察がバッテリーを修理したんだわ‥‥」"},
{"id": 172, "speaker": 3, "form": "dlg", "jp": "「とにかく、シローを説得に行きましょう！」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "（清田さんじゃないのは間違いないけど、\n　アレって本当にシローなんだろうか？）"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "（たしかシローの『意識』は『人工衛星』の中に‥‥）"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "「姉さん、\n　シローの『意識』は『人工衛星』の中にいるんじゃあ？」"},
{"id": 176, "speaker": 3, "form": "dlg", "jp": "「それが、いなくなったのよ！！」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「いない！？」"},
{"id": 178, "speaker": 3, "form": "dlg", "jp": "「ここ数日、\n　『人工衛星』の『シロー』とは全く連絡が取れないの！」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「それ本当なの！？」"},
{"id": 180, "speaker": 3, "form": "dlg", "jp": "「本当よ！！」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "（もしかして、本当に『シロー』が暴走してる！？）"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "（いったい『シロー』はいつの間にあの体に戻ったんだ！？）"},
{"id": 183, "speaker": 3, "form": "dlg", "jp": "「とにかく、シローを説得しないと！！」"},
{"id": 184, "speaker": 3, "form": "choice", "jp": "「そうだね！」"},
{"id": 185, "speaker": 3, "form": "choice", "jp": "「ちょっと待って！」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「そうだね！」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「ピンポーン」"},
{"id": 188, "speaker": 3, "form": "dlg", "jp": "「誰かしら？」"},
{"id": 189, "speaker": 3, "form": "dlg", "jp": "「ピンポーン」"},
{"id": 190, "speaker": 3, "form": "dlg", "jp": "「ちょっと、降りてくるから、\n　その間にナゴムも着替えて！」"},
{"id": 191, "speaker": 3, "form": "dlg", "jp": "「そんなカッコウじゃ、外に出られないでしょう！」"},
{"id": 192, "speaker": 3, "form": "dlg", "jp": "「ピンポーン」"},
{"id": 193, "speaker": 3, "form": "dlg", "jp": "「はいっ！」"},
{"id": 194, "speaker": 3, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 195, "speaker": 2, "form": "dlg", "jp": "「というわけなんだ‥‥」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「わるいけど、今日は帰ってもらえるかなぁ‥‥」"},
{"id": 197, "speaker": 29, "form": "dlg", "jp": "「アンタのお姉さん、このカッコウをみて\n　なんとも思わなかったのかしら？」"},
{"id": 198, "speaker": 31, "form": "dlg", "jp": "「よっぽど、パニくってんだろう？」"},
{"id": 199, "speaker": 31, "form": "dlg", "jp": "「それにどんなに怪力があるって言っても、\n　『警察の銃』で破壊できるぐらい」"},
{"id": 200, "speaker": 31, "form": "dlg", "jp": "「やわな作りなんだから、\n　大騒ぎするほどの相手か？」"},
{"id": 201, "speaker": 35, "form": "dlg", "jp": "「それは言えてる‥‥」"},
{"id": 202, "speaker": 29, "form": "dlg", "jp": "「それに、多分『暴走』じゃなくって、\n　『クリエーター』に操られているだけだから」"},
{"id": 203, "speaker": 29, "form": "dlg", "jp": "「ナゴムたちが説得しても\n　多分、関係ないわね‥‥」"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 205, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～～！」"},
{"id": 206, "speaker": 3, "form": "dlg", "jp": "「警部さんがむかえに来てくれたわよ！」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「姉さんはともかく、\n　警察に『クリエーター』の説明はできないよ！」"},
{"id": 208, "speaker": 31, "form": "dlg", "jp": "「まあ、そりゃそうだな‥‥」"},
{"id": 209, "speaker": 31, "form": "dlg", "jp": "「じゃあ、ぱっと行って、\n　ぱっと終わらせてくるんだな‥‥」"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "「ありがとう！！」"},
{"id": 211, "speaker": 29, "form": "dlg", "jp": "「くれぐれも、人前で能力は使わないように！」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "「わかってる！！」"},
{"id": 213, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～！」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "「今、行くよ！！」"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "こうしてボクは姉さんといっしょに\n『シロー』の説得に行くことにした。"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 217, "speaker": 11, "form": "dlg", "jp": "「すみません、ウチの連中が\n　バッテリーを修理したばっかりに‥‥」"},
{"id": 218, "speaker": 3, "form": "dlg", "jp": "「いいえ、こちらこそ\n　わざわざむかえに来ていただけるなんて‥‥」"},
{"id": 219, "speaker": 11, "form": "dlg", "jp": "「とにかく、ご理解を頂きたいのは\n　すでに莫大な被害がでているということです」"},
{"id": 220, "speaker": 11, "form": "dlg", "jp": "「ですから、説得が失敗した場合は‥‥」"},
{"id": 221, "speaker": 3, "form": "dlg", "jp": "「はい、破壊してくださって結構です‥‥」"},
{"id": 222, "speaker": 11, "form": "dlg", "jp": "「ありがとうございます‥‥」"},
{"id": 223, "speaker": 11, "form": "dlg", "jp": "「‥‥着きました」"},
{"id": 224, "speaker": 3, "form": "dlg", "jp": "「ナゴム、行くわよ‥‥」"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って‥‥」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「ボク１人で行くよ‥‥」"},
{"id": 227, "speaker": 11, "form": "dlg", "jp": "「ナゴムくん！！」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「姉さんはここで待ってて‥‥」"},
{"id": 229, "speaker": 3, "form": "dlg", "jp": "「いいえ、私も行くわ！！」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「ダメだ！」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「多分、ボク１人の方が、うまくいくはずなんだ！！」"},
{"id": 232, "speaker": 3, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 234, "speaker": 3, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥」"},
{"id": 236, "speaker": 3, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 237, "speaker": 3, "form": "dlg", "jp": "「でも、くれぐれも危ないことはしないでね‥‥」"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "「大丈夫だよ‥‥」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "ボクは念のため、\n１人でシローの説得に向かうことにした。"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "（いくら操られているといっても、\n　心のどこかにシローがいるなら‥‥）"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "（きっと、ボクたちの言うことを\n　聞いてくれるはず‥‥）"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "ボクは暴れているシローに\nゆっくりと近づいていった。"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "（シローはボクたちを守るように\n　命令されているんだ‥‥）"},
{"id": 244, "speaker": 2, "form": "dlg", "jp": "（いつもボクたちを助けてくれた‥‥）"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "（ルードが襲って来た時やペルーの時も‥‥）"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥！？）"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "（シローはどうやって、あの体に戻ってきたんだ！？）"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "（『バッテリー』が直ったぐらいで、\n　『人工衛星』から『意識』を転送できるんだろうか？）"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "（まさか、警察が回線をつないだ？）"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "（そんなことはありえない！）"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "（警察は『シローの意識』が\n　『あの体』にいないことを知らないハズだ）"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "（ってことは目の前にいるシローには\n　『シローの意識』はない！？）"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥！！）"},
{"id": 254, "speaker": 2, "form": "dlg", "jp": "（じゃあ、説得なんて！！）"},
{"id": 255, "speaker": 5, "form": "dlg", "jp": "「ウォ～～～～～～～！」"},
{"id": 256, "speaker": 5, "form": "dlg", "jp": "シローはボクに向かって\n持ち上げていた自動車を投げ付けた。"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "「ウワッ！」"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 259, "speaker": 3, "form": "dlg", "jp": "「どうしたの！！」"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "「あれはシローじゃないんじゃないかな？」"},
{"id": 261, "speaker": 3, "form": "dlg", "jp": "「何言ってるの！！」"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "「姉さん、良く考えてみてよ！！」"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "「シローは警察で保管されてたんだろう？」"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "「バッテリーが修理されたとしても、\n　『シローの意識』が転送されるわけじゃないだろう？」"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "「警察は『シローの意識』が\n　あの体にないことは知らないんだから」"},
{"id": 266, "speaker": 3, "form": "dlg", "jp": "「‥‥‥！？」"},
{"id": 267, "speaker": 3, "form": "dlg", "jp": "「そ、そうだったわね‥‥」"},
{"id": 268, "speaker": 3, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 269, "speaker": 3, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 270, "speaker": 3, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 271, "speaker": 3, "form": "dlg", "jp": "「‥‥‥！？」"},
{"id": 272, "speaker": 3, "form": "dlg", "jp": "「じゃあ、あのアンドロイドはなんで動いているの？」"},
{"id": 273, "speaker": 29, "form": "dlg", "jp": "「間違いなく『クリエーター』ね‥‥」"},
{"id": 274, "speaker": 3, "form": "dlg", "jp": "「『クリエーター』‥‥？」"},
{"id": 275, "speaker": 3, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 276, "speaker": 3, "form": "dlg", "jp": "「っていうより、みなさんは一体‥‥？」"},
{"id": 277, "speaker": 31, "form": "dlg", "jp": "「やっと、その話題になったか‥‥」"},
{"id": 278, "speaker": 29, "form": "dlg", "jp": "「どっちにしても説明するはずだったんだから\n　いい機会ね‥‥」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 280, "speaker": 29, "form": "dlg", "jp": "「お姉さん‥‥」"},
{"id": 281, "speaker": 29, "form": "dlg", "jp": "ジーンは『クリエーター』のこと、\n『Ｅ－ｇｒｏ』のことなどを簡単に説明した。"},
{"id": 282, "speaker": 3, "form": "dlg", "jp": "「‥‥‥‥‥」"},
{"id": 283, "speaker": 31, "form": "dlg", "jp": "「信じられない話だとは思いますが‥‥」"},
{"id": 284, "speaker": 3, "form": "dlg", "jp": "「いいえ、信じられる話だと思います‥‥」"},
{"id": 285, "speaker": 3, "form": "dlg", "jp": "「ただ、あまりにも恐ろしい話なので‥‥」"},
{"id": 286, "speaker": 29, "form": "dlg", "jp": "「そうですね‥‥」"},
{"id": 287, "speaker": 3, "form": "dlg", "jp": "「ねえ、ナゴムっ！」"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「なんだい、姉さん‥‥」"},
{"id": 289, "speaker": 3, "form": "dlg", "jp": "「今の話が本当なら‥‥」"},
{"id": 290, "speaker": 3, "form": "dlg", "jp": "「『人工衛星』にいた『シロー』も‥‥」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「たしかに！！」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「もしかして、『人工衛星』も『クリエーター』に！！」"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "「だから、『シロー』と連絡が取れなくなったとか‥‥」"},
{"id": 294, "speaker": 31, "form": "dlg", "jp": "「おい、その『人工衛星』って、\n　めちゃめちゃ攻撃力があるんじゃないのか？」"},
{"id": 295, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 296, "speaker": 29, "form": "dlg", "jp": "「ルードの工場を壊滅させたのを見たけど、\n　かなりの兵器ね‥‥」"},
{"id": 297, "speaker": 31, "form": "dlg", "jp": "「このアンドロイドは、\n　警察の拳銃でも制止できるけど‥‥」"},
{"id": 298, "speaker": 31, "form": "dlg", "jp": "「オレたちの中で、『宇宙』に行ける\n　能力のあるやつなんて‥‥」"},
{"id": 299, "speaker": 29, "form": "dlg", "jp": "「そんなの能力、聞いたことがないわね‥‥」"},
{"id": 300, "speaker": 31, "form": "dlg", "jp": "「おい、こんなアンドロイドより、\n　そっちの方をどうにかしておかないと‥‥」"},
{"id": 301, "speaker": 4, "form": "dlg", "jp": "「それなら大丈夫です！！」"},
{"id": 302, "speaker": 4, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "「‥‥‥！！」"},
{"id": 304, "speaker": 3, "form": "dlg", "jp": "「清田さん‥‥？」"},
{"id": 305, "speaker": 4, "form": "dlg", "jp": "「すみません、返事がなかったので\n　勝手に上がらせてもらいました‥‥」"},
{"id": 306, "speaker": 31, "form": "dlg", "jp": "「オ、オマエは！？」"},
{"id": 307, "speaker": 31, "form": "dlg", "jp": "「『清田』か？\n　それとも『ゴトウ』か？」"},
{"id": 308, "speaker": 4, "form": "dlg", "jp": "「ちょっと待ってください、『人違い』です‥‥」"},
{"id": 309, "speaker": 31, "form": "dlg", "jp": "「『人違い』だとぉ？」"},
{"id": 310, "speaker": 31, "form": "dlg", "jp": "「まさか『自分はシロー』だなんて\n　いいわけをするつもりじゃぁ？」"},
{"id": 311, "speaker": 4, "form": "dlg", "jp": "「そうです！\n　ボクは『シロー』です‥‥」"},
{"id": 312, "speaker": 31, "form": "dlg", "jp": "「タイミングが悪かったな？」"},
{"id": 313, "speaker": 31, "form": "dlg", "jp": "「『シローさん』なら、今テレビに生出演中だよ！」"},
{"id": 314, "speaker": 4, "form": "dlg", "jp": "「違います！！」"},
{"id": 315, "speaker": 4, "form": "dlg", "jp": "「ボクはリツコに育てられた方の\n　『シロー』なんです！！」"},
{"id": 316, "speaker": 35, "form": "dlg", "jp": "「つまり、『人工知能』の\n　『シロー』って言いたいの？」"},
{"id": 317, "speaker": 4, "form": "dlg", "jp": "「そ、そうです！！」"},
{"id": 318, "speaker": 35, "form": "dlg", "jp": "「ザ～ンネン‥‥」"},
{"id": 319, "speaker": 35, "form": "dlg", "jp": "「そっちの『シローさん』も\n　宇宙にいるって知ってるんだよ！」"},
{"id": 320, "speaker": 31, "form": "dlg", "jp": "「オカシなウソをつくってことは、\n　『ゴトウマサシ』だなぁ～～～！！」"},
{"id": 321, "speaker": 31, "form": "dlg", "jp": "「さあ、復讐に来たのか、\n　反省して仲間になりに来たのか」"},
{"id": 322, "speaker": 31, "form": "dlg", "jp": "「聞かせてもらおうじゃないか‥‥」"},
{"id": 323, "speaker": 31, "form": "dlg", "jp": "「返事次第では、今度こそ再起不能に‥‥」"},
{"id": 324, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って！！」"},
{"id": 325, "speaker": 29, "form": "dlg", "jp": "「あの状況から考えて、\n　『ゴトウ』が復活できるとは思えないわ！」"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "「たしかに‥‥」"},
{"id": 327, "speaker": 29, "form": "dlg", "jp": "「それに『清田』って人も、ああなった以上は‥‥」"},
{"id": 328, "speaker": 31, "form": "dlg", "jp": "「じゃぁ、コイツは誰なんだよ‥‥」"},
{"id": 329, "speaker": 31, "form": "dlg", "jp": "「まさか、『シロー』って話を信じてるんじゃぁ？」"},
{"id": 330, "speaker": 48, "form": "dlg", "jp": "「だから、『シロー』なんです！！」"},
{"id": 331, "speaker": 48, "form": "dlg", "jp": "「もちろん、少しは『清田ユウリ』の部分もありますが‥‥」"},
{"id": 332, "speaker": 31, "form": "dlg", "jp": "「だから、そんなわけないだろう！」"},
{"id": 333, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 334, "speaker": 29, "form": "dlg", "jp": "「どっちにしてもつじつまが合わないんだから、\n　話を聞くだけ聞きましょう‥‥」"},
{"id": 335, "speaker": 31, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 336, "speaker": 2, "form": "dlg", "jp": "「どういうことなのか、説明してくれる？」"},
{"id": 337, "speaker": 48, "form": "dlg", "jp": "「わかりました」"},
{"id": 338, "speaker": 48, "form": "dlg", "jp": "失敗の原因は『記憶力』と『情報処理能力』の問題。\n『説得するべき相手』は本当にそこにいたのか？"}
]
