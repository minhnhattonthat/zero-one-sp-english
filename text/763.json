[
{"id": 0, "speaker": null, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「コン、コン」"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 3, "speaker": 20, "form": "dlg", "jp": "「何か？」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「いえ、今戻ったんで‥‥」"},
{"id": 5, "speaker": 20, "form": "dlg", "jp": "「うん、わかったよ」"},
{"id": 6, "speaker": 20, "form": "dlg", "jp": "さてと、刑事さんたちのためにも、\nおとなしくしておいた方がよさそうだな‥‥"},
{"id": 7, "speaker": 20, "form": "dlg", "jp": "アレ？"},
{"id": 8, "speaker": 20, "form": "dlg", "jp": "刑事さんたちいないのかな？"},
{"id": 9, "speaker": 20, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 10, "speaker": 20, "form": "dlg", "jp": "となりの部屋のドアが開く音がした。"},
{"id": 11, "speaker": 20, "form": "dlg", "jp": "「バタン！」"},
{"id": 12, "speaker": 20, "form": "dlg", "jp": "そうか、ボクがいないから\n外に出てたんだな‥‥"},
{"id": 13, "speaker": 20, "form": "dlg", "jp": "とりあえず、戻って来たことを伝えておくか‥‥"},
{"id": 14, "speaker": 20, "form": "dlg", "jp": "「コン、コン」"},
{"id": 15, "speaker": 20, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 16, "speaker": 20, "form": "dlg", "jp": "「何か？」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「いえ、今戻ったんで‥‥」"},
{"id": 18, "speaker": 20, "form": "dlg", "jp": "「ああ、連絡があったよ‥‥」"},
{"id": 19, "speaker": 20, "form": "dlg", "jp": "「それでボクたちも戻って来たんだ」"},
{"id": 20, "speaker": 20, "form": "dlg", "jp": "「バタン！」"},
{"id": 21, "speaker": 20, "form": "dlg", "jp": "さてと、刑事さんたちのためにも、\nおとなしくしておいた方がよさそうだな‥‥"},
{"id": 22, "speaker": 20, "form": "dlg", "jp": "テレビでも見て時間でもつぶすか‥‥"},
{"id": 23, "speaker": 20, "form": "dlg", "jp": "ボクはリモコンを取るために\nサイドボードに手を伸ばした。"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥！」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「オマエヲコロス！」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "なんだ、この『メモ』は‥‥"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "いったい、いつの間に‥‥"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "とにかく、となりの刑事さんに\n知らせておくか‥‥"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "その時！！"},
{"id": 30, "speaker": 20, "form": "dlg", "jp": "「ウワァ～～～～～～っ！」"},
{"id": 31, "speaker": 20, "form": "dlg", "jp": "となりの部屋からだ！！"},
{"id": 32, "speaker": 20, "form": "dlg", "jp": "ボクはとなりの部屋のドアを開けた。"},
{"id": 33, "speaker": 20, "form": "dlg", "jp": "「ダメだ、こっちに来ちゃぁ！」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 35, "speaker": 4, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 36, "speaker": 4, "form": "dlg", "jp": "な、なんだコイツ！！"},
{"id": 37, "speaker": 20, "form": "dlg", "jp": "「『ルード』の『サイボーグ』だ！！」"},
{"id": 38, "speaker": 4, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 39, "speaker": 20, "form": "dlg", "jp": "「とにかく、逃げるんだ‥‥」"},
{"id": 40, "speaker": 20, "form": "dlg", "jp": "刑事さんはボクの手を引いて\n部屋の外へと連れ出した。"},
{"id": 41, "speaker": 20, "form": "dlg", "jp": "「バタン！」"},
{"id": 42, "speaker": 20, "form": "dlg", "jp": "「ちくしょう、いつの間に‥‥」"},
{"id": 43, "speaker": 20, "form": "dlg", "jp": "刑事さんも、まさか部屋の中にヤツらが\n侵入してくるとは思っていなかったようだ‥‥"},
{"id": 44, "speaker": 20, "form": "dlg", "jp": "ってことはどこに逃げても同じなのか‥‥"},
{"id": 45, "speaker": 20, "form": "choice", "jp": "「とにかく、逃げましょう！」"},
{"id": 46, "speaker": 20, "form": "choice", "jp": "「とにかく、警部さんたちに‥‥」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「とにかく、警部さんたちに‥‥」"},
{"id": 48, "speaker": 20, "form": "dlg", "jp": "「に、逃げないのかい？」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「相手は部屋にまで入り込んでくるヤツらです」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「どこへ逃げても同じです‥‥」"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "「それより‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「今なら、あの１人だけでも捕まえられるかも‥‥」"},
{"id": 53, "speaker": 20, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 54, "speaker": 20, "form": "dlg", "jp": "刑事さんは『無線』で警部たちに連絡を入れた。"},
{"id": 55, "speaker": 20, "form": "dlg", "jp": "それにしても‥‥\nあのサイボーグ、いっこうに出てくる気配が‥‥"},
{"id": 56, "speaker": 20, "form": "dlg", "jp": "いったい中で何をしてるんだ？"},
{"id": 57, "speaker": 20, "form": "dlg", "jp": "そこへ‥‥"},
{"id": 58, "speaker": 20, "form": "dlg", "jp": "「ドタドタドタドタ‥‥」"},
{"id": 59, "speaker": 20, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 60, "speaker": 11, "form": "dlg", "jp": "「『サイボーグ』が現れたんだって！？」"},
{"id": 61, "speaker": 20, "form": "dlg", "jp": "「はいっ！」"},
{"id": 62, "speaker": 20, "form": "dlg", "jp": "「長船刑事が殺されました‥‥」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「まだ、この部屋の中にいるはずです！」"},
{"id": 64, "speaker": 11, "form": "dlg", "jp": "「そうかっ！」"},
{"id": 65, "speaker": 21, "form": "dlg", "jp": "「大胆な連中ね‥‥」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「姉さんは大丈夫なんでしょうか？」"},
{"id": 67, "speaker": 11, "form": "dlg", "jp": "「今、調べさせている‥‥」"},
{"id": 68, "speaker": 12, "form": "dlg", "jp": "「ただいま、リツコさんの無事が確認されました！」"},
{"id": 69, "speaker": 11, "form": "dlg", "jp": "「うむ‥‥」"},
{"id": 70, "speaker": 21, "form": "dlg", "jp": "「そうでしょうね‥‥」"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "「そうでしょう？」"},
{"id": 72, "speaker": 21, "form": "dlg", "jp": "「ヤツらはドクタージョウコウジを\n　追い込むつもりよ‥‥」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「追い込む？」"},
{"id": 74, "speaker": 21, "form": "dlg", "jp": "「見つけられないから、\n　誘い出す作戦に切り替えたのよ」"},
{"id": 75, "speaker": 21, "form": "dlg", "jp": "「つまり、２人の子供のうち、１人を殺すことで」"},
{"id": 76, "speaker": 21, "form": "dlg", "jp": "「出てこないと、\n　もう１人の命も危ないと思わせる作戦ね‥‥」"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "「つまり‥‥」"},
{"id": 78, "speaker": 21, "form": "dlg", "jp": "「ルードはとりあえずキミから殺そうとしている」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥！！」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "なんてことだ‥‥"},
{"id": 81, "speaker": 21, "form": "dlg", "jp": "「もう大丈夫よ‥‥」"},
{"id": 82, "speaker": 21, "form": "dlg", "jp": "「とにかく、\n　この中のヤツをどうするのかが問題ね‥‥」"},
{"id": 83, "speaker": 11, "form": "dlg", "jp": "「どうします？」"},
{"id": 84, "speaker": 21, "form": "dlg", "jp": "「で、相手の武装は？」"},
{"id": 85, "speaker": 20, "form": "dlg", "jp": "「長船刑事は『刀』で‥‥」"},
{"id": 86, "speaker": 21, "form": "dlg", "jp": "「『刀』？」"},
{"id": 87, "speaker": 20, "form": "dlg", "jp": "「はい、『日本刀』のように見えましたが‥‥」"},
{"id": 88, "speaker": 21, "form": "dlg", "jp": "「もしかしたら、\n　長髪で色白のキモチわるいヤツじゃぁ？」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「そ、そうです‥‥！！」"},
{"id": 90, "speaker": 21, "form": "dlg", "jp": "「『カマキリ』ね‥‥」"},
{"id": 91, "speaker": 11, "form": "dlg", "jp": "「『カマキリ』？」"},
{"id": 92, "speaker": 21, "form": "dlg", "jp": "「『カマキリジャック』‥‥」"},
{"id": 93, "speaker": 21, "form": "dlg", "jp": "「『ルード』のサイコな殺し屋‥‥」"},
{"id": 94, "speaker": 21, "form": "dlg", "jp": "「刀で人を斬り付けるのが趣味の『変質者』よ！」"},
{"id": 95, "speaker": 21, "form": "dlg", "jp": "「ウワサでは\n　最近サイボーグ手術を受けたって‥‥」"},
{"id": 96, "speaker": 11, "form": "dlg", "jp": "「どうします？」"},
{"id": 97, "speaker": 21, "form": "dlg", "jp": "「いくら、『サイボーグ』でも、この最上階の窓から\n　飛び下りたりしないでしょう‥‥」"},
{"id": 98, "speaker": 21, "form": "dlg", "jp": "「とにかく、この部屋を包囲するのね！」"},
{"id": 99, "speaker": 21, "form": "dlg", "jp": "「アキヤマ！！」"},
{"id": 100, "speaker": 22, "form": "dlg", "jp": "「了解ですっ！」"},
{"id": 101, "speaker": 22, "form": "dlg", "jp": "こうして、この部屋は警察に包囲されることになった。"},
{"id": 102, "speaker": 22, "form": "dlg", "jp": "そして‥‥"},
{"id": 103, "speaker": 11, "form": "dlg", "jp": "「全然出てくる気配がありませんね‥‥」"},
{"id": 104, "speaker": 11, "form": "dlg", "jp": "「もしかしたら、もう逃げたのでは？」"},
{"id": 105, "speaker": 21, "form": "dlg", "jp": "「そんなわけないでしょう？」"},
{"id": 106, "speaker": 21, "form": "dlg", "jp": "「ここは『最上階』なのよ？」"},
{"id": 107, "speaker": 11, "form": "dlg", "jp": "「いえ、そうですけど\n　いざとなれば窓をつたって下の階とかへ‥‥」"},
{"id": 108, "speaker": 21, "form": "dlg", "jp": "「‥‥‥‥！」"},
{"id": 109, "speaker": 21, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 110, "speaker": 21, "form": "dlg", "jp": "「『突入』しましょう！」"},
{"id": 111, "speaker": 11, "form": "dlg", "jp": "「わかりましたっ！」"},
{"id": 112, "speaker": 11, "form": "dlg", "jp": "しびれをきらした警察は\n部屋に突入することになった。"},
{"id": 113, "speaker": 21, "form": "dlg", "jp": "「逃げられないわよっ！」"},
{"id": 114, "speaker": 21, "form": "dlg", "jp": "「カンネンしなさいっ！」"},
{"id": 115, "speaker": 21, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 116, "speaker": 21, "form": "dlg", "jp": "しかし‥‥"},
{"id": 117, "speaker": 11, "form": "dlg", "jp": "「ど、どういうことだ‥‥」"},
{"id": 118, "speaker": 11, "form": "dlg", "jp": "そこにあの『サイボーグ』の姿はなかった。"},
{"id": 119, "speaker": 21, "form": "dlg", "jp": "「いったいどこから逃げたの？」"},
{"id": 120, "speaker": 22, "form": "dlg", "jp": "「警視、窓が開けられた形せきはありません！」"},
{"id": 121, "speaker": 21, "form": "dlg", "jp": "「ベッドやクローゼットの中は？」"},
{"id": 122, "speaker": 22, "form": "dlg", "jp": "「はい、何も‥‥」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「そんなハズはありません！」"},
{"id": 124, "speaker": 11, "form": "dlg", "jp": "「ワレワレが来る前に\n　部屋から目をはなしたことは？」"},
{"id": 125, "speaker": 20, "form": "dlg", "jp": "「ありませんっ！」"},
{"id": 126, "speaker": 20, "form": "dlg", "jp": "「ずっと、ここで見張ってましたから‥‥」"},
{"id": 127, "speaker": 11, "form": "dlg", "jp": "「じゃあ、いったいどこに消えたんだぁ？」"},
{"id": 128, "speaker": 21, "form": "dlg", "jp": "「それより、いつソイツは入って来たの？」"},
{"id": 129, "speaker": 20, "form": "dlg", "jp": "「いつのまにか‥‥です」"},
{"id": 130, "speaker": 11, "form": "dlg", "jp": "「いつのまにか？」"},
{"id": 131, "speaker": 20, "form": "dlg", "jp": "「はい‥‥\n　とつぜん、ソファーの後ろから現れたんです！」"},
{"id": 132, "speaker": 21, "form": "dlg", "jp": "「スキをみて事前に侵入していたようね‥‥」"},
{"id": 133, "speaker": 21, "form": "dlg", "jp": "「アキヤマッ！！」"},
{"id": 134, "speaker": 22, "form": "dlg", "jp": "「ハッ！」"},
{"id": 135, "speaker": 21, "form": "dlg", "jp": "「フロントに『ドアの開閉記録』を確認して！」"},
{"id": 136, "speaker": 22, "form": "dlg", "jp": "「わかりました！」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「『ドアの開閉記録』？」"},
{"id": 138, "speaker": 11, "form": "dlg", "jp": "「この部屋は警護用にドアの開閉された時間が\n　フロントに記録されるんだよ‥‥」"},
{"id": 139, "speaker": 11, "form": "dlg", "jp": "「つまり、いつあの部屋に犯人が入ったか\n　特定することができるんだよ」"},
{"id": 140, "speaker": 11, "form": "dlg", "jp": "そして‥‥"},
{"id": 141, "speaker": 22, "form": "dlg", "jp": "「警視！」"},
{"id": 142, "speaker": 21, "form": "dlg", "jp": "「どうだった？」"},
{"id": 143, "speaker": 22, "form": "dlg", "jp": "「はい、それが‥‥」"},
{"id": 144, "speaker": 21, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 145, "speaker": 21, "form": "dlg", "jp": "『ドアの開閉記録』によると、\nボクたちのいた寝室側のドアは"},
{"id": 146, "speaker": 21, "form": "dlg", "jp": "ボクや姉さんの出入りした時にしか\n開けられておらず、"},
{"id": 147, "speaker": 21, "form": "dlg", "jp": "あちらの応接室側のドアも刑事さんたちが\n朝、出ていった以降は"},
{"id": 148, "speaker": 21, "form": "dlg", "jp": "さっき刑事さんが出入りしたあの時以外\n開閉した記録は残っていないという。"},
{"id": 149, "speaker": 21, "form": "dlg", "jp": "「ますます追い込まれたわね‥‥」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「追い込まれた？」"},
{"id": 151, "speaker": 21, "form": "dlg", "jp": "「間違いなくココには『殺し屋』がいる。\n　でも、その居場所はわからない‥‥」"},
{"id": 152, "speaker": 21, "form": "dlg", "jp": "「追い込まれたと言わずになんて言うの‥‥」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥」"},
{"id": 154, "speaker": 21, "form": "dlg", "jp": "「ねえ、本当にソイツはいたの？」"},
{"id": 155, "speaker": 20, "form": "dlg", "jp": "「ちょっと待ってください！」"},
{"id": 156, "speaker": 20, "form": "dlg", "jp": "「いたからこそ、長船刑事は‥‥」"},
{"id": 157, "speaker": 20, "form": "dlg", "jp": "「もしかして、私を疑ってるんですか？」"},
{"id": 158, "speaker": 11, "form": "dlg", "jp": "「そ、そうですよ！」"},
{"id": 159, "speaker": 21, "form": "dlg", "jp": "「疑ってるわ‥‥」"},
{"id": 160, "speaker": 21, "form": "dlg", "jp": "「ドアの開閉記録をみるかぎり、\n　アナタしか出入りした人間はいないのよ！」"},
{"id": 161, "speaker": 20, "form": "dlg", "jp": "「しかし‥‥」"},
{"id": 162, "speaker": 21, "form": "dlg", "jp": "「どうなのナゴムくん？」"},
{"id": 163, "speaker": 21, "form": "dlg", "jp": "「キミはその『殺し屋』を見たの？」"},
{"id": 164, "speaker": 21, "form": "choice", "jp": "「見ましたっ！」"},
{"id": 165, "speaker": 21, "form": "choice", "jp": "「見てません‥‥」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "「見ましたっ！」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「アレが『殺し屋』だったかどうかは\n　わかりませんが‥‥」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「たしかに長髪の刀を持った男を‥‥」"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "「見てません‥‥」"},
{"id": 170, "speaker": 20, "form": "dlg", "jp": "「オイっ！」"},
{"id": 171, "speaker": 20, "form": "dlg", "jp": "「キミもちゃんと見ただろう？」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「でも、アレが『殺し屋』だったかどうか‥‥」"},
{"id": 173, "speaker": 21, "form": "dlg", "jp": "「でも、あの部屋に第３者がいたのは見たのね？」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「はい‥‥」"},
{"id": 175, "speaker": 11, "form": "dlg", "jp": "「証人が２人もいるんでは、\n　ここにいたのは間違いないでしょうな‥‥」"},
{"id": 176, "speaker": 21, "form": "dlg", "jp": "「そうかしら‥‥」"},
{"id": 177, "speaker": 11, "form": "dlg", "jp": "「どうかしたんですか？」"},
{"id": 178, "speaker": 21, "form": "dlg", "jp": "「ちょっとオカシイとは思わない？」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「何がですか？」"},
{"id": 180, "speaker": 21, "form": "dlg", "jp": "「その『メモ』よ‥‥」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「『メモ』？」"},
{"id": 182, "speaker": 21, "form": "dlg", "jp": "「その『メモ』の通りなら、\n　キミを殺すはずでしょう？」"},
{"id": 183, "speaker": 21, "form": "dlg", "jp": "「どうして、オサフネを殺したの？」"},
{"id": 184, "speaker": 11, "form": "dlg", "jp": "「それはジャマだったからじゃぁないんですか？」"},
{"id": 185, "speaker": 21, "form": "dlg", "jp": "「じゃあ、どうしてオサフネを殺した後にでも\n　彼を殺そうとしなかったの？」"},
{"id": 186, "speaker": 21, "form": "dlg", "jp": "そういえば！"},
{"id": 187, "speaker": 21, "form": "dlg", "jp": "ボクは決して遠くに逃げたわけではない。"},
{"id": 188, "speaker": 21, "form": "dlg", "jp": "それどころか、\nアイツは追ってこようともしなかった。"},
{"id": 189, "speaker": 21, "form": "dlg", "jp": "「つまり、『何か』おかしいのよ‥‥」"},
{"id": 190, "speaker": 21, "form": "dlg", "jp": "「『ルード』はなんの目的で\n　彼を襲わなかったのか？」"},
{"id": 191, "speaker": 21, "form": "choice", "jp": "「よりボクを怖がらせるためじゃぁ？」"},
{"id": 192, "speaker": 21, "form": "choice", "jp": "「殺す必要がなかったからじゃぁ？」"},
{"id": 193, "speaker": 21, "form": "choice", "jp": "「刑事さんが抵抗してくれたからじゃぁ？」"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "「刑事さんが抵抗してくれたからじゃぁ？」"},
{"id": 195, "speaker": 21, "form": "dlg", "jp": "「刑事の１人や２人を恐れるヤツが\n　わざわざこんなとこに侵入してくると思う？」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「殺す必要がなかったからじゃぁ？」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「アイツらは父さんに圧力さえかけられれば\n　いいんだから、別に殺さなくても‥‥」"},
{"id": 198, "speaker": 21, "form": "dlg", "jp": "「でも、キミを殺した方がより圧力かかるんじゃない？」"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "「コワイこと言わないでくださいよ！」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "「よりボクを怖がらせるためじゃぁ？」"},
{"id": 201, "speaker": 21, "form": "dlg", "jp": "「キミはカン違いをしてるわね」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「はぁ？」"},
{"id": 203, "speaker": 21, "form": "dlg", "jp": "「キミを怖がらせても意味がないのよ」"},
{"id": 204, "speaker": 21, "form": "dlg", "jp": "「ドクタージョウコウジを怖がらせないと‥‥」"},
{"id": 205, "speaker": 21, "form": "dlg", "jp": "「そのためには、キミを殺した方が\n　効果的だと思わない？」"},
{"id": 206, "speaker": 2, "form": "dlg", "jp": "「コワイこと言わないでくださいよ！」"},
{"id": 207, "speaker": 20, "form": "dlg", "jp": "「しかし、ワレワレが襲われたのは事実です！」"},
{"id": 208, "speaker": 21, "form": "dlg", "jp": "「どうなのナゴムくん‥‥」"},
{"id": 209, "speaker": 21, "form": "dlg", "jp": "「キミは襲われたの？」"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 211, "speaker": 2, "form": "choice", "jp": "「ボクも襲われました！」"},
{"id": 212, "speaker": 2, "form": "choice", "jp": "「ボクは襲われていません‥‥」"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "「ボクは襲われていません‥‥」"},
{"id": 214, "speaker": 21, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥」"},
{"id": 215, "speaker": 21, "form": "dlg", "jp": "「なぜ、『ルード』はキミを殺さなかったのかな？」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「ちょっと、イヤなこと言わないでくださいよ！」"},
{"id": 217, "speaker": 21, "form": "dlg", "jp": "「あっ、ゴメンなさい‥‥」"},
{"id": 218, "speaker": 21, "form": "dlg", "jp": "「とにかく、『ルード』がこのホテルに\n　潜り込んでいることは間違いなさそうね‥‥」"},
{"id": 219, "speaker": 21, "form": "dlg", "jp": "「さらに警備をゲンジュウにしましょう！」"},
{"id": 220, "speaker": 21, "form": "dlg", "jp": "「とにかく、\n　アナタたちには別の部屋を用意します」"},
{"id": 221, "speaker": 21, "form": "dlg", "jp": "「後は館内に不審な人物が出入りしてないか\n　もう一度洗い直しを‥‥」"},
{"id": 222, "speaker": 22, "form": "dlg", "jp": "「わかりました！」"},
{"id": 223, "speaker": 22, "form": "dlg", "jp": "こうして、ボクたちは別の部屋に移ることになった。"},
{"id": 224, "speaker": 22, "form": "dlg", "jp": "警察は新しくほぼ同じような\nセミスイートの部屋を用意してくれた"},
{"id": 225, "speaker": 22, "form": "dlg", "jp": "そして、戻って来た姉さんとボクは\nさっそくコッチの部屋へ移動した。"},
{"id": 226, "speaker": 22, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥）"},
{"id": 227, "speaker": 22, "form": "choice", "jp": "【調べる】"},
{"id": 228, "speaker": 22, "form": "choice", "jp": "【話す】"},
{"id": 229, "speaker": 22, "form": "dlg", "jp": "【調べる】"},
{"id": 230, "speaker": 22, "form": "dlg", "jp": "ボクはとりあえず部屋を調べることにした。"},
{"id": 231, "speaker": 22, "form": "dlg", "jp": "部屋はさっきまでの部屋と全く同じつくりだ‥‥"},
{"id": 232, "speaker": 22, "form": "choice", "jp": "【調べる】"},
{"id": 233, "speaker": 22, "form": "choice", "jp": "【話す】"},
{"id": 234, "speaker": 22, "form": "dlg", "jp": "【調べる】"},
{"id": 235, "speaker": 22, "form": "dlg", "jp": "ボクは念のため\nもう一度部屋を調べることにした。"},
{"id": 236, "speaker": 3, "form": "dlg", "jp": "「どうしたの？」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「念のため部屋を調べておこうかと‥‥」"},
{"id": 238, "speaker": 3, "form": "dlg", "jp": "「前の部屋とそんなに変わらないわね‥‥」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「今度も隣には刑事さんたちが待機してるし‥‥」"},
{"id": 241, "speaker": 3, "form": "dlg", "jp": "「昼間はそれでも襲われたんでしょう？」"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "【話す】"},
{"id": 244, "speaker": 3, "form": "dlg", "jp": "「前の部屋とそんなに変わらないわね‥‥」"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "「同じだよ‥‥」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「今度も隣には刑事さんたちが待機してるし‥‥」"},
{"id": 247, "speaker": 3, "form": "dlg", "jp": "「昼間はそれでも襲われたんでしょう？」"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 249, "speaker": 2, "form": "choice", "jp": "【聞く】"},
{"id": 250, "speaker": 2, "form": "choice", "jp": "【話す】"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "【話す】"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "ボクは姉さんに\n襲われた時のことを詳しく話した。"},
{"id": 253, "speaker": 3, "form": "dlg", "jp": "「不思議な話ねぇ‥‥」"},
{"id": 254, "speaker": 3, "form": "dlg", "jp": "「何度聞いても不思議な話ねぇ‥‥」"},
{"id": 255, "speaker": 3, "form": "dlg", "jp": "【聞く】"},
{"id": 256, "speaker": 3, "form": "choice", "jp": "「警察のことコワクないのかな？」"},
{"id": 257, "speaker": 3, "form": "choice", "jp": "「姉さんは本当に大丈夫だったの？」"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "「警察のことコワクないのかな？」"},
{"id": 259, "speaker": 3, "form": "dlg", "jp": "「まあ、昨日のサイボーグもそうだったし‥‥」"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 261, "speaker": 2, "form": "choice", "jp": "【聞く】"},
{"id": 262, "speaker": 2, "form": "choice", "jp": "【話す】"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "【聞く】"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "「姉さんは本当に大丈夫だったの？」"},
{"id": 265, "speaker": 3, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "「姉さんも気をつけた方がいいよ‥‥」"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "「アイツらは警察がいてもへっちゃらみたいだし‥‥」"},
{"id": 268, "speaker": 3, "form": "dlg", "jp": "「でも、そんな恐いもの知らずの連中が\n　どうしてナゴムを殺さなかったのかしら？」"},
{"id": 269, "speaker": 2, "form": "dlg", "jp": "「姉さんまで、そんなこと言うんだ！」"},
{"id": 270, "speaker": 3, "form": "dlg", "jp": "「だって、やっぱりおかしいじゃない？」"},
{"id": 271, "speaker": 2, "form": "dlg", "jp": "「そうかな‥‥」"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "「それより、どうなの研究発表の準備は？」"},
{"id": 273, "speaker": 3, "form": "dlg", "jp": "「資料の方はどうにかなりそうなんだけど‥‥」"},
{"id": 274, "speaker": 3, "form": "dlg", "jp": "「発表には自信が‥‥」"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "「やっぱり、キンチョウするの？」"},
{"id": 276, "speaker": 3, "form": "dlg", "jp": "「そりゃそうよ！」"},
{"id": 277, "speaker": 3, "form": "dlg", "jp": "「大ぜいの人の前で発表するのよ、\n　プロジェクターとか使って‥‥」"},
{"id": 278, "speaker": 3, "form": "dlg", "jp": "「それも、最新式の『立体プロジェクター』よ‥‥」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "「『立体プロジェクター』？」"},
{"id": 280, "speaker": 3, "form": "dlg", "jp": "「そう、メガネなしで、立体に見えるの！」"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "「へぇ～～～～」"},
{"id": 282, "speaker": 2, "form": "choice", "jp": "【聞く】"},
{"id": 283, "speaker": 2, "form": "choice", "jp": "【話す】"},
{"id": 284, "speaker": 2, "form": "dlg", "jp": "【話す】"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "「目の前で人が殺される方が\n　キンチョウするけどね‥‥」"},
{"id": 286, "speaker": 3, "form": "dlg", "jp": "「そうでしょうね‥‥」"},
{"id": 287, "speaker": 3, "form": "dlg", "jp": "「それにくらべたら私の方は‥‥」"},
{"id": 288, "speaker": 3, "form": "dlg", "jp": "「何度も言うってことは\n　それだけ恐かったのね‥‥」"},
{"id": 289, "speaker": 3, "form": "dlg", "jp": "【聞く】"},
{"id": 290, "speaker": 3, "form": "choice", "jp": "「そんなにキンチョウするの？」"},
{"id": 291, "speaker": 3, "form": "choice", "jp": "「そんなにスゴイ、プロジェクターなの？」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「そんなにキンチョウするの？」"},
{"id": 293, "speaker": 3, "form": "dlg", "jp": "「スゴクするわよ！！」"},
{"id": 294, "speaker": 3, "form": "choice", "jp": "【聞く】"},
{"id": 295, "speaker": 3, "form": "choice", "jp": "【話す】"},
{"id": 296, "speaker": 3, "form": "dlg", "jp": "【聞く】"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "「そんなにスゴイ、プロジェクターなの？」"},
{"id": 298, "speaker": 3, "form": "dlg", "jp": "「スゴイわよ、ほんとに目の前に\n　人間がいるみたいに見えるんだから‥‥」"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "「『人間がいるみたいに見える』！？」"},
{"id": 300, "speaker": 3, "form": "dlg", "jp": "「そうよ！」"},
{"id": 301, "speaker": 3, "form": "dlg", "jp": "「まあ、そんなことより\n　その殺人犯の方が心配よね‥‥」"},
{"id": 302, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "「アイツはきっとボクたちの事を狙ってるだろうし‥‥」"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「コン、コン」"},
{"id": 306, "speaker": 3, "form": "dlg", "jp": "「ハイ！」"},
{"id": 307, "speaker": 11, "form": "dlg", "jp": "「失礼します‥‥」"},
{"id": 308, "speaker": 11, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 309, "speaker": 3, "form": "dlg", "jp": "「なんでしょうか？」"},
{"id": 310, "speaker": 21, "form": "dlg", "jp": "「ナゴムくんに、さっきの事件のことを\n　もう一度詳しく説明してもらおうと思ってね」"},
{"id": 311, "speaker": 21, "form": "dlg", "jp": "「かまわないわね？」"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "こうして、ボクはもう一度刑事さんたちに\nあの『殺し屋』の話をすることになった。"},
{"id": 314, "speaker": 11, "form": "dlg", "jp": "「どうも、ウチの若いヤツの言うことが\n　ぜんぜんあてにならないんでね‥‥」"},
{"id": 315, "speaker": 20, "form": "dlg", "jp": "「そんなぁ～～」"},
{"id": 316, "speaker": 21, "form": "dlg", "jp": "「バカらしい‥‥」"},
{"id": 317, "speaker": 21, "form": "dlg", "jp": "「人間が消えるなんて‥‥」"},
{"id": 318, "speaker": 2, "form": "dlg", "jp": "「消えたかどうかはわかりませんが\n　あの部屋にはもう１人男の人がいました」"},
{"id": 319, "speaker": 11, "form": "dlg", "jp": "「本当にいたのかい？」"},
{"id": 320, "speaker": 11, "form": "choice", "jp": "「間違いなくいました」"},
{"id": 321, "speaker": 11, "form": "choice", "jp": "「いなかったかもしれません」"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "「間違いなくいました」"},
{"id": 323, "speaker": 20, "form": "dlg", "jp": "「だから、言ったでしょう！」"},
{"id": 324, "speaker": 21, "form": "dlg", "jp": "「じゃあ、アナタたちはその『カマキリ』が\n　ニンジャみたいに消えたと？」"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "「いえ、ボクは『消えた』とは言ってません！」"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "「ただ‥‥」"},
{"id": 327, "speaker": 2, "form": "choice", "jp": "「本当にボクは見たんです！」"},
{"id": 328, "speaker": 2, "form": "choice", "jp": "「いたように見えてただけかも‥‥」"},
{"id": 329, "speaker": 2, "form": "dlg", "jp": "「本当にボクは見たんです！」"},
{"id": 330, "speaker": 2, "form": "dlg", "jp": "「いなかったかもしれません」"},
{"id": 331, "speaker": 20, "form": "dlg", "jp": "「オイ、ウソをつくなよ！」"},
{"id": 332, "speaker": 2, "form": "dlg", "jp": "「人間が突然消えるなんて考えられないし‥‥」"},
{"id": 333, "speaker": 2, "form": "choice", "jp": "「いなかったのかもしれませんよ‥‥」"},
{"id": 334, "speaker": 2, "form": "choice", "jp": "「いたように見えてただけかも‥‥」"},
{"id": 335, "speaker": 2, "form": "dlg", "jp": "「いなかったのかもしれませんよ‥‥」"},
{"id": 336, "speaker": 20, "form": "dlg", "jp": "「でも、キミも見ただろう？」"},
{"id": 337, "speaker": 2, "form": "dlg", "jp": "「２人ともが錯覚を見たってことは？」"},
{"id": 338, "speaker": 2, "form": "dlg", "jp": "その時！"},
{"id": 339, "speaker": 23, "form": "dlg", "jp": "「失礼します！」"},
{"id": 340, "speaker": 11, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 341, "speaker": 23, "form": "dlg", "jp": "「インターポールの保管していた\n　『カマキリ』の指紋と同じものが」"},
{"id": 342, "speaker": 23, "form": "dlg", "jp": "「現場から発見されました！」"},
{"id": 343, "speaker": 11, "form": "dlg", "jp": "「なんだって！」"},
{"id": 344, "speaker": 21, "form": "dlg", "jp": "「やはり、\n　あの部屋には『カマキリ』がいたということね‥‥」"},
{"id": 345, "speaker": 21, "form": "dlg", "jp": "「後は館内に不審な人物が出入りしてないか\n　もう一度洗い直しを！！」"},
{"id": 346, "speaker": 21, "form": "dlg", "jp": "警視たちはあわただしく部屋を出ていった。"},
{"id": 347, "speaker": 3, "form": "dlg", "jp": "「刑事さんたちも、大変ね‥‥」"},
{"id": 348, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 349, "speaker": 2, "form": "dlg", "jp": "「命を狙われてるボクたちの方がもっと大変だよ‥‥」"},
{"id": 350, "speaker": 3, "form": "dlg", "jp": "「まあ、そうね‥‥」"},
{"id": 351, "speaker": 3, "form": "dlg", "jp": "その時！！"},
{"id": 352, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 353, "speaker": 3, "form": "dlg", "jp": "背後でドアが開く音が鳴り響いた。"},
{"id": 354, "speaker": 3, "form": "dlg", "jp": "「ナゴムッ！！」"},
{"id": 355, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 356, "speaker": 2, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 357, "speaker": 2, "form": "dlg", "jp": "ボクは何が起きたのかまったく理解ができなかった。"},
{"id": 358, "speaker": 2, "form": "dlg", "jp": "理解どころか意識すら遠くなって行く‥‥"},
{"id": 359, "speaker": 2, "form": "dlg", "jp": "「いたように見えてただけかも‥‥」"},
{"id": 360, "speaker": 11, "form": "dlg", "jp": "「『いたように見えた』‥‥？？」"},
{"id": 361, "speaker": 2, "form": "dlg", "jp": "「アレ、さっきも姉さんと、\n　そんな話してたような‥‥」"},
{"id": 362, "speaker": 3, "form": "dlg", "jp": "「『プロジェクター』の話でしょう？」"},
{"id": 363, "speaker": 2, "form": "dlg", "jp": "「あっ、そうか！」"},
{"id": 364, "speaker": 2, "form": "dlg", "jp": "さっき、姉さんが『最新式のプロジェクター』の\n『立体映像』の話で"},
{"id": 365, "speaker": 2, "form": "dlg", "jp": "まるで目の前に人がいるみたいに見えるって‥‥"},
{"id": 366, "speaker": 2, "form": "dlg", "jp": "‥‥！？"},
{"id": 367, "speaker": 2, "form": "dlg", "jp": "もしかして、昼間の『殺し屋』も\n『立体映像』なんじゃ！！"},
{"id": 368, "speaker": 3, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 369, "speaker": 3, "form": "choice", "jp": "【きっとそうだ！】"},
{"id": 370, "speaker": 3, "form": "choice", "jp": "【いや、そんなバカな‥‥】"},
{"id": 371, "speaker": 3, "form": "dlg", "jp": "【きっとそうだ！】"},
{"id": 372, "speaker": 3, "form": "dlg", "jp": "たしかに『立体映像』なら、\n簡単に消えることはできる！"},
{"id": 373, "speaker": 3, "form": "dlg", "jp": "それに、ボクに襲ってこなかった理由も！！"},
{"id": 374, "speaker": 11, "form": "dlg", "jp": "「どうかしたのかい？」"},
{"id": 375, "speaker": 2, "form": "dlg", "jp": "「あの『殺し屋』の正体がわかったんです！」"},
{"id": 376, "speaker": 21, "form": "dlg", "jp": "「ほんと！？」"},
{"id": 377, "speaker": 2, "form": "dlg", "jp": "「本当です！！」"},
{"id": 378, "speaker": 21, "form": "dlg", "jp": "「わかったわ、参考までに聞かせてもらうわ‥‥」"},
{"id": 379, "speaker": 2, "form": "dlg", "jp": "「アリガトウゴザイマス‥‥」"},
{"id": 380, "speaker": 21, "form": "dlg", "jp": "「で、キミの言う『正体』って？」"},
{"id": 381, "speaker": 2, "form": "dlg", "jp": "「ハイ、それは‥‥」"},
{"id": 382, "speaker": 2, "form": "dlg", "jp": "「『立体映像』です‥‥」"},
{"id": 383, "speaker": 11, "form": "dlg", "jp": "「『立体映像』？」"},
{"id": 384, "speaker": 2, "form": "dlg", "jp": "「そうです！」"},
{"id": 385, "speaker": 2, "form": "dlg", "jp": "「だから、アイツはボクたちを襲って来なかったし、\n　急に姿を消すことができたんです‥‥」"},
{"id": 386, "speaker": 11, "form": "dlg", "jp": "「マンガじゃあるまいし‥‥」"},
{"id": 387, "speaker": 20, "form": "dlg", "jp": "「キミはアレがそんな風に見えたのかい？」"},
{"id": 388, "speaker": 2, "form": "dlg", "jp": "「ボクにはそうは見えませんでした‥‥」"},
{"id": 389, "speaker": 2, "form": "dlg", "jp": "「でも、『人間がいるみたいに見える』\n　『立体プロジェクター』があるらしいんです！」"},
{"id": 390, "speaker": 21, "form": "dlg", "jp": "「『立体映像』ってのは信じてあげてもいいけど」"},
{"id": 391, "speaker": 21, "form": "dlg", "jp": "「どうやって彼を殺したの？」"},
{"id": 392, "speaker": 21, "form": "dlg", "jp": "「ただの『映像』が‥‥」"},
{"id": 393, "speaker": 11, "form": "dlg", "jp": "「そ、そうですよ！」"},
{"id": 394, "speaker": 2, "form": "dlg", "jp": "「たぶん‥‥」"},
{"id": 395, "speaker": 2, "form": "choice", "jp": "「『立体映像』では殺人はムリです！」"},
{"id": 396, "speaker": 2, "form": "choice", "jp": "「『レーザー光線』で‥‥」"},
{"id": 397, "speaker": 2, "form": "dlg", "jp": "「『立体映像』では殺人はムリです！」"},
{"id": 398, "speaker": 11, "form": "dlg", "jp": "「ハァ？」"},
{"id": 399, "speaker": 2, "form": "dlg", "jp": "「つまり、『殺人』は別の人間がやったんです！」"},
{"id": 400, "speaker": 11, "form": "dlg", "jp": "「それはいったい！？」"},
{"id": 401, "speaker": 2, "form": "dlg", "jp": "「本名は知りませんが‥‥\n　たぶん『カマキリ』っていう『殺し屋』」"},
{"id": 402, "speaker": 11, "form": "dlg", "jp": "「ちょっと待てよ！」"},
{"id": 403, "speaker": 11, "form": "dlg", "jp": "「『カマキリ』って『立体映像』なんだろう？」"},
{"id": 404, "speaker": 2, "form": "dlg", "jp": "「はい、ボクが見た方は‥‥」"},
{"id": 405, "speaker": 21, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 406, "speaker": 2, "form": "dlg", "jp": "「ボクが見た\n　『襲ってこないカマキリ』は『立体映像』で‥‥」"},
{"id": 407, "speaker": 2, "form": "dlg", "jp": "「『殺人』をしたのは『本物のカマキリ』！！」"},
{"id": 408, "speaker": 21, "form": "dlg", "jp": "「本物の！？」"},
{"id": 409, "speaker": 2, "form": "dlg", "jp": "「たとえ『立体映像』でも、\n　投射する『プロジェクター』が必要になります」"},
{"id": 410, "speaker": 2, "form": "dlg", "jp": "「つまり、『プロジェクター』を操っていたのが\n　『本物のカマキリ』！！」"},
{"id": 411, "speaker": 11, "form": "dlg", "jp": "「それって、もしかして‥‥」"},
{"id": 412, "speaker": 2, "form": "dlg", "jp": "「そうです‥‥」"},
{"id": 413, "speaker": 2, "form": "dlg", "jp": "「あの時それができたのはただ１人！！」"},
{"id": 414, "speaker": 2, "form": "dlg", "jp": "「刑事さんアンタだっ！」"},
{"id": 415, "speaker": 20, "form": "dlg", "jp": "「ふっふふふふふふ‥‥」"},
{"id": 416, "speaker": 20, "form": "dlg", "jp": "「まさか、『立体映像』がバレるとは‥‥」"},
{"id": 417, "speaker": 24, "form": "dlg", "jp": "「ウヒャヒャヒャヒャヒャ‥」"},
{"id": 418, "speaker": 21, "form": "dlg", "jp": "「オノレっ！」"},
{"id": 419, "speaker": 2, "form": "dlg", "jp": "「きっと本物の刑事さんは\n　この部屋を出たときにすでに‥‥」"},
{"id": 420, "speaker": 24, "form": "dlg", "jp": "「そうさ‥‥」"},
{"id": 421, "speaker": 24, "form": "dlg", "jp": "「切り刻んでやったよ‥‥」"},
{"id": 422, "speaker": 21, "form": "dlg", "jp": "「動かないでっ！」"},
{"id": 423, "speaker": 24, "form": "dlg", "jp": "「拳銃か‥‥」"},
{"id": 424, "speaker": 24, "form": "dlg", "jp": "「サイボーグの\n　オレにそのオドシが通用すると思ってるのか？」"},
{"id": 425, "speaker": 21, "form": "dlg", "jp": "「くらえッ！」"},
{"id": 426, "speaker": 21, "form": "dlg", "jp": "「バキューン！」"},
{"id": 427, "speaker": 21, "form": "dlg", "jp": "しかし、カマキリは素早い動きで\n銃弾をかわし、姉さんを引き寄せた。"},
{"id": 428, "speaker": 2, "form": "dlg", "jp": "「姉さんっ！」"},
{"id": 429, "speaker": 24, "form": "dlg", "jp": "「動体視力も改造してんだよっ！」"},
{"id": 430, "speaker": 24, "form": "dlg", "jp": "「あきらめなっ！」"},
{"id": 431, "speaker": 11, "form": "dlg", "jp": "「ぐむむむむ‥‥」"},
{"id": 432, "speaker": 24, "form": "dlg", "jp": "「わかっただろう？」"},
{"id": 433, "speaker": 24, "form": "dlg", "jp": "「オマエたちを\n　切り刻むのなんてあっという間だ‥‥」"},
{"id": 434, "speaker": 24, "form": "dlg", "jp": "「これ以上『肉片』をふやしたくなかったら\n　おとなしくしておくんだな‥‥」"},
{"id": 435, "speaker": 2, "form": "dlg", "jp": "「ちくしょう！」"},
{"id": 436, "speaker": 24, "form": "dlg", "jp": "「じゃあ、この女はもらって行くぜ！」"},
{"id": 437, "speaker": 2, "form": "dlg", "jp": "「姉さんっ！」"},
{"id": 438, "speaker": 2, "form": "dlg", "jp": "ボクは姉さんを追って飛び出した。"},
{"id": 439, "speaker": 3, "form": "dlg", "jp": "「ナゴム！\n　ダメよ、大人しくして‥‥」"},
{"id": 440, "speaker": 2, "form": "dlg", "jp": "「ちくしょうっ！」"},
{"id": 441, "speaker": 2, "form": "dlg", "jp": "「『レーザー光線』で‥‥」"},
{"id": 442, "speaker": 11, "form": "dlg", "jp": "「『レーザー光線』？」"},
{"id": 443, "speaker": 2, "form": "dlg", "jp": "「そうです！」"},
{"id": 444, "speaker": 2, "form": "dlg", "jp": "「『立体映像』を投射する『プロジェクター』から、\n　『レーザー光線』を発射して‥‥」"},
{"id": 445, "speaker": 21, "form": "dlg", "jp": "「マンガの読みすぎね‥‥」"},
{"id": 446, "speaker": 21, "form": "dlg", "jp": "「『検死』の結果、\n　『エイリな刃物』って答えが出てるの‥‥」"},
{"id": 447, "speaker": 2, "form": "dlg", "jp": "「そうなんですか‥‥」"},
{"id": 448, "speaker": 21, "form": "dlg", "jp": "「そうなの‥‥」"},
{"id": 449, "speaker": 21, "form": "dlg", "jp": "「とにかく、\n　子供の探偵ゴッコにつきあってるヒマはないの」"},
{"id": 450, "speaker": 2, "form": "dlg", "jp": "「すみません‥‥」"},
{"id": 451, "speaker": 11, "form": "dlg", "jp": "「とにかく、ゲンジュウな警備体制をしくから\n　あとはワレワレにまかせなさい‥‥」"},
{"id": 452, "speaker": 2, "form": "dlg", "jp": "「ハァ‥‥」"},
{"id": 453, "speaker": 2, "form": "dlg", "jp": "こうして、みんなは持ち場へ戻って行った。"},
{"id": 454, "speaker": 3, "form": "dlg", "jp": "「もう‥‥」"},
{"id": 455, "speaker": 3, "form": "dlg", "jp": "「バカなんだから‥‥」"},
{"id": 456, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 457, "speaker": 3, "form": "dlg", "jp": "「『立体映像』が『殺人』なんて\n　できるわけないでしょう‥‥」"},
{"id": 458, "speaker": 3, "form": "dlg", "jp": "その時！！"},
{"id": 459, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 460, "speaker": 3, "form": "dlg", "jp": "背後でドアが開く音が鳴り響いた。"},
{"id": 461, "speaker": 3, "form": "dlg", "jp": "「ナゴムッ！！」"},
{"id": 462, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 463, "speaker": 2, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 464, "speaker": 2, "form": "dlg", "jp": "ボクは何が起きたのかまったく理解ができなかった。"},
{"id": 465, "speaker": 2, "form": "dlg", "jp": "理解どころか意識すら遠くなって行く‥‥"},
{"id": 466, "speaker": 2, "form": "dlg", "jp": "【いや、そんなバカな‥‥】"},
{"id": 467, "speaker": 2, "form": "dlg", "jp": "たしかに『立体映像』なら、\n簡単に消えることはできるだろうけど、"},
{"id": 468, "speaker": 2, "form": "dlg", "jp": "『人殺し』をすることなんてできないよな‥‥"},
{"id": 469, "speaker": 11, "form": "dlg", "jp": "「どうかしたのかい？」"},
{"id": 470, "speaker": 2, "form": "dlg", "jp": "「いえ、なんでもありません‥‥」"},
{"id": 471, "speaker": 2, "form": "dlg", "jp": "こうして、事情聴取は１時間ほど続いた。"},
{"id": 472, "speaker": 2, "form": "dlg", "jp": "しかし、ボクの意見からは\n何も手がかりを見つけることはできず"},
{"id": 473, "speaker": 2, "form": "dlg", "jp": "警視たちはあきらめて部屋を出て行ってまった。"},
{"id": 474, "speaker": 3, "form": "dlg", "jp": "「刑事さんたちも、大変みたいね‥‥」"},
{"id": 475, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 476, "speaker": 2, "form": "dlg", "jp": "「命を狙われてるボクたちの方がもっと大変だよ‥‥」"},
{"id": 477, "speaker": 3, "form": "dlg", "jp": "「まあ、そうね‥‥」"},
{"id": 478, "speaker": 3, "form": "dlg", "jp": "その時！！"},
{"id": 479, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 480, "speaker": 3, "form": "dlg", "jp": "背後でドアが開く音が鳴り響いた。"},
{"id": 481, "speaker": 3, "form": "dlg", "jp": "「ナゴムッ！！」"},
{"id": 482, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 483, "speaker": 2, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 484, "speaker": 2, "form": "dlg", "jp": "ボクは何が起きたのかまったく理解ができなかった。"},
{"id": 485, "speaker": 2, "form": "dlg", "jp": "理解どころか意識すら遠くなって行く‥‥"},
{"id": 486, "speaker": 2, "form": "dlg", "jp": "「ボクも襲われました！」"},
{"id": 487, "speaker": 2, "form": "dlg", "jp": "「アイツはボクを殺しに来たんです！！」"},
{"id": 488, "speaker": 2, "form": "dlg", "jp": "「この『メモ』がなによりの証拠です！」"},
{"id": 489, "speaker": 11, "form": "dlg", "jp": "「彼はすでに『ルード』に襲われてるんです。\n　とてもウソをついてるとは‥‥」"},
{"id": 490, "speaker": 21, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 491, "speaker": 21, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 492, "speaker": 21, "form": "dlg", "jp": "「とにかく、『ルード』がこのホテルに\n　潜り込んでいることは間違いなさそうね‥‥」"},
{"id": 493, "speaker": 21, "form": "dlg", "jp": "「さらに警備をゲンジュウにしましょう！」"},
{"id": 494, "speaker": 21, "form": "dlg", "jp": "「とにかく、\n　アナタたちには別の部屋を用意します」"},
{"id": 495, "speaker": 21, "form": "dlg", "jp": "「後は館内に不審な人物が出入りしてないか\n　もう一度洗い直しを‥‥」"},
{"id": 496, "speaker": 22, "form": "dlg", "jp": "「わかりました！」"},
{"id": 497, "speaker": 22, "form": "dlg", "jp": "こうして、ボクたちは別の部屋に移ることになった。"},
{"id": 498, "speaker": 3, "form": "dlg", "jp": "「前の部屋とそんなに変わらないわね‥‥」"},
{"id": 499, "speaker": 2, "form": "dlg", "jp": "「同じだよ‥‥」"},
{"id": 500, "speaker": 2, "form": "dlg", "jp": "「今度も隣には刑事さんたちが待機してるし‥‥」"},
{"id": 501, "speaker": 3, "form": "dlg", "jp": "「昼間はそれでも襲われたんでしょう？」"},
{"id": 502, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 503, "speaker": 2, "form": "dlg", "jp": "「ねえさんは本当に大丈夫だったの？」"},
{"id": 504, "speaker": 3, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 505, "speaker": 3, "form": "dlg", "jp": "「まだ、このホテルに犯人はいるんでしょ？」"},
{"id": 506, "speaker": 2, "form": "dlg", "jp": "「たぶんね‥‥」"},
{"id": 507, "speaker": 3, "form": "dlg", "jp": "「それなのにまだこのホテルにいなきゃいけないの？」"},
{"id": 508, "speaker": 3, "form": "dlg", "jp": "「危なくない？」"},
{"id": 509, "speaker": 2, "form": "dlg", "jp": "「なんでも、\n　さらにゲンジュウな警備体制をとるって‥‥」"},
{"id": 510, "speaker": 3, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 511, "speaker": 3, "form": "dlg", "jp": "その時！！"},
{"id": 512, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 513, "speaker": 3, "form": "dlg", "jp": "背後でドアが開く音が鳴り響いた。"},
{"id": 514, "speaker": 3, "form": "dlg", "jp": "「ナゴムッ！！」"},
{"id": 515, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 516, "speaker": 2, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 517, "speaker": 2, "form": "dlg", "jp": "ボクは何が起きたのかまったく理解ができなかった。"},
{"id": 518, "speaker": 2, "form": "dlg", "jp": "理解どころか意識すら遠くなって行く‥‥"},
{"id": 519, "speaker": 2, "form": "dlg", "jp": "「とにかく、逃げましょう！」"},
{"id": 520, "speaker": 20, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 521, "speaker": 20, "form": "dlg", "jp": "ボクたちは部屋から離れることにした。"},
{"id": 522, "speaker": 20, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 523, "speaker": 2, "form": "dlg", "jp": "「しかし、アイツはいつの間に\n　あの部屋に侵入したんでしょうか？」"},
{"id": 524, "speaker": 20, "form": "dlg", "jp": "「たぶん、このホテルには何人もの工作員が‥‥」"},
{"id": 525, "speaker": 2, "form": "dlg", "jp": "「そんな！！」"},
{"id": 526, "speaker": 2, "form": "dlg", "jp": "「じゃあ、\n　どこに逃げても危ないってことですか‥‥」"},
{"id": 527, "speaker": 4, "form": "dlg", "jp": "「その通りだよ‥‥」"},
{"id": 528, "speaker": 4, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 529, "speaker": 4, "form": "dlg", "jp": "ボクは何が起きたのかまったく理解ができなかった。"},
{"id": 530, "speaker": 4, "form": "dlg", "jp": "理解どころか意識すら遠くなって行く‥‥"},
{"id": 531, "speaker": 4, "form": "dlg", "jp": "さて、どうしようかな？"},
{"id": 532, "speaker": 4, "form": "choice", "jp": "【話す】"},
{"id": 533, "speaker": 4, "form": "choice", "jp": "【電話】"},
{"id": 534, "speaker": 4, "form": "dlg", "jp": "【話す】"},
{"id": 535, "speaker": 4, "form": "dlg", "jp": "って、話す相手なんていないし‥‥"},
{"id": 536, "speaker": 4, "form": "dlg", "jp": "【電話】"},
{"id": 537, "speaker": 4, "form": "dlg", "jp": "そうだ‥‥"},
{"id": 538, "speaker": 4, "form": "dlg", "jp": "出口に部屋番号を教えてやるんだった‥‥"},
{"id": 539, "speaker": 4, "form": "dlg", "jp": "ボクは備え付けの電話の内線で\n出口エイジの部屋に連絡することにした。"},
{"id": 540, "speaker": 4, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 541, "speaker": 4, "form": "dlg", "jp": "「ピッ、ピッ、ピッ‥‥」"},
{"id": 542, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 543, "speaker": 50, "form": "dlg", "jp": "（もしもし‥‥）"},
{"id": 544, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 545, "speaker": 2, "form": "dlg", "jp": "「あっ、もしもし‥‥」"},
{"id": 546, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 547, "speaker": 50, "form": "dlg", "jp": "（その声は常光寺くんだね‥‥）"},
{"id": 548, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 549, "speaker": 2, "form": "dlg", "jp": "「あ、ああ‥‥」"},
{"id": 550, "speaker": 2, "form": "dlg", "jp": "「部屋に戻ったんで、\n　コッチの部屋番号を教えておくよ‥‥」"},
{"id": 551, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 552, "speaker": 50, "form": "dlg", "jp": "（ちょっと待って、メモ、メモ‥‥）"},
{"id": 553, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 554, "speaker": 50, "form": "dlg", "jp": "ボクはこの部屋の部屋番号を出口に伝えた。"},
{"id": 555, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 556, "speaker": 50, "form": "dlg", "jp": "（すごいなぁ、『スイート』なんだろう？）"},
{"id": 557, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 558, "speaker": 2, "form": "dlg", "jp": "「警察が用意した部屋だよ‥‥」"},
{"id": 559, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 560, "speaker": 50, "form": "dlg", "jp": "（ちょっと見せてもらってもいいかな？）"},
{"id": 561, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 562, "speaker": 2, "form": "dlg", "jp": "「いいんじゃないかな？」"},
{"id": 563, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 564, "speaker": 50, "form": "dlg", "jp": "（じゃあ、今からそっちに行ってもいいかな？）"},
{"id": 565, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 566, "speaker": 2, "form": "dlg", "jp": "「いいよ、どうせタイクツだし‥‥」"},
{"id": 567, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 568, "speaker": 50, "form": "dlg", "jp": "（じゃあ、今から行くよ！）"},
{"id": 569, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 570, "speaker": 50, "form": "dlg", "jp": "「チン！」"},
{"id": 571, "speaker": 50, "form": "dlg", "jp": "これで少しはタイクツしのぎになりそうだ‥‥"},
{"id": 572, "speaker": 50, "form": "dlg", "jp": "とりあえず、刑事さんには伝えておくか‥‥"},
{"id": 573, "speaker": 50, "form": "dlg", "jp": "「コン、コン」"},
{"id": 574, "speaker": 20, "form": "dlg", "jp": "「どうかした？」"},
{"id": 575, "speaker": 2, "form": "dlg", "jp": "「あの、もうすぐ友だちが来ますんで‥‥」"},
{"id": 576, "speaker": 20, "form": "dlg", "jp": "「ＯＫ！！」"},
{"id": 577, "speaker": 20, "form": "dlg", "jp": "「何かあったらエンリョせずに言ってくれよ！」"},
{"id": 578, "speaker": 2, "form": "dlg", "jp": "「ありがとうございます‥‥」"},
{"id": 579, "speaker": 2, "form": "dlg", "jp": "「コン、コン」"},
{"id": 580, "speaker": 2, "form": "dlg", "jp": "来た！"},
{"id": 581, "speaker": 50, "form": "dlg", "jp": "「すみませ～ん」"},
{"id": 582, "speaker": 2, "form": "dlg", "jp": "「今開けるよ！」"},
{"id": 583, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 584, "speaker": 50, "form": "dlg", "jp": "「へえ～っ、やっぱり広いね！」"},
{"id": 585, "speaker": 50, "form": "dlg", "jp": "「こっちが寝室サイドってことは‥‥」"},
{"id": 586, "speaker": 2, "form": "dlg", "jp": "「あっちが応接室さ‥‥」"},
{"id": 587, "speaker": 2, "form": "dlg", "jp": "「まあ、あっちは刑事さんたちが\n　待機するのに使ってるんだけど‥‥」"},
{"id": 588, "speaker": 50, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 589, "speaker": 50, "form": "dlg", "jp": "「でもスゴイね、キミのお父さんって‥‥」"},
{"id": 590, "speaker": 2, "form": "dlg", "jp": "「さあ、よくわかんないんだよ‥‥」"},
{"id": 591, "speaker": 50, "form": "dlg", "jp": "「自分のお父さんだろう？」"},
{"id": 592, "speaker": 2, "form": "dlg", "jp": "「うん、そうなんだけど、今回の事件まで\n　自分の親のことなんか気にしたことなかったよ」"},
{"id": 593, "speaker": 50, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 594, "speaker": 50, "form": "dlg", "jp": "「お父さんは行方不明だって聞いたけど」"},
{"id": 595, "speaker": 50, "form": "dlg", "jp": "「本当に知らないんだ‥‥」"},
{"id": 596, "speaker": 2, "form": "dlg", "jp": "「そうなんだよな‥‥」"},
{"id": 597, "speaker": 2, "form": "dlg", "jp": "「アイツらからも、警察からも\n　しつこく聞かれるんだけど‥‥」"},
{"id": 598, "speaker": 2, "form": "dlg", "jp": "「知らないものは知らないんだよ‥‥」"},
{"id": 599, "speaker": 50, "form": "dlg", "jp": "「ふ～ん‥‥」"},
{"id": 600, "speaker": 50, "form": "dlg", "jp": "「‥‥‥‥‥‥！？」"},
{"id": 601, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 602, "speaker": 50, "form": "dlg", "jp": "「今、隣の部屋から『悲鳴』が聞こえなかった？」"},
{"id": 603, "speaker": 2, "form": "dlg", "jp": "「『悲鳴』！？」"},
{"id": 604, "speaker": 2, "form": "dlg", "jp": "「聞こえなかったよ‥‥」"},
{"id": 605, "speaker": 50, "form": "dlg", "jp": "「気のせいかな～」"},
{"id": 606, "speaker": 2, "form": "dlg", "jp": "「コワイこというなよ‥‥」"},
{"id": 607, "speaker": 50, "form": "dlg", "jp": "「いや、\n　確かに聞こえたように思うんだけど‥‥」"},
{"id": 608, "speaker": 2, "form": "dlg", "jp": "「マジ‥‥？」"},
{"id": 609, "speaker": 50, "form": "dlg", "jp": "「マジ！！」"},
{"id": 610, "speaker": 50, "form": "dlg", "jp": "「ちょっと調べてみてみようか？」"},
{"id": 611, "speaker": 50, "form": "dlg", "jp": "そう言って、出口はとなりの部屋を\nのぞきに行った。"},
{"id": 612, "speaker": 50, "form": "dlg", "jp": "「‥‥‥‥‥！？」"},
{"id": 613, "speaker": 2, "form": "dlg", "jp": "「何っ！？」"},
{"id": 614, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 615, "speaker": 50, "form": "dlg", "jp": "「早くっ、警察を呼んでっ！」"},
{"id": 616, "speaker": 2, "form": "dlg", "jp": "「警察ならそこに‥‥」"},
{"id": 617, "speaker": 50, "form": "dlg", "jp": "「死んでるんだよ！」"},
{"id": 618, "speaker": 2, "form": "dlg", "jp": "「死んでる！？」"},
{"id": 619, "speaker": 2, "form": "dlg", "jp": "「まさか‥‥！？」"},
{"id": 620, "speaker": 2, "form": "dlg", "jp": "ボクも確認のため、となりの部屋を\nのぞきこんだ！！"},
{"id": 621, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥！！"},
{"id": 622, "speaker": 2, "form": "dlg", "jp": "となりで待機していた刑事さんが\n二人とも倒れている。"},
{"id": 623, "speaker": 2, "form": "choice", "jp": "【見る】"},
{"id": 624, "speaker": 2, "form": "choice", "jp": "【話す】"},
{"id": 625, "speaker": 2, "form": "dlg", "jp": "【見る】"},
{"id": 626, "speaker": 2, "form": "dlg", "jp": "ボクは血を流して倒れている刑事さんたちを見た。"},
{"id": 627, "speaker": 2, "form": "dlg", "jp": "「これって‥‥」"},
{"id": 628, "speaker": 50, "form": "dlg", "jp": "「死んでいるよ‥‥」"},
{"id": 629, "speaker": 50, "form": "dlg", "jp": "【話す】"},
{"id": 630, "speaker": 50, "form": "dlg", "jp": "誰と？"},
{"id": 631, "speaker": 50, "form": "choice", "jp": "【刑事】"},
{"id": 632, "speaker": 50, "form": "choice", "jp": "【出口エイジ】"},
{"id": 633, "speaker": 50, "form": "dlg", "jp": "【刑事】"},
{"id": 634, "speaker": 2, "form": "dlg", "jp": "「刑事さん！！」"},
{"id": 635, "speaker": 50, "form": "dlg", "jp": "「ムダだよ！」"},
{"id": 636, "speaker": 50, "form": "dlg", "jp": "「そんなことより‥‥」"},
{"id": 637, "speaker": 50, "form": "dlg", "jp": "【出口エイジ】"},
{"id": 638, "speaker": 2, "form": "dlg", "jp": "「出口！！」"},
{"id": 639, "speaker": 50, "form": "dlg", "jp": "「早く連絡を‥‥！！」"},
{"id": 640, "speaker": 50, "form": "dlg", "jp": "ロビーにいる警部さんたちに連絡を取るため\n備え付けの電話の受話器をとった。"},
{"id": 641, "speaker": 50, "form": "dlg", "jp": "‥‥‥‥‥！！"},
{"id": 642, "speaker": 50, "form": "dlg", "jp": "ボクは電話のそばにある\nとんでもない『メモ』を見つけてしまった。"},
{"id": 643, "speaker": 50, "form": "dlg", "jp": "「ど、どうしたんだい？」"},
{"id": 644, "speaker": 2, "form": "dlg", "jp": "「コレ、見て！」"},
{"id": 645, "speaker": 50, "form": "dlg", "jp": "「こ、これはっ！？」"},
{"id": 646, "speaker": 50, "form": "dlg", "jp": "その『メモ』には\n『オマエヲコロス！』と書かれてあった。"},
{"id": 647, "speaker": 50, "form": "dlg", "jp": "「とにかく、早く警察を！」"},
{"id": 648, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 649, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 650, "speaker": 2, "form": "dlg", "jp": "失敗の原因は記憶力または推理力不足。\n事件現場で見たものをちゃんと思い出せば‥‥"},
{"id": 651, "speaker": 2, "form": "dlg", "jp": "失敗の原因は推理力不足。\nこの事件にはレーザー光線は関係ない‥‥"},
{"id": 652, "speaker": 2, "form": "dlg", "jp": "失敗の原因は推理力不足。　敵は想像を超えた\n犯罪組織だということを忘れるな。"},
{"id": 653, "speaker": 2, "form": "dlg", "jp": "失敗の原因は記憶力不足。\nキミは決して襲われてはいないハズ‥‥"},
{"id": 654, "speaker": 2, "form": "dlg", "jp": "失敗の原因は判断力不足。\n敵は意外な方法でキミを狙っている‥‥"}
]
