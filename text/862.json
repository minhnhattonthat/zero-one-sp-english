[
{"id": 0, "speaker": 29, "form": "dlg", "jp": "「気をつけてね‥‥」"},
{"id": 1, "speaker": 29, "form": "dlg", "jp": "「アイツの精神攻撃はどこから来るかわからないから‥‥」"},
{"id": 2, "speaker": 2, "form": "dlg", "jp": "「で、アイツはドコに？」"},
{"id": 3, "speaker": 29, "form": "dlg", "jp": "「また、『消えた』わ！」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "「私にもわからないわよ！」"},
{"id": 7, "speaker": 29, "form": "dlg", "jp": "「とにかく反応がなくなったのよ！」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「まわりの誰かに逃げたってことは？」"},
{"id": 9, "speaker": 29, "form": "dlg", "jp": "「それもない！」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「とにかく、清田さんの体はココにあるハズだから\n　せめて清田さんだけでも助け出そうか？」"},
{"id": 11, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 12, "speaker": 29, "form": "dlg", "jp": "ボクたちは『ゴトウマサシ』に襲われた\n清田さんを探すことにした。"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "（さて、どこから探そうかな‥‥）"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "どうやらここは実習用の建物らしい‥‥"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "２階建てで\nそれぞれの階に『実習室』と『準備室』がある。"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "ちなみにマイちゃんがいたのが『１階の準備室』だ‥‥"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「準備室を調べてみるか‥‥」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "ボクは準備室を調べてみることにした。"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "「ダメ、カギがかかってるわ！」"},
{"id": 20, "speaker": 29, "form": "dlg", "jp": "準備室の扉はカギがかけられており、\n中に入ることはできない。"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「まさか、扉をこわすわけにはいかないよな？」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "ボクたちは\nもう１度準備室を調べてみることにした。"},
{"id": 23, "speaker": 29, "form": "dlg", "jp": "「やっぱ開かないわね‥‥」"},
{"id": 24, "speaker": 29, "form": "dlg", "jp": "やはり、ここから中に入ることはできなさそうだ。"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「別の場所を調べてみよう」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「となると‥‥」"},
{"id": 27, "speaker": 2, "form": "choice", "jp": "「２階に上がってみるか‥‥」"},
{"id": 28, "speaker": 2, "form": "choice", "jp": "「実習室を調べてみるか‥‥」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「実習室を調べてみるか‥‥」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "ボクたちは実習室を調べてみることにした。"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 32, "speaker": 29, "form": "dlg", "jp": "「ここはカギがかかってないわ！」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「よし、"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "ボクが中を調べてくるから、\n　ジーンはここで待ってて‥‥」"},
{"id": 35, "speaker": 29, "form": "dlg", "jp": "「気をつけてね‥‥！」"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "「何か見落としがあるかもしれないし‥‥」"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "「ここで待ってて」"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「メモ以外になにか見つかるかも‥‥」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「ここで待ってて」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "ボクは中を調べてみることにした。"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "（なんだかよくわかんないや‥‥）"},
{"id": 44, "speaker": 2, "form": "dlg", "jp": "（まあ、そんなことより『清田さん』だよな‥‥）"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "（コレってあのメモにあったカギのキーホルダーじゃ？）"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "（ってことは、この先にカギがあるんだよな‥‥）"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "（まあ、そんなことより『清田さん』だよな‥‥）"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "（もしかしたら、このカギがあの部屋のカギかも！）"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "（どうにかして、\n　この『キーホルダー』を取れないかな？）"},
{"id": 50, "speaker": 29, "form": "dlg", "jp": "「どうだった？」"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "「うん、カギっぽいものを見つけたんだけど‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「どうしても手が届かないんだ‥‥」"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "「どうしよう‥‥」"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「もしかして、このカギ！！」"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "ボクはジーンのところに戻ることにした。"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "「どうだった？」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「『カギ』を見つけたよ！」"},
{"id": 59, "speaker": 29, "form": "dlg", "jp": "「もしかしたらそのカギが！？」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「ジーンもそう思う？」"},
{"id": 61, "speaker": 29, "form": "dlg", "jp": "「とにかく、試してみましょう！」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "「そうだね！」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "ボクたちは『２階の準備室』に行くことにした。"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "「たしかにカギのサイズはぴったりあいそうね‥‥」"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "「どうだった？」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「何も見つからなかったよ‥‥」"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "「どうだった？」"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "「なんか、気になるメモを見つけたんだけど‥‥」"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "「メモ？」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "「コレなんだけど‥‥」"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「カギを探しています‥‥」"},
{"id": 74, "speaker": 29, "form": "dlg", "jp": "「誰かがカギをなくしたみたいね‥‥」"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "（やっぱり、ここには手がかりはなさそうだな‥‥）"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「２階に上がってみるか‥‥」"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "ボクたちは２階に上がってみることにした。"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "「なんか代わり映えしない景色ね‥‥」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「学校の建物だからね‥‥」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "２階も１階と同様に、\n『実習室』と『準備室』の２つの部屋がある"},
{"id": 82, "speaker": 2, "form": "choice", "jp": "「実習室を調べてみるか‥‥」"},
{"id": 83, "speaker": 2, "form": "choice", "jp": "「準備室を調べてみるか‥‥」"},
{"id": 84, "speaker": 2, "form": "choice", "jp": "「一旦、１階に戻ろう‥‥」"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "「実習室を調べてみるか‥‥」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "ボクたちは実習室を調べてみることにした。"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "「じゃあここで待ってて‥‥」"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "「気をつけてね‥‥！」"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "「見落としてるものがあるかもしれないし‥‥」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "ボクはもう１度調べてみることにした。"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 93, "speaker": 29, "form": "dlg", "jp": "「どうだった？」"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "「ここも誰もいない‥‥」"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "「どうだった？」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「やっぱり、ここには‥‥」"},
{"id": 98, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「一旦、１階に戻ろう‥‥」"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "「わかったわ！」"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "ボクたちは一旦１階に降りることにした。"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 103, "speaker": 29, "form": "choice", "jp": "「２階に上がってみるか‥‥」"},
{"id": 104, "speaker": 29, "form": "choice", "jp": "「実習室を調べてみるか‥‥」"},
{"id": 105, "speaker": 29, "form": "choice", "jp": "「準備室を調べてみるか‥‥」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「いったいどこに？」"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「準備室を調べてみるか‥‥」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "ボクたちは準備室を調べてみることにした。"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「カギがかかってる‥‥」"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "「この部屋、中から音が聞こえるわ！」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「本当！？」"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "「この部屋、あやしいわね‥‥」"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "たしかに、静かなこの建物の中で\nここからはおかしな物音が聞こえる。"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「もしかしてこの中に清田さんが！？」"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "「じゃない？」"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「でも、"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "『カギ』"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "がないと‥‥」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「もう少し、ていねいに調べてみよう」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「となると‥‥」"},
{"id": 123, "speaker": 2, "form": "choice", "jp": "「実習室を調べてみるか‥‥」"},
{"id": 124, "speaker": 2, "form": "choice", "jp": "「一旦、１階に戻ろう‥‥」"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "ボクたちは\nもう一度、準備室を調べてみることにした。"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "しかし‥‥"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「やっぱり、"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "『カギ』"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "が見つからないことには‥‥」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「となると‥‥」"},
{"id": 131, "speaker": 2, "form": "choice", "jp": "「実習室を調べてみるか‥‥」"},
{"id": 132, "speaker": 2, "form": "choice", "jp": "「一旦、１階に戻ろう‥‥」"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "ボクはさっきの『カギ』を『カギ穴』にそっとさしこんだ。"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "「入った！！」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「これで開いてくれるといいんだけど‥‥」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「開いたぞ！」"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "「やった！！」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「じゃぁ、入るよ！」"}
]
