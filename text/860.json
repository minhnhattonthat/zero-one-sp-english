[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／２２／ＡＭ０９：５０"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "あれから２日が過ぎた。"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "しかし、ボクたちはまだ、『精神攻撃』に対しての\n対処手段を見つけられていなかった。"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "（だから、なんでボクの部屋に‥‥）"},
{"id": 4, "speaker": 31, "form": "dlg", "jp": "（こないだはオレたちの所に来ただろう？）"},
{"id": 5, "speaker": 29, "form": "dlg", "jp": "（『人類の存亡』がかかってるのに\n　小さなことでゴチャゴチャ言わないの！）"},
{"id": 6, "speaker": 51, "form": "dlg", "jp": "（そんなことより、\n　『精神攻撃』の対応策はみつかったん？）"},
{"id": 7, "speaker": 31, "form": "dlg", "jp": "（まだだ‥‥）"},
{"id": 8, "speaker": 29, "form": "dlg", "jp": "（というより防ぎようがないの‥‥）"},
{"id": 9, "speaker": 29, "form": "dlg", "jp": "（しいて言えば、『精神』をきたえるしか‥‥）"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "（なんだよそれ‥‥）"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "（でも、早くなんとかしないとマズイんじゃあ‥‥）"},
{"id": 12, "speaker": 51, "form": "dlg", "jp": "（防御がムリなら、先に攻撃してやるってのは？）"},
{"id": 13, "speaker": 29, "form": "dlg", "jp": "（『精神』って『形』がないのよ？）"},
{"id": 14, "speaker": 51, "form": "dlg", "jp": "（『肉体』の方を攻撃してやったらどうなる？）"},
{"id": 15, "speaker": 51, "form": "dlg", "jp": "（『精神』にダメージがあるんちゃう？）"},
{"id": 16, "speaker": 29, "form": "dlg", "jp": "（『精神』が抜け出す前なら可能だろうけど‥‥）"},
{"id": 17, "speaker": 29, "form": "dlg", "jp": "（ダメージより先に逃げられたら意味ないわね‥‥）"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "（じゃあ、逃げられる前に攻撃すればいいんだよね？）"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "（それができればね？）"},
{"id": 20, "speaker": 29, "form": "dlg", "jp": "（肉体を攻撃するってことは\n　ソイツに近付くってことよ‥‥）"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "（つまり、ソイツの攻撃範囲に入るってことだし）"},
{"id": 22, "speaker": 29, "form": "dlg", "jp": "（イコール、逃げ場を与えることになるでしょう？）"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "（じゃあ、『遠隔攻撃』なら？）"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "（ケネスなら遠くから攻撃できるだろう？）"},
{"id": 25, "speaker": 31, "form": "dlg", "jp": "（あとは射程距離の問題だな‥‥）"},
{"id": 26, "speaker": 31, "form": "dlg", "jp": "（オレの能力はジーンのように\n　広い範囲に有効範囲がないんだ‥‥）"},
{"id": 27, "speaker": 31, "form": "dlg", "jp": "（せいぜい、５００Ｍ程度だ‥‥）"},
{"id": 28, "speaker": 31, "form": "dlg", "jp": "（『誘拐事件』の目撃証言からすると\n　ソイツは女の子の側にいたわけじゃないから）"},
{"id": 29, "speaker": 31, "form": "dlg", "jp": "（それなりの距離が有効範囲だと思うんだ‥‥）"},
{"id": 30, "speaker": 31, "form": "choice", "jp": "（たぶん、向こうの方が長いんじゃあ？）"},
{"id": 31, "speaker": 31, "form": "choice", "jp": "（たぶん、ケネスの方が長いんじゃあ？）"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "（たぶん、向こうの方が長いんじゃあ？）"},
{"id": 33, "speaker": 31, "form": "dlg", "jp": "（なんでそう思うんだ？）"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "（だって、目撃証言では側にいなかったんだから\n　離れた場所で使える能力ってことじゃあ？）"},
{"id": 35, "speaker": 29, "form": "dlg", "jp": "（でも本部の情報が入った位置と\n　犯行現場ってそんなに離れてなかったでしょう？）"},
{"id": 36, "speaker": 29, "form": "dlg", "jp": "（つまり、比較的近くで能力を使ったってことじゃない？）"},
{"id": 37, "speaker": 29, "form": "dlg", "jp": "（もし、５００Ｍ以上離れても使える能力なら、\n　５００Ｍ以上離れて使うと思うけど‥‥）"},
{"id": 38, "speaker": 31, "form": "dlg", "jp": "（そ、そうだな！）"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "（たぶん、ケネスの方が長いんじゃあ？）"},
{"id": 40, "speaker": 29, "form": "dlg", "jp": "（なんでそう思うの？）"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "（だって、本部の情報が入った位置と\n　犯行現場ってそんなに離れてなかったんだろう？）"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "（つまり、比較的近くで能力を使ったんだろう？）"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "（もし、５００Ｍ以上離れても使える能力なら、\n　５００Ｍ以上離れて使うと思うんだ‥‥）"},
{"id": 44, "speaker": 31, "form": "dlg", "jp": "（そ、そうだな！）"},
{"id": 45, "speaker": 51, "form": "dlg", "jp": "（じゃあ、ケネスがとりあえずこらしめて、\n　それから交渉するっていうのはどう？）"},
{"id": 46, "speaker": 31, "form": "dlg", "jp": "（やってみてもいいかもな‥‥）"},
{"id": 47, "speaker": 29, "form": "dlg", "jp": "（そうね、そろそろ何かアクションを起さないと\n　時間的にマズイしね‥‥）"},
{"id": 48, "speaker": 29, "form": "dlg", "jp": "（じゃあ、その方向で作戦を立てましょう！）"},
{"id": 49, "speaker": 29, "form": "dlg", "jp": "（この作戦を成功させるために重要なことは‥‥）"},
{"id": 50, "speaker": 29, "form": "choice", "jp": "（手加減をすること‥‥）"},
{"id": 51, "speaker": 29, "form": "choice", "jp": "（周りに人がいないこと‥‥）"},
{"id": 52, "speaker": 29, "form": "choice", "jp": "（ケネスががんばること‥‥）"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "（手加減をすること‥‥）"},
{"id": 54, "speaker": 31, "form": "dlg", "jp": "（たしかに、やりすぎると\n　仲間になる交渉ができなくなるな‥‥）"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "（ケネスががんばること‥‥）"},
{"id": 56, "speaker": 31, "form": "dlg", "jp": "（オレ、１人じゃどうにもならないな‥‥）"},
{"id": 57, "speaker": 31, "form": "choice", "jp": "（手加減をすること‥‥）"},
{"id": 58, "speaker": 31, "form": "choice", "jp": "（周りに人がいないこと‥‥）"},
{"id": 59, "speaker": 31, "form": "choice", "jp": "（ケネスががんばること‥‥）"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "（周りに人がいないこと‥‥）"},
{"id": 61, "speaker": 29, "form": "dlg", "jp": "（そうね‥‥）"},
{"id": 62, "speaker": 29, "form": "dlg", "jp": "（たぶん、『遠隔攻撃』なら、\n　相手も攻撃を予測できないから）"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "（確実にダメージを与えることができる！）"},
{"id": 64, "speaker": 29, "form": "dlg", "jp": "（あとは周りに逃げばとなる人間さえいなければ）"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "（『テレパシー』で向こうに勝ち目がないことを伝えて\n　仲間になる交渉ができるわね‥‥）"},
{"id": 66, "speaker": 51, "form": "dlg", "jp": "（でも、\n　どうやってソイツが１人きりの時を見つけるの？）"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "（それなら大丈夫‥‥）"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "（アイツの能力のイメージは記憶してるから、\n　いつでもアイツを見つけられるし）"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "（５００Ｍ以内に誰もいないタイミングを見つけるのは\n　簡単よ！）"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "（じゃあ、すぐに作戦を実行しようよ！）"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "（そうね！）"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "こうしてボクたちは『ケネスの能力』を使った攻撃を\n実行することにした。"},
{"id": 73, "speaker": 31, "form": "dlg", "jp": "（じゃあ、ジーン頼んだぞ！）"},
{"id": 74, "speaker": 29, "form": "dlg", "jp": "（大丈夫、もう見つけたわ！）"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥）"},
{"id": 76, "speaker": 29, "form": "dlg", "jp": "（運が味方してくれてるようね‥‥）"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "（ソイツは今、１人で行動してる？）"},
{"id": 78, "speaker": 31, "form": "dlg", "jp": "（で、どの辺りに？）"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "（３丁目の公園付近‥‥）"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "（『公園』！？）"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "（もしかしたら、また女の子を襲うつもりなんじゃぁ？）"},
{"id": 82, "speaker": 29, "form": "dlg", "jp": "（大丈夫‥‥）"},
{"id": 83, "speaker": 29, "form": "dlg", "jp": "（公園には今、誰もいないわ‥‥）"},
{"id": 84, "speaker": 31, "form": "dlg", "jp": "（チャンスだな‥‥）"},
{"id": 85, "speaker": 31, "form": "dlg", "jp": "（オレとナゴムは公園へ向かう！）"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "（なんで、ボクが‥‥）"},
{"id": 87, "speaker": 31, "form": "dlg", "jp": "（いざとなったら、お前の能力も\n　５００Ｍぐらい石とか投げ付けられるだろう‥‥）"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "（でも、ボクの場合コントロールは‥‥）"},
{"id": 89, "speaker": 31, "form": "dlg", "jp": "（いいから付いて来い！）"},
{"id": 90, "speaker": 31, "form": "dlg", "jp": "（ジーンたちはここからアイツとの距離を教えてくれ！）"},
{"id": 91, "speaker": 31, "form": "dlg", "jp": "（５００Ｍ以内に近付かないように‥‥）"},
{"id": 92, "speaker": 29, "form": "dlg", "jp": "（わかったわ！）"},
{"id": 93, "speaker": 31, "form": "dlg", "jp": "（じゃあ行くぞ！）"},
{"id": 94, "speaker": 51, "form": "dlg", "jp": "（気をつけてな！）"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "こうしてボクとケネスは\n『精神攻撃の能力者』を追って公園へと向かった。"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "２００５／０８／２２／ＰＭ０２：１０"},
{"id": 99, "speaker": 31, "form": "dlg", "jp": "（ジーン、着いたぞ！）"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "（ちょうどいい距離ね‥‥）"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "（このままいけば、あと４０秒でソイツは公園に入るわ！）"},
{"id": 102, "speaker": 31, "form": "dlg", "jp": "（了解！）"},
{"id": 103, "speaker": 31, "form": "dlg", "jp": "「この『鉄球』を腹にぶつけてやる！」"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "（入ったわ！）"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "（今、ベンチの辺りでキョロキョロしてる！）"},
{"id": 106, "speaker": 31, "form": "dlg", "jp": "（よっしゃァ！）"},
{"id": 107, "speaker": 31, "form": "dlg", "jp": "（いけぇぇぇぇ！）"},
{"id": 108, "speaker": 31, "form": "dlg", "jp": "ケネスは鉄球を能力をつかって公園に向かって飛ばした。"},
{"id": 109, "speaker": 29, "form": "dlg", "jp": "（１時の方向に若干方向修正して！！）"},
{"id": 110, "speaker": 31, "form": "dlg", "jp": "（了解！！）"},
{"id": 111, "speaker": 31, "form": "dlg", "jp": "そして！！"},
{"id": 112, "speaker": 31, "form": "dlg", "jp": "「バシッ！」"},
{"id": 113, "speaker": 4, "form": "dlg", "jp": "「ウガッ！！」"},
{"id": 114, "speaker": 4, "form": "dlg", "jp": "公園の方から男の悲鳴が聞こえた。"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "「やった！」"},
{"id": 116, "speaker": 31, "form": "dlg", "jp": "（ジーン、どうなった？）"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "（命中よ！！）"},
{"id": 118, "speaker": 29, "form": "dlg", "jp": "（うずくまってる‥‥）"},
{"id": 119, "speaker": 4, "form": "dlg", "jp": "（また、オマエらか‥‥）"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥！」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "突然、知らないテレパシーがボクたちの\n会話に割り込んで来た。"},
{"id": 122, "speaker": 4, "form": "dlg", "jp": "（オレの人形をうばっただけでなく、\n　攻撃をしかけてくるとは‥‥）"},
{"id": 123, "speaker": 31, "form": "dlg", "jp": "（コイツ、『ゴトウ』だ！！）"},
{"id": 124, "speaker": 33, "form": "dlg", "jp": "（名前を知ってるのか‥‥）"},
{"id": 125, "speaker": 33, "form": "dlg", "jp": "（まあ、その名前もオマエたちのせいで\n　もう使えなくなったがな‥‥）"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "（今の攻撃でわかったと思うけど、\n　私たちはアナタを殺すことも可能なの‥‥）"},
{"id": 127, "speaker": 33, "form": "dlg", "jp": "（だから‥‥）"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "（『仲間』になって欲しいの‥‥）"},
{"id": 129, "speaker": 33, "form": "dlg", "jp": "（はあ？）"},
{"id": 130, "speaker": 33, "form": "dlg", "jp": "（こんなものぶつけておいて、仲間になりたいだと？）"},
{"id": 131, "speaker": 31, "form": "dlg", "jp": "（オマエがあの子たちにしたことよりマシだろう？）"},
{"id": 132, "speaker": 33, "form": "dlg", "jp": "（仲間になるといいことがあるのか？）"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "（人類をいっしょに救うことが‥‥）"},
{"id": 134, "speaker": 33, "form": "dlg", "jp": "（オレは慈善事業にはキョウミねぇー）"},
{"id": 135, "speaker": 33, "form": "dlg", "jp": "（そうだな‥‥）"},
{"id": 136, "speaker": 33, "form": "dlg", "jp": "（オレの趣味の手伝いをしてくれるなら\n　考えてもいいかな‥‥）"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "（その内容次第ね‥‥）"},
{"id": 138, "speaker": 33, "form": "dlg", "jp": "（女の子を１００人ほど、オレに寄付してもらえるかな？）"},
{"id": 139, "speaker": 29, "form": "dlg", "jp": "（それは本気でいっているの？）"},
{"id": 140, "speaker": 33, "form": "dlg", "jp": "（オレのコレクションを見たんだろう？）"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "（交渉決裂ね！！）"},
{"id": 142, "speaker": 33, "form": "dlg", "jp": "（そうだな‥‥）"},
{"id": 143, "speaker": 29, "form": "dlg", "jp": "（アナタには死んでもらいます！）"},
{"id": 144, "speaker": 33, "form": "dlg", "jp": "（やれるもんならやってみろ！）"},
{"id": 145, "speaker": 31, "form": "dlg", "jp": "（やれちゃうんだよ‥‥）"},
{"id": 146, "speaker": 31, "form": "dlg", "jp": "（オマエの周りにはオマエの逃げ道となる人間がいない‥‥）"},
{"id": 147, "speaker": 31, "form": "dlg", "jp": "（つまり、逃げ道はないんだよ！）"},
{"id": 148, "speaker": 33, "form": "dlg", "jp": "（おもしろい、やってみろ！）"},
{"id": 149, "speaker": 31, "form": "dlg", "jp": "（ジーン、本当にやるけどいいんだな！）"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "（かまわないわ！）"},
{"id": 151, "speaker": 29, "form": "dlg", "jp": "（今、地面に倒れてるから、その辺りを狙って！）"},
{"id": 152, "speaker": 31, "form": "dlg", "jp": "（ＯＫ！）"},
{"id": 153, "speaker": 31, "form": "dlg", "jp": "（今度はそのくだらない『頭』だ！）"},
{"id": 154, "speaker": 31, "form": "dlg", "jp": "（ジゴクで反省しな！！）"},
{"id": 155, "speaker": 29, "form": "dlg", "jp": "（ちょっと待って！！）"},
{"id": 156, "speaker": 31, "form": "dlg", "jp": "（どうした？）"},
{"id": 157, "speaker": 29, "form": "dlg", "jp": "（ストップ！！）"},
{"id": 158, "speaker": 29, "form": "dlg", "jp": "（アイツが消えたわ？）"},
{"id": 159, "speaker": 31, "form": "dlg", "jp": "（なんだって！？）"},
{"id": 160, "speaker": 29, "form": "dlg", "jp": "（体の中から『イメージ』がなくなったわ‥‥）"},
{"id": 161, "speaker": 31, "form": "dlg", "jp": "（周りに人は？）"},
{"id": 162, "speaker": 29, "form": "dlg", "jp": "（５００Ｍ以内に誰もいない‥‥）"},
{"id": 163, "speaker": 51, "form": "dlg", "jp": "（じゃあ、アイツの方が有効範囲が長かったの！）"},
{"id": 164, "speaker": 29, "form": "dlg", "jp": "（ちがうわ！）"},
{"id": 165, "speaker": 29, "form": "dlg", "jp": "（アイツの『イメージ』自体がなくなったの！）"},
{"id": 166, "speaker": 51, "form": "dlg", "jp": "（どういうこと！？）"},
{"id": 167, "speaker": 29, "form": "dlg", "jp": "（アイツの『精神』が消えてしまったの！）"},
{"id": 168, "speaker": 31, "form": "dlg", "jp": "（それって‥‥）"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "（『精神』が死んだか、\n　『精神』の形が変わった‥‥）"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "（『精神の形』ってころころ変えられるものなの？）"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "（ムリよ‥‥）"},
{"id": 172, "speaker": 31, "form": "dlg", "jp": "（じゃあ‥‥）"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "（死んだ‥‥）"},
{"id": 174, "speaker": 29, "form": "dlg", "jp": "（たぶんね‥‥）"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "こうして、『ゴトウマサシ』のことは、\n後味の悪い結末をむかえた‥‥"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "２００５／０８／２２／ＰＭ０３：２０"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「ただいま‥‥」"},
{"id": 179, "speaker": 3, "form": "dlg", "jp": "「おかえりなさい‥‥」"},
{"id": 180, "speaker": 26, "form": "dlg", "jp": "「おじゃましてるよ‥‥」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「最近、三田さん毎日来てるね？」"},
{"id": 182, "speaker": 26, "form": "dlg", "jp": "「べ、別に深い意味はないよ‥‥」"},
{"id": 183, "speaker": 26, "form": "dlg", "jp": "「ただ、博士の用事が‥‥」"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「そういえば、\n　また父さん帰って来なくなったね？」"},
{"id": 185, "speaker": 26, "form": "dlg", "jp": "「研究意欲が燃え上がって止まらないそうです‥‥」"},
{"id": 186, "speaker": 3, "form": "dlg", "jp": "「しょうがないわね‥‥」"},
{"id": 187, "speaker": 3, "form": "dlg", "jp": "「ピンポーン！！」"},
{"id": 188, "speaker": 3, "form": "dlg", "jp": "「ピンポーン！！」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「ボクが出るよ！」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 192, "speaker": 58, "form": "dlg", "jp": "「た、助けてください‥‥」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「マ、マイちゃん！？」"},
{"id": 194, "speaker": 58, "form": "dlg", "jp": "「お願いします‥‥」"},
{"id": 195, "speaker": 3, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 196, "speaker": 3, "form": "dlg", "jp": "「アラ、マイちゃん！！」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「マイちゃんって！？」"},
{"id": 198, "speaker": 3, "form": "dlg", "jp": "「スゴイわね、もう歩けるんだ！」"},
{"id": 199, "speaker": 3, "form": "dlg", "jp": "「あがって‥‥」"},
{"id": 200, "speaker": 58, "form": "dlg", "jp": "「そんなことより、兄さんを‥‥」"},
{"id": 201, "speaker": 3, "form": "dlg", "jp": "「何かあったの？」"},
{"id": 202, "speaker": 58, "form": "dlg", "jp": "「ウウウウウウウ‥‥」"},
{"id": 203, "speaker": 3, "form": "dlg", "jp": "「とりあえず、あがって‥‥」"},
{"id": 204, "speaker": 3, "form": "dlg", "jp": "姉さんの話では、午前中、姉さんたちは\n清田さんの所へ行っていたらしい‥‥"},
{"id": 205, "speaker": 3, "form": "dlg", "jp": "そこで、清田さんから姉さんの研究資料のおかげで\nマイちゃんが回復したことのお礼を言われ、"},
{"id": 206, "speaker": 3, "form": "dlg", "jp": "マイちゃんにも会わせてもらったらしい‥‥"},
{"id": 207, "speaker": 3, "form": "dlg", "jp": "マイちゃんの肉体は筋肉などがおとろえないように\n清田さんが動かしていたので、"},
{"id": 208, "speaker": 3, "form": "dlg", "jp": "『意識』が戻った時点で、\nほぼもとのマイちゃんに戻れたらしい。"},
{"id": 209, "speaker": 3, "form": "dlg", "jp": "で、なんでマイちゃんがウチに来たかというと‥‥"},
{"id": 210, "speaker": 58, "form": "dlg", "jp": "「実は、兄さんが突然おかしくなったんです！」"},
{"id": 211, "speaker": 26, "form": "dlg", "jp": "「おかしくって？」"},
{"id": 212, "speaker": 58, "form": "dlg", "jp": "「まるで『別人』みたいに‥‥」"},
{"id": 213, "speaker": 26, "form": "dlg", "jp": "「『別人』？」"},
{"id": 214, "speaker": 58, "form": "dlg", "jp": "「ハイ、突然苦しみ出して、\n　治まったと思ったら‥‥」"},
{"id": 215, "speaker": 58, "form": "dlg", "jp": "「目つきが変わって‥‥」"},
{"id": 216, "speaker": 58, "form": "dlg", "jp": "「マイにヘンなコトを‥‥」"},
{"id": 217, "speaker": 26, "form": "dlg", "jp": "「それで逃げて来たんだね？」"},
{"id": 218, "speaker": 3, "form": "dlg", "jp": "「お兄さんは今？」"},
{"id": 219, "speaker": 58, "form": "dlg", "jp": "「研究室に中からカギをかけて閉じこもってます‥‥」"},
{"id": 220, "speaker": 58, "form": "dlg", "jp": "「数年間も意識を失っていたマイには\n　みなさんしかたよれる人が‥‥」"},
{"id": 221, "speaker": 3, "form": "dlg", "jp": "「ここのことは？」"},
{"id": 222, "speaker": 58, "form": "dlg", "jp": "「電話帳で調べました‥‥」"},
{"id": 223, "speaker": 58, "form": "dlg", "jp": "「お願いします！！」"},
{"id": 224, "speaker": 58, "form": "dlg", "jp": "「マイを、兄さんを助けてください‥‥」"},
{"id": 225, "speaker": 58, "form": "dlg", "jp": "その時！"},
{"id": 226, "speaker": 29, "form": "dlg", "jp": "（ナゴム！！）"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "（ジ、ジーン‥‥）"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "（今、ちょっと取込み中なんだよ！）"},
{"id": 229, "speaker": 29, "form": "dlg", "jp": "（大変よ！）"},
{"id": 230, "speaker": 29, "form": "dlg", "jp": "（アイツの『イメージ』が見つかったのよ！）"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "（だから今は‥‥）"},
{"id": 232, "speaker": 29, "form": "dlg", "jp": "（いいから聞いて！）"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "（アイツの『イメージ』は今、\n　この間の大学にいるのよ！！）"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「なんだってっ！！」"},
{"id": 235, "speaker": 26, "form": "dlg", "jp": "「ど、ど、どうかしたのかい？」"},
{"id": 236, "speaker": 2, "form": "dlg", "jp": "「いえ、なんでもありません！」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "（それって本当なの？）"},
{"id": 238, "speaker": 29, "form": "dlg", "jp": "（間違いないわ！）"},
{"id": 239, "speaker": 58, "form": "dlg", "jp": "「兄さんを元の兄さんに戻してください‥‥」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "（『元の兄さん』？）"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "（もしかして！？）"},
{"id": 242, "speaker": 29, "form": "dlg", "jp": "（何、どうかしたの？）"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "（コッチはコッチでいろいろあるんだよ！）"},
{"id": 244, "speaker": 26, "form": "dlg", "jp": "「もしかして、『精神』の移動をくり返していたから\n　『精神』がこわれたとか？」"},
{"id": 245, "speaker": 58, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 246, "speaker": 3, "form": "dlg", "jp": "「とにかく、閉じこもってるんだったら、\n　私たちだけではどうにもできないわね‥‥」"},
{"id": 247, "speaker": 3, "form": "dlg", "jp": "「警察に協力してもらいましょう！」"},
{"id": 248, "speaker": 26, "form": "dlg", "jp": "「少々、説明には手こずりそうだけどね‥‥」"},
{"id": 249, "speaker": 3, "form": "dlg", "jp": "「でも、大槻警部はシローのことを知ってるから\n　比較的わかってくれると！」"},
{"id": 250, "speaker": 3, "form": "dlg", "jp": "「ねえ、いっしょに警察に行きましょう」"},
{"id": 251, "speaker": 58, "form": "dlg", "jp": "「わ、わかりました‥‥」"},
{"id": 252, "speaker": 3, "form": "dlg", "jp": "「じゃあ、姉さんたち警察に行ってくるから‥‥」"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "「う、うん‥‥」"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "（ちょっと、聞いてるの！？）"},
{"id": 255, "speaker": 2, "form": "dlg", "jp": "（えっ？）"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 257, "speaker": 29, "form": "dlg", "jp": "（とにかく、例の大学へ行きましょう！）"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "（わかった！）"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "こうしてボクたちは例の大学へ、\n姉さんたちは警察に行くことになった。"},
{"id": 260, "speaker": 15, "form": "dlg", "jp": "（そんなことより、\n　『精神攻撃』の対応策はみつかったの？）"},
{"id": 261, "speaker": 15, "form": "dlg", "jp": "（防御がムリなら、先に攻撃するっていうのは？）"},
{"id": 262, "speaker": 29, "form": "dlg", "jp": "（『精神』って『形』がないのよ？）"},
{"id": 263, "speaker": 15, "form": "dlg", "jp": "（『肉体』の方を攻撃したらどうなるの？）"},
{"id": 264, "speaker": 15, "form": "dlg", "jp": "（『精神』にダメージがあるんじゃぁ？）"},
{"id": 265, "speaker": 15, "form": "dlg", "jp": "（じゃあ、ケネスがとりあえずこらしめて、\n　それから交渉するっていうのはどう？）"},
{"id": 266, "speaker": 15, "form": "dlg", "jp": "（でも、\n　どうやってソイツが１人きりの時を見つけるの？）"},
{"id": 267, "speaker": 15, "form": "dlg", "jp": "（気をつけてね！）"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 269, "speaker": 15, "form": "dlg", "jp": "（じゃあ、アイツの方が有効範囲が長かったの！）"},
{"id": 270, "speaker": 29, "form": "dlg", "jp": "（ちがうわ！）"},
{"id": 271, "speaker": 29, "form": "dlg", "jp": "（アイツの『イメージ』自体がなくなったの！）"},
{"id": 272, "speaker": 15, "form": "dlg", "jp": "（どういうこと！？）"},
