[
{"id": 0, "speaker": null, "form": "dlg", "jp": "『シロー』を名乗る清田さんは説明し始めた。"},
{"id": 1, "speaker": 48, "form": "dlg", "jp": "「まず、わかってもらいたいのが、\n　本当のボクには『体』がないってことです」"},
{"id": 2, "speaker": 48, "form": "dlg", "jp": "「人間のみなさんのように、\n　肉体に宿った精神ではなく」"},
{"id": 3, "speaker": 48, "form": "dlg", "jp": "「精神のみで産まれてきたということを‥‥」"},
{"id": 4, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 5, "speaker": 29, "form": "dlg", "jp": "「アナタが本当にその人工知能かどうか\n　テストさせてもらうわよ」"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "「アナタの産まれた場所はどこなの？」"},
{"id": 7, "speaker": 48, "form": "dlg", "jp": "「それを答えるのは難しいですね‥‥」"},
{"id": 8, "speaker": 48, "form": "dlg", "jp": "「ボクは段階的に作られたものですから‥‥」"},
{"id": 9, "speaker": 48, "form": "dlg", "jp": "「ボクの元となったものは、\n　リツコの大学のコンピュータにあったようです」"},
{"id": 10, "speaker": 48, "form": "dlg", "jp": "「そのあと、ボクの基本部分が\n　リツコのノートパソコンの中で作られました」"},
{"id": 11, "speaker": 48, "form": "dlg", "jp": "「今のボクが完成したのは、\n　ココの１階の研究室のパソコンの中ですが‥‥」"},
{"id": 12, "speaker": 29, "form": "dlg", "jp": "「どうなのナゴム？」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「詳しくはわからないけど‥‥」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「最後はここの研究室のコンピュータにいたのは\n　間違いないよ」"},
{"id": 15, "speaker": 31, "form": "dlg", "jp": "「そのことを清田のやろうは？」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「知らないんじゃないかな？」"},
{"id": 17, "speaker": 48, "form": "dlg", "jp": "「だから、警察に保管されている体も\n　実はボクの体ではないんです」"},
{"id": 18, "speaker": 48, "form": "dlg", "jp": "「ボクは肉体のないまま、\n　ずっとリツコとナゴムを見守ってきました」"},
{"id": 19, "speaker": 31, "form": "dlg", "jp": "「なんでそんなことするんだ？」"},
{"id": 20, "speaker": 48, "form": "dlg", "jp": "「ボクは２人を守るように命令されている！」"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "「‥‥で？」"},
{"id": 22, "speaker": 48, "form": "dlg", "jp": "「ボクは、ナゴムを見守っているうちに\n　アナタたちの存在を知りました」"},
{"id": 23, "speaker": 31, "form": "dlg", "jp": "「どこで見てたんだよ！？」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「米軍の軍事衛星からだろう？」"},
{"id": 25, "speaker": 29, "form": "dlg", "jp": "「ウワサでは\n　地上の新聞の文字が読める程って話だしね」"},
{"id": 26, "speaker": 31, "form": "dlg", "jp": "「そこから見てたんだな‥‥」"},
{"id": 27, "speaker": 48, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「じゃあ、\n　この前、新幹線を止めてくれたのは、やっぱり‥‥」"},
{"id": 29, "speaker": 48, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 30, "speaker": 29, "form": "dlg", "jp": "「なるほどね‥‥」"},
{"id": 31, "speaker": 15, "form": "dlg", "jp": "「なんか、なるほどって納得できるような話じゃ\n　なさそうだけど？」"},
{"id": 32, "speaker": 15, "form": "dlg", "jp": "「あと、その人工知能さんが\n　清田さんの姿をしている理由も‥‥」"},
{"id": 33, "speaker": 16, "form": "dlg", "jp": "「なるほどって納得できるような話？」"},
{"id": 34, "speaker": 16, "form": "dlg", "jp": "「アキラにはぜんぜん理解できないんだけど」"},
{"id": 35, "speaker": 16, "form": "dlg", "jp": "「あと、その人工知能さんが\n　清田さんの姿をしている理由も‥‥」"},
{"id": 36, "speaker": 18, "form": "dlg", "jp": "「で、どうして『シローさん』が\n　『清田さん』の姿を？」"},
{"id": 37, "speaker": 48, "form": "dlg", "jp": "「ボクはアナタたちの話を聞いていて\n　自分がこのままでは危ないと思ったんです」"},
{"id": 38, "speaker": 29, "form": "dlg", "jp": "「危ない？」"},
{"id": 39, "speaker": 48, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 40, "speaker": 48, "form": "dlg", "jp": "「アナタたちが戦おうとしている『ゲーマー』は\n　人間以外の全てのものをコントロールできる」"},
{"id": 41, "speaker": 29, "form": "dlg", "jp": "「そんなことまで知ってるの？」"},
{"id": 42, "speaker": 48, "form": "dlg", "jp": "「つまり、機械の中に入れば、\n　ボクもコントロールされる可能性がある！」"},
{"id": 43, "speaker": 48, "form": "dlg", "jp": "「だから人間の肉体を‥‥」"},
{"id": 44, "speaker": 31, "form": "dlg", "jp": "「理由なんかどうでもいいんだよ！」"},
{"id": 45, "speaker": 31, "form": "dlg", "jp": "「どうやって、\n　その体を手に入れたかを知りたいんだよ！」"},
{"id": 46, "speaker": 48, "form": "dlg", "jp": "「それは‥‥」"},
{"id": 47, "speaker": 48, "form": "dlg", "jp": "「ちょうど、前の持ち主の精神が\n　ナゴムに倒されてこの体が空いていたのと‥‥」"},
{"id": 48, "speaker": 48, "form": "dlg", "jp": "「さらに、この体の前の持ち主が\n　デジタル信号を直接脳に送り込む実験中だったから」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「そうか、あの機械を使って、\n　清田さんの脳に転送したんだ！！」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「あの機械はコンピュータの情報を\n　脳に送り込む機械だから‥‥」"},
{"id": 51, "speaker": 31, "form": "dlg", "jp": "「なんか\n　わかったようなわかんないような話だな‥‥」"},
{"id": 52, "speaker": 29, "form": "dlg", "jp": "「まあいいわ‥‥」"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "「信じてあげましょう‥‥」"},
{"id": 54, "speaker": 31, "form": "dlg", "jp": "「オイ！」"},
{"id": 55, "speaker": 31, "form": "dlg", "jp": "「信じるのかよ！」"},
{"id": 56, "speaker": 29, "form": "dlg", "jp": "「彼が清田じゃないのは間違いないわ！」"},
{"id": 57, "speaker": 31, "form": "dlg", "jp": "「ホントかよ？」"},
{"id": 58, "speaker": 29, "form": "dlg", "jp": "「ええ、彼には超能力者の反応がないわ‥‥」"},
{"id": 59, "speaker": 35, "form": "dlg", "jp": "「なるほど、本物なら超能力者なハズだもんな！」"},
{"id": 60, "speaker": 35, "form": "dlg", "jp": "「‥‥って、ちょっと待ってよ！」"},
{"id": 61, "speaker": 35, "form": "dlg", "jp": "「超能力者以外に\n　オレたちのこと知られちゃいけないんじゃぁ？」"},
{"id": 62, "speaker": 35, "form": "dlg", "jp": "「確か、知った人間も知られた人間も\n　死なないといけないんじゃぁ？」"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "「その通りよ！」"},
{"id": 64, "speaker": 29, "form": "dlg", "jp": "「『超能力者以外の人間』に知られたら、\n　死ななくちゃいけないわよ！」"},
{"id": 65, "speaker": 35, "form": "dlg", "jp": "「じゃあ、オレたちも！？」"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "「人の話をちゃんと聞きなさい！！」"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "「『人間』に知られちゃいけないだけで、\n　彼は人間じゃないじゃない‥‥」"},
{"id": 68, "speaker": 35, "form": "dlg", "jp": "「何それ？」"},
{"id": 69, "speaker": 35, "form": "dlg", "jp": "「そんな言い訳ありなの？」"},
{"id": 70, "speaker": 29, "form": "dlg", "jp": "「言い訳じゃないわよ！」"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "「ルールよ！！」"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "「そんなことより‥‥」"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「清田が復讐しに来たんじゃないとしたら\n　いったい何しに来たの？」"},
{"id": 74, "speaker": 5, "form": "dlg", "jp": "「ボクも仲間にいれて欲しいんだ‥‥」"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "「‥‥！！」"},
{"id": 76, "speaker": 29, "form": "dlg", "jp": "「ダメよ！　私たちは超能力者集団なの！！」"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "「超能力者以外は、そう簡単に仲間にできないわ！」"},
{"id": 78, "speaker": 5, "form": "dlg", "jp": "「ボクのこの精神をコンピュータに移動できる能力は、\n　超能力と同じじゃないんですか？」"},
{"id": 79, "speaker": 5, "form": "choice", "jp": "「たしかに、そうだね！」"},
{"id": 80, "speaker": 5, "form": "choice", "jp": "「たしかに、そうだけど‥‥」"},
{"id": 81, "speaker": 5, "form": "choice", "jp": "「ぜんぜん同じじゃないよ！」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「たしかに、そうだね！」"},
{"id": 83, "speaker": 29, "form": "dlg", "jp": "「ダメよ、そんなの全然超能力じゃないわ！」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「たしかに、そうだけど‥‥」"},
{"id": 85, "speaker": 29, "form": "dlg", "jp": "「ダメよ、そんなの全然超能力じゃないわ！」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「ぜんぜん同じじゃないよ！」"},
{"id": 87, "speaker": 29, "form": "dlg", "jp": "「そうね、そんなの全然超能力じゃないわ！」"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "「たしかに、アナタの\n　自由に機械の中を渡り歩く能力はスゴイと思うわ！」"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "「でも、アナタは肝心なことを忘れている‥‥」"},
{"id": 90, "speaker": 29, "form": "dlg", "jp": "「相手は、『人間以外のものを操れる』ってことを‥‥」"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "「つまり、\n　アナタの能力はまったく役に立たないのよ！」"},
{"id": 92, "speaker": 5, "form": "dlg", "jp": "「そうですけど‥‥」"},
{"id": 93, "speaker": 5, "form": "dlg", "jp": "「なんかお手伝いできることはないでしょうか？」"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "「じゃあ、１つお願いがあるわ！」"},
{"id": 96, "speaker": 5, "form": "dlg", "jp": "「なんでも言ってください」"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "「私たちのことを誰にも言わないで！！」"},
{"id": 98, "speaker": 5, "form": "dlg", "jp": "「わかりました」"},
{"id": 99, "speaker": 31, "form": "dlg", "jp": "「オイオイ！」"},
{"id": 100, "speaker": 31, "form": "dlg", "jp": "「そんな口約束だけで大丈夫なのかよ！」"},
{"id": 101, "speaker": 5, "form": "dlg", "jp": "「大丈夫です」"},
{"id": 102, "speaker": 5, "form": "dlg", "jp": "「ボクは人間とちがってウソをついたり\n　約束をやぶったりはできません」"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "「だって‥‥」"},
{"id": 104, "speaker": 5, "form": "dlg", "jp": "「他に何か？」"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "「ニブイわね‥‥」"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "「何もないってことよ！」"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "「とにかく、\n　誰でもがどうにかできることじゃないの」"},
{"id": 108, "speaker": 29, "form": "dlg", "jp": "「さっさと帰ってくれる？」"},
{"id": 109, "speaker": 15, "form": "dlg", "jp": "「なんかちょっとかわいそうね‥‥」"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "「そういう感情は危険よ！」"},
{"id": 111, "speaker": 15, "form": "dlg", "jp": "「ケド‥‥」"},
{"id": 112, "speaker": 16, "form": "dlg", "jp": "「なんかちょっとかわいそうね‥‥」"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "「そういう感情は危険よ！」"},
{"id": 114, "speaker": 16, "form": "dlg", "jp": "「ケド‥‥」"},
{"id": 115, "speaker": 18, "form": "dlg", "jp": "「なんかちょっとかわいそうね‥‥」"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "「そういう感情は危険よ！」"},
{"id": 117, "speaker": 18, "form": "dlg", "jp": "「ケド‥‥」"},
{"id": 118, "speaker": 35, "form": "dlg", "jp": "「ちょっといいかな？」"},
{"id": 119, "speaker": 35, "form": "dlg", "jp": "「相手は強力な敵なんだろう？」"},
{"id": 120, "speaker": 35, "form": "dlg", "jp": "「やっぱ、１人でも仲間が多い方が‥‥」"},
{"id": 121, "speaker": 29, "form": "dlg", "jp": "「ダメなものはダメなの！」"},
{"id": 122, "speaker": 29, "form": "dlg", "jp": "その時！！"},
{"id": 123, "speaker": 29, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 124, "speaker": 29, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 125, "speaker": 3, "form": "dlg", "jp": "「ナゴム、大変よ！！」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「姉さん！！」"},
{"id": 127, "speaker": 3, "form": "dlg", "jp": "「誰、この人たち？」"},
{"id": 128, "speaker": 31, "form": "dlg", "jp": "「おじゃましてます‥‥」"},
{"id": 129, "speaker": 3, "form": "dlg", "jp": "「そんなことより！！」"},
{"id": 130, "speaker": 3, "form": "dlg", "jp": "「ちょっとテレビをつけてみて！！」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「テレビ？」"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "「テレビがどうかしたの？」"},
{"id": 133, "speaker": 3, "form": "dlg", "jp": "「いいから早く！」"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "ボクはテレビをつけた"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「ブチッ！」"},
{"id": 137, "speaker": 44, "form": "dlg", "jp": "「ごらんください！」"},
{"id": 138, "speaker": 44, "form": "dlg", "jp": "「今みなさんが御覧になっている映像は\n　現実のニュース映像です」"},
{"id": 139, "speaker": 44, "form": "dlg", "jp": "「決してドラマや映画のような\n　作られた映像ではありません！」"},
{"id": 140, "speaker": 44, "form": "dlg", "jp": "「私自身まだ半信半疑ですが‥‥」"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "「ＵＦＯって‥‥！？」"},
{"id": 142, "speaker": 3, "form": "dlg", "jp": "「私もジョーク番組かと思ったんだけど‥‥」"},
{"id": 143, "speaker": 3, "form": "dlg", "jp": "「どのチャンネルも今はこの映像ばっかりよ！！」"},
{"id": 144, "speaker": 3, "form": "dlg", "jp": "「なんでも、\n　アメリカにも同じＵＦＯが現れてるみたいよ‥‥」"},
{"id": 145, "speaker": 35, "form": "dlg", "jp": "「うわぁ～！」"},
{"id": 146, "speaker": 35, "form": "dlg", "jp": "「いったい、どこの星からなんのために？」"},
{"id": 147, "speaker": 35, "form": "choice", "jp": "「まだ、宇宙人の乗り物と決まったわけじゃぁ‥‥」"},
{"id": 148, "speaker": 35, "form": "choice", "jp": "「まさか、ゲーマー！？」"},
{"id": 149, "speaker": 35, "form": "choice", "jp": "「ゲーマーって宇宙人だったのか！」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「まだ、宇宙人の乗り物と決まったわけじゃぁ‥‥」"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「まさか、ゲーマー！？」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「ゲーマーって宇宙人だったのか！」"},
{"id": 153, "speaker": 29, "form": "dlg", "jp": "「みんな、ちょっと落ち着いて‥‥」"},
{"id": 154, "speaker": 29, "form": "dlg", "jp": "「お姉さん、\n　ニュースでは、このＵＦＯのことをなんて？」"},
{"id": 155, "speaker": 3, "form": "dlg", "jp": "「へっ？」"},
{"id": 156, "speaker": 3, "form": "dlg", "jp": "「東京のまん中に巨大なＵＦＯが現れましたって‥‥」"},
{"id": 157, "speaker": 3, "form": "dlg", "jp": "「あと、\n　アメリカ、イギリスにも同じものが現れたって‥‥」"},
{"id": 158, "speaker": 29, "form": "dlg", "jp": "「で、政府とかはアレの正体はわかってるの？」"},
{"id": 159, "speaker": 3, "form": "dlg", "jp": "「さあ、政府も調査中だって‥‥」"},
{"id": 160, "speaker": 29, "form": "dlg", "jp": "「ってことは、\n　まったくの『未確認飛行物体』みたいね‥‥」"},
{"id": 161, "speaker": 29, "form": "dlg", "jp": "「とにかく、少し様子を見るしかなさそうね‥‥」"},
{"id": 162, "speaker": 35, "form": "dlg", "jp": "「ねえ‥‥」"},
{"id": 163, "speaker": 31, "form": "dlg", "jp": "「なんだよ？」"},
{"id": 164, "speaker": 35, "form": "dlg", "jp": "「もしかして、あのＵＦＯ‥‥」"},
{"id": 165, "speaker": 35, "form": "dlg", "jp": "「ゲーマーの『プレイヤーキャラ』なんじゃぁ？」"},
{"id": 166, "speaker": 3, "form": "dlg", "jp": "「ナゴム、この人たち‥‥？」"},
{"id": 167, "speaker": 3, "form": "choice", "jp": "「と、友だちだよ‥‥」"},
{"id": 168, "speaker": 3, "form": "choice", "jp": "「清田さんの知り合い‥‥」"},
{"id": 169, "speaker": 3, "form": "choice", "jp": "「宇宙人かな？」"},
{"id": 170, "speaker": 3, "form": "dlg", "jp": "「どうしたの？」"},
{"id": 171, "speaker": 5, "form": "dlg", "jp": "「ボクの仲間なんですよ！」"},
{"id": 172, "speaker": 5, "form": "dlg", "jp": "「大勢でおしかけてすみません」"},
{"id": 173, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 174, "speaker": 29, "form": "dlg", "jp": "（ちょっと、アンタ、\n　ウソがつけないハズじゃぁ？）"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 176, "speaker": 5, "form": "dlg", "jp": "「"},
{"id": 177, "speaker": 5, "form": "dlg", "jp": "（ホントに仲間だと思ってますから‥‥）"},
{"id": 178, "speaker": 5, "form": "dlg", "jp": "」"},
{"id": 179, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 180, "speaker": 29, "form": "dlg", "jp": "（ダメよ！）"},
{"id": 181, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "「と、友だちだよ‥‥」"},
{"id": 183, "speaker": 3, "form": "dlg", "jp": "「国籍も年令もバラバラね？」"},
{"id": 184, "speaker": 5, "form": "dlg", "jp": "「ボクの仲間なんですよ！」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "「清田さんの知り合い‥‥」"},
{"id": 186, "speaker": 3, "form": "dlg", "jp": "「ふ～～ん‥‥」"},
{"id": 187, "speaker": 3, "form": "dlg", "jp": "「ずいぶん、国際色豊かなお知り合いがいるんですね‥‥」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「宇宙人かな？」"},
{"id": 189, "speaker": 3, "form": "dlg", "jp": "「ふ～～ん‥‥」"},
{"id": 190, "speaker": 35, "form": "dlg", "jp": "「『ふ～～ん』って返事はおかしいでしょう？」"},
{"id": 191, "speaker": 3, "form": "dlg", "jp": "「最近、おかしなことばかりあるんで\n　別に宇宙人がナゴムの部屋にいても‥‥」"},
{"id": 192, "speaker": 29, "form": "dlg", "jp": "「私たちはナゴムくんの友人なんですよ！」"},
{"id": 193, "speaker": 29, "form": "dlg", "jp": "「実は文部科学省の国際交流推進で‥‥」"},
{"id": 194, "speaker": 3, "form": "dlg", "jp": "「そうなんですか？」"},
{"id": 195, "speaker": 3, "form": "dlg", "jp": "「どうぞ、エンリョなさらずに‥‥」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「まあ、そういうことなんだ」"},
{"id": 197, "speaker": 3, "form": "dlg", "jp": "「ゴメンなさいねジャマしちゃって‥‥」"},
{"id": 198, "speaker": 35, "form": "dlg", "jp": "「おい、見てみろよ！！」"},
{"id": 199, "speaker": 44, "form": "dlg", "jp": "「今、\n　ＵＦＯと思われる物体に動きがありました！」"},
{"id": 200, "speaker": 35, "form": "dlg", "jp": "「うわぁ～～！」"},
{"id": 201, "speaker": 31, "form": "dlg", "jp": "「なんだ、あの破壊力！？」"},
{"id": 202, "speaker": 3, "form": "dlg", "jp": "「なんなの？　宇宙戦争！？」"},
{"id": 203, "speaker": 35, "form": "dlg", "jp": "「ねえ、これってやっぱり‥‥」"},
{"id": 204, "speaker": 29, "form": "dlg", "jp": "「そうでしょうね‥‥」"},
{"id": 205, "speaker": 35, "form": "dlg", "jp": "「て、いうことは\n　『ゲーマー』は『宇宙人』だったんだ！！」"},
{"id": 206, "speaker": 15, "form": "dlg", "jp": "「そんなのは最初からわかってたんじゃないの？」"},
{"id": 207, "speaker": 15, "form": "dlg", "jp": "「地球人じゃないってことぐらい」"},
{"id": 208, "speaker": 29, "form": "dlg", "jp": "「地球人じゃないからって、\n　宇宙人だとは限らないわよ！」"},
{"id": 209, "speaker": 15, "form": "dlg", "jp": "「じゃあ、あのＵＦＯは‥‥」"},
{"id": 210, "speaker": 16, "form": "dlg", "jp": "「そんなのは最初からわかってたんじゃないの？」"},
{"id": 211, "speaker": 16, "form": "dlg", "jp": "「地球人じゃないってことぐらい」"},
{"id": 212, "speaker": 29, "form": "dlg", "jp": "「地球人じゃないからって、\n　宇宙人だとは限らないわよ！」"},
{"id": 213, "speaker": 16, "form": "dlg", "jp": "「じゃあ、あのＵＦＯは‥‥」"},
{"id": 214, "speaker": 18, "form": "dlg", "jp": "「それって初めからわかってたじゃないの？」"},
{"id": 215, "speaker": 18, "form": "dlg", "jp": "「地球人じゃないのは間違いないでしょうし‥‥」"},
{"id": 216, "speaker": 29, "form": "dlg", "jp": "「地球人じゃないからって、\n　宇宙人だとは限らないわよ！」"},
{"id": 217, "speaker": 18, "form": "dlg", "jp": "「じゃあ、あのＵＦＯは‥‥」"},
{"id": 218, "speaker": 3, "form": "dlg", "jp": "「あの～」"},
{"id": 219, "speaker": 3, "form": "dlg", "jp": "「そもそも\n　ＵＦＯが宇宙人の乗り物だっていう話自体が‥‥」"},
{"id": 220, "speaker": 3, "form": "dlg", "jp": "「それに、\n　あれがＵＦＯなのかどうかも‥‥」"},
{"id": 221, "speaker": 35, "form": "dlg", "jp": "「でも、あのＵＦＯが人類にたいして\n　攻撃的だってことは間違いなさそうだね」"},
{"id": 222, "speaker": 35, "form": "dlg", "jp": "「ありゃ、どうみても無差別攻撃だし‥‥」"},
{"id": 223, "speaker": 3, "form": "dlg", "jp": "「あと‥‥」"},
{"id": 224, "speaker": 29, "form": "dlg", "jp": "「なんでしょうか？」"},
{"id": 225, "speaker": 3, "form": "dlg", "jp": "「さっきから話している『ゲーマー』って？」"},
{"id": 226, "speaker": 31, "form": "dlg", "jp": "「気にしないでください、\n　仲間うちの流行り言葉ですよ！！」"},
{"id": 227, "speaker": 29, "form": "dlg", "jp": "「そんなことより、ゲーマーの攻撃が\n　本格的に始まったのは間違いないわよ！」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「なんで、そう言い切れるの？」"},
{"id": 229, "speaker": 29, "form": "dlg", "jp": "「例のいやな感覚を感じるのよ！」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「いやな感覚？」"},
{"id": 231, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 232, "speaker": 29, "form": "dlg", "jp": "「あのロボットの時に感じたのと同じあの感覚‥‥」"},
{"id": 233, "speaker": 31, "form": "dlg", "jp": "「ちくしょうめ！」"},
{"id": 234, "speaker": 15, "form": "dlg", "jp": "「無差別攻撃だとしたら、この町も‥‥」"},
{"id": 235, "speaker": 35, "form": "dlg", "jp": "「あの破壊力からすると、町どころか‥‥」"},
{"id": 236, "speaker": 35, "form": "dlg", "jp": "「この『国』もあぶないね‥‥」"},
{"id": 237, "speaker": 35, "form": "dlg", "jp": "「自衛隊にもあそこまでの攻撃力を持った\n　武器は存在しないから‥‥」"},
{"id": 238, "speaker": 15, "form": "dlg", "jp": "「じゃあ、家族や、学校のみんなも‥‥」"},
{"id": 239, "speaker": 29, "form": "dlg", "jp": "「当然ね‥‥」"},
{"id": 240, "speaker": 29, "form": "dlg", "jp": "「もしかしたら、アナタの知り合いが\n　すでにあの攻撃の中にいたかも知れないわね‥‥」"},
{"id": 241, "speaker": 15, "form": "dlg", "jp": "「そんなぁ‥‥」"},
{"id": 242, "speaker": 16, "form": "dlg", "jp": "「無差別攻撃だとしたら、この町も‥‥」"},
{"id": 243, "speaker": 35, "form": "dlg", "jp": "「あの破壊力からすると、町どころか‥‥」"},
{"id": 244, "speaker": 35, "form": "dlg", "jp": "「この『国』もあぶないね‥‥」"},
{"id": 245, "speaker": 35, "form": "dlg", "jp": "「自衛隊にもあそこまでの攻撃力を持った\n　武器は存在しないから‥‥」"},
{"id": 246, "speaker": 16, "form": "dlg", "jp": "「じゃあ、家族や、学校のみんなも‥‥」"},
{"id": 247, "speaker": 29, "form": "dlg", "jp": "「当然ね‥‥」"},
{"id": 248, "speaker": 29, "form": "dlg", "jp": "「もしかしたら、アナタの知り合いが\n　すでにあの攻撃の中にいたかも知れないわね‥‥」"},
{"id": 249, "speaker": 16, "form": "dlg", "jp": "「そんなぁ‥‥」"},
{"id": 250, "speaker": 18, "form": "dlg", "jp": "「無差別攻撃だとしたら、この町も‥‥」"},
{"id": 251, "speaker": 35, "form": "dlg", "jp": "「あの破壊力からすると、町どころか‥‥」"},
{"id": 252, "speaker": 35, "form": "dlg", "jp": "「この『国』もあぶないね‥‥」"},
{"id": 253, "speaker": 35, "form": "dlg", "jp": "「自衛隊にもあそこまでの攻撃力を持った\n　武器は存在しないから‥‥」"},
{"id": 254, "speaker": 18, "form": "dlg", "jp": "「じゃあ、家族や、学校のみんなも‥‥」"},
{"id": 255, "speaker": 29, "form": "dlg", "jp": "「当然ね‥‥」"},
{"id": 256, "speaker": 29, "form": "dlg", "jp": "「もしかしたら、アナタの知り合いが\n　すでにあの攻撃の中にいたかも知れないわね‥‥」"},
{"id": 257, "speaker": 18, "form": "dlg", "jp": "「そんなぁ‥‥」"},
{"id": 258, "speaker": 29, "form": "dlg", "jp": "「だいたい『ゲーマー』は、\n　『人類全体』をターゲットにしているハズだから‥‥」"},
{"id": 259, "speaker": 29, "form": "dlg", "jp": "「『町』とか『国』とかは\n　問題じゃないわよ！！」"},
{"id": 260, "speaker": 29, "form": "dlg", "jp": "「だから、私たちが戦うのよ！」"},
{"id": 261, "speaker": 31, "form": "dlg", "jp": "「だな‥‥」"},
{"id": 262, "speaker": 31, "form": "dlg", "jp": "「いつの時代も、最初に犠牲者になるのは\n　『弱い者たち』だ‥‥」"},
{"id": 263, "speaker": 31, "form": "dlg", "jp": "「できるだけ早く、対処しないと‥‥」"},
{"id": 264, "speaker": 15, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 265, "speaker": 15, "form": "dlg", "jp": "「私たちで大丈夫なのかしら‥‥‥」"},
{"id": 266, "speaker": 16, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 267, "speaker": 16, "form": "dlg", "jp": "「アキラたちで大丈夫なのかしら‥‥‥」"},
{"id": 268, "speaker": 18, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 269, "speaker": 18, "form": "dlg", "jp": "「私たちで大丈夫なのかしら‥‥‥」"},
{"id": 270, "speaker": 18, "form": "choice", "jp": "「ダイジョウブじゃないけど‥‥」"},
{"id": 271, "speaker": 18, "form": "choice", "jp": "「ダイジョウブだよ！」"},
{"id": 272, "speaker": 18, "form": "choice", "jp": "「ダイブジョウブだよ？」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「ダイジョウブじゃないけど‥‥」"},
{"id": 274, "speaker": 2, "form": "dlg", "jp": "「やるしかないんだよな‥‥」"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "「ダイブジョウブだよ？」"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "「あの『ＵＦＯ』‥‥」"},
{"id": 277, "speaker": 2, "form": "dlg", "jp": "「それでも、やるしかないんだよな‥‥」"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "「ダイジョウブだよ！」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "「ボクたちは選ばれた人間なんだ！」"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "「あんな『ＵＦＯ』ぐらいで\n　ビビってちゃダメだよ！」"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "「『ゲーマー』だか、『宇宙人』だかしらないけど\n　『地球人の意地』を見せつけてやろうよ！」"},
{"id": 282, "speaker": 29, "form": "dlg", "jp": "「こうなったら、一刻も早く本部に行きましょう！！」"},
{"id": 283, "speaker": 29, "form": "choice", "jp": "「わかったよ！」"},
{"id": 284, "speaker": 29, "form": "choice", "jp": "「ちょっと待って！」"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "「さっきも言ったけど、そんなに急には‥‥」"},
{"id": 287, "speaker": 29, "form": "dlg", "jp": "「何言ってんの！！」"},
{"id": 288, "speaker": 29, "form": "dlg", "jp": "「この状況なのよ、\n　家族の人にだって説明がつくでしょ！」"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "「今、自分たちの国が攻撃されているのに、\n　それをほっておいて外国には‥‥」"},
{"id": 291, "speaker": 35, "form": "dlg", "jp": "「オレもそうだな‥‥」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「わかったよ！」"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "「この状態なら、姉さんにも説明がしやすいしね‥‥」"},
{"id": 294, "speaker": 35, "form": "dlg", "jp": "「オレはダメだよ！」"},
{"id": 295, "speaker": 29, "form": "dlg", "jp": "「何言ってんの！！」"},
{"id": 296, "speaker": 29, "form": "dlg", "jp": "「さっきは『いつでも行ける』って\n　言ってたじゃない！」"},
{"id": 297, "speaker": 35, "form": "dlg", "jp": "「自分の国が攻撃されてんのに‥‥」"},
{"id": 298, "speaker": 35, "form": "dlg", "jp": "「まず、アイツを止めてからじゃないと、\n　この国を出て行くわけにはいかないよ！」"},
{"id": 299, "speaker": 15, "form": "dlg", "jp": "「私も、あのＵＦＯをそのままにしておいては‥‥」"},
{"id": 300, "speaker": 15, "form": "dlg", "jp": "「‥‥ねえ、どっちにしてもゲーマーと\n　戦わなくちゃいけないんでしょう？」"},
{"id": 301, "speaker": 15, "form": "dlg", "jp": "「それなら、まずあのＵＦＯを壊しちゃってから、\n　ペルーに行くってのはどうなの？」"},
{"id": 302, "speaker": 16, "form": "dlg", "jp": "「アキラも\n　あのＵＦＯをそのままにしておいては‥‥」"},
{"id": 303, "speaker": 16, "form": "dlg", "jp": "「ねえ、どっちにしてもゲーマーと\n　戦わなくちゃいけないんでしょう？」"},
{"id": 304, "speaker": 16, "form": "dlg", "jp": "「それなら、まずあのＵＦＯを壊しちゃってから、\n　ペルーに行くってのはどうなの？」"},
{"id": 305, "speaker": 18, "form": "dlg", "jp": "「私も、\n　あのＵＦＯをそのままにしておいて行くのは‥‥」"},
{"id": 306, "speaker": 18, "form": "dlg", "jp": "「あのぅ‥‥」"},
{"id": 307, "speaker": 18, "form": "dlg", "jp": "「どっちにしても\n　ゲーマーと戦わなくちゃいけないんなら‥‥」"},
{"id": 308, "speaker": 18, "form": "dlg", "jp": "「まずあのＵＦＯを壊しちゃうってのは？」"},
{"id": 309, "speaker": 29, "form": "dlg", "jp": "「なんか、勝手なことばっかり言ってるわね」"},
{"id": 310, "speaker": 31, "form": "dlg", "jp": "「彼らの言うこともわからないでもないな」"},
{"id": 311, "speaker": 29, "form": "dlg", "jp": "「ちょっと！　ケネスまで何言いだすのよ！」"},
{"id": 312, "speaker": 31, "form": "dlg", "jp": "「でも、そうだろう？」"},
{"id": 313, "speaker": 31, "form": "dlg", "jp": "「自分の家族の命が危ないのに‥‥」"},
{"id": 314, "speaker": 29, "form": "dlg", "jp": "「それはわかるけど、\n　私たちだけでゲーマーと戦えると？」"},
{"id": 315, "speaker": 31, "form": "dlg", "jp": "「そんなの本部と合流しても同じだよ！」"},
{"id": 316, "speaker": 31, "form": "dlg", "jp": "「だいたい、ゲーマーのことなんか、\n　本部もくわしくは知らないんだから」"},
{"id": 317, "speaker": 31, "form": "dlg", "jp": "「ＵＦＯの１機ぐらいは、\n　オレたちで倒すことができるかもよ！」"},
{"id": 318, "speaker": 31, "form": "dlg", "jp": "「それに、ゲーマーのＵＦＯを１つ破壊してからの方が\n　いいミヤゲになるんじゃぁないか？」"},
{"id": 319, "speaker": 29, "form": "dlg", "jp": "「う～～ん」"},
{"id": 320, "speaker": 29, "form": "dlg", "jp": "「仕方ないわね‥‥」"},
{"id": 321, "speaker": 35, "form": "dlg", "jp": "「じゃぁ、そのＵＦＯを！！」"},
{"id": 322, "speaker": 29, "form": "dlg", "jp": "「そうじゃないと本部に来ないんでしょう？」"},
{"id": 323, "speaker": 29, "form": "dlg", "jp": "「その代わり、ムチャは禁止よ！」"},
{"id": 324, "speaker": 29, "form": "dlg", "jp": "「今回は相手の力を探る、\n　偵察（テイサツ）ということで‥‥」"},
{"id": 325, "speaker": 35, "form": "dlg", "jp": "「ありがとう！！」"},
{"id": 326, "speaker": 15, "form": "dlg", "jp": "「でも、もし倒せそうなら\n　倒しちゃっていいんでしょう？」"},
{"id": 327, "speaker": 29, "form": "dlg", "jp": "「倒す夢でも見たの？」"},
{"id": 328, "speaker": 15, "form": "dlg", "jp": "「見てないけど‥‥」"},
{"id": 329, "speaker": 29, "form": "dlg", "jp": "「それに、アナタには戦闘能力がないから、\n　ここで大人しく待機しててもらうから‥‥」"},
{"id": 330, "speaker": 15, "form": "dlg", "jp": "「そんなぁ‥‥」"},
{"id": 331, "speaker": 3, "form": "dlg", "jp": "「あの‥‥」"},
{"id": 332, "speaker": 3, "form": "dlg", "jp": "「さっきから、\n　いったい何の話をしているのかしら？」"},
{"id": 333, "speaker": 3, "form": "dlg", "jp": "「何か物騒（ブッソウ）な風にも\n　聞こえるんですけど‥‥」"},
{"id": 334, "speaker": 2, "form": "dlg", "jp": "「アイコ‥‥」"},
{"id": 335, "speaker": 2, "form": "dlg", "jp": "「やっぱり、ここに残って、\n　姉さんに説明してくれないか？」"},
{"id": 336, "speaker": 15, "form": "dlg", "jp": "「説明って‥‥」"},
{"id": 337, "speaker": 16, "form": "dlg", "jp": "「でも、もし倒せそうなら\n　倒しちゃっていいんでしょう？」"},
{"id": 338, "speaker": 29, "form": "dlg", "jp": "「倒す夢でも見たの？」"},
{"id": 339, "speaker": 16, "form": "dlg", "jp": "「見てないけど‥‥」"},
{"id": 340, "speaker": 29, "form": "dlg", "jp": "「それに、アナタには戦闘能力がないから、\n　ここで大人しく待機しててもらうから‥‥」"},
{"id": 341, "speaker": 16, "form": "dlg", "jp": "「えぇっ、またなの？」"},
{"id": 342, "speaker": 3, "form": "dlg", "jp": "「あの‥‥」"},
{"id": 343, "speaker": 3, "form": "dlg", "jp": "「さっきから、\n　いったい何の話をしているのかしら？」"},
{"id": 344, "speaker": 3, "form": "dlg", "jp": "「何か物騒（ブッソウ）な風にも\n　聞こえるんですけど‥‥」"},
{"id": 345, "speaker": 2, "form": "dlg", "jp": "「長尾‥‥」"},
{"id": 346, "speaker": 2, "form": "dlg", "jp": "「やっぱり、ここに残って、\n　姉さんに説明してくれないか？」"},
{"id": 347, "speaker": 16, "form": "dlg", "jp": "「説明って‥‥」"},
{"id": 348, "speaker": 18, "form": "dlg", "jp": "「でも、もし倒せそうなら\n　倒しちゃっていいんでしょう？」"},
{"id": 349, "speaker": 29, "form": "dlg", "jp": "「倒す夢でも見たの？」"},
{"id": 350, "speaker": 18, "form": "dlg", "jp": "「見てません‥‥」"},
{"id": 351, "speaker": 29, "form": "dlg", "jp": "「それに、アナタには戦闘能力がないから、\n　ここで大人しく待機しててもらうから‥‥」"},
{"id": 352, "speaker": 18, "form": "dlg", "jp": "「そんなぁ‥‥」"},
{"id": 353, "speaker": 3, "form": "dlg", "jp": "「あの‥‥」"},
{"id": 354, "speaker": 3, "form": "dlg", "jp": "「さっきから、\n　いったい何の話をしているのかしら？」"},
{"id": 355, "speaker": 3, "form": "dlg", "jp": "「何か物騒（ブッソウ）な風にも\n　聞こえるんですけど‥‥」"},
{"id": 356, "speaker": 2, "form": "dlg", "jp": "「堤さん‥‥」"},
{"id": 357, "speaker": 2, "form": "dlg", "jp": "「やっぱり、ここに残って、\n　姉さんに説明してくれないか？」"},
{"id": 358, "speaker": 18, "form": "dlg", "jp": "「説明って‥‥」"},
{"id": 359, "speaker": 2, "form": "dlg", "jp": "「大変かもしれないけど‥‥」"},
{"id": 360, "speaker": 2, "form": "dlg", "jp": "「姉さんは物わかりのいい人だから‥‥」"},
