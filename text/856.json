[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／１９／ＡＭ１０：０５"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 2, "speaker": 13, "form": "dlg", "jp": "「遅いよ！」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「ゴ、ゴメン‥‥」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「アレ、女の子たちは？」"},
{"id": 5, "speaker": 14, "form": "dlg", "jp": "「オマエが遅いから、先に中に入ってるよ！」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "ボクがどうして遅刻したかというと、\n朝一番でジーンから連絡があったからだ‥‥"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "ボクは遊園地に行くことを黙っていようとしたが、\n『テレパシー』でバレてしまい。"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "長時間、説教をくらったワケだ‥‥"},
{"id": 10, "speaker": 14, "form": "dlg", "jp": "「じゃあ入るぞ！」"},
{"id": 11, "speaker": 16, "form": "dlg", "jp": "「チィーッス！」"},
{"id": 12, "speaker": 18, "form": "dlg", "jp": "「コンニチハ‥‥」"},
{"id": 13, "speaker": 15, "form": "dlg", "jp": "「遅かったわね‥‥」"},
{"id": 14, "speaker": 51, "form": "dlg", "jp": "「オッス！」"},
{"id": 15, "speaker": 16, "form": "dlg", "jp": "「チィーッス！」"},
{"id": 16, "speaker": 15, "form": "dlg", "jp": "「遅かったわね‥‥」"},
{"id": 17, "speaker": 15, "form": "dlg", "jp": "「何かあったの？」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "（もう来てたの？）"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "（ジーンにしかられなかった？）"},
{"id": 20, "speaker": 15, "form": "dlg", "jp": "（べつに‥‥）"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "（ウソ！）"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "（ボクはゴマかそうとしたけど、\n　長々と説教をされたよ‥‥）"},
{"id": 23, "speaker": 15, "form": "dlg", "jp": "（そんなことするからよ！）"},
{"id": 24, "speaker": 15, "form": "dlg", "jp": "（ジーンみたいなタイプはウソをつかれたら\n　余計に怒り出すのよ！）"},
{"id": 25, "speaker": 15, "form": "dlg", "jp": "（私は正直に言ったから何も言われなかったわよ！）"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "（そうなんだ‥‥）"},
{"id": 27, "speaker": 16, "form": "dlg", "jp": "「何かあったの？」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "（もう来てたの？）"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "（ジーンにしかられなかった？）"},
{"id": 30, "speaker": 16, "form": "dlg", "jp": "（べつに‥‥）"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "（ウソ！）"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "（ボクはゴマかそうとしたけど、\n　長々と説教をされたよ‥‥）"},
{"id": 33, "speaker": 16, "form": "dlg", "jp": "（だからじゃない？）"},
{"id": 34, "speaker": 16, "form": "dlg", "jp": "（アキラは正直に話したけどなにも言われなかったから‥‥）"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "（そうなんだ‥‥）"},
{"id": 36, "speaker": 18, "form": "dlg", "jp": "「何かあったの？」"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "（もう来てたの？）"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "（ジーンにしかられなかった？）"},
{"id": 39, "speaker": 18, "form": "dlg", "jp": "（べつに‥‥）"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "（ウソ！）"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "（ボクはゴマかそうとしたけど、\n　長々と説教をされたよ‥‥）"},
{"id": 42, "speaker": 18, "form": "dlg", "jp": "（だからじゃないかしら？）"},
{"id": 43, "speaker": 18, "form": "dlg", "jp": "（私は正直に話したけどなにも言われなかったから‥‥）"},
{"id": 44, "speaker": 2, "form": "dlg", "jp": "（そうなんだ‥‥）"},
{"id": 45, "speaker": 51, "form": "dlg", "jp": "「遅かったな！」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "（もう来てたの？）"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "（ジーンにしかられなかった？）"},
{"id": 48, "speaker": 51, "form": "dlg", "jp": "（ぜんぜん‥‥）"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "（ウソ！）"},
{"id": 50, "speaker": 51, "form": "dlg", "jp": "（もしかして、ゴマかそうとしたん？）"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "（うん、すぐにバレたけど！）"},
{"id": 52, "speaker": 51, "form": "dlg", "jp": "（ウチは正直にゆうたから‥‥）"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "（そうなんだ‥‥）"},
{"id": 54, "speaker": 13, "form": "dlg", "jp": "「そう言えば、オマエ昨日の\n　『模試（モシ）』受けてなかったみたいだけど」"},
{"id": 55, "speaker": 13, "form": "dlg", "jp": "「大丈夫なのか？」"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "「『模試』なんかあったの？」"},
{"id": 57, "speaker": 13, "form": "dlg", "jp": "「それすら知らなかったのか？」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「わ、忘れてたよ‥‥」"},
{"id": 59, "speaker": 14, "form": "dlg", "jp": "「大丈夫だよ！」"},
{"id": 60, "speaker": 14, "form": "dlg", "jp": "「オレも受けてないし‥‥」"},
{"id": 61, "speaker": 14, "form": "dlg", "jp": "「『模試』を受けなかったからって\n　『受験』には何も関係ないよ！」"},
{"id": 62, "speaker": 15, "form": "dlg", "jp": "「そういえば、ナゴムちゃんは\n　宿題はちゃんとやってるの？」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「かろうじて、それだけは‥‥」"},
{"id": 64, "speaker": 14, "form": "dlg", "jp": "「せっかく遊びに来てるのに\n　ウザイ話ばかりするなよな！」"},
{"id": 65, "speaker": 13, "form": "dlg", "jp": "「たしかに‥‥」"},
{"id": 66, "speaker": 13, "form": "dlg", "jp": "「勉強の話は１日１時間までだな‥‥」"},
{"id": 67, "speaker": 14, "form": "dlg", "jp": "「それはそれで問題あるかと‥‥」"},
{"id": 68, "speaker": 13, "form": "dlg", "jp": "「そういえば、最近ナゴム付き合い悪いけど、\n　もしかして真剣に受験勉強に目覚めたとか？」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "（イヤなことを言うなぁ～）"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "（コッチは受験勉強どころじゃないのに‥‥）"},
{"id": 71, "speaker": 2, "form": "choice", "jp": "「違うよ！」"},
{"id": 72, "speaker": 2, "form": "choice", "jp": "「その通りだよ！」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「違うよ！」"},
{"id": 74, "speaker": 13, "form": "dlg", "jp": "「じゃあなんだ？」"},
{"id": 75, "speaker": 13, "form": "dlg", "jp": "「ネットゲームにハマって、\n　ヒキコモリになってしまったのか？」"},
{"id": 76, "speaker": 14, "form": "dlg", "jp": "「それをツトムに言われるとつらいなぁ～」"},
{"id": 77, "speaker": 13, "form": "dlg", "jp": "「大丈夫、オレはヒキコモらないから‥‥」"},
{"id": 78, "speaker": 13, "form": "dlg", "jp": "「ちゃんと、ゲーセンやゲームショウにも\n　足を運ぶようにしてるから‥‥」"},
{"id": 79, "speaker": 15, "form": "dlg", "jp": "「あんまり大丈夫そうに聞こえないけど‥‥」"},
{"id": 80, "speaker": 13, "form": "dlg", "jp": "「オレのことより、ナゴムだよ！」"},
{"id": 81, "speaker": 13, "form": "dlg", "jp": "「引きこもっていったい何してるんだよ！」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「ボクは‥‥」"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "「ホラ、ルードの事件とかいろいろあったから\n　あんまり外出できなかっただけだよ‥‥」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「その通りだよ！」"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "「やっぱ、後で後悔したくないだろう？」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「後で勉強しておけば良かったって‥‥」"},
{"id": 87, "speaker": 13, "form": "dlg", "jp": "「どうだろう？」"},
{"id": 88, "speaker": 13, "form": "dlg", "jp": "「勉強はいつでもできるけど」"},
{"id": 89, "speaker": 13, "form": "dlg", "jp": "「遊ぶのは子供のウチじゃないと‥‥」"},
{"id": 90, "speaker": 14, "form": "dlg", "jp": "「そうかな？」"},
{"id": 91, "speaker": 14, "form": "dlg", "jp": "「遊び呆けている大人もいると思うけどな‥‥」"},
{"id": 92, "speaker": 13, "form": "dlg", "jp": "「まあ、大人は大人の遊びがあるかもしれないけど」"},
{"id": 93, "speaker": 13, "form": "dlg", "jp": "「大人になってゲームを遊ぶわけには‥‥」"},
{"id": 94, "speaker": 14, "form": "dlg", "jp": "「じゃあツトムは大人になると、\n　ゲームを卒業するんだな？」"},
{"id": 95, "speaker": 13, "form": "dlg", "jp": "「もちろんだよ！」"},
{"id": 96, "speaker": 13, "form": "dlg", "jp": "「自分の子供が大学に行く頃には\n　卒業するつもりだよ！」"},
{"id": 97, "speaker": 15, "form": "dlg", "jp": "「遊んでばかりのヒトの子供が\n　大学なんか入れるのかしら？」"},
{"id": 98, "speaker": 16, "form": "dlg", "jp": "「まあ、\n　今日ぐらいは楽しく過ごしたらいいんじゃないの？」"},
{"id": 99, "speaker": 16, "form": "dlg", "jp": "こうしてボクたちは受験や宿題のことを\n今日１日は忘れて過ごすことにした。"},
{"id": 100, "speaker": 16, "form": "dlg", "jp": "「ねえ、"},
{"id": 101, "speaker": 16, "form": "dlg", "jp": "『オバケ屋敷』"},
{"id": 102, "speaker": 16, "form": "dlg", "jp": "があるわよ！」"},
{"id": 103, "speaker": 16, "form": "dlg", "jp": "「みんなで入らない？」"},
{"id": 104, "speaker": 14, "form": "dlg", "jp": "「長尾はやっぱり、そっち方面かよ‥‥」"},
{"id": 105, "speaker": 16, "form": "dlg", "jp": "「何よ、ソッチ方面って！！」"},
{"id": 106, "speaker": 13, "form": "dlg", "jp": "「でも、こういうのって、\n　機械じかけのものが並んでるだけだろう？」"},
{"id": 107, "speaker": 16, "form": "dlg", "jp": "「何言ってるのよ！」"},
{"id": 108, "speaker": 16, "form": "dlg", "jp": "「最近は人間が直接オバケを演じてるの」"},
{"id": 109, "speaker": 16, "form": "dlg", "jp": "「だから、リアルですっごくコワイんだって‥‥」"},
{"id": 110, "speaker": 15, "form": "dlg", "jp": "「おもしろそうね？」"},
{"id": 111, "speaker": 14, "form": "dlg", "jp": "「よし、ちょっとのぞいてみるか？」"},
{"id": 112, "speaker": 16, "form": "dlg", "jp": "「ねぇ、せっかくだから２人ずつのペアで入らない？」"},
{"id": 113, "speaker": 16, "form": "dlg", "jp": "「みんなで入ってもこわくないでしょう？」"},
{"id": 114, "speaker": 14, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 115, "speaker": 13, "form": "dlg", "jp": "「よし、オレが公平なクジを作ってやる！」"},
{"id": 116, "speaker": 13, "form": "dlg", "jp": "こうして、男女ペアの組みわけがされることになった。"},
{"id": 117, "speaker": 15, "form": "dlg", "jp": "「やっぱり、ナゴムちゃんとペアか‥‥」"},
{"id": 118, "speaker": 15, "form": "dlg", "jp": "「これってクサレ縁ってヤツ？」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "（もしかして『能力者は引き寄せられる』って\n　いうヤツじゃぁ？）"},
{"id": 120, "speaker": 16, "form": "dlg", "jp": "「アキラたちがトップね！」"},
{"id": 121, "speaker": 13, "form": "dlg", "jp": "「オマエほんとにうれしそうだな‥‥」"},
{"id": 122, "speaker": 16, "form": "dlg", "jp": "「さあ、行くわよ！」"},
{"id": 123, "speaker": 16, "form": "dlg", "jp": "「アキラは常光寺くんとペアね？」"},
{"id": 124, "speaker": 16, "form": "dlg", "jp": "ボクは長尾とペアになった。"},
{"id": 125, "speaker": 16, "form": "dlg", "jp": "（これってグウゼンかな？）"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "（もしかして『能力者は引き寄せられる』って\n　いうヤツじゃぁ？）"},
{"id": 127, "speaker": 15, "form": "dlg", "jp": "「じゃあ、私たちがトップね！」"},
{"id": 128, "speaker": 13, "form": "dlg", "jp": "「三船、ギャーギャーさわぐなよ‥‥」"},
{"id": 129, "speaker": 15, "form": "dlg", "jp": "「ダイジョウブよ、こういうの平気だから‥‥」"},
{"id": 130, "speaker": 18, "form": "dlg", "jp": "「よろしく‥‥」"},
{"id": 131, "speaker": 18, "form": "dlg", "jp": "ボクは堤さんとペアになった。"},
{"id": 132, "speaker": 18, "form": "dlg", "jp": "（これってグウゼン？）"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "（もしかして『能力者は引き寄せられる』って\n　いうヤツじゃぁ？）"},
{"id": 134, "speaker": 16, "form": "dlg", "jp": "「アキラたちがトップね！」"},
{"id": 135, "speaker": 13, "form": "dlg", "jp": "「オマエほんとにうれしそうだな‥‥」"},
{"id": 136, "speaker": 16, "form": "dlg", "jp": "「さあ、行くわよ！」"},
{"id": 137, "speaker": 51, "form": "dlg", "jp": "「ウチは常光寺とペアか‥‥」"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "「よろしく‥‥」"},
{"id": 139, "speaker": 51, "form": "dlg", "jp": "（これってグウゼン？）"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "（もしかして『能力者は引き寄せられる』って\n　いうヤツじゃぁ？）"},
{"id": 141, "speaker": 16, "form": "dlg", "jp": "「アキラたちがトップね！」"},
{"id": 142, "speaker": 13, "form": "dlg", "jp": "「オマエほんとにうれしそうだな‥‥」"},
{"id": 143, "speaker": 16, "form": "dlg", "jp": "「さあ、行くわよ！」"},
{"id": 144, "speaker": 16, "form": "dlg", "jp": "ボクたちは１０分置きに\n順番にお化け屋敷に入ることになり、"},
{"id": 145, "speaker": 16, "form": "dlg", "jp": "ボクたちのグループが１番最後に\n入ることになった。"},
{"id": 146, "speaker": 14, "form": "dlg", "jp": "「じゃあ、行ってくるぜ！」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「がんばってね！」"},
{"id": 148, "speaker": 15, "form": "dlg", "jp": "「オバケ屋敷って、久しぶりね‥‥」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「そう言えば、幼稚園の時にいっしょに入ったね」"},
{"id": 150, "speaker": 15, "form": "dlg", "jp": "「あの時、途中でナゴムちゃんが泣き出して\n　オバケに出口まで送ってもらったんだよね‥‥」"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「イヤなこと覚えてるなぁ～」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「で、アイコはコワクないのかい？」"},
{"id": 153, "speaker": 15, "form": "dlg", "jp": "「ぜんぜん‥‥」"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "「そうだね、アイコは強いもんな」"},
{"id": 155, "speaker": 15, "form": "dlg", "jp": "「案外こんなのって女の子の方が平気なのかも？」"},
{"id": 156, "speaker": 15, "form": "dlg", "jp": "「それに、『人類滅亡』とかそんな目にあってるのに\n　作り物のオバケなんかコワがってられないし‥‥」"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "「まあ、それもそうだね‥‥」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「そろそろ入ろうか？」"},
{"id": 159, "speaker": 15, "form": "dlg", "jp": "「うん！！」"},
{"id": 160, "speaker": 15, "form": "dlg", "jp": "ボクたちも中に入ることにした。"},
{"id": 161, "speaker": 16, "form": "dlg", "jp": "「オバケ屋敷って、久しぶり‥‥」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「こわくないの？」"},
{"id": 163, "speaker": 16, "form": "dlg", "jp": "「ぜんぜん‥‥」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「そうだね、長尾は強いもんな」"},
{"id": 165, "speaker": 16, "form": "dlg", "jp": "「案外こんなのって女の子の方が平気なのかも？」"},
{"id": 166, "speaker": 16, "form": "dlg", "jp": "「それに、『人類滅亡』とかそんな目にあってるのに\n　作り物のオバケなんかコワがってられないし‥‥」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「まあ、それもそうだね‥‥」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「そろそろ入ろうか？」"},
{"id": 169, "speaker": 16, "form": "dlg", "jp": "「うん！！」"},
{"id": 170, "speaker": 16, "form": "dlg", "jp": "ボクたちも中に入ることにした。"},
{"id": 171, "speaker": 18, "form": "dlg", "jp": "「私、オバケ屋敷に入るの初めてかも‥‥」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「大丈夫？、こわくない？」"},
{"id": 173, "speaker": 18, "form": "dlg", "jp": "「たぶん大丈夫‥‥」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「へぇ、堤さんって結構強いんだ‥‥」"},
{"id": 175, "speaker": 18, "form": "dlg", "jp": "「案外こういうのって女の子の方が\n　平気なのかも？」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「そろそろ入ろうか？」"},
{"id": 178, "speaker": 18, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 179, "speaker": 18, "form": "dlg", "jp": "ボクたちも中に入ることにした。"},
{"id": 180, "speaker": 51, "form": "dlg", "jp": "「オバケ屋敷やなんてホンマひさしぶりやわ‥‥」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「こわくないの？」"},
{"id": 182, "speaker": 51, "form": "dlg", "jp": "「ぜんぜん‥‥」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「そうだね、小田は強いもんな」"},
{"id": 184, "speaker": 51, "form": "dlg", "jp": "「案外こんなんって女の子の方が\n　平気なんとちゃうかな？」"},
{"id": 185, "speaker": 51, "form": "dlg", "jp": "「それに、『人類滅亡』とかそんな目にあってるのに\n　作り物のオバケなんかコワがってられへんやろう？」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「まあ、それもそうだね‥‥」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「そろそろ入ろうか？」"},
{"id": 188, "speaker": 51, "form": "dlg", "jp": "「うん、そうやね‥‥」"},
{"id": 189, "speaker": 51, "form": "dlg", "jp": "ボクたちも中に入ることにした。"},
{"id": 190, "speaker": 51, "form": "dlg", "jp": "そして‥‥"},
{"id": 191, "speaker": 13, "form": "dlg", "jp": "「やっぱり、つまらなかったな‥‥」"},
{"id": 192, "speaker": 13, "form": "dlg", "jp": "「だいたい、『オバケ』って存在自体が作り物だから\n　その作り物をさらに作り物にしても‥‥」"},
{"id": 193, "speaker": 14, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 194, "speaker": 14, "form": "dlg", "jp": "「今なら、オバケとかより、\n　『殺人鬼』の方が恐ろしいよな‥‥」"},
{"id": 195, "speaker": 15, "form": "dlg", "jp": "「っていうか、\n　２人とも始めからコワがるつもりないんだもん！」"},
{"id": 196, "speaker": 14, "form": "dlg", "jp": "「そういうオマエたちだって、\n　ぜんぜんコワがってないだろう？」"},
{"id": 197, "speaker": 15, "form": "dlg", "jp": "「でも、１回だけ声出そうになったわよ！！」"},
{"id": 198, "speaker": 16, "form": "dlg", "jp": "「もしかして、『女の子』じゃない？」"},
{"id": 199, "speaker": 15, "form": "dlg", "jp": "「そう！」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "「長尾なんか、オバケの解説してるんだもん！」"},
{"id": 201, "speaker": 16, "form": "dlg", "jp": "「でも、１回だけ声出そうになったわよ！！」"},
{"id": 202, "speaker": 15, "form": "dlg", "jp": "「もしかして、『女の子』じゃない？」"},
{"id": 203, "speaker": 16, "form": "dlg", "jp": "「そう！」"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "「うん、アイコはともかく、\n　堤さんとかもっと怖がると思ってたよ！」"},
{"id": 205, "speaker": 18, "form": "dlg", "jp": "「でも、１回だけ声出そうになったわよ！」"},
{"id": 206, "speaker": 15, "form": "dlg", "jp": "「もしかして、『女の子』じゃない？」"},
{"id": 207, "speaker": 18, "form": "dlg", "jp": "「そう！」"},
{"id": 208, "speaker": 51, "form": "dlg", "jp": "「でも、１回だけ声出そうになったけどな！」"},
{"id": 209, "speaker": 15, "form": "dlg", "jp": "「もしかして、『女の子』じゃない？」"},
{"id": 210, "speaker": 51, "form": "dlg", "jp": "「そう！」"},
{"id": 211, "speaker": 14, "form": "dlg", "jp": "「オレもアレはおどろいた！」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "「ボ、ボクも‥‥」"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "みんなが言う『女の子』とは、\n中でポツンと立っていた『女の子』のことで、"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "ごく普通の１０歳ぐらいの人形みたいに見えるんだけど、\nよく見ると明らかに生きている人間で、"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "でも、他のオバケみたいに突然動き出すわけでもなく、\n本当にピクリとも動かない少女だ。"},
{"id": 216, "speaker": 14, "form": "dlg", "jp": "「普通、少しぐらい動くだろう？」"},
{"id": 217, "speaker": 14, "form": "dlg", "jp": "「マバタキすらしなかったぜ！」"},
{"id": 218, "speaker": 13, "form": "dlg", "jp": "「アレって本当に子供だったら、\n　よく仕込まれてるよな？」"},
{"id": 219, "speaker": 13, "form": "choice", "jp": "「子供じゃないだろう？」"},
{"id": 220, "speaker": 13, "form": "choice", "jp": "「子供だっただろう？」"},
{"id": 221, "speaker": 13, "form": "choice", "jp": "「人形じゃないかな？」"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "「子供じゃないだろう？」"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "「たぶん‥‥」"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "「子供がオバケ屋敷で働かないだろう？」"},
{"id": 225, "speaker": 13, "form": "dlg", "jp": "「それ以前に大人でもマバタキをガマンできるかな？」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「子供だっただろう？」"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「たぶん‥‥」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「人形なら、あんなに恐くないと思うよ」"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "「別に仮装しているわけでも、\n　動き出すわけでもなく立ってるだけなのに」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「どのオバケよりもコワイんだから‥‥」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「人形じゃないかな？」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「だって、１０歳ぐらいに見えたよ？」"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "「いくらプロでも１０歳の子供が\n　マバタキをガマンできるかな？」"},
{"id": 234, "speaker": 13, "form": "dlg", "jp": "「いや、人間だろう？」"},
{"id": 235, "speaker": 13, "form": "dlg", "jp": "「人形なら、あんなに恐くないと思うぜ！」"},
{"id": 236, "speaker": 13, "form": "dlg", "jp": "「別に仮装しているわけでも、\n　動き出すわけでもなく立ってるだけなのに」"},
{"id": 237, "speaker": 13, "form": "dlg", "jp": "「どのオバケよりもコワイんだぜ？」"},
{"id": 238, "speaker": 14, "form": "dlg", "jp": "「関西の小劇団出身の、\n　ヤリなんとかっていう俳優が」"},
{"id": 239, "speaker": 14, "form": "dlg", "jp": "「２０分以上マバタキをしないっていう芝居を\n　上演したことがあるっていうから」"},
{"id": 240, "speaker": 14, "form": "dlg", "jp": "「訓練次第でマバタキはガマンできるんだろうけどな‥‥」"},
{"id": 241, "speaker": 13, "form": "dlg", "jp": "「何にしてもキモチ悪いよな‥‥」"},
{"id": 242, "speaker": 14, "form": "dlg", "jp": "「よし、口直しに『サンダードラゴン』に乗ろうぜ！」"},
{"id": 243, "speaker": 13, "form": "dlg", "jp": "「やだよ、\n　オレはジェットコースターとかはダメなんだ‥‥」"},
{"id": 244, "speaker": 15, "form": "dlg", "jp": "「アラ、ゲームで素早い動きは\n　きたえられてるんじゃぁ？」"},
{"id": 245, "speaker": 13, "form": "dlg", "jp": "「動体視力はきたえられてるけど、\n　重力はちょっと‥‥」"},
{"id": 246, "speaker": 13, "form": "dlg", "jp": "「それに‥‥」"},
{"id": 247, "speaker": 13, "form": "dlg", "jp": "「『サンダードラゴン』もそうだけど、\n　ジェットコースターって名前がダサいジャン！」"},
{"id": 248, "speaker": 13, "form": "dlg", "jp": "「『テンプラ』とか、『ベンテン』とか\n　『ブラックトルネード』とか‥‥」"},
{"id": 249, "speaker": 13, "form": "dlg", "jp": "「そういうのに乗るとセンスが疑われるだろう？」"},
{"id": 250, "speaker": 14, "form": "dlg", "jp": "「そんないいわけで\n　逃げられると思ってるのか？」"},
{"id": 251, "speaker": 14, "form": "dlg", "jp": "「さあ、行くぞ‥‥」"},
{"id": 252, "speaker": 13, "form": "dlg", "jp": "「ええぇ～～～っ」"},
{"id": 253, "speaker": 13, "form": "dlg", "jp": "そして‥‥"},
{"id": 254, "speaker": 14, "form": "dlg", "jp": "「そろそろ帰ろうか‥‥」"},
{"id": 255, "speaker": 15, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 256, "speaker": 16, "form": "dlg", "jp": "「ねえ、最後に『観覧車』に乗らない？」"},
{"id": 257, "speaker": 16, "form": "dlg", "jp": "「さっきみたいに男女ペアで‥‥」"},
{"id": 258, "speaker": 13, "form": "dlg", "jp": "「なんだ、オマエ男にうえてるのか？」"},
{"id": 259, "speaker": 16, "form": "dlg", "jp": "「そんなんじゃないわよ！」"},
{"id": 260, "speaker": 16, "form": "dlg", "jp": "「ただ、ああいうのって\n　カップルで乗らないとさみしく見えるでしょう？」"},
{"id": 261, "speaker": 14, "form": "dlg", "jp": "「たしかに、男３人で乗りたくないな‥‥」"},
{"id": 262, "speaker": 14, "form": "dlg", "jp": "「よし、乗るか‥‥」"},
{"id": 263, "speaker": 14, "form": "dlg", "jp": "「ペアはさっきと同じでいいよな‥‥」"},
{"id": 264, "speaker": 14, "form": "dlg", "jp": "こうしてボクたちは観覧車に乗ることになった。"},
{"id": 265, "speaker": 15, "form": "dlg", "jp": "「なんか、\n　夏休みらしい夏休みを過ごしてるわね‥‥」"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 267, "speaker": 15, "form": "dlg", "jp": "「ジーンが見たらなんて言うかしら‥‥」"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "「間違いなく怒るだろうね？」"},
{"id": 269, "speaker": 2, "form": "dlg", "jp": "「ねえ、そう言えば、\n　新しい『夢』は見ていないの？」"},
{"id": 270, "speaker": 15, "form": "dlg", "jp": "「うん、ぜんぜん‥‥」"},
{"id": 271, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 272, "speaker": 15, "form": "dlg", "jp": "「見たい時に見れないって不便な能力よね‥‥」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「でも、\n　自由に未来が見れたら便利すぎるだろうし‥‥」"},
{"id": 274, "speaker": 15, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 275, "speaker": 15, "form": "dlg", "jp": "「競馬の予想もできちゃうし‥‥」"},
{"id": 276, "speaker": 15, "form": "dlg", "jp": "「なによりも『クリエーター』に勝てるのか\n　そうじゃないのかもわかっちゃうもんね」"},
{"id": 277, "speaker": 15, "form": "dlg", "jp": "「もし、勝てないってわかったら\n　もうすべてがイヤになるもんね？」"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 279, "speaker": 15, "form": "dlg", "jp": "「とにかく、不便でもなんでも」"},
{"id": 280, "speaker": 15, "form": "dlg", "jp": "「『未来』が見えるウチは\n　『未来』があるってことだからいいんだけど‥‥」"},
{"id": 281, "speaker": 15, "form": "choice", "jp": "「そうだね‥‥」"},
{"id": 282, "speaker": 15, "form": "choice", "jp": "「そうじゃないんじゃぁ？」"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 284, "speaker": 2, "form": "dlg", "jp": "「もしかしたら、先の未来が見えないのは、\n　先の未来がまだ決定してないからかも‥‥」"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "「そうじゃないんじゃぁ？」"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "「もしかしたら、先の未来が見えないのは、\n　先の未来がまだ決定してないからかも‥‥」"},
{"id": 287, "speaker": 15, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「やっぱり、世の中ってある程度\n　因果関係ってあろうだろう？」"},
{"id": 289, "speaker": 15, "form": "dlg", "jp": "「で‥‥？」"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "「例えば、『宝くじ』を買うと‥‥」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「『宝くじが当たる未来』や\n　『ハズれる未来』が発生するけど」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「買うまではどちらの未来も発生しないのかも‥‥」"},
{"id": 293, "speaker": 15, "form": "dlg", "jp": "「なるほど！！」"},
{"id": 294, "speaker": 15, "form": "dlg", "jp": "「じゃあ、『クリエーターの夢』を見ないってことは\n　まだ、どうなるか決まってないってことかしら？」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "「その可能性もあるね！」"},
{"id": 296, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃんのわりには\n　いいこと言うわね！」"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "「なんだよ、そのいいグサ！」"},
{"id": 298, "speaker": 15, "form": "dlg", "jp": "「フフフフフフ‥‥」"},
{"id": 299, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん‥‥」"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "「なんだよ‥‥」"},
{"id": 301, "speaker": 15, "form": "dlg", "jp": "「『約束』のこと覚えてる？」"},
{"id": 302, "speaker": 2, "form": "dlg", "jp": "「『約束』‥‥？」"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "（アイコとなにか『約束』したかな？）"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "（‥‥‥）"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥）"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥）"},
{"id": 307, "speaker": 15, "form": "dlg", "jp": "「もう忘れてるわよね‥‥」"},
{"id": 308, "speaker": 15, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥！！）"},
{"id": 309, "speaker": 15, "form": "dlg", "jp": "（思い出した！）"},
{"id": 310, "speaker": 15, "form": "dlg", "jp": "ボクは昔‥‥"},
{"id": 311, "speaker": 15, "form": "dlg", "jp": "小学校の２年か、３年の時‥‥"},
{"id": 312, "speaker": 15, "form": "dlg", "jp": "犬を散歩中のアイコが、\nトラックにひかれそうになったことがあったんだ。"},
{"id": 313, "speaker": 15, "form": "dlg", "jp": "で、とっさにボクはアイコを引き寄せて、\nトラックから守ったんだ。"},
{"id": 314, "speaker": 15, "form": "dlg", "jp": "でも、その時、\nアイコの犬はトラックにひかれて死んじゃったんだ。"},
{"id": 315, "speaker": 15, "form": "dlg", "jp": "で、アイコがあんまり泣き止まないから‥‥"},
{"id": 316, "speaker": 15, "form": "dlg", "jp": "『ボクが助けてやったのが気に入らないのか！』"},
{"id": 317, "speaker": 15, "form": "dlg", "jp": "『なら、もう助けてやらない！』って\n怒鳴っちゃったんだ‥‥"},
{"id": 318, "speaker": 15, "form": "dlg", "jp": "そしたら、『アイコ』のヤツ‥‥"},
{"id": 319, "speaker": 15, "form": "dlg", "jp": "『ゴメンなさい！\n　アイコのこと見捨てないで‥‥』"},
{"id": 320, "speaker": 15, "form": "dlg", "jp": "で、ボクもいいかっこして、"},
{"id": 321, "speaker": 15, "form": "dlg", "jp": "『見捨てないよ、\n　いつでもアイコのこと守ってやるから！』"},
{"id": 322, "speaker": 15, "form": "dlg", "jp": "『約束するよ！』って言ったんだ‥‥"},
{"id": 323, "speaker": 15, "form": "dlg", "jp": "（子供だから、言えたんだよな‥‥）"},
{"id": 324, "speaker": 15, "form": "dlg", "jp": "（今じゃ、\n　そんなことはずかしくってとても‥‥）"},
{"id": 325, "speaker": 15, "form": "dlg", "jp": "（でも、\n　なんでコイツそんなはずかしいことを今頃‥‥）"},
{"id": 326, "speaker": 15, "form": "dlg", "jp": "（また、\n　いつもみたいにボクをからかってるのかな？）"},
{"id": 327, "speaker": 15, "form": "dlg", "jp": "（それとも‥‥）"},
{"id": 328, "speaker": 15, "form": "dlg", "jp": "（不安なのか？）"},
{"id": 329, "speaker": 15, "form": "choice", "jp": "「からかってるの？」"},
{"id": 330, "speaker": 15, "form": "choice", "jp": "「不安なの？」"},
{"id": 331, "speaker": 2, "form": "dlg", "jp": "「からかってるの？」"},
{"id": 332, "speaker": 15, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥！」"},
{"id": 333, "speaker": 15, "form": "dlg", "jp": "「ちょっとだけね‥‥」"},
{"id": 334, "speaker": 15, "form": "dlg", "jp": "「だって、ナゴムちゃん子供のくせに、\n　あんなにカッコウつけた台詞言うんだもん！」"},
{"id": 335, "speaker": 2, "form": "dlg", "jp": "「たぶん、子供だから言ったんだよ‥‥」"},
{"id": 336, "speaker": 15, "form": "dlg", "jp": "「かわいくないわねぇ～」"},
{"id": 337, "speaker": 2, "form": "dlg", "jp": "「不安なの？」"},
{"id": 338, "speaker": 15, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥！」"},
{"id": 339, "speaker": 15, "form": "dlg", "jp": "「ちょっとだけね‥‥」"},
{"id": 340, "speaker": 15, "form": "dlg", "jp": "「でも、大丈夫よ！！」"},
{"id": 341, "speaker": 15, "form": "dlg", "jp": "「その返事からすると、\n　『約束』は守ってくれそうだから」"},
{"id": 342, "speaker": 2, "form": "dlg", "jp": "「ああ『守ってやるよ』‥‥」"},
{"id": 343, "speaker": 2, "form": "dlg", "jp": "「『約束』だから‥‥」"},
{"id": 344, "speaker": 2, "form": "dlg", "jp": "その時！"},
{"id": 345, "speaker": 15, "form": "dlg", "jp": "「ちょっと、アレ見て！！」"},
{"id": 346, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 347, "speaker": 15, "form": "dlg", "jp": "「アレってさっきの『女の子』じゃあ？」"},
{"id": 348, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥！」"},
{"id": 349, "speaker": 2, "form": "dlg", "jp": "アイコの指差す方向には\nさっきの"},
{"id": 350, "speaker": 2, "form": "dlg", "jp": "オバケ屋敷の少女"},
{"id": 351, "speaker": 2, "form": "dlg", "jp": "が"},
{"id": 352, "speaker": 2, "form": "dlg", "jp": "男の人に抱えられている姿があった。"},
{"id": 353, "speaker": 15, "form": "dlg", "jp": "「見えにくいけど、『あの子』よね？」"},
{"id": 354, "speaker": 2, "form": "dlg", "jp": "「たぶん‥‥」"},
{"id": 355, "speaker": 15, "form": "dlg", "jp": "「抱えられて運ばれてるってことは、\n　やっぱり人形だったのね‥‥」"},
{"id": 356, "speaker": 2, "form": "dlg", "jp": "「そうみたいだね‥‥」"},
{"id": 357, "speaker": 16, "form": "dlg", "jp": "「なんか、\n　夏休みらしい夏休みを過ごしてるわね‥‥」"},
{"id": 358, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 359, "speaker": 16, "form": "dlg", "jp": "「ジーンが見たらなんて言うかしら‥‥」"},
{"id": 360, "speaker": 2, "form": "dlg", "jp": "「間違いなく怒るだろうね？」"},
{"id": 361, "speaker": 2, "form": "dlg", "jp": "「ねえ、そう言えば、\n　新しい『夢』は見ていないの？」"},
{"id": 362, "speaker": 16, "form": "dlg", "jp": "「うん、ぜんぜん‥‥」"},
{"id": 363, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 364, "speaker": 16, "form": "dlg", "jp": "「見たい時に見れないって不便な能力よね‥‥」"},
{"id": 365, "speaker": 2, "form": "dlg", "jp": "「でも、\n　自由に未来が見れたら便利すぎるだろうし‥‥」"},
{"id": 366, "speaker": 16, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 367, "speaker": 16, "form": "dlg", "jp": "「競馬の予想もできちゃうし‥‥」"},
{"id": 368, "speaker": 16, "form": "dlg", "jp": "「なによりも『クリエーター』に勝てるのか\n　そうじゃないのかもわかっちゃうもんね」"},
{"id": 369, "speaker": 16, "form": "dlg", "jp": "「もし、勝てないってわかったら\n　もうすべてがイヤになるでしょう？」"},
{"id": 370, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 371, "speaker": 16, "form": "dlg", "jp": "「とにかく、不便でもなんでも」"},
{"id": 372, "speaker": 16, "form": "dlg", "jp": "「『未来』が見えるウチは\n　『未来』があるってことだからいいんだけど‥‥」"},
{"id": 373, "speaker": 16, "form": "choice", "jp": "「そうだね‥‥」"},
{"id": 374, "speaker": 16, "form": "choice", "jp": "「そうじゃないんじゃぁ？」"},
{"id": 375, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 376, "speaker": 2, "form": "dlg", "jp": "「もしかしたら、先の未来が見えないのは、\n　先の未来がまだ決定してないからかも‥‥」"},
{"id": 377, "speaker": 2, "form": "dlg", "jp": "「そうじゃないんじゃぁ？」"},
{"id": 378, "speaker": 2, "form": "dlg", "jp": "「もしかしたら、先の未来が見えないのは、\n　先の未来がまだ決定してないからかも‥‥」"},
{"id": 379, "speaker": 16, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 380, "speaker": 2, "form": "dlg", "jp": "「やっぱり、世の中ってある程度\n　因果関係ってあろうだろう？」"},
{"id": 381, "speaker": 16, "form": "dlg", "jp": "「で‥‥？」"},
{"id": 382, "speaker": 2, "form": "dlg", "jp": "「例えば、『宝くじ』を買うと‥‥」"},
{"id": 383, "speaker": 2, "form": "dlg", "jp": "「『宝くじが当たる未来』や\n　『ハズれる未来』が発生するけど」"},
{"id": 384, "speaker": 2, "form": "dlg", "jp": "「買うまではどちらの未来も発生しないのかも‥‥」"},
{"id": 385, "speaker": 16, "form": "dlg", "jp": "「なるほど！！」"},
{"id": 386, "speaker": 16, "form": "dlg", "jp": "「じゃあ、『クリエーターの夢』を見ないってことは\n　まだ、どうなるか決まってないってことかしら？」"},
{"id": 387, "speaker": 2, "form": "dlg", "jp": "「その可能性もあるね！」"},
{"id": 388, "speaker": 16, "form": "dlg", "jp": "「常光寺くん‥‥」"},
{"id": 389, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 390, "speaker": 16, "form": "dlg", "jp": "「これって『夢』じゃないよね？」"},
{"id": 391, "speaker": 2, "form": "dlg", "jp": "「えっ？」"},
{"id": 392, "speaker": 16, "form": "dlg", "jp": "「今、この瞬間は『夢』じゃないよね？」"},
{"id": 393, "speaker": 2, "form": "dlg", "jp": "「た、たぶん‥‥」"},
{"id": 394, "speaker": 2, "form": "dlg", "jp": "「ど、どうかしたの？」"},
{"id": 395, "speaker": 16, "form": "dlg", "jp": "「せっかく、男の子とデートしてるのに\n　これが『夢』だったら悲しいし‥‥」"},
{"id": 396, "speaker": 16, "form": "dlg", "jp": "「『夢』じゃなかったら、\n　『クリエーター』が襲って来るワケだし‥‥」"},
{"id": 397, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 398, "speaker": 2, "form": "dlg", "jp": "「長尾の場合はどっちでもいっしょだろう？」"},
{"id": 399, "speaker": 2, "form": "dlg", "jp": "「『夢』なら、『現実』になちゃうんだから‥‥」"},
{"id": 400, "speaker": 16, "form": "dlg", "jp": "「フクザツよね‥‥」"},
{"id": 401, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 402, "speaker": 2, "form": "dlg", "jp": "（長尾らしくない台詞だな‥‥）"},
{"id": 403, "speaker": 2, "form": "dlg", "jp": "（やっぱり不安なのかな？）"},
{"id": 404, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 405, "speaker": 16, "form": "dlg", "jp": "「ちょっと！」"},
{"id": 406, "speaker": 16, "form": "dlg", "jp": "「どこ見てるのよ！！」"},
{"id": 407, "speaker": 16, "form": "choice", "jp": "「け、『景色』だよ‥‥」"},
{"id": 408, "speaker": 16, "form": "choice", "jp": "「『胸』‥‥」"},
{"id": 409, "speaker": 2, "form": "dlg", "jp": "「け、『景色』だよ‥‥」"},
{"id": 410, "speaker": 2, "form": "dlg", "jp": "「『景色を観覧するため』の『観覧車』だろう？」"},
{"id": 411, "speaker": 16, "form": "dlg", "jp": "「そ、そうよね‥‥」"},
{"id": 412, "speaker": 2, "form": "dlg", "jp": "「『胸』‥‥」"},
{"id": 413, "speaker": 16, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 414, "speaker": 16, "form": "dlg", "jp": "「‥‥‥‥‥‥エッチ‥‥‥‥‥‥」"},
{"id": 415, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 416, "speaker": 2, "form": "dlg", "jp": "その時！"},
{"id": 417, "speaker": 16, "form": "dlg", "jp": "「ちょっと、アレ見て！！」"},
{"id": 418, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 419, "speaker": 16, "form": "dlg", "jp": "「アレってさっきの『女の子』じゃあ？」"},
{"id": 420, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥！」"},
{"id": 421, "speaker": 2, "form": "dlg", "jp": "長尾の指差す方向には\nさっきの"},
{"id": 422, "speaker": 2, "form": "dlg", "jp": "オバケ屋敷の少女"},
{"id": 423, "speaker": 2, "form": "dlg", "jp": "が"},
{"id": 424, "speaker": 2, "form": "dlg", "jp": "男の人に抱えられている姿があった。"},
{"id": 425, "speaker": 16, "form": "dlg", "jp": "「見えにくいけど、『あの子』よね？」"},
{"id": 426, "speaker": 2, "form": "dlg", "jp": "「たぶん‥‥」"},
{"id": 427, "speaker": 16, "form": "dlg", "jp": "「抱えられて運ばれてるってことは、\n　やっぱり人形だったのね‥‥」"},
{"id": 428, "speaker": 2, "form": "dlg", "jp": "「そうみたいだね‥‥」"},
{"id": 429, "speaker": 18, "form": "dlg", "jp": "「なんか、\n　夏休みらしい夏休みを過ごしてるわね‥‥」"},
{"id": 430, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 431, "speaker": 18, "form": "dlg", "jp": "「ジーンが見たらなんて言うかしら‥‥」"},
{"id": 432, "speaker": 2, "form": "dlg", "jp": "「間違いなく怒るだろうね？」"},
{"id": 433, "speaker": 18, "form": "dlg", "jp": "「そういえば、コッチに来てから\n　遊園地きたの初めてかも‥‥」"},
{"id": 434, "speaker": 2, "form": "dlg", "jp": "「転校してくる前はよく遊園地行ったの？」"},
{"id": 435, "speaker": 18, "form": "dlg", "jp": "「中学になってからは１度もないわね‥‥」"},
{"id": 436, "speaker": 2, "form": "dlg", "jp": "「ふーん‥‥」"},
{"id": 437, "speaker": 18, "form": "dlg", "jp": "「こうして学校の友だちどうして\n　遊園地に来るのって結構『夢』だったの‥‥」"},
{"id": 438, "speaker": 18, "form": "choice", "jp": "「そうなんだ‥‥」"},
{"id": 439, "speaker": 18, "form": "choice", "jp": "「恋人同士じゃなくって？」"},
{"id": 440, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 441, "speaker": 18, "form": "dlg", "jp": "「やっぱり、学校の中だけの付き合いじゃ\n　本当の友だちって感じがしないでしょう？」"},
{"id": 442, "speaker": 18, "form": "dlg", "jp": "「三船さんとか、常光寺くんとかって、\n　そんな感じじゃないし‥‥」"},
{"id": 443, "speaker": 2, "form": "dlg", "jp": "「アイツは特別だよ‥‥」"},
{"id": 444, "speaker": 18, "form": "dlg", "jp": "「いいわね、『特別な人』がいるなんて‥‥」"},
{"id": 445, "speaker": 2, "form": "dlg", "jp": "「そういう意味の『特別』じゃないよ！」"},
{"id": 446, "speaker": 18, "form": "dlg", "jp": "「ええ、そう言う意味では言ってないわよ！」"},
{"id": 447, "speaker": 18, "form": "dlg", "jp": "「フフフフフフ‥‥」"},
{"id": 448, "speaker": 2, "form": "dlg", "jp": "「恋人同士じゃなくって？」"},
{"id": 449, "speaker": 18, "form": "dlg", "jp": "「うん！」"},
{"id": 450, "speaker": 18, "form": "dlg", "jp": "「コッチはどうか知らないけど、\n　ムコウじゃ、遊園地でデートすると」"},
{"id": 451, "speaker": 18, "form": "dlg", "jp": "「必ず別れるっていうジンクスがあるの‥‥」"},
{"id": 452, "speaker": 2, "form": "dlg", "jp": "「それって、ただ、遊園地でデートするカップルが\n　若いからってことじゃないの？」"},
{"id": 453, "speaker": 2, "form": "dlg", "jp": "「若いカップルがそのまま結婚するのって\n　ほとんどないだろう？」"},
{"id": 454, "speaker": 18, "form": "dlg", "jp": "「でも、ウチのお父さんとお母さんは\n　中学の時から付き合って結婚したんだって‥‥」"},
{"id": 455, "speaker": 2, "form": "dlg", "jp": "「へえ‥‥」"},
{"id": 456, "speaker": 18, "form": "dlg", "jp": "「でもよかった、中学最後の夏休みに\n　こうやってさそってもらえて‥‥」"},
{"id": 457, "speaker": 18, "form": "dlg", "jp": "「転校生ってこういうのにビンカンなの‥‥」"},
{"id": 458, "speaker": 18, "form": "dlg", "jp": "「自分は仲間はずれにされるんじゃないかって‥‥」"},
{"id": 459, "speaker": 2, "form": "dlg", "jp": "「そんなことはしないよ‥‥」"},
{"id": 460, "speaker": 18, "form": "dlg", "jp": "「そうかしら、やっぱメインメンバーとかあるでしょう？」"},
{"id": 461, "speaker": 18, "form": "dlg", "jp": "「普段は仲良く遊んでいても、デキスギくんは\n　大冒険には連れて行ってもらえないじゃない？」"},
{"id": 462, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥」"},
{"id": 463, "speaker": 2, "form": "dlg", "jp": "「そ、そういえば、\n　堤さんのお父さん関西出身なんだよね」"},
{"id": 464, "speaker": 18, "form": "dlg", "jp": "「そうよ」"},
{"id": 465, "speaker": 18, "form": "dlg", "jp": "「転校してくるまでは、\n　アッチに住んでたのよ‥‥」"},
{"id": 466, "speaker": 2, "form": "dlg", "jp": "「そのわりに、ぜんぜんナマりがないね？」"},
{"id": 467, "speaker": 18, "form": "dlg", "jp": "「意識して関西弁が出ないようにしてるから‥‥」"},
{"id": 468, "speaker": 18, "form": "dlg", "jp": "「バカにされたり、イジメられるのイヤだから‥‥」"},
{"id": 469, "speaker": 2, "form": "dlg", "jp": "「それにしても、全然ナマリがないね？」"},
{"id": 470, "speaker": 18, "form": "dlg", "jp": "「『アナウンサー教室』も通わされてから‥‥」"},
{"id": 471, "speaker": 2, "form": "dlg", "jp": "「本当にいろいろやってるんだね‥‥」"},
{"id": 472, "speaker": 18, "form": "dlg", "jp": "「フフフフフ‥‥」"},
{"id": 473, "speaker": 18, "form": "dlg", "jp": "「でも、やっぱり、\n　女の子の関西弁とかイヤでしょう？」"},
{"id": 474, "speaker": 18, "form": "choice", "jp": "「そんなコトないよ‥‥」"},
{"id": 475, "speaker": 18, "form": "choice", "jp": "「さあ、どうなんだろう？」"},
{"id": 476, "speaker": 2, "form": "dlg", "jp": "「そんなコトないよ‥‥」"},
{"id": 477, "speaker": 2, "form": "dlg", "jp": "「ボクは聞いてみたいけどなぁ、\n　堤さんの関西弁‥‥」"},
{"id": 478, "speaker": 18, "form": "dlg", "jp": "「そ、そう？」"},
{"id": 479, "speaker": 2, "form": "dlg", "jp": "「ねえ、せっかく２人きりなんだから、\n　聞かせてよ‥‥」"},
{"id": 480, "speaker": 18, "form": "dlg", "jp": "「イヤよ！」"},
{"id": 481, "speaker": 2, "form": "dlg", "jp": "「その『イヤよ』って関西弁では？」"},
{"id": 482, "speaker": 18, "form": "dlg", "jp": "「イ、イヤや‥‥」"},
{"id": 483, "speaker": 2, "form": "dlg", "jp": "「やっぱり、かわいいよ！」"},
{"id": 484, "speaker": 2, "form": "dlg", "jp": "「堤さんの関西弁は‥‥」"},
{"id": 485, "speaker": 18, "form": "dlg", "jp": "「ヤ、ヤメテ‥‥、\n　もう、ホンマに恥ずかしいわぁ‥‥」"},
{"id": 486, "speaker": 2, "form": "dlg", "jp": "「さあ、どうなんだろう？」"},
{"id": 487, "speaker": 2, "form": "dlg", "jp": "「たしかにテレビとかのイメージは良くないね‥‥」"},
{"id": 488, "speaker": 2, "form": "dlg", "jp": "「なんか、\n　ヤミ金融とか、漫才師とかのイメージが‥‥」"},
{"id": 489, "speaker": 18, "form": "dlg", "jp": "「そ、そうよね‥‥」"},
{"id": 490, "speaker": 18, "form": "dlg", "jp": "その時！"},
{"id": 491, "speaker": 18, "form": "dlg", "jp": "「ちょっと、アレ見て！！」"},
{"id": 492, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 493, "speaker": 18, "form": "dlg", "jp": "「アレってさっきの『女の子』じゃあ？」"},
{"id": 494, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥！」"},
{"id": 495, "speaker": 2, "form": "dlg", "jp": "堤さんの指差す方向には\nさっきの"},
{"id": 496, "speaker": 2, "form": "dlg", "jp": "オバケ屋敷の少女"},
{"id": 497, "speaker": 2, "form": "dlg", "jp": "が"},
{"id": 498, "speaker": 2, "form": "dlg", "jp": "男の人に抱えられている姿があった。"},
{"id": 499, "speaker": 18, "form": "dlg", "jp": "「見えにくいけど、『あの子』よね？」"},
{"id": 500, "speaker": 2, "form": "dlg", "jp": "「たぶん‥‥」"},
{"id": 501, "speaker": 18, "form": "dlg", "jp": "「抱えられて運ばれてるってことは、\n　やっぱり人形だったのね‥‥」"},
{"id": 502, "speaker": 2, "form": "dlg", "jp": "「そうみたいだね‥‥」"},
{"id": 503, "speaker": 51, "form": "dlg", "jp": "「なんか、\n　夏休みらしい夏休みを過ごしてるよな‥‥」"},
{"id": 504, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 505, "speaker": 51, "form": "dlg", "jp": "「まあ、クラブも引退したし、\n　これが普通なんやろうけど‥‥」"},
{"id": 506, "speaker": 2, "form": "dlg", "jp": "「もう、引退したんだ？」"},
{"id": 507, "speaker": 2, "form": "dlg", "jp": "「そう言えば、全国大会は？」"},
{"id": 508, "speaker": 51, "form": "dlg", "jp": "「地区予選、昨日やったから‥‥」"},
{"id": 509, "speaker": 2, "form": "dlg", "jp": "「じゃあ、試合には？」"},
{"id": 510, "speaker": 51, "form": "dlg", "jp": "「出れるわけないやん！」"},
{"id": 511, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 512, "speaker": 51, "form": "dlg", "jp": "「常光寺があやまることちゃうし‥‥」"},
{"id": 513, "speaker": 51, "form": "choice", "jp": "「そうだけど‥‥」"},
{"id": 514, "speaker": 51, "form": "choice", "jp": "「そうだね‥‥」"},
{"id": 515, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 516, "speaker": 51, "form": "dlg", "jp": "「男がグチグチ言うとったらアカン！」"},
{"id": 517, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 518, "speaker": 51, "form": "dlg", "jp": "「そうや！」"},
{"id": 519, "speaker": 51, "form": "dlg", "jp": "「常光寺は細かいことに気ぃ使い過ぎや！」"},
{"id": 520, "speaker": 51, "form": "dlg", "jp": "「男はどんどん前に行ったらええねん！」"},
{"id": 521, "speaker": 51, "form": "dlg", "jp": "「後の事は女がひろてくれる！」"},
{"id": 522, "speaker": 51, "form": "dlg", "jp": "「男のしりぬぐいを嫌がるような女は\n　始めから相手にせえへんかったらええねん！」"},
{"id": 523, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 524, "speaker": 51, "form": "dlg", "jp": "「アンタもケネスもジーンに偉そうに言われて\n　カッコ悪いと思えへんか？」"},
{"id": 525, "speaker": 51, "form": "dlg", "jp": "「ウチの大会のことなんか\n　どうでもええやん！」"},
{"id": 526, "speaker": 51, "form": "dlg", "jp": "「どうせ、\n　中学生でウチに勝てるヤツなんておらんし‥‥」"},
{"id": 527, "speaker": 51, "form": "dlg", "jp": "「そんな勝負してもしゃあないやろう？」"},
{"id": 528, "speaker": 51, "form": "dlg", "jp": "「それより『クリエーター』やって‥‥」"},
{"id": 529, "speaker": 51, "form": "dlg", "jp": "「ソイツが『生き物』やったら、\n　ウチの『奥義』、『能力』は通用せえへんねんから‥‥」"},
{"id": 530, "speaker": 51, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥」"},
{"id": 531, "speaker": 2, "form": "dlg", "jp": "「そんな弱気になるなんて、\n　小田らしくないよ‥‥」"},
{"id": 532, "speaker": 51, "form": "dlg", "jp": "「そういうのもなんかなぁ‥‥」"},
{"id": 533, "speaker": 51, "form": "dlg", "jp": "「『強い』って思われるのもさみしいなぁ‥‥」"},
{"id": 534, "speaker": 2, "form": "dlg", "jp": "「そうなの？」"},
{"id": 535, "speaker": 51, "form": "dlg", "jp": "「だって、\n　『女』として見られてないみたいやし‥‥」"},
{"id": 536, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 537, "speaker": 51, "form": "dlg", "jp": "「なあ、こうして２人きりやけど\n　ちゃんとドキドキしてる？」"},
{"id": 538, "speaker": 51, "form": "choice", "jp": "「な、なに言ってるんだよ‥‥」"},
{"id": 539, "speaker": 51, "form": "choice", "jp": "「アハハハハハハハ‥‥」"},
{"id": 540, "speaker": 2, "form": "dlg", "jp": "「な、なに言ってるんだよ‥‥」"},
{"id": 541, "speaker": 51, "form": "dlg", "jp": "「その反応、ちゃんとドキドキしてるみたいやね‥‥」"},
{"id": 542, "speaker": 2, "form": "dlg", "jp": "「バ、ババ、バカなことを‥‥」"},
{"id": 543, "speaker": 51, "form": "dlg", "jp": "「ちょっと落ち着いて‥‥」"},
{"id": 544, "speaker": 51, "form": "dlg", "jp": "「コッチが恥ずかしくなるやないの‥‥」"},
{"id": 545, "speaker": 2, "form": "dlg", "jp": "「ハハハハハハ‥‥」"},
{"id": 546, "speaker": 51, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 547, "speaker": 2, "form": "dlg", "jp": "「アハハハハハハハ‥‥」"},
{"id": 548, "speaker": 51, "form": "dlg", "jp": "「その返事やもんなぁ‥‥」"},
{"id": 549, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 550, "speaker": 51, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 551, "speaker": 51, "form": "dlg", "jp": "その時！"},
{"id": 552, "speaker": 51, "form": "dlg", "jp": "「ちょっと、アレ見て！！」"},
{"id": 553, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 554, "speaker": 51, "form": "dlg", "jp": "「アレ、さっきの『女の子』ちゃうん？」"},
{"id": 555, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥！」"},
{"id": 556, "speaker": 2, "form": "dlg", "jp": "小田の指差す方向には\nさっきの"},
{"id": 557, "speaker": 2, "form": "dlg", "jp": "オバケ屋敷の少女"},
{"id": 558, "speaker": 2, "form": "dlg", "jp": "が"},
{"id": 559, "speaker": 2, "form": "dlg", "jp": "男の人に抱えられている姿があった。"},
{"id": 560, "speaker": 51, "form": "dlg", "jp": "「見えにくいけど、『あの子』やんな？」"},
{"id": 561, "speaker": 2, "form": "dlg", "jp": "「たぶん‥‥」"},
{"id": 562, "speaker": 51, "form": "dlg", "jp": "「抱えられて運ばれてるってことは、\n　やっぱり人形やったんや‥‥」"},
{"id": 563, "speaker": 2, "form": "dlg", "jp": "「そうみたいだね‥‥」"},
{"id": 564, "speaker": 14, "form": "dlg", "jp": "「オイ、見たかさっきの女の子？」"},
{"id": 565, "speaker": 2, "form": "dlg", "jp": "「うん、見た！」"},
{"id": 566, "speaker": 2, "form": "dlg", "jp": "「やっぱり、人形だったんだね？」"},
{"id": 567, "speaker": 13, "form": "dlg", "jp": "「そうか？」"},
{"id": 568, "speaker": 13, "form": "dlg", "jp": "「アレは最近流行りの『少女誘拐』じゃないのか？」"},
{"id": 569, "speaker": 2, "form": "dlg", "jp": "「どうやったら、そんな考え方ができるんだよ！」"},
{"id": 570, "speaker": 13, "form": "dlg", "jp": "「例えば意識を失わせてから、さらうとか‥‥」"},
{"id": 571, "speaker": 14, "form": "dlg", "jp": "「こんな人の多い場所で\n　そんなことするはずないだろう？」"},
{"id": 572, "speaker": 14, "form": "dlg", "jp": "「さあ、帰ろうぜ！」"},
{"id": 573, "speaker": 14, "form": "dlg", "jp": "「じゃあな！」"},
{"id": 574, "speaker": 2, "form": "dlg", "jp": "「うん、今日はありがとう‥‥」"},
{"id": 575, "speaker": 2, "form": "dlg", "jp": "（結構遅くなっちゃったな‥‥）"},
{"id": 576, "speaker": 2, "form": "dlg", "jp": "（ジーンにいいわけを考えておかないと‥‥）"},
{"id": 577, "speaker": 4, "form": "dlg", "jp": "「ナゴムくん！」"},
{"id": 578, "speaker": 2, "form": "dlg", "jp": "「警部！？」"},
{"id": 579, "speaker": 2, "form": "dlg", "jp": "「どうしたんですか、こんなところで？」"},
{"id": 580, "speaker": 2, "form": "dlg", "jp": "「もしかして！？」"},
{"id": 581, "speaker": 2, "form": "dlg", "jp": "「まだ、ルードの残党が？」"},
{"id": 582, "speaker": 11, "form": "dlg", "jp": "「いや、アッチの事件からは外されたよ‥‥」"},
{"id": 583, "speaker": 11, "form": "dlg", "jp": "「今は"},
{"id": 584, "speaker": 11, "form": "dlg", "jp": "『少女誘拐事件』"},
{"id": 585, "speaker": 11, "form": "dlg", "jp": "の方だよ‥‥」"},
{"id": 586, "speaker": 2, "form": "dlg", "jp": "「えっ？」"},
{"id": 587, "speaker": 2, "form": "dlg", "jp": "「まさか、この辺りでも\n　誰かさらわれたんですか？」"},
{"id": 588, "speaker": 11, "form": "dlg", "jp": "「まあ、さらわれたのかどうかはわからんが‥‥」"},
{"id": 589, "speaker": 11, "form": "dlg", "jp": "「女の子がいなくなったのは間違いないみたいだ」"},
{"id": 590, "speaker": 2, "form": "dlg", "jp": "「警部もいろいろ大変ですね？」"},
{"id": 591, "speaker": 11, "form": "dlg", "jp": "「仕事だからな‥‥」"},
{"id": 592, "speaker": 11, "form": "dlg", "jp": "「じゃあ、ナゴムくんも気をつけて」"},
{"id": 593, "speaker": 2, "form": "dlg", "jp": "「ありがとうございます」"},
{"id": 594, "speaker": 2, "form": "dlg", "jp": "（なんか、イヤな世の中になってきたな‥‥）"},
{"id": 595, "speaker": 2, "form": "dlg", "jp": "（とにかく急いで帰ろう！）"},
{"id": 596, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 597, "speaker": 2, "form": "dlg", "jp": "「ドン！」"},
{"id": 598, "speaker": 4, "form": "dlg", "jp": "「ツタタタ‥‥」"},
{"id": 599, "speaker": 2, "form": "dlg", "jp": "「スミマセン！」"},
{"id": 600, "speaker": 4, "form": "dlg", "jp": "「気をつけてくれよ！」"},
{"id": 601, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥！？」"},
{"id": 602, "speaker": 2, "form": "dlg", "jp": "（シロー！？）"},
{"id": 603, "speaker": 4, "form": "dlg", "jp": "「どうかしたのかい？」"},
{"id": 604, "speaker": 2, "form": "dlg", "jp": "（まさか、そんなハズはないよな‥‥）"},
{"id": 605, "speaker": 2, "form": "dlg", "jp": "「いえ、なんでもありません！」"},
{"id": 606, "speaker": 4, "form": "dlg", "jp": "「変わった子だな‥‥」"},
{"id": 607, "speaker": 4, "form": "dlg", "jp": "そういって、シローそっくりのその人は\n立ち去ってしまった。"},
{"id": 608, "speaker": 2, "form": "dlg", "jp": "（しかし、ビックリするぐらい\n　そっくりだったな‥‥）"},
{"id": 609, "speaker": 2, "form": "dlg", "jp": "（それに、あのスーツどこかで見たことあるぞ？）"},
{"id": 610, "speaker": 2, "form": "dlg", "jp": "（そんなことより早く帰らないと\n　ジーンたちが来てるかも‥‥）"},
{"id": 611, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"}
]
