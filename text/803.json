[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０７／２２／ＰＭ００：０５"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 2, "speaker": 2, "form": "dlg", "jp": "「ただいま‥‥」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 4, "speaker": 3, "form": "dlg", "jp": "「おそかったわね‥‥」"},
{"id": 5, "speaker": 3, "form": "dlg", "jp": "「早くお昼食べちゃわないと、\n　小田さん来るんじゃないの‥‥」"},
{"id": 6, "speaker": 3, "form": "dlg", "jp": "「早くお昼食べちゃわないと、\n　アキラちゃん来るんじゃないの‥‥」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "ボクは急いで昼ゴハンをすませた。"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "２００５／０７／２２／ＰＭ０１：０５"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 12, "speaker": 3, "form": "dlg", "jp": "「ハーイ！」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「ボクが出るよ‥‥」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 16, "speaker": 51, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 17, "speaker": 51, "form": "dlg", "jp": "やっぱり、『小田トモ』だった‥‥"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「あがってよ‥‥」"},
{"id": 19, "speaker": 51, "form": "dlg", "jp": "「おじゃまします‥‥」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「で、なんか用？」"},
{"id": 21, "speaker": 51, "form": "dlg", "jp": "「相談なんやけど‥‥」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 23, "speaker": 51, "form": "dlg", "jp": "「こないだの『幽霊』のことどう思う？」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「あれはさんざんだったね‥‥」"},
{"id": 25, "speaker": 51, "form": "dlg", "jp": "「まあ、そうやろうね‥‥」"},
{"id": 26, "speaker": 51, "form": "dlg", "jp": "「で、『幽霊』ってまだ信じてる？」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「まだも何も‥‥」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「ボクは始めから信じてないし‥‥」"},
{"id": 29, "speaker": 51, "form": "dlg", "jp": "「じゃあ、ウチが\n　『幽霊』を見たって言っても信じへん？」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "「えっ、見たの？」"},
{"id": 31, "speaker": 51, "form": "dlg", "jp": "「見てしもたかも‥‥」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "「それ、マジの話？」"},
{"id": 33, "speaker": 51, "form": "dlg", "jp": "「それがようわからへんねん‥‥」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「『わからへん』って‥‥」"},
{"id": 35, "speaker": 51, "form": "dlg", "jp": "「だから、確認したいんだけど\n　１人やったらキモチ悪いやん！」"},
{"id": 36, "speaker": 51, "form": "dlg", "jp": "「常光寺、ついてきてくれへん？」"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "「なんでボクなんだよ‥‥」"},
{"id": 38, "speaker": 51, "form": "dlg", "jp": "「角川はたよりにならんし、\n　関口はバカにするやろう？」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「ボクだって、バカにするよ‥‥」"},
{"id": 40, "speaker": 51, "form": "dlg", "jp": "「常光寺にそんな根性あらへん！」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「なんだよ、その言いぐさは‥‥」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "「それに、小田だって、信じてなかったんじゃ？」"},
{"id": 43, "speaker": 51, "form": "dlg", "jp": "「だからキモチ悪いんやん！」"},
{"id": 44, "speaker": 51, "form": "dlg", "jp": "「ないと思てるモン見たんやで？」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「だいたい、『何』を見たんだよ！」"},
{"id": 46, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 47, "speaker": 51, "form": "dlg", "jp": "『生きている死んだ人』"},
{"id": 48, "speaker": 51, "form": "dlg", "jp": "‥‥」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「何それ？」"},
{"id": 50, "speaker": 51, "form": "dlg", "jp": "「"},
{"id": 51, "speaker": 51, "form": "dlg", "jp": "『死んだのに生きてる人間』"},
{"id": 52, "speaker": 51, "form": "dlg", "jp": "やん！！」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「そんなのいるワケないだろう？」"},
{"id": 54, "speaker": 51, "form": "dlg", "jp": "「だから、『幽霊』かなって‥‥」"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「もし、本当なら間違いなく『幽霊』だよな‥‥」"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "いや、もしかしたら『母さん』の\n『残存思念』みたいなヤツか？"},
{"id": 57, "speaker": 51, "form": "dlg", "jp": "「でも、自信がないねん‥‥」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「だろうな‥‥」"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "「普通目のサッカクだと思うよな‥‥」"},
{"id": 60, "speaker": 51, "form": "dlg", "jp": "「ちょっと、何かカン違いしてへん！？」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "「カン違い？？」"},
{"id": 62, "speaker": 51, "form": "dlg", "jp": "「ウチは『生きている死んだ人』は\n　間違いなく見たのっ！」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 64, "speaker": 51, "form": "dlg", "jp": "「剣道っていうのは、\n　動体視力が重要なスポーツやで！」"},
{"id": 65, "speaker": 51, "form": "dlg", "jp": "「ウチが見間違いとかするわけないやん！」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「じゃあ、何を確認したいんだよ！」"},
{"id": 67, "speaker": 51, "form": "dlg", "jp": "「だ・か・ら‥‥」"},
{"id": 68, "speaker": 51, "form": "dlg", "jp": "「ソイツが"},
{"id": 69, "speaker": 51, "form": "dlg", "jp": "『幽霊』"},
{"id": 70, "speaker": 51, "form": "dlg", "jp": "なのか、\n　"},
{"id": 71, "speaker": 51, "form": "dlg", "jp": "『ゾンビ』"},
{"id": 72, "speaker": 51, "form": "dlg", "jp": "なのかがわからないってことやん！」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "『ゾンビ』"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "！？」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「もうちょっと詳しく話してくれないか？\n　さっぱり話が見えないんだけど‥‥」"},
{"id": 77, "speaker": 51, "form": "dlg", "jp": "「そ、そうやね‥‥」"},
{"id": 78, "speaker": 51, "form": "dlg", "jp": "「実は昨日、プールから帰ったら\n　家族が大騒ぎしてたんよ‥‥」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「何かあったの？」"},
{"id": 80, "speaker": 51, "form": "dlg", "jp": "「近所のオジさんが死んだんやって‥‥」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「それはたいへんだね‥‥」"},
{"id": 82, "speaker": 51, "form": "dlg", "jp": "「大変なんはその後やって‥‥」"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "「その後？」"},
{"id": 84, "speaker": 51, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 85, "speaker": 51, "form": "dlg", "jp": "「そのオジさんの『死体』が『行方不明』になったんよ！」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「『死体』が『行方不明』！？」"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "「誰かに盗まれたの？」"},
{"id": 88, "speaker": 51, "form": "dlg", "jp": "「うん、ウチらもそう思ってたんやけど‥‥」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「違うの？」"},
{"id": 90, "speaker": 51, "form": "dlg", "jp": "「ウチ、見てもうてん！」"},
{"id": 91, "speaker": 51, "form": "dlg", "jp": "「その死んだオジさんが歩いてるの‥‥」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「それって、死んでなかっただけじゃないの？」"},
{"id": 93, "speaker": 51, "form": "dlg", "jp": "「そんなわけないやん！！」"},
{"id": 94, "speaker": 51, "form": "dlg", "jp": "「ちゃんと医者が診断書書いてたんやで！」"},
{"id": 95, "speaker": 51, "form": "dlg", "jp": "「キモチ悪いやろう？」"},
{"id": 96, "speaker": 51, "form": "dlg", "jp": "「とにかく、\n　確かめようと思ってあとをつけたんやけど‥‥」"},
{"id": 97, "speaker": 51, "form": "dlg", "jp": "「なんか、キモチ悪い『倉庫』に入っていったから‥‥」"},
{"id": 98, "speaker": 51, "form": "dlg", "jp": "「確認しに行きたいんやけど、さすがに１人じゃあ‥‥」"},
{"id": 99, "speaker": 51, "form": "dlg", "jp": "「なあ、ついて来るやろう？」"},
{"id": 100, "speaker": 51, "form": "choice", "jp": "「別にいいけど‥‥」"},
{"id": 101, "speaker": 51, "form": "choice", "jp": "「いやだよ、そんなの‥‥」"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「別にいいけど‥‥」"},
{"id": 103, "speaker": 51, "form": "dlg", "jp": "「ホンマ！！」"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "「で、何を確認しにゆくの？」"},
{"id": 105, "speaker": 51, "form": "dlg", "jp": "「だから、『幽霊本人』やん！」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「『幽霊本人』？」"},
{"id": 107, "speaker": 51, "form": "dlg", "jp": "「昨日、あの後ソイツのあとをつけたのよ‥‥」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "「勇気あるな～」"},
{"id": 109, "speaker": 51, "form": "dlg", "jp": "「今思えばね‥‥」"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「で‥‥？」"},
{"id": 111, "speaker": 51, "form": "dlg", "jp": "「ソイツ、ある倉庫に入っていったのよ‥‥」"},
{"id": 112, "speaker": 51, "form": "dlg", "jp": "「それ以上はコワくなって帰ったんやけど‥‥」"},
{"id": 113, "speaker": 51, "form": "dlg", "jp": "「アイツ、あの倉庫で働いてるんかな？」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「『幽霊』なら働いてないだろうね‥‥」"},
{"id": 115, "speaker": 51, "form": "dlg", "jp": "「とにかく、あそこへ行けば、\n　すべてがわかるやろうと思うけど‥‥」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「わかったよ、ついて行くよ‥‥」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "こうしてボクは小田と２人で\n小田の言う『倉庫』へ行くことになった。"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「いやだよ、そんなの‥‥」"},
{"id": 120, "speaker": 51, "form": "dlg", "jp": "「なんで！！」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「きっとそれ、小田の見間違いだよ‥‥」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「こないだのこともあるし‥‥」"},
{"id": 123, "speaker": 51, "form": "dlg", "jp": "「ちゃうって！」"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「とにかく、ボクは行かないよ‥‥」"},
{"id": 125, "speaker": 51, "form": "dlg", "jp": "「常光寺なら\n　ついて来てくれるって思たのに‥‥」"},
{"id": 126, "speaker": 51, "form": "dlg", "jp": "しかたないよな‥‥"},
{"id": 127, "speaker": 51, "form": "dlg", "jp": "ボクは『犬の事件』を調べないといけないし‥‥"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 129, "speaker": 51, "form": "dlg", "jp": "「もうええわ‥‥」"},
{"id": 130, "speaker": 51, "form": "dlg", "jp": "「ウチ１人で調べるわ‥‥」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「また、何かわかったら教えてくれよ‥‥」"},
{"id": 132, "speaker": 51, "form": "dlg", "jp": "「イ～～～～ヤ！」"},
{"id": 133, "speaker": 51, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 134, "speaker": 51, "form": "dlg", "jp": "「バタン！」"},
{"id": 135, "speaker": 51, "form": "dlg", "jp": "「タン、タン、タン、タン、タン‥‥」"},
{"id": 136, "speaker": 51, "form": "dlg", "jp": "小田は怒って帰ってしまった。"},
{"id": 137, "speaker": 16, "form": "dlg", "jp": "「コンニチハ‥‥」"},
{"id": 138, "speaker": 16, "form": "dlg", "jp": "やっぱり、『長尾アキラ』だった‥‥"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「あがってよ‥‥」"},
{"id": 140, "speaker": 16, "form": "dlg", "jp": "「おじゃまします‥‥」"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "「で、なんか用？」"},
{"id": 142, "speaker": 16, "form": "dlg", "jp": "「相談なんだけど‥‥」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 144, "speaker": 16, "form": "dlg", "jp": "「常光寺くんってやさしいよね‥‥」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「なんだよ、キモチ悪いなぁ‥‥」"},
{"id": 146, "speaker": 16, "form": "dlg", "jp": "「ねえ、\n　こないだの『幽霊』のことどう思ってる？」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「あれはさんざんだったね‥‥」"},
{"id": 148, "speaker": 16, "form": "dlg", "jp": "「そ、そうなんだけど‥‥」"},
{"id": 149, "speaker": 16, "form": "dlg", "jp": "「『幽霊』ってまだ信じてる？」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「まだも何も‥‥」"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「ボクは始めから信じてないし‥‥」"},
{"id": 152, "speaker": 16, "form": "dlg", "jp": "「じゃあ、アキラが\n　『幽霊』を見たって言っても信じない？」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「えっ、見たの？」"},
{"id": 154, "speaker": 16, "form": "dlg", "jp": "「見ちゃった‥‥」"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "「それ、マジの話？」"},
{"id": 156, "speaker": 16, "form": "dlg", "jp": "「たぶん‥‥」"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "「なんかの見間違いじゃないの？」"},
{"id": 158, "speaker": 16, "form": "dlg", "jp": "「それがわかんないのよねぇ～」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "「『ねぇ～』って‥‥」"},
{"id": 160, "speaker": 16, "form": "dlg", "jp": "「だから、確認したいんだけど\n　１人じゃコワイし‥‥」"},
{"id": 161, "speaker": 16, "form": "dlg", "jp": "「常光寺くん、ついてきてくれない？」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「なんでボクなんだよ‥‥」"},
{"id": 163, "speaker": 16, "form": "dlg", "jp": "「関口くんとかはバカにするじゃない‥‥」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「ボクだって、バカにするよ‥‥」"},
{"id": 165, "speaker": 16, "form": "dlg", "jp": "「でも、常光寺くんはやさしいでしょう？」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "「やめろよ、照れくさいから‥‥」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「だいたい、『何』を見たんだよ！」"},
{"id": 168, "speaker": 16, "form": "dlg", "jp": "「『生きている死んだ人』‥‥」"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "「何それ？」"},
{"id": 170, "speaker": 16, "form": "dlg", "jp": "「『死んだ人』が生きていたのよ！！」"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "「そんなワケないだろう？」"},
{"id": 172, "speaker": 16, "form": "dlg", "jp": "「だから、\n　『幽霊』かも知れないって言ってるのよ！」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「もし、本当なら間違いなく『幽霊』だよな‥‥」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "いや、もしかしたら『母さん』の\n『残存思念』みたいなヤツか？"},
{"id": 175, "speaker": 16, "form": "dlg", "jp": "「それが、自信がないのよ‥‥」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「珍しいな‥‥」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「長尾が、\n　オカルト関係でギモンを抱くなんて‥‥」"},
{"id": 178, "speaker": 16, "form": "dlg", "jp": "「ちょっと、何かカン違いしてない！？」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「カン違い？？」"},
{"id": 180, "speaker": 16, "form": "dlg", "jp": "「アキラは『生きている死んだ人』について\n　ギモンなんて抱いてないわよ！」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 182, "speaker": 16, "form": "dlg", "jp": "「アキラは『幽霊』かどうかが\n　自信がないっていってるのよ」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「さらにワケがわかんないよ！」"},
{"id": 184, "speaker": 16, "form": "dlg", "jp": "「だ・か・ら‥‥」"},
{"id": 185, "speaker": 16, "form": "dlg", "jp": "「アキラが見たのが、"},
{"id": 186, "speaker": 16, "form": "dlg", "jp": "『幽霊』"},
{"id": 187, "speaker": 16, "form": "dlg", "jp": "なのか、\n　"},
{"id": 188, "speaker": 16, "form": "dlg", "jp": "『ゾンビ』"},
{"id": 189, "speaker": 16, "form": "dlg", "jp": "なのかがわからないってことよ！」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "『ゾンビ』"},
{"id": 192, "speaker": 2, "form": "dlg", "jp": "！？」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「もうちょっと詳しく話してくれないか？\n　さっぱり話が見えないんだけど‥‥」"},
{"id": 194, "speaker": 16, "form": "dlg", "jp": "「そ、そうね‥‥」"},
{"id": 195, "speaker": 16, "form": "dlg", "jp": "「実は昨日、プールから帰ったら\n　家族が大騒ぎしてたの‥‥」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「何かあったの？」"},
{"id": 197, "speaker": 16, "form": "dlg", "jp": "「近所のオジさんが死んだんだって‥‥」"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "「それはたいへんだね‥‥」"},
{"id": 199, "speaker": 16, "form": "dlg", "jp": "「大変なのはその後よ！」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "「その後？」"},
{"id": 201, "speaker": 16, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 202, "speaker": 16, "form": "dlg", "jp": "「そのオジさんの『死体』が『行方不明』になったのよ！！」"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "「『死体』が『行方不明』！？」"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "「誰かに盗まれたの？」"},
{"id": 205, "speaker": 16, "form": "dlg", "jp": "「うん、アキラたちもそう思ってたんだけど‥‥」"},
{"id": 206, "speaker": 2, "form": "dlg", "jp": "「違うの？」"},
{"id": 207, "speaker": 16, "form": "dlg", "jp": "「アキラ、見てしまったの‥‥」"},
{"id": 208, "speaker": 16, "form": "dlg", "jp": "「その死んだオジさんが歩いてるの！」"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "「それって、死んでなかっただけじゃないの？」"},
{"id": 210, "speaker": 16, "form": "dlg", "jp": "「ちゃんと医者が診断書書いてたのよ！」"},
{"id": 211, "speaker": 16, "form": "dlg", "jp": "「キモチ悪いでしょう？」"},
{"id": 212, "speaker": 16, "form": "dlg", "jp": "「とにかく、\n　確かめようと思ってあとをつけたんだけど‥‥」"},
{"id": 213, "speaker": 16, "form": "dlg", "jp": "「なんか、キモチ悪い『倉庫』に入っていったから‥‥」"},
{"id": 214, "speaker": 16, "form": "dlg", "jp": "「確認しに行きたいけど、さすがに１人じゃあ‥‥」"},
{"id": 215, "speaker": 16, "form": "dlg", "jp": "「ねえ、ついて来てくれるでしょう？」"},
{"id": 216, "speaker": 16, "form": "choice", "jp": "「別にいいけど‥‥」"},
{"id": 217, "speaker": 16, "form": "choice", "jp": "「いやだよ、そんなの‥‥」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「別にいいけど‥‥」"},
{"id": 219, "speaker": 16, "form": "dlg", "jp": "「ホント！！」"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「で、何を確認しにゆくの？」"},
{"id": 221, "speaker": 16, "form": "dlg", "jp": "「だから、『幽霊本人』よ！」"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "「『幽霊本人』？」"},
{"id": 223, "speaker": 16, "form": "dlg", "jp": "「昨日、その後ソイツのあとをつけたのよ‥‥」"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "「勇気あるな～」"},
{"id": 225, "speaker": 16, "form": "dlg", "jp": "「今思えばね‥‥」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「で‥‥？」"},
{"id": 227, "speaker": 16, "form": "dlg", "jp": "「ソイツ、ある倉庫に入っていったのよ‥‥」"},
{"id": 228, "speaker": 16, "form": "dlg", "jp": "「それ以上はコワくなって帰ったんだけど‥‥」"},
{"id": 229, "speaker": 16, "form": "dlg", "jp": "「アイツ、あの倉庫で働いてるのかな？」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「『幽霊』なら働いてないだろうね‥‥」"},
{"id": 231, "speaker": 16, "form": "dlg", "jp": "「とにかく、あそこへ行けば、\n　すべてがわかるような気がするの‥‥」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「わかったよ、ついて行くよ‥‥」"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "こうしてボクは長尾と２人で\n長尾の言う『倉庫』へ行くことになった。"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「いやだよ、そんなの‥‥」"},
{"id": 235, "speaker": 16, "form": "dlg", "jp": "「どうして！！」"},
{"id": 236, "speaker": 2, "form": "dlg", "jp": "「きっとそれ、長尾の見間違いだよ‥‥」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「こないだのこともあるし‥‥」"},
{"id": 238, "speaker": 16, "form": "dlg", "jp": "「そうかな‥‥」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「とにかく、ボクは行かないよ‥‥」"},
{"id": 240, "speaker": 16, "form": "dlg", "jp": "「常光寺くんなら\n　ついて来てくれるって思ったのに‥‥」"},
{"id": 241, "speaker": 16, "form": "dlg", "jp": "しかたないよな‥‥"},
{"id": 242, "speaker": 16, "form": "dlg", "jp": "ボクは『犬の事件』を調べないといけないし‥‥"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 244, "speaker": 16, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 245, "speaker": 16, "form": "dlg", "jp": "「アキラ１人で調べてくるわよ‥‥」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「また、何かわかったら教えてくれよ‥‥」"},
{"id": 247, "speaker": 16, "form": "dlg", "jp": "「イヤよ！」"},
{"id": 248, "speaker": 16, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 249, "speaker": 16, "form": "dlg", "jp": "「バタン！」"},
{"id": 250, "speaker": 16, "form": "dlg", "jp": "「タン、タン、タン、タン、タン‥‥」"},
{"id": 251, "speaker": 16, "form": "dlg", "jp": "長尾は怒って帰ってしまった。"},
{"id": 252, "speaker": 16, "form": "dlg", "jp": "さてと、コッチはコッチの用事をすませるかな‥‥"},
{"id": 253, "speaker": 16, "form": "dlg", "jp": "とりあえず、顔の広そうな『シンちゃん』に\n『犬の事件』のことを聞いてみるか‥‥"},
{"id": 254, "speaker": 16, "form": "dlg", "jp": "ボクは携帯電話をとりだし、\n『シンちゃん』に電話をかけた。"},
{"id": 255, "speaker": 16, "form": "dlg", "jp": "「ピ・ポ・パ・ポ・ピ‥‥」"},
{"id": 256, "speaker": 16, "form": "dlg", "jp": "「ピッ！」"},
{"id": 257, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 258, "speaker": 14, "form": "dlg", "jp": "（もしもーし！）"},
{"id": 259, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "「シンちゃん？」"},
{"id": 261, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 262, "speaker": 14, "form": "dlg", "jp": "（なんだ、ナゴムか？）"},
{"id": 263, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "「ちょっと話があるんだけど‥‥」"},
{"id": 265, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 266, "speaker": 14, "form": "dlg", "jp": "（オマエ、今ヒマか？）"},
{"id": 267, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "「ヒマだけど‥‥」"},
{"id": 269, "speaker": 2, "form": "dlg", "jp": "なんか、今日はこのやりとりばかりだな‥‥"},
{"id": 270, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 271, "speaker": 14, "form": "dlg", "jp": "（じゃあ、\n　今から『スーパーヒーロー』に来いよ！）"},
{"id": 272, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「あ、ああ‥‥」"},
{"id": 274, "speaker": 2, "form": "dlg", "jp": "「ピッ！」"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "『スーパーヒーロー』っていうのは\nボクたちの行きつけの『ゲームセンター』だ。"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "ボクはシンちゃんに会うために、\n『スーパーヒーロー』に行くことにした。"},
{"id": 277, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 279, "speaker": 14, "form": "dlg", "jp": "「遅いよ！」"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "「これでもかなり急いで来たのに‥‥」"},
{"id": 281, "speaker": 14, "form": "dlg", "jp": "「ハハハハハハ‥‥」"},
{"id": 282, "speaker": 14, "form": "dlg", "jp": "「で、話ってなんだ？」"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "「シンちゃん、\n　『犬が人間を襲う』って話を聞いたことない？」"},
{"id": 284, "speaker": 14, "form": "dlg", "jp": "「それって、ニュースで最近やってるヤツだろう？」"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "「よかった、知ってるんだよね！」"},
{"id": 286, "speaker": 14, "form": "dlg", "jp": "「知ってるもなにも、\n　こないだこの町でもあっただろう‥‥」"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "「そう！」"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「あったんだよ！！」"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "「で、もっと何か知らないかな？」"},
{"id": 290, "speaker": 14, "form": "dlg", "jp": "「あっ、ウチの店のお客さんの１人が\n　被害にあったって言ってたな」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「シンちゃんちの？」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "シンちゃんの家は『美容室』だ。"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "「その人どんな人だったの？」"},
{"id": 294, "speaker": 14, "form": "dlg", "jp": "「そこまでは知らないな～」"},
{"id": 295, "speaker": 14, "form": "dlg", "jp": "「まあ、ウチの客だから、\n　女の人だとは思うけど‥‥」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「その他は？」"},
{"id": 297, "speaker": 14, "form": "dlg", "jp": "「なんだよ、何がそんなに気になるんだ？」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "「いや、あの‥‥」"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "そうだよな‥‥"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "こんな話いきなりしたら怪しいよな‥‥"},
{"id": 301, "speaker": 2, "form": "dlg", "jp": "「いや、ウチも犬を飼おうかなって思って？」"},
{"id": 302, "speaker": 14, "form": "dlg", "jp": "「ふーん‥‥」"},
{"id": 303, "speaker": 14, "form": "dlg", "jp": "その時！！"},
{"id": 304, "speaker": 16, "form": "dlg", "jp": "「常光寺くん！！」"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「な、長尾‥‥」"},
{"id": 306, "speaker": 16, "form": "dlg", "jp": "「アキラの誘いを断わっておいて、\n　ゲームセンターなんかで遊んでるなんて！」"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "「ち、ちがうよ！\n　ボクは別に遊んでるワケじゃあ‥‥」"},
{"id": 308, "speaker": 14, "form": "dlg", "jp": "「もしかして、『幽霊』のことか？」"},
{"id": 309, "speaker": 2, "form": "dlg", "jp": "「シンちゃんも誘われたの？」"},
{"id": 310, "speaker": 14, "form": "dlg", "jp": "「ちょっとだけな‥‥」"},
{"id": 311, "speaker": 16, "form": "dlg", "jp": "「いいのよ、関口くんのことは\n　初めからアテにしてないから‥‥」"},
{"id": 312, "speaker": 16, "form": "dlg", "jp": "「それより、常光寺くん！！」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 314, "speaker": 16, "form": "dlg", "jp": "「アキラのたのみと、\n　ゲームとどっちが大切なの？」"},
{"id": 315, "speaker": 16, "form": "choice", "jp": "「もちろん『ゲーム』‥‥」"},
{"id": 316, "speaker": 16, "form": "choice", "jp": "「わかったよ、ついて行くよ‥‥」"},
{"id": 317, "speaker": 2, "form": "dlg", "jp": "「わかったよ、ついて行くよ‥‥」"},
{"id": 318, "speaker": 16, "form": "dlg", "jp": "「別にイヤならいいのよ‥‥」"},
{"id": 319, "speaker": 2, "form": "dlg", "jp": "「いいよ、ついて行くよ‥‥」"},
{"id": 320, "speaker": 16, "form": "dlg", "jp": "「アラ、そう？」"},
{"id": 321, "speaker": 16, "form": "dlg", "jp": "「じゃあ、\n　ちょっと常光寺くんを借りるわね‥‥」"},
{"id": 322, "speaker": 14, "form": "dlg", "jp": "「いいよ、煮るなり焼くなり\n　好きにしてやってくれ‥‥」"},
{"id": 323, "speaker": 2, "form": "dlg", "jp": "「シンちゃん‥‥」"},
{"id": 324, "speaker": 14, "form": "dlg", "jp": "「じゃあな‥‥」"},
{"id": 325, "speaker": 16, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 326, "speaker": 16, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 327, "speaker": 16, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 328, "speaker": 2, "form": "dlg", "jp": "「で、何を確認するつもりなんだ？」"},
{"id": 329, "speaker": 16, "form": "dlg", "jp": "「だから、『倉庫』よ！」"},
{"id": 330, "speaker": 2, "form": "dlg", "jp": "「『倉庫』？」"},
{"id": 331, "speaker": 16, "form": "dlg", "jp": "「昨日、その『幽霊』が消えた『倉庫』‥‥」"},
{"id": 332, "speaker": 16, "form": "dlg", "jp": "「アイツ、あの倉庫で働いてるのかな？」"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "「『幽霊』なら働いてないだろうね‥‥」"},
{"id": 334, "speaker": 16, "form": "dlg", "jp": "「とにかく、あそこへ行けば、\n　すべてがわかるような気がするの‥‥」"},
{"id": 335, "speaker": 2, "form": "dlg", "jp": "「わかったよ、ついて行くよ‥‥」"},
{"id": 336, "speaker": 2, "form": "dlg", "jp": "こうしてボクは長尾と２人で\n長尾の言う『倉庫』へ行くことになった。"},
{"id": 337, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 338, "speaker": 51, "form": "dlg", "jp": "「ちょっと、常光寺っ！！」"},
{"id": 339, "speaker": 2, "form": "dlg", "jp": "「お、小田‥‥」"},
{"id": 340, "speaker": 51, "form": "dlg", "jp": "「人の誘いを断わっておいて、\n　ゲームセンターなんかで遊んでるんや！」"},
{"id": 341, "speaker": 2, "form": "dlg", "jp": "「ち、ちがうよ！\n　ボクは別に遊んでるワケじゃあ‥‥」"},
{"id": 342, "speaker": 14, "form": "dlg", "jp": "「もしかして、『幽霊』のことか？」"},
