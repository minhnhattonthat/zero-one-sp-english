[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／２４／ＡＭ１０：００"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「コン、コン」"},
{"id": 2, "speaker": 3, "form": "dlg", "jp": "「ナゴム、早くしなさい\n　新幹線に間に合わないわよ！」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「うん、わかった！」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "姉さんは今日から、学会に参加するために\n大阪の大学に行くことになっており、"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "ボクと三田さんも、いっしょに\nついて行くことになっていた。"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「今、行くよ！」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 8, "speaker": 26, "form": "dlg", "jp": "「さあ、行こうか‥‥」"},
{"id": 9, "speaker": 26, "form": "dlg", "jp": "ボクたちは、新幹線で大阪へと向かった。"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「姉さん‥‥」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「発表って、『人工知能』のだろう？」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「シローのこと発表しちゃうの？」"},
{"id": 13, "speaker": 3, "form": "dlg", "jp": "「少しだけね‥‥」"},
{"id": 14, "speaker": 3, "form": "dlg", "jp": "「インターポールが動いちゃったから、\n　ある程度は世間にも知られちゃったでしょうし‥‥」"},
{"id": 15, "speaker": 3, "form": "dlg", "jp": "「でも、全部は発表しないわ‥‥」"},
{"id": 16, "speaker": 3, "form": "dlg", "jp": "「多分、今の時代には\n　まだ早すぎるように思うの‥‥」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 18, "speaker": 3, "form": "dlg", "jp": "「ただ、このまま人間の科学が進歩してゆくんだったら、\n　ああいった人格の存在や人権のことについては」"},
{"id": 19, "speaker": 3, "form": "dlg", "jp": "「知ってもらっておきたいの‥‥」"},
{"id": 20, "speaker": 26, "form": "dlg", "jp": "「でも、注意しないと危険ですよ！」"},
{"id": 21, "speaker": 26, "form": "dlg", "jp": "「やっぱり、ああゆうのを面白がって\n　批判する学者って結構いますから‥‥」"},
{"id": 22, "speaker": 26, "form": "dlg", "jp": "「お父さんも、最初にロボットの研究を始めた頃は\n　かなり非難されたみたいですよ！」"},
{"id": 23, "speaker": 26, "form": "dlg", "jp": "「やっぱり、ネタミとか有名欲で、\n　他人を批難する人間って結構いますから‥‥」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「そんなことをして有名になれるの？」"},
{"id": 25, "speaker": 26, "form": "dlg", "jp": "「注目されているものを批難すると、\n　注目されちゃうんですよ‥‥」"},
{"id": 26, "speaker": 26, "form": "dlg", "jp": "「例えば、今の時代にメンコの賭博性を\n　とやかくいう教育学者って目立たないけど」"},
{"id": 27, "speaker": 26, "form": "dlg", "jp": "「ゲームの暴力性を批難すると、\n　注目されるだろう？」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「なんかわかる気がする‥‥」"},
{"id": 29, "speaker": 26, "form": "dlg", "jp": "「だろう？」"},
{"id": 30, "speaker": 26, "form": "dlg", "jp": "「最近でも『クローン』の人権が\n　話題になってたけど‥‥」"},
{"id": 31, "speaker": 26, "form": "dlg", "jp": "「人工知能の人権なんて‥‥」"},
{"id": 32, "speaker": 26, "form": "dlg", "jp": "「まあ、気をつけて発表してくださいね‥‥」"},
{"id": 33, "speaker": 3, "form": "dlg", "jp": "「ありがとうございます」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「で、向こうではどんなとこに泊まるの？」"},
{"id": 35, "speaker": 3, "form": "dlg", "jp": "「アッチの大学の『清田さん』って人が\n　ホテルを用意してくれているわ」"},
{"id": 36, "speaker": 26, "form": "dlg", "jp": "「キヨタ！！」"},
{"id": 37, "speaker": 26, "form": "dlg", "jp": "「まさか、『清田ユウリ』じゃぁ！？」"},
{"id": 38, "speaker": 3, "form": "dlg", "jp": "「御存じなんですか？」"},
{"id": 39, "speaker": 26, "form": "dlg", "jp": "「やっぱり！！」"},
{"id": 40, "speaker": 26, "form": "dlg", "jp": "「御存じも何も、\n　彼も元、"},
{"id": 41, "speaker": 26, "form": "dlg", "jp": "博士の助手"},
{"id": 42, "speaker": 26, "form": "dlg", "jp": "ですよ」"},
{"id": 43, "speaker": 3, "form": "dlg", "jp": "「そうなんですか？」"},
{"id": 44, "speaker": 3, "form": "dlg", "jp": "「私はメールだけのおつき合いなんで‥‥」"},
{"id": 45, "speaker": 26, "form": "dlg", "jp": "「会ったことないんですね？」"},
{"id": 46, "speaker": 26, "form": "dlg", "jp": "「会ったらきっと驚きますよ！」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「なんで驚くの？」"},
{"id": 48, "speaker": 26, "form": "dlg", "jp": "「まあ、あった時の楽しみってことで‥‥」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「思わせぶりだなぁ～」"},
{"id": 50, "speaker": 3, "form": "dlg", "jp": "「ねえ、それより‥‥」"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 52, "speaker": 3, "form": "dlg", "jp": "「この新幹線おかしくない？」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 54, "speaker": 3, "form": "dlg", "jp": "「さっきから、乗務員がなんだかバタバタ\n　あわててるようなんだけど‥‥」"},
{"id": 55, "speaker": 26, "form": "dlg", "jp": "「そういえば‥‥」"},
{"id": 56, "speaker": 3, "form": "dlg", "jp": "「それに、もうすぐ京都なのに、\n　"},
{"id": 57, "speaker": 3, "form": "dlg", "jp": "ぜんぜん減速しない"},
{"id": 58, "speaker": 3, "form": "dlg", "jp": "んだけど‥‥」"},
{"id": 59, "speaker": 26, "form": "dlg", "jp": "「まさか！！」"},
{"id": 60, "speaker": 26, "form": "dlg", "jp": "「流行りの機械の誤作動！？」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "（まさかっ！？）"},
{"id": 62, "speaker": 3, "form": "dlg", "jp": "「もしそうだとすると、どうなるのかしら？」"},
{"id": 63, "speaker": 26, "form": "dlg", "jp": "「機械の暴走なら、\n　まったく予想できないですよ！」"},
{"id": 64, "speaker": 26, "form": "dlg", "jp": "その時‥‥"},
{"id": 65, "speaker": 36, "form": "dlg", "jp": "「ご案内いたします」"},
{"id": 66, "speaker": 36, "form": "dlg", "jp": "「当列車は、"},
{"id": 67, "speaker": 36, "form": "dlg", "jp": "運転システムのトラブル"},
{"id": 68, "speaker": 36, "form": "dlg", "jp": "のため‥‥」"},
{"id": 69, "speaker": 36, "form": "dlg", "jp": "「予定をしておりました京都への停車を\n　中止させていただきます」"},
{"id": 70, "speaker": 36, "form": "dlg", "jp": "「京都へは新大阪からの\n　折り返し便を御利用くださいますよう」"},
{"id": 71, "speaker": 36, "form": "dlg", "jp": "「よろしくお願いいたします‥‥」"},
{"id": 72, "speaker": 36, "form": "dlg", "jp": "「なお‥‥」"},
{"id": 73, "speaker": 26, "form": "dlg", "jp": "「やっぱりですね！」"},
{"id": 74, "speaker": 26, "form": "dlg", "jp": "とたん、乗客が騒ぎ出した。"},
{"id": 75, "speaker": 3, "form": "dlg", "jp": "「どうなるのかしら」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "（やっぱりこれも『ゲーマー』の仕業？）"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "（だとしたら‥‥）"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "（とりあえずテレパシーでジーンに連絡を‥‥）"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "（ジーン！！）"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "（ジーン‥‥！！）"},
{"id": 81, "speaker": 29, "form": "dlg", "jp": "（何よっ！）"},
{"id": 82, "speaker": 29, "form": "dlg", "jp": "（今日はオオサカじゃなかったの？）"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "（そうなんだけど‥‥）"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "（どうも今乗ってる新幹線が、\n　『暴走』しているみたいなんだ‥‥）"},
{"id": 85, "speaker": 29, "form": "dlg", "jp": "（それ、本当なの？）"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "（わからない‥‥）"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "（とりあえず、調べてくれないかな？）"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "（わかったわ！）"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "（ちょっと待ってて‥‥）"},
{"id": 90, "speaker": 29, "form": "dlg", "jp": "ボクはジーンの能力で、\nこの新幹線を調べてもらうことにした。"},
{"id": 91, "speaker": 26, "form": "dlg", "jp": "「ちゃんと、新大阪では止まってくれますかね？」"},
{"id": 92, "speaker": 3, "form": "dlg", "jp": "「それより、\n　このままずっと止まらなかった時の方が心配だわ‥‥」"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "「このまま止まらなかったらどうなるの？」"},
{"id": 94, "speaker": 3, "form": "dlg", "jp": "「そうね、"},
{"id": 95, "speaker": 3, "form": "dlg", "jp": "ずっと加速しつづけて脱線する"},
{"id": 96, "speaker": 3, "form": "dlg", "jp": "とか‥‥」"},
{"id": 97, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 98, "speaker": 3, "form": "dlg", "jp": "前を進んでいる列車に衝突"},
{"id": 99, "speaker": 3, "form": "dlg", "jp": "しちゃうとか‥‥」"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "（ナゴム‥‥）"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "（ジーンからだ！）"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "（何かわかった？）"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "（聞こえた乗務員の話しからすると、\n　やっぱり"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "コントロールが効かない"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "みたい！）"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "（たぶん、"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "ゲーマーの仕業"},
{"id": 108, "speaker": 29, "form": "dlg", "jp": "だと思うわ‥‥）"},
{"id": 109, "speaker": 29, "form": "choice", "jp": "（でも、飛行機じゃなくてよかった。）"},
{"id": 110, "speaker": 29, "form": "choice", "jp": "（電車ってのがマズすぎる！！）"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "（でも、飛行機じゃなくてよかった）"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "（どうして？）"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "（線路の上を走ってる限り、\n　おかしな所にぶつけたりされないし‥‥）"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "（そんなことないわよ！！）"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "（線路の先にずっと障害物がないと思ってるの？）"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "（線路の上を走ってる限り、\n　逃げようがないのよ！）"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "（それに、ロボットの時のことを覚えていないの？）"},
{"id": 118, "speaker": 29, "form": "dlg", "jp": "（もし、ゲーマーの仕業なら、\n　動力源を破壊すれば止めることができる）"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "（つまり燃料切れでも止まるのよ）"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "（飛行機なら燃料切れもありうるけど、\n　電車ならそれはありえないでしょう！）"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "（たしかに‥‥）"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "（電車ってのがマズすぎる！！）"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "（ロボットの時のことを覚えてる？）"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "（もし、ゲーマーの仕業なら、\n　動力源を破壊すれば止めることができる）"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "（つまり燃料切れでも止まるけど‥‥）"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "（飛行機なら燃料切れもありうるけど、\n　電車ならそれはありえない！）"},
{"id": 127, "speaker": 29, "form": "dlg", "jp": "（たしかに‥‥）"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "（とにかく、先に障害物がないかどうか\n　調べてみるわ！）"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "（頼む‥‥）"},
{"id": 130, "speaker": 26, "form": "dlg", "jp": "「ナゴムくん‥‥」"},
{"id": 131, "speaker": 26, "form": "dlg", "jp": "「どうしたんだい、ボーッとして？」"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "「いや、なんでもないよ！」"},
{"id": 133, "speaker": 3, "form": "dlg", "jp": "「大丈夫かしら？」"},
{"id": 134, "speaker": 26, "form": "dlg", "jp": "「まあ、大丈夫でしょう‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "（三田さんはノンキだなぁ～）"},
{"id": 136, "speaker": 29, "form": "dlg", "jp": "（ナゴム‥‥）"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "（大変よ！！）"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "（その先で別の車両が停止しているわ！！）"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "（なんだって！！）"},
{"id": 140, "speaker": 29, "form": "dlg", "jp": "（このままでは、"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "衝突"},
{"id": 142, "speaker": 29, "form": "dlg", "jp": "してしまうわ！）"},
{"id": 143, "speaker": 29, "form": "dlg", "jp": "（早くなんとか止めて！！）"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "（止めろっても‥‥）"},
{"id": 145, "speaker": 2, "form": "choice", "jp": "（いったいどうすれば‥‥）"},
{"id": 146, "speaker": 2, "form": "choice", "jp": "（わかった動力源を破壊してみるよ！）"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "（いったいどうすれば‥‥）"},
{"id": 148, "speaker": 29, "form": "dlg", "jp": "（私は何もできないわ‥‥）"},
{"id": 149, "speaker": 29, "form": "dlg", "jp": "（とりあえず、頑張ってみてよ‥‥）"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "（そんなぁ‥‥）"},
{"id": 151, "speaker": 29, "form": "dlg", "jp": "（くれぐれも、人前で能力を使うようなマネだけは‥‥）"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "（わかってるよ！）"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "（わかった動力源を破壊してみるよ！）"},
{"id": 154, "speaker": 29, "form": "dlg", "jp": "（ダメよ！！）"},
{"id": 155, "speaker": 29, "form": "dlg", "jp": "（そんな大勢の前で、能力を使っちゃぁ！）"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "（そんなぁ‥‥）"},
{"id": 157, "speaker": 29, "form": "dlg", "jp": "（他の方法を考えて！）"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "（でも‥‥）"},
{"id": 159, "speaker": 29, "form": "dlg", "jp": "（あっ、急いで！）"},
{"id": 160, "speaker": 29, "form": "dlg", "jp": "（このままだと本当に衝突してしまうわ！！）"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "（こんな大勢の中じゃぁ、ボクの能力は使えない！）"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "（となると‥‥）"},
{"id": 163, "speaker": 2, "form": "choice", "jp": "（ケネス！！）"},
{"id": 164, "speaker": 2, "form": "choice", "jp": "（松尾さん！！）"},
{"id": 165, "speaker": 2, "form": "choice", "jp": "（シロー！！）"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "（ダメだ、どうすればいいかわからない！）"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "（ケネス！！）"},
{"id": 169, "speaker": 31, "form": "dlg", "jp": "（事情はジーンに聞いた‥‥）"},
{"id": 170, "speaker": 31, "form": "dlg", "jp": "（でも、オレの能力じゃぁ‥‥）"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "（時間がないんだ！）"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "（どうにか、してくれよ！）"},
{"id": 173, "speaker": 31, "form": "dlg", "jp": "（無理なものは、無理だよ！！）"},
{"id": 174, "speaker": 31, "form": "choice", "jp": "（ジーン！！）"},
{"id": 175, "speaker": 31, "form": "choice", "jp": "（松尾さん！！）"},
{"id": 176, "speaker": 31, "form": "choice", "jp": "（シロー！！）"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "（ジーン！！）"},
{"id": 178, "speaker": 29, "form": "dlg", "jp": "（もうダメ‥‥）"},
{"id": 179, "speaker": 29, "form": "dlg", "jp": "（時間切れよ‥‥）"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "（松尾さん！！）"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "（松尾さんっ！！）"},
{"id": 183, "speaker": 29, "form": "dlg", "jp": "（何やってんの！！）"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "（松尾さんにテレパシーが通じないんだ！）"},
{"id": 185, "speaker": 29, "form": "dlg", "jp": "（彼はテレパシーの能力が弱いのよ！）"},
{"id": 186, "speaker": 29, "form": "dlg", "jp": "（そんなに遠距離じゃぁ通じないわ！）"},
{"id": 187, "speaker": 29, "form": "dlg", "jp": "（急いで！、時間が無いわよ！）"},
{"id": 188, "speaker": 29, "form": "choice", "jp": "（ケネス！！）"},
{"id": 189, "speaker": 29, "form": "choice", "jp": "（松尾さんに仲介して！！）"},
{"id": 190, "speaker": 29, "form": "choice", "jp": "（シロー！！）"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "（松尾さんに仲介して！！）"},
{"id": 192, "speaker": 29, "form": "dlg", "jp": "（ダメ！）"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "（なんで！？）"},
{"id": 194, "speaker": 29, "form": "dlg", "jp": "（時間切れよ‥‥）"},
{"id": 195, "speaker": 29, "form": "dlg", "jp": "（早く逃げて‥‥！！）"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「シロー！！」"},
{"id": 198, "speaker": 29, "form": "dlg", "jp": "（何言ってるの！？）"},
