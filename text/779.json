[
{"id": 0, "speaker": null, "form": "dlg", "jp": "そして‥‥"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "２００５／０７／２５／ＰＭ０６：０５"},
{"id": 2, "speaker": 3, "form": "dlg", "jp": "「ねえ、起きて！」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 4, "speaker": 3, "form": "dlg", "jp": "「何か聞こえない？」"},
{"id": 5, "speaker": 26, "form": "dlg", "jp": "「『インターポール』の『ヘリ』だ！」"},
{"id": 6, "speaker": 26, "form": "dlg", "jp": "「応援が到着したんですよ！！」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「ボクたちに気付いてくれるかな？」"},
{"id": 8, "speaker": 26, "form": "dlg", "jp": "「それは、ムリだよ‥‥」"},
{"id": 9, "speaker": 26, "form": "dlg", "jp": "「気付かれない場所に隠れてるんだから‥‥」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「そんなぁ～～」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「早く見つけてもらうよ！」"},
{"id": 12, "speaker": 3, "form": "dlg", "jp": "「そんなことしたら、\n　先にルードに見つかってしまうわ！」"},
{"id": 13, "speaker": 3, "form": "dlg", "jp": "「それより、父さんは大丈夫なのかしら？」"},
{"id": 14, "speaker": 26, "form": "dlg", "jp": "「たぶん、大丈夫だと思いますよ‥‥」"},
{"id": 15, "speaker": 26, "form": "dlg", "jp": "「ヤツらは『博士の知識』を手に入れるまでは\n　ぜったい博士に手出しできないハズですから‥‥」"},
{"id": 16, "speaker": 3, "form": "dlg", "jp": "「そ、そうよね‥‥」"},
{"id": 17, "speaker": 26, "form": "dlg", "jp": "「あとはインターポールが\n　うまくやってくれることを祈るしか‥‥」"},
{"id": 18, "speaker": 26, "form": "dlg", "jp": "その時‥‥"},
{"id": 19, "speaker": 4, "form": "dlg", "jp": "「そこに誰かいるのか？」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥！？」"},
{"id": 21, "speaker": 3, "form": "dlg", "jp": "「秋山警部補！！」"},
{"id": 22, "speaker": 22, "form": "dlg", "jp": "「なんだ、アナタたちですか‥‥」"},
{"id": 23, "speaker": 22, "form": "dlg", "jp": "「無事、脱出されてたんですね？」"},
{"id": 24, "speaker": 3, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「よかった、コレでボクたちは日本へ帰れるんですね‥‥」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "ボクは秋山警部補に駆け寄った。"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 28, "speaker": 26, "form": "dlg", "jp": "「誰ですか？　あの人は？」"},
{"id": 29, "speaker": 3, "form": "dlg", "jp": "「インターポールの『秋山警部補』です！」"},
{"id": 30, "speaker": 26, "form": "dlg", "jp": "「秋山ぁ～～～～～っ！」"},
{"id": 31, "speaker": 26, "form": "dlg", "jp": "「ナゴムくん、ソイツから離れるんだ！」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 33, "speaker": 26, "form": "dlg", "jp": "「ソイツは『ルードのスパイ』だ！！」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 35, "speaker": 22, "form": "dlg", "jp": "「動くなっ！」"},
{"id": 36, "speaker": 22, "form": "dlg", "jp": "「オレの『この手』には\n　『殺人レーザー発射装置』が装備されているんだぞ！」"},
{"id": 37, "speaker": 22, "form": "dlg", "jp": "「死にたくなければ、\n　大人しくオレについてこい！」"},
{"id": 38, "speaker": 3, "form": "dlg", "jp": "「ナゴムをどうするつもりなんです！」"},
{"id": 39, "speaker": 22, "form": "dlg", "jp": "「人質にさせてもらうよ‥‥」"},
{"id": 40, "speaker": 22, "form": "dlg", "jp": "「さあ、大人しくついて来るんだ！」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「ちくしょうっ！」"},
{"id": 42, "speaker": 26, "form": "dlg", "jp": "「ナゴムくん、抵抗しちゃダメだ！」"},
{"id": 43, "speaker": 26, "form": "dlg", "jp": "「今は大人しくするんだ‥‥」"},
{"id": 44, "speaker": 26, "form": "dlg", "jp": "「ソイツが来てるってことは\n　インターポールも来てるハズだし‥‥」"},
{"id": 45, "speaker": 26, "form": "dlg", "jp": "「シローだって‥‥」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 47, "speaker": 22, "form": "dlg", "jp": "「ハハハハハハハハ‥‥」"},
{"id": 48, "speaker": 22, "form": "dlg", "jp": "「シローってあのロボットか？」"},
{"id": 49, "speaker": 22, "form": "dlg", "jp": "「アイツなら来ないよ‥‥」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥！？」"},
{"id": 51, "speaker": 22, "form": "dlg", "jp": "「警察でコンピューターをゴソゴソやってたから、\n　オレが壊してやったよ‥‥」"},
{"id": 52, "speaker": 3, "form": "dlg", "jp": "「なんですって！！」"},
{"id": 53, "speaker": 22, "form": "dlg", "jp": "「バッテリーを打ち抜いたら\n　一発で動かなくなったよ‥‥」"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 55, "speaker": 22, "form": "dlg", "jp": "「まあ、そういうことだ‥‥」"},
{"id": 56, "speaker": 22, "form": "dlg", "jp": "「じゃあな‥‥」"},
{"id": 57, "speaker": 22, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 58, "speaker": 22, "form": "dlg", "jp": "こうしてボクは再び工場の中に連れ戻されることになった。"},
{"id": 59, "speaker": 22, "form": "dlg", "jp": "工場の中にはすでにインターポールの\n特殊部隊の突入作戦が始まっており、"},
{"id": 60, "speaker": 22, "form": "dlg", "jp": "あちらこちらで銃撃の音が鳴りひびいていた。"},
{"id": 61, "speaker": 22, "form": "dlg", "jp": "ボクは工場の奥にある研究施設へと連行された。"},
{"id": 62, "speaker": 28, "form": "dlg", "jp": "「けっ、インターポールの連中め‥‥」"},
{"id": 63, "speaker": 22, "form": "dlg", "jp": "「人質を１匹連れて来ました！」"},
{"id": 64, "speaker": 28, "form": "dlg", "jp": "「よくやった、アキヤマ！！」"},
{"id": 65, "speaker": 22, "form": "dlg", "jp": "「さあ、オヤジに会わせてやるぞ‥‥」"},
{"id": 66, "speaker": 22, "form": "dlg", "jp": "「ホラよ‥‥」"},
{"id": 67, "speaker": 27, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥！？」"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "「と、父さんっ！！」"},
{"id": 69, "speaker": 27, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 70, "speaker": 27, "form": "dlg", "jp": "「リツコや三田くんは？」"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "「わからない‥‥」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "「ジャングルでボクだけが捕まったから‥‥」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「でも、たぶん大丈夫だと‥‥」"},
{"id": 74, "speaker": 27, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 75, "speaker": 27, "form": "choice", "jp": "「父さんは大丈夫なの？」"},
{"id": 76, "speaker": 27, "form": "choice", "jp": "「もうすぐインターポールが助けてくれるよ！」"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "「父さんは大丈夫なの？」"},
{"id": 78, "speaker": 27, "form": "dlg", "jp": "「大丈夫だ‥‥」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「もうすぐインターポールが助けてくれるよ！」"},
{"id": 80, "speaker": 28, "form": "dlg", "jp": "「フフフフフ‥‥」"},
{"id": 81, "speaker": 28, "form": "dlg", "jp": "「それはどうかな？」"},
{"id": 82, "speaker": 22, "form": "dlg", "jp": "「大佐、状況は？」"},
{"id": 83, "speaker": 28, "form": "dlg", "jp": "「オマエの情報のおかげで\n　さほど苦戦はしていない‥‥」"},
{"id": 84, "speaker": 28, "form": "dlg", "jp": "「しかし、\n　この工場は手放すことになるだろうな‥‥」"},
{"id": 85, "speaker": 28, "form": "dlg", "jp": "「ヤツらに場所がバレた以上\n　これまで通りというわけには‥‥」"},
{"id": 86, "speaker": 22, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 87, "speaker": 28, "form": "dlg", "jp": "「もちろん、タダで手放すつもりはないがな‥‥」"},
{"id": 88, "speaker": 22, "form": "dlg", "jp": "「と、もうしますと？」"},
{"id": 89, "speaker": 28, "form": "dlg", "jp": "「工場中に『爆弾』を仕掛けさせてもらった‥‥」"},
{"id": 90, "speaker": 28, "form": "dlg", "jp": "「インターポールの連中は\n　工場ごとあの世行きだ‥‥」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥！！）"},
{"id": 92, "speaker": 22, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "（なんてヒドイことを‥‥）"},
{"id": 94, "speaker": 28, "form": "dlg", "jp": "「それにしても、あのアンドロイドめ‥‥」"},
{"id": 95, "speaker": 28, "form": "dlg", "jp": "「アイツのせいで\n　この工場を失うことになるとは‥‥」"},
{"id": 96, "speaker": 28, "form": "dlg", "jp": "「本来なら生みの親のキサマを\n　殺したいところなんだが‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "（やっぱり、コイツら‥‥）"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "（父さんの知識を手に入れるまで\n　父さんに手出しできないんだ‥‥）"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "（と言うことは、\n　ルードはまだ父さんの知識を手に入れてない！）"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "（じゃあ、ルードのサイボーグは\n　父さんが造ったんじゃないんだ！）"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "「父さん、ルードのサイボーグは父さんが造ったの？」"},
{"id": 102, "speaker": 27, "form": "dlg", "jp": "「いいや‥‥」"},
{"id": 103, "speaker": 22, "form": "dlg", "jp": "「そんなワケないだろう！」"},
{"id": 104, "speaker": 22, "form": "dlg", "jp": "「このオイボレが造ったアンドロイドは、\n　バッテリーを破壊されただけでガラクタになるんだ‥‥」"},
{"id": 105, "speaker": 22, "form": "dlg", "jp": "「そんなものが兵器として通用すると思うか？」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 107, "speaker": 28, "form": "dlg", "jp": "「ワレワレはドクターの\n　機械と神経をつなぐ技術を欲しているんだよ‥‥」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "「神経？」"},
{"id": 109, "speaker": 28, "form": "dlg", "jp": "「工業的な技術力では、\n　たぶん、ワレワレのスタッフの方が」"},
{"id": 110, "speaker": 28, "form": "dlg", "jp": "「ドクターよりずっと優秀だからな‥‥」"},
{"id": 111, "speaker": 28, "form": "choice", "jp": "「ウソだ！！」"},
{"id": 112, "speaker": 28, "form": "choice", "jp": "「本当なの？」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「ウソだ！！」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「本当なの？」"},
{"id": 115, "speaker": 22, "form": "dlg", "jp": "「見せてあげよう‥‥」"},
{"id": 116, "speaker": 22, "form": "dlg", "jp": "「オレの『殺人レーザー』の威力‥‥」"},
{"id": 117, "speaker": 22, "form": "dlg", "jp": "そういって、秋山は腕を壁の方にかまえた。"},
{"id": 118, "speaker": 22, "form": "dlg", "jp": "「ビューン！」"},
{"id": 119, "speaker": 22, "form": "dlg", "jp": "「鋼鉄製のドアもあの通りだ‥‥」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥！！」"},
{"id": 121, "speaker": 27, "form": "dlg", "jp": "「くだらん‥‥」"},
{"id": 122, "speaker": 22, "form": "dlg", "jp": "「負け惜しみを‥‥」"},
{"id": 123, "speaker": 22, "form": "dlg", "jp": "「アンタのアンドロイドはこのレーザーで一発で‥‥」"},
{"id": 124, "speaker": 27, "form": "dlg", "jp": "「おおかたバッテリーを破壊したんだろう？」"},
{"id": 125, "speaker": 22, "form": "dlg", "jp": "「その通り‥‥」"},
{"id": 126, "speaker": 22, "form": "dlg", "jp": "「しかし‥‥」"},
{"id": 127, "speaker": 22, "form": "dlg", "jp": "「バッテリーを破壊されただけで\n　動けなくなるというのもどうだか‥‥」"},
{"id": 128, "speaker": 22, "form": "dlg", "jp": "「ちなみに、この腕には\n　独立したバッテリーが仕組まれてるから」"},
{"id": 129, "speaker": 22, "form": "dlg", "jp": "「例え、オレが死んでも動き続けるがな‥‥」"},
{"id": 130, "speaker": 8, "form": "dlg", "jp": "「失礼します！」"},
{"id": 131, "speaker": 28, "form": "dlg", "jp": "「どうした？」"},
{"id": 132, "speaker": 8, "form": "dlg", "jp": "「『潜水艦』の準備ができました！」"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "（『潜水艦』！？）"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "どうやら、この工場には潜水艦のドックがあり\nコイツらはそれを利用して脱出するつもりらしい。"},
{"id": 135, "speaker": 28, "form": "dlg", "jp": "「よし、じゃあ行くか‥‥」"},
{"id": 136, "speaker": 28, "form": "dlg", "jp": "「ついてこい！」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「父さん‥‥」"},
{"id": 138, "speaker": 27, "form": "dlg", "jp": "「今は従うんだ‥‥」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥」"},
{"id": 140, "speaker": 22, "form": "dlg", "jp": "「さあ、早くしろよ！」"},
{"id": 141, "speaker": 22, "form": "dlg", "jp": "「急がないとオレたちまで\n　爆発に巻き込まれるだろう‥‥」"},
{"id": 142, "speaker": 22, "form": "dlg", "jp": "「ハハハハハハハハハ‥‥」"},
{"id": 143, "speaker": 22, "form": "dlg", "jp": "ボクたちは秋山たちとともに\n潜水艦のドックへ向かった。"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "（姉さんたちは大丈夫だよね？）"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "（爆発に巻き込まれるようなことないよね‥‥）"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 150, "speaker": 27, "form": "dlg", "jp": "「"},
{"id": 151, "speaker": 27, "form": "dlg", "jp": "（シローがうまくやってくれていればな‥‥）"},
{"id": 152, "speaker": 27, "form": "dlg", "jp": "」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "（シロー？）"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 156, "speaker": 27, "form": "dlg", "jp": "「"},
{"id": 157, "speaker": 27, "form": "dlg", "jp": "（シローにここのコンピューターを\n　ハッキングするようにたのんでおいたんだ‥‥）"},
{"id": 158, "speaker": 27, "form": "dlg", "jp": "」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "（ダメだよ！！）"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "（シローはもう‥‥）"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 165, "speaker": 27, "form": "dlg", "jp": "「"},
{"id": 166, "speaker": 27, "form": "dlg", "jp": "（どうかしたのか？）"},
{"id": 167, "speaker": 27, "form": "dlg", "jp": "」"},
{"id": 168, "speaker": 27, "form": "dlg", "jp": "その時‥‥"},
{"id": 169, "speaker": 27, "form": "dlg", "jp": "「ドカーン！！」"},
{"id": 170, "speaker": 28, "form": "dlg", "jp": "「フフフフフフフ‥‥」"},
{"id": 171, "speaker": 28, "form": "dlg", "jp": "「最初の爆発が始まったか‥‥」"},
{"id": 172, "speaker": 28, "form": "dlg", "jp": "「予定より少し早いようだが‥‥」"},
{"id": 173, "speaker": 28, "form": "dlg", "jp": "「オイ、急げっ！」"},
{"id": 174, "speaker": 8, "form": "dlg", "jp": "「違います！」"},
{"id": 175, "speaker": 28, "form": "dlg", "jp": "「どうした？」"},
{"id": 176, "speaker": 8, "form": "dlg", "jp": "「今の爆発は『潜水艦のドック』が‥‥」"},
{"id": 177, "speaker": 28, "form": "dlg", "jp": "「なんだとっ！」"},
{"id": 178, "speaker": 8, "form": "dlg", "jp": "「インターポールの連中、『軍事衛星』をつかって‥‥」"},
{"id": 179, "speaker": 28, "form": "dlg", "jp": "「『軍事衛星』だと！？」"},
{"id": 180, "speaker": 8, "form": "dlg", "jp": "「ハイ、たぶん‥‥」"},
{"id": 181, "speaker": 27, "form": "dlg", "jp": "「"},
{"id": 182, "speaker": 27, "form": "dlg", "jp": "（ナゴム、逃げるぞっ！！）"},
{"id": 183, "speaker": 27, "form": "dlg", "jp": "」"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "（へっ？）"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 187, "speaker": 27, "form": "dlg", "jp": "「"},
{"id": 188, "speaker": 27, "form": "dlg", "jp": "（早くっ！）"},
{"id": 189, "speaker": 27, "form": "dlg", "jp": "」"},
{"id": 190, "speaker": 27, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 191, "speaker": 27, "form": "dlg", "jp": "ボクたちは爆発さわぎにビンジョウして\n逃げ出すことにした。"},
{"id": 192, "speaker": 22, "form": "dlg", "jp": "「オイ、どこへ行くつもりだ！」"},
{"id": 193, "speaker": 22, "form": "dlg", "jp": "「逃がすかぁ～～～～っ！」"},
{"id": 194, "speaker": 4, "form": "dlg", "jp": "「博士、ナゴム伏せて！！」"},
{"id": 195, "speaker": 4, "form": "dlg", "jp": "館内放送の声だった‥‥"},
{"id": 196, "speaker": 22, "form": "dlg", "jp": "「何‥‥？」"},
{"id": 197, "speaker": 22, "form": "dlg", "jp": "目の前にいた秋山が一瞬にして蒸発してしまい"},
{"id": 198, "speaker": 22, "form": "dlg", "jp": "床には秋山の手だけが残されていた。"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "「いったい何が？」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "天井を見上げると、\nそこには大きな穴があいていた。"},
{"id": 201, "speaker": 27, "form": "dlg", "jp": "「シロー‥‥」"},
{"id": 202, "speaker": 27, "form": "dlg", "jp": "「とにかく今のうちに‥‥」"},
{"id": 203, "speaker": 27, "form": "choice", "jp": "「うん、わかった！」"},
{"id": 204, "speaker": 27, "form": "choice", "jp": "「ちょっと待って、『この手』武器になるんじゃぁ？」"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "「うん、わかった！」"},
{"id": 206, "speaker": 2, "form": "dlg", "jp": "ボクたちはこのスキに逃げることにした。"},
{"id": 207, "speaker": 8, "form": "dlg", "jp": "「逃げられると思ってるのか？」"},
{"id": 208, "speaker": 8, "form": "dlg", "jp": "アキスはボクたちに向かって銃を構えた。"},
{"id": 209, "speaker": 8, "form": "dlg", "jp": "「バキューン！」"},
{"id": 210, "speaker": 27, "form": "dlg", "jp": "「安心しろ、銃なんて簡単にあたるものじゃない！」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 212, "speaker": 8, "form": "dlg", "jp": "「ルードをなめるなよ！」"},
{"id": 213, "speaker": 8, "form": "dlg", "jp": "「バキューン！」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "「ウワァ！！」"},
{"id": 215, "speaker": 27, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って、『この手』武器になるんじゃぁ？」"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "ボクは足下にあった、『秋山』の手を拾い上げた。"},
{"id": 218, "speaker": 27, "form": "dlg", "jp": "「行くぞ！！」"},
{"id": 219, "speaker": 8, "form": "dlg", "jp": "「逃げられると思ってるのか？」"},
{"id": 220, "speaker": 8, "form": "dlg", "jp": "アキスはボクたちに向かって銃を構えた。"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "「させるかぁぁぁぁぁ！！！」"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "ボクはイチかバチか持っていた秋山の手を\nアキスに向けて構えてみた。"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "すると‥‥"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "「ビューン！」"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "「ビビビビビ‥‥」"},
{"id": 226, "speaker": 8, "form": "dlg", "jp": "「うぐぐぐ‥‥」"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥！」"},
{"id": 228, "speaker": 27, "form": "dlg", "jp": "「どうやら、筋肉の動きに反応して\n　発射される仕組みみたいだな‥‥」"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "「そ、そうみたいだね‥‥」"},
{"id": 230, "speaker": 8, "form": "dlg", "jp": "「ち、ちくしょう！」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「形勢逆転だな‥‥」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「コイツの威力はオマエたちの方が知ってるだろう？」"},
{"id": 233, "speaker": 28, "form": "dlg", "jp": "「オノレ‥‥」"},
{"id": 234, "speaker": 27, "form": "dlg", "jp": "「さあ、行くぞ！」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 236, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "工場の外に出ると、姉さんたちと\nブラバスキー警視がいっしょにいた。"},
{"id": 240, "speaker": 3, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 241, "speaker": 3, "form": "dlg", "jp": "「父さん！！」"},
{"id": 242, "speaker": 27, "form": "dlg", "jp": "「リツコ‥‥」"},
{"id": 243, "speaker": 27, "form": "dlg", "jp": "「メイワクかけたな‥‥」"},
{"id": 244, "speaker": 21, "form": "dlg", "jp": "「ドクタージョウコウジですね？」"},
{"id": 245, "speaker": 27, "form": "dlg", "jp": "「アナタは？」"},
{"id": 246, "speaker": 21, "form": "dlg", "jp": "「インターポールのブラバスキーです」"},
{"id": 247, "speaker": 27, "form": "dlg", "jp": "「アナタが指揮官ですか？」"},
{"id": 248, "speaker": 21, "form": "dlg", "jp": "「そうですが？」"},
{"id": 249, "speaker": 27, "form": "dlg", "jp": "「全員、今すぐ撤退させてください！」"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "「工場には爆弾が‥‥」"},
{"id": 251, "speaker": 21, "form": "dlg", "jp": "「そんなこと言われなくても\n　すでに撤退命令を出したばかりです‥‥」"},
{"id": 252, "speaker": 27, "form": "dlg", "jp": "「それは良かった‥‥」"},
{"id": 253, "speaker": 21, "form": "dlg", "jp": "「爆弾よりやっかいなのが‥‥」"},
{"id": 254, "speaker": 2, "form": "dlg", "jp": "「爆弾よりやっかいなの？」"},
{"id": 255, "speaker": 3, "form": "dlg", "jp": "「軍事衛星が‥‥」"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "「軍事衛星？」"},
{"id": 257, "speaker": 21, "form": "dlg", "jp": "「軍の連中が動き出すとは‥‥」"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "「姉さん‥‥」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「シローが‥‥」"},
{"id": 260, "speaker": 3, "form": "dlg", "jp": "「さっき、警視から聞いたわ‥‥」"},
{"id": 261, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 262, "speaker": 21, "form": "dlg", "jp": "「まあ、ドクター救出できた以上\n　ココにはもう用はないわ‥‥」"},
{"id": 263, "speaker": 26, "form": "dlg", "jp": "「アイツらを逮捕しないんですか？」"},
{"id": 264, "speaker": 21, "form": "dlg", "jp": "「この状況じゃ、逮捕どころじゃないでしょう？」"},
{"id": 265, "speaker": 21, "form": "dlg", "jp": "「とりあえず、\n　ヤツらも無傷ではないでしょうし‥‥」"},
{"id": 266, "speaker": 26, "form": "dlg", "jp": "「せめて、あのロバートっていう幹部だけでも‥‥」"},
{"id": 267, "speaker": 21, "form": "dlg", "jp": "「たしかにロバートさえいなくなれば、\n　ルード壊滅は簡単でしょうね‥‥」"},
{"id": 268, "speaker": 21, "form": "dlg", "jp": "「でも、コチラも部下たちを\n　無駄死にさせるわけにはいかないの‥‥」"},
{"id": 269, "speaker": 27, "form": "dlg", "jp": "「三田くん‥‥」"},
{"id": 270, "speaker": 27, "form": "dlg", "jp": "「ロバートなら大丈夫だよ‥‥」"},
{"id": 271, "speaker": 26, "form": "dlg", "jp": "「どういうことですか？」"},
{"id": 272, "speaker": 27, "form": "dlg", "jp": "「ヤツは潜水艦で脱出しようと\n　この工場の一番奥に逃げ込んだんだ‥‥」"},
{"id": 273, "speaker": 27, "form": "dlg", "jp": "「その頼みの潜水艦が破壊された今となっては\n　この工場と運命をともにするしか‥‥」"},
{"id": 274, "speaker": 27, "form": "dlg", "jp": "その時！！"},
{"id": 275, "speaker": 27, "form": "dlg", "jp": "「ガシャン！」"},
{"id": 276, "speaker": 27, "form": "dlg", "jp": "「ガシャン！」"},
{"id": 277, "speaker": 3, "form": "dlg", "jp": "「何、この音‥‥」"},
{"id": 278, "speaker": 3, "form": "dlg", "jp": "「ガシャン！」"},
{"id": 279, "speaker": 3, "form": "dlg", "jp": "「ガシャン！」"},
{"id": 280, "speaker": 26, "form": "dlg", "jp": "「じ、重機みたいですね‥‥」"},
{"id": 281, "speaker": 26, "form": "dlg", "jp": "「ガシャン！」"},
{"id": 282, "speaker": 26, "form": "dlg", "jp": "「ガシャン！」"},
{"id": 283, "speaker": 3, "form": "dlg", "jp": "「アレを見て！」"},
{"id": 284, "speaker": 3, "form": "dlg", "jp": "「ガシャン！」"},
{"id": 285, "speaker": 3, "form": "dlg", "jp": "「ガシャン！」"},
{"id": 286, "speaker": 3, "form": "dlg", "jp": "燃え盛る工場の中から、巨大なロボットが\nコチラに向かって歩いてくる。"},
{"id": 287, "speaker": 28, "form": "dlg", "jp": "「ハハハハハハハハ‥‥」"},
{"id": 288, "speaker": 28, "form": "dlg", "jp": "「逃げられると思っていたのか！」"},
{"id": 289, "speaker": 28, "form": "dlg", "jp": "「ルードをなめるなよっ！」"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "「あぶない！」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「ドカーン！」"},
{"id": 292, "speaker": 28, "form": "dlg", "jp": "「ハッハハハハハ‥‥」"},
{"id": 293, "speaker": 21, "form": "dlg", "jp": "「やっぱりアイツか‥‥」"},
{"id": 294, "speaker": 21, "form": "dlg", "jp": "「くらえっ！」"},
{"id": 295, "speaker": 21, "form": "dlg", "jp": "「バキューン！」"},
{"id": 296, "speaker": 21, "form": "dlg", "jp": "「カキーン！」"},
{"id": 297, "speaker": 28, "form": "dlg", "jp": "「そんなものが通用すると思ってるのか！」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "「ちくしょう！」"},
{"id": 299, "speaker": 2, "form": "choice", "jp": "「と、とにかく逃げましょう！」"},
{"id": 300, "speaker": 2, "form": "choice", "jp": "「こ、ここはボクにまかせて！」"},
{"id": 301, "speaker": 2, "form": "dlg", "jp": "「こ、ここはボクにまかせて！」"},
{"id": 302, "speaker": 21, "form": "dlg", "jp": "「何言ってるの！！」"},
{"id": 303, "speaker": 21, "form": "dlg", "jp": "「アイツには拳銃も通用しないのよ！」"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "「拳銃よりスゴイものがあるんだ！」"},
{"id": 305, "speaker": 27, "form": "dlg", "jp": "「あの『手』を使うつもりだな？」"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 307, "speaker": 27, "form": "dlg", "jp": "「じゃあ、アイツの『動力源』を狙うんだ‥‥」"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "「『動力源』？」"},
{"id": 309, "speaker": 27, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 310, "speaker": 27, "form": "dlg", "jp": "「どんな機械でも『動力源』を破壊されたら‥‥」"},
{"id": 311, "speaker": 27, "form": "dlg", "jp": "「あの足の間の赤いパーツが『動力源』に違いない」"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "「やってみるよ！」"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "「ドカーーーーーン！」"},
{"id": 315, "speaker": 3, "form": "dlg", "jp": "「やったぁ！」"},
{"id": 316, "speaker": 26, "form": "dlg", "jp": "「ス、スゴイ‥‥」"},
{"id": 317, "speaker": 28, "form": "dlg", "jp": "「ウッウウ‥‥」"},
{"id": 318, "speaker": 21, "form": "dlg", "jp": "「カンネンしなさい‥‥」"},
{"id": 319, "speaker": 28, "form": "dlg", "jp": "「くっ、くそう‥‥」"},
{"id": 320, "speaker": 28, "form": "dlg", "jp": "こうして、ルードの大幹部の１人、\nロバート大佐は逮捕され、"},
{"id": 321, "speaker": 28, "form": "dlg", "jp": "ボクたちも無事救出された。"},
{"id": 322, "speaker": 28, "form": "dlg", "jp": "警視の話では、ロバート大佐が逮捕され、\nあの大工場が破壊された今となっては"},
{"id": 323, "speaker": 28, "form": "dlg", "jp": "ルードが壊滅するのは時間の問題だということだ‥‥"},
{"id": 324, "speaker": 28, "form": "dlg", "jp": "もう２度と父さんやボクたちが\nルードに狙われることはないだろう‥‥"},
{"id": 325, "speaker": 28, "form": "dlg", "jp": "これで全てが解決したということだ‥‥"},
{"id": 326, "speaker": 28, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥。"},
{"id": 327, "speaker": 28, "form": "dlg", "jp": "『シロー』のことをのぞいて‥‥"},
{"id": 328, "speaker": 2, "form": "dlg", "jp": "「うわぁぁぁぁぁぁぁ～～」"},
{"id": 329, "speaker": 2, "form": "dlg", "jp": "「と、とにかく逃げましょう！」"},
{"id": 330, "speaker": 21, "form": "dlg", "jp": "「シャクだけど‥‥」"},
{"id": 331, "speaker": 28, "form": "dlg", "jp": "「逃がすものか！」"},
{"id": 332, "speaker": 28, "form": "dlg", "jp": "「ドカーン！」"},
{"id": 333, "speaker": 26, "form": "dlg", "jp": "「博士、何か手立てはないんですか？」"},
{"id": 334, "speaker": 27, "form": "dlg", "jp": "「弾切れを待つか‥‥」"},
{"id": 335, "speaker": 27, "form": "dlg", "jp": "「シローに気付いてもらうか‥‥」"},
{"id": 336, "speaker": 3, "form": "dlg", "jp": "「シローに？」"},
{"id": 337, "speaker": 27, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 338, "speaker": 2, "form": "dlg", "jp": "「父さん、シローは‥‥」"},
{"id": 339, "speaker": 2, "form": "dlg", "jp": "その時！！"},
{"id": 340, "speaker": 3, "form": "dlg", "jp": "「ナゴム、危ない！！」"},
{"id": 341, "speaker": 28, "form": "dlg", "jp": "「もらったぁぁぁあっ！」"},
{"id": 342, "speaker": 28, "form": "dlg", "jp": "「ドカーーーーーン！」"},
{"id": 343, "speaker": 2, "form": "dlg", "jp": "「うわぁぁぁぁぁぁ」"},
{"id": 344, "speaker": 2, "form": "dlg", "jp": "敵の動きは一定のパターンなので見極めれば、\nあとはタイミングの問題。\n＊最初の攻撃に注意しろ！！"},
{"id": 345, "speaker": 2, "form": "dlg", "jp": "失敗の原因は判断力不足、\nキミは戦う『力』を持っていたハズ。"},
{"id": 346, "speaker": 2, "form": "dlg", "jp": "力の差のある敵と戦うには武器が必要。\nそれは逃げる場合も同じ。"}
]
