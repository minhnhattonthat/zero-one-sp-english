[
{"id": 0, "speaker": 4, "form": "dlg", "jp": "「その必要はないっ！」"},
{"id": 1, "speaker": 24, "form": "dlg", "jp": "「はあん？」"},
{"id": 2, "speaker": 24, "form": "dlg", "jp": "「カキーン！」"},
{"id": 3, "speaker": 24, "form": "dlg", "jp": "また、例の青年だった。"},
{"id": 4, "speaker": 4, "form": "dlg", "jp": "「ルードのサイボーグめ！」"},
{"id": 5, "speaker": 4, "form": "dlg", "jp": "「いくぞっ！」"},
{"id": 6, "speaker": 4, "form": "dlg", "jp": "青年はサイボーグのカマキリよりも素早く動き、"},
{"id": 7, "speaker": 4, "form": "dlg", "jp": "「くらえっ！」"},
{"id": 8, "speaker": 4, "form": "dlg", "jp": "「バキッ！！」"},
{"id": 9, "speaker": 24, "form": "dlg", "jp": "「ウワッ！！」"},
{"id": 10, "speaker": 24, "form": "dlg", "jp": "カマキリを吹っ飛ばした。"},
{"id": 11, "speaker": 4, "form": "dlg", "jp": "「早く、頭に銃を！！」"},
{"id": 12, "speaker": 11, "form": "dlg", "jp": "「よし、わかった！！」"},
{"id": 13, "speaker": 11, "form": "dlg", "jp": "「さあ、捕まえたぞ！！」"},
{"id": 14, "speaker": 11, "form": "dlg", "jp": "「立つんだ‥‥」"},
{"id": 15, "speaker": 11, "form": "dlg", "jp": "「オイ、立てと言ってるのがわからんのか！」"},
{"id": 16, "speaker": 11, "form": "dlg", "jp": "「頭が吹っ飛ぶことになるぞっ！！」"},
{"id": 17, "speaker": 11, "form": "dlg", "jp": "「オイコラッ！」"},
{"id": 18, "speaker": 21, "form": "dlg", "jp": "「ミスターオオツキ！」"},
{"id": 19, "speaker": 11, "form": "dlg", "jp": "「うん？」"},
{"id": 20, "speaker": 21, "form": "dlg", "jp": "「このニオイ‥‥！！」"},
{"id": 21, "speaker": 21, "form": "dlg", "jp": "「奥歯に青酸性の毒を仕込んでたようね‥‥」"},
{"id": 22, "speaker": 11, "form": "dlg", "jp": "「カーーッ」"},
{"id": 23, "speaker": 11, "form": "dlg", "jp": "「また、自殺しやがったか‥‥」"},
{"id": 24, "speaker": 11, "form": "dlg", "jp": "「おっ、そうだ！」"},
{"id": 25, "speaker": 11, "form": "dlg", "jp": "「キミ、今日は逃がさんぞ！！」"},
{"id": 26, "speaker": 11, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 27, "speaker": 11, "form": "dlg", "jp": "「コラ、待てっ！！」"},
{"id": 28, "speaker": 3, "form": "dlg", "jp": "「待って！！」"},
{"id": 29, "speaker": 3, "form": "dlg", "jp": "「待って、『シロー』！！」"},
{"id": 30, "speaker": 4, "form": "dlg", "jp": "「‥‥‥！！」"},
{"id": 31, "speaker": 3, "form": "dlg", "jp": "「シローなんでしょう‥‥？」"},
{"id": 32, "speaker": 4, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「‥‥！？」"},
{"id": 34, "speaker": 3, "form": "dlg", "jp": "「やっぱり‥‥」"},
{"id": 35, "speaker": 5, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 36, "speaker": 21, "form": "dlg", "jp": "「早く捕まえるのよ！」"},
{"id": 37, "speaker": 20, "form": "dlg", "jp": "「ハッ！」"},
{"id": 38, "speaker": 20, "form": "dlg", "jp": "その時！"},
{"id": 39, "speaker": 20, "form": "dlg", "jp": "「ウィ～～～ン！」"},
{"id": 40, "speaker": 20, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 41, "speaker": 3, "form": "dlg", "jp": "「シロー！！」"},
{"id": 42, "speaker": 21, "form": "dlg", "jp": "「動きが止まったわ‥‥」"},
{"id": 43, "speaker": 21, "form": "dlg", "jp": "「さあ、今のうちに取り押さえて‥‥」"},
{"id": 44, "speaker": 3, "form": "dlg", "jp": "「シロォーー！！」"},
{"id": 45, "speaker": 3, "form": "dlg", "jp": "こうして、姉さんに『シロー』と呼ばれた青年は\n警察に身柄を確保され、"},
{"id": 46, "speaker": 3, "form": "dlg", "jp": "２人の殺し屋も死んだため、警察は\nまるで事件が解決したかのように喜んだ‥‥"},
{"id": 47, "speaker": 3, "form": "dlg", "jp": "しかし、実際は何も解決していなかった‥‥"},
{"id": 48, "speaker": 3, "form": "dlg", "jp": "そう、何１つも‥‥"},
{"id": 49, "speaker": 3, "form": "dlg", "jp": "ルードの殺し屋が死んだため、警察は\nまるで事件が解決したかのように喜んだ‥‥"},
{"id": 50, "speaker": 3, "form": "dlg", "jp": "しかし、実際は何も解決していなかった‥‥"},
{"id": 51, "speaker": 3, "form": "dlg", "jp": "そう、何１つも‥‥"}
]
