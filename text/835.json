[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／２８／ＡＭ０８：３０"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "　‥‥翌朝‥‥　"},
{"id": 2, "speaker": 29, "form": "dlg", "jp": "「じゃあアスカ、頼んだわよ！」"},
{"id": 3, "speaker": 35, "form": "dlg", "jp": "「ほんと、人使いが荒いんだから‥‥」"},
{"id": 4, "speaker": 35, "form": "dlg", "jp": "「では、いきますよ～～」"},
{"id": 5, "speaker": 35, "form": "dlg", "jp": "「シュン！」"},
{"id": 6, "speaker": 35, "form": "dlg", "jp": "ボクたちは、松尾さんの能力を使って\n大阪へ向かった。"},
{"id": 7, "speaker": 35, "form": "dlg", "jp": "「シュン！」"},
{"id": 8, "speaker": 35, "form": "dlg", "jp": "「とうちゃーーく！！」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "（わぁっ！）"},
{"id": 10, "speaker": 29, "form": "dlg", "jp": "「もう！　なんでこんな人目につくとこに！！」"},
{"id": 11, "speaker": 35, "form": "dlg", "jp": "「ここが一番イメージしやすかったんだよ‥‥」"},
{"id": 12, "speaker": 29, "form": "dlg", "jp": "「誰かに見られたらどうするつもり！」"},
{"id": 13, "speaker": 35, "form": "dlg", "jp": "「いいじゃん、見られなかったんだから‥‥」"},
{"id": 14, "speaker": 35, "form": "dlg", "jp": "「ハラ減った‥‥」"},
{"id": 15, "speaker": 35, "form": "dlg", "jp": "「タコヤキ食べない？」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「そんなことしてる場合じゃないでしょう！！」"},
{"id": 17, "speaker": 31, "form": "dlg", "jp": "「ナゴム、そいつはどこにいるんだ？」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「こんなトコロにいるわけないだろう？」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「とりあえず、大学に行けば‥‥」"},
{"id": 20, "speaker": 35, "form": "dlg", "jp": "「オレ、大学の場所しらないよ！」"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "「電車で行くわよ！」"},
{"id": 22, "speaker": 29, "form": "dlg", "jp": "ボクたちは清田さんの大学へと向かった"},
{"id": 23, "speaker": 29, "form": "dlg", "jp": "２００５／０８／２８／ＡＭ０９：３０"},
{"id": 24, "speaker": 31, "form": "dlg", "jp": "「で、ここのどこにいるんだ？」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「ここにいるかどうかは‥‥」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「もしかしたら、家の方かもしれないし‥‥」"},
{"id": 27, "speaker": 31, "form": "dlg", "jp": "「じゃぁ、\n　こんなとこに来てもしかたないじゃないか！」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「でも、家がどこかは知らないんだし‥‥」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「とりあえずここで\n　居場所を教えてもらえば‥‥」"},
{"id": 30, "speaker": 31, "form": "dlg", "jp": "「わかった、早く聞いてこいよ」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「うん、ちょっと待ってて‥‥」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "ボクは構内にいる人に\n清田さんの居場所を聞くことにした。"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「すみません、清田さんってどこにいるかわかりませんか？」"},
{"id": 34, "speaker": 6, "form": "dlg", "jp": "「ああ、あの人？」"},
{"id": 35, "speaker": 6, "form": "dlg", "jp": "「あの人なら、旧研究棟にこもってるよ！」"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "「『旧研究棟』？」"},
{"id": 37, "speaker": 6, "form": "dlg", "jp": "「ウラにあるボロボロの建物だよ！」"},
{"id": 38, "speaker": 6, "form": "dlg", "jp": "「いつもあそこにこもってるから、\n　行けばいるんじゃないかな？」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「ありがとうございます」"},
{"id": 40, "speaker": 31, "form": "dlg", "jp": "「わかったのか、居場所？」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「ああ、ウラの研究棟だって‥‥」"},
{"id": 42, "speaker": 29, "form": "dlg", "jp": "「行きましょう！」"},
{"id": 43, "speaker": 15, "form": "dlg", "jp": "「会ってくれるかな？」"},
{"id": 44, "speaker": 2, "form": "dlg", "jp": "「さあ、どうだろう？」"},
{"id": 45, "speaker": 16, "form": "dlg", "jp": "「なんかワクワクするね‥‥」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「長尾はポジティブだね‥‥」"},
{"id": 47, "speaker": 18, "form": "dlg", "jp": "「大丈夫かしら‥‥」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「大丈夫だよ‥‥」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "ボクたちは『旧研究棟』へ向かった。"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「ここのことだね」"},
{"id": 51, "speaker": 29, "form": "dlg", "jp": "「気持ち悪い場所ね‥‥」"},
{"id": 52, "speaker": 29, "form": "dlg", "jp": "「すんなり会ってくれるかしら‥‥」"},
{"id": 53, "speaker": 31, "form": "dlg", "jp": "「ムリだよ‥‥」"},
{"id": 54, "speaker": 31, "form": "dlg", "jp": "「どうせ、この前のヤツみたいに、\n　ロクなヤツじゃぁないんだから‥‥」"},
{"id": 55, "speaker": 31, "form": "dlg", "jp": "「‥‥‥！」"},
{"id": 56, "speaker": 29, "form": "dlg", "jp": "「どうしたの！？」"},
{"id": 57, "speaker": 31, "form": "dlg", "jp": "「テメエ、先制攻撃かコラ！」"},
{"id": 58, "speaker": 29, "form": "dlg", "jp": "「何言ってるの？」"},
{"id": 59, "speaker": 31, "form": "dlg", "jp": "「ウワァ！！」"},
{"id": 60, "speaker": 31, "form": "dlg", "jp": "「ちくしょう、ヤメロ！！」"},
{"id": 61, "speaker": 15, "form": "dlg", "jp": "「もしかして、例の怪物に襲われてるんじゃぁ？」"},
{"id": 62, "speaker": 16, "form": "dlg", "jp": "「もしかして、例の怪物に襲われてるとか？」"},
{"id": 63, "speaker": 18, "form": "dlg", "jp": "「もしかして、例の怪物に襲われてるのかも‥‥？」"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "「でも、あの怪物は夢にでてくるんじゃぁ？」"},
{"id": 65, "speaker": 31, "form": "dlg", "jp": "「うわあああああああ！」"},
{"id": 66, "speaker": 31, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "「ケネス！！」"},
{"id": 68, "speaker": 35, "form": "dlg", "jp": "「死んじゃったの？」"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "「大丈夫‥‥」"},
{"id": 70, "speaker": 29, "form": "dlg", "jp": "「まだ、息はあるわ！」"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "「多分、気絶したみたい‥‥」"},
{"id": 72, "speaker": 35, "form": "dlg", "jp": "「ショック死よりましだよね‥‥」"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「何のんきなこと言ってるの！！」"},
{"id": 74, "speaker": 29, "form": "dlg", "jp": "「油断しちゃダメよ！」"},
{"id": 75, "speaker": 35, "form": "dlg", "jp": "「わかった！」"},
{"id": 76, "speaker": 35, "form": "dlg", "jp": "「襲われたら、ショック死しないように\n　すぐに気絶するよ！」"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "「バカッ！」"},
{"id": 78, "speaker": 35, "form": "dlg", "jp": "「うわぁぁ！」"},
{"id": 79, "speaker": 35, "form": "dlg", "jp": "「うわぁぁぁぁぁぁぁぁ！」"},
{"id": 80, "speaker": 35, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 81, "speaker": 15, "form": "dlg", "jp": "「ヤダ、\n　本当に気絶しちゃったみたい‥‥」"},
{"id": 82, "speaker": 16, "form": "dlg", "jp": "「あらら、\n　本当に気絶しちゃったみたい‥‥」"},
{"id": 83, "speaker": 18, "form": "dlg", "jp": "「本当に‥‥」"},
{"id": 84, "speaker": 18, "form": "dlg", "jp": "「気絶しちゃった‥‥」"},
{"id": 85, "speaker": 29, "form": "dlg", "jp": "「こんなところで攻撃してきたってことは‥‥」"},
{"id": 86, "speaker": 29, "form": "dlg", "jp": "「私たちの探している怪物は、\n　その『清田』っていう人で間違いなさそうね‥‥」"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "「本当に攻撃されたのか？」"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "「それ以外、考えられないわね‥‥」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「何のために‥‥」"},
{"id": 90, "speaker": 15, "form": "dlg", "jp": "「やっぱり、先制攻撃なんじゃぁ？」"},
{"id": 91, "speaker": 16, "form": "dlg", "jp": "「やっぱり、先制攻撃じゃないの？」"},
{"id": 92, "speaker": 18, "form": "dlg", "jp": "「やっぱり、先制攻撃？」"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "「先制攻撃ってことは、\n　ボクたちが来ることを知ってたってことだぜ？」"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "「知ってたんでしょうね‥‥」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「なんで‥‥？」"},
{"id": 96, "speaker": 15, "form": "dlg", "jp": "「‥‥‥！？」"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 98, "speaker": 15, "form": "dlg", "jp": "「もしかして、"},
{"id": 99, "speaker": 15, "form": "dlg", "jp": "その人の能力って\n"},
{"id": 100, "speaker": 15, "form": "dlg", "jp": "　夢を見せる能力じゃぁないんじゃ‥‥」"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "「じゃあ、どんな能力なの？」"},
{"id": 102, "speaker": 15, "form": "dlg", "jp": "「例えば、\n"},
{"id": 103, "speaker": 15, "form": "dlg", "jp": "　他人の脳に自由に出入りできる能力とか‥‥」"},
{"id": 104, "speaker": 16, "form": "dlg", "jp": "「‥‥‥！？」"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 106, "speaker": 16, "form": "dlg", "jp": "「もしかして、"},
{"id": 107, "speaker": 16, "form": "dlg", "jp": "その人の能力って\n"},
{"id": 108, "speaker": 16, "form": "dlg", "jp": "　夢を見せる能力じゃぁないんじゃない‥‥？」"},
{"id": 109, "speaker": 29, "form": "dlg", "jp": "「じゃあ、どんな能力なの？」"},
{"id": 110, "speaker": 16, "form": "dlg", "jp": "「例えば、\n"},
{"id": 111, "speaker": 16, "form": "dlg", "jp": "　他人の脳に自由に出入りできる能力とか‥‥」"},
{"id": 112, "speaker": 18, "form": "dlg", "jp": "「‥‥‥！？」"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 114, "speaker": 18, "form": "dlg", "jp": "「もしかして、"},
{"id": 115, "speaker": 18, "form": "dlg", "jp": "その人の能力って\n"},
{"id": 116, "speaker": 18, "form": "dlg", "jp": "　夢を見せる能力じゃぁないのかも‥‥」"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "「じゃあ、どんな能力なの？」"},
{"id": 118, "speaker": 18, "form": "dlg", "jp": "「例えば、\n"},
{"id": 119, "speaker": 18, "form": "dlg", "jp": "　他人の脳に自由に出入りできる能力とか‥‥」"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "「なるほど！！」"},
{"id": 121, "speaker": 29, "form": "dlg", "jp": "「つまり、こういうことね‥‥」"},
{"id": 122, "speaker": 29, "form": "dlg", "jp": "「アイツは、"},
{"id": 123, "speaker": 29, "form": "dlg", "jp": "自分の『意識』を"},
{"id": 124, "speaker": 29, "form": "dlg", "jp": "他人の脳の中に\n"},
{"id": 125, "speaker": 29, "form": "dlg", "jp": "　自由に送り込むことができる」"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "「送りこんだ『意識』で\n"},
{"id": 127, "speaker": 29, "form": "dlg", "jp": "　他人の脳の中を覗いたり」"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "「他人に幻覚を見せたりすることが\n　できるってことね‥‥」"},
{"id": 129, "speaker": 29, "form": "dlg", "jp": "「ソイツはナゴムの脳の中に入ってきて、\n　三田さんの情報を手に入れた」"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "「その時に、私たちの情報もってことね‥‥」"},
{"id": 131, "speaker": 15, "form": "dlg", "jp": "「こんな短時間で２人が倒されちゃったってことは」"},
{"id": 132, "speaker": 15, "form": "dlg", "jp": "「話し合うつもりはないんじゃないかしら？」"},
{"id": 133, "speaker": 16, "form": "dlg", "jp": "「こんな短時間で２人が倒されちゃったってことは」"},
{"id": 134, "speaker": 16, "form": "dlg", "jp": "「話し合うつもりはないんじゃないかしら？」"},
{"id": 135, "speaker": 18, "form": "dlg", "jp": "「こんな短時間で２人が倒されちゃったってことは」"},
{"id": 136, "speaker": 18, "form": "dlg", "jp": "「話し合うつもりはないんじゃないかしら？」"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "「そうかしら？」"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "「こんな短時間で２人も倒せるのに、\n"},
{"id": 139, "speaker": 29, "form": "dlg", "jp": "　私たち"},
{"id": 140, "speaker": 29, "form": "dlg", "jp": "『女子供』に攻撃してこない"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "ってことは」"},
{"id": 142, "speaker": 29, "form": "dlg", "jp": "「なにか考えがあるんじゃない？」"},
{"id": 143, "speaker": 4, "form": "dlg", "jp": "「その通り！！」"},
{"id": 144, "speaker": 4, "form": "dlg", "jp": "「正体も見抜くとはおどろきだな‥‥」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「オ、オマエ！？」"},
{"id": 146, "speaker": 29, "form": "dlg", "jp": "「どうしたの？」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「みんな見えないのか？」"},
{"id": 148, "speaker": 29, "form": "dlg", "jp": "「もしかしてっ！？」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「今、目の前にいる！」"},
{"id": 151, "speaker": 29, "form": "dlg", "jp": "「そいつは今、"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "ナゴムの脳の中に入りこみ\n"},
{"id": 153, "speaker": 29, "form": "dlg", "jp": "　直接イメージを見せているだけだから」"},
{"id": 154, "speaker": 29, "form": "dlg", "jp": "「私たちには見えないし、手助けもできないわよ」"},
{"id": 155, "speaker": 29, "form": "dlg", "jp": "「気をつけて！！」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「大丈夫だよ、\n　攻撃してくる気配はないみたい‥‥」"},
{"id": 157, "speaker": 4, "form": "dlg", "jp": "「まず、結論から先に言おう‥‥」"},
{"id": 158, "speaker": 4, "form": "dlg", "jp": "「オレはオマエらに協力するつもりはない！」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "「なんだって！」"},
{"id": 160, "speaker": 29, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「ボクたちには協力しないって‥‥」"},
{"id": 162, "speaker": 4, "form": "dlg", "jp": "「その代わり、\n　オマエたちに危害を加えるつもりもない‥‥」"},
{"id": 163, "speaker": 4, "form": "dlg", "jp": "「悪いが、今オレは世紀の大実験中なんだ‥‥」"},
{"id": 164, "speaker": 4, "form": "dlg", "jp": "「ジャマさえしなければ、\n　オマエらを殺さずに帰してやる」"},
{"id": 165, "speaker": 4, "form": "dlg", "jp": "「もし、ジャマをするようなら‥‥」"},
{"id": 166, "speaker": 4, "form": "dlg", "jp": "「気絶どころでは済まさない！！」"},
{"id": 167, "speaker": 4, "form": "dlg", "jp": "「そこで気絶している２人を連れて\n　おとなしく帰るんだな‥‥」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「おとなしくカエレだって‥‥」"},
{"id": 169, "speaker": 4, "form": "dlg", "jp": "「オレの能力はオレ以外のためには使わない！」"},
{"id": 170, "speaker": 4, "form": "dlg", "jp": "「とにかく、オレの研究のジャマをするな！」"},
{"id": 171, "speaker": 4, "form": "dlg", "jp": "「もし、この建物に一歩でも踏み入れたら‥‥」"},
{"id": 172, "speaker": 4, "form": "dlg", "jp": "「『宣戦布告』とみなし、\n　オマエたちを皆殺しにする！！」"},
{"id": 173, "speaker": 4, "form": "dlg", "jp": "「とにかく、良く考えるんだな‥‥」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「この建物に入ると皆殺しにするって‥‥」"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "「どうする？」"},
{"id": 176, "speaker": 29, "form": "dlg", "jp": "「どうするって言っても‥‥」"},
{"id": 177, "speaker": 29, "form": "choice", "jp": "「ここは一旦逃げた方が‥‥」"},
{"id": 178, "speaker": 29, "form": "choice", "jp": "「仕方ない、中に入ろう！」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「ここは一旦逃げた方が‥‥」"},
{"id": 180, "speaker": 29, "form": "dlg", "jp": "「この２人はどうするのよ！」"},
{"id": 181, "speaker": 29, "form": "dlg", "jp": "「こうなったら仕方ないわ！」"},
{"id": 182, "speaker": 29, "form": "dlg", "jp": "「３人だけで行きましょう！」"},
{"id": 183, "speaker": 29, "form": "dlg", "jp": "「ついて来て！」"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「仕方ない、中に入ろう！」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "「２人は後ろをついて来て！」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "ボクたちは３人だけで中に入ることになった。"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「ギーー！」"}
]
