{"id": 317, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 318, "speaker": 2, "form": "dlg", "jp": "さっ、プールへ行くか‥‥"},
{"id": 319, "speaker": 2, "form": "dlg", "jp": "さすがにプールには\n『ルード』の連中も現れないだろう‥‥"},
{"id": 320, "speaker": 4, "form": "dlg", "jp": "「アラ、常光寺くん！！」"},
{"id": 321, "speaker": 4, "form": "dlg", "jp": "この声は？"},
{"id": 322, "speaker": 18, "form": "dlg", "jp": "「なんでこんなところに？」"},
{"id": 323, "speaker": 2, "form": "dlg", "jp": "「堤さん！！」"},
{"id": 324, "speaker": 18, "form": "dlg", "jp": "「おウチの方が大変なことになってたんじゃぁ？」"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "「ああ、それでウチにいるより\n　ココにいた方が安全だろうって‥‥」"},
{"id": 326, "speaker": 18, "form": "dlg", "jp": "「そうだったの？」"},
{"id": 327, "speaker": 2, "form": "dlg", "jp": "「でも、さずが堤さんだね‥‥」"},
{"id": 328, "speaker": 2, "form": "dlg", "jp": "「夏休みをこんな高級ホテルのプールで\n　過ごしてるなんて‥‥」"},
{"id": 329, "speaker": 18, "form": "dlg", "jp": "「それってどういうコト？」"},
{"id": 330, "speaker": 2, "form": "dlg", "jp": "「お嬢様なんだなぁって‥‥」"},
{"id": 331, "speaker": 18, "form": "dlg", "jp": "「私、『お嬢様』じゃないわよ？」"},
{"id": 332, "speaker": 18, "form": "dlg", "jp": "「ここにいるのは、親戚から無料券をもらったから‥‥」"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "「そうなの？」"},
{"id": 334, "speaker": 18, "form": "dlg", "jp": "「そうよ‥‥」"},
{"id": 335, "speaker": 18, "form": "dlg", "jp": "さすがにプールには\n『ルード』の連中も現れないだろう‥‥"},
{"id": 336, "speaker": 4, "form": "dlg", "jp": "「オイッ、常光寺！！」"},
{"id": 337, "speaker": 2, "form": "dlg", "jp": "（この声は？）"},
{"id": 338, "speaker": 17, "form": "dlg", "jp": "「なんでオマエがこんなところにいるんだ？」"},
{"id": 339, "speaker": 2, "form": "dlg", "jp": "「先生！！」"},
{"id": 340, "speaker": 2, "form": "dlg", "jp": "「先生こそっ！」"},
{"id": 341, "speaker": 17, "form": "dlg", "jp": "「オレはアレだよ‥‥\n　ココのホテルの『ジムの会員』だから‥‥」"},
{"id": 342, "speaker": 2, "form": "dlg", "jp": "「『ジムの会員』がどうして『プール』に‥‥」"},
{"id": 343, "speaker": 17, "form": "dlg", "jp": "「『プール』も使えるんだよなぁ」"},
{"id": 344, "speaker": 2, "form": "dlg", "jp": "「それにどうして『ジャージ』なんですか？」"},
{"id": 345, "speaker": 17, "form": "dlg", "jp": "「それはアレだよ‥‥」"},
{"id": 346, "speaker": 17, "form": "dlg", "jp": "「今日は『見学』だから‥‥」"},
{"id": 347, "speaker": 2, "form": "dlg", "jp": "「それにココの入会料って高いんじゃぁ？」"},
{"id": 348, "speaker": 17, "form": "dlg", "jp": "「オレは『ジムの会員』だからな‥‥」"},
{"id": 349, "speaker": 17, "form": "dlg", "jp": "「『ジム』っていうのは『量産型』だから\n　『安い』んだよ‥‥」"},
{"id": 350, "speaker": 2, "form": "dlg", "jp": "（イミがわからないよ！）"},
{"id": 351, "speaker": 2, "form": "dlg", "jp": "そう言えば、警部さんたち、\n『ロビー』にいるって言ってたな‥‥"},
{"id": 352, "speaker": 2, "form": "dlg", "jp": "ちょっと顔を出してみるか‥‥"},
{"id": 353, "speaker": 2, "form": "dlg", "jp": "いったん部屋に戻るとするか‥‥"}
]
