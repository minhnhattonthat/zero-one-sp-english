{"id": 77, "speaker": 2, "form": "dlg", "jp": "「こないだ逃げた連中は？」"},
{"id": 78, "speaker": 11, "form": "dlg", "jp": "「もっか、捜索中だよ」"},
{"id": 79, "speaker": 21, "form": "dlg", "jp": "「近日中に逮捕されるでしょうね‥‥」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「父さんの居場所はわかりましたか？」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「父さんの居場所はわかりましたか？」"},
{"id": 83, "speaker": 11, "form": "dlg", "jp": "「うむう‥‥」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「まだ、わからないんですね？」"},
{"id": 85, "speaker": 21, "form": "dlg", "jp": "「重要機密だから、家族にも話せないわ‥‥」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 87, "speaker": 21, "form": "dlg", "jp": "「そんなコトより、キミは\n　ドクタージョウコウジの情報は持ってないの？」"},
{"id": 88, "speaker": 11, "form": "dlg", "jp": "「ささいなことでいいんだけど‥‥」"},
{"id": 89, "speaker": 21, "form": "dlg", "jp": "「仲が良かった人とか、よく行く場所とか‥‥」"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "（そういうのは、ほとんど知らないんだよな‥‥）"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "（親を取り巻いてる世界のことなんて\n　まったくキョウミがなかったから‥‥）"},
{"id": 92, "speaker": 2, "form": "choice", "jp": "【よく行く場所‥‥】"},
{"id": 93, "speaker": 2, "form": "choice", "jp": "【仲が良かった人‥‥】"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "【仲が良かった人‥‥】"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "（父さんの仕事関係の人には何人か会ったことあるけど\n　本当に仲がいいのかどうか‥‥）"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "（父さんがウチに連れてくる人で\n　本当に信頼してるのは『三田さん』ぐらいか‥‥）"},
{"id": 97, "speaker": 2, "form": "choice", "jp": "「よく、わかりません」"},
{"id": 98, "speaker": 2, "form": "choice", "jp": "「『母さん』とは仲がよかったと‥‥」"},
{"id": 99, "speaker": 2, "form": "choice", "jp": "「『三田さん』のことは信頼してたみたいです」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "「よく、わかりません」"},
{"id": 101, "speaker": 21, "form": "dlg", "jp": "「ちゃんと、考えて‥‥」"},
{"id": 102, "speaker": 21, "form": "choice", "jp": "「『母さん』とは仲がよかったと‥‥」"},
{"id": 103, "speaker": 21, "form": "choice", "jp": "「『三田さん』のことは信頼してたみたいです」"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "「『母さん』とは仲がよかったと‥‥」"},
{"id": 105, "speaker": 21, "form": "dlg", "jp": "「ステキね‥‥」"},
{"id": 106, "speaker": 21, "form": "dlg", "jp": "「でもそんな情報は今はいらないの‥‥」"},
{"id": 107, "speaker": 21, "form": "dlg", "jp": "「ほかには？」"},
{"id": 108, "speaker": 21, "form": "choice", "jp": "「よく、わかりません」"},
{"id": 109, "speaker": 21, "form": "choice", "jp": "「『三田さん』のことは信頼してたみたいです」"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「『三田さん』のことは信頼してたみたいです」"},
{"id": 111, "speaker": 21, "form": "dlg", "jp": "「『三田』って『助手』の？」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 113, "speaker": 21, "form": "dlg", "jp": "「その『三田』って『助手』も行方不明なの‥‥」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「そうなんですか‥‥」"},
{"id": 115, "speaker": 21, "form": "dlg", "jp": "「じゃあ、ドクタージョウコウジが\n　よく行く場所とかは？」"},
