{"id": 188, "speaker": 2, "form": "dlg", "jp": "（両親の仕事の都合とかで、\n　こんな中途半端な時期に転校して来たらしい‥‥）"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "（とにかく、\n　いろんな意味で目立つ存在の生徒だ‥‥）"},
{"id": 190, "speaker": 50, "form": "dlg", "jp": "「おウチの方が大変なことになってたんじゃぁ？」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「なんでそんなこと知ってるんだ？」"},
{"id": 192, "speaker": 50, "form": "dlg", "jp": "「小さな町だからね‥‥」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "「まあ、ウチにいるより\n　ココにいた方が安全だろうって‥‥」"},
{"id": 195, "speaker": 2, "form": "dlg", "jp": "「で、キミはなんでこんな所に‥‥」"},
{"id": 196, "speaker": 50, "form": "dlg", "jp": "「住んでるんだよ‥‥」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「住んでる？」"},
{"id": 198, "speaker": 50, "form": "dlg", "jp": "「父の仕事でコッチに来たんだけど\n　まだ、住む家がきまってないんだよ‥‥」"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "「ホテル住まいなんだ‥‥スゴイね‥‥」"},
{"id": 200, "speaker": 50, "form": "dlg", "jp": "「常光寺くんは何号室？」"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "「何号室だったっけ？」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「警察が用意してくれた部屋だから‥‥」"},
{"id": 203, "speaker": 50, "form": "dlg", "jp": "「ボクは７５６号にいるから、あとで電話してよ‥‥」"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 205, "speaker": 50, "form": "dlg", "jp": "「じゃぁね‥‥」"},
{"id": 206, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "アイツ、こんな立派なホテルに住んでるんだ‥‥"},
{"id": 208, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "さっ、ジムへ行くか‥‥"},
{"id": 210, "speaker": 21, "form": "dlg", "jp": "「イメージとちがう行動をとるのね‥‥」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「警視！？」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "「『イメージとちがう』って？」"},
{"id": 213, "speaker": 21, "form": "dlg", "jp": "「ゴメンね、キミのかよわなフンイキから\n　スポーツが想像できなかったの‥‥」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "「失礼ですね‥‥」"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "「『健全な肉体に健全な精神が宿る』\n　っていうじゃないですか！」"},
{"id": 216, "speaker": 21, "form": "dlg", "jp": "「言わないわよ」"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "「えっ！？」"},
{"id": 218, "speaker": 21, "form": "dlg", "jp": "「正しくは\n　『健全な肉体に健全な精神が宿れかし』‥‥」"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "「『宿れかし』って？」"},
{"id": 220, "speaker": 21, "form": "dlg", "jp": "「ローマの詩人の言葉で」"},
{"id": 221, "speaker": 21, "form": "dlg", "jp": "「『健全な肉体』も『健全な精神』が\n　宿るように願うって言葉‥‥」"},
{"id": 222, "speaker": 21, "form": "dlg", "jp": "「つまり、『健全な肉体』には『健全な精神』が\n　宿らないことをなげいた言葉よ‥‥」"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "「ウソ！？」"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "（ボクは今までだまされていたのか！！）"},
{"id": 225, "speaker": 21, "form": "dlg", "jp": "「ザンネンながら‥‥」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「体をこわさない程度にがんばります‥‥」"},
{"id": 228, "speaker": 21, "form": "dlg", "jp": "「そうね‥‥\n　それが一番ね‥‥」"},
{"id": 229, "speaker": 21, "form": "dlg", "jp": "「じゃあ、私はこれで‥‥」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「えっ、もう行っちゃうんですか？」"},
{"id": 231, "speaker": 21, "form": "dlg", "jp": "「ええ、オオツキと今後の対策をね‥‥」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "（なんか気になるな‥‥）"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "「あの‥‥」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「ボクも行っちゃあマズイですか‥‥」"},
{"id": 235, "speaker": 21, "form": "dlg", "jp": "「かまわないわよ‥‥」"},
{"id": 236, "speaker": 21, "form": "dlg", "jp": "「キミからも聞きたいこともあるし‥‥」"},
{"id": 237, "speaker": 21, "form": "dlg", "jp": "ボクは警視といっしょにロビーに行くことにした。"},
{"id": 238, "speaker": 11, "form": "dlg", "jp": "「うん、どうかしたのかい？」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「いいえ、ちょっと‥‥」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "さすがにジムには\n『ルード』の連中も現れないだろう‥‥"},
{"id": 241, "speaker": 11, "form": "dlg", "jp": "「安心したまえ！」"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "「警部！？」"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「おどかさないでくださいよ！」"},
{"id": 244, "speaker": 11, "form": "dlg", "jp": "「別におどかすつもりは‥‥」"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "「で、こんな所で何してるんですか？」"},
{"id": 246, "speaker": 11, "form": "dlg", "jp": "「キミの警護じゃないか‥‥」"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "「ゴクロウさまです‥‥」"},
{"id": 248, "speaker": 11, "form": "dlg", "jp": "「気にしなくていいよ‥‥」"},
{"id": 249, "speaker": 11, "form": "dlg", "jp": "「それに若いうちは体は\n　きたえられるだけきたえた方がいいからな！」"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "「そうなんですか？」"},
{"id": 251, "speaker": 11, "form": "dlg", "jp": "「えっ！？」"},
{"id": 252, "speaker": 11, "form": "dlg", "jp": "「まあ、コンキョはないが、\n　何事もやらないよりやった方がいいだろう？」"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "「何をやるかによると思うんですが‥‥」"},
{"id": 254, "speaker": 2, "form": "dlg", "jp": "「とにかく、\n　体をこわさない程度にがんばります‥‥」"},
{"id": 255, "speaker": 11, "form": "dlg", "jp": "「ウン、それが一番だな‥‥」"},
{"id": 256, "speaker": 11, "form": "dlg", "jp": "「じゃあ、オレはコレで‥‥」"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "「どこへ行くんですか？」"},
{"id": 258, "speaker": 11, "form": "dlg", "jp": "「ああ、警視と今後の相談をね‥‥」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "（なんか気になるな‥‥）"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "「あの‥‥」"},
{"id": 261, "speaker": 2, "form": "dlg", "jp": "「ボクも行っちゃあマズイですか‥‥」"},
{"id": 262, "speaker": 11, "form": "dlg", "jp": "「ああ、かまわないよ‥‥」"},
{"id": 263, "speaker": 11, "form": "dlg", "jp": "「ナゴムくんからも聞きたいこともあるし‥‥」"},
{"id": 264, "speaker": 11, "form": "dlg", "jp": "ボクは警部といっしょにロビーに行くことにした。"},
{"id": 265, "speaker": 21, "form": "dlg", "jp": "「アラ、どうかしたの？」"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "「いいえ、ちょっと‥‥」"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "（たしか、ジムがあるって言ってたな‥‥）"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "ボクはジムに行ってみることにした。"},
{"id": 269, "speaker": 2, "form": "dlg", "jp": "とりあえず、\n出かける前に隣の刑事さんに伝えておこう。"},
{"id": 270, "speaker": 2, "form": "dlg", "jp": "「コン！コン！」"},
{"id": 271, "speaker": 2, "form": "dlg", "jp": "「すみません‥‥」"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 273, "speaker": 20, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 274, "speaker": 2, "form": "dlg", "jp": "「ちょっと、ジムに行ってもいいですか？」"},
{"id": 275, "speaker": 20, "form": "dlg", "jp": "「わかった、そっちの警備のモノに伝えておくよ‥‥」"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "「ありがとうございます」"},
{"id": 277, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "（夏はやっぱプールでしょう！！）"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "ボクはプールに行ってみることにした。"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "とりあえず、\n出かける前に隣の刑事さんに伝えておこう。"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "「コン！コン！」"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "「すみません‥‥」"},
{"id": 284, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 285, "speaker": 20, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "「ちょっと、プールに行ってもいいですか？」"},
{"id": 287, "speaker": 20, "form": "dlg", "jp": "「わかった、そっちの警備のモノに伝えておくよ‥‥」"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「ありがとうございます」"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 291, "speaker": 4, "form": "dlg", "jp": "「常光寺くん！！」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "（この声は？）"},
{"id": 293, "speaker": 50, "form": "dlg", "jp": "「なんでこんなところに？」"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "「出口！！」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "（『出口エイジ』‥‥）"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "（今月になって隣のクラスにやってきた『転校生』だ。）"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "（両親の仕事の都合とかで、\n　こんな中途半端な時期に転校して来たらしい‥‥）"},
