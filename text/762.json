[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０７／２２／ＰＭ０１：０４"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "せっかくの夏休みなのにこんなところに\n閉じ込められてしまうとは‥‥"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "まあ、考えようによってはタダで\nリゾート気分を味わわせてもらってるんだけど‥‥"},
{"id": 3, "speaker": null, "form": "dlg", "jp": "さてと‥‥"},
{"id": 4, "speaker": null, "form": "dlg", "jp": "ちょっとホテルを探検するか‥‥"},
{"id": 5, "speaker": null, "form": "dlg", "jp": "こんなに立派なホテル、\nめったに泊まれないからな‥‥"},
{"id": 6, "speaker": null, "form": "dlg", "jp": "さて、どこに行ってみよう？"},
{"id": 7, "speaker": null, "form": "choice", "jp": "（たしか、ジムがあるって言ってたな‥‥）"},
{"id": 8, "speaker": null, "form": "choice", "jp": "（ロビーでくつろぐってのもいいかも‥‥）"},
{"id": 9, "speaker": null, "form": "choice", "jp": "（夏はやっぱプールでしょう！！）"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "（ロビーでくつろぐってのもいいかも‥‥）"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "（たしか、警部さんたちもいるだろうし、\n　父さんの情報が手に入れられるかも‥‥）"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "ボクはロビーに行ってみることにした。"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "とりあえず、\n出かける前に隣の刑事さんに伝えておこう。"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「コン！コン！」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「すみません‥‥」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 17, "speaker": 20, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「ちょっと、ロビーに行ってきます」"},
{"id": 19, "speaker": 20, "form": "dlg", "jp": "「わかった、そっちの警備のモノに伝えておくよ‥‥」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「ありがとうございます」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 23, "speaker": 4, "form": "dlg", "jp": "「常光寺くん！！」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "（この声は？）"},
{"id": 25, "speaker": 50, "form": "dlg", "jp": "「なんでこんなところに？」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「出口！！」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "（『出口エイジ』‥‥）"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "（今月になって隣のクラスにやってきた『転校生』だ。）"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "（両親の仕事の都合とかで、\n　こんな中途半端な時期に転校して来たらしい‥‥）"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "（とにかく、\n　いろんな意味で目立つ存在の生徒だ‥‥）"},
{"id": 31, "speaker": 50, "form": "dlg", "jp": "「おウチの方が大変なことになってたんじゃぁ？」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "「なんでそんなこと知ってるんだ？」"},
{"id": 33, "speaker": 50, "form": "dlg", "jp": "「小さな町だからね‥‥」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "「まあ、ウチにいるより\n　ココにいた方が安全だろうって‥‥」"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "「で、キミはなんでこんな所に‥‥」"},
{"id": 37, "speaker": 50, "form": "dlg", "jp": "「住んでるんだよ‥‥」"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "「住んでる？」"},
{"id": 39, "speaker": 50, "form": "dlg", "jp": "「父の仕事でコッチに来たんだけど\n　まだ、住む家がきまってないんだよ‥‥」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「ホテル住まいなんだ‥‥スゴイね‥‥」"},
{"id": 41, "speaker": 50, "form": "dlg", "jp": "「常光寺くんは何号室？」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "「何号室だったっけ？」"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「警察が用意してくれた部屋だから‥‥」"},
{"id": 44, "speaker": 50, "form": "dlg", "jp": "「ボクは７５６号にいるから、あとで電話してよ‥‥」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 46, "speaker": 50, "form": "dlg", "jp": "「じゃぁね‥‥」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "ロビーではブラバスキー警視と、大槻警部が\nなにやら話をしていた。"},
{"id": 49, "speaker": 2, "form": "choice", "jp": "【大槻警部に話しかける】"},
{"id": 50, "speaker": 2, "form": "choice", "jp": "【ブラバスキー警視に話しかける】"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "【大槻警部に話しかける】"},
{"id": 52, "speaker": 11, "form": "dlg", "jp": "「やっぱりタイクツかい？」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「いえ、そういうわけでは‥‥」"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "「ただ、せっかくなんで\n　いろいろ見てまわろうかと‥‥」"},
{"id": 55, "speaker": 11, "form": "dlg", "jp": "「大丈夫だと思うけど、\n　あんまり人気のないところにはいかないように」"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "せっかくだから、ちょっと話を聞いてみるか‥‥"},
{"id": 58, "speaker": 2, "form": "choice", "jp": "「父さんの居場所はわかりましたか？」"},
{"id": 59, "speaker": 2, "form": "choice", "jp": "「こないだ逃げた連中は？」"},
{"id": 60, "speaker": 2, "form": "choice", "jp": "「本当にココは安全なんでしょうか？」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "【ブラバスキー警視に話しかける】"},
{"id": 62, "speaker": 21, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「いえ、別に‥‥」"},
{"id": 64, "speaker": 21, "form": "dlg", "jp": "「キケンだからムヤミにウロウロしないでね‥‥」"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "せっかくだから、ちょっと話を聞いてみるか‥‥"},
{"id": 67, "speaker": 2, "form": "choice", "jp": "「父さんの居場所はわかりましたか？」"},
