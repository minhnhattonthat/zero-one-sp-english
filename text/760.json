{"id": 151, "speaker": 4, "form": "dlg", "jp": "「で、こちらが‥‥」"},
{"id": 152, "speaker": 11, "form": "dlg", "jp": "「ハイ！」"},
{"id": 153, "speaker": 11, "form": "dlg", "jp": "「『常光寺リツコ』さんと『ナゴム』くんであります」"},
{"id": 154, "speaker": 4, "form": "dlg", "jp": "「はじめまして‥‥」"},
{"id": 155, "speaker": 4, "form": "dlg", "jp": "「『インターポール』の\n　"},
{"id": 156, "speaker": 4, "form": "dlg", "jp": "『ケイト・ブラバスキー』"},
{"id": 157, "speaker": 4, "form": "dlg", "jp": "よ‥‥」"},
{"id": 158, "speaker": 3, "form": "dlg", "jp": "「ブラバスキーさん‥‥」"},
{"id": 159, "speaker": 21, "form": "dlg", "jp": "「『ケイト』でいいわ‥‥」"},
