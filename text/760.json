{"id": 142, "speaker": 21, "form": "dlg", "jp": "「ナゴムくん！！」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「ハ、ハイッ！」"},
{"id": 144, "speaker": 21, "form": "dlg", "jp": "「昨日は大カツヤクだったみたいね‥‥」"},
{"id": 145, "speaker": 21, "form": "dlg", "jp": "「でも、もうムチャをしないで\n　命を失うことになるわよ！」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 147, "speaker": 4, "form": "dlg", "jp": "「遅かったわね、\n　ミスターオオツキ‥‥」"},
{"id": 148, "speaker": 11, "form": "dlg", "jp": "「すみません、『ブラバスキー警視』‥‥」"},
