{"id": 113, "speaker": 11, "form": "dlg", "jp": "やはり、世界的な犯罪組織だけあって、\n警察もかなり困惑しているようだった。"},
{"id": 114, "speaker": 11, "form": "dlg", "jp": "２００５／０７／２２／ＡＭ１０：５６"},
{"id": 115, "speaker": 11, "form": "dlg", "jp": "「さあ、着きました‥‥」"},
{"id": 116, "speaker": 3, "form": "dlg", "jp": "「まあ、こんな立派なとこに‥‥？」"},
{"id": 117, "speaker": 11, "form": "dlg", "jp": "「普段は要人を迎える時に使うホテルです‥‥」"},
{"id": 118, "speaker": 3, "form": "dlg", "jp": "「そんなにしてもらわなくても‥‥」"},
{"id": 119, "speaker": 11, "form": "dlg", "jp": "「いや、\n　本件は『インターポール』もかんでいるんで‥‥」"},
{"id": 120, "speaker": 11, "form": "dlg", "jp": "「まあ、日本警察の意地みたいなもんですよ‥‥」"},
{"id": 121, "speaker": 11, "form": "dlg", "jp": "「さあ、中へ‥‥」"},
{"id": 122, "speaker": 21, "form": "dlg", "jp": "「遅かったわね、\n　ミスターオオツキ‥‥」"},
{"id": 123, "speaker": 11, "form": "dlg", "jp": "「すみません、『ブラバスキー警視』‥‥」"},
{"id": 124, "speaker": 21, "form": "dlg", "jp": "「これだから、日本のオヤクショは‥‥」"},
{"id": 125, "speaker": 11, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 126, "speaker": 3, "form": "dlg", "jp": "「オハヨウゴザイマス‥‥」"},
{"id": 127, "speaker": 21, "form": "dlg", "jp": "「オハヨウ‥‥」"},
{"id": 128, "speaker": 21, "form": "dlg", "jp": "「どう、あんまり眠れなかったでしょう？」"},
{"id": 129, "speaker": 3, "form": "dlg", "jp": "「は、はい‥‥」"},
{"id": 130, "speaker": 21, "form": "dlg", "jp": "「今日は大丈夫よ‥‥」"},
{"id": 131, "speaker": 21, "form": "dlg", "jp": "「ちゃんと、私たち『インターポール』も\n　警備につきあうから‥‥」"},
{"id": 132, "speaker": 21, "form": "dlg", "jp": "「遅かったわね、\n　ミスターオオツキ‥‥」"},
{"id": 133, "speaker": 11, "form": "dlg", "jp": "「すみません、『ブラバスキー警視』‥‥」"},
