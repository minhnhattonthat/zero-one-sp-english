[
{"id": 0, "speaker": null, "form": "dlg", "jp": "あの『ゴート』というサイボーグの出現によって、"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "父さんの失В（しっそう）に\n『ルード』が関係していることが決定的になり、"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "ボクたちは警察によって、\nより厳重（げんじゅう）に警備されることになった。"},
{"id": 3, "speaker": null, "form": "dlg", "jp": "２００５／０７／２２／ＡＭ１０：００"},
{"id": 4, "speaker": null, "form": "dlg", "jp": "「コン！コン！」"},
{"id": 5, "speaker": 3, "form": "dlg", "jp": "「早くしなさい\n　警部さんたち待ってるわよ！」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「うん、わかった！」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "ボクたちは今日から、警察の用意したホテルで\n厳重な警備の中で生活することになった。"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「今、行くよ！」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "「痛っ！」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "昨日、アイツを蹴った時に足を傷めたようだ。"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 12, "speaker": 11, "form": "dlg", "jp": "「忘れ物はないですね‥‥」"},
{"id": 13, "speaker": 3, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 14, "speaker": 11, "form": "dlg", "jp": "「おや、どうしたんだい？」"},
{"id": 15, "speaker": 11, "form": "dlg", "jp": "「足、ケガしてるのか？」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「ええ、昨日アイツを蹴った時に‥‥」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「まあ、たいしたことはなさそうですけど」"},
{"id": 18, "speaker": 11, "form": "dlg", "jp": "「ならいいけど、\n　あんまりムチャをしない方がいいよ！」"},
{"id": 19, "speaker": 11, "form": "dlg", "jp": "「では、行きましょうか‥‥」"},
{"id": 20, "speaker": 11, "form": "dlg", "jp": "「バタン！」"},
{"id": 21, "speaker": 11, "form": "dlg", "jp": "警察は自分たちが警備していても\n堂々と襲撃してきた連中なので、"},
{"id": 22, "speaker": 11, "form": "dlg", "jp": "また襲ってくると判断したらしい。"},
{"id": 23, "speaker": 11, "form": "dlg", "jp": "「本当にスミマセンねぇ‥‥」"},
{"id": 24, "speaker": 3, "form": "dlg", "jp": "「いいえ‥‥こちらこそ‥‥」"},
{"id": 25, "speaker": 11, "form": "dlg", "jp": "「一応、国際的な大事件ですから、上の方も\n　フンパツして、ＶＩＰ扱いの部屋を用意したんで」"},
{"id": 26, "speaker": 11, "form": "dlg", "jp": "「カンベンしてやってください‥‥」"},
{"id": 27, "speaker": 3, "form": "dlg", "jp": "「ありがとうございます‥‥」"},
{"id": 28, "speaker": 3, "form": "choice", "jp": "（『ゴート』のことを聞いてみよう‥‥）"},
{"id": 29, "speaker": 3, "form": "choice", "jp": "（この前の工作員のことを聞いてみよう‥‥！）"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "（『ゴート』のことを聞いてみよう‥‥）"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「それで、あの『サイボーグ』は\n　なにか白状しましたか‥‥？」"},
{"id": 32, "speaker": 11, "form": "dlg", "jp": "「それが‥‥」"},
{"id": 33, "speaker": 11, "form": "dlg", "jp": "「あの野郎‥‥」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「何も言わないんですね‥‥」"},
{"id": 35, "speaker": 11, "form": "dlg", "jp": "「いや、そうじゃなくて‥‥」"},
{"id": 36, "speaker": 11, "form": "dlg", "jp": "「"},
{"id": 37, "speaker": 11, "form": "dlg", "jp": "『自爆』"},
{"id": 38, "speaker": 11, "form": "dlg", "jp": "しやがったんだ‥‥」"},
