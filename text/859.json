[
{"id": 0, "speaker": null, "form": "dlg", "jp": "ボクはあの複雑な『清田さん』と『マイちゃん』のことを\nジーンたちに説明した。"},
{"id": 1, "speaker": 31, "form": "dlg", "jp": "「その話本当かよ！？」"},
{"id": 2, "speaker": 29, "form": "dlg", "jp": "「まるでＳＦね‥‥」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「まあ、そういうわけで、\n　『マイちゃん』は能力者の事件とは無関係なんだ‥‥」"},
{"id": 4, "speaker": 29, "form": "dlg", "jp": "「となると、他の子を探すしかないわね‥‥」"},
{"id": 5, "speaker": 31, "form": "dlg", "jp": "「ナゴムは警察と仲良しなんだろう？」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「別に仲良しってわけじゃあ‥‥」"},
{"id": 7, "speaker": 31, "form": "dlg", "jp": "「でもこの中で一番警察に近付いても\n　不自然じゃないのはナゴムだろう？」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 9, "speaker": 31, "form": "dlg", "jp": "「警察に忍び込んで、行方不明の女の子の『写真』を\n　借りてこいよ！」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「貸してくれないと思うよ！」"},
{"id": 11, "speaker": 31, "form": "dlg", "jp": "「だまって借りてこいよ！」"},
{"id": 12, "speaker": 29, "form": "dlg", "jp": "「女の子たちがどうなってもいいの？」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「わかったよ！」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「ダメかもしれないけど、やってみるよ！」"},
{"id": 15, "speaker": 51, "form": "dlg", "jp": "「がんばってな！」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「ヒトゴトだと思って‥‥」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "こうして、\nボクは警察に『写真』を借りに行くことになった。"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "（さてと、どうしようかな‥‥）"},
{"id": 20, "speaker": 2, "form": "choice", "jp": "【移動】"},
{"id": 21, "speaker": 2, "form": "choice", "jp": "【見る】"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "【移動】"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "（とにかく、警部の所にいかないとな‥‥）"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "ボクは建物の中に入ることにした。"},
{"id": 25, "speaker": 12, "form": "dlg", "jp": "「コラコラ、ここは子供の来る場所じゃないぞ！」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 27, "speaker": 2, "form": "choice", "jp": "【移動】"},
{"id": 28, "speaker": 2, "form": "choice", "jp": "【見る】"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "【移動】"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "（でも、警部の所にいかないことには‥‥）"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "ボクは建物の中に入ることにした。"},
{"id": 32, "speaker": 12, "form": "dlg", "jp": "「ここは子供の来る場所じゃないって\n　言ってるだろう！」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 34, "speaker": 2, "form": "choice", "jp": "【移動】"},
{"id": 35, "speaker": 2, "form": "choice", "jp": "【見る】"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "【見る】"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "ボクは辺りを見回してみることにした。"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "当たり前だけど、入口では不信人物が侵入しないように\n警備の警官が立っている。"},
{"id": 39, "speaker": 2, "form": "choice", "jp": "【移動】"},
{"id": 40, "speaker": 2, "form": "choice", "jp": "【話す】"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "【話す】"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "ボクは素直に警官に話しかけることにした。"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「あのう～～～」"},
{"id": 44, "speaker": 12, "form": "dlg", "jp": "「どうかしたのかい？」"},
{"id": 45, "speaker": 12, "form": "choice", "jp": "「忘れ物を取りにきたんですけど‥‥」"},
{"id": 46, "speaker": 12, "form": "choice", "jp": "「大槻警部に会いたいんですけど‥‥」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「忘れ物を取りにきたんですけど‥‥」"},
{"id": 48, "speaker": 12, "form": "dlg", "jp": "「忘れ物？」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「実はボクここに保護されていたことが‥‥」"},
{"id": 50, "speaker": 12, "form": "dlg", "jp": "「あっ！」"},
{"id": 51, "speaker": 12, "form": "dlg", "jp": "「どこかで見たことがあると思ったよ！」"},
{"id": 52, "speaker": 12, "form": "dlg", "jp": "「何を忘れたの？　取ってきてあげるよ！」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "（しまったな‥‥）"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "（ここは正直に話をするか‥‥）"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「大槻警部に会いたいんですけど‥‥」"},
{"id": 56, "speaker": 12, "form": "dlg", "jp": "「警部になんか用なの？」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "「ちょっと警部本人にしか、言えないんですけど‥‥」"},
{"id": 58, "speaker": 12, "form": "dlg", "jp": "「事件に関係ある情報かなにかだね？」"},
{"id": 59, "speaker": 12, "form": "dlg", "jp": "「ついておいで！」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「ありがとうございます！」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "ボクは警部のいる部屋へ無事入ることができた。"},
{"id": 62, "speaker": 11, "form": "dlg", "jp": "「やあ、ナゴムくんどうかしたのかい？」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "（なんとかして『写真』を貸してもらわないと‥‥）"},
{"id": 64, "speaker": 12, "form": "dlg", "jp": "「彼は事件の情報を持って来たみたいですよ！」"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥！）"},
{"id": 66, "speaker": 11, "form": "dlg", "jp": "「『情報』？」"},
{"id": 67, "speaker": 11, "form": "dlg", "jp": "「どんな情報だい？」"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "「あ、あのう‥‥」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「実は‥‥」"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "（ええい！）"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "「行方不明になった女の子を見たかもしれないんです！」"},
{"id": 72, "speaker": 11, "form": "dlg", "jp": "「本当か？」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「ハイ！」"},
{"id": 74, "speaker": 11, "form": "dlg", "jp": "「で、どこで‥‥」"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "「ゆ、遊園地で‥‥」"},
{"id": 76, "speaker": 11, "form": "dlg", "jp": "「遊園地？」"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "「意識を失った女の子が\n　男の人に抱えられて連れて行かれたんです！」"},
{"id": 78, "speaker": 11, "form": "dlg", "jp": "「それは本当なんだね？」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「ハイ！」"},
{"id": 80, "speaker": 11, "form": "dlg", "jp": "「ちょっと待ってくれ、\n　その女の子はこの中にいるかい？」"},
{"id": 81, "speaker": 11, "form": "dlg", "jp": "警部は机の上に４枚の写真を並べた。"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "（しめた！）"},
{"id": 83, "speaker": 11, "form": "dlg", "jp": "「どうだい？」"},
{"id": 84, "speaker": 11, "form": "choice", "jp": "【こっそり１枚抜き取る】"},
{"id": 85, "speaker": 11, "form": "choice", "jp": "【適当に返事する】"},
{"id": 86, "speaker": 11, "form": "dlg", "jp": "【適当に返事する】"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "「ええ、まあ‥‥」"},
{"id": 88, "speaker": 11, "form": "dlg", "jp": "「まあとかそういう問題じゃないだろう？」"},
{"id": 89, "speaker": 11, "form": "dlg", "jp": "「この中にキミの見た女の子はいるかい？」"},
{"id": 90, "speaker": 11, "form": "choice", "jp": "【こっそり１枚抜き取る】"},
{"id": 91, "speaker": 11, "form": "choice", "jp": "【ゴニョゴニョ返事する】"},
{"id": 92, "speaker": 11, "form": "dlg", "jp": "【ゴニョゴニョ返事する】"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "「ぁっ・・ぇっ・・」"},
{"id": 94, "speaker": 11, "form": "dlg", "jp": "「よく聞こえないよ？」"},
{"id": 95, "speaker": 11, "form": "choice", "jp": "【こっそり１枚抜き取る】"},
{"id": 96, "speaker": 11, "form": "choice", "jp": "【ごっそり４枚取る】"},
{"id": 97, "speaker": 11, "form": "dlg", "jp": "【こっそり１枚抜き取る】"},
{"id": 98, "speaker": 11, "form": "dlg", "jp": "ボクは机の上の写真をこっそりと手にとった。"},
{"id": 99, "speaker": 11, "form": "dlg", "jp": "「オイオイ、乱暴に扱わないでくれよ！」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "「いえ、近くて見てみないと‥‥」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "（ど、どうしよう？）"},
{"id": 102, "speaker": 2, "form": "choice", "jp": "【素直に頼み込む】"},
{"id": 103, "speaker": 2, "form": "choice", "jp": "【そっとポケットに入れる】"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "【素直に頼み込む】"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「警部さん、この写真借りて帰っちゃいけませんか？」"},
{"id": 106, "speaker": 11, "form": "dlg", "jp": "「はぁ？」"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「じっくり見ないと、わからないんで‥‥」"},
{"id": 108, "speaker": 11, "form": "dlg", "jp": "「これは外部への持ち出し禁止だ」"},
{"id": 109, "speaker": 11, "form": "dlg", "jp": "【そっとポケットに入れる】"},
{"id": 110, "speaker": 11, "form": "dlg", "jp": "ボクは写真をそっとポケットに入れた。"},
{"id": 111, "speaker": 11, "form": "dlg", "jp": "「オイオイ、何してるんだ！」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「じょ、冗談ですよ！」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "【ごっそり４枚取る】"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "ボクは机の上の写真をごっそりと手にとった。"},
{"id": 115, "speaker": 11, "form": "dlg", "jp": "「オイオイ、乱暴に扱わないでくれよ！」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "（やっぱり、こっそり借りるなんてムリだよ‥‥）"},
{"id": 118, "speaker": 29, "form": "dlg", "jp": "（もういいわよ！）"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "（ジーン！？）"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "（もういいって？）"},
{"id": 121, "speaker": 29, "form": "dlg", "jp": "（ナゴムの手に持っている写真を\n　コッチからのぞかせてもらったわ）"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "（さすがジーン！！）"},
{"id": 123, "speaker": 29, "form": "dlg", "jp": "（もう帰ってらっしゃい！）"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "（わかった！）"},
{"id": 125, "speaker": 11, "form": "dlg", "jp": "「どうだい？」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「この中にはいないみたいですね？」"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「じゃボクはコレで‥‥」"},
{"id": 128, "speaker": 11, "form": "dlg", "jp": "「待った！」"},
{"id": 129, "speaker": 11, "form": "dlg", "jp": "「この中にいないってことは、\n　別の女の子が新たにさらわれた可能性があるだろう？」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「ええっ！」"},
{"id": 131, "speaker": 11, "form": "dlg", "jp": "「どんな子だったんだ‥‥その子？」"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "（マズイな‥‥）"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "（どうしよう‥‥）"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "（‥‥‥）"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥）"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "（清田さんゴメン！！）"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "「ボクが見た女の子は‥‥」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "ボクは『マイちゃん』の話をした。"},
{"id": 140, "speaker": 11, "form": "dlg", "jp": "「ああ、あの子のことか‥‥」"},
{"id": 141, "speaker": 11, "form": "dlg", "jp": "「あの子なら、事件とは関係ないよ‥‥」"},
{"id": 142, "speaker": 11, "form": "dlg", "jp": "「あの子はかわいそうな子なんだ‥‥」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「そうなんですか‥‥」"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "「どうもおさがわせしました‥‥」"},
{"id": 145, "speaker": 11, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 146, "speaker": 11, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 147, "speaker": 11, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 148, "speaker": 29, "form": "dlg", "jp": "「遅かったわね」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「ゴマかすのに苦労して‥‥」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「で、『写真の女の子』は？」"},
{"id": 151, "speaker": 51, "form": "dlg", "jp": "「ジーンが見つけたみたいよ！」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「さすが！」"},
{"id": 153, "speaker": 29, "form": "dlg", "jp": "「行くわよ！」"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "「どこへ？」"},
{"id": 155, "speaker": 31, "form": "dlg", "jp": "「その女の子の所に決まってるだろう？」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「もう？」"},
{"id": 157, "speaker": 29, "form": "dlg", "jp": "「急がないとあぶないんでしょう！」"},
{"id": 158, "speaker": 31, "form": "dlg", "jp": "「さあ、行くぞ！」"},
{"id": 159, "speaker": 31, "form": "dlg", "jp": "２００５／０８／２０／ＰＭ０５：１０"},
{"id": 160, "speaker": 29, "form": "dlg", "jp": "「ここよ‥‥」"},
{"id": 161, "speaker": 51, "form": "dlg", "jp": "「超能力者の反応は？」"},
{"id": 162, "speaker": 29, "form": "dlg", "jp": "「ないわ‥‥」"},
{"id": 163, "speaker": 31, "form": "dlg", "jp": "「外出中か‥‥」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「で、どうするの？」"},
{"id": 165, "speaker": 29, "form": "dlg", "jp": "「とにかく中を調べましょう」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "ボクたちは部屋の中に入ることにした。"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「ゴトウマサシ‥‥」"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "「これがソイツの名前ね‥‥」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「カギがかかってるけど‥‥」"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "「ナゴムの能力ならカンタンにこわせるでしょう？」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「まあ、そうだけど‥‥」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "『カチッ！』"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "ボクはムリやりカギをこじ開けた。"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "「開いたよ‥‥」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 177, "speaker": 51, "form": "dlg", "jp": "「ウチにまかせて！！」"},
{"id": 178, "speaker": 51, "form": "dlg", "jp": "小田はカギ穴に指先をふれた。"},
{"id": 179, "speaker": 51, "form": "dlg", "jp": "「ガチ！」"},
{"id": 180, "speaker": 51, "form": "dlg", "jp": "「開いたわよ！」"},
{"id": 181, "speaker": 51, "form": "dlg", "jp": "どうやら小田はカギを破壊したようだ。"},
{"id": 182, "speaker": 29, "form": "dlg", "jp": "「行くわよ！」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「気持ちの悪い部屋だね‥‥」"},
{"id": 184, "speaker": 29, "form": "dlg", "jp": "「覚悟しなさい！」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "「はぁ？」"},
{"id": 186, "speaker": 29, "form": "dlg", "jp": "「コッチの部屋はもっとスゴイから‥‥」"},
{"id": 187, "speaker": 29, "form": "dlg", "jp": "そういってジーンは隣の部屋のドアを開けた。"},
{"id": 188, "speaker": 29, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「こ、これは！」"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "「コイツのコレクションね‥‥」"},
{"id": 191, "speaker": 31, "form": "dlg", "jp": "「オイ、みんなまだ生きてるぞ！」"},
{"id": 192, "speaker": 31, "form": "dlg", "jp": "「しっかりしろ！」"},
{"id": 193, "speaker": 29, "form": "dlg", "jp": "「ダメよ‥‥」"},
{"id": 194, "speaker": 29, "form": "dlg", "jp": "「脳の精神神経をズタズタに破壊されてるわ‥‥」"},
{"id": 195, "speaker": 51, "form": "dlg", "jp": "「ヒドイことするなぁ～」"},
{"id": 196, "speaker": 29, "form": "dlg", "jp": "「これでハッキリしたわね‥‥」"},
{"id": 197, "speaker": 29, "form": "dlg", "jp": "「この『誘拐犯』、『ゴトウマサシ』が\n　間違いなく『精神攻撃の能力者』だって‥‥」"},
{"id": 198, "speaker": 31, "form": "dlg", "jp": "「とにかく、ここに長時間いるのはキケンだな‥‥」"},
{"id": 199, "speaker": 31, "form": "dlg", "jp": "「オレたちが疑われることになるぜ！」"},
{"id": 200, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 201, "speaker": 29, "form": "dlg", "jp": "「一旦、退散しましょう！」"},
{"id": 202, "speaker": 51, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 203, "speaker": 51, "form": "dlg", "jp": "「この子らは？」"},
{"id": 204, "speaker": 29, "form": "dlg", "jp": "「私たちではどうすることもできないわ‥‥」"},
{"id": 205, "speaker": 31, "form": "dlg", "jp": "「とにかく、警察に通報して\n　後の事は警察にまかせるしか‥‥」"},
{"id": 206, "speaker": 51, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 207, "speaker": 51, "form": "dlg", "jp": "２００５／０８／２０／ＰＭ０５：５０"},
{"id": 208, "speaker": 51, "form": "dlg", "jp": "『ゴトウの部屋』を出たボクたちは、"},
{"id": 209, "speaker": 51, "form": "dlg", "jp": "公衆電話から警察に女の子たちのことを\n匿名で通報した。"},
{"id": 210, "speaker": 31, "form": "dlg", "jp": "「オイ、いいのかよ‥‥」"},
{"id": 211, "speaker": 29, "form": "dlg", "jp": "「何が？」"},
{"id": 212, "speaker": 31, "form": "dlg", "jp": "「警察が動き出して、\n　ゴトウってヤツをつかまえたら‥‥」"},
{"id": 213, "speaker": 31, "form": "dlg", "jp": "「『仲間』にできないだろう？」"},
{"id": 214, "speaker": 29, "form": "dlg", "jp": "「たぶん、つかまらないわ‥‥」"},
{"id": 215, "speaker": 29, "form": "dlg", "jp": "「つかまるとしたら、『体』だけね‥‥」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「はぁ？」"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "「『彼』は精神を他人の脳に送り込み、\n　その精神を破壊して」"},
{"id": 218, "speaker": 29, "form": "dlg", "jp": "「残った体を自由にコントロールできるのよ‥‥」"},
{"id": 219, "speaker": 29, "form": "dlg", "jp": "「つまり、『彼』にとって『肉体』は\n　乗り換えが自由なのよ‥‥」"},
{"id": 220, "speaker": 51, "form": "dlg", "jp": "「そんなコトより、\n　アンタらこんなヤツまで仲間にするつもり？」"},
{"id": 221, "speaker": 29, "form": "dlg", "jp": "「私の話をちゃんと聞いていなかったの？」"},
{"id": 222, "speaker": 51, "form": "dlg", "jp": "「聞いてるから怒ってるねん！」"},
{"id": 223, "speaker": 29, "form": "dlg", "jp": "「『彼』の『能力』は\n　この中の誰よりも強力なのよ‥‥」"},
{"id": 224, "speaker": 31, "form": "dlg", "jp": "「まあ、ある意味不死身なんだからな‥‥」"},
{"id": 225, "speaker": 29, "form": "dlg", "jp": "「まあ、防御力だけなら『ナゴムの能力』も\n　それなりなんだけど‥‥」"},
{"id": 226, "speaker": 29, "form": "dlg", "jp": "「『人間をコントロール』ってのは、\n　『クリエーター』もできないことだから‥‥」"},
{"id": 227, "speaker": 31, "form": "dlg", "jp": "「ただ、心配なのは\n　向こうが仲間になってくれるかどうかだな‥‥」"},
{"id": 228, "speaker": 31, "form": "dlg", "jp": "「今のジーンの話の通り、\n　絶対的に向こうの方が『力』を持ってる」"},
{"id": 229, "speaker": 31, "form": "dlg", "jp": "「オレたちの言うことを聞いてくれるとは‥‥」"},
{"id": 230, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 231, "speaker": 29, "form": "dlg", "jp": "「『力』でねじ伏せることは難しいわね‥‥」"},
{"id": 232, "speaker": 51, "form": "dlg", "jp": "「ウチは反対や！」"},
{"id": 233, "speaker": 51, "form": "dlg", "jp": "「あんなことするヤツ‥‥」"},
{"id": 234, "speaker": 29, "form": "dlg", "jp": "「気持ちはわかるけどね‥‥」"},
{"id": 235, "speaker": 51, "form": "dlg", "jp": "「あの子たちはどうなるんよ！」"},
{"id": 236, "speaker": 51, "form": "choice", "jp": "「かわいそうだけど‥‥」"},
{"id": 237, "speaker": 51, "form": "choice", "jp": "「大丈夫かも‥‥」"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "「大丈夫かも‥‥」"},
{"id": 239, "speaker": 31, "form": "dlg", "jp": "「ハァ？」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「１００％とはいえないけど‥‥」"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "「もし、清田さんの研究がうまくゆけば‥‥」"},
{"id": 242, "speaker": 31, "form": "dlg", "jp": "「あのワケのわかんない話か？」"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「もし、『マイちゃん』が元に戻るなら\n　あの子たちも元に戻る可能性もあるだろう？」"},
{"id": 244, "speaker": 2, "form": "dlg", "jp": "「もし、『マイちゃん』が元に戻るなら‥‥」"},
{"id": 245, "speaker": 51, "form": "dlg", "jp": "「そ、そうやね！」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「あとで、警察に電話しておくよ！」"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "「『城北大学』の『清田さん』に相談しろって‥‥」"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "その時！"},
{"id": 249, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥！？」"},
{"id": 250, "speaker": 31, "form": "dlg", "jp": "「ジーン、どうかしたのか？」"},
{"id": 251, "speaker": 29, "form": "dlg", "jp": "「今、一瞬『能力者の気配』を感じたの！」"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "「まさか！！」"},
{"id": 253, "speaker": 31, "form": "dlg", "jp": "「この近くをうろついている『能力者』っていったら‥‥」"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "「間違いないわね‥‥」"},
{"id": 255, "speaker": 51, "form": "dlg", "jp": "「どうする？」"},
{"id": 256, "speaker": 29, "form": "dlg", "jp": "「どうにもできないわ‥‥」"},
{"id": 257, "speaker": 29, "form": "dlg", "jp": "「私たちには『精神攻撃』を防ぐすべがないから‥‥」"},
{"id": 258, "speaker": 29, "form": "dlg", "jp": "「じっくり作戦を練ってからじゃないと\n　『全滅』ってこともありうるわよ」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥」"},
{"id": 260, "speaker": 29, "form": "dlg", "jp": "「今日はもう遅いからこれで解散しましょう」"},
{"id": 261, "speaker": 2, "form": "dlg", "jp": "「でも、ここでソイツを見失ったら‥‥」"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "「ソイツ、\n　名前も顔も変わっちゃうかもしれないだろう？」"},
{"id": 263, "speaker": 29, "form": "dlg", "jp": "「大丈夫よ‥‥」"},
{"id": 264, "speaker": 29, "form": "dlg", "jp": "「もう、\n　『コイツ』の『イメージの波形』は覚えたから‥‥」"},
{"id": 265, "speaker": 29, "form": "dlg", "jp": "「どんなに顔や形を変えても\n　すぐにみつけられるわ！」"},
{"id": 266, "speaker": 31, "form": "dlg", "jp": "「とりあえず、深追いは禁物だな‥‥」"},
{"id": 267, "speaker": 31, "form": "dlg", "jp": "こうしてボクはジーンとケネスにたしなめられ、\n一旦解散することになった。"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "「かわいそうだけど‥‥」"},
{"id": 269, "speaker": 2, "form": "dlg", "jp": "「ボクたちは誰も、\n　『ヒーリング』の能力は持ってないから‥‥」"},
{"id": 270, "speaker": 29, "form": "dlg", "jp": "「本部に簡単なキズ程度を治せる仲間はいるけど‥‥」"},
{"id": 271, "speaker": 29, "form": "dlg", "jp": "「ズタズタにされた神経までは‥‥」"},
{"id": 272, "speaker": 51, "form": "dlg", "jp": "「そんなんかわいそすぎる！！」"},
{"id": 273, "speaker": 29, "form": "dlg", "jp": "「これ以上かわいそうな子を増やしたくなかったら\n　早く『彼』を仲間にすることね！」"},
{"id": 274, "speaker": 51, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥」"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "その時！"},
{"id": 277, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥！？」"},
{"id": 278, "speaker": 31, "form": "dlg", "jp": "「ジーン、どうかしたのか？」"},
{"id": 279, "speaker": 29, "form": "dlg", "jp": "「今、一瞬『能力者の気配』を感じたの！」"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "「まさか！！」"},
{"id": 281, "speaker": 31, "form": "dlg", "jp": "「この近くをうろついている『能力者』っていったら‥‥」"},
{"id": 282, "speaker": 29, "form": "dlg", "jp": "「間違いないわね‥‥」"},
{"id": 283, "speaker": 51, "form": "dlg", "jp": "「よしっ、探そう！！」"},
{"id": 284, "speaker": 29, "form": "dlg", "jp": "「ダメよっ！」"},
{"id": 285, "speaker": 29, "form": "dlg", "jp": "「コッチは誰も『精神攻撃』を防げないんだから‥‥」"},
{"id": 286, "speaker": 51, "form": "dlg", "jp": "「そんなんどうでもええやん！！」"},
{"id": 287, "speaker": 51, "form": "dlg", "jp": "「常光寺、行こっ！」"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "ボクと小田は２人で\n『もう１人の能力者』を探すことにした。"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 291, "speaker": 51, "form": "dlg", "jp": "「ふた手に別れよっ！」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「ＯＫ！！」"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "ボクたちは別々に行動することにした。"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "（たしか、この辺りで人影が見えたんだけど‥‥）"},
{"id": 296, "speaker": 29, "form": "dlg", "jp": "「見失ったの？」"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "「ジーン！」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "どうやら、ジーンも来てくれたようだった。"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "「来てくれたの？」"},
{"id": 300, "speaker": 29, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 301, "speaker": 2, "form": "dlg", "jp": "「ねえ、能力でアイツの居場所わからない？」"},
{"id": 302, "speaker": 29, "form": "dlg", "jp": "「能力を使わなくてもわかるんじゃないかしら？」"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "「どこにいるの？」"},
{"id": 304, "speaker": 29, "form": "dlg", "jp": "「目の前よ‥‥」"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「目の前？」"},
{"id": 306, "speaker": 29, "form": "dlg", "jp": "「シネェ！！」"},
{"id": 307, "speaker": 29, "form": "dlg", "jp": "「バキューン！」"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "「ウワァ～～～～～～！！」"},
{"id": 309, "speaker": 15, "form": "dlg", "jp": "「がんばってね！」"},
{"id": 310, "speaker": 2, "form": "dlg", "jp": "「ヒトゴトだと思って‥‥」"},
{"id": 311, "speaker": 15, "form": "dlg", "jp": "「ジーンが見つけたみたいよ！」"},
{"id": 312, "speaker": 15, "form": "dlg", "jp": "「超能力者の反応は？」"},
{"id": 313, "speaker": 15, "form": "dlg", "jp": "「ヒドイわね‥‥」"},
{"id": 314, "speaker": 15, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 315, "speaker": 15, "form": "dlg", "jp": "「この子たちは？」"},
{"id": 316, "speaker": 29, "form": "dlg", "jp": "「私たちではどうすることもできないわ‥‥」"},
{"id": 317, "speaker": 31, "form": "dlg", "jp": "「とにかく、警察に通報して\n　後の事は警察にまかせるしか‥‥」"},
{"id": 318, "speaker": 15, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 319, "speaker": 15, "form": "dlg", "jp": "「そんなコトより、\n　こんなヤツまで仲間にするつもり？」"},
{"id": 320, "speaker": 29, "form": "dlg", "jp": "「私の話をちゃんと聞いていなかったの？」"},
{"id": 321, "speaker": 15, "form": "dlg", "jp": "「聞いてるから怒ってるのよ！」"},
{"id": 322, "speaker": 15, "form": "dlg", "jp": "「私は反対よ！」"},
{"id": 323, "speaker": 15, "form": "dlg", "jp": "「あんなことするヤツ‥‥」"},
{"id": 324, "speaker": 29, "form": "dlg", "jp": "「気持ちはわかるけどね‥‥」"},
{"id": 325, "speaker": 15, "form": "dlg", "jp": "「あの子たちはどうなるのよ！」"},
{"id": 326, "speaker": 15, "form": "dlg", "jp": "「そ、そうよね！」"},
{"id": 327, "speaker": 15, "form": "dlg", "jp": "「どうする？」"},
{"id": 328, "speaker": 15, "form": "dlg", "jp": "「そんなのかわいそすぎる！！」"},
{"id": 329, "speaker": 29, "form": "dlg", "jp": "「これ以上かわいそうな子を増やしたくなかったら\n　早く『彼』を仲間にすることね！」"},
{"id": 330, "speaker": 15, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥」"},
{"id": 331, "speaker": 15, "form": "dlg", "jp": "「よしっ、探しましょう！！」"},
{"id": 332, "speaker": 29, "form": "dlg", "jp": "「ダメよっ！」"},
{"id": 333, "speaker": 29, "form": "dlg", "jp": "「コッチは誰も『精神攻撃』を防げないんだから‥‥」"},
{"id": 334, "speaker": 15, "form": "dlg", "jp": "「そんなのどうでもいいじゃない！！」"},
{"id": 335, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん、行こっ！」"},
{"id": 336, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 337, "speaker": 2, "form": "dlg", "jp": "ボクとアイコは２人で\n『もう１人の能力者』を探すことにした。"},
{"id": 338, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
