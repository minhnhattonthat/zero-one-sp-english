{"id": 17, "speaker": null, "form": "choice", "jp": "【科学部】"},
{"id": 18, "speaker": null, "form": "choice", "jp": "【マンガ部】"},
{"id": 19, "speaker": null, "form": "dlg", "jp": "【科学部】"},
{"id": 20, "speaker": null, "form": "dlg", "jp": "科学部に入っています。"},
{"id": 21, "speaker": null, "form": "dlg", "jp": "【マンガ部】"},
{"id": 22, "speaker": null, "form": "dlg", "jp": "マンガ部に入っています。"},
{"id": 23, "speaker": null, "form": "dlg", "jp": "【入らない】"},
{"id": 24, "speaker": null, "form": "dlg", "jp": "クラブには入っていません。"},
{"id": 25, "speaker": null, "form": "dlg", "jp": "パートナーを選びます。"},
{"id": 26, "speaker": null, "form": "choice", "jp": "【アイコ】"},
{"id": 27, "speaker": null, "form": "choice", "jp": "【アキラ】"},
{"id": 28, "speaker": null, "form": "choice", "jp": "【ナナセ】"},
{"id": 29, "speaker": null, "form": "dlg", "jp": "アイコです。"},
{"id": 30, "speaker": null, "form": "dlg", "jp": "アキラです。"},
{"id": 31, "speaker": null, "form": "dlg", "jp": "ナナセです。"},
{"id": 32, "speaker": null, "form": "dlg", "jp": "誰か死んでますか？"},
{"id": 33, "speaker": null, "form": "choice", "jp": "【死んでる】"},
{"id": 34, "speaker": null, "form": "choice", "jp": "【しんでない】"},
{"id": 35, "speaker": null, "form": "dlg", "jp": "誰も死んでません。"},
{"id": 36, "speaker": null, "form": "dlg", "jp": "誰か死んでます。"},
{"id": 37, "speaker": null, "form": "dlg", "jp": "誰が死んでますか？"},
{"id": 38, "speaker": null, "form": "choice", "jp": "【アイコ】"},
{"id": 39, "speaker": null, "form": "choice", "jp": "【アキラ】"},
{"id": 40, "speaker": null, "form": "choice", "jp": "【ナナセ】"},
{"id": 41, "speaker": null, "form": "dlg", "jp": "アイコが死んでます。"},
{"id": 42, "speaker": null, "form": "dlg", "jp": "アキラが死んでます。"},
{"id": 43, "speaker": null, "form": "dlg", "jp": "ナナセが死んでます。"},
{"id": 44, "speaker": null, "form": "dlg", "jp": "ジーンを気にする？"},
{"id": 45, "speaker": null, "form": "choice", "jp": "【しない】"},
{"id": 46, "speaker": null, "form": "choice", "jp": "【する】"},
{"id": 47, "speaker": null, "form": "dlg", "jp": "【しない】"},
{"id": 48, "speaker": null, "form": "dlg", "jp": "【する】"},
{"id": 49, "speaker": null, "form": "dlg", "jp": "ではゲームスタート！"},
{"id": 50, "speaker": null, "form": "dlg", "jp": "２００５／０８／２９／ＡＭ１０：２０"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "（なんだい、急に集合かけたりして？）"},
{"id": 52, "speaker": 29, "form": "dlg", "jp": "（本部から、\n　アナタたちの『スーツ』が届いたのよ‥‥）"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "（『スーツ』？）"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "（もしかして、いまジーンたちが着ているそれ？）"},
{"id": 55, "speaker": 29, "form": "dlg", "jp": "（そうよ‥‥）"},
{"id": 56, "speaker": 29, "form": "dlg", "jp": "（『Ｅ－ｇｒｏ』のユニフォームみたいなものよ！）"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "（ユニフォーム？）"},
{"id": 58, "speaker": 31, "form": "dlg", "jp": "（まあ、戦闘服みたいなもんだ！）"},
{"id": 59, "speaker": 31, "form": "dlg", "jp": "（『Ｅ－ｇｒｏ』は秘密の組織だけど、優秀な科学者や\n　大手企業がバックアップしてくれてるから）"},
{"id": 60, "speaker": 31, "form": "dlg", "jp": "（超能力だけでなく、科学力もスゴイんだよ）"},
{"id": 61, "speaker": 31, "form": "dlg", "jp": "（このスーツには\n　そのスゴイ科学がいっぱい詰まってるんだ！）"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "（例えば？）"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "（温度調節機能とか‥‥）"},
{"id": 64, "speaker": 29, "form": "dlg", "jp": "（どんな気温の場所でも体温を一定に保てる機能よ）"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "（さらに‥‥）"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "（一番の特徴が『ステルス効果』ね‥‥）"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "（ステルス効果？）"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "（このスーツには光の乱反射機能が付いていて、\n　カメラやレーダーなんかに捕らえられにくいの‥‥）"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "（この前のロボットの時みたいな行動をしてたら、\n　カメラなんかに写っちゃうかもしれないでしょう？）"},
{"id": 70, "speaker": 31, "form": "dlg", "jp": "（そうだな、あの時は誰かに見られるんじゃあって\n　ドキドキしたからな‥‥）"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "（とにかく、これからは\n　行動する時にはコレを着てちょうだい！）"},
{"id": 72, "speaker": 16, "form": "dlg", "jp": "（エ～っ！）"},
{"id": 73, "speaker": 31, "form": "dlg", "jp": "（不満なのか？）"},
{"id": 74, "speaker": 16, "form": "dlg", "jp": "（だって、アキラ‥‥）"},
{"id": 75, "speaker": 16, "form": "dlg", "jp": "（実は、自分専用の『バトルスーツ』を\n　作って来たのに‥‥）"},
{"id": 76, "speaker": 35, "form": "dlg", "jp": "（ホント？）"},
{"id": 77, "speaker": 35, "form": "dlg", "jp": "（アキラちゃん、スゴイや！！）"},
{"id": 78, "speaker": 16, "form": "dlg", "jp": "（でしょう？）"},
{"id": 79, "speaker": 16, "form": "dlg", "jp": "（常光寺くん、ちょっとトイレ借りるわね？）"},
{"id": 80, "speaker": 16, "form": "dlg", "jp": "（着替えてくるわ！）"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "（いいけど、姉さんに見つかるなよ！）"},
{"id": 82, "speaker": 16, "form": "dlg", "jp": "（わかってるって！）"},
{"id": 83, "speaker": 16, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 84, "speaker": 16, "form": "dlg", "jp": "「バタン！」"},
{"id": 85, "speaker": 16, "form": "dlg", "jp": "長尾は紙袋を抱えて部屋を出ていった。"},
{"id": 86, "speaker": 35, "form": "dlg", "jp": "（アキラちゃんってスゴイんだね‥‥）"},
{"id": 87, "speaker": 31, "form": "dlg", "jp": "（たしかに、そこらへんにいる女の子とは\n　違った感じがするもんな）"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "（多分、期待しない方がいいよ‥‥）"},
{"id": 89, "speaker": 16, "form": "dlg", "jp": "（お待たせ～～）"},
{"id": 90, "speaker": 16, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "（何よ、その格好は！）"},
{"id": 92, "speaker": 16, "form": "dlg", "jp": "（どう？）"},
{"id": 93, "speaker": 31, "form": "dlg", "jp": "（いいぞ、アキラ！！）"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "（いいわけないでしょう！）"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "（着替えてらっしゃい！）"},
{"id": 96, "speaker": 16, "form": "dlg", "jp": "（なんで？）"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "（いいからっ！！）"},
{"id": 98, "speaker": 16, "form": "dlg", "jp": "（わかったわよ！）"},
{"id": 99, "speaker": 16, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 100, "speaker": 16, "form": "dlg", "jp": "「バタン！」"},
{"id": 101, "speaker": 16, "form": "dlg", "jp": "長尾は再び着替えに行った。"},
{"id": 102, "speaker": 16, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 103, "speaker": 16, "form": "dlg", "jp": "（ハイ、コレでいいんでしょ！）"},
{"id": 104, "speaker": 31, "form": "dlg", "jp": "（いや、オレはさっきの方が面白かったぜ！）"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "（そう言う問題じゃないでしょ！！）"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "（あんな格好じゃぁ、\n　目立ってしょうがないじゃないの！）"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "（それにあんなに肌が出ていたら\n　危ないでしょう！）"},
{"id": 108, "speaker": 16, "form": "dlg", "jp": "（でも、超能力で戦うなら、\n　フツウあんな感じでしょう？）"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "（フツウは超能力では戦わないな‥‥）"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "（とにかく、本部からの\n　コッチのユニフォームを着てもらうから‥‥）"},
{"id": 111, "speaker": 15, "form": "dlg", "jp": "（コレってピチピチの素材だから‥‥）"},
{"id": 112, "speaker": 15, "form": "dlg", "jp": "（体のラインが出ちゃうんじゃ？）"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "（子供のクセにマセたこと言わないで！）"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "（生きるか死ぬかの戦いなのよ！）"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "（機能優先には目をつぶりなさい！）"},
{"id": 116, "speaker": 16, "form": "dlg", "jp": "（コレってピチピチの素材だから‥‥）"},
{"id": 117, "speaker": 16, "form": "dlg", "jp": "（体のラインが出ちゃうんじゃ？）"},
{"id": 118, "speaker": 29, "form": "dlg", "jp": "（アンタのコスプレよりぜんぜんマシでしょう！）"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "（生きるか死ぬかの戦いなのよ！）"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "（機能優先には目をつぶりなさい！）"},
{"id": 121, "speaker": 18, "form": "dlg", "jp": "（コレってピチッとした素材だから‥‥）"},
{"id": 122, "speaker": 18, "form": "dlg", "jp": "（体のラインが出ちゃうんじゃ‥‥？）"},
{"id": 123, "speaker": 29, "form": "dlg", "jp": "（生きるか死ぬかの戦いなの）"},
{"id": 124, "speaker": 29, "form": "dlg", "jp": "（機能優先には目をつぶってちょうだい‥‥）"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "（で、さぁ～）"},
{"id": 126, "speaker": 2, "form": "choice", "jp": "（なんで今頃こんなものを？）"},
{"id": 127, "speaker": 2, "form": "choice", "jp": "（もう仲間探しは終わったんじゃ？）"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "（なんで今頃こんなものを？）"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "（それこそ、こないだのロボットの時に\n　送ってくれたら良かったのに！）"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "（アナタたちの体のサイズにあわせて、\n　カスタマイズしてたのよ！）"},
{"id": 131, "speaker": 29, "form": "dlg", "jp": "（それと、\n　仲間探しが一段落ついたってこともあるしね）"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "（もう仲間探しは終わったんじゃ？）"},
{"id": 133, "speaker": 29, "form": "dlg", "jp": "（私たちの目的は\n　仲間探しじゃぁないでしょう！）"},
{"id": 134, "speaker": 29, "form": "dlg", "jp": "（仲間探しが終わったってことは、いよいよ\n　ゲーマーとの応戦体制を整えていかないと‥‥）"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "（結局、３人だけしか集まらなかったけど‥‥）"},
{"id": 136, "speaker": 31, "form": "dlg", "jp": "（気にするな！）"},
{"id": 137, "speaker": 31, "form": "dlg", "jp": "（確率的には\n　半分以上が仲間になったんだから優秀な方だ！）"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "（それに、本部はアナタたち３人の能力を\n　高く評価しているわ！）"},
{"id": 139, "speaker": 31, "form": "dlg", "jp": "（なにしろ、戦車より強い中学生までいるからな！）"},
{"id": 140, "speaker": 29, "form": "dlg", "jp": "（それに、だんだんゲーマーの攻撃も\n　本格的になりつつあるみたいだし‥‥）"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "ジーンは新聞の束を差し出した。"},
{"id": 142, "speaker": 29, "form": "dlg", "jp": "「バサ‥‥」"},
{"id": 143, "speaker": 29, "form": "dlg", "jp": "そこには、世界各国で様々な機械が誤作動したという\nニュースが書かれていた。"},
{"id": 144, "speaker": 31, "form": "dlg", "jp": "（いよいよって感じだな‥‥）"},
{"id": 145, "speaker": 29, "form": "dlg", "jp": "（だから本部も召集をかけたみたいね‥‥）"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "（『召集』！！）"},
{"id": 147, "speaker": 29, "form": "dlg", "jp": "（そうよ、\n　ナゴムたちにもすぐにペルーの本部に‥‥）"},
{"id": 148, "speaker": 15, "form": "dlg", "jp": "（すぐになんて、無理よ！）"},
{"id": 149, "speaker": 15, "form": "dlg", "jp": "（お母さんたちになんて説明すればいいのよ！）"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "（心配しないで！）"},
{"id": 151, "speaker": 29, "form": "dlg", "jp": "（これからは本格的な戦いになるから、\n　家族ぐらいになら話しちゃってかまわないから‥‥）"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "（ありのままを説明してあげて‥‥）"},
{"id": 153, "speaker": 15, "form": "dlg", "jp": "（そんなの信じてくれるわけないじゃない！）"},
{"id": 154, "speaker": 15, "form": "dlg", "jp": "（それに‥‥）"},
{"id": 155, "speaker": 16, "form": "dlg", "jp": "（すぐになんて、無理！）"},
{"id": 156, "speaker": 16, "form": "dlg", "jp": "（絶対ダメ！）"},
{"id": 157, "speaker": 16, "form": "dlg", "jp": "（家族になんて説明すればいいのよ！）"},
{"id": 158, "speaker": 29, "form": "dlg", "jp": "（心配しないで！）"},
{"id": 159, "speaker": 29, "form": "dlg", "jp": "（これからは本格的な戦いになるから、\n　家族ぐらいになら話しちゃってかまわないから‥‥）"},
{"id": 160, "speaker": 29, "form": "dlg", "jp": "（ありのままを説明してあげて‥‥）"},
{"id": 161, "speaker": 16, "form": "dlg", "jp": "（そんなの信じてくれるわけないじゃない！）"},
{"id": 162, "speaker": 16, "form": "dlg", "jp": "（それに‥‥）"},
{"id": 163, "speaker": 18, "form": "dlg", "jp": "（そんな、すぐになんて‥‥）"},
{"id": 164, "speaker": 18, "form": "dlg", "jp": "（家族になんて説明すればいいの？）"},
{"id": 165, "speaker": 29, "form": "dlg", "jp": "（心配しないで！）"},
{"id": 166, "speaker": 29, "form": "dlg", "jp": "（これからは本格的な戦いになるから、\n　家族ぐらいになら話しちゃってかまわないから‥‥）"},
{"id": 167, "speaker": 29, "form": "dlg", "jp": "（ありのままを説明してあげて‥‥）"},
{"id": 168, "speaker": 18, "form": "dlg", "jp": "（そんなの信じてくれるわけないわ！）"},
{"id": 169, "speaker": 18, "form": "dlg", "jp": "（それに‥‥）"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "（そんな危険な戦いに参加していいっていう親も\n　この国にはいないよな‥‥）"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "（ナゴムのところもそうなの？）"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "（当たり前だろう！）"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "（中学生が\n　そんなワケのわからない理由で海外旅行なんて！）"},
{"id": 174, "speaker": 35, "form": "dlg", "jp": "（オレはぜんぜんかまわないよ‥‥）"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "（松尾さん、仕事は大丈夫なの？）"},
{"id": 176, "speaker": 35, "form": "dlg", "jp": "（もう除隊したよ！）"},
{"id": 177, "speaker": 35, "form": "dlg", "jp": "（日本の平和より、人類の平和の方が大事だからね‥‥）"},
{"id": 178, "speaker": 31, "form": "dlg", "jp": "（立派だねぇ～～）"},
{"id": 179, "speaker": 29, "form": "dlg", "jp": "（とにかく、何がなんでも話をつけてちょうだい！）"},
{"id": 180, "speaker": 29, "form": "dlg", "jp": "（アナタたちの力が必要なのよ！）"},
{"id": 181, "speaker": 29, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 182, "speaker": 29, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 183, "speaker": 29, "form": "dlg", "jp": "誰だろう‥‥？"},
{"id": 184, "speaker": 3, "form": "dlg", "jp": "「アラッ！」"},
{"id": 185, "speaker": 3, "form": "dlg", "jp": "「『清田さん』！！」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "（『清田』！？）"},
{"id": 187, "speaker": 31, "form": "dlg", "jp": "（オイ、今『清田』って言わなかったか？）"},
{"id": 188, "speaker": 35, "form": "dlg", "jp": "（言った！）"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "（まさかっ！？）"},
{"id": 190, "speaker": 35, "form": "dlg", "jp": "（ナゴムくんがやっつけたんじゃぁなかったのか？）"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "（多分‥‥）"},
{"id": 192, "speaker": 3, "form": "dlg", "jp": "「さあ、上がってください」"},
{"id": 193, "speaker": 37, "form": "dlg", "jp": "「すいません‥‥」"},
{"id": 194, "speaker": 3, "form": "dlg", "jp": "「で、今日はなんのご用件で？」"},
{"id": 195, "speaker": 37, "form": "dlg", "jp": "「ナゴムくんにちょっと‥‥」"},
{"id": 196, "speaker": 3, "form": "dlg", "jp": "「ナゴムに？」"},
{"id": 197, "speaker": 31, "form": "dlg", "jp": "（ナゴムに用だって言ってるぜ？）"},
{"id": 198, "speaker": 31, "form": "choice", "jp": "（まさか仕返しに？）"},
{"id": 199, "speaker": 31, "form": "choice", "jp": "（いや、そんなハズはない！）"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "（まさか仕返しに？）"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "（十分考えられる！！）"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "（いや、そんなハズはない！）"},
{"id": 203, "speaker": 3, "form": "dlg", "jp": "「ナゴム～！」"},
{"id": 204, "speaker": 3, "form": "dlg", "jp": "「お客さんよ～～」"},
{"id": 205, "speaker": 3, "form": "dlg", "jp": "「清田さん！！」"},
{"id": 206, "speaker": 3, "form": "dlg", "jp": "「聞こえてるの！？」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「ああ！」"},
{"id": 208, "speaker": 3, "form": "dlg", "jp": "「上がってもらうわよ～！」"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 210, "speaker": 3, "form": "dlg", "jp": "「どうぞ、２階にいますから‥‥」"},
{"id": 211, "speaker": 37, "form": "dlg", "jp": "「では、おじゃまします‥‥」"},
{"id": 212, "speaker": 37, "form": "dlg", "jp": "清田さんが上がってくる。"},
{"id": 213, "speaker": 37, "form": "dlg", "jp": "「タッタッタッタッタ‥‥」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "（どうしよう！）"},
{"id": 215, "speaker": 29, "form": "dlg", "jp": "（安心して！）"},
{"id": 216, "speaker": 29, "form": "dlg", "jp": "（彼もバカじゃないんだから、\n　こんなところで攻撃をしかけてはこないわ）"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "（そうだといいんだけど‥‥）"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「コン、コン」"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "（来たっ！）"},
{"id": 220, "speaker": 37, "form": "dlg", "jp": "「入るよ？」"},
{"id": 221, "speaker": 37, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 222, "speaker": 31, "form": "dlg", "jp": "「テメエ、よくもノコノコと‥‥」"},
{"id": 223, "speaker": 31, "form": "dlg", "jp": "「この前のウラミは忘れちゃいないんだぞ！！」"},
{"id": 224, "speaker": 37, "form": "dlg", "jp": "「ちょっと待って！！」"},
{"id": 225, "speaker": 37, "form": "dlg", "jp": "「人違いだっ！！」"},
{"id": 226, "speaker": 31, "form": "dlg", "jp": "「人違いだとぉ？」"},
{"id": 227, "speaker": 31, "form": "dlg", "jp": "「オメエの顔は忘れないよ！」"},
{"id": 228, "speaker": 37, "form": "dlg", "jp": "「違うっ！」"},
{"id": 229, "speaker": 37, "form": "dlg", "jp": "「ボクは清田じゃないんだ！！」"},
{"id": 230, "speaker": 31, "form": "dlg", "jp": "「‥‥誰がどうみても清田じゃないか？」"},
{"id": 231, "speaker": 29, "form": "dlg", "jp": "「清田じゃないんだったら誰なのよ？」"},
{"id": 232, "speaker": 4, "form": "dlg", "jp": "「『シロー』‥‥」"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "（シロー！？）"},
{"id": 234, "speaker": 31, "form": "dlg", "jp": "「なんだ、\n　テメェ『清田シロー』って名前なのか？」"},
{"id": 235, "speaker": 48, "form": "dlg", "jp": "「違うよ！」"},
{"id": 236, "speaker": 48, "form": "dlg", "jp": "「ボクには名字なんてないんだ‥‥」"},
{"id": 237, "speaker": 31, "form": "dlg", "jp": "「ヘタなイイワケだな‥‥」"},
{"id": 238, "speaker": 31, "form": "dlg", "jp": "「名字がないって、\n　オマエはグラビアアイドルか？」"},
{"id": 239, "speaker": 31, "form": "choice", "jp": "「待って！　本当にシローかも‥‥」"},
{"id": 240, "speaker": 31, "form": "choice", "jp": "「シローの体は警察が保管してるんだ！」"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "「待って！　本当にシローかも‥‥」"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "「シローの体は警察が保管してるんだ！」"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「こんなところに来れるわけないだろう！」"},
{"id": 244, "speaker": 31, "form": "dlg", "jp": "「なんなんだよ、シローって？」"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "「姉さんが育ててた人工知能‥‥」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「ルードの基地や、\n　新幹線の時に助けてくれたのもシローなんだ‥‥」"},
{"id": 247, "speaker": 29, "form": "dlg", "jp": "「新幹線の時って、軍事衛星が‥‥」"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "「シローは軍事衛星の中に逃げてたんだ！」"},
{"id": 249, "speaker": 31, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 250, "speaker": 31, "form": "dlg", "jp": "「言ってることがチンプンカンプンだよ！」"},
{"id": 251, "speaker": 29, "form": "dlg", "jp": "「ちゃんと説明してくれる？」"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "ボクは『シロー』のことをみんなに説明した‥‥"},
{"id": 254, "speaker": 31, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 255, "speaker": 29, "form": "dlg", "jp": "「でも、その話、おかしくない？」"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "「何が？」"},
{"id": 257, "speaker": 29, "form": "dlg", "jp": "「だって、今の話からすると、その『シロー』って\n　軍事衛星の中にいるハズだし‥‥」"},
{"id": 258, "speaker": 29, "form": "dlg", "jp": "「体も、警察が保管してるんでしょう？」"},
{"id": 259, "speaker": 29, "form": "dlg", "jp": "「じゃあ、ここに来れるワケないじゃない！」"},
{"id": 260, "speaker": 31, "form": "dlg", "jp": "「となると、やっぱりテメェ！！」"},
{"id": 261, "speaker": 48, "form": "dlg", "jp": "「信じてください！」"},
{"id": 262, "speaker": 48, "form": "dlg", "jp": "「ボクは『シロー』なんです！」"},
{"id": 263, "speaker": 48, "form": "choice", "jp": "「信じるよ！」"},
{"id": 264, "speaker": 48, "form": "choice", "jp": "「信じられないよ！」"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "「信じるよ！」"},
{"id": 266, "speaker": 31, "form": "dlg", "jp": "「バカ！　信じられないだろう？」"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "「信じられないよ！」"},
{"id": 268, "speaker": 48, "form": "dlg", "jp": "「とにかく、\n　説明しますから聞いてください‥‥」"},
{"id": 269, "speaker": 29, "form": "dlg", "jp": "「わかったわ、話しなさい‥‥」"},
{"id": 270, "speaker": 29, "form": "dlg", "jp": "「そのかわり、おかしなことをしたら、\n　即、攻撃するから‥‥」"},
{"id": 271, "speaker": 48, "form": "dlg", "jp": "「わかりました‥‥」"}
]
