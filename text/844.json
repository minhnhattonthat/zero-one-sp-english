[
{"id": 0, "speaker": 31, "form": "dlg", "jp": "「オイ！　起きろ！」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "「へっ、何？」"},
{"id": 2, "speaker": 31, "form": "dlg", "jp": "「リーダーが呼んでる」"},
{"id": 3, "speaker": 31, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 4, "speaker": 31, "form": "dlg", "jp": "「バタン！」"},
{"id": 5, "speaker": 31, "form": "dlg", "jp": "ケネスに起されたボクは、\nみんなと一緒に『メインホール』へと向かった。"},
{"id": 6, "speaker": 31, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 7, "speaker": 46, "form": "dlg", "jp": "「どうですか？」"},
{"id": 8, "speaker": 46, "form": "dlg", "jp": "「少しは、体は休まりましたか？」"},
{"id": 9, "speaker": 29, "form": "dlg", "jp": "「ハイ、ありがとうございました」"},
{"id": 10, "speaker": 46, "form": "dlg", "jp": "「アナタがたを呼んだのは他でもありません」"},
{"id": 11, "speaker": 46, "form": "dlg", "jp": "「アナタがたにも\n　『アカシックレコード』を見てもらおうと思いまして」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「『アカシックレコード』って‥‥」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「前にジーンが話していた？」"},
{"id": 14, "speaker": 29, "form": "dlg", "jp": "「そう、人類の過去の記憶が記録されているっていう‥‥」"},
{"id": 15, "speaker": 15, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 16, "speaker": 15, "form": "dlg", "jp": "「『アカシックレコード』ってＳＦに出てくる\n　人類の未来までの記述がされているってヤツじゃぁ？」"},
{"id": 17, "speaker": 16, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 18, "speaker": 16, "form": "dlg", "jp": "「『アカシックレコード』って\n　人類の未来までの記述がされているってヤツじゃない？」"},
{"id": 19, "speaker": 18, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 20, "speaker": 18, "form": "dlg", "jp": "「『アカシックレコード』ってＳＦに出てくる\n　人類の未来までの記述がされているってヤツでしょう？」"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "「だから、それは『ＳＦ』の中の話でしょう？」"},
{"id": 22, "speaker": 29, "form": "dlg", "jp": "「実際の『アカシックレコード』はそうじゃないの」"},
{"id": 23, "speaker": 29, "form": "dlg", "jp": "「これまでの『ゲーマー』の破壊行動が\n　全て記録されているの‥‥」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「で、それはどこに？」"},
{"id": 25, "speaker": 46, "form": "dlg", "jp": "「それは今から案内します」"},
{"id": 26, "speaker": 46, "form": "dlg", "jp": "「ついて来てください‥‥」"},
{"id": 27, "speaker": 46, "form": "dlg", "jp": "ボクたちは『アリス』の後について行った。"},
{"id": 28, "speaker": 46, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 29, "speaker": 46, "form": "dlg", "jp": "「ここが『コンピュータルーム』です。」"},
{"id": 30, "speaker": 35, "form": "dlg", "jp": "「うわぁ～～」"},
{"id": 31, "speaker": 35, "form": "dlg", "jp": "「スゴイなぁ～！」"},
{"id": 32, "speaker": 35, "form": "dlg", "jp": "「全然、この遺跡のイメージにあっていないけど‥‥」"},
{"id": 33, "speaker": 35, "form": "dlg", "jp": "「で、このコンピュータたちにそのゲーマーの\n　記録が残ってるの？」"},
{"id": 34, "speaker": 31, "form": "dlg", "jp": "「『アカシックレコード』は\n　２０００年前からあるんだぞ！」"},
{"id": 35, "speaker": 31, "form": "dlg", "jp": "「現在のコンピュータの形をしているハズないだろう！」"},
{"id": 36, "speaker": 46, "form": "dlg", "jp": "「あの、奥に固定されているのが\n　『アカシックレコード』です」"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "「こ、この石が‥‥？」"},
{"id": 38, "speaker": 46, "form": "dlg", "jp": "「石なのか、機械なのかもよくわかりません‥‥」"},
{"id": 39, "speaker": 46, "form": "dlg", "jp": "「これを構成している物質すら何なのか‥‥」"},
{"id": 40, "speaker": 46, "form": "dlg", "jp": "「先ほどケネスが『２０００年前』と言いましたが、\n　実際はそれよりずっと前からあったみたいです」"},
{"id": 41, "speaker": 46, "form": "dlg", "jp": "「インカ人がこれを見つけたのが\n　『２０００年前』ってだけですから‥‥」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "「インカ人が見つけたってことは？」"},
{"id": 43, "speaker": 46, "form": "dlg", "jp": "「そうです」"},
{"id": 44, "speaker": 46, "form": "dlg", "jp": "「『アカシックレコード』はずっとこの場所にあるのです」"},
{"id": 45, "speaker": 46, "form": "dlg", "jp": "「インカ人がここに『要塞都市』を作ったのも\n　この『アカシックレコード』がここにあったからです。」"},
{"id": 46, "speaker": 35, "form": "dlg", "jp": "「そんなの動かしちゃえばいいのに‥‥」"},
{"id": 47, "speaker": 31, "form": "dlg", "jp": "「動かないんだよ！」"},
{"id": 48, "speaker": 31, "form": "dlg", "jp": "「動かせないし、壊すこともできないんだよ！」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「そんなもの存在するの？」"},
{"id": 50, "speaker": 46, "form": "dlg", "jp": "「存在しているから、目の前にあるのです」"},
{"id": 51, "speaker": 46, "form": "dlg", "jp": "「『壊れない』から、何千年もこうして存在し」"},
{"id": 52, "speaker": 46, "form": "dlg", "jp": "「『動かせない』から、ここにあり続けているのです」"},
{"id": 53, "speaker": 46, "form": "dlg", "jp": "「インカの人々はここに『要塞』を作れば\n　壊されないことを知っていたのです」"},
{"id": 54, "speaker": 46, "form": "dlg", "jp": "「だから、こんな不便な山奥に要塞を作ったのです」"},
{"id": 55, "speaker": 46, "form": "dlg", "jp": "「そして私たち『Ｅ－ｇｒｏ』も、\n　最も安全な場所としてここに本部を設けたのです」"},
{"id": 56, "speaker": 35, "form": "dlg", "jp": "「で、コイツからどうやって『記憶』を読み取ったの？」"},
{"id": 57, "speaker": 46, "form": "dlg", "jp": "「触れてみてください‥‥」"},
{"id": 58, "speaker": 35, "form": "dlg", "jp": "「ふれると御利益があるの？」"},
{"id": 59, "speaker": 29, "form": "dlg", "jp": "「いいから、触れてみて‥‥」"},
{"id": 60, "speaker": 35, "form": "dlg", "jp": "「じゃあ、ちょっとだけ‥‥」"},
{"id": 61, "speaker": 35, "form": "dlg", "jp": "松尾さんはおそるおそる\n『アカシックレコード』に手を伸ばした。"},
{"id": 62, "speaker": 35, "form": "dlg", "jp": "そして‥‥"},
{"id": 63, "speaker": 35, "form": "dlg", "jp": "「うわぁ～～！」"},
{"id": 64, "speaker": 35, "form": "dlg", "jp": "「うわっ！　うわっ！」"},
{"id": 65, "speaker": 35, "form": "dlg", "jp": "「うわぁ～～～！」"},
{"id": 66, "speaker": 35, "form": "dlg", "jp": "「な、なんだよこれ‥‥」"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "「忘れてたわ‥‥」"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "「清田の攻撃で気絶しちゃうほどの\n　怖がりには少し刺激が強すぎたかもしれないわね‥‥」"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "「じゃあ、次はナゴムの番よ‥‥」"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "「なんか、コワイなぁ‥‥」"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "「大丈夫よ！」"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "「アスカが特別怖がりなだけなんだから‥‥」"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「さあ‥‥」"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "ボクもおそるおそる『アカシックレコード』に触れてみた。"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "すると‥‥"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "指先から『イメージ』が直接頭の中に流れ込んで来た。"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "それは恐ろしい映像の数々だった。"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "大洪水で、町が一瞬に飲み込まれ、"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "幼い子も年寄りも、\nだれかれなく悲鳴とともに激流にのまれてゆく‥‥"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "なすすべも無く流され、\n肺いっぱいに水を飲み、溺れ死んでゆく映像。"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "火山が噴火し、"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "溶岩が押し寄せ、"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "山も森も炎に包まれ、"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "家を焼かれ、町を焼かれ、"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "逃げ場を失った人々が灼熱に焼かれてゆくイメージ。"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "それ以外にも大寒波、干ばつ、大地震等\n様々な天変地異が人類を打ちのめしていた。"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "「どうだった？」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「これが誰かの仕業ならヒドすぎる！！」"},
{"id": 90, "speaker": 29, "form": "dlg", "jp": "「アイコも見てみる？」"},
{"id": 91, "speaker": 15, "form": "dlg", "jp": "「エンリョします‥‥」"},
{"id": 92, "speaker": 15, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 93, "speaker": 29, "form": "dlg", "jp": "「アキラも見てみる？」"},
{"id": 94, "speaker": 16, "form": "dlg", "jp": "「ヤダ！」"},
{"id": 95, "speaker": 16, "form": "dlg", "jp": "「絶対見ない！」"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "「ナナセも見てみる？」"},
{"id": 97, "speaker": 18, "form": "dlg", "jp": "「辞退します‥‥」"},
{"id": 98, "speaker": 46, "form": "dlg", "jp": "「『ゲーマー』の恐ろしさを理解してくれたなら、\n　別にかまいません」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「確かに恐ろしい映像の数々だったけど‥‥」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "「アレがゲーマーの仕業だっていう証拠は？」"},
{"id": 101, "speaker": 46, "form": "dlg", "jp": "「ひとつはイイツタエです」"},
{"id": 102, "speaker": 46, "form": "dlg", "jp": "「インカの人々は文字を持たなかったので、\n　文献は残っていません」"},
{"id": 103, "speaker": 46, "form": "dlg", "jp": "「しかし、イイツタエることで\n　ゲーマーの存在を残してきました」"},
{"id": 104, "speaker": 46, "form": "dlg", "jp": "「そして、もうひとつが『能力』‥‥」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「『能力』？」"},
{"id": 106, "speaker": 46, "form": "dlg", "jp": "「ジーンたちのような、\n　特別なものが見える能力者には」"},
{"id": 107, "speaker": 46, "form": "dlg", "jp": "「この"},
{"id": 108, "speaker": 46, "form": "dlg", "jp": "『天変地異』"},
{"id": 109, "speaker": 46, "form": "dlg", "jp": "が"},
{"id": 110, "speaker": 46, "form": "dlg", "jp": "『何ものか』"},
{"id": 111, "speaker": 46, "form": "dlg", "jp": "によって\n　コントロールされているってことがわかるのです」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「そうなのジーン‥‥？」"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "「ものスゴク"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "『邪悪な意志』"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "を感じるの！」"},
{"id": 117, "speaker": 46, "form": "dlg", "jp": "「さらにジーンたちは、最近になって」"},
{"id": 118, "speaker": 46, "form": "dlg", "jp": "「この『アカシックレコード』から、\n　新たな『邪悪な意識』を感じとったのです‥‥」"},
{"id": 119, "speaker": 15, "form": "dlg", "jp": "「それで、近々ゲーマーの攻撃があるって知ったのね！」"},
{"id": 120, "speaker": 16, "form": "dlg", "jp": "「それで、近々ゲーマーの攻撃があるって知ったのね！」"},
{"id": 121, "speaker": 18, "form": "dlg", "jp": "「それで、近々ゲーマーの攻撃があるって知ったんですね！」"},
{"id": 122, "speaker": 46, "form": "dlg", "jp": "「それ以外にもアナタのように『予知』のできるメンバーが\n　現在の事態を予知していましたから‥‥」"},
{"id": 123, "speaker": 35, "form": "dlg", "jp": "「ねえ‥‥」"},
{"id": 124, "speaker": 35, "form": "dlg", "jp": "「『ゲーマー』って本当にいるの？」"},
{"id": 125, "speaker": 35, "form": "dlg", "jp": "「オレが頭悪いだけかもしれないんだけど‥‥」"},
{"id": 126, "speaker": 35, "form": "dlg", "jp": "「今の話をまとめると」"},
{"id": 127, "speaker": 35, "form": "dlg", "jp": "「大昔の人が、\n　『天変地異』は『ゲーマーの仕業』だって言っていた」"},
{"id": 128, "speaker": 35, "form": "dlg", "jp": "「『天変地異』は誰かにコントロールされている」"},
{"id": 129, "speaker": 35, "form": "dlg", "jp": "「だから『天変地異』は『ゲーマー』の仕業\n　ってことだろう？」"},
{"id": 130, "speaker": 35, "form": "dlg", "jp": "「なんか、強引すぎないかな？」"},
{"id": 131, "speaker": 46, "form": "dlg", "jp": "「たしかにそうですが‥‥」"},
{"id": 132, "speaker": 46, "form": "dlg", "jp": "「現状を考えると、\n　『ゲーマー』の存在を認めざるをえないでしょう？」"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "「でも、さっきの『アカシックレコード』の映像の中でも\n　『ゲーマー』っぽい連中は映っていなかったよね‥‥」"},
{"id": 134, "speaker": 35, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「それにゲーマーの乗り物だと思ってた\n　『ＵＦＯ』も実はゲーマーの物ではなかった‥‥」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「松尾さんがゲーマーの存在を疑うのも当然かと‥‥」"},
{"id": 137, "speaker": 35, "form": "dlg", "jp": "「もしゲーマーが本当に\n　『ゲーム感覚』で破壊活動をしてるんなら」"},
{"id": 138, "speaker": 35, "form": "dlg", "jp": "「直接、自らの手で破壊するんじゃぁ？」"},
{"id": 139, "speaker": 46, "form": "dlg", "jp": "「ゴメンなさい、\n　私はゲームをしない人間なので‥‥」"},
{"id": 140, "speaker": 46, "form": "dlg", "jp": "「ゲームを楽しむ者の気持ちが良くわからないのです‥‥」"},
{"id": 141, "speaker": 31, "form": "dlg", "jp": "「でも『ゲーム好き』なんてそんなモンじゃないのか？」"},
{"id": 142, "speaker": 31, "form": "dlg", "jp": "「例えばオレなんかはスポーツは\n　実際にプレイしないと楽しくないと思うけど‥‥」"},
{"id": 143, "speaker": 31, "form": "dlg", "jp": "「テレビゲーム好きの連中って、スポーツも\n　テレビゲームですませちゃったりするじゃん！」"},
{"id": 144, "speaker": 31, "form": "dlg", "jp": "「あと、スポーツゲームでもユニフォームの\n　『水着』が何種類あるかを気にしたり‥‥」"},
{"id": 145, "speaker": 31, "form": "dlg", "jp": "「まあ、ゲーム好きな連中のことを\n　マトモに考えても仕方ないと思うぜ！」"},
{"id": 146, "speaker": 35, "form": "dlg", "jp": "「やっぱ、みんな『イクサ』についてはシロートだね‥‥」"},
{"id": 147, "speaker": 31, "form": "dlg", "jp": "「どう言う意味だよ！！」"},
{"id": 148, "speaker": 35, "form": "dlg", "jp": "「『敵』のことも良く知らないで\n　『イクサ』に勝てるワケないじゃないか！」"},
{"id": 149, "speaker": 35, "form": "dlg", "jp": "「『わからない！』とか『考えても仕方ない』とか、\n　それじゃあ戦う前から負けるに決まってるよ！」"},
{"id": 150, "speaker": 46, "form": "dlg", "jp": "「でも、私たちは本当に\n　『ゲーム好き』の気持ちがわからないのです‥‥」"},
{"id": 151, "speaker": 35, "form": "dlg", "jp": "「知能指数１３００でそんなコトを言ってちゃダメだよ！」"},
{"id": 152, "speaker": 35, "form": "dlg", "jp": "「自分たちでわからないんなら、\n　わかる人間を呼んでくればいいんじゃない？」"},
{"id": 153, "speaker": 46, "form": "dlg", "jp": "「それはそうですが‥‥」"},
{"id": 154, "speaker": 35, "form": "dlg", "jp": "「ゲーム好きのヤツなんて\n　そこら中にたくさんいると思うケド‥‥」"},
{"id": 155, "speaker": 35, "form": "dlg", "jp": "「どうなの？」"},
{"id": 156, "speaker": 15, "form": "dlg", "jp": "「私の知り合いにも１人いるわよ！」"},
{"id": 157, "speaker": 15, "form": "dlg", "jp": "「バカがつくほどの『ゲーム好き』が‥‥」"},
{"id": 158, "speaker": 16, "form": "dlg", "jp": "「アキラの知り合いにも１人いるわ！」"},
{"id": 159, "speaker": 16, "form": "dlg", "jp": "「キョーレツな『ゲーム好き』が‥‥」"},
{"id": 160, "speaker": 18, "form": "dlg", "jp": "「そういえば、私の同級生にも１人‥‥」"},
{"id": 161, "speaker": 18, "form": "dlg", "jp": "「すごい『ゲーム好き』が‥‥」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「それって、まさか‥‥」"},
{"id": 163, "speaker": 15, "form": "dlg", "jp": "「そう！！」"},
{"id": 164, "speaker": 15, "form": "dlg", "jp": "「『角川ツトム』よ！」"},
{"id": 165, "speaker": 15, "form": "dlg", "jp": "「私の知っている中で一番の『ゲーム好き』！」"},
{"id": 166, "speaker": 16, "form": "dlg", "jp": "「そうよ！」"},
{"id": 167, "speaker": 16, "form": "dlg", "jp": "「あの『角川ツトム』‥‥」"},
{"id": 168, "speaker": 16, "form": "dlg", "jp": "「あれは『天然記念物』クラスじゃないかしら？」"},
{"id": 169, "speaker": 16, "form": "dlg", "jp": "「あそこまでの『ゲーム好き』は\n　『ニホンカワウソ』より少ないと思うわよ！」"},
{"id": 170, "speaker": 18, "form": "dlg", "jp": "「そう！」"},
{"id": 171, "speaker": 18, "form": "dlg", "jp": "「『角川くん』‥‥」"},
{"id": 172, "speaker": 18, "form": "dlg", "jp": "「彼って恐いぐらい『ゲーム好き』じゃない！」"},
{"id": 173, "speaker": 46, "form": "dlg", "jp": "「アナタがたにはそんなスゴイ知人がいるのですか？」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「スゴイってただのおかしな中学生ですよ‥‥」"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "「別にテレポートやサイコキネシスは使えませんよ？」"},
{"id": 176, "speaker": 15, "form": "dlg", "jp": "「人の数百倍、『ゲームが好き』ってだけの\n　さえない『オタクくん』って感じ‥‥」"},
{"id": 177, "speaker": 16, "form": "dlg", "jp": "「人より数百倍『ゲームが好き』ってだけの\n　『オタクチュウボウ』‥‥」"},
{"id": 178, "speaker": 18, "form": "dlg", "jp": "「そうね、人より数百倍『ゲームが好き』なだけよね」"},
{"id": 179, "speaker": 46, "form": "dlg", "jp": "「『数百倍』？」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "「『数千倍』かも‥‥」"},
{"id": 181, "speaker": 31, "form": "dlg", "jp": "「ちょっと待てよ！」"},
{"id": 182, "speaker": 31, "form": "dlg", "jp": "「アリスの『知能指数１３００』ってのが、\n　普通の人間の１３倍なんだぞ！」"},
{"id": 183, "speaker": 31, "form": "dlg", "jp": "「『数百』、『数千倍』っていったら‥‥」"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「ものの例えだよ！」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "「まあ、それぐらい『ゲームが好き』ってこと‥‥」"},
{"id": 186, "speaker": 46, "form": "dlg", "jp": "「それはスバラシイ！！」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「多分、スバラシクないと思うよ‥‥」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「本当にただの変わった中学生なだけだから‥‥」"},
{"id": 189, "speaker": 29, "form": "dlg", "jp": "「ねえ、『ただの中学生』なの？\n　『変わった中学生』なの？」"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "「どっち？」"},
{"id": 191, "speaker": 15, "form": "dlg", "jp": "「間違いなく『変わった中学生』！！」"},
{"id": 192, "speaker": 16, "form": "dlg", "jp": "「世界遺産級の『変わった中学生』！！」"},
{"id": 193, "speaker": 18, "form": "dlg", "jp": "「まあ、『変わった中学生』じゃないかしら？」"},
{"id": 194, "speaker": 46, "form": "dlg", "jp": "「オモシロそうですね‥‥」"},
{"id": 195, "speaker": 46, "form": "dlg", "jp": "「その人物に会わせてもらえないでしょうか？」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「たぶん、簡単に会えると思うけど‥‥」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「会ってどうする気なの？」"},
{"id": 198, "speaker": 46, "form": "dlg", "jp": "「アスカの言う通り、\n　私たちは『ゲーマー』の情報が少なすぎます」"},
{"id": 199, "speaker": 46, "form": "dlg", "jp": "「『ゲーマー』と同じ『ゲーム好き』の人物の意見を聞けば\n　何か有益な情報にならないでしょうか？」"},
{"id": 200, "speaker": 46, "form": "dlg", "jp": "「ここには『テレポーテーション』を使える者や\n　『サイコキネシス』が使えるものは何人かいますが」"},
{"id": 201, "speaker": 46, "form": "dlg", "jp": "「そこまでの『ゲーム好き』は１人もおりません」"},
{"id": 202, "speaker": 46, "form": "dlg", "jp": "「かなり貴重な情報が手に入るかと‥‥」"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "「そこまで言うのなら‥‥」"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "「でも、会ってがっくりしないで！」"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "「松尾さん！」"},
{"id": 206, "speaker": 2, "form": "dlg", "jp": "「いっしょに『日本』に戻ってくれる？」"},
{"id": 207, "speaker": 35, "form": "dlg", "jp": "「ホイキタッ！」"},
{"id": 208, "speaker": 35, "form": "dlg", "jp": "「シュン！」"},
{"id": 209, "speaker": 35, "form": "dlg", "jp": "ボクは松尾さんといっしょに\n『ツトム』を連れてくるために日本へと向かった。"},
{"id": 210, "speaker": 35, "form": "dlg", "jp": "そして‥‥"}
]
