{"id": 55, "speaker": 2, "form": "dlg", "jp": "（ケネス！！）"},
{"id": 56, "speaker": 29, "form": "dlg", "jp": "（やっと声を出して驚かなくなったわね‥‥）"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "（みんなが集まるってことは何かあったの？）"},
{"id": 58, "speaker": 15, "form": "dlg", "jp": "（テレビ見てないの？）"},
{"id": 59, "speaker": 16, "form": "dlg", "jp": "（テレビ見てないの？）"},
{"id": 60, "speaker": 18, "form": "dlg", "jp": "（テレビ見てないの？）"},
{"id": 61, "speaker": 51, "form": "dlg", "jp": "（テレビ見てないの？）"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "（テレビ？）"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "（テレビがどうかしたの？）"},
{"id": 64, "speaker": 15, "form": "dlg", "jp": "（とにかくテレビつけてみて！）"},
{"id": 65, "speaker": 16, "form": "dlg", "jp": "（とにかくテレビつけてみて！）"},
{"id": 66, "speaker": 18, "form": "dlg", "jp": "（とにかくテレビつけてみて！）"},
{"id": 67, "speaker": 51, "form": "dlg", "jp": "（とにかくテレビつけてみぃ！）"},
{"id": 68, "speaker": 51, "form": "dlg", "jp": "ボクは言われるままにテレビのスイッチを入れた。"},
{"id": 69, "speaker": 51, "form": "dlg", "jp": "テレビには自衛隊の戦車を破壊する\nロボットの姿が映し出されていた。"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "（何これ？）"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "（こんな時間に『映画』？）"},
{"id": 72, "speaker": 31, "form": "dlg", "jp": "（ニュースだよ‥‥）"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "（ニュース！？）"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "（これが！？）"},
{"id": 75, "speaker": 29, "form": "dlg", "jp": "（『自衛隊』の『秘密兵器』だって‥‥）"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "（『自衛隊』の？）"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "（じゃあどうして自衛隊の戦車を！？）"},
{"id": 78, "speaker": 29, "form": "dlg", "jp": "（『暴走』してるのよ！）"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "（まさかっ！）"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "（『クリエーターの仕業』！？）"},
{"id": 81, "speaker": 29, "form": "dlg", "jp": "（間違いないわね‥‥）"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "（単なる誤作動って可能性は？）"},
{"id": 83, "speaker": 31, "form": "dlg", "jp": "（ありえないな‥‥）"},
{"id": 84, "speaker": 31, "form": "dlg", "jp": "（こうやってテレビで『新兵器』の発表を\n　報道させてるぐらいだから）"},
{"id": 85, "speaker": 31, "form": "dlg", "jp": "（簡単に誤作動なんてしない、\n　自信があったんだろうし‥‥）"},
{"id": 86, "speaker": 15, "form": "dlg", "jp": "（フツー報道規制されるわね‥‥）"},
{"id": 87, "speaker": 16, "form": "dlg", "jp": "（フツー報道規制されるわね‥‥）"},
{"id": 88, "speaker": 18, "form": "dlg", "jp": "（フツー報道規制されるわね‥‥）"},
{"id": 89, "speaker": 51, "form": "dlg", "jp": "（フツー報道規制されるやろ‥‥）"},
{"id": 90, "speaker": 44, "form": "dlg", "jp": "「大変なことになりました！！」"},
{"id": 91, "speaker": 44, "form": "dlg", "jp": "「従来の自衛隊の戦力ではあの『歩行戦車』を\n　制止することは難しそうです！！」"},
{"id": 92, "speaker": 1, "form": "dlg", "jp": "「現在、避難勧告が出ているのは\n　次の市町村です‥‥」"},
{"id": 93, "speaker": 1, "form": "dlg", "jp": "「『◯森町』、『□山町』、『×大町』‥‥」"},
{"id": 94, "speaker": 1, "form": "dlg", "jp": "「『◯武村』、『□藤町』、『×洋町』、『□平町』‥‥」"},
{"id": 95, "speaker": 31, "form": "dlg", "jp": "（このままだと、スゴイ被害がでそうだな‥‥）"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "（そ、そうだね‥‥）"},
{"id": 97, "speaker": 31, "form": "dlg", "jp": "（どうする？）"},
{"id": 98, "speaker": 31, "form": "dlg", "jp": "（このまま放っておくのか？）"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "（しかたないわね‥‥）"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "（ケネス、車出してくれる？）"},
{"id": 102, "speaker": 15, "form": "dlg", "jp": "（アレを止めに行くのね！！）"},
{"id": 103, "speaker": 16, "form": "dlg", "jp": "（アレを止めに行くのね！！）"},
{"id": 104, "speaker": 18, "form": "dlg", "jp": "（アレを止めに行くのね！！）"},
{"id": 105, "speaker": 51, "form": "dlg", "jp": "（アレを止めに行くんやね！！）"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "（違うわ！）"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "（たぶん、止めることは出来ないわね‥‥）"},
{"id": 108, "speaker": 29, "form": "dlg", "jp": "（『クリエーター』が動かしてるんだから‥‥）"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "（そんな、やってみないとわからないだろう？）"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "（わかるわよ！）"},
{"id": 111, "speaker": 29, "form": "dlg", "jp": "（ただ‥‥）"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "（壊すことはできるかも‥‥）"},
{"id": 113, "speaker": 15, "form": "dlg", "jp": "（どういうこと？）"},
{"id": 114, "speaker": 16, "form": "dlg", "jp": "（どういうこと？）"},
{"id": 115, "speaker": 18, "form": "dlg", "jp": "（どういうこと？）"},
{"id": 116, "speaker": 51, "form": "dlg", "jp": "（どういうこと？）"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "（アレをとめるには、\n　『壊す』か『燃料切れを待つ』しかないのよ‥‥）"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "（ハァ？）"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "（あのロボットは『クリエーター』に操られてるだけなの）"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "（つまり、クリエーターがコントロールしているだけで\n　クリエーターが動かしているわけじゃないの！）"},
{"id": 121, "speaker": 29, "form": "dlg", "jp": "（だから、燃料が切れたら、\n　クリエーターがどんなに操ろうとしても動かないし）"},
{"id": 122, "speaker": 29, "form": "dlg", "jp": "（また、それ自体がこわれた場合も動かしようがないの‥‥）"},
{"id": 123, "speaker": 31, "form": "dlg", "jp": "（その話が本当なら‥‥）"},
{"id": 124, "speaker": 31, "form": "dlg", "jp": "（『燃料切れ』を待った方がいいんじゃないか？）"},
{"id": 125, "speaker": 29, "form": "dlg", "jp": "（で、アレの燃料はいつ切れるの？）"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "（それ以前にアレの燃料はなんなの？）"},
{"id": 127, "speaker": 31, "form": "dlg", "jp": "（ムムムムム‥‥）"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "（くだらないこと言ってないで、早く車の用意を！！）"},
{"id": 129, "speaker": 15, "form": "dlg", "jp": "（ちょっとアレ見て！！）"},
{"id": 130, "speaker": 16, "form": "dlg", "jp": "（ちょっとアレ見て！！）"},
{"id": 131, "speaker": 18, "form": "dlg", "jp": "（ちょっとアレ見て！！）"},
{"id": 132, "speaker": 51, "form": "dlg", "jp": "（ちょっとアレ見て！！）"},
{"id": 133, "speaker": 44, "form": "dlg", "jp": "「『歩行戦車』が町の方へ進み始めました」"},
{"id": 134, "speaker": 44, "form": "dlg", "jp": "「自衛隊の発表では、\n　約４０分で一番近い町に到着する予定です」"},
{"id": 135, "speaker": 29, "form": "dlg", "jp": "（やな展開になってきたわね‥‥）"},
{"id": 136, "speaker": 29, "form": "dlg", "jp": "（ケネス、４０分で現地に行ける？）"},
{"id": 137, "speaker": 31, "form": "dlg", "jp": "（ムチャ言うなよ！！）"},
{"id": 138, "speaker": 31, "form": "dlg", "jp": "（どうがんばっても１時間は‥‥）"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "（たぶん、交通規制もされてるだろうから、\n　すんなり現場に行けるかどうかも‥‥）"},
{"id": 140, "speaker": 29, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 141, "speaker": 29, "form": "choice", "jp": "（それでも行くしか‥‥）"},
{"id": 142, "speaker": 29, "form": "choice", "jp": "（先に仲間探しをするとか‥‥）"},
{"id": 143, "speaker": 29, "form": "choice", "jp": "（やっぱり、燃料切れを待つしか‥‥）"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "（それでも行くしか‥‥）"},
{"id": 145, "speaker": 29, "form": "dlg", "jp": "（イチかバチかね‥‥）"},
{"id": 146, "speaker": 29, "form": "dlg", "jp": "こうしてボクたちは\n交通規制のされている中、"},
{"id": 147, "speaker": 29, "form": "dlg", "jp": "ケネスの運転する車に乗って、\n現場へと向かった‥‥"},
{"id": 148, "speaker": 29, "form": "dlg", "jp": "しかし‥‥"},
{"id": 149, "speaker": 29, "form": "dlg", "jp": "車は渋滞に巻き込まれてしまい、\n身動きの取れない状態が２時間続いた。"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "ロボットは町を破壊しつつ、\n『原子力発電所』へと向かった。"},
{"id": 151, "speaker": 29, "form": "dlg", "jp": "そして‥‥"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "ボクたち人類は『全滅』した‥‥"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "（やっぱり、燃料切れを待つしか‥‥）"},
{"id": 154, "speaker": 29, "form": "dlg", "jp": "（イチかバチかね‥‥）"},
{"id": 155, "speaker": 29, "form": "dlg", "jp": "こうしてボクたちは\nあのロボットの燃料切れを待つことにした。"},
{"id": 156, "speaker": 29, "form": "dlg", "jp": "もし、短時間で燃料が切れなかった場合は\nボクたちは大きなダメージを受けるだろう‥‥"},
{"id": 157, "speaker": 29, "form": "dlg", "jp": "ロボットは町を破壊しつつ、\n『原子力発電所』へと向かった。"},
{"id": 158, "speaker": 29, "form": "dlg", "jp": "そして‥‥"},
{"id": 159, "speaker": 29, "form": "dlg", "jp": "ボクたち人類は『全滅』した‥‥"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "（先に仲間探しをするとか‥‥）"},
{"id": 161, "speaker": 29, "form": "dlg", "jp": "（何言ってるの！！）"},
{"id": 162, "speaker": 29, "form": "dlg", "jp": "（そんな場合じゃないでしょう？）"},
{"id": 163, "speaker": 15, "form": "dlg", "jp": "（ナゴムちゃん！）"},
{"id": 164, "speaker": 15, "form": "dlg", "jp": "（正気なの！？）"},
{"id": 165, "speaker": 16, "form": "dlg", "jp": "（常光寺くん！）"},
{"id": 166, "speaker": 16, "form": "dlg", "jp": "（正気なの！？）"},
{"id": 167, "speaker": 18, "form": "dlg", "jp": "（常光寺くん！）"},
{"id": 168, "speaker": 18, "form": "dlg", "jp": "（正気！？）"},
{"id": 169, "speaker": 51, "form": "dlg", "jp": "（常光寺ぃ！）"},
{"id": 170, "speaker": 51, "form": "dlg", "jp": "（正気か！？）"},
{"id": 171, "speaker": 31, "form": "dlg", "jp": "（現時点で『新しい仲間』のことなんて\n　どうでもいいだろう！）"},
{"id": 172, "speaker": 31, "form": "dlg", "jp": "（あと４０分で大勢の人が死ぬって言う時に、\n　『仲間探し』なんて！！）"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "（『あと４０分』しかないんだろう？）"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "（『あと４０分』で\n　ボクたちがあのロボットを止められる可能性はない‥‥）"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "（でも‥‥）"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "（でも、『あと４０分』で\n　『テレポーター』が見つかる可能性はあるんじゃあ？）"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "（昨日言ってた残りの仲間って、\n　『テレポーター』なんだろう？）"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "（『テレポーター』なら‥‥）"},
{"id": 179, "speaker": 29, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥！！）"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "（『瞬間移動』の能力があるのなら、\n　４０分もかからずに現地に行けるだろう？）"},
{"id": 181, "speaker": 15, "form": "dlg", "jp": "（ナゴムちゃん、天才！！）"},
{"id": 182, "speaker": 16, "form": "dlg", "jp": "（常光寺くん、スゴイ！）"},
{"id": 183, "speaker": 18, "form": "dlg", "jp": "（たしかにその通りね！）"},
{"id": 184, "speaker": 51, "form": "dlg", "jp": "（常光寺ぃ！）"},
{"id": 185, "speaker": 51, "form": "dlg", "jp": "（オマエ天才！！）"},
{"id": 186, "speaker": 31, "form": "dlg", "jp": "（言うのは簡単だけど、\n　実際そんなに簡単ならとっくに見つかってるだろう？）"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "（そうなんだけど‥‥）"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "（例えば‥‥）"},
{"id": 189, "speaker": 2, "form": "choice", "jp": "（手紙で返事をもらうとか？）"},
{"id": 190, "speaker": 2, "form": "choice", "jp": "（電話をかけてきてもらうってのは？）"},
{"id": 191, "speaker": 2, "form": "choice", "jp": "（本部に探してもらうとか？）"},
{"id": 192, "speaker": 2, "form": "dlg", "jp": "（本部に探してもらうとか？）"},
{"id": 193, "speaker": 31, "form": "dlg", "jp": "（ハァ？）"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "（だって、昨日のジーンの話なら、\n　相手にテレパシーが届いてるかもしれないんだろう？）"},
{"id": 195, "speaker": 2, "form": "dlg", "jp": "（テレパシーが届いてるなら、\n　そこで能力を使ってくれって伝えておけば‥‥）"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "（その能力のイメージを本部がキャッチして\n　その人の居場所がわかるんじゃぁ‥‥）"},
{"id": 197, "speaker": 31, "form": "dlg", "jp": "（昨日も言ったけど、\n　確実にイメージをキャッチできる保証はないんだよ）"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "（じゃあ‥‥）"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "（手紙で返事をもらうとか？）"},
{"id": 200, "speaker": 31, "form": "dlg", "jp": "（ハァ？）"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "（だって、昨日のジーンの話なら、\n　相手にテレパシーが届いてるかもしれないんだろう？）"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "（テレパシーが届いてるなら、\n　手紙で居場所を教えてくれって伝えて‥‥）"},
{"id": 203, "speaker": 31, "form": "dlg", "jp": "（返事が届くのは何時間後だよ！）"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "（じゃあ‥‥）"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "（電話をかけてきてもらうってのは？）"},
{"id": 206, "speaker": 31, "form": "dlg", "jp": "（ハァ？）"},
{"id": 207, "speaker": 31, "form": "dlg", "jp": "（何言い出すんだよ！）"},
{"id": 208, "speaker": 2, "form": "dlg", "jp": "（だって、昨日のジーンの話なら、\n　相手にテレパシーが届いてるかもしれないんだろう？）"},
{"id": 209, "speaker": 29, "form": "dlg", "jp": "（そうだと思うんだけど‥‥）"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "（ならコッチの電話番号を教えて‥‥）"},
{"id": 211, "speaker": 29, "form": "dlg", "jp": "（なるほど！！）"},
{"id": 212, "speaker": 29, "form": "dlg", "jp": "（それなら、『テレパシー』が弱くても、\n　私たちと連絡を取ることができるわね！！）"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "（だろう？）"},
{"id": 214, "speaker": 29, "form": "dlg", "jp": "（さっそくやってみるわ！）"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "（お願い！！）"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "こうしてジーンは近くにいるハズの『仲間』に\nコチラの電話番号を伝えるため"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "テレパシーを送った。"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "「ピリリリリ‥‥」"},
{"id": 220, "speaker": 31, "form": "dlg", "jp": "（来たぁ！？）"},
{"id": 221, "speaker": 31, "form": "dlg", "jp": "「ピリリリリ‥‥」"},
{"id": 222, "speaker": 31, "form": "dlg", "jp": "「ピッ！」"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "「もしもし‥‥！！」"},
{"id": 224, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 225, "speaker": 4, "form": "dlg", "jp": "（だ、誰ぇ？）"},
{"id": 226, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「あの‥‥」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「『テレパシー』を送った‥‥」"},
{"id": 229, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 230, "speaker": 4, "form": "dlg", "jp": "（キ、キミが！？）"},
{"id": 231, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 232, "speaker": 29, "form": "dlg", "jp": "（送ったのは私よ‥‥）"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "（事情は『テレパシー』で伝えたとおりよ‥‥）"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「とりあえず、ボクたちアナタと‥‥」"},
{"id": 235, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 236, "speaker": 4, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥）"},
{"id": 237, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 238, "speaker": 4, "form": "dlg", "jp": "『テレポーターさん』はジーンの『テレパシー』で\nだいたいの事情は理解してくれているらしい‥‥"},
{"id": 239, "speaker": 4, "form": "dlg", "jp": "ただ‥‥"},
{"id": 240, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 241, "speaker": 4, "form": "dlg", "jp": "（たしかにオレ、瞬間移動はできるんだけど‥‥）"},
{"id": 242, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「じゃあ今すぐここに来てくれませんか？」"},
{"id": 244, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 245, "speaker": 4, "form": "dlg", "jp": "（ダメなんだ‥‥）"},
{"id": 246, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "「どうして！？」"},
{"id": 248, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 249, "speaker": 4, "form": "dlg", "jp": "（オレ、『イメージ』できない場所には‥‥）"},
{"id": 250, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 251, "speaker": 4, "form": "dlg", "jp": "どうやら、『イメージ出来ない場所』には\n瞬間移動することはできないらしい‥‥"},
{"id": 252, "speaker": 29, "form": "dlg", "jp": "（しかたないわね！！）"},
{"id": 253, "speaker": 29, "form": "dlg", "jp": "（じゃあ、むかえに行ってあげるわ！）"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "こうしては『テレポーターさん』をむかえに\n駅前まで行くことになった。"},
{"id": 255, "speaker": 29, "form": "dlg", "jp": "そして‥‥"},
{"id": 256, "speaker": 29, "form": "dlg", "jp": "失敗の原因はあきらめたこと‥‥\nすでに答えはわかっているハズ！！"},
{"id": 257, "speaker": 29, "form": "dlg", "jp": "失敗の原因はあきらめたこと‥‥\nすでに答えはわかっているハズ！！"}
]
