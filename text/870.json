[
{"id": 0, "speaker": null, "form": "dlg", "jp": "『シロー』を名乗る清田さんは説明を始めた。"},
{"id": 1, "speaker": 48, "form": "dlg", "jp": "「まず、わかってもらいたいのが、\n　本当のボクには『体』がないってことです」"},
{"id": 2, "speaker": 48, "form": "dlg", "jp": "「人間のみなさんのように、\n　肉体に宿った精神ではなく」"},
{"id": 3, "speaker": 48, "form": "dlg", "jp": "「精神のみで産まれてきたということを‥‥」"},
{"id": 4, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 5, "speaker": 29, "form": "dlg", "jp": "「アナタが本当にその人工知能かどうか\n　テストさせてもらうわよ」"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "「アナタの産まれた場所はどこなの？」"},
{"id": 7, "speaker": 48, "form": "dlg", "jp": "「それを答えるのは難しいですね‥‥」"},
{"id": 8, "speaker": 48, "form": "dlg", "jp": "「ボクは段階的に作られたものですから‥‥」"},
{"id": 9, "speaker": 48, "form": "dlg", "jp": "「ボクの元となったものは、\n　リツコの大学のコンピュータにあったようです」"},
{"id": 10, "speaker": 48, "form": "dlg", "jp": "「そのあと、ボクの基本部分が\n　リツコのノートパソコンの中で作られました」"},
{"id": 11, "speaker": 48, "form": "dlg", "jp": "「今のボクが完成したのは、\n　ココの１階の研究室のパソコンの中ですが‥‥」"},
{"id": 12, "speaker": 29, "form": "dlg", "jp": "「どうなのナゴム？」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「詳しくはわからないけど‥‥」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「姉さん、どうなの？」"},
{"id": 15, "speaker": 3, "form": "dlg", "jp": "「話はよく理解できないけど‥‥」"},
{"id": 16, "speaker": 3, "form": "dlg", "jp": "「『シロー』の話をしているのなら彼の言う通りよ！」"},
{"id": 17, "speaker": 31, "form": "dlg", "jp": "「そのことを清田って人やゴトウは？」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「知らないだろうね」"},
{"id": 19, "speaker": 48, "form": "dlg", "jp": "「だから、警察に保管されてた体も\n　実はボクの体ではないんです」"},
{"id": 20, "speaker": 48, "form": "dlg", "jp": "「ボクは肉体のないまま、\n　ずっとリツコとナゴムを見守ってきました」"},
{"id": 21, "speaker": 31, "form": "dlg", "jp": "「なんでそんなことするんだ？」"},
{"id": 22, "speaker": 48, "form": "dlg", "jp": "「ボクは２人を守るように命令されている！」"},
{"id": 23, "speaker": 29, "form": "dlg", "jp": "「‥‥で？」"},
{"id": 24, "speaker": 48, "form": "dlg", "jp": "「ボクは、ナゴムを見守っているうちに\n　アナタたちの存在を知りました」"},
{"id": 25, "speaker": 31, "form": "dlg", "jp": "「米軍の軍事衛星からか！？」"},
{"id": 26, "speaker": 29, "form": "dlg", "jp": "「ウワサでは\n　地上の新聞の文字が読める程って話だしね」"},
{"id": 27, "speaker": 48, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 28, "speaker": 29, "form": "dlg", "jp": "「なるほどね‥‥」"},
{"id": 29, "speaker": 51, "form": "dlg", "jp": "「なるほどやないやろう！！」"},
{"id": 30, "speaker": 51, "form": "dlg", "jp": "「ノリツッコミのつもりか？」"},
{"id": 31, "speaker": 51, "form": "dlg", "jp": "「そんなんじゃ、全然笑われへんで！！」"},
{"id": 32, "speaker": 51, "form": "dlg", "jp": "「だいたい、なんで人工知能さんが\n　清田さんの姿をしているんや！」"},
{"id": 33, "speaker": 15, "form": "dlg", "jp": "「なんか、なるほどって納得できるような話じゃ\n　なさそうだけど？」"},
{"id": 34, "speaker": 15, "form": "dlg", "jp": "「あと、その人工知能さんが\n　清田さんの姿をしている理由も‥‥」"},
{"id": 35, "speaker": 16, "form": "dlg", "jp": "「なるほどって納得できるような話？」"},
{"id": 36, "speaker": 16, "form": "dlg", "jp": "「アキラにはぜんぜん理解できないんだけど」"},
{"id": 37, "speaker": 16, "form": "dlg", "jp": "「あと、その人工知能さんが\n　清田さんの姿をしている理由も‥‥」"},
{"id": 38, "speaker": 18, "form": "dlg", "jp": "「で、どうして『シローさん』が\n　『清田さん』の姿を？」"},
{"id": 39, "speaker": 48, "form": "dlg", "jp": "「それはグウゼンなんです‥‥」"},
{"id": 40, "speaker": 48, "form": "dlg", "jp": "「ボクはアナタたちの話を聞いていて\n　自分がこのままでは危ないと思っていました」"},
{"id": 41, "speaker": 29, "form": "dlg", "jp": "「危ない？」"},
{"id": 42, "speaker": 48, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 43, "speaker": 48, "form": "dlg", "jp": "「アナタたちが戦おうとしている『敵』は\n　人間以外の全てのものをコントロールできる」"},
{"id": 44, "speaker": 48, "form": "dlg", "jp": "「つまり、『機械』の中にいたら\n　あのように‥‥」"},
{"id": 45, "speaker": 48, "form": "dlg", "jp": "シローはテレビのブラウン管を指さした。"},
{"id": 46, "speaker": 48, "form": "dlg", "jp": "「バキューン！」"},
{"id": 47, "speaker": 48, "form": "dlg", "jp": "ニュース映像に写し出されていた方の『シロー』が\nバタリと倒れた。"},
{"id": 48, "speaker": 44, "form": "dlg", "jp": "「今、たった今‥‥」"},
{"id": 49, "speaker": 44, "form": "dlg", "jp": "「警察の狙撃部隊によって、\n　アンドロイドのバッテリーが破壊されました！」"},
{"id": 50, "speaker": 48, "form": "dlg", "jp": "「つまり、機械の中に入れば、\n　ボクもコントロールされる可能性がある！」"},
{"id": 51, "speaker": 48, "form": "dlg", "jp": "「そのことを思いなやんでいたある日、\n　この体の前の持ち主のことを知ったんです‥‥」"},
{"id": 52, "speaker": 48, "form": "dlg", "jp": "「この体の前の持ち主の精神は\n　あのゴトウによってボロボロにされてしまいました」"},
{"id": 53, "speaker": 48, "form": "dlg", "jp": "「あのまま放置しておけば、\n　間違いなく肉体もくちてしまうことに‥‥」"},
{"id": 54, "speaker": 48, "form": "dlg", "jp": "「だからこの肉体を保存するためにも‥‥」"},
{"id": 55, "speaker": 31, "form": "dlg", "jp": "「体をうばったってことか？」"},
{"id": 56, "speaker": 48, "form": "dlg", "jp": "「うばったというよりは、\n　お互いを補いあったと‥‥」"},
{"id": 57, "speaker": 48, "form": "dlg", "jp": "「『清田ユウリ』の精神のほとんどは\n　破壊されていましたが」"},
{"id": 58, "speaker": 48, "form": "dlg", "jp": "「すべてが破壊されたわけではありません‥‥」"},
{"id": 59, "speaker": 48, "form": "dlg", "jp": "「彼の意志の『もっとも強い部分』は\n　破壊されずに残っていました」"},
{"id": 60, "speaker": 31, "form": "dlg", "jp": "「なんなんだよ、\n　その『もっとも強い部分』って‥‥」"},
{"id": 61, "speaker": 48, "form": "dlg", "jp": "「『妹を思う気持ち』です‥‥」"},
{"id": 62, "speaker": 48, "form": "dlg", "jp": "「あのままでは、この肉体は\n　間違いなくくちてしまったでしょう‥‥」"},
{"id": 63, "speaker": 48, "form": "dlg", "jp": "「そうなれば、\n　幼いマイちゃんを１人にしてしまうことに‥‥」"},
{"id": 64, "speaker": 48, "form": "dlg", "jp": "「だから、マイちゃんを守ることを条件に\n　この肉体を提供してくれたんです」"},
{"id": 65, "speaker": 31, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 66, "speaker": 31, "form": "dlg", "jp": "「で、どうやればそんなことができるんだよ！？」"},
{"id": 67, "speaker": 48, "form": "dlg", "jp": "「それは‥‥」"},
{"id": 68, "speaker": 48, "form": "dlg", "jp": "「ちょうど、彼の精神が\n　ゴトウという人にこわされた時‥‥」"},
{"id": 69, "speaker": 48, "form": "dlg", "jp": "「この体が偶然にも\n　あの機械とつながっていたから‥‥」"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "「そうか、あの機械を使って、\n　清田さんの脳に転送したんだ！！」"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "「あの機械は脳の中の情報を\n　出し入れする機械だったから‥‥」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "「それなら、どうして今まで姿を隠してたの？」"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 74, "speaker": 29, "form": "dlg", "jp": "「私の能力でも見つからなかったってことは\n　『変装』までしてたんでしょう？」"},
{"id": 75, "speaker": 48, "form": "dlg", "jp": "「それは‥‥」"},
{"id": 76, "speaker": 48, "form": "dlg", "jp": "「マイちゃんのためです‥‥」"},
{"id": 77, "speaker": 31, "form": "dlg", "jp": "「行方をくらます方が\n　マイちゃんが心配するだろ？」"},
{"id": 78, "speaker": 48, "form": "dlg", "jp": "「ですが、今のボクが彼女の前に出て行っても\n　彼女は混乱するハズです‥‥」"},
{"id": 79, "speaker": 48, "form": "dlg", "jp": "「だから、彼の記憶の断片と\n　ボクの意識が完全に融合し」"},
{"id": 80, "speaker": 48, "form": "dlg", "jp": "「『マイちゃんの兄』として振る舞えるようになるまで\n　身を隠しておこうと‥‥」"},
{"id": 81, "speaker": 31, "form": "dlg", "jp": "「なんだか\n　わかったようなわかんないような話だな‥‥」"},
{"id": 82, "speaker": 3, "form": "dlg", "jp": "「信じてあげて下さい！！」"},
{"id": 83, "speaker": 3, "form": "dlg", "jp": "「彼は間違いなく『シロー』です！」"},
{"id": 84, "speaker": 5, "form": "dlg", "jp": "「リツコ‥‥」"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "「姉さん‥‥」"},
{"id": 86, "speaker": 29, "form": "dlg", "jp": "「まあいいわ‥‥」"},
{"id": 87, "speaker": 29, "form": "dlg", "jp": "「信じてあげましょう‥‥」"},
{"id": 88, "speaker": 31, "form": "dlg", "jp": "「オイ！」"},
{"id": 89, "speaker": 31, "form": "dlg", "jp": "「信じるのかよ！」"},
{"id": 90, "speaker": 29, "form": "dlg", "jp": "「彼がゴトウじゃないのは間違いないわ！」"},
{"id": 91, "speaker": 31, "form": "dlg", "jp": "「ホントかよ？」"},
{"id": 92, "speaker": 29, "form": "dlg", "jp": "「ええ、彼には超能力者の反応がないわ‥‥」"},
{"id": 93, "speaker": 35, "form": "dlg", "jp": "「ちょっと待ってよ！」"},
{"id": 94, "speaker": 35, "form": "dlg", "jp": "「超能力者以外に\n　オレたちのこと知られちゃいけないんじゃぁ？」"},
{"id": 95, "speaker": 35, "form": "dlg", "jp": "「確か、知った人間も知られた人間も\n　死なないといけないんじゃぁ？」"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "「その通りよ！」"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "「『超能力者以外の人間』に知られたら、\n　死ななくちゃいけないわよ！」"},
{"id": 98, "speaker": 35, "form": "dlg", "jp": "「じゃあ、オレたちも！？」"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "「人の話をちゃんと聞きなさい！！」"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "「『人間』に知られちゃいけないだけで、\n　彼は人間じゃないじゃない‥‥」"},
{"id": 101, "speaker": 35, "form": "dlg", "jp": "「何それ？」"},
{"id": 102, "speaker": 35, "form": "dlg", "jp": "「そんな言い訳ありなの？」"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "「言い訳じゃないわよ！」"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "「ルールよ！！」"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "「そんなことより‥‥」"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "「ゴトウが復讐しに来たんじゃないとしたら\n　いったい何しに来たの？」"},
{"id": 107, "speaker": 5, "form": "dlg", "jp": "「ボクも仲間にいれてもらえませんか？」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "「‥‥！！」"},
{"id": 109, "speaker": 29, "form": "dlg", "jp": "「ダメよ！　私たちは超能力者集団なの！！」"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "「超能力者以外は、そう簡単に仲間にできないわ！」"},
{"id": 111, "speaker": 5, "form": "dlg", "jp": "「そうですけど‥‥」"},
{"id": 112, "speaker": 5, "form": "dlg", "jp": "「なんかお手伝いできることはないでしょうか？」"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "「じゃあ、１つお願いがあるわ！」"},
{"id": 115, "speaker": 5, "form": "dlg", "jp": "「なんでも言ってください」"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "「私たちのことを誰にも言わないで！！」"},
{"id": 117, "speaker": 5, "form": "dlg", "jp": "「わかりました」"},
{"id": 118, "speaker": 31, "form": "dlg", "jp": "「オイオイ！」"},
{"id": 119, "speaker": 31, "form": "dlg", "jp": "「そんな口約束だけで大丈夫なのかよ！」"},
{"id": 120, "speaker": 5, "form": "dlg", "jp": "「大丈夫です」"},
{"id": 121, "speaker": 5, "form": "dlg", "jp": "「ボクは人間とちがってウソをついたり\n　約束をやぶったりはできません」"},
{"id": 122, "speaker": 29, "form": "dlg", "jp": "「だって‥‥」"},
{"id": 123, "speaker": 5, "form": "dlg", "jp": "「他に何か？」"},
{"id": 124, "speaker": 29, "form": "dlg", "jp": "「ニブイわね‥‥」"},
{"id": 125, "speaker": 29, "form": "dlg", "jp": "「何もないってことよ！」"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "「とにかく、\n　誰でもがどうにかできることじゃないの」"},
{"id": 127, "speaker": 29, "form": "dlg", "jp": "「さっさと帰ってくれる？」"},
{"id": 128, "speaker": 51, "form": "dlg", "jp": "「なんかちょっとかわいそうやな‥‥」"},
{"id": 129, "speaker": 29, "form": "dlg", "jp": "「そういう感情は危険よ！」"},
{"id": 130, "speaker": 51, "form": "dlg", "jp": "「冷たいオンナやなぁ‥‥」"},
{"id": 131, "speaker": 15, "form": "dlg", "jp": "「なんかちょっとかわいそうね‥‥」"},
{"id": 132, "speaker": 29, "form": "dlg", "jp": "「そういう感情は危険よ！」"},
{"id": 133, "speaker": 15, "form": "dlg", "jp": "「ケド‥‥」"},
{"id": 134, "speaker": 16, "form": "dlg", "jp": "「なんかちょっとかわいそうね‥‥」"},
{"id": 135, "speaker": 29, "form": "dlg", "jp": "「そういう感情は危険よ！」"},
{"id": 136, "speaker": 16, "form": "dlg", "jp": "「ケド‥‥」"},
{"id": 137, "speaker": 18, "form": "dlg", "jp": "「なんかちょっとかわいそうね‥‥」"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "「そういう感情は危険よ！」"},
{"id": 139, "speaker": 18, "form": "dlg", "jp": "「ケド‥‥」"},
{"id": 140, "speaker": 35, "form": "dlg", "jp": "「ちょっといいかな？」"},
{"id": 141, "speaker": 35, "form": "dlg", "jp": "「そんなことより、\n　スゴイことになってるみたいなんだけど」"},
{"id": 142, "speaker": 35, "form": "dlg", "jp": "「テレビ‥‥」"},
{"id": 143, "speaker": 29, "form": "dlg", "jp": "「テレビ‥‥！？」"},
{"id": 144, "speaker": 29, "form": "dlg", "jp": "ボクたちはいっせいに\nテレビに注目した。"},
{"id": 145, "speaker": 0, "form": "dlg", "jp": "「では、もう一度現場に戻します」"},
{"id": 146, "speaker": 44, "form": "dlg", "jp": "「はい、ごらんください‥‥」"},
{"id": 147, "speaker": 44, "form": "dlg", "jp": "「私、正直言ってコウフンしております」"},
{"id": 148, "speaker": 44, "form": "dlg", "jp": "「このような場面に出会えたこと\n　神さまに感謝したいと思っています」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「ＵＦＯ？？」"},
{"id": 150, "speaker": 15, "form": "dlg", "jp": "「まさか、『クリエーター』！？」"},
{"id": 151, "speaker": 16, "form": "dlg", "jp": "「まさか、『クリエーター』！？」"},
{"id": 152, "speaker": 18, "form": "dlg", "jp": "「まさか、『クリエーター』！？」"},
{"id": 153, "speaker": 51, "form": "dlg", "jp": "「まさか、『クリエーター』！？」"},
{"id": 154, "speaker": 44, "form": "dlg", "jp": "「いったい、なんの目的でこの地球に、\n　さらには日本にやってきたのでしょうか？」"},
{"id": 155, "speaker": 44, "form": "dlg", "jp": "「友好を結びに、それとも侵略に、\n　それともただの観光でしょうか？」"},
{"id": 156, "speaker": 1, "form": "dlg", "jp": "「ただいま、政府からアナウンスがありました」"},
{"id": 157, "speaker": 1, "form": "dlg", "jp": "「このＵＦＯさわぎにより、\n　渋滞の心配がある‥‥」"},
{"id": 158, "speaker": 1, "form": "dlg", "jp": "「Ａ号線、Ｂ号線は現在封鎖されております」"},
{"id": 159, "speaker": 1, "form": "dlg", "jp": "「また、近隣の住民の方は、\n　万一の場合にそなえ‥‥」"},
{"id": 160, "speaker": 1, "form": "dlg", "jp": "「外出を控えてください‥‥」"},
{"id": 161, "speaker": 35, "form": "dlg", "jp": "「今日はいったいどうなってるんだ？」"},
{"id": 162, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥」"},
{"id": 163, "speaker": 29, "form": "dlg", "jp": "ジーンの表情が暗くなった。"},
{"id": 164, "speaker": 29, "form": "choice", "jp": "（もしかして、コレも『クリエーター』の仕業？）"},
{"id": 165, "speaker": 29, "form": "choice", "jp": "（もしかして、コレが『米軍の秘密兵器』だとか？）"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "（もしかして、コレも『クリエーター』の仕業？）"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "（そんなバカな‥‥）"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "（もしかして、コレが『米軍の秘密兵器』だとか）"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "（そんなバカな‥‥）"},
{"id": 170, "speaker": 31, "form": "dlg", "jp": "「ジーン‥‥‥」"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「どうしたんだい？"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "２人とも‥‥」"},
{"id": 174, "speaker": 35, "form": "dlg", "jp": "「まさか、あのＵＦＯが『クリエーター』の乗り物とか？」"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "「その方がまだよかったわ‥‥」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「いったいどういうこと？」"},
{"id": 177, "speaker": 29, "form": "dlg", "jp": "「『あのＵＦＯ』は\n　『クリエーターの乗り物じゃない』ってことよ！」"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「じゃあ？」"},
{"id": 179, "speaker": 35, "form": "dlg", "jp": "「やっぱり『宇宙人』の？」"},
{"id": 180, "speaker": 31, "form": "dlg", "jp": "「違うよ！」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「じゃあ、なんなんだよ！」"},
{"id": 182, "speaker": 29, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』の『秘密兵器』よ‥‥」"},
{"id": 183, "speaker": 35, "form": "dlg", "jp": "「ふ～～ん‥‥」"},
{"id": 184, "speaker": 35, "form": "dlg", "jp": "「でも、テレビに映っちゃったら、\n　もう『秘密』じゃないね‥‥」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "「それより、『秘密兵器』が\n　『クリエーター』に操られるってことはないの‥‥」"},
{"id": 186, "speaker": 29, "form": "dlg", "jp": "「私は『ある』と思ってたわ‥‥」"},
{"id": 187, "speaker": 35, "form": "dlg", "jp": "「じゃあ、そんなもの作っちゃぁ～」"},
{"id": 188, "speaker": 31, "form": "dlg", "jp": "「アイツらも必死なんだよ‥‥」"},
{"id": 189, "speaker": 15, "form": "dlg", "jp": "「『アイツら』って？」"},
{"id": 190, "speaker": 16, "form": "dlg", "jp": "「『アイツら』？」"},
{"id": 191, "speaker": 18, "form": "dlg", "jp": "「『アイツら』？」"},
{"id": 192, "speaker": 51, "form": "dlg", "jp": "「『アイツら』って？」"},
{"id": 193, "speaker": 29, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』の『スポンサー』連中‥‥」"},
{"id": 194, "speaker": 29, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』は識者や大富豪のスポンサーの\n　援助があるからこうして活動ができるの‥‥」"},
{"id": 195, "speaker": 29, "form": "dlg", "jp": "「その人たちの援助のおかげね‥‥」"},
{"id": 196, "speaker": 15, "form": "dlg", "jp": "「そんな人たちまで『超能力者』なの？」"},
{"id": 197, "speaker": 29, "form": "dlg", "jp": "「違うわ‥‥」"},
{"id": 198, "speaker": 15, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』は『超能力者』の集団じゃあ？」"},
{"id": 199, "speaker": 16, "form": "dlg", "jp": "「そんな人たちまで『超能力者』なの？」"},
{"id": 200, "speaker": 29, "form": "dlg", "jp": "「違うわ‥‥」"},
{"id": 201, "speaker": 16, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』は『超能力者』の集団じゃなかったの？」"},
{"id": 202, "speaker": 18, "form": "dlg", "jp": "「そんな人たちまで『超能力者』なの？」"},
{"id": 203, "speaker": 29, "form": "dlg", "jp": "「違うわ‥‥」"},
{"id": 204, "speaker": 18, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』は『超能力者』の集団じゃないの？」"},
{"id": 205, "speaker": 51, "form": "dlg", "jp": "「そんな人たちまで『超能力者』なん？」"},
{"id": 206, "speaker": 29, "form": "dlg", "jp": "「違うわ‥‥」"},
{"id": 207, "speaker": 51, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』は『超能力者』の集団ちゃうの？」"},
{"id": 208, "speaker": 29, "form": "dlg", "jp": "「だから、援助をしてもらっているだけで\n　『超能力者』ってわけじゃないから‥‥」"},
{"id": 209, "speaker": 29, "form": "dlg", "jp": "「いくら『超能力者』でも\n　お金がないと生きて行けないでしょう？」"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "「でも、よく協力してくれるよね？」"},
{"id": 211, "speaker": 29, "form": "dlg", "jp": "「当たり前でしょう？」"},
{"id": 212, "speaker": 29, "form": "dlg", "jp": "「たくさん持っている人程、\n　失うのが恐いのよ！」"},
{"id": 213, "speaker": 29, "form": "dlg", "jp": "「例えば、ナゴムが一文無しで‥‥」"},
{"id": 214, "speaker": 29, "form": "dlg", "jp": "「身寄りがだれもいなくて‥‥」"},
{"id": 215, "speaker": 29, "form": "dlg", "jp": "「何をやってもダメで‥‥」"},
{"id": 216, "speaker": 29, "form": "dlg", "jp": "「世の中があなたを敵視していて‥‥」"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "「重い病気になっていたとしたら、\n　今の生活を守りたいと思う？」"},
{"id": 218, "speaker": 29, "form": "dlg", "jp": "「それとも‥‥」"},
{"id": 219, "speaker": 29, "form": "dlg", "jp": "「それとも『こんな世界なくなってしまえ』って思う？」"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 221, "speaker": 31, "form": "dlg", "jp": "「ある意味、アイツらの方が必死なんだよ‥‥」"},
{"id": 222, "speaker": 31, "form": "dlg", "jp": "「守るために‥‥」"},
{"id": 223, "speaker": 31, "form": "dlg", "jp": "「だから、積極的に援助もしてくれるけど‥‥」"},
{"id": 224, "speaker": 29, "form": "dlg", "jp": "「余計なこともしてくれるの‥‥」"},
{"id": 225, "speaker": 15, "form": "dlg", "jp": "「『余計なこと』‥‥？」"},
{"id": 226, "speaker": 16, "form": "dlg", "jp": "「『余計なこと』‥‥？」"},
{"id": 227, "speaker": 18, "form": "dlg", "jp": "「『余計なこと』‥‥？」"},
{"id": 228, "speaker": 51, "form": "dlg", "jp": "「『余計なこと』‥‥？」"},
{"id": 229, "speaker": 29, "form": "dlg", "jp": "「あの『ＵＦＯ』とか‥‥」"},
{"id": 230, "speaker": 29, "form": "dlg", "jp": "「私たちはあの『ＵＦＯ』すらコントロールされることを\n　恐れて開発を中断させようとしたんだけど‥‥」"},
{"id": 231, "speaker": 29, "form": "dlg", "jp": "「彼らは何が何でもより安心したいがために、\n　強力な武器を欲しがったの‥‥」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「じゃあ、あのＵＦＯは『兵器』なの？」"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "「ええ、多分『世界一強力な兵器』よ‥‥」"},
{"id": 234, "speaker": 35, "form": "dlg", "jp": "「『世界一強力な兵器』！？」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「それが『暴走』することは考えなかったの？」"},
{"id": 236, "speaker": 29, "form": "dlg", "jp": "「『秘密』にしておけば、\n　『クリエーター』には操れないと思ったようね‥‥」"},
{"id": 237, "speaker": 35, "form": "dlg", "jp": "「バカだねぇ～」"},
{"id": 238, "speaker": 35, "form": "dlg", "jp": "「軍の『秘密兵器』すら操られたのに‥‥」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「もし、あの『ＵＦＯ』が操られたとしたら‥‥」"},
{"id": 240, "speaker": 29, "form": "dlg", "jp": "「残念ながら、すでに操られているとしか思えない‥‥」"},
{"id": 241, "speaker": 29, "form": "dlg", "jp": "「『秘密兵器』を『決戦前』に披露するとは\n　考えられない‥‥」"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 243, "speaker": 35, "form": "dlg", "jp": "「オイ、観ろよ！」"},
{"id": 244, "speaker": 35, "form": "dlg", "jp": "「うわぁ～～！」"},
{"id": 245, "speaker": 31, "form": "dlg", "jp": "「やりやがった！！」"},
{"id": 246, "speaker": 29, "form": "dlg", "jp": "「行くわよっ！」"},
{"id": 247, "speaker": 35, "form": "dlg", "jp": "「行くってどこへ？」"},
{"id": 248, "speaker": 29, "form": "dlg", "jp": "「『ＵＦＯの破壊』に決まってるでしょう！！」"},
{"id": 249, "speaker": 35, "form": "dlg", "jp": "「待ってくれよ！」"},
{"id": 250, "speaker": 35, "form": "dlg", "jp": "「相手は『世界一強力な兵器』なんだろう？」"},
{"id": 251, "speaker": 35, "form": "dlg", "jp": "「オレたちだけで破壊するのは‥‥」"},
{"id": 252, "speaker": 29, "form": "dlg", "jp": "「ぐずぐずしているヒマはないの‥‥」"},
{"id": 253, "speaker": 29, "form": "dlg", "jp": "「もし、あのＵＦＯの正体が一般人にバレたら\n　どうなると思う？」"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』の存在もバレちゃうってことよ‥‥」"},
{"id": 255, "speaker": 29, "form": "dlg", "jp": "「もし、ＵＦＯで被害を受けた人たちが\n　そのことを知ったら‥‥」"},
{"id": 256, "speaker": 29, "form": "dlg", "jp": "「間違いなく、\n　『Ｅ－ｇｒｏ』に敵対感情を抱くでしょ‥‥？」"},
{"id": 257, "speaker": 29, "form": "dlg", "jp": "「そんなことになったら‥‥」"},
{"id": 258, "speaker": 15, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 259, "speaker": 16, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 260, "speaker": 18, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 261, "speaker": 51, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 262, "speaker": 31, "form": "dlg", "jp": "「『魔女狩り』が起きるな‥‥」"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "「つまり‥‥」"},
{"id": 264, "speaker": 29, "form": "dlg", "jp": "「『一般人』と『超能力者』の戦争になるわね‥‥」"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 266, "speaker": 29, "form": "dlg", "jp": "「だから、一刻も早く\n　あのＵＦＯを破壊して被害をおさえないと‥‥」"},
{"id": 267, "speaker": 31, "form": "dlg", "jp": "「かつ、『証拠インメツ』しないとな‥‥」"},
{"id": 268, "speaker": 31, "form": "choice", "jp": "「うん、そうだね！」"},
{"id": 269, "speaker": 31, "form": "choice", "jp": "「でも、そう簡単に破壊できるかなぁ？」"},
{"id": 270, "speaker": 2, "form": "dlg", "jp": "「うん、そうだね！」"},
{"id": 271, "speaker": 2, "form": "dlg", "jp": "「でも、そう簡単に破壊できるかなぁ？」"},
{"id": 272, "speaker": 29, "form": "dlg", "jp": "「自分を信じなきゃなにもできないわよ！」"},
{"id": 273, "speaker": 35, "form": "dlg", "jp": "「わかった！」"},
{"id": 274, "speaker": 35, "form": "dlg", "jp": "「あの場所ならわかるから、すぐにいけるよ！」"},
{"id": 275, "speaker": 5, "form": "dlg", "jp": "「あのう‥‥」"},
{"id": 276, "speaker": 31, "form": "dlg", "jp": "「なんだ？」"},
{"id": 277, "speaker": 31, "form": "dlg", "jp": "「まだいたのか？」"},
{"id": 278, "speaker": 5, "form": "dlg", "jp": "「やっぱり、ボクは連れていってもらえないでしょうか？」"},
{"id": 279, "speaker": 29, "form": "dlg", "jp": "「しつこいわね、ダメなものはダメよ！」"},
{"id": 280, "speaker": 5, "form": "dlg", "jp": "「ナゴム、なにかボクに協力できることはない？」"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "「あるよ‥‥」"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "「姉さんに、ボクたちのことを説明しておいて！」"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "「多分、姉さんまったく理解できてないと思うから‥‥」"},
{"id": 284, "speaker": 5, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "「あと‥‥」"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "「『マイちゃん』を守ってあげて‥‥」"},
{"id": 287, "speaker": 5, "form": "dlg", "jp": "「うん！！」"},
{"id": 288, "speaker": 5, "form": "dlg", "jp": "シローはすんなりとボクの言うことを聞いてくれた。"},
{"id": 289, "speaker": 31, "form": "dlg", "jp": "「じゃあ、\n　アイコはココでコイツを見張っておいてくれ！」"},
{"id": 290, "speaker": 15, "form": "dlg", "jp": "「わかったわ！」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「『私もつれってって！』\n　とか言わないんだね？」"},
{"id": 292, "speaker": 15, "form": "dlg", "jp": "「だって、\n　このカッコウで外に出るの恥ずかしいもん‥‥」"},
{"id": 293, "speaker": 29, "form": "dlg", "jp": "「アスカ、お願い！」"},
{"id": 294, "speaker": 31, "form": "dlg", "jp": "「じゃあ、\n　アキラはココでコイツを見張っておいてくれ！」"},
{"id": 295, "speaker": 16, "form": "dlg", "jp": "「わかったわ！」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「『アキラもつれってって！』\n　とか言わないんだね？」"},
{"id": 297, "speaker": 16, "form": "dlg", "jp": "「だって‥‥」"},
{"id": 298, "speaker": 16, "form": "dlg", "jp": "「もっと、『シローさん』に聞きたいことあるし‥‥」"},
{"id": 299, "speaker": 29, "form": "dlg", "jp": "「アスカ、お願い！」"},
{"id": 300, "speaker": 18, "form": "dlg", "jp": "「私も行っていいの？」"},
{"id": 301, "speaker": 29, "form": "dlg", "jp": "「たぶん、\n　アナタの『能力』が必要になりそうだし‥‥」"},
{"id": 302, "speaker": 29, "form": "dlg", "jp": "「アスカ、お願い！」"},
{"id": 303, "speaker": 51, "form": "dlg", "jp": "「じゃあ、いこか！」"},
{"id": 304, "speaker": 29, "form": "dlg", "jp": "「アスカ、お願い！」"},
{"id": 305, "speaker": 35, "form": "dlg", "jp": "「じゃあ行くよ！！」"},
{"id": 306, "speaker": 35, "form": "dlg", "jp": "「シュン！」"},
{"id": 307, "speaker": 35, "form": "dlg", "jp": "ボクたちは松尾さんの能力で現場へ向かった。"}
]
