[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／１１／ＡＭ０９：２０"},
{"id": 1, "speaker": 26, "form": "dlg", "jp": "「どうもスミマセン‥‥」"},
{"id": 2, "speaker": 26, "form": "dlg", "jp": "「朝食までいただいて‥‥」"},
{"id": 3, "speaker": 3, "form": "dlg", "jp": "「気にしないでください‥‥」"},
{"id": 4, "speaker": 26, "form": "dlg", "jp": "「どうですか？\n　学会の準備は順調に進んでいますか？」"},
{"id": 5, "speaker": 3, "form": "dlg", "jp": "「ハイ、少しずつですけど‥‥」"},
{"id": 6, "speaker": 3, "form": "dlg", "jp": "あの事件以降、『三田さん』が\nウチへよく来るようになった。"},
{"id": 7, "speaker": 3, "form": "dlg", "jp": "本人は、学会での発表が近付いた\n姉さんを手伝うためだというが、"},
{"id": 8, "speaker": 3, "form": "dlg", "jp": "本当はどうだが疑わしい‥‥"},
{"id": 9, "speaker": 3, "form": "dlg", "jp": "「父はちゃんと食事とかとってます？」"},
{"id": 10, "speaker": 26, "form": "dlg", "jp": "「ええ、\n　時間は不規則ですけどね‥‥」"},
{"id": 11, "speaker": 26, "form": "choice", "jp": "「いそがしいの？」"},
{"id": 12, "speaker": 26, "form": "choice", "jp": "「大学も夏休みでしょう？」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「いそがしいの？」"},
{"id": 14, "speaker": 26, "form": "dlg", "jp": "「いそがしくはないよ‥‥」"},
{"id": 15, "speaker": 26, "form": "dlg", "jp": "「ただ、ルードのサイボーグを見て\n　ライバル心がわいて来たみたいで‥‥」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「大学も夏休みでしょう？」"},
{"id": 17, "speaker": 26, "form": "dlg", "jp": "「学生がいない方が研究に没頭できるとかいって‥‥」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「しかたないなぁ～」"},
{"id": 19, "speaker": 3, "form": "dlg", "jp": "「三田さんもそれにつきあわされてるんでしょう？」"},
{"id": 20, "speaker": 3, "form": "dlg", "jp": "「大変よね～～」"},
{"id": 21, "speaker": 26, "form": "dlg", "jp": "「そんなことはないですよ！」"},
{"id": 22, "speaker": 26, "form": "dlg", "jp": "「側にいて研究のお手伝いをすることが\n　助手のつとめですから‥‥」"},
{"id": 23, "speaker": 26, "form": "dlg", "jp": "「ハイ！」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「助手って大変なんだね‥‥」"},
{"id": 25, "speaker": 26, "form": "dlg", "jp": "「まあ、大変じゃない仕事なんてないよ！」"},
{"id": 26, "speaker": 3, "form": "dlg", "jp": "「三田さんって立派ですね‥‥」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「うん、将来はノーベル賞でももらうんじゃない？」"},
{"id": 28, "speaker": 26, "form": "dlg", "jp": "「ハハハハハハハ‥‥」"},
{"id": 29, "speaker": 26, "form": "dlg", "jp": "「いらないよそんなもの‥‥」"},
{"id": 30, "speaker": 26, "form": "dlg", "jp": "「それにもらうとすれば博士の方が先ですよ！」"},
{"id": 31, "speaker": 3, "form": "dlg", "jp": "「万が一そうなったらいやだわ‥‥」"},
{"id": 32, "speaker": 26, "form": "dlg", "jp": "「どうしてですか？」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「あのヒゲ面で受賞式に出そうだから？」"},
{"id": 34, "speaker": 3, "form": "dlg", "jp": "「正解！」"},
{"id": 35, "speaker": 3, "form": "dlg", "jp": "「フフフフフフフフ‥‥」"},
{"id": 36, "speaker": 3, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 37, "speaker": 3, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 38, "speaker": 13, "form": "dlg", "jp": "「ナ～ゴ～ム～くん！！」"},
{"id": 39, "speaker": 3, "form": "dlg", "jp": "「角川くんよ！」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「何の用だろう？」"},
{"id": 41, "speaker": 13, "form": "dlg", "jp": "「ウィッス！」"},
{"id": 42, "speaker": 14, "form": "dlg", "jp": "「ヨッ！」"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「何か用？」"},
{"id": 44, "speaker": 14, "form": "dlg", "jp": "「『プール』でも行かないか？」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「『プール』？」"},
{"id": 46, "speaker": 14, "form": "dlg", "jp": "「どうせ家でヒマなんだろう？」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「まあ、そうだけど‥‥」"},
{"id": 48, "speaker": 13, "form": "dlg", "jp": "「じゃあ、決まりだな！」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「なんで、そうなるんだよ！！」"},
{"id": 50, "speaker": 14, "form": "dlg", "jp": "「若い者が細かいことを気にするな！」"},
{"id": 51, "speaker": 14, "form": "dlg", "jp": "「さっさと準備してこいよ‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「しかたないなぁ～～」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "こうしてボクはシンちゃんたちといっしょに\nプールへ行くことになった。"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "「イッテキマ～ス！！」"},
{"id": 55, "speaker": 3, "form": "dlg", "jp": "「気をつけてね‥‥」"},
{"id": 56, "speaker": 14, "form": "dlg", "jp": "「じゃあ、ナゴムを借りて行きます！」"},
{"id": 57, "speaker": 14, "form": "dlg", "jp": "「で、オヤジさんのことは\n　もう落ち着いたのか？」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 59, "speaker": 13, "form": "dlg", "jp": "「さすが、世界的な博士だよな、\n　世界的な事件に巻き込まれるなんて‥‥」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「ぜんぜんうれしくないけど‥‥」"},
{"id": 61, "speaker": 13, "form": "dlg", "jp": "「平凡が一番っていう、日本人の典型だな‥‥」"},
{"id": 62, "speaker": 13, "form": "dlg", "jp": "「オレなら、事件のことを手記にして\n　出版するけどな‥‥」"},
{"id": 63, "speaker": 13, "form": "dlg", "jp": "「うまくゆけば大儲けできると思うんだけど‥‥」"},
{"id": 64, "speaker": 13, "form": "choice", "jp": "「その手があったか！！」"},
{"id": 65, "speaker": 13, "form": "choice", "jp": "「それはちょっと‥‥」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「その手があったか！！」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「それはちょっと‥‥」"},
{"id": 68, "speaker": 14, "form": "dlg", "jp": "「まあ、ナゴムんとこは金持ちなんだから\n　そんなことまでしてお金欲しくないだろう？」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「ウチはそんなにお金持ちじゃないよ‥‥」"},
{"id": 70, "speaker": 14, "form": "dlg", "jp": "「そもそも、ああいうのって\n　『加害者側』が書くもんで‥‥」"},
{"id": 71, "speaker": 14, "form": "dlg", "jp": "「ナゴムは『被害者』だから、\n　書いても金になんかならないよ‥‥」"},
{"id": 72, "speaker": 13, "form": "dlg", "jp": "「『被害者』の言い分なんて聞きたいか？」"},
{"id": 73, "speaker": 14, "form": "dlg", "jp": "「さあ‥‥？」"},
{"id": 74, "speaker": 4, "form": "dlg", "jp": "「あら、みんな来てたの？」"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "「堤さん！！」"},
{"id": 76, "speaker": 18, "form": "dlg", "jp": "「常光寺くん！」"},
{"id": 77, "speaker": 18, "form": "dlg", "jp": "「もうお父さんのことは大丈夫なの？」"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 79, "speaker": 15, "form": "dlg", "jp": "「で、宿題は順調なの？」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「アイコ！？」"},
{"id": 81, "speaker": 15, "form": "dlg", "jp": "「ほとんど、やってなかったんでしょう？」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「うん、今あわててやってるところ‥‥」"},
{"id": 83, "speaker": 15, "form": "dlg", "jp": "「じゃあ、こんなところで遊んでいていいの？」"},
{"id": 84, "speaker": 14, "form": "dlg", "jp": "「まあ、息抜きぐらいさしてやれよ‥‥」"},
{"id": 85, "speaker": 14, "form": "dlg", "jp": "「コイツも遊んでたわけじゃないんだし‥‥」"},
{"id": 86, "speaker": 15, "form": "dlg", "jp": "「じゃあ、関口くんたちは\n　息抜きは必要無いわね！」"},
{"id": 87, "speaker": 13, "form": "dlg", "jp": "「オマエこそ、家で宿題してろよ！」"},
{"id": 88, "speaker": 15, "form": "dlg", "jp": "「私はもう終わらせたわよ！」"},
{"id": 89, "speaker": 13, "form": "dlg", "jp": "「ウソ！？」"},
{"id": 90, "speaker": 15, "form": "dlg", "jp": "「それに私は堤さんがさそったから来ただけで‥‥」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「堤さんが！？」"},
{"id": 92, "speaker": 13, "form": "dlg", "jp": "「それって、ちょっと意外かも‥‥」"},
{"id": 93, "speaker": 18, "form": "dlg", "jp": "「どうして？」"},
{"id": 94, "speaker": 18, "form": "dlg", "jp": "「私、水泳は３歳から‥‥」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "「でも、堤さんってインドア派のイメージが‥‥」"},
{"id": 97, "speaker": 18, "form": "dlg", "jp": "「水泳はインドアスポーツよ？」"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 99, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃんたら、何デレデレしてるのよ！」"},
{"id": 100, "speaker": 15, "form": "choice", "jp": "「ヤいてるの？」"},
{"id": 101, "speaker": 15, "form": "choice", "jp": "「だって、堤さんかわいいから‥‥」"},
{"id": 102, "speaker": 15, "form": "choice", "jp": "「デレデレなんてしてないよ！」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「ヤいてるの？」"},
{"id": 104, "speaker": 15, "form": "dlg", "jp": "「な、なんで私が‥‥」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「だって、堤さんかわいいから‥‥」"},
{"id": 106, "speaker": 15, "form": "dlg", "jp": "「どうせ、私はかわいくないですよ！」"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「デレデレなんてしてないよ！」"},
{"id": 108, "speaker": 15, "form": "dlg", "jp": "「そうかしら？」"},
{"id": 109, "speaker": 13, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 110, "speaker": 13, "form": "dlg", "jp": "「管理者責任で、そのウルサイのを連れて帰れよ！」"},
{"id": 111, "speaker": 15, "form": "dlg", "jp": "「なんで、ナゴムちゃんが私の管理者なのよ！」"},
{"id": 112, "speaker": 14, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 113, "speaker": 14, "form": "dlg", "jp": "「どっちかっていうとその逆っぽいな‥‥」"},
{"id": 114, "speaker": 13, "form": "dlg", "jp": "「三船はウルサイんだよ‥‥」"},
{"id": 115, "speaker": 15, "form": "dlg", "jp": "「フフフフフフ‥‥」"},
{"id": 116, "speaker": 15, "form": "dlg", "jp": "「もっと、ウルサイのが来てるわよ！」"},
{"id": 117, "speaker": 14, "form": "dlg", "jp": "「まさか‥‥！？」"},
{"id": 118, "speaker": 16, "form": "dlg", "jp": "「ねえねえ、何の話してたの？」"},
{"id": 119, "speaker": 13, "form": "dlg", "jp": "「キタ～～～～～～！」"},
{"id": 120, "speaker": 13, "form": "choice", "jp": "「なんでもないよ‥‥」"},
{"id": 121, "speaker": 13, "form": "choice", "jp": "「長尾がカワイイって‥‥」"},
{"id": 122, "speaker": 13, "form": "choice", "jp": "「長尾がウルサイって‥‥」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「なんでもないよ‥‥」"},
{"id": 124, "speaker": 16, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 125, "speaker": 14, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「長尾がカワイイって‥‥」"},
{"id": 127, "speaker": 16, "form": "dlg", "jp": "「そ、そんなことないわよ‥‥」"},
{"id": 128, "speaker": 16, "form": "dlg", "jp": "「アキラより、堤さんや三船ちゃんの方が‥‥」"},
{"id": 129, "speaker": 13, "form": "dlg", "jp": "「何テレてんだよ‥‥」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「長尾がウルサイって‥‥」"},
{"id": 131, "speaker": 16, "form": "dlg", "jp": "「そ‥‥」"},
{"id": 132, "speaker": 13, "form": "dlg", "jp": "「怒らないの？」"},
{"id": 133, "speaker": 16, "form": "dlg", "jp": "「だって、アキラうるさいし‥‥」"},
{"id": 134, "speaker": 14, "form": "dlg", "jp": "「自覚はあるんだな？」"},
{"id": 135, "speaker": 16, "form": "dlg", "jp": "「そんなことより、ちょっと聞いてよ‥‥」"},
{"id": 136, "speaker": 14, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 137, "speaker": 13, "form": "dlg", "jp": "「どうせ、また幽霊とか吸血鬼とかの話だろう？」"},
{"id": 138, "speaker": 16, "form": "dlg", "jp": "「えっ、どうしてわかったの！？」"},
{"id": 139, "speaker": 13, "form": "dlg", "jp": "「やっぱりかよ‥‥」"},
{"id": 140, "speaker": 14, "form": "dlg", "jp": "「で、今度はなんなんだよ！」"},
{"id": 141, "speaker": 16, "form": "dlg", "jp": "「『吸血鬼』よ‥‥」"},
{"id": 142, "speaker": 14, "form": "dlg", "jp": "「また、そんなこと言ってるのかよ‥‥」"},
{"id": 143, "speaker": 13, "form": "dlg", "jp": "「どうせアレだろう？」"},
{"id": 144, "speaker": 13, "form": "dlg", "jp": "「例の『チュパカブラ』のウワサを聞いたんだろう？」"},
{"id": 145, "speaker": 16, "form": "dlg", "jp": "「違うわよ！！」"},
{"id": 146, "speaker": 16, "form": "dlg", "jp": "「見たのよこの目で！！」"},
{"id": 147, "speaker": 14, "form": "dlg", "jp": "「『吸血鬼』をか？」"},
{"id": 148, "speaker": 16, "form": "dlg", "jp": "「うん、それっぽいの‥‥」"},
{"id": 149, "speaker": 13, "form": "dlg", "jp": "「信用できないなぁ～～」"},
{"id": 150, "speaker": 13, "form": "dlg", "jp": "「こないだの件もあるし‥‥」"},
{"id": 151, "speaker": 18, "form": "dlg", "jp": "「ねえ、こないだの件って？」"},
{"id": 152, "speaker": 14, "form": "dlg", "jp": "「くだらない話だよ‥‥」"},
{"id": 153, "speaker": 16, "form": "dlg", "jp": "「くだらなくないわよ！！」"},
{"id": 154, "speaker": 16, "form": "dlg", "jp": "「もし本当にだったら、大発見よ！」"},
{"id": 155, "speaker": 16, "form": "choice", "jp": "「そうだけど‥‥」"},
{"id": 156, "speaker": 16, "form": "choice", "jp": "「そのもしはありえないよ！」"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 158, "speaker": 16, "form": "dlg", "jp": "「でしょう？」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "「そのもしはありえないよ！」"},
{"id": 160, "speaker": 16, "form": "dlg", "jp": "「常光寺くんまで‥‥」"},
{"id": 161, "speaker": 18, "form": "dlg", "jp": "「ねえ、話だけでも聞いてあげましょうよ‥‥」"},
{"id": 162, "speaker": 14, "form": "dlg", "jp": "「仕方ねぇなぁ‥‥」"},
{"id": 163, "speaker": 14, "form": "dlg", "jp": "長尾は『吸血鬼』の話をし始めた。"},
{"id": 164, "speaker": 16, "form": "dlg", "jp": "「実はね‥‥」"},
{"id": 165, "speaker": 16, "form": "dlg", "jp": "「昨日の夕方、買い物の帰りに\n　倉庫街の近くで悲鳴を聞いちゃったの‥‥」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "「悲鳴！？」"},
{"id": 167, "speaker": 16, "form": "dlg", "jp": "「そう」"},
{"id": 168, "speaker": 16, "form": "dlg", "jp": "「で、倉庫街の方へかけよったら、\n　オカシな人影を見たのよ！！」"},
{"id": 169, "speaker": 15, "form": "dlg", "jp": "「『オカシな人影』！？」"},
{"id": 170, "speaker": 16, "form": "dlg", "jp": "「そうよ！」"},
{"id": 171, "speaker": 16, "form": "dlg", "jp": "「人間じゃないみたいなの‥‥」"},
{"id": 172, "speaker": 18, "form": "dlg", "jp": "「人間じゃない？」"},
{"id": 173, "speaker": 16, "form": "dlg", "jp": "「『怪獣』みたいなの‥‥」"},
{"id": 174, "speaker": 16, "form": "dlg", "jp": "「アレは絶対、『吸血鬼』よ！」"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "「ちょっと待ってよ、\n　『人間じゃない』と『吸血鬼』なの？」"},
{"id": 176, "speaker": 16, "form": "dlg", "jp": "「今朝の新聞読んでないの？」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「ゴ、ゴメン‥‥」"},
{"id": 178, "speaker": 16, "form": "dlg", "jp": "「あの倉庫街の倉庫で死体が見つかったのよ‥‥」"},
{"id": 179, "speaker": 16, "form": "dlg", "jp": "「『血を抜き取られた死体』が‥‥」"},
{"id": 180, "speaker": 15, "form": "dlg", "jp": "「『血を抜き取られた死体』！？」"},
{"id": 181, "speaker": 13, "form": "dlg", "jp": "「だから、アレだろう？」"},
{"id": 182, "speaker": 13, "form": "dlg", "jp": "「ウワサの『チュパカブラ』だろう？」"},
{"id": 183, "speaker": 13, "form": "dlg", "jp": "「あんなの『吸血鬼』でもなんでもないよ‥‥」"},
{"id": 184, "speaker": 13, "form": "dlg", "jp": "「マスコミがおもしろがって大袈裟に報道してるんだよ！」"},
{"id": 185, "speaker": 16, "form": "dlg", "jp": "「じゃあ、あの『怪獣みたいなの』は？」"},
{"id": 186, "speaker": 14, "form": "dlg", "jp": "「そっちの方がウソっぽいだろう？」"},
{"id": 187, "speaker": 16, "form": "dlg", "jp": "「じゃあ、アキラがウソをついてると？」"},
{"id": 188, "speaker": 14, "form": "dlg", "jp": "「そうじゃなくて、\n　オマエは思い込みがハゲしいから‥‥」"},
{"id": 189, "speaker": 16, "form": "dlg", "jp": "「そんなぁ～～～～」"},
{"id": 190, "speaker": 13, "form": "dlg", "jp": "「まあ、こないだの幽霊もそうだったしな‥‥」"},
{"id": 191, "speaker": 16, "form": "dlg", "jp": "「アンタまで‥‥」"},
{"id": 192, "speaker": 16, "form": "dlg", "jp": "「ねえ、常光寺くんは、信じてくれるよね‥‥」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「う～～～～ん‥‥」"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "「ボクもウソみたいな経験をいろいろしたから‥‥」"},
{"id": 195, "speaker": 13, "form": "dlg", "jp": "「オイオイ、何を言い出すんだよ！」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「長尾が本当に吸血鬼を見たかどうかは別として」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「怪物っぽいものを見たのは本当じゃないかな？」"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "「ぬいぐるみとか‥‥\n　サイボーグとか‥‥」"},
{"id": 199, "speaker": 15, "form": "dlg", "jp": "「そういえば、\n　ナゴムちゃんはサイボーグに襲われたんだっけ‥‥」"},
{"id": 200, "speaker": 16, "form": "dlg", "jp": "「やっぱり、わかってくれるのは\n　常光寺くんだけね‥‥」"},
{"id": 201, "speaker": 13, "form": "dlg", "jp": "「でも、ルードってもうカイメツしたんだろう？」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「例えばの話だよ‥‥」"},
{"id": 203, "speaker": 4, "form": "dlg", "jp": "「あれ、みんな来てたん？」"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "「小田！！」"},
{"id": 205, "speaker": 51, "form": "dlg", "jp": "「常光寺ぃ！」"},
{"id": 206, "speaker": 51, "form": "dlg", "jp": "「もうお父さんのことは大丈夫なん？」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 208, "speaker": 15, "form": "dlg", "jp": "「で、宿題は順調なの？」"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "「アイコ！？」"},
{"id": 210, "speaker": 15, "form": "dlg", "jp": "「ほとんど、やってなかっったんでしょう？」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「うん、今あわててやってるところ‥‥」"},
{"id": 212, "speaker": 15, "form": "dlg", "jp": "「じゃあ、こんなところで遊んでいていいの？」"},
{"id": 213, "speaker": 14, "form": "dlg", "jp": "「まあ、息抜きぐらいさしてやれよ‥‥」"},
{"id": 214, "speaker": 14, "form": "dlg", "jp": "「コイツも遊んでたわけじゃないんだし‥‥」"},
{"id": 215, "speaker": 15, "form": "dlg", "jp": "「じゃあ、関口くんたちは\n　息抜きは必要無いわね！」"},
{"id": 216, "speaker": 13, "form": "dlg", "jp": "「オマエこそ、家で宿題してろよ！」"},
{"id": 217, "speaker": 15, "form": "dlg", "jp": "「私はもう終わらせたわよ！」"},
{"id": 218, "speaker": 13, "form": "dlg", "jp": "「ウソ！？」"},
{"id": 219, "speaker": 51, "form": "dlg", "jp": "「アンタらはまだみたいやね‥‥」"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「小田も終わったの？」"},
{"id": 221, "speaker": 51, "form": "dlg", "jp": "「アタリマエやん！！」"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 223, "speaker": 2, "form": "choice", "jp": "「すごいね‥‥」"},
{"id": 224, "speaker": 2, "form": "choice", "jp": "「イメージとちがうね」"},
{"id": 225, "speaker": 2, "form": "choice", "jp": "「ボクもがんばらなきゃ‥‥」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「すごいね‥‥」"},
{"id": 227, "speaker": 15, "form": "dlg", "jp": "「感心してないで、\n　ナゴムちゃんもがんばらないと‥‥」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "「イメージとちがうね」"},
{"id": 230, "speaker": 51, "form": "dlg", "jp": "「もしかして、ウチのこと筋肉バカだと思ってたとか‥‥」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「そうじゃないけど‥‥」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「部活とか忙しそうだったし‥‥」"},
{"id": 233, "speaker": 51, "form": "dlg", "jp": "「忙しいはイイワケにできひんやろう？」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「ボクもがんばらなきゃ‥‥」"},
{"id": 235, "speaker": 51, "form": "dlg", "jp": "「ホンマやで‥‥」"},
{"id": 236, "speaker": 51, "form": "dlg", "jp": "「今年は受験もあるんやから‥‥」"},
{"id": 237, "speaker": 13, "form": "dlg", "jp": "「受験勉強しなくちゃいけないのに、\n　宿題なんて出さなくても‥‥」"},
{"id": 238, "speaker": 51, "form": "dlg", "jp": "「軟弱モノ‥‥」"},
{"id": 239, "speaker": 13, "form": "dlg", "jp": "「そう言う言葉は\n　金髪のお姉さんに言ってもらいたいもんだ‥‥」"},
{"id": 240, "speaker": 14, "form": "dlg", "jp": "「で、２人だけで来たの？」"},
{"id": 241, "speaker": 15, "form": "dlg", "jp": "「違うわよ」"},
{"id": 242, "speaker": 15, "form": "dlg", "jp": "「アキラちゃんといっしょよ‥‥」"},
{"id": 243, "speaker": 13, "form": "dlg", "jp": "「ええっ、長尾と！？」"},
{"id": 244, "speaker": 15, "form": "dlg", "jp": "「そうよ！」"},
{"id": 245, "speaker": 13, "form": "dlg", "jp": "「オレ、アイツ苦手なんだよ‥‥」"},
{"id": 246, "speaker": 13, "form": "dlg", "jp": "「ＵＦＯとか幽霊とか、\n　非科学的な話ばっかりするし‥‥」"},
{"id": 247, "speaker": 14, "form": "dlg", "jp": "「オレもダメだな‥‥」"},
{"id": 248, "speaker": 16, "form": "dlg", "jp": "「ねえねえ、何の話してたの？」"},
{"id": 249, "speaker": 13, "form": "dlg", "jp": "「キタ～～～～～～！」"},
{"id": 250, "speaker": 13, "form": "choice", "jp": "「なんでもないよ‥‥」"},
{"id": 251, "speaker": 13, "form": "choice", "jp": "「長尾がカワイイって‥‥」"},
{"id": 252, "speaker": 13, "form": "choice", "jp": "「長尾がウルサイって‥‥」"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "「なんでもないよ‥‥」"},
{"id": 254, "speaker": 16, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 255, "speaker": 14, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "「長尾がカワイイって‥‥」"},
{"id": 257, "speaker": 16, "form": "dlg", "jp": "「そ、そんなことないわよ‥‥」"},
{"id": 258, "speaker": 16, "form": "dlg", "jp": "「アキラより、堤さんや三船ちゃんの方が‥‥」"},
{"id": 259, "speaker": 13, "form": "dlg", "jp": "「何テレてんだよ‥‥」"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "「長尾がウルサイって‥‥」"},
{"id": 261, "speaker": 16, "form": "dlg", "jp": "「そ‥‥」"},
{"id": 262, "speaker": 13, "form": "dlg", "jp": "「怒らないの？」"},
{"id": 263, "speaker": 16, "form": "dlg", "jp": "「だって、アキラうるさいし‥‥」"},
{"id": 264, "speaker": 14, "form": "dlg", "jp": "「自覚はあるんだな？」"},
{"id": 265, "speaker": 14, "form": "dlg", "jp": "（『長尾アキラ』‥‥）"},
{"id": 266, "speaker": 14, "form": "dlg", "jp": "（同じクラスの『オカルト』＆\n　『ファンタジーマニア』だ‥‥）"},
{"id": 267, "speaker": 14, "form": "dlg", "jp": "（やたらとオバケやＵＦＯなんかの\n　話題ばかりする）"},
{"id": 268, "speaker": 14, "form": "dlg", "jp": "（ちょっと変わった女の子だ‥‥）"},
{"id": 269, "speaker": 16, "form": "dlg", "jp": "「そんなことより、ちょっと聞いてよ‥‥」"},
{"id": 270, "speaker": 14, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 271, "speaker": 13, "form": "dlg", "jp": "「どうせ、また幽霊とか吸血鬼とかの話だろう？」"},
{"id": 272, "speaker": 16, "form": "dlg", "jp": "「えっ、どうしてわかったの！？」"},
{"id": 273, "speaker": 13, "form": "dlg", "jp": "「やっぱりかよ‥‥」"},
{"id": 274, "speaker": 14, "form": "dlg", "jp": "「で、今度はなんなんだよ！」"},
{"id": 275, "speaker": 16, "form": "dlg", "jp": "「『吸血鬼』よ‥‥」"},
{"id": 276, "speaker": 14, "form": "dlg", "jp": "「また、そんなこと言ってるのかよ‥‥」"},
{"id": 277, "speaker": 13, "form": "dlg", "jp": "「どうせアレだろう？」"},
{"id": 278, "speaker": 13, "form": "dlg", "jp": "「例の『チュパカブラ』のウワサを聞いたんだろう？」"},
{"id": 279, "speaker": 16, "form": "dlg", "jp": "「違うわよ！！」"},
{"id": 280, "speaker": 16, "form": "dlg", "jp": "「見たのよこの目で！！」"},
{"id": 281, "speaker": 14, "form": "dlg", "jp": "「『吸血鬼』をか？」"},
{"id": 282, "speaker": 16, "form": "dlg", "jp": "「うん、それっぽいの‥‥」"},
{"id": 283, "speaker": 13, "form": "dlg", "jp": "「信用できないなぁ～～」"},
{"id": 284, "speaker": 13, "form": "dlg", "jp": "「こないだの件もあるし‥‥」"},
{"id": 285, "speaker": 16, "form": "dlg", "jp": "「何よ！\n　こないだの件って‥‥」"},
{"id": 286, "speaker": 16, "form": "dlg", "jp": "「なんだかわからないけど、\n　アキラは本当に見たのよ！」"},
{"id": 287, "speaker": 15, "form": "dlg", "jp": "「ねえ、話だけでも聞いてあげましょう‥‥」"},
{"id": 288, "speaker": 14, "form": "dlg", "jp": "「仕方ねぇなぁ‥‥」"},
{"id": 289, "speaker": 14, "form": "dlg", "jp": "長尾は『吸血鬼』の話をし始めた。"},
{"id": 290, "speaker": 16, "form": "dlg", "jp": "「実はね‥‥」"},
{"id": 291, "speaker": 16, "form": "dlg", "jp": "「昨日の夕方、買い物の帰りに\n　倉庫街の近くで悲鳴を聞いちゃったの‥‥」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「悲鳴！？」"},
{"id": 293, "speaker": 16, "form": "dlg", "jp": "「そう」"},
{"id": 294, "speaker": 16, "form": "dlg", "jp": "「で、倉庫街の方へかけよったら、\n　オカシな人影を見たのよ！！」"},
{"id": 295, "speaker": 15, "form": "dlg", "jp": "「『オカシな人影』！？」"},
{"id": 296, "speaker": 16, "form": "dlg", "jp": "「そうよ！」"},
{"id": 297, "speaker": 16, "form": "dlg", "jp": "「人間じゃないみたいなの‥‥」"},
{"id": 298, "speaker": 15, "form": "dlg", "jp": "「人間じゃない？」"},
{"id": 299, "speaker": 16, "form": "dlg", "jp": "「『怪獣』みたいなの‥‥」"},
{"id": 300, "speaker": 16, "form": "dlg", "jp": "「アレは絶対、『吸血鬼』よ！」"},
{"id": 301, "speaker": 2, "form": "dlg", "jp": "「ちょっと待ってよ、\n　『人間じゃない』と『吸血鬼』なの？」"},
{"id": 302, "speaker": 16, "form": "dlg", "jp": "「今朝の新聞読んでないの？」"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "「ゴ、ゴメン‥‥」"},
{"id": 304, "speaker": 16, "form": "dlg", "jp": "「あの倉庫街の倉庫で死体が見つかったのよ‥‥」"},
{"id": 305, "speaker": 16, "form": "dlg", "jp": "「『血を抜き取られた死体』が‥‥」"},
{"id": 306, "speaker": 15, "form": "dlg", "jp": "「『血を抜き取られた死体』！？」"},
{"id": 307, "speaker": 13, "form": "dlg", "jp": "「だから、アレだろう？」"},
{"id": 308, "speaker": 13, "form": "dlg", "jp": "「ウワサの『チュパカブラ』だろう？」"},
{"id": 309, "speaker": 13, "form": "dlg", "jp": "「あんなの『吸血鬼』でもなんでもないよ‥‥」"},
{"id": 310, "speaker": 13, "form": "dlg", "jp": "「マスコミがおもしろがって大袈裟に報道してるんだよ！」"},
{"id": 311, "speaker": 16, "form": "dlg", "jp": "「じゃあ、あの『怪獣みたいなの』は？」"},
{"id": 312, "speaker": 14, "form": "dlg", "jp": "「そっちの方がウソっぽいだろう？」"},
{"id": 313, "speaker": 16, "form": "dlg", "jp": "「じゃあ、アキラがウソをついてると？」"},
{"id": 314, "speaker": 14, "form": "dlg", "jp": "「そうじゃなくて、\n　オマエは思い込みがハゲしいから‥‥」"},
{"id": 315, "speaker": 16, "form": "dlg", "jp": "「そんなぁ～～～～」"},
{"id": 316, "speaker": 13, "form": "dlg", "jp": "「まあ、こないだの幽霊もそうだったしな‥‥」"},
{"id": 317, "speaker": 16, "form": "dlg", "jp": "「アンタまで‥‥」"},
{"id": 318, "speaker": 16, "form": "dlg", "jp": "「ねえ、常光寺くんは、信じてくれるよね‥‥」"},
{"id": 319, "speaker": 2, "form": "dlg", "jp": "「う～～～～ん‥‥」"},
{"id": 320, "speaker": 2, "form": "dlg", "jp": "「ボクもウソみたいな経験をいろいろしたから‥‥」"},
{"id": 321, "speaker": 13, "form": "dlg", "jp": "「オイオイ、何を言い出すんだよ！」"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "「長尾が本当に吸血鬼を見たかどうかは別として」"},
{"id": 323, "speaker": 2, "form": "dlg", "jp": "「怪物っぽいものを見たのは本当じゃないかな？」"},
{"id": 324, "speaker": 2, "form": "dlg", "jp": "「ぬいぐるみとか‥‥\n　サイボーグとか‥‥」"},
{"id": 325, "speaker": 15, "form": "dlg", "jp": "「そういえば、\n　ナゴムちゃんはサイボーグに襲われたんだっけ‥‥」"},
{"id": 326, "speaker": 16, "form": "dlg", "jp": "「やっぱり、わかってくれるのは\n　常光寺くんだけね‥‥」"},
{"id": 327, "speaker": 13, "form": "dlg", "jp": "「でも、ルードってもうカイメツしたんだろう？」"},
{"id": 328, "speaker": 2, "form": "dlg", "jp": "「例えばの話だよ‥‥」"},
{"id": 329, "speaker": 2, "form": "dlg", "jp": "（でも、本当に『ルード』のサイボーグだったら！！）"},
{"id": 330, "speaker": 2, "form": "dlg", "jp": "（この町に\n　現れる理由なんて１つしか考えられない！！）"},
{"id": 331, "speaker": 2, "form": "dlg", "jp": "（まさか‥‥！）"},
{"id": 332, "speaker": 14, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "「なんでもないよ‥‥」"},
{"id": 334, "speaker": 13, "form": "dlg", "jp": "「まさか、コイツの言うこと信じたとか‥‥？」"},
{"id": 335, "speaker": 14, "form": "dlg", "jp": "「それより、せっかくこれだけの人数がいるんだから」"},
{"id": 336, "speaker": 14, "form": "dlg", "jp": "「なんかしないか？」"},
{"id": 337, "speaker": 15, "form": "dlg", "jp": "「バレーでもする？」"},
{"id": 338, "speaker": 15, "form": "dlg", "jp": "「ビーチボールならあるけど‥‥」"},
{"id": 339, "speaker": 14, "form": "dlg", "jp": "「それだ！」"}
]
