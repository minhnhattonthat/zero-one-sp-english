{"id": 26, "speaker": null, "form": "dlg", "jp": "パートナーを選びます。"},
{"id": 27, "speaker": null, "form": "dlg", "jp": "アキラです。"},
{"id": 28, "speaker": null, "form": "dlg", "jp": "トモです。"},
{"id": 29, "speaker": null, "form": "dlg", "jp": "ではゲームスタート！"},
{"id": 30, "speaker": null, "form": "dlg", "jp": "２００５／０７／２６／ＡＭ０８：２０"},
{"id": 31, "speaker": null, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 32, "speaker": 3, "form": "dlg", "jp": "「ただいま」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「どこ行ってたのこんな朝から‥‥」"},
{"id": 34, "speaker": 3, "form": "dlg", "jp": "「コンビニよ‥‥」"},
{"id": 35, "speaker": 3, "form": "dlg", "jp": "「牛乳きれてたから‥‥」"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "「ふーん‥‥」"},
{"id": 37, "speaker": 3, "form": "dlg", "jp": "「そんなことより、聞いてよ！」"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "「なんかあったの？」"},
{"id": 39, "speaker": 3, "form": "dlg", "jp": "「今、"},
{"id": 40, "speaker": 3, "form": "dlg", "jp": "アイコちゃんのお母さんから聞いた"},
{"id": 41, "speaker": 3, "form": "dlg", "jp": "んだけど‥‥」"},
{"id": 42, "speaker": 3, "form": "dlg", "jp": "「伊東さんトコのクロが通行人にかみついて、\n　保健所に連れて行かれちゃったんだって‥‥」"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥！！」"},
{"id": 44, "speaker": 3, "form": "dlg", "jp": "「なんでも、\n　かみつかれた人は重傷らしいわよ‥‥」"},
{"id": 45, "speaker": 3, "form": "dlg", "jp": "「コレってやっぱり最近流行りの\n　"},
{"id": 46, "speaker": 3, "form": "dlg", "jp": "『謎の狂犬病』"},
{"id": 47, "speaker": 3, "form": "dlg", "jp": "に関係あるのかな？」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「さあ、どうだろう？」"},
{"id": 49, "speaker": 3, "form": "dlg", "jp": "「クロって、"},
{"id": 50, "speaker": 3, "form": "dlg", "jp": "大人しい犬"},
{"id": 51, "speaker": 3, "form": "dlg", "jp": "だったのに\n　かわいそうだわ‥‥」"},
{"id": 52, "speaker": 3, "form": "dlg", "jp": "『謎の狂犬病』"},
{"id": 53, "speaker": 3, "form": "dlg", "jp": "‥‥"},
{"id": 54, "speaker": 3, "form": "dlg", "jp": "ジーンたちがあやしんでいた事件だ‥‥"},
{"id": 55, "speaker": 3, "form": "dlg", "jp": "たぶん、ゾンビを操っていたアイツが\n『犬の死体』を操っていたのだろう‥‥"},
{"id": 56, "speaker": 3, "form": "dlg", "jp": "アイツが死んだ以上、もうかわいそうな犬や\n犬による被害はでないだろう‥‥"},
{"id": 57, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 58, "speaker": 3, "form": "dlg", "jp": "『昨日の夜まで』"},
{"id": 59, "speaker": 3, "form": "dlg", "jp": "は大人しかったらしいのに‥‥」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "『昨日の夜まで』"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "！？」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って、クロはいつ人を襲ったの？」"},
{"id": 64, "speaker": 3, "form": "dlg", "jp": "「だから、"},
{"id": 65, "speaker": 3, "form": "dlg", "jp": "今朝早く"},
{"id": 66, "speaker": 3, "form": "dlg", "jp": "よ‥‥」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「今朝！？」"},
{"id": 68, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 69, "speaker": 3, "form": "dlg", "jp": "アイコちゃんが"},
{"id": 70, "speaker": 3, "form": "dlg", "jp": "ランニングの最中に"},
{"id": 71, "speaker": 3, "form": "dlg", "jp": "目撃"},
{"id": 72, "speaker": 3, "form": "dlg", "jp": "して\n　救急車を呼んだんだって‥‥」"},
{"id": 73, "speaker": 3, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "「いや、どうもしないよ‥‥」"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "なんで、今朝なんだ？"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "もしかして、『謎の狂犬病』は\nあの『死体を操るヤツ』とは関係なかったのか？"},
{"id": 77, "speaker": 3, "form": "dlg", "jp": "「そんなことより、早く食事終わらせてしまって‥‥」"},
{"id": 78, "speaker": 3, "form": "dlg", "jp": "「姉さん、いそがしいんだから‥‥」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 81, "speaker": 3, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 82, "speaker": 3, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 83, "speaker": 14, "form": "dlg", "jp": "「コンチハ‥‥」"},
{"id": 84, "speaker": 3, "form": "dlg", "jp": "「あらっ、関口くん‥‥」"},
{"id": 85, "speaker": 3, "form": "dlg", "jp": "「コンニチハ‥‥」"},
{"id": 86, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～」"},
{"id": 87, "speaker": 3, "form": "dlg", "jp": "「関口くんよ～～」"},
{"id": 88, "speaker": 3, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「ウィッス！！」"},
{"id": 90, "speaker": 14, "form": "dlg", "jp": "「ウィッス！！」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「まあ、あがれよ‥‥」"},
{"id": 92, "speaker": 3, "form": "dlg", "jp": "「じゃあ、姉さんはでかけるから‥‥」"},
{"id": 93, "speaker": 3, "form": "dlg", "jp": "「ゆっくりしていってね‥‥」"},
{"id": 94, "speaker": 14, "form": "dlg", "jp": "「いえ、スグに出ますから‥‥」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「出る？」"},
{"id": 96, "speaker": 14, "form": "dlg", "jp": "「たまにはクラブに顔を出してやらないと‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「どうせ、誰も来てないんじゃぁ？」"},
{"id": 98, "speaker": 14, "form": "dlg", "jp": "「そんなの行ってみないとわからないだろう？」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「まあそうだけど‥‥」"},
{"id": 100, "speaker": 3, "form": "dlg", "jp": "「じゃあ、戸締まりお願いね‥‥」"},
{"id": 101, "speaker": 3, "form": "dlg", "jp": "こうしてボクたちは学校へゆくことになった。"},
{"id": 102, "speaker": 14, "form": "dlg", "jp": "「お姉さん、忙しいのかい？」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「なんだか、近々研究発表があるとか‥‥」"},
{"id": 104, "speaker": 14, "form": "dlg", "jp": "「学者さんも大変なんだな‥‥」"},
{"id": 105, "speaker": 14, "form": "dlg", "jp": "「誰も来てないな‥‥」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「だから言ったのに‥‥」"},
{"id": 107, "speaker": 14, "form": "dlg", "jp": "「しかたない‥‥」"},
{"id": 108, "speaker": 14, "form": "dlg", "jp": "「帰るか？」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「いったい、何しに来たんだよ！」"},
{"id": 110, "speaker": 14, "form": "dlg", "jp": "「散歩がてらのパトロールってことで‥‥」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "「何のパトロールなんだよ！」"},
{"id": 112, "speaker": 14, "form": "dlg", "jp": "「最近、野良犬が暴れてるらしいからな\n　部室が荒らされてないかどうかの‥‥」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「野良犬じゃなくて飼い犬が暴れてるんじゃ？」"},
{"id": 114, "speaker": 14, "form": "dlg", "jp": "「知ってるんじゃないか！」"},
{"id": 115, "speaker": 14, "form": "dlg", "jp": "そうだ！！"},
{"id": 116, "speaker": 14, "form": "dlg", "jp": "シンちゃんに『謎の狂犬病』のことを聞いてみよう！！"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「また『犬』が暴れる事件があったって知ってる？」"},
{"id": 118, "speaker": 14, "form": "dlg", "jp": "「『事件』？」"},
{"id": 119, "speaker": 14, "form": "dlg", "jp": "「ただ、犬がかみついただけだろう？」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「知ってるのか？」"},
{"id": 121, "speaker": 14, "form": "dlg", "jp": "「伊東さんのとこのクロが\n　保健所に連れられていったよ‥‥」"},
{"id": 122, "speaker": 14, "form": "dlg", "jp": "「『狂犬病』って恐ろしいな‥‥」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「でも、\n　『狂犬病』って日本じゃほとんど絶滅したって‥‥」"},
{"id": 124, "speaker": 14, "form": "dlg", "jp": "「『ほとんど』っていうのは\n　『０』じゃないってことだろう？」"},
{"id": 125, "speaker": 14, "form": "dlg", "jp": "「最近じゃあ、海外から来た『犬以外の動物』が\n　『狂犬病』にかかってるって言うしな‥‥」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「『犬』じゃないのに『狂犬病』？」"},
{"id": 127, "speaker": 14, "form": "dlg", "jp": "「『アライグマ』とかそういうのが\n　けっこう持ってるらしいぜ‥‥」"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "「なんで『アライグマ』が日本にいるんだ？」"},
{"id": 129, "speaker": 14, "form": "dlg", "jp": "「ペットとして輸入するんだとよ‥‥」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「ふーーん」"},
{"id": 131, "speaker": 14, "form": "dlg", "jp": "「でも、『アライグマ』だろう？」"},
{"id": 132, "speaker": 14, "form": "dlg", "jp": "「犬みたいに予防接種とかしないらしいんだ‥‥」"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "「他に情報は？」"},
{"id": 134, "speaker": 14, "form": "dlg", "jp": "「知らねぇよ‥‥」"},
{"id": 135, "speaker": 14, "form": "dlg", "jp": "「なんでそんなこと知りたがるんだ？」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「なんでもアイコがその現場見たんだって‥‥」"},
{"id": 137, "speaker": 14, "form": "dlg", "jp": "「ふ～～～～ん」"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "「なんか情報持ってない？」"},
{"id": 139, "speaker": 14, "form": "dlg", "jp": "「まあ、本当に『犬』のことが気になるなら\n　『三船』に聞いた方がいいんじゃないか？」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「アイコに？」"},
{"id": 141, "speaker": 14, "form": "dlg", "jp": "「アイツんとこ昔、『犬』飼ってたから\n　オレたちよりは詳しいんじゃないか？」"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「そ、そういえば‥‥」"},
{"id": 143, "speaker": 14, "form": "dlg", "jp": "「とりあえず帰ろうぜ‥‥」"},
{"id": 144, "speaker": 14, "form": "dlg", "jp": "ボクたちはそれぞれ家に帰ることにした。"},
{"id": 145, "speaker": 14, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 146, "speaker": 14, "form": "dlg", "jp": "いったい何しに学校へいったんだか‥‥"},
{"id": 147, "speaker": 13, "form": "dlg", "jp": "「コンチハ‥‥」"},
{"id": 148, "speaker": 3, "form": "dlg", "jp": "「あらっ、角川くん‥‥」"},
{"id": 149, "speaker": 3, "form": "dlg", "jp": "「コンニチハ‥‥」"},
{"id": 150, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～」"},
{"id": 151, "speaker": 3, "form": "dlg", "jp": "「角川くんよ～～」"},
{"id": 152, "speaker": 3, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「やあ！」"},
{"id": 154, "speaker": 13, "form": "dlg", "jp": "「マイド！」"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "「なんか用？」"},
{"id": 156, "speaker": 13, "form": "dlg", "jp": "「なんか用じゃないよ、\n　たまにはクラブに顔だしてくれないと‥‥」"},
{"id": 157, "speaker": 13, "form": "dlg", "jp": "「長尾のヤツ、ウルサくって‥‥」"},
{"id": 158, "speaker": 3, "form": "dlg", "jp": "「じゃあ、姉さんはでかけるけど‥‥」"},
{"id": 159, "speaker": 3, "form": "dlg", "jp": "「ゆっくりしていってね‥‥」"},
{"id": 160, "speaker": 13, "form": "dlg", "jp": "「いえ、ボクたちもスグでますんで‥‥」"},
{"id": 161, "speaker": 3, "form": "dlg", "jp": "「そう、じゃあ戸締まりお願いね‥‥」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「出るって？」"},
{"id": 163, "speaker": 13, "form": "dlg", "jp": "「行くんだろう、クラブ？」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「夏休みだぜ？」"},
{"id": 165, "speaker": 13, "form": "dlg", "jp": "「それでも、出てるクラブとかあるだろう？」"},
{"id": 166, "speaker": 13, "form": "dlg", "jp": "「とにかく、たまには顔を見せないと長尾が‥‥」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "こうしてボクは学校へ行くことになった。"},
{"id": 169, "speaker": 13, "form": "dlg", "jp": "「お姉さん、忙しいのかい？」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「なんだか、近々研究発表があるとか‥‥」"},
{"id": 171, "speaker": 13, "form": "dlg", "jp": "「学者さんも大変なんだな‥‥」"},
{"id": 172, "speaker": 13, "form": "dlg", "jp": "「ガラガラガラ‥‥」"},
{"id": 173, "speaker": 13, "form": "dlg", "jp": "「アレ？？」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「来てないな、長尾‥‥」"},
{"id": 175, "speaker": 13, "form": "dlg", "jp": "「クソ～～～～！！」"},
{"id": 176, "speaker": 13, "form": "dlg", "jp": "「こんなことなら、\n　家で『マグナム探偵』でもやってた方が‥‥」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「それってゲーム？」"},
{"id": 178, "speaker": 13, "form": "dlg", "jp": "「そうだよ、名探偵早川ケンが\n　マグナムをぶっぱなすアクションだよ‥‥」"},
{"id": 179, "speaker": 13, "form": "dlg", "jp": "「まあ、隠れた名作だから、\n　オマエが知らないのもムリないけど‥‥」"},
{"id": 180, "speaker": 13, "form": "dlg", "jp": "「どうする、帰るか？」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「相変わらず勝手なんだから‥‥」"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "そうだ！！"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "ツトムに『謎の狂犬病』のことを聞いてみよう！！"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「なあ、また『犬』が暴れる事件があったって知ってる？」"},
{"id": 185, "speaker": 13, "form": "dlg", "jp": "「『事件』？」"},
{"id": 186, "speaker": 13, "form": "dlg", "jp": "「ただ、犬がかみついただけだろう？」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「知ってるのか？」"},
{"id": 188, "speaker": 13, "form": "dlg", "jp": "「伊東のオバさんのとこのクロが\n　保健所に連れられていったよ‥‥」"},
{"id": 189, "speaker": 13, "form": "dlg", "jp": "「まあ、『狂犬病』かなにかだな‥‥」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "「でも、\n　『狂犬病』って日本じゃほとんど絶滅したって‥‥」"},
{"id": 191, "speaker": 13, "form": "dlg", "jp": "「『ほとんど』っていうのは\n　『０』じゃないってことだろう？」"},
{"id": 192, "speaker": 13, "form": "dlg", "jp": "「別に珍しいことじゃないよ！」"},
{"id": 193, "speaker": 13, "form": "dlg", "jp": "「そんなことより、何をそんなに\n　『犬』にこだわってるんだよ！」"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "「いや、最近この近所で『犬』の事件が\n　あいついで起きてるだろう？」"},
{"id": 195, "speaker": 13, "form": "dlg", "jp": "「なるほど、『事件』の方に興味があるんだな？」"},
{"id": 196, "speaker": 13, "form": "dlg", "jp": "「『名探偵常光寺ナゴム』ってことだ！」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「別にそんなんじゃないけど‥‥」"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "「なんでもアイコがその現場見たんだって‥‥」"},
{"id": 199, "speaker": 13, "form": "dlg", "jp": "「『目撃者』ってヤツだな‥‥」"},
{"id": 200, "speaker": 13, "form": "dlg", "jp": "「ってことは犯人は『相棒のヤっさん』？」"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "「犯人も相棒もいないだろう？」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「なんだよ、人がマジメに聞いてるのに‥‥」"},
{"id": 203, "speaker": 13, "form": "dlg", "jp": "「そんなに気にすることじゃないだろう？」"},
{"id": 204, "speaker": 13, "form": "dlg", "jp": "「『犬』が『人にかみつく』のなんて\n　別に普通のことだろう？」"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "「もういいよ‥‥」"},
{"id": 206, "speaker": 13, "form": "dlg", "jp": "「まあ、そう怒るなよ！」"},
{"id": 207, "speaker": 13, "form": "dlg", "jp": "「とにかく、『犬』のことは\n　オレに聞いてもムダだってことだ‥‥」"},
{"id": 208, "speaker": 13, "form": "dlg", "jp": "「オレ、動物にぜんぜんキョウミないから‥‥」"},
{"id": 209, "speaker": 13, "form": "dlg", "jp": "「まあ、本当に『犬』のことが気になるなら\n　『三船』に聞いた方がいいんじゃないか？」"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "「アイコに？」"},
{"id": 211, "speaker": 13, "form": "dlg", "jp": "「目撃者なんだろう？」"},
{"id": 212, "speaker": 13, "form": "dlg", "jp": "「それにアイツんとこ昔、『犬』飼ってたから\n　オレたちよりは詳しいんじゃないか？」"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "「そ、そういえば‥‥」"},
{"id": 214, "speaker": 13, "form": "dlg", "jp": "「じゃあ、帰ろうぜ！！」"},
{"id": 215, "speaker": 13, "form": "dlg", "jp": "ボクたちはそれぞれ家に帰ることにした。"},
{"id": 216, "speaker": 13, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 217, "speaker": 13, "form": "dlg", "jp": "いったい何しに学校へいったんだか‥‥"},
{"id": 218, "speaker": 14, "form": "dlg", "jp": "「コンチハ‥‥」"},
{"id": 219, "speaker": 3, "form": "dlg", "jp": "「あらっ、関口くん‥‥」"},
{"id": 220, "speaker": 3, "form": "dlg", "jp": "「コンニチハ‥‥」"},
{"id": 221, "speaker": 13, "form": "dlg", "jp": "「どうも‥‥」"},
{"id": 222, "speaker": 3, "form": "dlg", "jp": "「角川くんも‥‥」"},
{"id": 223, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～」"},
{"id": 224, "speaker": 3, "form": "dlg", "jp": "「関口くんたちよ～～」"},
{"id": 225, "speaker": 3, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「ウィッス！！」"},
{"id": 227, "speaker": 14, "form": "dlg", "jp": "「ウィッス！！」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「まあ、あがれよ‥‥」"},
{"id": 229, "speaker": 3, "form": "dlg", "jp": "「じゃあ、姉さんはでかけるから‥‥」"},
{"id": 230, "speaker": 3, "form": "dlg", "jp": "「関口くんたちはゆっくりしていってね‥‥」"},
{"id": 231, "speaker": 13, "form": "dlg", "jp": "「どうもすみません‥‥」"},
{"id": 232, "speaker": 13, "form": "dlg", "jp": "「お姉さん、忙しいのかい？」"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "「なんだか、近々研究発表があるとか‥‥」"},
{"id": 234, "speaker": 14, "form": "dlg", "jp": "「学者さんも大変なんだな‥‥」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「で、なんか用？」"},
{"id": 236, "speaker": 14, "form": "dlg", "jp": "「用なんてねぇーよ！」"},
{"id": 237, "speaker": 14, "form": "dlg", "jp": "「たいくつだからちょっと遊びにきただけ‥‥」"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "「勉強しろよ！」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「受験生なんだろう？」"},
{"id": 240, "speaker": 14, "form": "dlg", "jp": "「受験生は勉強以外しちゃいけないのかよ！」"},
{"id": 241, "speaker": 14, "form": "dlg", "jp": "「だいたいオマエはどれだけ勉強してるんだ？」"},
{"id": 242, "speaker": 14, "form": "dlg", "jp": "「言っとくけど、\n　オマエよりオレの方が成績いいんだぜ？」"},
{"id": 243, "speaker": 14, "form": "dlg", "jp": "たしかにシンちゃんは学年でもトップクラスだ。"},
{"id": 244, "speaker": 14, "form": "dlg", "jp": "しかし、シンちゃんが\nマジメに勉強をしているのを見たことがない。"},
{"id": 245, "speaker": 14, "form": "dlg", "jp": "ウチの学校の７不思議の１つだ‥‥"},
{"id": 246, "speaker": 14, "form": "dlg", "jp": "‥‥あとの６つは良く知らないケド‥‥"},
{"id": 247, "speaker": 13, "form": "dlg", "jp": "「どうせ、ナゴムもタイクツしてたんだろう？」"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "「別にボクは‥‥」"},
{"id": 249, "speaker": 13, "form": "dlg", "jp": "「まあ、男なんだから細かいことは気にするな‥‥」"},
{"id": 250, "speaker": 13, "form": "dlg", "jp": "勝手なことばっか言いやがって‥‥"},
{"id": 251, "speaker": 13, "form": "dlg", "jp": "そうだ！！"},
{"id": 252, "speaker": 13, "form": "dlg", "jp": "コイツらに『謎の狂犬病』のことを聞いてみよう！！"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "「なあ、また『犬』が暴れる事件があったって知ってる？」"},
{"id": 254, "speaker": 13, "form": "dlg", "jp": "「『事件』？」"},
{"id": 255, "speaker": 13, "form": "dlg", "jp": "「ただ、犬がかみついただけだろう？」"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "「知ってるのか？」"},
{"id": 257, "speaker": 13, "form": "dlg", "jp": "「伊東のオバさんのとこのクロが\n　保健所に連れられていったよ‥‥」"},
{"id": 258, "speaker": 13, "form": "dlg", "jp": "「まあ、『狂犬病』かなにかだな‥‥」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「でも、\n　『狂犬病』って日本じゃほとんど絶滅したって‥‥」"},
{"id": 260, "speaker": 14, "form": "dlg", "jp": "「『ほとんど』っていうのは\n　『０』じゃないってことだろう？」"},
{"id": 261, "speaker": 14, "form": "dlg", "jp": "「最近じゃあ、海外から来た『犬以外の動物』が\n　『狂犬病』にかかってるって言うしな‥‥」"},
{"id": 262, "speaker": 13, "form": "dlg", "jp": "「『犬』じゃないのに『狂犬病』？」"},
{"id": 263, "speaker": 14, "form": "dlg", "jp": "「『アライグマ』とかそういうのが\n　けっこう持ってるらしいぜ‥‥」"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "「なんで『アライグマ』が日本にいるんだ？」"},
{"id": 265, "speaker": 14, "form": "dlg", "jp": "「ペットとして輸入するんだとよ‥‥」"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "「ふーーん」"},
{"id": 267, "speaker": 14, "form": "dlg", "jp": "「でも、『アライグマ』だろう？」"},
{"id": 268, "speaker": 14, "form": "dlg", "jp": "「犬みたいに予防接種とかしないらしいんだ‥‥」"},
{"id": 269, "speaker": 13, "form": "dlg", "jp": "「シンちゃんは博学だねぇ～～」"},
{"id": 270, "speaker": 14, "form": "dlg", "jp": "「オマエが『ゲーム』以外のことを\n　勉強しなさすぎなんだよ‥‥」"},
{"id": 271, "speaker": 13, "form": "dlg", "jp": "「いいじゃん別に‥‥」"},
{"id": 272, "speaker": 13, "form": "dlg", "jp": "「なにか１つだけでも自慢できることがあれば‥‥」"},
{"id": 273, "speaker": 14, "form": "dlg", "jp": "「ゲームに詳しいって、自慢できることか？」"},
{"id": 274, "speaker": 13, "form": "dlg", "jp": "「何言ってんだよ、すごい自慢だよ‥‥」"},
{"id": 275, "speaker": 13, "form": "dlg", "jp": "「『拳道４』の『１００連勝カード』が\n　ネットオークションでいくらの値がついてると思う？」"},
{"id": 276, "speaker": 13, "form": "dlg", "jp": "「海の向こうじゃ\n　『プロのゲーマー』がいるぐらいなんだぜ！」"},
{"id": 277, "speaker": 2, "form": "dlg", "jp": "「そんな国ぜったい住みたくないな‥‥」"},
{"id": 278, "speaker": 14, "form": "dlg", "jp": "「そんなことより、何をそんなに\n　『犬』にこだわってるんだよ！」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "「いや、最近この近所で『犬』の事件が\n　あいついで起きてるだろう？」"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "「なんでもアイコがその現場見たんだって‥‥」"},
{"id": 281, "speaker": 13, "form": "dlg", "jp": "「『犬』のことは『犬の専門家』にでも\n　まかせておいたらどうだ？」"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "「『犬の専門家』？」"},
{"id": 283, "speaker": 13, "form": "dlg", "jp": "「『犬のおまわりさん』とか‥‥」"},
{"id": 284, "speaker": 14, "form": "dlg", "jp": "「そいつは鳴いてばかりで役にたちそうもないな‥‥」"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "「なんだよ、人がマジメに聞いてるのに‥‥」"},
{"id": 286, "speaker": 14, "form": "dlg", "jp": "「そんなに気にすることじゃないだろう？」"},
{"id": 287, "speaker": 14, "form": "dlg", "jp": "「『犬』が『人にかみつく』のなんて\n　別に普通のことだろう？」"},
{"id": 288, "speaker": 14, "form": "dlg", "jp": "「『犬が三毛猫を産むって一族』なら事件だけど‥‥」"},
{"id": 289, "speaker": 13, "form": "dlg", "jp": "「『イヌがミケのイチゾク』だな‥‥」"},
{"id": 290, "speaker": 13, "form": "dlg", "jp": "「それを解決するのは\n　『三毛猫のホームズ』だな‥‥」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「もういいよ‥‥」"},
{"id": 292, "speaker": 14, "form": "dlg", "jp": "「まあ、そう怒るなよ！」"},
{"id": 293, "speaker": 13, "form": "dlg", "jp": "「そうそう‥‥」"},
{"id": 294, "speaker": 13, "form": "dlg", "jp": "「オレたちも茶のいっぱいも出ないところで\n　相手してやってんだから‥‥」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "「わるかったな！！」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「タン、タン、タン、タン、タン‥‥」"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "ボクはお茶を入れるために\nいったんキッチンへおりていった。"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "「ホラよ！」"},
{"id": 300, "speaker": 14, "form": "dlg", "jp": "「なんだ、本当にお茶をもってきたのか？」"},
{"id": 301, "speaker": 13, "form": "dlg", "jp": "「ふつう、あんな風に言われたら、\n　ジュースかなにかを出すよな‥‥」"},
{"id": 302, "speaker": 2, "form": "dlg", "jp": "「オマエら本当にタチが悪いな‥‥」"},
{"id": 303, "speaker": 14, "form": "dlg", "jp": "「ハッハハハハハ‥‥」"},
{"id": 304, "speaker": 13, "form": "dlg", "jp": "「とにかく、『犬』のことは\n　オレたちに聞いてもムダだってことだ‥‥」"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「何、まとめようとしてるんだよ‥‥」"},
{"id": 306, "speaker": 13, "form": "dlg", "jp": "「いや、マジで‥‥」"},
{"id": 307, "speaker": 13, "form": "dlg", "jp": "「オレ、動物にぜんぜんキョウミないから‥‥」"},
{"id": 308, "speaker": 14, "form": "dlg", "jp": "「というより、３次元の生き物すべてに\n　キョウミがないんだろう？」"},
{"id": 309, "speaker": 13, "form": "dlg", "jp": "「シッケイな！！」"},
{"id": 310, "speaker": 13, "form": "dlg", "jp": "「『声優』はベツバラだよ！」"},
{"id": 311, "speaker": 14, "form": "dlg", "jp": "「まあ、本当に『犬』のことが気になるなら\n　『三船』に聞いた方がいいんじゃないか？」"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "「アイコに？」"},
{"id": 313, "speaker": 14, "form": "dlg", "jp": "「アイツんとこ昔、『犬』飼ってたから\n　オレたちよりは詳しいんじゃないか？」"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "「そ、そういえば‥‥」"},
{"id": 315, "speaker": 14, "form": "dlg", "jp": "「じゃあ、ジャマしたな‥‥」"},
{"id": 316, "speaker": 13, "form": "dlg", "jp": "「お姉さまによろしくな‥‥」"},
{"id": 317, "speaker": 13, "form": "dlg", "jp": "こうして、シンちゃんたちは帰っていった。"},
{"id": 318, "speaker": 13, "form": "dlg", "jp": "さてと、これからどうするかな？"},
{"id": 319, "speaker": 13, "form": "choice", "jp": "【アイコに会って話を聞いてみるか‥‥】"},
{"id": 320, "speaker": 13, "form": "choice", "jp": "【ジーンに報告しておくか‥‥】"},
{"id": 321, "speaker": 13, "form": "dlg", "jp": "【アイコに会って話を聞いてみるか‥‥】"},
{"id": 322, "speaker": 13, "form": "dlg", "jp": "たぶん、この時間ならまだ学校にいるハズだ。"},
{"id": 323, "speaker": 13, "form": "dlg", "jp": "ボクは部活に出ているアイコに会うために\n学校に行くことにした。"},
{"id": 324, "speaker": 13, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 325, "speaker": 13, "form": "dlg", "jp": "アイコたちのバレー部はこの夏の大会で\n３年生は引退となるため、"},
{"id": 326, "speaker": 13, "form": "dlg", "jp": "夏休みにもかかわらず、ほぼ毎日のように\n練習が行われていた。"},
{"id": 327, "speaker": 17, "form": "dlg", "jp": "「常光寺！！」"},
{"id": 328, "speaker": 17, "form": "dlg", "jp": "それは『体育教師』の大本先生の声だった。"},
{"id": 329, "speaker": 17, "form": "dlg", "jp": "「夏休みに登校してくるなんて、\n　オマエ、クラブやってたっけ？」"},
{"id": 330, "speaker": 2, "form": "dlg", "jp": "「ま、まあ一応‥‥」"},
{"id": 331, "speaker": 17, "form": "dlg", "jp": "「じゃあ、アレだな‥‥」"},
{"id": 332, "speaker": 17, "form": "dlg", "jp": "「夏休みも猛練習ってヤツだ‥‥」"},
{"id": 333, "speaker": 17, "form": "dlg", "jp": "「いや、立派、立派‥‥」"},
{"id": 334, "speaker": 2, "form": "dlg", "jp": "（文化部なんだけど‥‥）"},
{"id": 335, "speaker": 2, "form": "dlg", "jp": "「こ、顧問のクセに‥‥」"},
{"id": 336, "speaker": 17, "form": "dlg", "jp": "「そうだったな‥‥」"},
{"id": 337, "speaker": 17, "form": "dlg", "jp": "「じゃあ、アレだな‥‥」"},
{"id": 338, "speaker": 17, "form": "dlg", "jp": "「夏休みも猛練習ってヤツだ‥‥」"},
{"id": 339, "speaker": 17, "form": "dlg", "jp": "「いや、立派、立派‥‥」"},
{"id": 340, "speaker": 2, "form": "dlg", "jp": "「野球部です‥‥」"},
{"id": 341, "speaker": 17, "form": "dlg", "jp": "「そうだったな‥‥」"},
{"id": 342, "speaker": 17, "form": "dlg", "jp": "「じゃあ、アレだな‥‥」"},
{"id": 343, "speaker": 17, "form": "dlg", "jp": "「夏休みも猛練習ってヤツだ‥‥」"},
{"id": 344, "speaker": 17, "form": "dlg", "jp": "「いや、立派、立派‥‥」"},
{"id": 345, "speaker": 2, "form": "dlg", "jp": "「いえ、別に‥‥」"},
{"id": 346, "speaker": 17, "form": "dlg", "jp": "「そうだよな‥‥」"},
{"id": 347, "speaker": 17, "form": "dlg", "jp": "「じゃあ、アレだな‥‥」"},
{"id": 348, "speaker": 17, "form": "dlg", "jp": "「図書室で受験勉強ってヤツだな‥‥」"},
{"id": 349, "speaker": 17, "form": "dlg", "jp": "「いや、立派、立派‥‥」"},
{"id": 350, "speaker": 17, "form": "choice", "jp": "【ついでに先生にも聞いてみるか‥‥】"},
{"id": 351, "speaker": 17, "form": "choice", "jp": "【いや、この先生に聞いても‥‥】"},
{"id": 352, "speaker": 17, "form": "dlg", "jp": "【いや、この先生に聞いても‥‥】"},
{"id": 353, "speaker": 2, "form": "dlg", "jp": "「じゃあ、失礼します‥‥」"},
{"id": 354, "speaker": 17, "form": "dlg", "jp": "「じゃあな‥‥」"},
{"id": 355, "speaker": 17, "form": "dlg", "jp": "とにかく、アイコから話を聞くとするか‥‥"},
{"id": 356, "speaker": 17, "form": "dlg", "jp": "ボクはバレー部の部室の方へ行くことにした。"},
{"id": 357, "speaker": 17, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 358, "speaker": 17, "form": "dlg", "jp": "【ついでに先生にも聞いてみるか‥‥】"},
{"id": 359, "speaker": 2, "form": "dlg", "jp": "「そう言えば先生‥‥」"},
{"id": 360, "speaker": 17, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 361, "speaker": 2, "form": "dlg", "jp": "「先生は『犬の事件』って知ってます？」"},
{"id": 362, "speaker": 17, "form": "dlg", "jp": "「『犬の事件』？」"},
{"id": 363, "speaker": 17, "form": "dlg", "jp": "「なんだ、そりゃ？」"},
{"id": 364, "speaker": 2, "form": "dlg", "jp": "「最近、\n　多発してる『犬が人を襲う事件』のことですよ‥‥」"},
{"id": 365, "speaker": 2, "form": "dlg", "jp": "「新聞とかにものってるでしょう？」"},
{"id": 366, "speaker": 17, "form": "dlg", "jp": "「新聞？」"},
{"id": 367, "speaker": 17, "form": "dlg", "jp": "「何新聞だ？」"},
{"id": 368, "speaker": 17, "form": "dlg", "jp": "「スポーツ新聞にものってたか？」"},
{"id": 369, "speaker": 2, "form": "dlg", "jp": "「さあ、それは？」"},
{"id": 370, "speaker": 17, "form": "dlg", "jp": "「スポーツ新聞にのってないんだったら\n　オレにはわからんな‥‥」"},
{"id": 371, "speaker": 2, "form": "dlg", "jp": "「そ、そんな‥‥」"},
{"id": 372, "speaker": 17, "form": "dlg", "jp": "「オレは体育教師だからな‥‥」"},
{"id": 373, "speaker": 17, "form": "dlg", "jp": "「まあ、専門外っていうヤツだな‥‥」"},
{"id": 374, "speaker": 17, "form": "dlg", "jp": "「そういうことは科学の\n　『高塚先生』に聞くといいんじゃないか？」"},
{"id": 375, "speaker": 17, "form": "dlg", "jp": "「あの先生は大学で『生物』を専攻してたらしいし‥‥」"},
{"id": 376, "speaker": 17, "form": "dlg", "jp": "「犬のこともくわしいんじゃないか？」"},
{"id": 377, "speaker": 2, "form": "dlg", "jp": "「いえ、ボクは『犬』のことが知りたいんじゃなくて‥‥」"},
{"id": 378, "speaker": 2, "form": "dlg", "jp": "「『犬の事件』が知りたいだけなんですけど‥‥」"},
{"id": 379, "speaker": 17, "form": "dlg", "jp": "「そんなコト知ってどうするんだ？」"},
{"id": 380, "speaker": 17, "form": "dlg", "jp": "「心配せんでも、そんなものは受験には出ないな‥‥」"},
{"id": 381, "speaker": 17, "form": "dlg", "jp": "「じゃあ、\n　オレは帰ってテレビを見なくちゃならんから‥‥」"},
{"id": 382, "speaker": 2, "form": "dlg", "jp": "「ちょっと待ってくださいよ‥‥」"},
{"id": 383, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥"},
{"id": 384, "speaker": 2, "form": "dlg", "jp": "あの先生に聞いたボクが間違いだったな‥‥"},
{"id": 385, "speaker": 2, "form": "dlg", "jp": "とにかく、アイコから話を聞くとするか‥‥"},
{"id": 386, "speaker": 2, "form": "dlg", "jp": "ボクはバレー部の部室の方へ行くことにした。"},
{"id": 387, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 388, "speaker": 2, "form": "dlg", "jp": "さてと‥‥"},
{"id": 389, "speaker": 2, "form": "dlg", "jp": "バレー部はどこだ？"},
{"id": 390, "speaker": 15, "form": "dlg", "jp": "「アラ、ナゴムちゃん！？」"},
{"id": 391, "speaker": 2, "form": "dlg", "jp": "「アイコ、ちょうどよかった！」"},
{"id": 392, "speaker": 2, "form": "dlg", "jp": "「今、オマエを探してたところなんだよ‥‥」"},
{"id": 393, "speaker": 15, "form": "dlg", "jp": "「どうして私を？」"},
{"id": 394, "speaker": 2, "form": "dlg", "jp": "「ちょっと聞きたいことあるんだよ‥‥」"},
{"id": 395, "speaker": 15, "form": "dlg", "jp": "「えっ、何？」"},
{"id": 396, "speaker": 2, "form": "dlg", "jp": "「今、大丈夫なのか？」"},
{"id": 397, "speaker": 15, "form": "dlg", "jp": "「ダメよ、まだ練習終わってないし‥‥」"},
{"id": 398, "speaker": 15, "form": "dlg", "jp": "「また、あとで来てよ！」"},
{"id": 399, "speaker": 2, "form": "dlg", "jp": "「あとでって、いつだよ‥‥」"},
{"id": 400, "speaker": 15, "form": "dlg", "jp": "「『夕方』‥‥」"},
{"id": 401, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 402, "speaker": 2, "form": "dlg", "jp": "アイコも夏休みまでたいへんだな‥‥"},
{"id": 403, "speaker": 2, "form": "dlg", "jp": "さてと‥‥"},
{"id": 404, "speaker": 2, "form": "dlg", "jp": "それじゃあここにいてもしょうがないし‥‥"},
{"id": 405, "speaker": 2, "form": "dlg", "jp": "【ジーンに報告しておくか‥‥】"},
{"id": 406, "speaker": 2, "form": "dlg", "jp": "ボクはジーンに報告しに行くことにした。"},
{"id": 407, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 408, "speaker": 2, "form": "dlg", "jp": "「コン！コン！」"},
{"id": 409, "speaker": 2, "form": "dlg", "jp": "「ボクだよ、ナゴム‥‥」"},
{"id": 410, "speaker": 31, "form": "dlg", "jp": "「開いてるよ‥‥」"},
{"id": 411, "speaker": 31, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 412, "speaker": 29, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 413, "speaker": 2, "form": "dlg", "jp": "「また、『犬』が人を襲ったらしいんだよ！」"},
{"id": 414, "speaker": 31, "form": "dlg", "jp": "「本当か！？」"},
{"id": 415, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 416, "speaker": 2, "form": "dlg", "jp": "「知り合いの女の子が現場を見たんだって‥‥」"},
{"id": 417, "speaker": 2, "form": "dlg", "jp": "「あの『死体を操るヤツ』の仕業じゃなかったの？」"},
{"id": 418, "speaker": 29, "form": "dlg", "jp": "「そうじゃなかったのよ‥‥」"},
{"id": 419, "speaker": 2, "form": "dlg", "jp": "「なんだ、知ってたの？」"},
{"id": 420, "speaker": 31, "form": "dlg", "jp": "「本部から"},
{"id": 421, "speaker": 31, "form": "dlg", "jp": "新しい『データＣＤ』"},
{"id": 422, "speaker": 31, "form": "dlg", "jp": "が届いたんだよ」"},
{"id": 423, "speaker": 31, "form": "dlg", "jp": "「で、それを見たら‥‥」"},
{"id": 424, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って、どうやって見たの？」"},
{"id": 425, "speaker": 29, "form": "dlg", "jp": "「買ったのよ！　パソコン‥‥」"},
{"id": 426, "speaker": 29, "form": "dlg", "jp": "「早く見ないとこないだみたいなことになるから‥‥」"},
{"id": 427, "speaker": 31, "form": "dlg", "jp": "「で、そのデータとこないだのアイツのデータが\n　ぜんぜん一致しなかったんだよ」"},
{"id": 428, "speaker": 2, "form": "dlg", "jp": "「つまり？」"},
{"id": 429, "speaker": 29, "form": "dlg", "jp": "「『犬の事件』は"},
{"id": 430, "speaker": 29, "form": "dlg", "jp": "別の能力者"},
{"id": 431, "speaker": 29, "form": "dlg", "jp": "の仕業ってことよ‥‥」"},
{"id": 432, "speaker": 2, "form": "dlg", "jp": "「で、その『データ』ってどんな内容だったの？」"},
{"id": 433, "speaker": 29, "form": "dlg", "jp": "「本部がキャッチした『邪悪な念』の\n　観測されたポイントよ‥‥」"},
{"id": 434, "speaker": 31, "form": "dlg", "jp": "「観測されたポイントは全部で３箇所‥‥」"},
{"id": 435, "speaker": 2, "form": "dlg", "jp": "「たった３箇所？」"},
{"id": 436, "speaker": 31, "form": "dlg", "jp": "「本部の連中が『キャッチ』できたのが\n　３回だけってことだ‥‥」"},
{"id": 437, "speaker": 31, "form": "dlg", "jp": "「でもって、その３箇所がすべて\n　"},
{"id": 438, "speaker": 31, "form": "dlg", "jp": "『犬の事件』の『発生現場』"},
{"id": 439, "speaker": 31, "form": "dlg", "jp": "だったんだよ‥‥」"},
{"id": 440, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って、『事件の発生現場』ってどういうこと？」"},
{"id": 441, "speaker": 29, "form": "dlg", "jp": "「その場所で『能力』を使ったってことね‥‥」"},
{"id": 442, "speaker": 2, "form": "dlg", "jp": "「じゃあ、事件現場にソイツがいたってこと？」"},
{"id": 443, "speaker": 29, "form": "dlg", "jp": "「ただし、『事件発生当時』じゃないわよ‥‥」"},
{"id": 444, "speaker": 2, "form": "dlg", "jp": "「はぁ？」"},
{"id": 445, "speaker": 31, "form": "dlg", "jp": "「事件と記録と照らし合わせると‥‥」"},
{"id": 446, "speaker": 31, "form": "dlg", "jp": "「『能力の使われた時間』と\n　『事件の起きた時間』に"},
{"id": 447, "speaker": 31, "form": "dlg", "jp": "１時間ほどのズレ"},
{"id": 448, "speaker": 31, "form": "dlg", "jp": "があるんだ」"},
{"id": 449, "speaker": 29, "form": "dlg", "jp": "「つまり、ソイツはリアルタイムに\n　犬をコントロールしているんじゃないってことよ！」"},
{"id": 450, "speaker": 2, "form": "dlg", "jp": "「じゃあ、『犬を操る能力』じゃあないってこと？」"},
{"id": 451, "speaker": 29, "form": "dlg", "jp": "「そうとは言い切れないわね‥‥」"},
{"id": 452, "speaker": 29, "form": "dlg", "jp": "「実際、『犬の事件』のポイントと\n　『邪悪な念』がキャッチされたポイントが」"},
{"id": 453, "speaker": 29, "form": "dlg", "jp": "「ぴったり一致するんだから、『能力者』が\n　事件に関係しているのは間違いないわね‥‥」"},
{"id": 454, "speaker": 29, "form": "dlg", "jp": "「ただ、時間がずれている以上、\n　リアルタイムに操っていないのも間違いないわね‥‥」"},
{"id": 455, "speaker": 29, "form": "dlg", "jp": "「考えられるのは『時限装置』のような能力かも‥‥」"},
{"id": 456, "speaker": 2, "form": "dlg", "jp": "「『時限装置』？」"},
{"id": 457, "speaker": 29, "form": "dlg", "jp": "「なんらかの命令を犬に与えておいて、\n　時間がたってから発動させるような能力ね‥‥」"},
{"id": 458, "speaker": 2, "form": "dlg", "jp": "「そんなこと可能なの？」"},
{"id": 459, "speaker": 29, "form": "dlg", "jp": "「さあ、『能力』っていろいろだから‥‥」"},
{"id": 460, "speaker": 29, "form": "dlg", "jp": "「とにかく、"},
{"id": 461, "speaker": 29, "form": "dlg", "jp": "『犬の事件』"},
{"id": 462, "speaker": 29, "form": "dlg", "jp": "が\n　"},
{"id": 463, "speaker": 29, "form": "dlg", "jp": "『能力者の仕業』"},
{"id": 464, "speaker": 29, "form": "dlg", "jp": "ってことは間違いなさそうね‥‥」"},
{"id": 465, "speaker": 31, "form": "dlg", "jp": "「ナゴムの知り合いのコが事件を見たんだろう？」"},
{"id": 466, "speaker": 31, "form": "dlg", "jp": "「そのコから、なんか情報を引き出せないか？」"},
{"id": 467, "speaker": 2, "form": "dlg", "jp": "「わかったやってみるよ‥‥」"},
{"id": 468, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 469, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 470, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 471, "speaker": 2, "form": "dlg", "jp": "今の時間だとアイコはまだ学校だろうな‥‥"},
{"id": 472, "speaker": 2, "form": "dlg", "jp": "よし学校へ行ってみよう！！"},
{"id": 473, "speaker": 2, "form": "dlg", "jp": "ボクは学校に行くことにした。"},
{"id": 474, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 475, "speaker": 2, "form": "dlg", "jp": "アイコたちのバレー部はこの夏の大会で\n３年生は引退となるため、"},
{"id": 476, "speaker": 2, "form": "dlg", "jp": "夏休みにもかかわらず、ほぼ毎日のように\n練習が行われていた。"},
{"id": 477, "speaker": 2, "form": "dlg", "jp": "そろそろアイコの部活も終わったころかな‥‥"},
{"id": 478, "speaker": 2, "form": "dlg", "jp": "よし学校へ行ってみよう！！"},
{"id": 479, "speaker": 2, "form": "dlg", "jp": "ボクは再び学校に行くことにした。"},
{"id": 480, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 481, "speaker": 2, "form": "dlg", "jp": "さてと‥‥"},
{"id": 482, "speaker": 2, "form": "dlg", "jp": "バレー部はどこだ？"},
{"id": 483, "speaker": 15, "form": "dlg", "jp": "「アラ、ナゴムちゃん！？」"},
{"id": 484, "speaker": 2, "form": "dlg", "jp": "「アイコ、ちょうどよかった！」"},
{"id": 485, "speaker": 2, "form": "dlg", "jp": "「今、オマエを探してたところなんだよ‥‥」"},
{"id": 486, "speaker": 15, "form": "dlg", "jp": "「どうして私を？」"},
{"id": 487, "speaker": 2, "form": "dlg", "jp": "「ちょっと聞きたいことあるんだよ‥‥」"},
{"id": 488, "speaker": 15, "form": "dlg", "jp": "「えっ、何？」"},
{"id": 489, "speaker": 2, "form": "dlg", "jp": "「今、大丈夫なのか？」"},
{"id": 490, "speaker": 15, "form": "dlg", "jp": "「いいわよ、部活も終わってるし‥‥」"},
{"id": 491, "speaker": 15, "form": "dlg", "jp": "ボクはすでに部活を終えてるであろう\nバレー部の部室へと向かった。"},
{"id": 492, "speaker": 15, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 493, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん！！」"},
{"id": 494, "speaker": 2, "form": "dlg", "jp": "「アイコ！！」"},
{"id": 495, "speaker": 2, "form": "dlg", "jp": "「どう？　部活終わった？」"},
{"id": 496, "speaker": 15, "form": "dlg", "jp": "「ウン‥‥」"},
{"id": 497, "speaker": 15, "form": "dlg", "jp": "「で、聞きたいことって何？」"},
{"id": 498, "speaker": 2, "form": "dlg", "jp": "「オマエさあ、\n　今朝、『犬が人を襲う』のを見たんだろう？」"},
{"id": 499, "speaker": 15, "form": "dlg", "jp": "「見たわよ‥‥」"},
{"id": 500, "speaker": 15, "form": "dlg", "jp": "「それがどうかしたの？」"},
{"id": 501, "speaker": 2, "form": "dlg", "jp": "「うん、ちょっと気になってね‥‥」"},
{"id": 502, "speaker": 15, "form": "dlg", "jp": "「気になったらいちいち調べるの？」"},
{"id": 503, "speaker": 15, "form": "dlg", "jp": "「もしかして、『探偵ゴッコ』？」"},
{"id": 504, "speaker": 2, "form": "dlg", "jp": "「なんでもいいから、その時の話きかせてくれよ」"},
{"id": 505, "speaker": 15, "form": "dlg", "jp": "「いいけど‥‥」"},
{"id": 506, "speaker": 2, "form": "dlg", "jp": "「で、なんで朝早くにそんなとこへ？」"},
{"id": 507, "speaker": 15, "form": "dlg", "jp": "「毎朝ランニングをしてるの」"},
{"id": 508, "speaker": 15, "form": "dlg", "jp": "「ちょうどそのコースが\n　伊東さんの家の前だったの‥‥」"},
{"id": 509, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ランニング中に見たんだ？」"},
{"id": 510, "speaker": 15, "form": "dlg", "jp": "「そうよ！」"},
{"id": 511, "speaker": 15, "form": "dlg", "jp": "「ちょうど、\n　伊東さんちの手前ぐらいまで走って来た時に‥‥」"},
{"id": 512, "speaker": 15, "form": "dlg", "jp": "「前を歩いていた女の人がいきなり\n　悲鳴をあげたのよ！！」"},
{"id": 513, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥！」"},
{"id": 514, "speaker": 15, "form": "dlg", "jp": "「で、そのまま女の人のところまでかけよったら‥‥」"},
{"id": 515, "speaker": 15, "form": "dlg", "jp": "「ガブガブガブって、クロが女の人を‥‥」"},
{"id": 516, "speaker": 2, "form": "dlg", "jp": "「で、アイコは大丈夫だったのか？」"},
{"id": 517, "speaker": 15, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 518, "speaker": 15, "form": "dlg", "jp": "「それがちょっと不思議なのよ‥‥」"},
{"id": 519, "speaker": 2, "form": "dlg", "jp": "「不思議？」"},
{"id": 520, "speaker": 15, "form": "dlg", "jp": "「たしかにその女の人にクロがかみついたんだけど、\n　３回程かみついたあとは大人しくなっちゃって‥‥」"},
{"id": 521, "speaker": 2, "form": "dlg", "jp": "「大人しくなった！？」"},
{"id": 522, "speaker": 15, "form": "dlg", "jp": "「そうなの‥‥」"},
{"id": 523, "speaker": 2, "form": "dlg", "jp": "「でも、保健所につれていかれちゃったんだろう？」"},
{"id": 524, "speaker": 15, "form": "dlg", "jp": "「まあ、相手の女の人は首筋かまれて\n　かなりのケガをしたみたいだし‥‥」"},
{"id": 525, "speaker": 15, "form": "dlg", "jp": "「私があわてて救急車呼ばなかったら\n　死んじゃってたかも‥‥」"},
{"id": 526, "speaker": 2, "form": "dlg", "jp": "「ヘビーなもの見たんだな‥‥」"},
{"id": 527, "speaker": 2, "form": "dlg", "jp": "「そこにはアイコしかいなかったのか？」"},
{"id": 528, "speaker": 15, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 529, "speaker": 15, "form": "dlg", "jp": "「もう１人、"},
{"id": 530, "speaker": 15, "form": "dlg", "jp": "オジさんがいた"},
{"id": 531, "speaker": 15, "form": "dlg", "jp": "みたいだけど‥‥」"},
{"id": 532, "speaker": 15, "form": "dlg", "jp": "オジさん！！"},
{"id": 533, "speaker": 2, "form": "dlg", "jp": "「オジさんがいたのかい？」"},
{"id": 534, "speaker": 15, "form": "dlg", "jp": "「道路に"},
{"id": 535, "speaker": 15, "form": "dlg", "jp": "車を停めて寝てた"},
{"id": 536, "speaker": 15, "form": "dlg", "jp": "みたい‥‥」"},
{"id": 537, "speaker": 15, "form": "dlg", "jp": "「救急車が来るまで、\n　全然気がつかなかったみたいだし‥‥」"},
{"id": 538, "speaker": 2, "form": "dlg", "jp": "「そうなの？」"},
{"id": 539, "speaker": 15, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 540, "speaker": 15, "form": "dlg", "jp": "「私も初めは誰もいないと思ってたんだけど‥‥」"},
{"id": 541, "speaker": 15, "form": "dlg", "jp": "「救急車が到着したら車からあわてておりてきて\n　"},
{"id": 542, "speaker": 15, "form": "dlg", "jp": "救急隊の手伝い"},
{"id": 543, "speaker": 15, "form": "dlg", "jp": "をしていたわ‥‥」"},
{"id": 544, "speaker": 2, "form": "dlg", "jp": "「救急隊の手伝いをした？」"},
{"id": 545, "speaker": 15, "form": "dlg", "jp": "「そうよ！」"},
{"id": 546, "speaker": 15, "form": "dlg", "jp": "ってことは悪い人じゃなさそうだな‥‥"},
{"id": 547, "speaker": 2, "form": "dlg", "jp": "「ほかに何かなかった？」"},
{"id": 548, "speaker": 15, "form": "dlg", "jp": "「何かって？」"},
{"id": 549, "speaker": 2, "form": "dlg", "jp": "「そこに『時計』があったとか？」"},
{"id": 550, "speaker": 15, "form": "dlg", "jp": "「はあ？」"},
{"id": 551, "speaker": 15, "form": "dlg", "jp": "「そんなのあったとしても覚えていないわ！」"},
{"id": 552, "speaker": 15, "form": "dlg", "jp": "「だって、目の前にケガ人がいるのよ！」"},
{"id": 553, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 554, "speaker": 15, "form": "dlg", "jp": "「まあ、とにかくイヤな事件だったわ‥‥」"},
{"id": 555, "speaker": 15, "form": "dlg", "jp": "これ以上何かを聞き出すのはむずかしそうだな‥‥"},
{"id": 556, "speaker": 2, "form": "dlg", "jp": "「いろいろ話してくれてありがとう！」"},
{"id": 557, "speaker": 2, "form": "dlg", "jp": "「じゃあ、これで帰るよ‥‥」"},
{"id": 558, "speaker": 15, "form": "dlg", "jp": "「ちょっと待ってよ！」"},
{"id": 559, "speaker": 15, "form": "dlg", "jp": "「せっかくだからいっしょに帰りましょうよ！」"},
{"id": 560, "speaker": 2, "form": "dlg", "jp": "「な、なんでだよ‥‥」"},
{"id": 561, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃんのせいでイヤなこと思い出したから\n　１人で帰るの恐くなったからよ‥‥」"},
{"id": 562, "speaker": 2, "form": "dlg", "jp": "「ゴ、ゴメン‥‥」"},
{"id": 563, "speaker": 15, "form": "dlg", "jp": "「とりあえず、着替えてくるから\n　校門のところでまっててよ‥‥」"},
{"id": 564, "speaker": 15, "form": "dlg", "jp": "こうしてボクはアイコといっしょに下校することになった。"},
{"id": 565, "speaker": 15, "form": "dlg", "jp": "「ねえ、ナゴムちゃん‥‥」"},
{"id": 566, "speaker": 2, "form": "dlg", "jp": "「なんだよ？」"},
{"id": 567, "speaker": 15, "form": "dlg", "jp": "「こないだ、\n　アキラちゃん来てたみたいだけど何かあったの？」"},
{"id": 568, "speaker": 2, "form": "dlg", "jp": "「何かってなんだよ？」"},
{"id": 569, "speaker": 15, "form": "dlg", "jp": "「ううん、ただめずらしいなぁと思って‥‥」"},
{"id": 570, "speaker": 2, "form": "dlg", "jp": "「別に、なんでもないよ‥‥」"},
{"id": 571, "speaker": 15, "form": "dlg", "jp": "「あら、そうなの‥‥」"},
{"id": 572, "speaker": 15, "form": "dlg", "jp": "「あれ、あれは‥‥」"},
