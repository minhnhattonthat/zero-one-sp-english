{"id": 48, "speaker": null, "form": "dlg", "jp": "多分、国民を動揺させないように\n政府が報道規制をしたに違いない。"},
{"id": 49, "speaker": 35, "form": "dlg", "jp": "「ねえ、もうこんな時間だよ‥‥」"},
{"id": 50, "speaker": 35, "form": "dlg", "jp": "「ここのウチの人に迷惑がかかっちゃうんじゃぁ？」"},
{"id": 51, "speaker": 31, "form": "dlg", "jp": "（迷惑だと思うんなら、声をだすなよ！）"},
{"id": 52, "speaker": 35, "form": "dlg", "jp": "（ゴメンゴメン‥‥）"},
{"id": 53, "speaker": 35, "form": "dlg", "jp": "（オレ、テレパシーって苦手なんだよ）"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "（ニガテでも何でも、マスターして！）"},
{"id": 55, "speaker": 31, "form": "dlg", "jp": "（あと、このウチのことなら心配無用だ！）"},
{"id": 56, "speaker": 31, "form": "dlg", "jp": "（ナゴムにはうるさい両親がいないんだよ）"},
{"id": 57, "speaker": 31, "form": "dlg", "jp": "（まあ、オレたちの作戦本部だと思ってくれ‥‥）"},
{"id": 58, "speaker": 31, "form": "choice", "jp": "（勝手なこと言うなよ！）"},
{"id": 59, "speaker": 31, "form": "choice", "jp": "（サラリとひどいこと言ったよな今‥‥）"},
{"id": 60, "speaker": 31, "form": "choice", "jp": "（もう、好きにしてくれ‥‥"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "（勝手なこと言うなよ！）"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "（サラリとひどいこと言ったよな今‥‥）"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "（もう、好きにしてくれ‥‥）"},
{"id": 64, "speaker": 31, "form": "dlg", "jp": "（なんだ、その投げやりな言い方は！）"},
{"id": 65, "speaker": 31, "form": "dlg", "jp": "（まあ、細かいことは気にするな‥‥）"},
{"id": 66, "speaker": 31, "form": "dlg", "jp": "（今は人類の未来がかかっている大切な時なんだ！）"},
{"id": 67, "speaker": 31, "form": "dlg", "jp": "（部屋を差し出すぐらい別になんてことはないだろう？）"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "（どっかの国の有事法案みたいなこと言ってるわね‥‥）"},
{"id": 69, "speaker": 35, "form": "dlg", "jp": "（でもさぁ、アイコちゃんもいないんだから‥‥）"},
{"id": 70, "speaker": 35, "form": "dlg", "jp": "（でもさぁ、アキラちゃんもいないんだから‥‥）"},
{"id": 71, "speaker": 35, "form": "dlg", "jp": "（でもさぁ、ナナセちゃんもいないんだから‥‥）"},
{"id": 72, "speaker": 35, "form": "dlg", "jp": "（これ以上、作戦会議もないだろう？）"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "（仕方ないじゃない！）"},
{"id": 74, "speaker": 29, "form": "dlg", "jp": "（あの子は"},
{"id": 75, "speaker": 29, "form": "dlg", "jp": "親戚の家にお泊まり"},
{"id": 76, "speaker": 29, "form": "dlg", "jp": "なんだから‥‥）"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "（お泊まりと言えば！）"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "（ボクも明日から『大阪』へ旅行だから‥‥）"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "（ナゴムも大阪に親戚が？）"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "（違うよ、"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "姉さんの研究発表"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "について行くんだよ！）"},
{"id": 83, "speaker": 29, "form": "dlg", "jp": "（ふ～～ん‥‥）"},
{"id": 84, "speaker": 35, "form": "dlg", "jp": "（じゃあ、明日早いだろう？）"},
{"id": 85, "speaker": 35, "form": "dlg", "jp": "（今日はもう解散しようよ！）"},
{"id": 86, "speaker": 29, "form": "dlg", "jp": "（待ってよ！）"},
{"id": 87, "speaker": 29, "form": "dlg", "jp": "（ナゴムはもういいの？）"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "（何か聞きたいこととかないの？）"},
{"id": 89, "speaker": 29, "form": "choice", "jp": "（ゲーマーとの戦いはいつ始まるの？）"},
{"id": 90, "speaker": 29, "form": "choice", "jp": "（ゲーマーって何人いるの？）"},
{"id": 91, "speaker": 29, "form": "choice", "jp": "（ゲーマーって本当にいるの？）"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "（ゲーマーとの戦いはいつ始まるの？）"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "（この間のロボットの暴走がゲーマーの仕業なら）"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "（すでにゲーマーの攻撃が始まっているんじゃぁ？）"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "（そうね‥‥）"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "（始まっていると言えば、始まっているわね‥‥）"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "（でも、過去の事例を見る限り、\n　まだ本気ってわけじゃないのよ！）"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "（たしか、この前もそんなこと言ってたけど‥‥）"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "（ゲーマーの力は天変地異を起せるのよ！）"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "（あんなオモチャみたいなロボットの暴走なんて‥‥）"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "（ゲーマーって何人いるの？）"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "（それはわからないわ‥‥）"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "（あまりにも巨大な存在なんで‥‥）"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "（何人いるかどころか‥‥）"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "（『人』で数える存在なのかさえも‥‥）"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "（ゲーマーって本当にいるの？）"},
{"id": 107, "speaker": 35, "form": "dlg", "jp": "（オレもそれが気になってたんだよ！）"},
{"id": 108, "speaker": 29, "form": "dlg", "jp": "（じゃあ、あのロボットの暴走はなんなのよ！）"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "（そうだけど‥‥）"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "（やっぱり、話にリアリティーが‥‥）"},
{"id": 111, "speaker": 29, "form": "dlg", "jp": "（中学生が覚えたての英語を使わないで！）"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "（１番リアルなのは真実なのよ！）"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "（それ以上のリアリティーなんてあり得ないのよ！）"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "（ナゴムの能力や、アスカの能力だって、\n　他人からすれば全然リアリティーの無いものよ）"},
{"id": 115, "speaker": 31, "form": "dlg", "jp": "（だいたいその顔で、アスカってのも‥‥）"},
{"id": 116, "speaker": 31, "form": "dlg", "jp": "（リアリティーが感じられんな！）"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "（でも、そんなにすごい力を持ってるのに、\n　なんですぐに攻撃してこないんだ？）"},
{"id": 118, "speaker": 29, "form": "dlg", "jp": "（ゲーマーだからね‥‥）"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "（目的は人類の破滅とかじゃなくて、\n　ただ攻撃を楽しんでいるだけだから‥‥）"},
{"id": 120, "speaker": 31, "form": "dlg", "jp": "（多分、あのロボットを狙ったのも‥‥）"},
{"id": 121, "speaker": 31, "form": "dlg", "jp": "（ただ単に目立ってたからとか、\n　そんな理由だと思うぜ！）"},
{"id": 122, "speaker": 35, "form": "dlg", "jp": "（そんなの中学生のイジメっ子と同じじゃないか？）"},
{"id": 123, "speaker": 29, "form": "dlg", "jp": "（まあ、それぐらいタチの悪いヤツと\n　私たちは戦わなくちゃならないのよ！！）"},
{"id": 124, "speaker": 35, "form": "dlg", "jp": "（わかったよ！）"},
{"id": 125, "speaker": 35, "form": "dlg", "jp": "（わかったから、もう帰っていい？）"},
{"id": 126, "speaker": 35, "form": "dlg", "jp": "（明日も仕事なんだよ‥‥）"},
{"id": 127, "speaker": 29, "form": "dlg", "jp": "（仕方ないわね‥‥）"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "（じゃぁ、帰ってもいいケド、\n　ちゃんと私たちを送ってってちょうだい！）"},
{"id": 129, "speaker": 35, "form": "dlg", "jp": "（ちぇっ、人使い荒いんだから‥‥）"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "（つべこべ言わないの！！）"},
{"id": 131, "speaker": 35, "form": "dlg", "jp": "（じゃぁ、ナゴムくん、\n　オジャマしたね‥‥）"},
{"id": 132, "speaker": 31, "form": "dlg", "jp": "（じゃぁな！）"},
{"id": 133, "speaker": 31, "form": "dlg", "jp": "「シュン！」"},
{"id": 134, "speaker": 31, "form": "dlg", "jp": "３人は松尾さんの能力で、\n自分のネグラへ帰っていった。"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "（さて、ボクも休むとするか‥‥）"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "ボクはそのまま眠りについた。"}
]
