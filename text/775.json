[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／０１／ＰＭ０４：３０"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「キーンコーンカーンコーン」"},
{"id": 2, "speaker": 14, "form": "dlg", "jp": "「ったく、なんで夏休みにわざわざクラブなんて‥‥」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「いいじゃん、他のクラブは毎日頑張ってるんだから‥‥」"},
{"id": 4, "speaker": 14, "form": "dlg", "jp": "「いや、アイツらは頑張りたいから\n　頑張るクラブに入ってんだろう？」"},
{"id": 5, "speaker": 14, "form": "dlg", "jp": "「オレは頑張りたくないから‥‥」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「わかった、わかった‥‥」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「さあ、グズグズ言ってないで帰ろうぜ‥‥」"},
{"id": 8, "speaker": 13, "form": "dlg", "jp": "「ナゴム、すっかり元気になったみたいだな‥‥」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "「ああ、いつまでも気にしてられないからな‥‥」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "本当は違った。"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "ボクはずっと気にしていた‥‥"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "ただ、それを気付かせたくなかっただけだ‥‥"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「キーンコーンカーンコーン」"},
{"id": 14, "speaker": 13, "form": "dlg", "jp": "「なんで、夏休みにクラブなんか‥‥」"},
{"id": 15, "speaker": 16, "form": "dlg", "jp": "「何、ナマケたこと言ってるの！！」"},
{"id": 16, "speaker": 16, "form": "dlg", "jp": "「運動部なんて、毎日暑い中練習しているのよ！」"},
{"id": 17, "speaker": 13, "form": "dlg", "jp": "「そうだけどさぁ‥‥」"},
{"id": 18, "speaker": 16, "form": "dlg", "jp": "「常光寺君なんて、お家であんなことがあったのに\n　出てきているんだから！」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「ボクは家にいても気がめいるだけだし‥‥」"},
{"id": 20, "speaker": 13, "form": "dlg", "jp": "「そんな風には見えないけどな‥‥」"},
{"id": 21, "speaker": 13, "form": "dlg", "jp": "ボクはずっと気にしていた‥‥"},
{"id": 22, "speaker": 13, "form": "dlg", "jp": "ただ、それを気付かせたくなかっただけだ‥‥"},
{"id": 23, "speaker": 13, "form": "dlg", "jp": "「キーンコーンカーンコーン」"},
{"id": 24, "speaker": 13, "form": "dlg", "jp": "「なんで、夏休みにクラブなんか‥‥」"},
{"id": 25, "speaker": 16, "form": "dlg", "jp": "「何、ナマケたこと言ってるの！！」"},
{"id": 26, "speaker": 16, "form": "dlg", "jp": "「運動部なんて、毎日暑い中練習しているのよ！」"},
{"id": 27, "speaker": 13, "form": "dlg", "jp": "「そうだけどさぁ‥‥」"},
{"id": 28, "speaker": 16, "form": "dlg", "jp": "「常光寺君なんて、お家であんなことがあったのに\n　出てきているんだから！」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「ボクは家にいても気がめいるだけだし‥‥」"},
{"id": 30, "speaker": 13, "form": "dlg", "jp": "「そんな風には見えないけどな‥‥」"},
{"id": 31, "speaker": 13, "form": "dlg", "jp": "ボクはずっと気にしていた‥‥"},
{"id": 32, "speaker": 13, "form": "dlg", "jp": "ただ、それを気付かせたくなかっただけだ‥‥"},
{"id": 33, "speaker": 13, "form": "dlg", "jp": "ボクたちは"},
{"id": 34, "speaker": 13, "form": "dlg", "jp": "父さんの死"},
{"id": 35, "speaker": 13, "form": "dlg", "jp": "によって、\n平穏な生活を取り戻した。"},
{"id": 36, "speaker": 13, "form": "dlg", "jp": "もちろん、あれだけの大爆発だったので、\nはっきりとした遺体は発見されることはなかった。"},
{"id": 37, "speaker": 13, "form": "dlg", "jp": "現在、父さんのお墓の中には、\n唯一父さんのものと断定できた"},
{"id": 38, "speaker": 13, "form": "dlg", "jp": "『歯』"},
{"id": 39, "speaker": 13, "form": "dlg", "jp": "と"},
{"id": 40, "speaker": 13, "form": "dlg", "jp": "いくつかの遺品が埋葬されているだけだった。"},
{"id": 41, "speaker": 13, "form": "dlg", "jp": "あの日以降、『ルード』の連中も姿を見せなくなった。"},
{"id": 42, "speaker": 13, "form": "dlg", "jp": "当然といえば、当然のことだ‥‥"},
{"id": 43, "speaker": 13, "form": "dlg", "jp": "彼等が欲していた『父さん』自体がいなくなった今、\n彼等が襲ってくる理由すらなくなったのだから‥‥"},
{"id": 44, "speaker": 13, "form": "dlg", "jp": "『三田さん』の話によると『ルード』は\n父さんにサイボーグを造らせようとしていたのではなく、"},
{"id": 45, "speaker": 13, "form": "dlg", "jp": "父さんの"},
{"id": 46, "speaker": 13, "form": "dlg", "jp": "『機械と神経をつなげる技術』"},
{"id": 47, "speaker": 13, "form": "dlg", "jp": "を\n欲していたらしい‥‥"},
{"id": 48, "speaker": 13, "form": "dlg", "jp": "ボクには良くわからないが、\n『Ａ１０神経』と呼ばれる場所に電気信号を流すことで"},
{"id": 49, "speaker": 13, "form": "dlg", "jp": "気持ちいいと感じさせることができるらしく、"},
{"id": 50, "speaker": 13, "form": "dlg", "jp": "『ルード』はそれをつかって、\n"},
{"id": 51, "speaker": 13, "form": "dlg", "jp": "『死を恐れない兵隊』"},
{"id": 52, "speaker": 13, "form": "dlg", "jp": "を造ろうとしていたらしい。"},
{"id": 53, "speaker": 13, "form": "dlg", "jp": "しかし、その計画も『父さん』の死んだ今では\nオジャンということらしい‥‥"},
{"id": 54, "speaker": 13, "form": "dlg", "jp": "とりあえず、インターポールは\n世界中の神経医学の権威たちの警護をしつつ、"},
{"id": 55, "speaker": 13, "form": "dlg", "jp": "事件がこれ以上拡大しないように\n近いうちに"},
{"id": 56, "speaker": 13, "form": "dlg", "jp": "『ルード』本部に踏み込む"},
{"id": 57, "speaker": 13, "form": "dlg", "jp": "らしい‥‥"},
{"id": 58, "speaker": 13, "form": "dlg", "jp": "こうして、『事件』は一応一段落がついたのだが、\n『父さん』をはじめ、多くのものを失ってしまった。"},
{"id": 59, "speaker": 13, "form": "dlg", "jp": "『シロー』の『体』は現在もインターポールに\n『証拠品』として保管されてしまっている。"},
{"id": 60, "speaker": 13, "form": "dlg", "jp": "姉さんも、再び『シロー』のプログラムを\n造り直すつもりは無いようだ‥‥"},
{"id": 61, "speaker": 13, "form": "dlg", "jp": "特に今回の事件はボクより姉さんの方が\nつらかったに違いない。"},
{"id": 62, "speaker": 13, "form": "dlg", "jp": "自分の親と子供を両方一度に失ったのだから‥‥"},
{"id": 63, "speaker": 14, "form": "dlg", "jp": "「しかし、変わってるよなオマエん家‥‥」"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "「何が？」"},
{"id": 65, "speaker": 14, "form": "dlg", "jp": "「あんな立派なオヤジさんだったんだから、\n　もっと派手な葬式をするのかと‥‥」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「ああ、親戚のおじさんたちにもしかられたよ‥‥」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「でも、父さん無宗教だったから‥‥」"},
{"id": 68, "speaker": 13, "form": "dlg", "jp": "「そんな問題か？」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「それに、ああいうの嫌いな人だったから‥‥」"},
{"id": 70, "speaker": 14, "form": "dlg", "jp": "「ふ～ん‥‥」"},
{"id": 71, "speaker": 13, "form": "dlg", "jp": "「しかし、変わってるよなオマエん家‥‥」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "「何が？」"},
{"id": 73, "speaker": 13, "form": "dlg", "jp": "「あんな立派なオヤジさんだったんだから、\n　もっと派手な葬式をするのかと‥‥」"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "「ああ、親戚のおじさんたちにもしかられたよ‥‥」"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "「でも、父さん無宗教だったから‥‥」"},
{"id": 76, "speaker": 14, "form": "dlg", "jp": "「そんな問題か？」"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "「それに、ああいうの嫌いな人だったから‥‥」"},
{"id": 78, "speaker": 13, "form": "dlg", "jp": "「ふ～ん‥‥」"},
{"id": 79, "speaker": 13, "form": "dlg", "jp": "「しかし、変わってるよなオマエん家‥‥」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「何が？」"},
{"id": 81, "speaker": 13, "form": "dlg", "jp": "「あんな立派なオヤジさんだったんだから、\n　もっと派手な葬式をするのかと‥‥」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「ああ、親戚のおじさんたちにもしかられたよ‥‥」"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "「でも、父さん無宗教だったから‥‥」"},
{"id": 84, "speaker": 13, "form": "dlg", "jp": "「そんな問題か？」"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "「それに、ああいうの嫌いな人だったから‥‥」"},
{"id": 86, "speaker": 13, "form": "dlg", "jp": "「ふ～ん‥‥」"},
{"id": 87, "speaker": 13, "form": "dlg", "jp": "本当はボクも姉さんも『父さん』が死んだことを\n実感できていなかったからだった。"},
{"id": 88, "speaker": 13, "form": "dlg", "jp": "『歯』１つだけで、死を実感しろというのが\nそもそも無理な話だと思った。"},
{"id": 89, "speaker": 13, "form": "dlg", "jp": "確かに目の前であれだけの大爆発を見たんだけど、\n父の死を見たわけではなかった。"},
{"id": 90, "speaker": 13, "form": "dlg", "jp": "だから、ボクたちは派手な葬式をすることに反対し、\nひっそりと埋葬のみをおこなった‥‥"},
{"id": 91, "speaker": 14, "form": "dlg", "jp": "「じゃあな‥‥」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 93, "speaker": 14, "form": "dlg", "jp": "「じゃあな‥‥」"},
{"id": 94, "speaker": 13, "form": "dlg", "jp": "「お姉様によろしくな‥‥」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 96, "speaker": 13, "form": "dlg", "jp": "「じゃあな‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 98, "speaker": 13, "form": "dlg", "jp": "「お姉様によろしくな！！」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「わかったよ！」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "しかし、今頃になってボクたちは\n父さんが死んでしまったことを実感し始めていた。"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "それは‥‥"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "平穏な日々が続いているからだった‥‥"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "「ただいまぁ‥‥」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "ボクが何の不安もなくこの玄関をくぐれるのも、\n全て父さんが死んだからだった‥‥"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「姉さん、いないの？」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "「カギ、開けっ放しだぜ‥‥」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "姉さんもすっかり安心してしまっているようで、\nカギもかけずに外出しているようだ‥‥"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "ボクは炎天下ですっかり消費されてしまった\n水分を補給するためにキッチンへと向かった。"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "（‥‥！！）"},
{"id": 112, "speaker": 3, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 113, "speaker": 4, "form": "dlg", "jp": "「遅かったなボウズ‥‥」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「オマエは‥‥！？」"},
{"id": 115, "speaker": 8, "form": "dlg", "jp": "「おひさしぶり‥‥」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「生きてたのか‥‥！？」"},
{"id": 117, "speaker": 8, "form": "dlg", "jp": "「ああ、なんとかな‥‥」"},
{"id": 118, "speaker": 8, "form": "dlg", "jp": "「オマエたちの様子がおかしかったから、\n　慌てて逃げさせてもらったぜ‥‥」"},
{"id": 119, "speaker": 8, "form": "dlg", "jp": "「まあ、それでも両足は吹っ飛んでしまったけどな‥‥」"},
{"id": 120, "speaker": 8, "form": "dlg", "jp": "「おかげで、オレもサイボーグの仲間入りさ‥‥」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「それで、復讐に来たのか‥‥！？」"},
{"id": 122, "speaker": 8, "form": "dlg", "jp": "「そうしたいのはヤマヤマだが‥‥」"},
{"id": 123, "speaker": 8, "form": "dlg", "jp": "「上が殺さずに連れて来いって言うからさっ‥‥」"},
{"id": 124, "speaker": 8, "form": "dlg", "jp": "「ほんじゃまぁ、そういうこって‥‥」"},
{"id": 125, "speaker": 8, "form": "dlg", "jp": "「ガツン！」"},
{"id": 126, "speaker": 8, "form": "dlg", "jp": "強烈な痛みで、目の前が真っ白になった。"},
{"id": 127, "speaker": 8, "form": "dlg", "jp": "そこでボクの意識は途絶えた。"}
]
