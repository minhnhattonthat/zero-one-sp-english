{"id": 568, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥"},
{"id": 569, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥"},
{"id": 570, "speaker": 0, "form": "dlg", "jp": "ダメだ‥‥"},
{"id": 571, "speaker": 0, "form": "dlg", "jp": "気になって眠れないや‥‥"},
{"id": 572, "speaker": 0, "form": "choice", "jp": "【少し、涼んでくるか‥‥】"},
{"id": 573, "speaker": 0, "form": "choice", "jp": "【いや、横になってればそのうち‥‥】"},
{"id": 574, "speaker": 0, "form": "dlg", "jp": "【いや、横になってればそのうち‥‥】"},
{"id": 575, "speaker": 0, "form": "dlg", "jp": "きっと眠くなるはず‥‥"},
{"id": 576, "speaker": 0, "form": "dlg", "jp": "‥‥‥"},
{"id": 577, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥"},
{"id": 578, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥"},
