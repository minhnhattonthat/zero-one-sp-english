{"id": 250, "speaker": 2, "form": "dlg", "jp": "「実はアイコもおもしろがってるんじゃぁ？」"},
{"id": 251, "speaker": 15, "form": "dlg", "jp": "「違うわよっ！」"},
{"id": 252, "speaker": 14, "form": "dlg", "jp": "「そんなことより、早く行かないと\n　アイツを待たせるとうるさいぞ！」"},
{"id": 253, "speaker": 14, "form": "dlg", "jp": "ボクたちは学校へと向かった。"},
{"id": 254, "speaker": 14, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 255, "speaker": 14, "form": "dlg", "jp": "２００５／０７／２０／ＰＭ１０：０５"},
{"id": 256, "speaker": 14, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 257, "speaker": 51, "form": "dlg", "jp": "「ちょっと、遅かったやん！」"},
{"id": 258, "speaker": 14, "form": "dlg", "jp": "「わりぃ、わりぃ‥‥」"},
{"id": 259, "speaker": 14, "form": "dlg", "jp": "「そう言えば、ツトム‥‥」"},
{"id": 260, "speaker": 14, "form": "dlg", "jp": "「その手に持ってるのは？」"},
{"id": 261, "speaker": 13, "form": "dlg", "jp": "「護身用の"},
{"id": 262, "speaker": 13, "form": "dlg", "jp": "『バット』"},
{"id": 263, "speaker": 13, "form": "dlg", "jp": "だよ‥‥」"},
{"id": 264, "speaker": 14, "form": "dlg", "jp": "「まさかオマエ、幽霊を信じてるとか‥‥」"},
{"id": 265, "speaker": 13, "form": "dlg", "jp": "「信じてないから『バット』なんだよ！」"},
{"id": 266, "speaker": 13, "form": "dlg", "jp": "「夜中に忍び込んでるヤツなんて\n　マトモじゃないんだから‥‥」"},
{"id": 267, "speaker": 14, "form": "dlg", "jp": "「なるほどね‥‥」"},
{"id": 268, "speaker": 15, "form": "dlg", "jp": "「ねえ、本当に出るの『幽霊』？」"},
{"id": 269, "speaker": 51, "form": "dlg", "jp": "「『幽霊』なんて出るわけないやん！」"},
{"id": 270, "speaker": 15, "form": "dlg", "jp": "「じゃぁ、どうして‥‥」"},
{"id": 271, "speaker": 51, "form": "dlg", "jp": "「『幽霊』なんておらへん、\n　おるのはおかしなイタズラしてるアホだけや！」"},
{"id": 272, "speaker": 51, "form": "dlg", "jp": "「だからそのアホの正体を見届けるだけや！」"},
{"id": 273, "speaker": 13, "form": "dlg", "jp": "「で、その『アホさん』は必ず現れるのか？」"},
{"id": 274, "speaker": 51, "form": "dlg", "jp": "「近所の子の話では‥‥」"},
{"id": 275, "speaker": 51, "form": "dlg", "jp": "「『最近、毎晩０時きっかりに\n　ピアノの音が学校から聞こえる』って言ってたから‥‥」"},
{"id": 276, "speaker": 51, "form": "dlg", "jp": "「かなりの確率で現れるんちゃうかな？」"},
{"id": 277, "speaker": 2, "form": "dlg", "jp": "「でも、『０時』って‥‥」"},
{"id": 278, "speaker": 14, "form": "dlg", "jp": "「かなり時間があるな‥‥」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "「それまでここで待つの？」"},
{"id": 281, "speaker": 51, "form": "dlg", "jp": "「そんなわけないやん！」"},
{"id": 282, "speaker": 51, "form": "dlg", "jp": "「いつまでもこんなとこにおったら\n　見つかってしまうやろ！」"},
{"id": 283, "speaker": 14, "form": "dlg", "jp": "「じゃあ、どうするんだよ！」"},
{"id": 284, "speaker": 51, "form": "dlg", "jp": "「任せときっ！」"},
{"id": 285, "speaker": 51, "form": "dlg", "jp": "「科学室の裏庭側の窓に細工をしておいたから」"},
{"id": 286, "speaker": 51, "form": "dlg", "jp": "「あそこに忍びこむことができるから‥‥」"},
{"id": 287, "speaker": 51, "form": "dlg", "jp": "「あそこやったら、暗幕があるし、\n　明かりをつけても外にもれへんし‥‥」"},
{"id": 288, "speaker": 51, "form": "dlg", "jp": "「なんたって、音楽室の真下やし‥‥」"},
{"id": 289, "speaker": 14, "form": "dlg", "jp": "「よしっ、じゃあ裏庭へ行こう‥‥」"},
{"id": 290, "speaker": 15, "form": "dlg", "jp": "「本当に大丈夫なの‥‥？」"},
{"id": 291, "speaker": 51, "form": "dlg", "jp": "「大丈夫、ウチを信用して！」"},
{"id": 292, "speaker": 51, "form": "dlg", "jp": "ボクたちは裏庭の科学室の窓から\n校舎に忍び込むことにした。"},
{"id": 293, "speaker": 15, "form": "dlg", "jp": "「真っ暗ね‥‥」"},
{"id": 294, "speaker": 51, "form": "dlg", "jp": "「ちょっと待って、\n　今、電気つけるから‥‥」"},
{"id": 295, "speaker": 13, "form": "dlg", "jp": "「大丈夫なのかよ？」"},
{"id": 296, "speaker": 51, "form": "dlg", "jp": "「大丈夫、大丈夫！」"},
{"id": 297, "speaker": 51, "form": "dlg", "jp": "「帰るときに暗幕しめといたから‥‥」"},
{"id": 298, "speaker": 14, "form": "dlg", "jp": "「で、オマエ、その『木刀』は？」"},
{"id": 299, "speaker": 14, "form": "dlg", "jp": "「まさか、『幽霊』と戦う気じゃあ？」"},
{"id": 300, "speaker": 51, "form": "dlg", "jp": "「何度言ったらわかるかなぁ？」"},
{"id": 301, "speaker": 51, "form": "dlg", "jp": "「『幽霊』なんておらへんって‥‥」"},
{"id": 302, "speaker": 13, "form": "dlg", "jp": "「じゃあ、何なんだよ、その『木刀』は？」"},
{"id": 303, "speaker": 51, "form": "dlg", "jp": "「『幽霊』のふりしてるアホが\n　ヘンタイやったらどうすんの！」"},
{"id": 304, "speaker": 51, "form": "dlg", "jp": "「夜中にピアノをひこうなんて\n　まともなヤツやあらへんでぇ？」"},
{"id": 305, "speaker": 15, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 306, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃんたちよりは、\n　たよりになりそうね！」"},
{"id": 307, "speaker": 51, "form": "dlg", "jp": "「そうやろ？」"},
{"id": 308, "speaker": 13, "form": "dlg", "jp": "「つまり、その『木刀』は\n　オレたちへの不信感の現れってことだな‥‥」"},
{"id": 309, "speaker": 51, "form": "dlg", "jp": "「まあ、そういうこと‥‥」"},
{"id": 310, "speaker": 51, "form": "dlg", "jp": "２００５／０７／２０／ＰＭ１０：０５"},
{"id": 311, "speaker": 51, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
