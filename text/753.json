{"id": 243, "speaker": 15, "form": "dlg", "jp": "「学校に忍びこむつもりでしょう？」"},
{"id": 244, "speaker": 14, "form": "dlg", "jp": "「だったらどうかしたのかよ！」"},
{"id": 245, "speaker": 15, "form": "dlg", "jp": "「私もついて行くわっ！」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「なんでアイコまで‥‥」"},
