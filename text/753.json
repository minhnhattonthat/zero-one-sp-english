{"id": 580, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 581, "speaker": 0, "form": "dlg", "jp": "なわけないか‥‥"},
{"id": 582, "speaker": 0, "form": "choice", "jp": "【少し、涼んでくるか‥‥】"},
{"id": 583, "speaker": 0, "form": "choice", "jp": "【こうなったら意地でも寝るぞ！！】"},
{"id": 584, "speaker": 0, "form": "dlg", "jp": "こうなったら意地でも寝るぞ！"},
{"id": 585, "speaker": 0, "form": "dlg", "jp": "‥‥‥"},
{"id": 586, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥"},
{"id": 587, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥"},
{"id": 588, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 589, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 590, "speaker": 0, "form": "dlg", "jp": "シーツが汗でビチョビチョだよ‥‥"},
{"id": 591, "speaker": 0, "form": "choice", "jp": "【少し、涼んでくるか‥‥】"},
{"id": 592, "speaker": 0, "form": "choice", "jp": "【意地でも寝るんだ！】"},
{"id": 593, "speaker": 0, "form": "dlg", "jp": "【意地でも寝るんだ！】"},
{"id": 594, "speaker": 0, "form": "dlg", "jp": "‥‥‥"},
{"id": 595, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥"},
{"id": 596, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥"},
{"id": 597, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 598, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 599, "speaker": 0, "form": "dlg", "jp": "シーツが汗でビチョビチョだよ‥‥"},
{"id": 600, "speaker": 0, "form": "choice", "jp": "【少し、涼んでくるか‥‥】"},
{"id": 601, "speaker": 0, "form": "choice", "jp": "【こうなったら意地でも寝るぞ！！】"},
{"id": 602, "speaker": 0, "form": "dlg", "jp": "【少し、涼んでくるか‥‥】"},
{"id": 603, "speaker": 0, "form": "dlg", "jp": "『姉さん』もまだ起きてるだろうし‥‥"},
{"id": 604, "speaker": 0, "form": "dlg", "jp": "ウチには大学教授をしている\n父さんの仕事用の『研究室』があった。"},
{"id": 605, "speaker": 0, "form": "dlg", "jp": "『研究室』は１階にあり、\nコンピュータの動作を安定させるために"},
{"id": 606, "speaker": 0, "form": "dlg", "jp": "いつも、クーラーがガンガンに効いた状態になっていた。"},
{"id": 607, "speaker": 0, "form": "dlg", "jp": "最近では、父さんにかわって、\n大学の助手をしている『姉さん』が"},
{"id": 608, "speaker": 0, "form": "dlg", "jp": "ほとんどの時間を『研究室』ですごしていた。"},
{"id": 609, "speaker": 0, "form": "dlg", "jp": "ボクは１階の『研究室』へ行くことにした。"},
{"id": 610, "speaker": 0, "form": "dlg", "jp": "【テレビをつけない】"},
{"id": 611, "speaker": 2, "form": "dlg", "jp": "（父さんが犯罪組織と関係があるとは‥‥）"},
{"id": 612, "speaker": 2, "form": "dlg", "jp": "その時‥‥"},
{"id": 613, "speaker": 2, "form": "dlg", "jp": "「プルルルルル‥‥」"},
{"id": 614, "speaker": 2, "form": "dlg", "jp": "ボクの携帯電話がなった。"},
{"id": 615, "speaker": 2, "form": "dlg", "jp": "（誰だろう？）"},
{"id": 616, "speaker": 2, "form": "dlg", "jp": "（こんな時間に‥‥）"},
{"id": 617, "speaker": 2, "form": "dlg", "jp": "携帯電話のディスプレイには\nシンちゃんの名前が表示されていた。"},
{"id": 618, "speaker": 2, "form": "dlg", "jp": "「ピッ！」"},
{"id": 619, "speaker": 2, "form": "dlg", "jp": "「もしもし‥‥」"},
{"id": 620, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 621, "speaker": 14, "form": "dlg", "jp": "（あっ、ナゴム‥‥）"},
{"id": 622, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 623, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 624, "speaker": 14, "form": "dlg", "jp": "（今から出て来れないか？）"},
{"id": 625, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 626, "speaker": 2, "form": "dlg", "jp": "「今から？」"},
{"id": 627, "speaker": 2, "form": "dlg", "jp": "「こんな遅くに？」"},
{"id": 628, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 629, "speaker": 14, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 630, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 631, "speaker": 2, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 632, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 633, "speaker": 14, "form": "dlg", "jp": "（いいから！！）"},
{"id": 634, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 635, "speaker": 14, "form": "choice", "jp": "「わかったよ！」"},
{"id": 636, "speaker": 14, "form": "choice", "jp": "「ダメだよ！」"},
{"id": 637, "speaker": 2, "form": "dlg", "jp": "「ダメだよ！」"},
{"id": 638, "speaker": 2, "form": "dlg", "jp": "「姉さんが心配するし‥‥」"},
{"id": 639, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 640, "speaker": 14, "form": "dlg", "jp": "（そうか‥‥）"},
{"id": 641, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 642, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 643, "speaker": 14, "form": "dlg", "jp": "（じゃあ仕方ないな）"},
{"id": 644, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 645, "speaker": 2, "form": "dlg", "jp": "「悪いね‥‥」"},
{"id": 646, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 647, "speaker": 14, "form": "dlg", "jp": "（気にするな！）"},
{"id": 648, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 649, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 650, "speaker": 14, "form": "dlg", "jp": "（じゃあな‥‥）"},
{"id": 651, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 652, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 653, "speaker": 2, "form": "dlg", "jp": "いったい、何の誘いだったんだろう？"},
{"id": 654, "speaker": 2, "form": "dlg", "jp": "ボクは誘いを断ったことを少し悔やんだ。"},
{"id": 655, "speaker": 2, "form": "dlg", "jp": "もしかしたら、外出した方が\n気がまぎれたのかもしれない。"},
{"id": 656, "speaker": 2, "form": "dlg", "jp": "１人でいるとどうしても\n父さんのことが気になってしまう。"},
{"id": 657, "speaker": 2, "form": "dlg", "jp": "「しかたない、テレビでも見るか‥‥」"},
{"id": 658, "speaker": 2, "form": "dlg", "jp": "「わかったよ！」"},
{"id": 659, "speaker": 2, "form": "dlg", "jp": "「で、どこへ行けばいいんだい？」"},
{"id": 660, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 661, "speaker": 14, "form": "dlg", "jp": "（もう、オマエんちの前に来てるから、\n　とりあえず、出て来いよ‥‥）"},
{"id": 662, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 663, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 664, "speaker": 2, "form": "dlg", "jp": "（ウチの前まで来てるって‥‥）"},
{"id": 665, "speaker": 2, "form": "dlg", "jp": "ボクは音がしないようにゆっくりとドアを開き、\nゆっくりと階段を降りた。"},
{"id": 666, "speaker": 2, "form": "dlg", "jp": "（『三船アイコ』‥‥）"},
{"id": 667, "speaker": 2, "form": "dlg", "jp": "（いわゆる『幼なじみ』だ‥‥）"},
{"id": 668, "speaker": 2, "form": "dlg", "jp": "（小さいころからボクのことを\n　ママゴトの道具かなにかと思いこんでいるようで）"},
{"id": 669, "speaker": 2, "form": "dlg", "jp": "（何かと世話をやきたがる‥‥）"}
]
