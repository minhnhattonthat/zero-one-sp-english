{"id": 556, "speaker": 0, "form": "dlg", "jp": "考え込んでいてもしかたない‥‥"},
{"id": 557, "speaker": 0, "form": "dlg", "jp": "宿題でもするか‥‥‥"},
{"id": 558, "speaker": 0, "form": "dlg", "jp": "‥‥‥"},
{"id": 559, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 560, "speaker": 0, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥"},
{"id": 561, "speaker": 0, "form": "dlg", "jp": "ダメだ‥‥"},
{"id": 562, "speaker": 0, "form": "dlg", "jp": "こう暑いと、とても宿題なんか‥‥"},
{"id": 563, "speaker": 0, "form": "choice", "jp": "【少し、涼んでくるか‥‥】"},
{"id": 564, "speaker": 0, "form": "choice", "jp": "【もう寝るとするか‥‥】"},
