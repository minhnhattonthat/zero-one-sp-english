[
{"id": 0, "speaker": null, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "「ただいま‥‥」"},
{"id": 2, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 3, "speaker": 3, "form": "dlg", "jp": "「お帰りなさい‥‥」"},
{"id": 4, "speaker": 3, "form": "dlg", "jp": "（『常光寺リツコ』‥‥　ボクの姉さんだ‥‥）"},
{"id": 5, "speaker": 3, "form": "dlg", "jp": "（ボクたちの母親はボクが小さいころに\n　死んでしまっており）"},
{"id": 6, "speaker": 3, "form": "dlg", "jp": "（歳の離れた姉が母親がわりになってくれていた）"},
{"id": 7, "speaker": 3, "form": "dlg", "jp": "「いいとこに帰って来たわ！」"},
{"id": 8, "speaker": 3, "form": "dlg", "jp": "「わるいけど、ドレッシング買って来てくれない？」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "「うん、行ってくるよ！」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 13, "speaker": 4, "form": "dlg", "jp": "「常光寺くん‥‥」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥！？）"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「堤さん！！」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "（『堤ナナセ』‥‥）"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "（ボクの学校の生徒会長だ‥‥）"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "（生徒会長と言っても、別にいじめられっこでも、\n　目立ちたがりやでもない‥‥）"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "（ただ成績が良く、性格も良いので、\n　教師たちに無理矢理に生徒会長をさせられている‥‥）"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "（また、彼女自身、性格がいいので、\n　そうした押し付け仕事をいやがってはいない。）"},
{"id": 21, "speaker": 18, "form": "dlg", "jp": "「急いでどこ行くの？」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「オツカイだよ‥‥」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「堤さんは？」"},
{"id": 24, "speaker": 18, "form": "dlg", "jp": "「今から『絵画教室』」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「堤さん、絵習ってるんだ」"},
{"id": 26, "speaker": 18, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「イメージ的にはバイオリンとかそんなんだけど‥‥」"},
{"id": 28, "speaker": 18, "form": "dlg", "jp": "「ピアノは習ってたけど、\n　バイオリンは‥‥」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「へぇ‥‥」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "「ピアノも？」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「確か、塾も通ってるだろう？」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "「大変だね？」"},
{"id": 33, "speaker": 18, "form": "dlg", "jp": "「そんなことないわよ‥‥」"},
{"id": 34, "speaker": 18, "form": "dlg", "jp": "「小さい頃は水泳とか、\n　ダンスとか、習字とか、英会話とか‥‥」"},
{"id": 35, "speaker": 18, "form": "dlg", "jp": "「そろばんとか、テニスとか、ゴルフとか、\n　乗馬とか、手品とか、いろいろ習ってたけど」"},
{"id": 36, "speaker": 18, "form": "dlg", "jp": "「今は絵画と塾だけだから‥‥」"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "「そ、そうなんだ‥‥」"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "「お金持ちって大変だね‥‥」"},
{"id": 39, "speaker": 18, "form": "dlg", "jp": "「アラ、ウチはお金持ちじゃないわよ！」"},
{"id": 40, "speaker": 18, "form": "dlg", "jp": "「常光寺くんみたいに\n　立派な家にも住んでないし‥‥」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「でも、そんなにたくさん習い事って‥‥」"},
{"id": 42, "speaker": 18, "form": "dlg", "jp": "「ウチのお父さん関西出身だから‥‥」"},
{"id": 43, "speaker": 18, "form": "dlg", "jp": "「『芸は身を助く』って思ってたみたい」"},
{"id": 44, "speaker": 2, "form": "dlg", "jp": "「だから、『手品』まで習ってたんだね‥‥」"},
{"id": 45, "speaker": 18, "form": "dlg", "jp": "「フフフフフ‥‥」"},
{"id": 46, "speaker": 18, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 47, "speaker": 18, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「ただいま‥‥」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「ハイ、コレ‥‥」"},
{"id": 51, "speaker": 3, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 52, "speaker": 3, "form": "dlg", "jp": "「いいとこに帰って来たわ！」"},
{"id": 53, "speaker": 3, "form": "dlg", "jp": "「わるいけど、ドレッシング買って来てくれない？」"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "「うん、行ってくるよ！」"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 58, "speaker": 4, "form": "dlg", "jp": "「ジョウコウジくん‥‥」"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥！？）"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「先生‥‥」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "（『ケイト・ブラバスキー』‥‥）"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "（新しくやってきた英語の先生だ‥‥）"},
{"id": 63, "speaker": 21, "form": "dlg", "jp": "「どこ行くの？」"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "「いえ、ちょっとオツカイに‥‥」"},
{"id": 65, "speaker": 21, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 66, "speaker": 21, "form": "dlg", "jp": "「じゃあね、また新学期に‥‥」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「さようなら‥‥」"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "「ただいま‥‥」"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "「ハイ、コレ‥‥」"},
{"id": 73, "speaker": 3, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 74, "speaker": 3, "form": "dlg", "jp": "「じゃあ、すぐに夕食にするから‥‥」"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 76, "speaker": 3, "form": "dlg", "jp": "「すぐに夕食にするから‥‥」"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "２００５／０７／２０／ＰＭ０７：００"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "姉さんと二人っきりの夕食はいつものことだ。"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "しかし、あきらかに二人の間には\nいつもと違う空気が流れていた。"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "理由は‥‥"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "昨日のニュースのせいだ。"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "２００５／０７／２０／ＰＭ０７：００"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "姉さんと二人っきりの夕食はいつものことだった。"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "しかし、あきらかに二人の間には\nいつもと違う空気が流れていた。"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "理由は‥‥"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "昨日のニュースのせいだ。"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "『昨日のニュース』‥‥"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "ペルーの『武器密売組織』、\n『ルード』の『私設軍』に"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "『サイボーグ手術』を受けた兵隊が\n混ざっている可能性があると、"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "アメリカのマスコミが発表したニュースのことだ‥‥"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "ボクたちの父親は世界的に有名な\n『ロボット工学博士』で、"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "特に、人間の神経と機械をつなぐ技術。"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "つまり、サイボーグに応用できそうな\n技術の権威だった。"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "さらに、まずいことに、\n父さんは２ヶ月ほど音信不通状態だった。"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "ボクも姉さんも、お互いを不安がらせないように\nその話題を一切口にしなかった。"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "そのため、食卓にはいつもよりぎこちない空気が\n充満していた。"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "ボクはその空気から逃れるために\n食事を終えるとすぐに自分の部屋に閉じこもった。"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "『ルード』"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "‥‥"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "なんでも武器の密売なんかをしている\n大きな組織らしい‥‥"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "中学生のボクにはよくわからないが、\n違法に武器を販売する連中みたいだ。"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "世界中でテロや紛争がなくならないのは、\nこうした闇の武器商人たちがいるからだという。"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "そして、その『ルード』の私設軍に\n『サイボーグ兵』が所属しているらしい‥‥"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "‥‥‥"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "やっぱり、父さんが‥‥"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "２００５／０７／２０／ＰＭ０９：４０"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "そろそろニュースの時間だ‥‥"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "今日はあのニュースの続報が流れるだろうか？"},
{"id": 113, "speaker": 2, "form": "choice", "jp": "【テレビをつける】"},
{"id": 114, "speaker": 2, "form": "choice", "jp": "【テレビをつけない】"},
{"id": 115, "speaker": 3, "form": "dlg", "jp": "「で、通知表もらったんでしょう？」"},
{"id": 116, "speaker": 3, "form": "dlg", "jp": "「どうだったの？」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「うん、後で渡すよ‥‥」"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "ボクは適当に返事をし、２階の自分の部屋に戻った。"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "２００５／０７／２０／ＰＭ０９：４５"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「プルルルルル‥‥」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "ボクの携帯電話がなった。"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "（誰だろう？）"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "（こんな時間に‥‥）"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "携帯電話のディスプレイには\nシンちゃんの名前が表示されていた。"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「ピッ！」"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "「もしもし‥‥」"},
{"id": 129, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 130, "speaker": 14, "form": "dlg", "jp": "（あっ、ナゴム‥‥）"},
{"id": 131, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 132, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 133, "speaker": 14, "form": "dlg", "jp": "（今から出て来れないか？）"},
{"id": 134, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「今から？」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「こんな遅くに？」"},
{"id": 137, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 138, "speaker": 14, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 139, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 141, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 142, "speaker": 14, "form": "dlg", "jp": "（いいから！！）"},
{"id": 143, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "「しかたないなぁ‥‥」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「で、どこへ行けばいいんだい？」"},
{"id": 146, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 147, "speaker": 14, "form": "dlg", "jp": "（もう、オマエんちの前に来てるから、\n　　とりあえず、出て来いよ‥‥）"},
{"id": 148, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "（ウチの前まで来てるって‥‥）"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "ボクは音がしないようにゆっくりとドアを開き、\nゆっくりと階段を降りた。"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "シンちゃんからだ‥‥"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「ピッ！」"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "「もしもし‥‥」"},
{"id": 155, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 156, "speaker": 14, "form": "dlg", "jp": "（あっ、ナゴム‥‥）"},
{"id": 157, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 158, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 159, "speaker": 14, "form": "dlg", "jp": "（そろそろ行くぞ！！）"},
{"id": 160, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「えっ、本当に行くの？」"},
{"id": 162, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 163, "speaker": 14, "form": "dlg", "jp": "（外で待ってるから早く出て来い！）"},
{"id": 164, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "「しかたないなぁ‥‥」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "シンちゃんは本気で学校に忍びこむつもりだ‥‥"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "ボクは音がしないようにゆっくりとドアを開き、\nゆっくりと階段を降りた。"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "２００５／０７／２０／ＰＭ０９：５０"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "外に出るとシンちゃんとツトムが立っていた。"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 171, "speaker": 14, "form": "dlg", "jp": "「『肝だめし』だよ‥‥」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「『肝だめし』？」"},
{"id": 173, "speaker": 13, "form": "dlg", "jp": "「なんでも『学校に幽霊が出る』んだってよ！」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「『幽霊』！？」"},
{"id": 175, "speaker": 13, "form": "dlg", "jp": "「ああ、オレたちは信じちゃいないけどな‥‥」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「じゃあ、なんで‥‥」"},
{"id": 177, "speaker": 14, "form": "dlg", "jp": "「おもしろそうだろう？」"},
{"id": 178, "speaker": 14, "form": "dlg", "jp": "「夜の学校に忍び込むなんて‥‥」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「だいたい、見つかったりしたら‥‥」"},
{"id": 180, "speaker": 14, "form": "dlg", "jp": "「大丈夫！！」"},
{"id": 181, "speaker": 14, "form": "dlg", "jp": "「その時の責任は『長尾』が取るって言ってるし‥‥」"},
{"id": 182, "speaker": 14, "form": "dlg", "jp": "（『長尾アキラ』‥‥）"},
{"id": 183, "speaker": 14, "form": "dlg", "jp": "（同じクラスの\n　『オカルト』＆『ファンタジー』マニアだ‥‥）"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「『長尾』ねぇ‥‥」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "「おかしいと思ったよ‥‥」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「シンちゃんが『オカルト』に興味もつなんて‥‥」"},
{"id": 187, "speaker": 13, "form": "dlg", "jp": "「長尾の話によると、夜中に音楽室の\n　ピアノが勝手に鳴り出すんだってよ‥‥」"},
{"id": 188, "speaker": 13, "form": "dlg", "jp": "「なんだかベタベタな話だろう？」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 190, "speaker": 14, "form": "dlg", "jp": "「まあ、中学生にもなってそれを信じるのは\n　あの女ぐらいだよ‥‥」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「で、長尾は？」"},
{"id": 192, "speaker": 14, "form": "dlg", "jp": "「校門の前で待ってるってよ！」"},
{"id": 193, "speaker": 13, "form": "dlg", "jp": "「さあ、行こうぜ！」"},
{"id": 194, "speaker": 4, "form": "dlg", "jp": "「ちょっと待ちなさいよっ！」"},
{"id": 195, "speaker": 15, "form": "dlg", "jp": "「こんな夜中に中学生が何してるの！」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「アイコ‥‥\n　オマエこそどうして？」"},
{"id": 197, "speaker": 15, "form": "dlg", "jp": "「窓から外を見たら、怪しい人影が見えたから\n　出てきたのよ！」"},
{"id": 198, "speaker": 15, "form": "dlg", "jp": "「で、どこへ行くつもり？」"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "「ちょ、ちょっと学校へ‥‥」"},
{"id": 200, "speaker": 15, "form": "dlg", "jp": "「なんで、こんな時間に？」"},
{"id": 201, "speaker": 13, "form": "dlg", "jp": "「何でもないよ！！」"},
{"id": 202, "speaker": 15, "form": "dlg", "jp": "「何でもないワケないでしょう！！」"},
{"id": 203, "speaker": 14, "form": "dlg", "jp": "「大きな声を出すなよ！！」"},
{"id": 204, "speaker": 14, "form": "dlg", "jp": "「オレたちは長尾に頼まれただけだよ！」"},
{"id": 205, "speaker": 15, "form": "dlg", "jp": "「『アキラちゃん』に？」"},
{"id": 206, "speaker": 14, "form": "dlg", "jp": "「そうだよ！」"},
{"id": 207, "speaker": 14, "form": "dlg", "jp": "「なんでもアイツが『幽霊の観察』をするのに\n　女１人じゃ不安だからって‥‥」"},
{"id": 208, "speaker": 15, "form": "dlg", "jp": "「アキラちゃんが言いそうなことね‥‥」"},
{"id": 209, "speaker": 13, "form": "dlg", "jp": "「ってワケだよ！」"},
{"id": 210, "speaker": 15, "form": "dlg", "jp": "「じゃあ、私もついて行くわ！」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「なんでアイコまで！？」"},
{"id": 212, "speaker": 15, "form": "dlg", "jp": "「だって、アンタたちみたいな男子３人と\n　夜中に女子が１人きりで会うなんて‥‥」"},
{"id": 213, "speaker": 15, "form": "dlg", "jp": "「ちょっと危なっかしいでしょう？」"},
{"id": 214, "speaker": 13, "form": "dlg", "jp": "「余計な心配だよ‥‥」"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "「実はアイコもおもしろがってるんじゃぁ？」"},
{"id": 216, "speaker": 15, "form": "dlg", "jp": "「違うわよっ！」"},
{"id": 217, "speaker": 14, "form": "dlg", "jp": "「そんなことより、\n　早く行かないと長尾が待ってるぞ！」"},
{"id": 218, "speaker": 14, "form": "dlg", "jp": "ボクたちは学校へと向かった。"},
{"id": 219, "speaker": 14, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 220, "speaker": 14, "form": "dlg", "jp": "外に出てみると、シンちゃんとツトムが待っていた。"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "「本当に行くの？」"},
{"id": 222, "speaker": 14, "form": "dlg", "jp": "「あたりまえだろう！」"},
{"id": 223, "speaker": 14, "form": "dlg", "jp": "「早く行かないと長尾が待ってるぞ！」"},
{"id": 224, "speaker": 14, "form": "dlg", "jp": "「早く行かないと小田が待ってるぞ！」"},
{"id": 225, "speaker": 4, "form": "dlg", "jp": "「ちょっと待ちなさい！」"},
{"id": 226, "speaker": 15, "form": "dlg", "jp": "「こんな夜中に中学生が何してるの！」"},
