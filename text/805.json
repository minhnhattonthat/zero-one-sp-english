[
{"id": 0, "speaker": null, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「もしもし‥‥」"},
{"id": 4, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 5, "speaker": 29, "form": "dlg", "jp": "（ジーンよ‥‥）"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「何、どうかしたの？」"},
{"id": 8, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 9, "speaker": 29, "form": "dlg", "jp": "（本部からちょっとした情報を手に入れたのよ）"},
{"id": 10, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「ウソ！」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「スゴイじゃない！」"},
{"id": 13, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 14, "speaker": 29, "form": "dlg", "jp": "（それよりナゴムはどうなの？）"},
{"id": 15, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「いや、こっちはぜんぜん‥‥」"},
{"id": 17, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 18, "speaker": 29, "form": "dlg", "jp": "（しょうがないわね‥‥）"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 20, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "（とにかく、顔を見せにいらっしゃい！）"},
{"id": 22, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 23, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 24, "speaker": 29, "form": "dlg", "jp": "（情報について話してあげるから‥‥）"},
{"id": 25, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「うん、わかった‥‥」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "ボクはジーンたちのいるホテルに行くことにした。"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "２００５／０７／２３／ＡＭ１０：２０"},
{"id": 30, "speaker": 29, "form": "dlg", "jp": "「おはよ‥‥」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「で、情報ってなに？」"},
{"id": 32, "speaker": 29, "form": "dlg", "jp": "「そんなことより、ちゃんと情報集めしてよね！」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「してるよ‥‥」"},
{"id": 34, "speaker": 29, "form": "dlg", "jp": "「ケネスが見たって言ってたわよ‥‥」"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "「見た？」"},
{"id": 36, "speaker": 31, "form": "dlg", "jp": "「女の子とデートしていただろう？」"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "「ち、ちがうよ！」"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "「アレは頼まれたから‥‥」"},
{"id": 39, "speaker": 29, "form": "dlg", "jp": "「頼まれたって何を？」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「『幽霊探し』を‥‥」"},
{"id": 41, "speaker": 29, "form": "dlg", "jp": "「はぁ？」"},
{"id": 42, "speaker": 29, "form": "dlg", "jp": "「そんなことしてる場合じゃないでしょう？」"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 44, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「コン、コン」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 47, "speaker": 56, "form": "dlg", "jp": "「失礼します！」"},
{"id": 48, "speaker": 31, "form": "dlg", "jp": "「どうぞ！」"},
{"id": 49, "speaker": 56, "form": "dlg", "jp": "「ちょっと、階下で水もれの苦情がありましたので」"},
{"id": 50, "speaker": 56, "form": "dlg", "jp": "「『シャワールーム』の点検をさせていただきます」"},
{"id": 51, "speaker": 31, "form": "dlg", "jp": "「いいよ、勝手にやってくれ‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「で、『情報』って？」"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "「しっ！」"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "（あの人に聞こえるわ‥‥）"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "（ゴメン‥‥）"},
{"id": 56, "speaker": 29, "form": "dlg", "jp": "（実は、本部が『悪意のあるテレパシー』の発信元を\n　見つけたらしいのよ‥‥）"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "（やったじゃない！）"},
{"id": 58, "speaker": 31, "form": "dlg", "jp": "（で、悪いけどナゴムんちのコンピューター\n　つかわせてもらえないか？）"},
{"id": 59, "speaker": 31, "form": "dlg", "jp": "（発信ポイントのデータはこのＣＤの中なんだよ‥‥）"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "（いいけど、\n　そんなのメールで送ってくればいいのに‥‥）"},
{"id": 61, "speaker": 29, "form": "dlg", "jp": "（ボウジュされるとマズイからね‥‥）"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "（ふーん‥‥）"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "その時！"},
{"id": 64, "speaker": 56, "form": "dlg", "jp": "「ギャーーーッ！」"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "「何っ？」"},
{"id": 66, "speaker": 31, "form": "dlg", "jp": "「『シャワールーム』の方からだ‥‥」"},
{"id": 67, "speaker": 31, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 68, "speaker": 31, "form": "dlg", "jp": "ボクたちはあわてて『シャワールーム』の\nドアをあけた。"},
{"id": 69, "speaker": 31, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 70, "speaker": 31, "form": "dlg", "jp": "‥‥‥‥‥！！"},
{"id": 71, "speaker": 31, "form": "dlg", "jp": "「なんだコリャ‥‥」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "「ウッ‥‥」"},
{"id": 73, "speaker": 31, "form": "dlg", "jp": "「バカヤロウ、\n　トイレが使えないのに吐くなよ‥‥」"},
{"id": 74, "speaker": 31, "form": "dlg", "jp": "「ガマンしろ！！」"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "「でも‥‥ウッ‥‥」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "そこには手足がバラバラに切断された\n『ホテルマン』の『死体』があった。"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "「おかしいわね‥‥」"},
{"id": 78, "speaker": 29, "form": "dlg", "jp": "「悲鳴を聞いて数秒で開けたのに、\n　もうバラバラだなんて‥‥」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「何、冷静なこと言ってるんだよ！」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「早く、救急車を‥‥」"},
{"id": 81, "speaker": 31, "form": "dlg", "jp": "「こんなにバラバラで生きてるハズないだろう？」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「じゃあ、警察にしらせないと‥‥」"},
{"id": 83, "speaker": 31, "form": "dlg", "jp": "「ちょっと待て、この状態で警察なんか呼んだら\n　間違いなくオレたちが逮捕されるぜ‥‥」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「そ、そうだけど‥‥」"},
{"id": 85, "speaker": 29, "form": "dlg", "jp": "「この人、入ってきてから何分たった？」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「１０分ぐらいかな‥‥」"},
{"id": 87, "speaker": 31, "form": "dlg", "jp": "「５分ぐらいだな‥‥」"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "「それがどうかしたの？」"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "「やっぱり、ムリがある‥‥」"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "「何がだよ！」"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "「そんな短時間で\n　ここまでバラバラにできないわ‥‥」"},
{"id": 92, "speaker": 31, "form": "dlg", "jp": "「それに、つい数秒前には\n　悲鳴をあげていたわけだしな‥‥」"},
{"id": 93, "speaker": 29, "form": "dlg", "jp": "「これは『ワナ』かも‥‥」"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "「『ワナ』‥‥？」"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "「私たちをおとしいれる‥‥」"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "「いったい、誰が‥‥」"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "「私たちの『敵』‥‥」"},
{"id": 98, "speaker": 29, "form": "dlg", "jp": "「『ゲーマー』もしくは、\n　私たちに『ジャマされたくない人間』‥‥」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「それって‥‥」"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "「『能力を悪用しているモノ』‥‥」"},
{"id": 101, "speaker": 31, "form": "dlg", "jp": "「とにかく、コイツをどうにかしないと‥‥」"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "「どうにかって、どうするのよ！」"},
{"id": 103, "speaker": 29, "form": "choice", "jp": "「『真犯人』を見つけよう！」"},
{"id": 104, "speaker": 29, "form": "choice", "jp": "「だから警察に‥‥」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「だから警察に‥‥」"},
{"id": 106, "speaker": 31, "form": "dlg", "jp": "「オマエ、どう説明するつもりだ？」"},
{"id": 107, "speaker": 31, "form": "dlg", "jp": "「オレたちしかいない部屋で、\n　短時間で生きた人間がバラバラになった‥‥」"},
{"id": 108, "speaker": 31, "form": "dlg", "jp": "「オレたち以外に誰が疑われると思う？」"},
{"id": 109, "speaker": 31, "form": "dlg", "jp": "「ヘタしたらムショに入れられて\n　出て来れなくなっちゃうぜ！」"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「だからって、\n　このままにはできないだろう？」"},
{"id": 111, "speaker": 29, "form": "dlg", "jp": "「じゃあ、どうするのよ！？」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「『真犯人』を見つけよう！」"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "「『真犯人』？」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「『真犯人』さえ見つかれば、\n　ボクたちが疑われることも‥‥」"},
{"id": 115, "speaker": 31, "form": "dlg", "jp": "「そ、それだっ！」"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "「で、その『真犯人』ってのは？」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「とりあえず、状況を整理してみようよ‥‥」"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「まず、この人は\n　そこのドアをノックして入って来た‥‥」"},
{"id": 119, "speaker": 31, "form": "dlg", "jp": "「アイサツもしてたな‥‥」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「で、ケネスが許可をして中に入って来た‥‥」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「その時は間違いなく１人だけだった？」"},
{"id": 122, "speaker": 31, "form": "dlg", "jp": "「間違いなく１人だった‥‥」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「で、その『シャワールーム』に入っていった‥‥」"},
{"id": 124, "speaker": 31, "form": "dlg", "jp": "「その５分後に『悲鳴』だ‥‥」"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "「その後すぐにドアをあけると‥‥」"},
{"id": 126, "speaker": 31, "form": "dlg", "jp": "「もうバラバラになっていた‥‥」"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「状況から考えて一番おかしいのが‥‥」"},
{"id": 128, "speaker": 2, "form": "choice", "jp": "「『シャワールーム』に入っていったこと‥‥」"},
{"id": 129, "speaker": 2, "form": "choice", "jp": "「１人だったこと‥‥」"},
{"id": 130, "speaker": 2, "form": "choice", "jp": "「短時間でバラバラになっていること‥‥」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「『シャワールーム』に入っていったこと‥‥」"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "「なんで『シャワールーム』に？」"},
{"id": 133, "speaker": 29, "form": "dlg", "jp": "「水もれのメンテナンスって言ってたわよ？」"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「となると‥‥」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「１人だったこと‥‥」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「なんで１人でやってきたのかな？」"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "「メンテナンスぐらい１人で十分でしょう？」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「じゃあ、１人っていうのは別に重要じゃないんだ‥‥」"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "「となると‥‥」"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「重要なのは‥‥」"},
{"id": 143, "speaker": 2, "form": "choice", "jp": "「水もれが本当にあったのか？」"},
{"id": 144, "speaker": 2, "form": "choice", "jp": "「この死体が本当にホテルマンなのか‥‥」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「水もれが本当にあったのか？」"},
{"id": 146, "speaker": 31, "form": "dlg", "jp": "「どっちでもいいことだろう？」"},
{"id": 147, "speaker": 31, "form": "dlg", "jp": "「水もれがウソでも本当でも、\n　短時間にバラバラになれないんだから‥‥」"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「となると‥‥」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「状況から考えて一番おかしいのが‥‥」"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「この死体が本当にホテルマンなのか‥‥」"},
{"id": 152, "speaker": 31, "form": "dlg", "jp": "「どっちでもいいことだろう？」"},
{"id": 153, "speaker": 31, "form": "dlg", "jp": "「コイツの職業がどうであれ、\n　短時間にバラバラになれないんだから‥‥」"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "「となると‥‥」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「状況から考えて一番おかしいのが‥‥」"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "「短時間でバラバラになっていること‥‥」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「常識的に考えて、余程おおげさな道具を使わないと\n　そんなことができるハズがない‥‥」"},
{"id": 159, "speaker": 29, "form": "dlg", "jp": "「じゃあ、コレはなんなのよ‥‥」"},
{"id": 160, "speaker": 29, "form": "choice", "jp": "「おおげさな道具を使った‥‥」"},
{"id": 161, "speaker": 29, "form": "choice", "jp": "「死体じゃない‥‥」"},
{"id": 162, "speaker": 29, "form": "choice", "jp": "「短時間じゃない‥‥」"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「おおげさな道具を使った‥‥」"},
{"id": 164, "speaker": 29, "form": "dlg", "jp": "「そんなものどこにあるの？」"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "「例えば‥‥」"},
{"id": 167, "speaker": 2, "form": "choice", "jp": "「『小型ロボット』‥‥」"},
{"id": 168, "speaker": 2, "form": "choice", "jp": "「『爆弾』‥‥」"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "「『小型ロボット』‥‥」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「『小型ロボット』がバラバラに‥‥」"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "「『小型』なのに、そんな大仕事を？」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「『大型ロボット』！！」"},
{"id": 174, "speaker": 29, "form": "dlg", "jp": "「そんなの入って来たらわかるでしょう！！」"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「『爆弾』‥‥」"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「『爆弾』でドカーンって‥‥」"},
{"id": 179, "speaker": 29, "form": "dlg", "jp": "「そんな音聞こえた？」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "「死体じゃない‥‥」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「つまり‥‥」"},
{"id": 184, "speaker": 2, "form": "choice", "jp": "「『アンドロイド』‥‥」"},
{"id": 185, "speaker": 2, "form": "choice", "jp": "「『人形』‥‥」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「『アンドロイド』‥‥」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「自動的にバラバラになる\n　『アンドロイド』とか‥‥」"},
{"id": 188, "speaker": 29, "form": "dlg", "jp": "「どう見ても『死体』よ‥‥」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "「『人形』‥‥」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「自動的にバラバラになる\n　『人形』とか‥‥」"},
{"id": 192, "speaker": 29, "form": "dlg", "jp": "「どう見ても『死体』よ‥‥」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "「短時間じゃない‥‥」"},
{"id": 195, "speaker": 31, "form": "dlg", "jp": "「はあ？」"},
{"id": 196, "speaker": 31, "form": "dlg", "jp": "「どういうことだ？」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「たぶん、\n　バラバラにされた時間がもっと前なんだ‥‥」"},
{"id": 198, "speaker": 31, "form": "dlg", "jp": "「それはありえないだろう？」"},
{"id": 199, "speaker": 31, "form": "dlg", "jp": "「『悲鳴』を聞いてすぐにドアを開けたんだぞ‥‥」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "「だから、『悲鳴』が『ニセモノ』だったとしたら？」"},
{"id": 201, "speaker": 31, "form": "dlg", "jp": "「はあ？」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「『悲鳴』なんてどうにでもなるだろう？」"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "「だいたい、\n　『悲鳴』がココから聞こえたのかどうかも‥‥」"},
{"id": 204, "speaker": 31, "form": "dlg", "jp": "「た、たしかに‥‥」"},
{"id": 205, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って、\n　それにしても時間が足りなすぎるわ！」"},
{"id": 206, "speaker": 29, "form": "dlg", "jp": "「もし、悲鳴より前だとしても、\n　それでも『５分』しかないのよ‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「じゃぁ、もっと前なら‥‥」"},
{"id": 208, "speaker": 29, "form": "dlg", "jp": "「もっと前って？」"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "「例えば‥‥」"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "「この部屋に入ってくる前だよ‥‥」"},
{"id": 211, "speaker": 31, "form": "dlg", "jp": "「頭イカレちまったのか？」"},
{"id": 212, "speaker": 31, "form": "dlg", "jp": "「じゃあ、コイツはバラバラの状態で\n　ここに入って来たのか？」"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "「不可能じゃないだろう？」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "「『トリック』を使えば‥‥」"},
{"id": 215, "speaker": 31, "form": "dlg", "jp": "「どんな『トリック』なんだよ！」"},
{"id": 216, "speaker": 31, "form": "choice", "jp": "「わからない‥‥」"},
{"id": 217, "speaker": 31, "form": "choice", "jp": "「例えば‥‥」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「わからない‥‥」"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "（多分、情報が少な過ぎるんだ‥‥）"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "（少し情報を整理しないと‥‥）"},
{"id": 221, "speaker": 2, "form": "choice", "jp": "【調べる】"},
{"id": 222, "speaker": 2, "form": "choice", "jp": "【相談する】"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "（まだ、わからないな‥‥）"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "（もう少し、情報を整理しないと‥‥）"},
{"id": 225, "speaker": 2, "form": "choice", "jp": "【調べる】"},
{"id": 226, "speaker": 2, "form": "choice", "jp": "【相談する】"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "【調べる】"},
{"id": 228, "speaker": 2, "form": "choice", "jp": "【シャワールーム】"},
{"id": 229, "speaker": 2, "form": "choice", "jp": "【死体】"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "【シャワールーム】"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "ボクはシャワールームを調べることにした。"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "‥‥‥"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥！？"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "しかし、新しい手がかりは見つからなかった。"},
{"id": 236, "speaker": 2, "form": "dlg", "jp": "【シャワールーム】"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "ボクはもう一度、\nシャワールームを調べることにした。"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "（今度は死体の後ろも調べてみよう！）"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "‥‥‥"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥！？"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "（こ、これは！？）"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「ねえ、コレ見てよ！」"},
{"id": 244, "speaker": 31, "form": "dlg", "jp": "「なんだ、その『ビニール袋』は！？」"},
{"id": 245, "speaker": 31, "form": "dlg", "jp": "ボクは血の入った『ビニール袋』を発見した。"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「たぶん、これで後から血だけばらまいたんだ‥‥」"},
{"id": 247, "speaker": 29, "form": "dlg", "jp": "「でも、誰がそんなことを？」"},
{"id": 248, "speaker": 29, "form": "dlg", "jp": "ボクはもう一度、\nシャワールームを調べることにした。"},
{"id": 249, "speaker": 29, "form": "dlg", "jp": "‥‥‥"},
{"id": 250, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 251, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥！？"},
{"id": 252, "speaker": 29, "form": "dlg", "jp": "しかし、新しい手がかりは見つからなかった。"},
{"id": 253, "speaker": 29, "form": "dlg", "jp": "【死体】"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "ボクは死体を調べることにした。"},
{"id": 255, "speaker": 29, "form": "dlg", "jp": "‥‥‥"},
{"id": 256, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 257, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥！？"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "（やっぱりだ！！）"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「ねえ、この死体の切断面を見て！」"},
{"id": 260, "speaker": 29, "form": "dlg", "jp": "「切断面がどうかしたの？」"},
{"id": 261, "speaker": 2, "form": "dlg", "jp": "「血がかたまっている‥‥」"},
{"id": 262, "speaker": 29, "form": "dlg", "jp": "「なんですって！？」"},
{"id": 263, "speaker": 31, "form": "dlg", "jp": "「こんなに早く血が止まるハズはない‥‥」"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "「やっぱり、かなり前に死んでるんだ‥‥」"},
{"id": 265, "speaker": 29, "form": "dlg", "jp": "「そうみたいね‥‥」"},
{"id": 266, "speaker": 29, "form": "dlg", "jp": "「これで何かわかりそう？」"},
{"id": 267, "speaker": 29, "form": "dlg", "jp": "ボクはもう一度、\n死体を調べることにした。"},
{"id": 268, "speaker": 29, "form": "dlg", "jp": "‥‥‥"},
{"id": 269, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 270, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥！？"},
{"id": 271, "speaker": 29, "form": "dlg", "jp": "しかし、新しい手がかりは見つからなかった。"},
{"id": 272, "speaker": 29, "form": "dlg", "jp": "【相談する】"},
{"id": 273, "speaker": 29, "form": "choice", "jp": "【ジーン】"},
{"id": 274, "speaker": 29, "form": "choice", "jp": "【ケネス】"},
{"id": 275, "speaker": 29, "form": "dlg", "jp": "「能力者の仕業だとしたら‥‥」"},
{"id": 276, "speaker": 29, "form": "dlg", "jp": "「いったいどんな能力なのかしら？」"},
{"id": 277, "speaker": 2, "form": "dlg", "jp": "（たしかに‥‥）"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "（ジーンの能力じゃあムリだし‥‥）"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "（ケネスの能力でもバラバラには‥‥）"},
{"id": 280, "speaker": 29, "form": "dlg", "jp": "「でも、誰がその『ビニール袋』や死体を‥‥」"},
{"id": 281, "speaker": 29, "form": "dlg", "jp": "「血の固まり方からすると\n　かなり前に切断されたのは間違いなさそうね‥‥」"},
{"id": 282, "speaker": 29, "form": "dlg", "jp": "「能力者の仕業だとしたら‥‥」"},
{"id": 283, "speaker": 29, "form": "dlg", "jp": "「いったいどんな能力なのかしら？」"},
{"id": 284, "speaker": 2, "form": "dlg", "jp": "（たしかに‥‥）"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "（ジーンの能力じゃあムリだし‥‥）"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "（ケネスの能力でもバラバラには‥‥）"},
{"id": 287, "speaker": 31, "form": "dlg", "jp": "「ワナにしても悪シュミすぎるな‥‥」"},
{"id": 288, "speaker": 31, "form": "dlg", "jp": "「いったい、誰の仕業なんだ？」"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "「例えば‥‥」"},
{"id": 290, "speaker": 2, "form": "choice", "jp": "「『氷』を使ったトリックなら‥‥」"},
{"id": 291, "speaker": 2, "form": "choice", "jp": "「『細い糸』を使ったトリックなら‥‥」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「『氷』を使ったトリックなら‥‥」"},
{"id": 293, "speaker": 29, "form": "dlg", "jp": "「『氷』‥‥！？」"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "「『氷』で死体を冷やすことで、\n　死亡推定時刻を‥‥！」"},
{"id": 295, "speaker": 29, "form": "dlg", "jp": "「『死亡推定時刻』って、\n　まともな検死をしたわけじゃないのに‥‥」"},
{"id": 296, "speaker": 29, "form": "dlg", "jp": "「その推理は話にならないわ‥‥」"},
{"id": 297, "speaker": 29, "form": "dlg", "jp": "「本当にトリックがわかってるの？」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "「『細い糸』を使ったトリックなら‥‥」"},
{"id": 299, "speaker": 29, "form": "dlg", "jp": "「『細い糸』‥‥！？」"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "「『細い糸』で遠くから、\n　バラバラの死体を引き寄せるんだよ！」"},
{"id": 301, "speaker": 29, "form": "dlg", "jp": "「その推理は話にならないわ‥‥」"},
{"id": 302, "speaker": 29, "form": "dlg", "jp": "「本当にトリックがわかってるの？」"},
{"id": 303, "speaker": 31, "form": "dlg", "jp": "「まあ、『ビニール袋』をやぶるぐらいは\n　オレの能力でも可能だけどな‥‥」"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "「そうだ！」"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「『ケネス』の能力なら‥‥」"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "「『操り人形』みたいに\n　バラバラの死体を操って‥‥」"},
{"id": 307, "speaker": 29, "form": "dlg", "jp": "「たしかに、『サイコキネシス』を使えば、\n　それぐらい可能かもしれないけど‥‥」"},
{"id": 308, "speaker": 29, "form": "dlg", "jp": "「まさか、ケネスのことを！？」"},
{"id": 309, "speaker": 2, "form": "dlg", "jp": "「違うよ‥‥」"},
{"id": 310, "speaker": 2, "form": "dlg", "jp": "「ただ、『すでにバラバラ状態の死体』でも\n　生きてるように見せられるってことだよ」"},
{"id": 311, "speaker": 31, "form": "dlg", "jp": "「ナゴムの言う通りかもしれないな‥‥」"},
{"id": 312, "speaker": 29, "form": "dlg", "jp": "「ダメよ！」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 314, "speaker": 29, "form": "dlg", "jp": "「コイツ入ってくるとき\n　ちゃんと『あいさつ』してたでしょう？」"},
{"id": 315, "speaker": 31, "form": "dlg", "jp": "「そ、そう言えば！！」"},
{"id": 316, "speaker": 29, "form": "dlg", "jp": "「そこまで、『サイコキネシス』でできる？」"},
{"id": 317, "speaker": 31, "form": "dlg", "jp": "「ムリだな‥‥」"},
{"id": 318, "speaker": 2, "form": "dlg", "jp": "「できないの？」"},
{"id": 319, "speaker": 2, "form": "dlg", "jp": "「オウカクマクとノドとシタとクチを\n　動かせばいいだけじゃないの？」"},
{"id": 320, "speaker": 31, "form": "dlg", "jp": "「そんな器用なことができると思うか？」"},
{"id": 321, "speaker": 2, "form": "dlg", "jp": "「じゃぁ、ちがうのかな‥‥」"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "「やっぱ、\n　『死体』を動かすのって難しいのか‥‥」"},
{"id": 323, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って！！」"},
{"id": 324, "speaker": 29, "form": "dlg", "jp": "「たしか、\n　"},
{"id": 325, "speaker": 29, "form": "dlg", "jp": "『死体を操る能力』"},
{"id": 326, "speaker": 29, "form": "dlg", "jp": "って聞いたことあるわ！」"},
{"id": 327, "speaker": 31, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 328, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 329, "speaker": 29, "form": "dlg", "jp": "『ネクロマンス』"},
{"id": 330, "speaker": 29, "form": "dlg", "jp": "っていう能力‥‥」"},
{"id": 331, "speaker": 29, "form": "dlg", "jp": "「なんでも『死体の脳』を\n　乗っ取ってしまう能力らしいの‥‥」"},
{"id": 332, "speaker": 2, "form": "dlg", "jp": "「『脳を乗っ取る』？」"},
{"id": 333, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 334, "speaker": 29, "form": "dlg", "jp": "「人間を飛行機に例えると\n　パイロットが脳ってことでしょう？」"},
{"id": 335, "speaker": 29, "form": "dlg", "jp": "「つまり、死んだ人間はパイロットが不在だから\n　簡単に乗っ取れるらしいの‥‥」"},
{"id": 336, "speaker": 31, "form": "dlg", "jp": "「悪シュミな能力だな‥‥」"},
{"id": 337, "speaker": 2, "form": "dlg", "jp": "「じゃあ、その能力なら‥‥」"},
{"id": 338, "speaker": 29, "form": "dlg", "jp": "「あらかじめ殺してバラバラにした死体を\n　生きてるように見せかけることは可能ね‥‥」"},
{"id": 339, "speaker": 2, "form": "dlg", "jp": "「いったいなんの為に‥‥」"},
{"id": 340, "speaker": 29, "form": "dlg", "jp": "「だから、ワナでしょう！」"},
{"id": 341, "speaker": 29, "form": "dlg", "jp": "「このことが警察にバレたら、\n　私たちがタイホされるのは間違いないから」"},
{"id": 342, "speaker": 2, "form": "dlg", "jp": "「でも、バラバラにする必要は？」"},
{"id": 343, "speaker": 2, "form": "dlg", "jp": "「単に死体を送りこんでくるだけでも‥‥」"},
{"id": 344, "speaker": 31, "form": "dlg", "jp": "「たしかにそうだな‥‥」"},
{"id": 345, "speaker": 29, "form": "dlg", "jp": "「とにかく、\n　この『死体』をどうにかしなくっちゃ‥‥」"},
{"id": 346, "speaker": 31, "form": "dlg", "jp": "「しかたないな‥‥」"},
{"id": 347, "speaker": 31, "form": "dlg", "jp": "「来たときと同じように追い出してやるか‥‥」"},
{"id": 348, "speaker": 2, "form": "dlg", "jp": "「まさか‥‥」"},
{"id": 349, "speaker": 31, "form": "dlg", "jp": "「『サイコキネシス』で退出願うよ！」"},
{"id": 350, "speaker": 31, "form": "dlg", "jp": "「ジーン、わるいけどコイツの着ている\n　ユニフォームと同じもの下から借りて来てくれ」"},
{"id": 351, "speaker": 29, "form": "dlg", "jp": "「ＯＫ！！」"},
{"id": 352, "speaker": 2, "form": "dlg", "jp": "「ボクは何をすればいい？」"},
{"id": 353, "speaker": 31, "form": "dlg", "jp": "「ここをとりあえず掃除しろ！」"},
{"id": 354, "speaker": 2, "form": "dlg", "jp": "「こ、この血をかい？」"},
{"id": 355, "speaker": 31, "form": "dlg", "jp": "「こんなの誰かに見られたら\n　死体があってもなくても同じだ‥‥」"},
{"id": 356, "speaker": 31, "form": "dlg", "jp": "こうしてボクたちは死体を片付けることにした。"},
{"id": 357, "speaker": 29, "form": "dlg", "jp": "「おまたせ！\n　ハイ、ユニフォーム‥‥」"},
{"id": 358, "speaker": 31, "form": "dlg", "jp": "「よし、あとはコイツに着替えさせて‥‥」"},
{"id": 359, "speaker": 31, "form": "dlg", "jp": "「うん？」"},
{"id": 360, "speaker": 29, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 361, "speaker": 31, "form": "dlg", "jp": "「コイツ『右手』がない！！」"},
{"id": 362, "speaker": 29, "form": "dlg", "jp": "「なんですって！？」"},
{"id": 363, "speaker": 29, "form": "dlg", "jp": "たしかにバラバラにされた死体の\n『右手』がみつからなかった‥‥"},
{"id": 364, "speaker": 29, "form": "dlg", "jp": "「『右手』ぐらいならバレないわよ！」"},
{"id": 365, "speaker": 29, "form": "dlg", "jp": "「早くこの死体を追い出してよ！」"},
{"id": 366, "speaker": 31, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 367, "speaker": 31, "form": "dlg", "jp": "ケネスは能力をつかって\nバラバラの死体をつなぎあわせ、"},
{"id": 368, "speaker": 31, "form": "dlg", "jp": "操り人形のように立ち上がらせた。"},
{"id": 369, "speaker": 29, "form": "dlg", "jp": "「なんかギクシャクしてるわね‥‥」"},
{"id": 370, "speaker": 31, "form": "dlg", "jp": "「しかたないだろう！」"},
{"id": 371, "speaker": 31, "form": "dlg", "jp": "「こんなのがウマクできたら\n　ジョウルリの人間国宝になってるよ！」"},
{"id": 372, "speaker": 2, "form": "dlg", "jp": "「日本人じゃ無いから『国宝』にはなんないよ！」"},
{"id": 373, "speaker": 29, "form": "dlg", "jp": "「とにかく、とっととその死体を外に出してよ」"},
{"id": 374, "speaker": 31, "form": "dlg", "jp": "「で、どこに運ぶ？」"},
{"id": 375, "speaker": 29, "form": "dlg", "jp": "「適当にはなれた場所がいいわね‥‥」"},
{"id": 376, "speaker": 31, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 377, "speaker": 31, "form": "dlg", "jp": "「じゃあ、いってくるよ！」"},
{"id": 378, "speaker": 31, "form": "dlg", "jp": "ケネスは『死体』をつれて出ていった。"},
{"id": 379, "speaker": 2, "form": "dlg", "jp": "「うまく行くかな？」"},
{"id": 380, "speaker": 29, "form": "dlg", "jp": "「そんなことより『真犯人』を見つけなきゃ‥‥」"},
{"id": 381, "speaker": 2, "form": "dlg", "jp": "「ねえ、例の『犬の事件』なんだけど‥‥」"},
{"id": 382, "speaker": 2, "form": "dlg", "jp": "「『死体を操る能力』で\n　『犬の死体』をあやつれないかな？」"},
{"id": 383, "speaker": 29, "form": "dlg", "jp": "「‥‥‥！」"},
{"id": 384, "speaker": 29, "form": "dlg", "jp": "「たぶん可能だと思う！」"},
{"id": 385, "speaker": 2, "form": "dlg", "jp": "「とにかく、\n　さっきの『データＣＤ』の情報を見てみない？」"},
{"id": 386, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 387, "speaker": 29, "form": "dlg", "jp": "ボクたちは本部からの\n情報の入った『データＣＤ』を確認することにした。"},
{"id": 388, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥！」"},
{"id": 389, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 390, "speaker": 29, "form": "dlg", "jp": "「無いのよ！」"},
{"id": 391, "speaker": 2, "form": "dlg", "jp": "「何が？」"},
{"id": 392, "speaker": 29, "form": "dlg", "jp": "「『データＣＤ』よ！」"},
{"id": 393, "speaker": 2, "form": "dlg", "jp": "「何だって！」"},
{"id": 394, "speaker": 29, "form": "dlg", "jp": "「たしか、\n　さっきそこに置いたハズなんだけど‥‥」"},
{"id": 395, "speaker": 2, "form": "dlg", "jp": "「ケネスが持っていったのかな？」"},
{"id": 396, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥！！」"},
{"id": 397, "speaker": 2, "form": "dlg", "jp": "「どうしたの？」"},
{"id": 398, "speaker": 29, "form": "dlg", "jp": "「アレを見て！」"},
{"id": 399, "speaker": 29, "form": "dlg", "jp": "ボクはジーンの視線の先を見た！"},
{"id": 400, "speaker": 29, "form": "dlg", "jp": "なんだ！？"},
{"id": 401, "speaker": 29, "form": "dlg", "jp": "それは手首から先だけが小さな生き物のように\n『データＣＤ』を運んでいた。"},
{"id": 402, "speaker": 29, "form": "dlg", "jp": "「早くつかまえて！」"},
{"id": 403, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 404, "speaker": 2, "form": "dlg", "jp": "ボクはその『手』をつかまえようとした。"},
{"id": 405, "speaker": 2, "form": "dlg", "jp": "しかし‥‥"},
{"id": 406, "speaker": 29, "form": "dlg", "jp": "「これが本当の目的だったみたいね‥‥」"},
{"id": 407, "speaker": 2, "form": "dlg", "jp": "「じゃあ、\n　結局『ワナ』に引っかかったってこと？」"},
{"id": 408, "speaker": 29, "form": "dlg", "jp": "「そうみたい‥‥」"},
{"id": 409, "speaker": 29, "form": "dlg", "jp": "どうやら死体を送りつけてきた『犯人』は\nボクたちに殺人の罪をきせるのが目的ではなく、"},
{"id": 410, "speaker": 29, "form": "dlg", "jp": "バラバラになった『手』を利用して\n"},
{"id": 411, "speaker": 29, "form": "dlg", "jp": "『データＣＤ』をうばうことが目的"},
{"id": 412, "speaker": 29, "form": "dlg", "jp": "だったようだ。"},
{"id": 413, "speaker": 31, "form": "dlg", "jp": "「なんだって！」"},
{"id": 414, "speaker": 29, "form": "dlg", "jp": "「どうやら私たちはワナにはまったみたいね‥‥」"},
{"id": 415, "speaker": 2, "form": "dlg", "jp": "「本部からもう１度送ってもらえば‥‥」"},
{"id": 416, "speaker": 29, "form": "dlg", "jp": "「まあ、それはそうなんだけど‥‥」"},
{"id": 417, "speaker": 2, "form": "dlg", "jp": "「だけど‥‥？」"},
{"id": 418, "speaker": 29, "form": "dlg", "jp": "「『敵』にコチラのことが\n　バレているっていうのが気になるわね」"},
{"id": 419, "speaker": 2, "form": "dlg", "jp": "「バレている！？」"},
{"id": 420, "speaker": 29, "form": "dlg", "jp": "「そうじゃないと、『データＣＤ』のことなんか\n　わかるワケないでしょう？」"},
{"id": 421, "speaker": 2, "form": "dlg", "jp": "「そ、そういえば！」"},
{"id": 422, "speaker": 31, "form": "dlg", "jp": "「それに、ここの場所も知ってたワケだしな‥‥」"},
{"id": 423, "speaker": 29, "form": "dlg", "jp": "「たぶん、『テレパシー』を盗聴されたわね‥‥」"},
{"id": 424, "speaker": 2, "form": "dlg", "jp": "「『盗聴』！」"},
{"id": 425, "speaker": 29, "form": "dlg", "jp": "「『テレパシー』なんて単なる『念』だから\n　『能力者』なら誰でも『受信』できちゃうのよ」"},
{"id": 426, "speaker": 2, "form": "dlg", "jp": "「便利なようで不便だね‥‥」"},
{"id": 427, "speaker": 31, "form": "dlg", "jp": "「でも、『受信』するっていっても、\n　『意識』しないと難しいはずじゃなかったか？」"},
{"id": 428, "speaker": 29, "form": "dlg", "jp": "「そうよ‥‥」"},
{"id": 429, "speaker": 29, "form": "dlg", "jp": "「つまり、私たちはすでに『敵』の意識の中に\n　入ってしまってるってことよ‥‥」"},
{"id": 430, "speaker": 31, "form": "dlg", "jp": "「いったい、どうしてオレたちのことがバレたんだ？」"},
{"id": 431, "speaker": 29, "form": "dlg", "jp": "「一番考えられるのが、\n　誰かが『ウカツな行動』を取った‥‥」"},
{"id": 432, "speaker": 2, "form": "dlg", "jp": "「ウカツな行動？」"},
{"id": 433, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 434, "speaker": 29, "form": "dlg", "jp": "「『敵』に怪しまれる行動よ‥‥」"},
{"id": 435, "speaker": 31, "form": "dlg", "jp": "「ちょっとまて！」"},
{"id": 436, "speaker": 31, "form": "dlg", "jp": "「っていうことは、オレたちのウチの誰かが、\n　すでに『敵』に出会ってるってことじゃあ‥‥」"},
{"id": 437, "speaker": 31, "form": "dlg", "jp": "も、もしかして‥‥！！"},
{"id": 438, "speaker": 29, "form": "dlg", "jp": "「ナゴム、心当たりがありそうね？」"},
{"id": 439, "speaker": 2, "form": "dlg", "jp": "「あ、ああ‥‥」"},
{"id": 440, "speaker": 2, "form": "dlg", "jp": "「さっき話した『幽霊』の話なんだけど‥‥」"},
{"id": 441, "speaker": 29, "form": "dlg", "jp": "「『幽霊』がどうしたのよ？」"},
{"id": 442, "speaker": 2, "form": "dlg", "jp": "「アレって、『幽霊』じゃなさそうなんだ‥‥」"},
{"id": 443, "speaker": 31, "form": "dlg", "jp": "「『幽霊』じゃない？」"},
{"id": 444, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 445, "speaker": 2, "form": "dlg", "jp": "「正確には『死んでるのに生きている人間』\n　ってことらしいんだ‥‥」"},
{"id": 446, "speaker": 31, "form": "dlg", "jp": "「『死んでるのに生きている』って‥‥\n　さっきのヤツそのままじゃないか！！」"},
{"id": 447, "speaker": 2, "form": "dlg", "jp": "「ボクもさっきまで気付かなかったんだけど‥‥」"},
{"id": 448, "speaker": 2, "form": "dlg", "jp": "「ケネスが見たっていう女子が、\n　『死んでるのに生きている人間』を見たんだって‥‥」"},
{"id": 449, "speaker": 2, "form": "dlg", "jp": "「で、ソイツのこと確かめたいからついて来てくれって‥‥」"},
{"id": 450, "speaker": 31, "form": "dlg", "jp": "「それで、確かめられたのか？」"},
{"id": 451, "speaker": 2, "form": "dlg", "jp": "「ううん、結局なにも‥‥」"},
{"id": 452, "speaker": 29, "form": "dlg", "jp": "「その話、気になるわね‥‥」"},
{"id": 453, "speaker": 29, "form": "dlg", "jp": "「もうちょっと調べることできない？」"},
{"id": 454, "speaker": 2, "form": "dlg", "jp": "「できると思うよ、\n　彼女もまだまだ調べたいみたいだし‥‥」"},
{"id": 455, "speaker": 31, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 456, "speaker": 31, "form": "dlg", "jp": "「その女の子のこと\n　ちゃんと守ってやったほうがいいぞ‥‥」"},
{"id": 457, "speaker": 31, "form": "dlg", "jp": "「どこでバレたのかはしらないが、\n　もしかしたらその子も狙われるかもしれないな‥‥」"},
{"id": 458, "speaker": 29, "form": "dlg", "jp": "「そ、そうね‥‥」"},
{"id": 459, "speaker": 2, "form": "dlg", "jp": "「コワイこというなよ！」"},
{"id": 460, "speaker": 29, "form": "dlg", "jp": "「まあ、十分注意してあげて‥‥」"}
]
