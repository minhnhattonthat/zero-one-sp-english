[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／１９／ＰＭ０６：４０"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 2, "speaker": 2, "form": "dlg", "jp": "「ただいまぁ～」"},
{"id": 3, "speaker": 3, "form": "dlg", "jp": "「おかえりなさい」"},
{"id": 4, "speaker": 26, "form": "dlg", "jp": "「どうだった、遊園地は楽しかったかい？」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "「三田さん来てたの？」"},
{"id": 6, "speaker": 26, "form": "dlg", "jp": "「女の子たちもいっしょだったんだろう？」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「ゴメンナサイ、ちょっと急いでるから‥‥」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "（きっとジーンたちが来ているハズだ！）"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 12, "speaker": 29, "form": "dlg", "jp": "（どう、楽しかった？）"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "（やっぱりだ！）"},
{"id": 14, "speaker": 29, "form": "dlg", "jp": "（何がやっぱりなの？）"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "（うまく、断われなかったんだよ‥‥）"},
{"id": 16, "speaker": 31, "form": "dlg", "jp": "（まあ、下手に疑われるよりはマシだけどな‥‥）"},
{"id": 17, "speaker": 29, "form": "dlg", "jp": "（それに、\n　別にアナタに説教をしに来たわけじゃないし‥‥）"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "（じゃあいったい？）"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "（本部から情報が入ったの‥‥）"},
{"id": 20, "speaker": 29, "form": "dlg", "jp": "（『クリエーター』の攻撃が\n　だんだん本格化してきてるって‥‥）"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "（本格化？）"},
{"id": 22, "speaker": 29, "form": "dlg", "jp": "（今まで『クリエーター』の仕業と思われる攻撃は\n　工業用機械なんかの暴走だったんだけど‥‥）"},
{"id": 23, "speaker": 29, "form": "dlg", "jp": "（ついに『軍事兵器』などを\n　コントロールし始めたみたいよ）"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "（ウソッ！）"},
{"id": 25, "speaker": 31, "form": "dlg", "jp": "（今の所、少しずつみたいだが、\n　一斉攻撃も時間の問題だな‥‥）"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "（つまり？）"},
{"id": 27, "speaker": 29, "form": "dlg", "jp": "（遊んでいるヒマはないってことよ！）"},
{"id": 28, "speaker": 29, "form": "dlg", "jp": "（とにかく、\n　明日からはもっと積極的に動いてもらうわよ！）"},
{"id": 29, "speaker": 31, "form": "dlg", "jp": "（まあ、宿題は今晩中に終わらせておくんだな‥‥）"},
{"id": 30, "speaker": 31, "form": "dlg", "jp": "（そうしないと、宿題が提出できなくなっちゃうぞ！）"},
{"id": 31, "speaker": 29, "form": "dlg", "jp": "（それどころか宿題を提出する新学期すら\n　来なくなっちゃうわよ！）"},
{"id": 32, "speaker": 29, "form": "dlg", "jp": "（わかったわね！）"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 34, "speaker": 31, "form": "dlg", "jp": "（じゃあ、頼んだぞ！）"},
{"id": 35, "speaker": 31, "form": "dlg", "jp": "「シュン！」"},
{"id": 36, "speaker": 31, "form": "dlg", "jp": "こうして、２人はいつものように\n窓から飛び去った。"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "（『クリエーターの攻撃』か‥‥）"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "（今いち実感がわかないんだよな‥‥）"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "（そんなことより、\n　三田さんに話しかけられてたんだ！！）"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "ボクは三田さんにあやまるために\n１階へと降りることにした。"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 43, "speaker": 3, "form": "dlg", "jp": "「ナゴム！\n　三田さんに失礼でしょう！」"},
{"id": 44, "speaker": 2, "form": "dlg", "jp": "「ゴメンナサイ、急いで確認しなきゃいけない\n　メールがあったから‥‥」"},
{"id": 45, "speaker": 26, "form": "dlg", "jp": "「ハハハハハハ‥‥」"},
{"id": 46, "speaker": 26, "form": "dlg", "jp": "「いいよ、気にしてないから‥‥」"},
{"id": 47, "speaker": 26, "form": "dlg", "jp": "「今日はデートだったんだろう？」"},
{"id": 48, "speaker": 26, "form": "dlg", "jp": "「帰ってきたらメールを確認したくなるよね‥‥」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「で、三田さんは何しに？」"},
{"id": 51, "speaker": 3, "form": "dlg", "jp": "「失礼なことばっかり言わないの！」"},
{"id": 52, "speaker": 3, "form": "dlg", "jp": "「明日、学会があるから、\n　論文を見てもらっていたのよ！」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "『学会』‥‥"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "姉さんは明日の学会で\n『人工知能』についての研究発表を行うらしい。"},
{"id": 56, "speaker": 2, "form": "choice", "jp": "【話す】"},
{"id": 57, "speaker": 2, "form": "choice", "jp": "【聞く】"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "【聞く】"},
{"id": 59, "speaker": 2, "form": "choice", "jp": "【研究発表のことを聞く】"},
{"id": 60, "speaker": 2, "form": "choice", "jp": "【晩ゴハンのオカズを聞く】"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "【聞く】"},
{"id": 62, "speaker": 2, "form": "choice", "jp": "【『清田』って人のことを聞く】"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "【話す】"},
{"id": 64, "speaker": 2, "form": "choice", "jp": "【シローのそっくりさんのことを話す】"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "【シローのそっくりさんのことを話す】"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「そうだ！」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「さっき、『シロー』そっくりな人に出会ったんだ！」"},
{"id": 68, "speaker": 26, "form": "dlg", "jp": "「それ、"},
{"id": 69, "speaker": 26, "form": "dlg", "jp": "『清田くん』"},
{"id": 70, "speaker": 26, "form": "dlg", "jp": "だよ‥‥」"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "『清田』"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "？」"},
{"id": 74, "speaker": 3, "form": "dlg", "jp": "「さっきまで、ココに来てたのよ」"},
{"id": 75, "speaker": 3, "form": "dlg", "jp": "「姉さんも、初めて見た時はあんまりそっくりなんで\n　驚いちゃったけど‥‥」"},
{"id": 76, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 77, "speaker": 26, "form": "dlg", "jp": "シローは清田くんをモデルに造られた"},
{"id": 78, "speaker": 26, "form": "dlg", "jp": "からね‥‥」"},
{"id": 79, "speaker": 26, "form": "choice", "jp": "【遊園地のことを話す】"},
{"id": 80, "speaker": 26, "form": "choice", "jp": "【警部のことを話す】"},
{"id": 81, "speaker": 26, "form": "dlg", "jp": "「それ、さっき聞いた‥‥」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「そうだったね‥‥」"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "【警部のことを話す】"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「そう言えば、さっき警部に会ったんだよ！」"},
{"id": 85, "speaker": 3, "form": "dlg", "jp": "「警部？」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「うん、あの『大槻警部』」"},
{"id": 87, "speaker": 3, "form": "dlg", "jp": "「ふーん‥‥」"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "「なんでも、この近所で\n　『女の子』が行方不明になったんだって‥‥」"},
{"id": 89, "speaker": 26, "form": "dlg", "jp": "「それは心配だね‥‥」"},
{"id": 90, "speaker": 26, "form": "dlg", "jp": "「最近、誘拐事件が多いし‥‥」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「だよね‥‥」"},
{"id": 92, "speaker": 3, "form": "dlg", "jp": "「早く見つかるといいわね‥‥」"},
{"id": 93, "speaker": 26, "form": "dlg", "jp": "「それ、さっき聞いたよ‥‥」"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "「そうだったね‥‥」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "【遊園地のことを話す】"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "「でも、遊園地なんて久しぶりだったよ‥‥」"},
{"id": 97, "speaker": 26, "form": "dlg", "jp": "「いいなぁ～」"},
{"id": 98, "speaker": 26, "form": "dlg", "jp": "「女の子とオバケ屋敷に入って‥‥」"},
{"id": 99, "speaker": 26, "form": "dlg", "jp": "「『キャーーッ！』」"},
{"id": 100, "speaker": 26, "form": "dlg", "jp": "「って、しがみつかれたりしたんだろう？」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "「そんな気の弱い女の子といっしょじゃなかったから」"},
{"id": 102, "speaker": 26, "form": "dlg", "jp": "「それ、さっき聞いたよ‥‥」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「ゴメンなさい‥‥」"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "【晩ゴハンのオカズを聞く】"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「今晩のオカズは？」"},
{"id": 106, "speaker": 3, "form": "dlg", "jp": "「エビフライとサラダよ‥‥」"},
{"id": 107, "speaker": 3, "form": "dlg", "jp": "「エビフライとサラダって言ったでしょう？」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "「あ、そうだったね‥‥」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "【研究発表のことを聞く】"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「まさか、『シロー』のことを発表しちゃうの？」"},
{"id": 111, "speaker": 3, "form": "dlg", "jp": "「ええ、ある程度ね‥‥」"},
{"id": 112, "speaker": 3, "form": "dlg", "jp": "「もちろん、『軍事衛星』のことなんかは\n　かくしておくけど‥‥」"},
{"id": 113, "speaker": 3, "form": "choice", "jp": "「その方が安全だね！」"},
{"id": 114, "speaker": 3, "form": "choice", "jp": "「それはもったいないよ！」"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "「それはもったいないよ！」"},
{"id": 116, "speaker": 3, "form": "dlg", "jp": "「だけど、あんまりシローの事が他人に知れると\n　大変なことになるでしょう？」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「その方が安全だね！」"},
{"id": 118, "speaker": 3, "form": "dlg", "jp": "「そうでしょう？」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "（って、何度も同じこと聞いてもしかたないか‥‥）"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "（シローって言えば‥‥）"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "【『清田』って人のことを聞く】"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「じゃあ、『清田』って人は？」"},
{"id": 123, "speaker": 26, "form": "dlg", "jp": "「以前は"},
{"id": 124, "speaker": 26, "form": "dlg", "jp": "常光寺博士の助手だった"},
{"id": 125, "speaker": 26, "form": "dlg", "jp": "んだ‥‥」"},
{"id": 126, "speaker": 26, "form": "dlg", "jp": "「ボクなんかより、\n　ずっと頭のいいヤツだったんだけど‥‥」"},
{"id": 127, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 128, "speaker": 26, "form": "dlg", "jp": "妹さんが事故で大ケガ"},
{"id": 129, "speaker": 26, "form": "dlg", "jp": "をしてね、\n　それで研究室をヤメちゃったんだ‥‥」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「へぇ～～～」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「で、なんでウチに来たの？」"},
{"id": 132, "speaker": 3, "form": "dlg", "jp": "「『シローの情報』を教えて欲しいって‥‥」"},
{"id": 133, "speaker": 3, "form": "dlg", "jp": "「今、別の大学でまた研究を再開し始めたらしいの‥‥」"},
{"id": 134, "speaker": 3, "form": "dlg", "jp": "「今度は１人で‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「でもなんで『シロー』なの？」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「その清田って人も『人工知能』の研究をしてるの？」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「父さんの助手なんだったら、\n　『ロボット工学』が専門なんじゃあ？」"},
{"id": 138, "speaker": 3, "form": "dlg", "jp": "「それはそうみたいよ‥‥」"},
{"id": 139, "speaker": 3, "form": "dlg", "jp": "「父さんと同じように、\n　"},
{"id": 140, "speaker": 3, "form": "dlg", "jp": "機械と人間をつなげる研究"},
{"id": 141, "speaker": 3, "form": "dlg", "jp": "をしているらしいの‥‥」"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「じゃあ、シローは関係ないんじゃぁ？」"},
{"id": 143, "speaker": 26, "form": "dlg", "jp": "「清田くんは\n　"},
{"id": 144, "speaker": 26, "form": "dlg", "jp": "『脳』のバックアップを研究している"},
{"id": 145, "speaker": 26, "form": "dlg", "jp": "らしいんだ‥‥」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「『脳』？」"},
{"id": 147, "speaker": 26, "form": "dlg", "jp": "「常光寺博士が唯一、手をつけてない部分だよ‥‥」"},
{"id": 148, "speaker": 26, "form": "dlg", "jp": "「たぶん、妹さんの事故が関係あるんだと思うけど‥‥」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 150, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 151, "speaker": 26, "form": "dlg", "jp": "清田くんの妹は『脳』をケガした"},
{"id": 152, "speaker": 26, "form": "dlg", "jp": "んだよ‥‥」"},
{"id": 153, "speaker": 26, "form": "dlg", "jp": "「手とか足なら、博士の技術で\n　回復させられるんだけど、脳を取り替えるわけには」"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "「そ、そうだよね‥‥」"},
{"id": 155, "speaker": 26, "form": "dlg", "jp": "「それで\n　"},
{"id": 156, "speaker": 26, "form": "dlg", "jp": "『脳のバックアップ』の研究"},
{"id": 157, "speaker": 26, "form": "dlg", "jp": "をし始めたんだって」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「でも、そんなことできるの？」"},
{"id": 159, "speaker": 26, "form": "dlg", "jp": "「う～ん‥‥」"},
{"id": 160, "speaker": 26, "form": "dlg", "jp": "「ボクには想像のできないレベルの技術だね‥‥」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「それに、もしそれができても妹さんは\n　元に戻らないんじゃぁ？」"},
{"id": 162, "speaker": 3, "form": "dlg", "jp": "「だから、『シローの情報』が欲しいらしいの‥‥」"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「『シローの情報』？」"},
{"id": 164, "speaker": 26, "form": "dlg", "jp": "「パソコンの"},
{"id": 165, "speaker": 26, "form": "dlg", "jp": "『データーの復旧』"},
{"id": 166, "speaker": 26, "form": "dlg", "jp": "とかわかるかい？」"},
{"id": 167, "speaker": 26, "form": "choice", "jp": "「わかるよ！」"},
{"id": 168, "speaker": 26, "form": "choice", "jp": "「わからないよ！」"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "「わかるよ！」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「メモリとかハードディスクとかに入ってる\n　必要な情報がこわれた時に」"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "「元に戻すってヤツだろう？」"},
{"id": 172, "speaker": 26, "form": "dlg", "jp": "「うん、情報が完全にこわれた場合は無理だけど、\n　部分的にこわれて情報が読めないだけなら」"},
{"id": 173, "speaker": 26, "form": "dlg", "jp": "「そこを直してやれば、\n　元通りに情報を読めるようになるんだよね」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「わからないよ！」"},
{"id": 175, "speaker": 26, "form": "dlg", "jp": "「パソコンって動くために必要な情報が\n　メモリとかハードディスクとかに入ってるんだけど」"},
{"id": 176, "speaker": 26, "form": "dlg", "jp": "「これがこわれることがあるんだよ‥‥」"},
{"id": 177, "speaker": 26, "form": "dlg", "jp": "「そんな時、特殊なソフトなんかを使って、\n　こわれた情報を元に戻せる場合があるんだ」"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「そんなことできるの！？」"},
{"id": 179, "speaker": 26, "form": "dlg", "jp": "「うん、情報が完全にこわれた場合は無理だけど、\n　部分的にこわれて情報が読めないだけなら」"},
{"id": 180, "speaker": 26, "form": "dlg", "jp": "「そこを直してやれば、\n　元通りに情報を読めるようになるんだ」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「へぇ～～」"},
{"id": 182, "speaker": 3, "form": "dlg", "jp": "「清田さんの話では、妹さんの脳から\n　"},
{"id": 183, "speaker": 3, "form": "dlg", "jp": "『記憶の断片』を抜き出すことに成功"},
{"id": 184, "speaker": 3, "form": "dlg", "jp": "したらしいの‥‥」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "「じゃあ、その"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "『記憶の断片』"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "から\n　"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "脳を修復しようとしてる"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "の？」"},
{"id": 190, "speaker": 3, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 191, "speaker": 3, "form": "dlg", "jp": "「でも、人間として生きて行くために必要な\n　情報のほとんどがこわれているらしくって」"},
{"id": 192, "speaker": 3, "form": "dlg", "jp": "「今、清田さんのもとにある\n　妹さんの『記憶の断片』だけではダメらしいの‥‥」"},
{"id": 193, "speaker": 3, "form": "dlg", "jp": "「で、こわれてしまった所を\n　"},
{"id": 194, "speaker": 3, "form": "dlg", "jp": "シローのデータで補完（ホカン）"},
{"id": 195, "speaker": 3, "form": "dlg", "jp": "したいらしいの‥‥」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「で、そんなことできるの？」"},
{"id": 197, "speaker": 3, "form": "dlg", "jp": "「わからないわ‥‥」"},
{"id": 198, "speaker": 3, "form": "dlg", "jp": "「人工知能と人間の脳が同じだとは思えないから‥‥」"},
{"id": 199, "speaker": 26, "form": "dlg", "jp": "「ただ、『シロー』は博士の造った体を\n　動かすことができただろう？」"},
{"id": 200, "speaker": 26, "form": "dlg", "jp": "「本来、博士の造った体は\n　『人間の脳』が動かすものだから」"},
{"id": 201, "speaker": 26, "form": "dlg", "jp": "「かなり似たような思考回路になってると思うんだよ‥‥」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「で、姉さんは協力してあげるの？」"},
{"id": 203, "speaker": 3, "form": "dlg", "jp": "「もちろんよ！」"},
{"id": 204, "speaker": 3, "form": "dlg", "jp": "「ただ、明日の学会が終わるまで、\n　外部に渡すわけにはいかないから」"},
{"id": 205, "speaker": 3, "form": "dlg", "jp": "「それ以降にしてくださいって返事したんだけど‥‥」"},
{"id": 206, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "その時！"},
{"id": 208, "speaker": 2, "form": "dlg", "jp": "「ピンポーン！！」"},
{"id": 209, "speaker": 3, "form": "dlg", "jp": "「ハ～～～～～イ！」"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "「ボクが出るよ！」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 213, "speaker": 11, "form": "dlg", "jp": "「コンバンハ‥‥」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "「どうかしたのですか？」"},
{"id": 215, "speaker": 3, "form": "dlg", "jp": "「誰ぇ？」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「警部さん！！」"},
{"id": 217, "speaker": 3, "form": "dlg", "jp": "「あがってもらいなさい」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「あがってって‥‥」"},
{"id": 219, "speaker": 11, "form": "dlg", "jp": "「イヤ、そんな大した用でも‥‥」"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「あがってよ！」"},
{"id": 221, "speaker": 11, "form": "dlg", "jp": "「じゃあ、お言葉にあまえて‥‥」"},
{"id": 222, "speaker": 3, "form": "dlg", "jp": "「そのせつはどうも\n　ありがとうございました‥‥」"},
{"id": 223, "speaker": 11, "form": "dlg", "jp": "「いえ、ワレワレは単なる職務ですから‥‥」"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "「で、何の用ですか？」"},
{"id": 225, "speaker": 11, "form": "dlg", "jp": "「実は‥‥」"},
{"id": 226, "speaker": 11, "form": "dlg", "jp": "「また、"},
{"id": 227, "speaker": 11, "form": "dlg", "jp": "女の子が行方不明"},
{"id": 228, "speaker": 11, "form": "dlg", "jp": "になったんですよ‥‥」"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "「さっき言ってたコとは別のコ？」"},
{"id": 230, "speaker": 11, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 231, "speaker": 11, "form": "dlg", "jp": "「これでこの町でも４人目です‥‥」"},
{"id": 232, "speaker": 26, "form": "dlg", "jp": "「４人も！？」"},
{"id": 233, "speaker": 26, "form": "dlg", "jp": "「ぜんぜん、ニュースとかで報道されてないんじゃぁ？」"},
{"id": 234, "speaker": 11, "form": "dlg", "jp": "「まあ、今どきの子供ですから‥‥」"},
{"id": 235, "speaker": 11, "form": "dlg", "jp": "「夏休みでしょう？」"},
{"id": 236, "speaker": 11, "form": "dlg", "jp": "「大騒ぎした後で、\n　単なる『家出』でしたってこともあるんで」"},
{"id": 237, "speaker": 11, "form": "dlg", "jp": "「後でその子たちがハジをかかないように\n　事件と確定するまでは公開できないんですよ‥‥」"},
{"id": 238, "speaker": 26, "form": "dlg", "jp": "「大変ですね‥‥」"},
{"id": 239, "speaker": 11, "form": "dlg", "jp": "「もし、情報がありましたら\n　署の方まで連絡ください‥‥」"},
{"id": 240, "speaker": 3, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 241, "speaker": 11, "form": "dlg", "jp": "「じゃあ、私はこれで失礼します」"},
{"id": 242, "speaker": 3, "form": "dlg", "jp": "「今、お茶を‥‥」"},
{"id": 243, "speaker": 11, "form": "dlg", "jp": "「いえ、まだ回るところがありますんで‥‥」"},
{"id": 244, "speaker": 26, "form": "dlg", "jp": "「なんか、イヤな時代になりましたね‥‥」"},
{"id": 245, "speaker": 3, "form": "dlg", "jp": "「本当ですね‥‥」"},
{"id": 246, "speaker": 26, "form": "dlg", "jp": "「ナゴムくんも、家族に心配かけちゃダメだよ！」"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "「ハイ‥‥」"}
]
