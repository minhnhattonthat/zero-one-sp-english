[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／１１／ＰＭ０８：００"},
{"id": 1, "speaker": 3, "form": "dlg", "jp": "「あんまり、『寄り道』なんてしちゃダメよ、\n　『通り魔』が出没するらしいから‥‥」"},
{"id": 2, "speaker": 26, "form": "dlg", "jp": "「まあ、ウワサの『通り魔』は若い女の人しか\n　襲わないらしいですケド‥‥」"},
{"id": 3, "speaker": 3, "form": "dlg", "jp": "「でも、ナゴムが『通り魔』と間違えられるかも‥‥」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「姉さん、そりゃないよ‥‥」"},
{"id": 5, "speaker": 3, "form": "dlg", "jp": "「変なウワサが立たないように、\n　キチンとしなさいってコトよ！」"},
{"id": 6, "speaker": 26, "form": "dlg", "jp": "「でも、同じ町に『おかしな通り魔』がいるって\n　なんだか気持ちわるいですよね‥‥」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「たしかに‥‥」"},
{"id": 8, "speaker": 2, "form": "choice", "jp": "「ルードの連中より気味が悪い‥‥」"},
{"id": 9, "speaker": 2, "form": "choice", "jp": "「超能力者より気味が悪い‥‥」"},
{"id": 10, "speaker": 2, "form": "choice", "jp": "「サイボーグより気味が悪い‥‥」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「ルードの連中より気味が悪い‥‥」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「サイボーグより気味が悪い‥‥」"},
{"id": 13, "speaker": 3, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 14, "speaker": 3, "form": "dlg", "jp": "「『ルード』の連中の方が目的がハッキりしてる分\n　気持ち悪くないわね‥‥」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「超能力者より気味が悪い‥‥」"},
{"id": 16, "speaker": 3, "form": "dlg", "jp": "「へっ‥‥？」"},
{"id": 17, "speaker": 3, "form": "dlg", "jp": "「どうして、『超能力者』なの？」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "（しまった‥‥）"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「いや、なんとなくだよ‥‥」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「その『通り魔』って捕まる気配はないの？」"},
{"id": 21, "speaker": 26, "form": "dlg", "jp": "「まあ、手がかりはいっぱいあるらしいんですよ」"},
{"id": 22, "speaker": 26, "form": "dlg", "jp": "「現場を目撃した人も結構いるらしいんですけど‥‥」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「それで捕まらないってどういうこと？」"},
{"id": 24, "speaker": 26, "form": "dlg", "jp": "「有力な手がかりではなく、\n　余計な情報が多くて‥‥」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「でも現場を目撃した人もいるんでしょう？」"},
{"id": 26, "speaker": 26, "form": "dlg", "jp": "「でも、目撃されているのは現場と襲われる瞬間だけで、\n　犯人は目撃されてないらしいんですよ‥‥」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 28, "speaker": 26, "form": "dlg", "jp": "「目撃者の話では、被害者は目の前でいきなり\n　悲鳴をあげていなくなって」"},
{"id": 29, "speaker": 26, "form": "dlg", "jp": "「数日後に突然、\n　現場に死体だけが帰ってたらしいんですよ」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "「通り魔っていうより『神隠し』って感じだね‥‥」"},
{"id": 31, "speaker": 26, "form": "dlg", "jp": "「最近、\n　おかしな事件が増えたような気がしますよね‥‥」"},
{"id": 32, "speaker": 26, "form": "dlg", "jp": "「ネット上でのウワサじゃあ、\n　いろんな機械の誤作動の事故も増えてるって‥‥」"},
{"id": 33, "speaker": 26, "form": "dlg", "jp": "「こないだなんか\n　『軍事衛星』が誤作動したってウワサまで‥‥」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「ふ～ん‥‥」"},
{"id": 35, "speaker": 26, "form": "dlg", "jp": "「まあ、不思議なことがあるから\n　世の中面白いんですけどね‥‥」"},
{"id": 36, "speaker": 26, "form": "dlg", "jp": "「実はボクが科学者を目ざしたのも\n　不思議を究明したいからなんですけど‥‥」"},
{"id": 37, "speaker": 3, "form": "dlg", "jp": "「じゃあ、三田さんは『幽霊』や『超能力』を信じる人？」"},
{"id": 38, "speaker": 26, "form": "dlg", "jp": "「ええ、信じるもなにも『大好物』です！」"},
{"id": 39, "speaker": 26, "form": "choice", "jp": "「科学者なのに？」"},
{"id": 40, "speaker": 26, "form": "choice", "jp": "「趣味悪い！！」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「科学者なのに？」"},
{"id": 42, "speaker": 26, "form": "dlg", "jp": "「『科学者だから』ですよ！！」"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「趣味悪い！！」"},
{"id": 44, "speaker": 26, "form": "dlg", "jp": "「そんなことはありませんよ！」"},
{"id": 45, "speaker": 26, "form": "dlg", "jp": "「不思議を解明しようとするのが\n　科学者の宿命です！」"},
{"id": 46, "speaker": 26, "form": "dlg", "jp": "「『エジソン』が『霊界通信』を\n　発明しようとしていたのは有名な話ですし‥‥」"},
{"id": 47, "speaker": 26, "form": "dlg", "jp": "「もっと有名なのでは、\n　例の『火の玉教授』とか‥‥」"},
{"id": 48, "speaker": 26, "form": "choice", "jp": "「じゃあ、『ＵＦＯ』とか詳しいの？」"},
{"id": 49, "speaker": 26, "form": "choice", "jp": "「じゃあ、『超能力』とか詳しいの？」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「じゃあ、『ＵＦＯ』とか詳しいの？」"},
{"id": 51, "speaker": 26, "form": "dlg", "jp": "「まあ、それなりにね‥‥」"},
{"id": 52, "speaker": 26, "form": "choice", "jp": "「やっぱり、『宇宙人』の乗り物なの？」"},
{"id": 53, "speaker": 26, "form": "choice", "jp": "「どうして『円盤型』なの？」"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "「やっぱり、『宇宙人』の乗り物なの？」"},
{"id": 55, "speaker": 26, "form": "dlg", "jp": "「それはどうかなぁ～？」"},
{"id": 56, "speaker": 26, "form": "dlg", "jp": "「『未確認飛行物体』の目撃証言は\n　信じられるレポートもたくさんあるけど‥‥」"},
{"id": 57, "speaker": 26, "form": "dlg", "jp": "「『エイリアン遭遇』のレポートは\n　ウソくさいものばかりだから‥‥」"},
{"id": 58, "speaker": 26, "form": "choice", "jp": "「『アダムスキーさん』の話は？」"},
{"id": 59, "speaker": 26, "form": "choice", "jp": "「『ニューハンプシャー州の夫婦』の話は？」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「『アダムスキーさん』の話は？」"},
{"id": 61, "speaker": 26, "form": "dlg", "jp": "「ああ、あの『アダムスキー型ＵＦＯ』の‥‥」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "「『金星人に会った』って‥‥」"},
{"id": 63, "speaker": 26, "form": "dlg", "jp": "「『６１歳』で『金星人』に出会って、\n　ペンダントをもらったっていってるけど‥‥」"},
{"id": 64, "speaker": 26, "form": "dlg", "jp": "「若い頃の写真に\n　そのペンダントが写っているからな‥‥」"},
{"id": 65, "speaker": 26, "form": "dlg", "jp": "「なにより、月や火星に空気があるって話を\n　信じられるかどうかって感じかな‥‥」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「『ニューハンプシャー州の夫婦』の話は？」"},
{"id": 67, "speaker": 26, "form": "dlg", "jp": "「あの『宇宙人にさらわれて身体検査された』\n　っていう‥‥」"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "「ホントだったら恐いよね‥‥」"},
{"id": 69, "speaker": 26, "form": "dlg", "jp": "「ホントでしたらね‥‥」"},
{"id": 70, "speaker": 26, "form": "dlg", "jp": "「あれって、『逆行催眠』で出て来た証言でしょう？」"},
{"id": 71, "speaker": 26, "form": "dlg", "jp": "「『逆行催眠』ってあてになんないんですよ‥‥」"},
{"id": 72, "speaker": 26, "form": "dlg", "jp": "「だいたい、『催眠状態』ってネボケた状態だから」\n"},
{"id": 73, "speaker": 26, "form": "dlg", "jp": "「『前世を見た』とか『宇宙人にあった』とか\n　寝言みたいなコトを‥‥」"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "「どうして『円盤型』なの？」"},
{"id": 75, "speaker": 26, "form": "dlg", "jp": "「それは、はじめてＵＦＯが大々的に\n　マスコミに報じられた時の話なんですけど‥‥」"},
{"id": 76, "speaker": 26, "form": "dlg", "jp": "「目撃者が『お皿を投げたみたいな飛び方だった』\n　って言ったのが『空飛ぶ円盤』って報じられたから」"},
{"id": 77, "speaker": 26, "form": "dlg", "jp": "「そのせいでみんなかってに、『ＵＦＯ』＝『円盤型』\n　って思い込むようになったんですよ」"},
{"id": 78, "speaker": 26, "form": "dlg", "jp": "「別に目撃者は\n　形については何も言ってないんですけどね？」"},
{"id": 79, "speaker": 3, "form": "dlg", "jp": "「詳しいんですね‥‥」"},
{"id": 80, "speaker": 3, "form": "choice", "jp": "「ちょっと見直したよ‥‥」"},
{"id": 81, "speaker": 3, "form": "choice", "jp": "「‥‥友達少ないでしょう？」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「‥‥友達少ないでしょう？」"},
{"id": 83, "speaker": 26, "form": "dlg", "jp": "「まあ、孤独は科学者の宿命です！！」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「ちょっと見直したよ‥‥」"},
{"id": 85, "speaker": 26, "form": "dlg", "jp": "「アリガトウ‥‥」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「じゃあ、『超能力』とか詳しいの？」"},
{"id": 87, "speaker": 26, "form": "dlg", "jp": "「まあ、それなりにね‥‥」"},
{"id": 88, "speaker": 26, "form": "choice", "jp": "「念写とか詳しい？」"},
{"id": 89, "speaker": 26, "form": "choice", "jp": "「やっぱり、スプーン曲げ？」"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "「念写とか詳しい？」"},
{"id": 91, "speaker": 26, "form": "dlg", "jp": "「あれは手品だからなぁ～」"},
{"id": 92, "speaker": 26, "form": "choice", "jp": "「『東大の博士がみとめた』って‥‥？」"},
{"id": 93, "speaker": 26, "form": "choice", "jp": "「『月の裏側の写真』の話は？」"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "「『東大の博士がみとめた』って‥‥」"},
{"id": 95, "speaker": 26, "form": "dlg", "jp": "「『福来博士』のことだろう？」"},
{"id": 96, "speaker": 26, "form": "dlg", "jp": "「あの人まともな実験で成功したことないから‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「やっぱり、スプーン曲げ？」"},
{"id": 98, "speaker": 26, "form": "dlg", "jp": "「あれは手品だからなぁ～」"},
{"id": 99, "speaker": 26, "form": "choice", "jp": "「やっぱり‥‥」"},
{"id": 100, "speaker": 26, "form": "choice", "jp": "「じゃあ、誰でもできるの？」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "「やっぱり‥‥」"},
{"id": 102, "speaker": 26, "form": "dlg", "jp": "「だって、どうして『スプーン』なんだって思いません？」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「思う、思う‥‥」"},
{"id": 104, "speaker": 26, "form": "dlg", "jp": "「あれって、パーティーなんかで\n　簡単にできるからでしょう？」"},
{"id": 105, "speaker": 26, "form": "dlg", "jp": "「まあ、マッチ棒を使った\n　『テーブルマジック』みたいなもんですよ‥‥」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「『月の裏側の写真』の話は？」"},
{"id": 107, "speaker": 26, "form": "dlg", "jp": "「あれって雑誌の想像図だろう？」"},
{"id": 108, "speaker": 26, "form": "dlg", "jp": "「どうして、そんなもの『念写』するの？」"},
{"id": 109, "speaker": 26, "form": "dlg", "jp": "「インチキにもほどがあるよ‥‥」"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「じゃあ、誰でもできるの？」"},
{"id": 111, "speaker": 26, "form": "dlg", "jp": "「ですから、手品なんで、手品師じゃないと‥‥」"},
{"id": 112, "speaker": 26, "form": "dlg", "jp": "「そもそも、誰でもできないことをするから\n　『超能力』だっていっちゃうと‥‥」"},
{"id": 113, "speaker": 26, "form": "dlg", "jp": "「『大食い』も『腹話術』も\n　みんな『超能力』ってことになっちゃいますね‥‥」"},
{"id": 114, "speaker": 26, "form": "dlg", "jp": "２００５／０７／２１／ＰＭ０８：００"},
{"id": 115, "speaker": 26, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「ただいま‥‥」"},
{"id": 117, "speaker": 3, "form": "dlg", "jp": "「おかえりなさい」"},
{"id": 118, "speaker": 26, "form": "dlg", "jp": "「オジャマしてるよ」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「三田さん、来てたの？」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "（『三田さん』‥‥）"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "（父さんの助手の中で一番父さんが信頼している人。）"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "（なんでも、本当は整形外科医を目指していたらしいが\n　父さんの研究を知り、医師免許を取りながら、）"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "（再び、理工学に鞍替えした奇特な人だ。）"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「父さんは？」"},
{"id": 125, "speaker": 26, "form": "dlg", "jp": "「研究所に残ってるよ‥‥」"},
{"id": 126, "speaker": 26, "form": "dlg", "jp": "「ボクは博士の着替えを取りに来ただけだから‥‥」"},
{"id": 127, "speaker": 3, "form": "dlg", "jp": "「三田さんからも父さんにたまには\n　帰って来るように言っておいてください」"},
{"id": 128, "speaker": 26, "form": "dlg", "jp": "「そう言ってるんですけどね‥‥」"},
{"id": 129, "speaker": 3, "form": "dlg", "jp": "「あいかわらず忙しいんですか？」"},
{"id": 130, "speaker": 26, "form": "dlg", "jp": "「ゼミが再開するまでに\n　やっておきたいことがあるみたいですよ‥‥」"},
{"id": 131, "speaker": 3, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 132, "speaker": 3, "form": "dlg", "jp": "父さんが研究にのめり込むと他のことが見えなくなるのは\nいつものことだった。"},
{"id": 133, "speaker": 3, "form": "dlg", "jp": "「三田さん、食事して行きますよね？」"},
{"id": 134, "speaker": 26, "form": "dlg", "jp": "「いえ、博士が待ってますから‥‥」"},
{"id": 135, "speaker": 3, "form": "dlg", "jp": "「父さんは待たせておけばいいわ！」"},
{"id": 136, "speaker": 3, "form": "dlg", "jp": "「せっかく作ったんだから食べてってくださいよ」"},
{"id": 137, "speaker": 26, "form": "dlg", "jp": "「そ、そうですか‥‥」"},
{"id": 138, "speaker": 26, "form": "dlg", "jp": "「じゃぁ‥‥」"},
{"id": 139, "speaker": 26, "form": "dlg", "jp": "こうしてボクたちは三田さんといっしょに\n食事をすることになった。"},
{"id": 140, "speaker": 26, "form": "dlg", "jp": "「どうしたんだい？」"},
{"id": 141, "speaker": 26, "form": "dlg", "jp": "「あんまりハシが進んでなさそうだけど‥‥」"},
{"id": 142, "speaker": 26, "form": "dlg", "jp": "当然だ‥‥"},
{"id": 143, "speaker": 26, "form": "dlg", "jp": "まだ、頭の中が整理されなくて\nとても食欲なんてわいてこない。"},
{"id": 144, "speaker": 3, "form": "dlg", "jp": "「ちゃんと食べないと夏バテするわよ‥‥」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 146, "speaker": 26, "form": "dlg", "jp": "「なやみでもあるの？」"},
{"id": 147, "speaker": 26, "form": "dlg", "jp": "「ボクが相談にのれること？」"},
{"id": 148, "speaker": 26, "form": "dlg", "jp": "「顔色があんまりよくなさそうだけど‥‥」"},
{"id": 149, "speaker": 3, "form": "dlg", "jp": "「夜ふかしなんかしてるからよ！」"},
{"id": 150, "speaker": 3, "form": "dlg", "jp": "「中学生にもなって『キモダメシ』なんて‥‥」"},
{"id": 151, "speaker": 26, "form": "dlg", "jp": "「ナゴムくんの世代でも『キモダメシ』なんてするの？」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「友だちが『幽霊』が見たいってむりやり‥‥」"},
{"id": 153, "speaker": 26, "form": "dlg", "jp": "「なるほど、探究心はいいけど、\n　家族に心配をかけちゃダメだな‥‥」"},
{"id": 154, "speaker": 26, "form": "dlg", "jp": "「で、『幽霊』は見れたの？」"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "「見れるわけないじゃないか！」"},
{"id": 156, "speaker": 26, "form": "dlg", "jp": "「そうなの？」"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "「三田さん、科学者でしょう？」"},
{"id": 158, "speaker": 26, "form": "dlg", "jp": "「そうだよ、だから聞いたんじゃないか、\n　『見れた』のか『見れなかった』のか‥‥」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "「はぁ？」"},
{"id": 160, "speaker": 26, "form": "dlg", "jp": "「真実を追求するのが『科学』であって、\n　先人の公式に当てはめるのが『科学』じゃないから」"},
{"id": 161, "speaker": 26, "form": "dlg", "jp": "「もし、ナゴムくんが『幽霊』を見たとしても\n　それは科学的になんらおかしいことじゃないから」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「そうなの！？」"},
{"id": 163, "speaker": 26, "form": "dlg", "jp": "「なんだか、ちょっと元気が出て来たみたいだね」"},
{"id": 164, "speaker": 26, "form": "dlg", "jp": "「じゃあ、続けるね‥‥」"},
{"id": 165, "speaker": 26, "form": "dlg", "jp": "「ただ、その『幽霊』が『クレオパトラ』の幽霊で\n　日本語で話したってなると少しおかしいし‥‥」"},
{"id": 166, "speaker": 26, "form": "dlg", "jp": "「さらにカタカナで『クレオパトラ』って\n　サインでも残したらさらに疑わしくなるけど」"},
{"id": 167, "speaker": 3, "form": "dlg", "jp": "「ローマ字で、『ＫＵＲＥＯＰＡＴＯＲＡ』って\n　書いてるとかね‥‥」"},
{"id": 168, "speaker": 26, "form": "dlg", "jp": "「で、ローマ字はローマのシーザーから習ったとか‥‥」"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "「もしかして、２人でボクのことバカにしてる？」"},
{"id": 170, "speaker": 26, "form": "dlg", "jp": "「ゴメン、ゴメン‥‥」"},
{"id": 171, "speaker": 26, "form": "dlg", "jp": "「まあ、『科学』は『真実を追求する学問』だから、\n　『信じる』ことと『疑う』ことが重要なんだよ‥‥」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「なんだかムジュンしてるね‥‥」"},
{"id": 173, "speaker": 26, "form": "dlg", "jp": "「世の中そんなものだよ、ムジュンをつっこむのは\n　それ専門のゲームがあるし‥‥」"},
{"id": 174, "speaker": 26, "form": "dlg", "jp": "三田さんは、わからないことをうれしそうに話した。"},
{"id": 175, "speaker": 26, "form": "dlg", "jp": "「だからボクは『幽霊』も『宇宙人』も\n　まったく否定はしないんだ‥‥」"},
{"id": 176, "speaker": 26, "form": "choice", "jp": "「じゃあ、『幽霊』を信じるの？」"},
{"id": 177, "speaker": 26, "form": "choice", "jp": "「じゃあ、『宇宙人』を信じるの？」"},
{"id": 178, "speaker": 26, "form": "choice", "jp": "「『超能力』は？」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「『超能力』は？」"},
{"id": 180, "speaker": 26, "form": "dlg", "jp": "「全部は否定しないよ！」"},
{"id": 181, "speaker": 26, "form": "dlg", "jp": "「でも、信用できないようなのが多いから‥‥」"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "「例えば？」"},
{"id": 183, "speaker": 26, "form": "dlg", "jp": "「人間の基本的な進化って、\n　人間の文明より先にストップされてるだろう？」"},
{"id": 184, "speaker": 26, "form": "dlg", "jp": "「つまり、超能力だろうが、普通の能力だろうが\n　太古の昔からある能力なはずなんだけど‥‥」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "「あっ、それよく言うよね！！」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「超能力は太古は全ての人間にそなわってた\n　ごく普通の能力なんだって‥‥」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「古代人はテレパシーで会話していたって‥‥」"},
{"id": 188, "speaker": 26, "form": "dlg", "jp": "「それって、どれくらい昔のことだと思う？」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「さあ、石器時代とかそれぐらいじゃぁ？」"},
{"id": 190, "speaker": 26, "form": "dlg", "jp": "「でさぁ、石器を使ってる時代の能力が、\n　『スプーン曲げ』ってのはどうなんだろう？」"},
{"id": 191, "speaker": 3, "form": "dlg", "jp": "「まあ、それぐらい不思議な能力ってこと？」"},
{"id": 192, "speaker": 2, "form": "dlg", "jp": "「じゃあ、『宇宙人』を信じるの？」"},
{"id": 193, "speaker": 26, "form": "dlg", "jp": "「全部は否定しないよ！」"},
{"id": 194, "speaker": 26, "form": "dlg", "jp": "「ただ、地球人みたいなのが、\n　円盤みたいなので地球にやってくることはないと思うよ」"},
{"id": 195, "speaker": 2, "form": "dlg", "jp": "「でも、宇宙には無限に星があるんでしょう？」"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「その中に１つぐらい‥‥」"},
{"id": 197, "speaker": 26, "form": "dlg", "jp": "「宇宙にある星の数は無限じゃないよ‥‥」"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "「でも、いっぱいあるんでしょう？」"},
{"id": 199, "speaker": 26, "form": "dlg", "jp": "「あるよ！」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "「じゃあ、１つぐらい地球と同じような星があっても‥‥」"},
{"id": 201, "speaker": 26, "form": "dlg", "jp": "「不思議じゃないよね‥‥」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「じゃあ、同じ様な生き物がいて\n　それが地球に来るってことも？」"},
{"id": 203, "speaker": 26, "form": "dlg", "jp": "「それじゃぁムジュンしちゃうよね？」"},
{"id": 204, "speaker": 26, "form": "dlg", "jp": "「地球の生き物と同じような生き物なら\n　何万年も生き続けられないからね‥‥」"},
{"id": 205, "speaker": 26, "form": "dlg", "jp": "「とにかく、地球人の寿命でいける範囲に\n　そんな星はないんだから‥‥」"},
{"id": 206, "speaker": 26, "form": "dlg", "jp": "「だから、宇宙人がいる可能性は十分あるけど\n　その宇宙人が一代で地球にくるのは無理かと‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「じゃあ、『幽霊』を信じるの？」"},
{"id": 208, "speaker": 26, "form": "dlg", "jp": "「全部は否定しないよ！」"},
{"id": 209, "speaker": 26, "form": "dlg", "jp": "「ボクが信用したくなる情報さえあれば、\n　ボクは信じるね‥‥」"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 211, "speaker": 26, "form": "dlg", "jp": "「今の所、\n　信用できるような話は聞いたことはないんだ」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "「じゃあ、信じてないんだ‥‥」"},
{"id": 213, "speaker": 26, "form": "dlg", "jp": "「そこがなんとも言えないんだよ‥‥」"},
{"id": 214, "speaker": 26, "form": "dlg", "jp": "「頭では信じてないつもりなんだけど\n　心の中では信じてそうなんだ‥‥」"},
{"id": 215, "speaker": 26, "form": "dlg", "jp": "「例えば、\n　暗闇に行くとなんか気味が悪くなるんだよ‥‥」"},
{"id": 216, "speaker": 26, "form": "dlg", "jp": "「まったく\n　信じてないんならそうはならないだろうし‥‥」"},
{"id": 217, "speaker": 3, "form": "dlg", "jp": "「たしかにそうね‥‥」"},
{"id": 218, "speaker": 3, "form": "dlg", "jp": "三田さんは結構このテの話が好きなのか、\nうれしそうに話してくれた。"},
{"id": 219, "speaker": 3, "form": "dlg", "jp": "三田さんになら『能力』の話をしても大丈夫かも‥‥"},
{"id": 220, "speaker": 3, "form": "dlg", "jp": "自分ひとりで抱えるには深刻すぎる問題だし、\nここは相談してみるか‥‥"},
{"id": 221, "speaker": 3, "form": "choice", "jp": "【しかし、『ジーンとの約束』が‥‥】"},
{"id": 222, "speaker": 3, "form": "choice", "jp": "【いや、相談しておいて損はないだろう】"},
{"id": 223, "speaker": 3, "form": "dlg", "jp": "【いや、相談しておいて損はないだろう】"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "「三田さん‥‥」"},
{"id": 225, "speaker": 26, "form": "dlg", "jp": "「どうしたんだい？」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「実はボク‥‥」"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「『超能力者』なんです‥‥」"},
{"id": 228, "speaker": 26, "form": "dlg", "jp": "「それはスゴイ！！」"},
{"id": 229, "speaker": 26, "form": "dlg", "jp": "「で、何ができるの？」"},
{"id": 230, "speaker": 26, "form": "dlg", "jp": "「『スプーン曲げ』？　『トランプ当て』？」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「手品じゃないんです！！」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「本当に超能力者なんです！」"},
{"id": 233, "speaker": 3, "form": "dlg", "jp": "「本当なの？」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「ボク、体を自由に『変質』させることができるんだ」"},
{"id": 236, "speaker": 26, "form": "dlg", "jp": "「何それ？」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「例えば、\n　体を鉄のように硬くすることができるんだ‥‥」"},
{"id": 238, "speaker": 26, "form": "dlg", "jp": "「体の一部ってことじゃないですよね？」"},
{"id": 239, "speaker": 3, "form": "dlg", "jp": "「‥‥」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「いいから見てて‥‥」"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "「ハッ！！」"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "ボクはあの時と同じように自分の体が硬くなるように念じた。"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥\n‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 244, "speaker": 3, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 245, "speaker": 26, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥」"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "しかし、なんの変化も現れなかった。"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "どうして、あの時はたしかに‥‥"},
{"id": 249, "speaker": 26, "form": "dlg", "jp": "「もう、おしまい？」"},
{"id": 250, "speaker": 26, "form": "dlg", "jp": "「まさか、それで柔軟体操がニガテになったとか？」"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "「そんなんじゃありません！！」"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "いったいどういうことだ？"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "あの時と今とでどう違うんだ？"},
{"id": 254, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥"},
{"id": 255, "speaker": 2, "form": "dlg", "jp": "そうかっ！"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "あの時は命がけで念じたんだ‥‥"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "あの『能力』は命がけじゃないと発動しないんだ！"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "（やっぱり、真剣じゃないとダメなんだ‥‥）"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「ちょっとまって！」"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "「姉さん、『ナイフ』持って来て‥‥」"},
{"id": 261, "speaker": 3, "form": "dlg", "jp": "「何をするつもり？」"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "「いいから持って来てよ」"},
{"id": 263, "speaker": 3, "form": "dlg", "jp": "「危ないことしないでよ‥‥」"},
{"id": 264, "speaker": 3, "form": "dlg", "jp": "姉さんは不安な表情で、\nボクに『ナイフ』を手渡した。"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "「三田さん、この『ナイフ』を\n　ボクの顔めがけて投げてみて‥‥」"},
{"id": 266, "speaker": 26, "form": "dlg", "jp": "「そんなことできないよ‥‥」"},
{"id": 267, "speaker": 26, "form": "dlg", "jp": "「大丈夫？　タネとかあるの？」"},
{"id": 268, "speaker": 26, "form": "choice", "jp": "「タネなんかないよ！」"},
{"id": 269, "speaker": 26, "form": "choice", "jp": "「大丈夫、タネはしこんであるから」"},
{"id": 270, "speaker": 2, "form": "dlg", "jp": "「大丈夫、タネはしこんであるから‥‥」"},
{"id": 271, "speaker": 26, "form": "dlg", "jp": "「それなら遠慮なく‥‥」"},
{"id": 272, "speaker": 26, "form": "dlg", "jp": "「行くよ！！」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「いいですよ！」"},
{"id": 274, "speaker": 2, "form": "dlg", "jp": "「シュンッ！」"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "三田さんはボクの顔を狙ってナイフを投げた‥‥"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "「グサッ！」"},
{"id": 277, "speaker": 2, "form": "dlg", "jp": "「ウワッ！！」"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "「タネなんかないよ！」"},
{"id": 279, "speaker": 26, "form": "dlg", "jp": "「あぶないよ‥‥」"},
{"id": 280, "speaker": 3, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 281, "speaker": 3, "form": "dlg", "jp": "「くだらない手品遊びなんかしてないで、\n　宿題でもしなさい！！」"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "食事を終えたボクは、\nそのまま大人しく自分の部屋へ戻ることにした。"},
{"id": 284, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "（‥‥？？）"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "（窓が開いている？）"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "（なぜだ？）"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「シュンッ！」"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "何かが風を切る音が聞こえた。"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "「グサッ！」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「ウワッ！！」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "【しかし、『ジーンとの約束』が‥‥】"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "やっぱり、このことは誰にも話さないでおこう！"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "食事を終えたボクは、\nそのまま大人しく自分の部屋へ戻ることにした。"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "失敗の原因は約束をやぶったこと‥‥\n決して人を裏切ったりしないように！"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "失敗の原因は約束をやぶったこと‥‥\n決して人を裏切ったりしないように！"}
]
