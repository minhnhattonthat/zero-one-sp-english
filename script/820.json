[
{"id": 0, "speaker": null, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "「ただいま‥‥」"},
{"id": 2, "speaker": 3, "form": "dlg", "jp": "「お帰りなさい‥‥」"},
{"id": 3, "speaker": 3, "form": "dlg", "jp": "「さあ、早く準備なさい！」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "２００５／０８／１３／ＡＭ０９：４５"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「『パーティー』だなんて、キンチョウするなぁ‥‥」"},
{"id": 7, "speaker": 3, "form": "dlg", "jp": "「大丈夫？ちゃんとできる？」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「フォークってどっちから使うんだっけ？」"},
{"id": 9, "speaker": 3, "form": "dlg", "jp": "「立食形式だって言ってたから、\n　そんなにキンチョウしなくて大丈夫よ‥‥」"},
{"id": 10, "speaker": 26, "form": "dlg", "jp": "「早かったんだね？」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「三田さん、そのスーツでパーティーに？」"},
{"id": 12, "speaker": 26, "form": "dlg", "jp": "「ハハハハハハ‥‥」"},
{"id": 13, "speaker": 26, "form": "dlg", "jp": "「本当はタキシードを用意してたんだけど、\n　夕べ『野良犬』に襲われてね‥‥」"},
{"id": 14, "speaker": 26, "form": "dlg", "jp": "「ボロボロにしちゃったんだよ‥‥」"},
{"id": 15, "speaker": 3, "form": "dlg", "jp": "「で、大丈夫なんですか？」"},
{"id": 16, "speaker": 26, "form": "dlg", "jp": "「ええまあ‥‥」"},
{"id": 17, "speaker": 3, "form": "dlg", "jp": "「今どき『野良犬』なんて珍しいわね‥‥」"},
{"id": 18, "speaker": 26, "form": "dlg", "jp": "「さあ、行きましょうか？」"},
{"id": 19, "speaker": 26, "form": "dlg", "jp": "こうして、\nボクたちはパーティー会場のホテルへと向かった。"},
{"id": 20, "speaker": 26, "form": "dlg", "jp": "そして‥‥"},
{"id": 21, "speaker": 26, "form": "dlg", "jp": "２００５／０８／１３／ＰＭ０４：３０"},
{"id": 22, "speaker": 26, "form": "dlg", "jp": "「スゴイパーティーだっただろう？」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「でも、あのホテルって言うのが‥‥」"},
{"id": 24, "speaker": 3, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 25, "speaker": 26, "form": "dlg", "jp": "「まあ、オヨバレですから\n　会場のことはケチつけるわけには‥‥」"},
{"id": 26, "speaker": 3, "form": "dlg", "jp": "「それに父さんはそのヒゲのまんま\n　出席するんだもの！」"},
{"id": 27, "speaker": 27, "form": "dlg", "jp": "「いけなかったか？」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「失礼だと思うよ‥‥」"},
{"id": 29, "speaker": 27, "form": "dlg", "jp": "「それなら、三田くんも同じようなもんだろう？」"},
{"id": 30, "speaker": 27, "form": "dlg", "jp": "「その年なんだから、タキシードぐらい‥‥」"},
{"id": 31, "speaker": 26, "form": "dlg", "jp": "「違いますよ！」"},
{"id": 32, "speaker": 26, "form": "dlg", "jp": "「これには理由が‥‥」"},
{"id": 33, "speaker": 27, "form": "dlg", "jp": "「どんな理由なんだ？」"},
{"id": 34, "speaker": 26, "form": "dlg", "jp": "「実は昨晩、『野良犬』に襲われまして‥‥」"},
{"id": 35, "speaker": 27, "form": "dlg", "jp": "「ほう、それは大変だったね‥‥」"},
{"id": 36, "speaker": 27, "form": "dlg", "jp": "「で、ケガは？」"},
{"id": 37, "speaker": 26, "form": "dlg", "jp": "「いえ、\n　ちょうどパトロール中の警官が追っ払ってくれたんで」"},
{"id": 38, "speaker": 26, "form": "dlg", "jp": "「ケガとかはなかったんですけど、\n　せっかくのタキシードがボロボロに‥‥」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「なんで、前日にタキシードなんか？」"},
{"id": 40, "speaker": 26, "form": "dlg", "jp": "「別にタキシードを着てたわけじゃないよ」"},
{"id": 41, "speaker": 26, "form": "dlg", "jp": "「貸衣装を取りに行った帰りだったんだよ」"},
{"id": 42, "speaker": 26, "form": "dlg", "jp": "「このホテルで貸してくれるっていうから」"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「じゃあ、昨日もここに来てたの？」"},
{"id": 44, "speaker": 26, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「その話本当なの？」"},
{"id": 46, "speaker": 26, "form": "dlg", "jp": "「本当ですよ！」"},
{"id": 47, "speaker": 26, "form": "dlg", "jp": "「２丁目に交差点の所あるでしょう？」"},
{"id": 48, "speaker": 27, "form": "dlg", "jp": "「４番地の辺りだな‥‥」"},
{"id": 49, "speaker": 26, "form": "dlg", "jp": "「そこで１１時ぐらいに‥‥」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「１１時に２丁目の４番地って！？」"},
{"id": 51, "speaker": 26, "form": "dlg", "jp": "「うん‥‥？」"},
{"id": 52, "speaker": 26, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「な、なんでもないよっ！」"},
{"id": 54, "speaker": 26, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「そ、そうだ、忘れてた！！」"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "「シンちゃんにＣＤ返さないと！！」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "「ちょ、ちょっと行ってくるね！！」"},
{"id": 58, "speaker": 3, "form": "dlg", "jp": "「いいけど、遅くならないでよ！」"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "「うん！」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "（２丁目の４番地で夕べの１１時っていったら、\n　『邪悪なイメージ』の件と一致するじゃないか！！）"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "（ジーンたちに知らせないと‥‥）"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "ボクはジーンたちのホテルへ急いだ。"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "その日、ボクたち家族は"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "父さんのスポンサーの企業の\n『パーティー』に招待されてホテルを訪れた。"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "２００５／０８／１３／ＡＭ１０：３５"},
{"id": 69, "speaker": 26, "form": "dlg", "jp": "「『矢追さん』、わざわざ『控え室』に\n　『スイートルーム』とってくれたんですよ！」"},
{"id": 70, "speaker": 3, "form": "dlg", "jp": "「そうなんですか‥‥」"},
{"id": 71, "speaker": 26, "form": "dlg", "jp": "「どうかしましたか？」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "「この前ルードに襲われたのが、\n　ここの『スイートルーム』だったんですよ‥‥」"},
{"id": 73, "speaker": 26, "form": "dlg", "jp": "「そ、そうだったんですか！？」"},
{"id": 74, "speaker": 26, "form": "dlg", "jp": "「博士、リツコさんたちが来ました‥‥」"},
{"id": 75, "speaker": 27, "form": "dlg", "jp": "「おお、久しぶりだな‥‥」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「何が久しぶりだよ！」"},
{"id": 77, "speaker": 3, "form": "dlg", "jp": "「ほんと、たまには家に帰って来てよね！」"},
{"id": 78, "speaker": 27, "form": "dlg", "jp": "「早々に説教されるとは‥‥」"},
{"id": 79, "speaker": 27, "form": "dlg", "jp": "「まあ、それだけしっかりしてくれてるから、\n　家を留守にできるんだがな‥‥」"},
{"id": 80, "speaker": 3, "form": "dlg", "jp": "「もうっ！\n　全然反省してないんだから‥‥」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「スゴイパーティーなの？」"},
{"id": 82, "speaker": 26, "form": "dlg", "jp": "「なんたって、天下の『ヤオイグループ』の\n　パーティーですからね‥‥」"},
{"id": 83, "speaker": 26, "form": "dlg", "jp": "『ヤオイグループ』‥‥"},
{"id": 84, "speaker": 26, "form": "dlg", "jp": "日本を代表する大企業グループだ。"},
{"id": 85, "speaker": 3, "form": "dlg", "jp": "「それよりお父さん、\n　まさか、そのカッコウで出席するつもり？」"},
{"id": 86, "speaker": 26, "form": "dlg", "jp": "「そうですよ、早く着替えてくださいよ！！」"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "「間に合うのそんなんで？」"},
{"id": 88, "speaker": 26, "form": "dlg", "jp": "「まあ、パーティーまでには\n　もうしばらく時間がありますけど‥‥」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「なんなら、ブラっとしてこようかな‥‥」"},
{"id": 90, "speaker": 26, "form": "dlg", "jp": "「いいんじゃないかな？」"},
{"id": 91, "speaker": 3, "form": "dlg", "jp": "「ちょっと、迷子にならないでよ！」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「なるわけないだろ！」"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "（前にも来たのに‥‥）"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "ボクはホテルの中を探検してみることにした。"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "しかし、またこのホテルに来るとは‥‥"},
{"id": 96, "speaker": 4, "form": "dlg", "jp": "「ナゴムちゃん！」"},
{"id": 97, "speaker": 4, "form": "dlg", "jp": "この呼び方は！？"},
{"id": 98, "speaker": 15, "form": "dlg", "jp": "「なんでこんな所に？」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「父さんのスポンサーの会社のパーティーに\n　招待されたんだよ」"},
{"id": 100, "speaker": 15, "form": "dlg", "jp": "「オジさんってスゴイわね‥‥」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "「で、なんでアイコはこんなとこに？」"},
{"id": 102, "speaker": 15, "form": "dlg", "jp": "「お母さんが\n　このホテルの優待券もらったのよ‥‥」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「へぇ‥‥」"},
{"id": 104, "speaker": 15, "form": "dlg", "jp": "「ねえ、\n　パーティーってごちそう出るんでしょう？」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「そうだろうね‥‥」"},
{"id": 106, "speaker": 15, "form": "dlg", "jp": "「いいわねぇ～」"},
{"id": 107, "speaker": 15, "form": "choice", "jp": "「そうだろう？」"},
{"id": 108, "speaker": 15, "form": "choice", "jp": "「そうかな？」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「そうだろう？」"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「そうかな？」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "「メンドクサイだけだよ‥‥」"},
{"id": 112, "speaker": 15, "form": "dlg", "jp": "「でも、なんかフシギ‥‥」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「何が‥‥？」"},
{"id": 114, "speaker": 15, "form": "dlg", "jp": "「昨日、\n　ここでナゴムちゃんと会う『夢』を見たんだ！」"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "「ふーん‥‥」"},
{"id": 116, "speaker": 15, "form": "dlg", "jp": "「何よそれだけ？」"},
{"id": 117, "speaker": 15, "form": "dlg", "jp": "本物の超能力者のボクからすれば、\n別にどうってことのない話だ‥‥"},
{"id": 118, "speaker": 15, "form": "dlg", "jp": "「なんか、感じわるーーい！」"},
{"id": 119, "speaker": 15, "form": "dlg", "jp": "「そんなんだから、『撃たれちゃう』のよ！」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「はぁ？」"},
{"id": 121, "speaker": 15, "form": "dlg", "jp": "「『夢の中』でナゴムちゃん、\n　『拳銃で撃たれてた』わよ‥‥」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「ソッチの方が感じわるいよ！」"},
{"id": 123, "speaker": 15, "form": "dlg", "jp": "「ふふふふ‥‥」"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「じゃあボク、『パーティー』に戻るから‥‥」"},
{"id": 125, "speaker": 15, "form": "dlg", "jp": "「あっそう？」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 127, "speaker": 15, "form": "dlg", "jp": "「じゃあね」"},
{"id": 128, "speaker": 4, "form": "dlg", "jp": "「常光寺くん！」"},
{"id": 129, "speaker": 4, "form": "dlg", "jp": "この声は！？"},
{"id": 130, "speaker": 16, "form": "dlg", "jp": "「なんでこんな所に？」"},
{"id": 131, "speaker": 16, "form": "dlg", "jp": "「わかったっ！」"},
{"id": 132, "speaker": 16, "form": "dlg", "jp": "「結婚式ね！」"},
{"id": 133, "speaker": 16, "form": "dlg", "jp": "長尾をいつもビミョーにずれた答えを導き出す。\nまあ、そういうコなんだけど‥‥"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "「ちがうよ！」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「父さんのスポンサーの会社のパーティーに\n　招待されたんだよ！」"},
{"id": 136, "speaker": 16, "form": "dlg", "jp": "「へえ、さすがぁー！」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「で、なんで長尾はこんなとこに？」"},
{"id": 138, "speaker": 16, "form": "dlg", "jp": "「アキラのお父さん、\n　このホテルに勤めてるの‥‥」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「で？」"},
{"id": 140, "speaker": 16, "form": "dlg", "jp": "「だから、ここのプールとか\n　安く利用できるんだ‥‥」"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 142, "speaker": 16, "form": "dlg", "jp": "「ねえ、常光寺くんもプールに行かない？」"},
{"id": 143, "speaker": 16, "form": "choice", "jp": "「いいねぇ！」"},
{"id": 144, "speaker": 16, "form": "choice", "jp": "「ダメだよ！」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「いいねぇ！」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「ってなワケないだろう！」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「ダメだよ！」"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「今から、パーティーなんだって！」"},
{"id": 149, "speaker": 16, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「さっき言っただろう？」"},
{"id": 151, "speaker": 16, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「ホントに人の話を聞かないんだから‥‥」"},
{"id": 153, "speaker": 16, "form": "dlg", "jp": "「まあ、アキラは直感にたよるタイプだから‥‥」"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 155, "speaker": 16, "form": "dlg", "jp": "「ああっアキラのことバカにしてるでしょう？」"},
{"id": 156, "speaker": 16, "form": "choice", "jp": "「ウン、ちょっとだけ‥‥」"},
{"id": 157, "speaker": 16, "form": "choice", "jp": "「してないよぉ！」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「ウン、ちょっとだけ‥‥」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "「してないよぉ！」"},
{"id": 160, "speaker": 16, "form": "dlg", "jp": "「常光寺くんはやさしいわね‥‥」"},
{"id": 161, "speaker": 16, "form": "dlg", "jp": "そんな風に言われると、\n相手が長尾でもちょっとテレるなぁ～"},
{"id": 162, "speaker": 16, "form": "dlg", "jp": "「でも、アキラのカンってけっこう当たるのよ！」"},
{"id": 163, "speaker": 16, "form": "dlg", "jp": "「昨日もここで『常光寺くんと会う夢』\n　見たんだから‥‥」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「へぇー‥‥」"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "「で、どんな夢だったの？」"},
{"id": 166, "speaker": 16, "form": "dlg", "jp": "「よく覚えてないけど‥‥」"},
{"id": 167, "speaker": 16, "form": "dlg", "jp": "「常光寺くんが『銃でうたれてた』わ‥‥」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「いやな夢見るんだなぁ～～」"},
{"id": 169, "speaker": 16, "form": "dlg", "jp": "「アキラのせいじゃないわよ！」"},
{"id": 170, "speaker": 16, "form": "dlg", "jp": "「『夢』なんだから‥‥」"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「とにかく、ボクはもう戻るよ‥‥」"},
{"id": 173, "speaker": 16, "form": "dlg", "jp": "「うん、じゃあね‥‥」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 177, "speaker": 26, "form": "dlg", "jp": "「あっ、帰って来た‥‥」"},
{"id": 178, "speaker": 3, "form": "dlg", "jp": "「さあ、もう始まるみたいよ‥‥」"},
{"id": 179, "speaker": 3, "form": "dlg", "jp": "ボクたちは『パーティー会場』へ向かった。"},
{"id": 180, "speaker": 3, "form": "dlg", "jp": "２００５／０８／１３／ＡＭ１０：５５"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「へぇ～～～～っ」"},
{"id": 182, "speaker": 3, "form": "dlg", "jp": "「さすがね‥‥」"},
{"id": 183, "speaker": 26, "form": "dlg", "jp": "「なんたって天下の『ヤオイグループ』ですから‥‥」"},
{"id": 184, "speaker": 4, "form": "dlg", "jp": "「コンチニワ‥‥」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "「‥‥‥？」"},
{"id": 186, "speaker": 4, "form": "dlg", "jp": "「キミがナゴムくんだね？」"},
{"id": 187, "speaker": 26, "form": "dlg", "jp": "「矢追会長っ！！」"},
{"id": 188, "speaker": 3, "form": "dlg", "jp": "「この度はお招きいただき、ありがとうございます‥‥」"},
{"id": 189, "speaker": 3, "form": "dlg", "jp": "「ナゴム！」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "「あ、ありがとうございます‥‥」"},
{"id": 191, "speaker": 55, "form": "dlg", "jp": "「いえいえ、\n　お父さまにはいろいろお世話になっていますから」"},
{"id": 192, "speaker": 55, "form": "dlg", "jp": "普段気にしたことなかったけど、\nやっぱり父さんってスゴイ人なんだ‥‥"},
{"id": 193, "speaker": 55, "form": "dlg", "jp": "「今日はぞんぶんに楽しんでいってくださいね」"},
{"id": 194, "speaker": 3, "form": "dlg", "jp": "「ありがとうございます‥‥」"},
{"id": 195, "speaker": 3, "form": "dlg", "jp": "そして‥‥"},
{"id": 196, "speaker": 3, "form": "dlg", "jp": "パーティーが始まった。"},
{"id": 197, "speaker": 3, "form": "dlg", "jp": "まあ、正直いって全然楽しくない。"},
{"id": 198, "speaker": 3, "form": "dlg", "jp": "いわゆる大人の社交の場であって、\nボクと同じ年頃の人間は１人もいない。"},
{"id": 199, "speaker": 3, "form": "dlg", "jp": "みんな、あいさつの合間合間に\nつくり笑顔で頭を下げあってるだけだ。"},
{"id": 200, "speaker": 3, "form": "dlg", "jp": "料理だって、たしかにごちそうなんだろうけど、\nなんだか小細工したものばかりで、"},
{"id": 201, "speaker": 3, "form": "dlg", "jp": "お腹にガツーンとくるものがぜんぜんないし、\n飲み物もアルコール以外は、"},
{"id": 202, "speaker": 3, "form": "dlg", "jp": "お茶か、オレンジジュースしかない。"},
{"id": 203, "speaker": 26, "form": "dlg", "jp": "「はははははは‥‥」"},
{"id": 204, "speaker": 26, "form": "dlg", "jp": "「タイクツしてるね‥‥」"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "「大人ってこんなのが面白いの？」"},
{"id": 206, "speaker": 26, "form": "dlg", "jp": "「ははははははは‥‥」"},
{"id": 207, "speaker": 26, "form": "dlg", "jp": "「これ自体が楽しいんじゃなくて、\n　こうした根まわしの結果が楽しいんだよ」"},
{"id": 208, "speaker": 2, "form": "dlg", "jp": "「結果？」"},
{"id": 209, "speaker": 26, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 210, "speaker": 26, "form": "dlg", "jp": "「みんな、笑いながらペコペコしてるだろう？」"},
{"id": 211, "speaker": 26, "form": "dlg", "jp": "「で‥‥」"},
{"id": 212, "speaker": 26, "form": "dlg", "jp": "「明日からは『先日はどうも‥‥』とか言って、\n　情にうったえて交渉をするんだよ！」"},
{"id": 213, "speaker": 26, "form": "dlg", "jp": "「世の中を動かすのは\n　『お金』と『情』だからね‥‥」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "「なんか、ムズかしい話だね‥‥」"},
{"id": 215, "speaker": 26, "form": "dlg", "jp": "「ははははははは‥‥」"},
{"id": 216, "speaker": 26, "form": "dlg", "jp": "「まあ、ボクもそういうの苦手だし\n　お酒も飲まないからタイクツだけどね‥‥」"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "「こんなことなら、\n　家でテレビでも見てた方がよかったよ！」"},
{"id": 218, "speaker": 26, "form": "dlg", "jp": "「抜け出して、部屋でテレビでも見てたら？」"},
{"id": 219, "speaker": 26, "form": "dlg", "jp": "「カギならボクも持ってるし‥‥」"},
{"id": 220, "speaker": 26, "form": "dlg", "jp": "「終わりそうになったら、\n　呼びに行ってあげるよ！」"},
{"id": 221, "speaker": 26, "form": "choice", "jp": "「じゃあ、そうさせてもらうよ！」"},
{"id": 222, "speaker": 26, "form": "choice", "jp": "「ダメだよ、姉さんにしかられるよ！」"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "「じゃあ、そうさせてもらうよ！」"},
{"id": 224, "speaker": 26, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 225, "speaker": 26, "form": "dlg", "jp": "三田さんから部屋のカギをあずかったボクは\nさっきの部屋へと向かった。"},
{"id": 226, "speaker": 26, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 227, "speaker": 26, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 228, "speaker": 26, "form": "dlg", "jp": "「バタン！」"},
{"id": 229, "speaker": 44, "form": "dlg", "jp": "「そろそろ犯行声明の第一の爆破予告の時間です‥‥」"},
{"id": 230, "speaker": 44, "form": "dlg", "jp": "うん？"},
{"id": 231, "speaker": 44, "form": "dlg", "jp": "なんだ、テレビがつきっぱなしじゃないか？"},
{"id": 232, "speaker": 44, "form": "dlg", "jp": "緊急ニュースみたいだな。"},
{"id": 233, "speaker": 44, "form": "dlg", "jp": "その時！！"},
{"id": 234, "speaker": 44, "form": "dlg", "jp": "「ドーーーーーーン！」"},
{"id": 235, "speaker": 44, "form": "dlg", "jp": "大きな爆音と共に、ホテル全体が大きくゆれた。"},
{"id": 236, "speaker": 44, "form": "dlg", "jp": "な、なんだぁ？"},
{"id": 237, "speaker": 44, "form": "dlg", "jp": "「今、１つ目の爆発がありました！」"},
{"id": 238, "speaker": 44, "form": "dlg", "jp": "「予告通りです！！」"},
{"id": 239, "speaker": 44, "form": "dlg", "jp": "何っ？"},
{"id": 240, "speaker": 44, "form": "dlg", "jp": "ボクはあわててテレビに注目した。"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "「ダメだよ、姉さんにしかられるよ！」"},
{"id": 242, "speaker": 26, "form": "dlg", "jp": "「大丈夫だよ、リツコさんには\n　ボクがうまく言っておくから‥‥」"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「いいよ、ガマンするよ‥‥」"},
{"id": 244, "speaker": 2, "form": "dlg", "jp": "ボクはもう少しガマンしてここに残ることにした。"},
{"id": 245, "speaker": 3, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「なんでもないよ‥‥」"},
{"id": 247, "speaker": 3, "form": "dlg", "jp": "「それよりナゴム、携帯電話持ってない？」"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "「ダメだよ、姉さん‥‥」"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "「こんな場所で電話なんかしちゃ！」"},
{"id": 251, "speaker": 3, "form": "dlg", "jp": "「違うわよ！」"},
{"id": 252, "speaker": 3, "form": "dlg", "jp": "「大学から『メール』が入るはずなんだけど、\n　私の携帯、『圏外』なのよ‥‥」"},
{"id": 253, "speaker": 3, "form": "dlg", "jp": "「もしかしたら、\n　こわれたんじゃないかと思って‥‥」"},
{"id": 254, "speaker": 26, "form": "dlg", "jp": "「アレ？」"},
{"id": 255, "speaker": 26, "form": "dlg", "jp": "「ボクのも圏外だ！？」"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "「そういう場所じゃないの？」"},
{"id": 257, "speaker": 26, "form": "dlg", "jp": "「そんなはずないよ、さっきは３本立ってたから‥‥」"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "「そうなの？」"},
{"id": 259, "speaker": 3, "form": "dlg", "jp": "「で、ナゴムのはどうなの？」"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "「さっきの部屋において来たよ‥‥」"},
{"id": 261, "speaker": 26, "form": "dlg", "jp": "「部屋のカギかしてあげようか？」"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "「ありがとう、\n　じゃあ、ちょっとボクの携帯も見てくるよ‥‥」"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "ボクはさっきの部屋に携帯電話を取りに戻った。"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 266, "speaker": 44, "form": "dlg", "jp": "「そろそろ犯行声明の第一の爆破予告の時間です‥‥」"},
{"id": 267, "speaker": 44, "form": "dlg", "jp": "うん？"},
{"id": 268, "speaker": 44, "form": "dlg", "jp": "なんだ、テレビがつきっぱなしじゃないか？"},
{"id": 269, "speaker": 44, "form": "dlg", "jp": "まあ、いいや‥‥"},
{"id": 270, "speaker": 44, "form": "dlg", "jp": "そんなことより、携帯は‥‥"},
{"id": 271, "speaker": 44, "form": "dlg", "jp": "たしか、ここにおいたハズだけど‥‥"},
{"id": 272, "speaker": 44, "form": "dlg", "jp": "あったあった‥‥"},
{"id": 273, "speaker": 44, "form": "dlg", "jp": "その時！！"},
{"id": 274, "speaker": 44, "form": "dlg", "jp": "「ドーーーーーーン！」"},
{"id": 275, "speaker": 44, "form": "dlg", "jp": "大きな爆音と共に、ホテル全体が大きくゆれた。"},
{"id": 276, "speaker": 44, "form": "dlg", "jp": "な、なんだぁ？"},
{"id": 277, "speaker": 44, "form": "dlg", "jp": "「今、１つ目の爆発がありました！」"},
{"id": 278, "speaker": 44, "form": "dlg", "jp": "「予告通りです！！」"},
{"id": 279, "speaker": 44, "form": "dlg", "jp": "何っ？"},
{"id": 280, "speaker": 44, "form": "dlg", "jp": "ボクはあわててテレビに注目した。"},
{"id": 281, "speaker": 44, "form": "dlg", "jp": "「『ヤオイロイヤルホテル』から、\n　もうもうと煙が立ち上がっています‥‥」"},
{"id": 282, "speaker": 44, "form": "dlg", "jp": "『ヤオイロイヤルホテル』って\nこのホテルじゃないか！？"},
{"id": 283, "speaker": 44, "form": "dlg", "jp": "「爆発は丁度２９階のフロアからです‥‥」"},
{"id": 284, "speaker": 44, "form": "dlg", "jp": "「中にいる宿泊客たちは大丈夫なのでしょうか？」"},
{"id": 285, "speaker": 44, "form": "dlg", "jp": "いったいどういうことだ？"},
{"id": 286, "speaker": 44, "form": "dlg", "jp": "「警察の発表によりますと‥‥」"},
{"id": 287, "speaker": 44, "form": "dlg", "jp": "「いまだ建物の中とは\n　連絡がとれない状況が続いているそうです‥‥」"},
{"id": 288, "speaker": 44, "form": "dlg", "jp": "はぁ？"},
{"id": 289, "speaker": 44, "form": "dlg", "jp": "ボクはあわてて携帯電話を確認した。"},
{"id": 290, "speaker": 44, "form": "dlg", "jp": "しかし、携帯電話は『圏外』になっている。"},
{"id": 291, "speaker": 44, "form": "dlg", "jp": "まさかっ！"},
{"id": 292, "speaker": 44, "form": "dlg", "jp": "念の為、そなえつけの電話も確認してみた。"},
{"id": 293, "speaker": 44, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 294, "speaker": 44, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 295, "speaker": 44, "form": "dlg", "jp": "やはり、不通状態だ‥‥"},
{"id": 296, "speaker": 44, "form": "dlg", "jp": "いったい、何が起きたんだ？"},
{"id": 297, "speaker": 44, "form": "dlg", "jp": "なんだかわからないけど、\n大変なことが起きたのは間違いない。"},
{"id": 298, "speaker": 44, "form": "dlg", "jp": "姉さんたちは大丈夫なんだろうか？"},
{"id": 299, "speaker": 44, "form": "dlg", "jp": "そう言えば、さっきテレビで気になることを言ってたな‥‥"},
{"id": 300, "speaker": 44, "form": "choice", "jp": "【たしか、２９階のフロアが爆発したって‥‥】"},
{"id": 301, "speaker": 44, "form": "choice", "jp": "【犯行声明の予告どおりだって‥‥】"},
{"id": 302, "speaker": 44, "form": "choice", "jp": "【警察の発表って‥‥】"},
{"id": 303, "speaker": 44, "form": "dlg", "jp": "【警察の発表って‥‥】"},
{"id": 304, "speaker": 44, "form": "dlg", "jp": "ってことは、警察沙汰の事件がここで起きている？"},
{"id": 305, "speaker": 44, "form": "dlg", "jp": "つまり、事故じゃない！"},
{"id": 306, "speaker": 44, "form": "dlg", "jp": "【犯行声明の予告どおりだって‥‥】"},
{"id": 307, "speaker": 44, "form": "dlg", "jp": "ってことは、誰かが爆弾をしかけたってこと？"},
{"id": 308, "speaker": 44, "form": "dlg", "jp": "つまり、事故じゃない！"},
{"id": 309, "speaker": 44, "form": "dlg", "jp": "【たしか、２９階のフロアが爆発したって‥‥】"},
{"id": 310, "speaker": 44, "form": "dlg", "jp": "２９階っていったら、この真下じゃないか！"},
{"id": 311, "speaker": 44, "form": "dlg", "jp": "窓から煙が見えないってことは反対側だな‥‥"},
{"id": 312, "speaker": 44, "form": "choice", "jp": "【とにかく、パーティー会場に戻ってみよう】"},
{"id": 313, "speaker": 44, "form": "choice", "jp": "【いや、もう少し情報を手に入れよう】"},
{"id": 314, "speaker": 44, "form": "dlg", "jp": "【とにかく、パーティー会場に戻ってみよう】"},
{"id": 315, "speaker": 44, "form": "dlg", "jp": "ボクはパーティー会場に戻ることにした。"},
{"id": 316, "speaker": 44, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 317, "speaker": 4, "form": "dlg", "jp": "「なんだオマエ！？」"},
{"id": 318, "speaker": 2, "form": "dlg", "jp": "「何っ！？」"},
{"id": 319, "speaker": 4, "form": "dlg", "jp": "「オイ、ココに１人隠れてたぞ！」"},
{"id": 320, "speaker": 4, "form": "dlg", "jp": "何なんだコイツ？"},
{"id": 321, "speaker": 4, "form": "dlg", "jp": "まさか、ルードの‥‥"},
{"id": 322, "speaker": 4, "form": "dlg", "jp": "「オレたちから逃げられると思ったのか！」"},
{"id": 323, "speaker": 4, "form": "dlg", "jp": "「死ねぇい！」"},
{"id": 324, "speaker": 4, "form": "dlg", "jp": "「バキューン！」"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "「うわぁ～～っ！」"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "【いや、もう少し情報を手に入れよう】"},
{"id": 327, "speaker": 2, "form": "dlg", "jp": "何やら事件みたいだし、ウカツに行動するのはキケンだ。"},
{"id": 328, "speaker": 2, "form": "dlg", "jp": "ボクはもう少しテレビから情報を手に入れることにした。"},
{"id": 329, "speaker": 44, "form": "dlg", "jp": "「では、一旦スタジオにお返しします‥‥」"},
{"id": 330, "speaker": 0, "form": "dlg", "jp": "「宿泊客などの安否が気になるところですが‥‥」"},
{"id": 331, "speaker": 1, "form": "dlg", "jp": "「では、今回の事件をおさらいします」"},
{"id": 332, "speaker": 1, "form": "dlg", "jp": "「今回、警察に犯行声明を出したのは、\n　『ルード』という『武器密売組織』で‥‥」"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "（『ルード』だって！？）"},
{"id": 334, "speaker": 2, "form": "dlg", "jp": "（たしか、『ルード』は壊滅したハズじゃぁ‥‥）"},
{"id": 335, "speaker": 1, "form": "dlg", "jp": "「『ルード』は今月に入ってから\n　大掛かりな取り締まりにより」"},
{"id": 336, "speaker": 1, "form": "dlg", "jp": "「幹部のほとんどが逮捕され、\n　すでに活動停止状態と思われていたのですが‥‥」"},
{"id": 337, "speaker": 1, "form": "dlg", "jp": "ニュースの説明によると、"},
{"id": 338, "speaker": 1, "form": "dlg", "jp": "『ルードの残党』が、『ヤオイグループのパーティー』に\n集まっている世界中の有名人を人質に、"},
{"id": 339, "speaker": 1, "form": "dlg", "jp": "すでに捕まっている\n幹部の釈放（シャクホウ）を要求しているらしい。"},
{"id": 340, "speaker": 1, "form": "dlg", "jp": "ちなみに、すでにエレベータは停止状態。"},
{"id": 341, "speaker": 1, "form": "dlg", "jp": "階段には武器を持った工作員が配備され、"},
{"id": 342, "speaker": 1, "form": "dlg", "jp": "この３０階のみが隔離（カクリ）された\n状態だという‥‥"},
{"id": 343, "speaker": 1, "form": "dlg", "jp": "つまり、現在『パーティー会場』にいる姉さんたちは\n人質になってしまったということだ‥‥"},
{"id": 344, "speaker": 1, "form": "dlg", "jp": "なんてことだ！！"},
{"id": 345, "speaker": 1, "form": "dlg", "jp": "「犯人たちはホテルにさらに大型の爆弾を\n　あと２つしかけているらしく」"},
{"id": 346, "speaker": 1, "form": "dlg", "jp": "「２４時間以内に幹部が釈放されなかった場合は\n　それらを爆破させると言ってるもようです‥‥」"},
{"id": 347, "speaker": 1, "form": "dlg", "jp": "何だって！！"},
{"id": 348, "speaker": 1, "form": "dlg", "jp": "とんでもないコトに巻き込まれちゃったな‥‥"},
{"id": 349, "speaker": 1, "form": "dlg", "jp": "いったい、どうすればいいんだ？"},
{"id": 350, "speaker": 1, "form": "choice", "jp": "【とにかく、姉さんたちを助けださないと‥‥】"},
{"id": 351, "speaker": 1, "form": "choice", "jp": "【とにかく、外と連絡を‥‥】"},
{"id": 352, "speaker": 1, "form": "choice", "jp": "【とにかく、爆弾を見つけだそう！】"},
{"id": 353, "speaker": 1, "form": "dlg", "jp": "【とにかく、外と連絡を‥‥】"},
{"id": 354, "speaker": 1, "form": "dlg", "jp": "ここにいても状況がまったくわからない！"},
{"id": 355, "speaker": 1, "form": "dlg", "jp": "でも、どうやって外と連絡を取る方法は？"},
{"id": 356, "speaker": 1, "form": "dlg", "jp": "携帯も備え付けの電話をつながらない状態で‥‥"},
{"id": 357, "speaker": 1, "form": "choice", "jp": "【窓から大声を出せば！！】"},
{"id": 358, "speaker": 1, "form": "choice", "jp": "【窓から紙飛行機を飛ばせば！！】"},
{"id": 359, "speaker": 1, "form": "choice", "jp": "【テレパシーを使えば！！】"},
{"id": 360, "speaker": 1, "form": "dlg", "jp": "【テレパシーを使えば！！】"},
{"id": 361, "speaker": 1, "form": "dlg", "jp": "テレパシーなら、電波状況に関係なく\n連絡がとれるハズ！！"},
{"id": 362, "speaker": 1, "form": "dlg", "jp": "【窓から紙飛行機を飛ばせば！！】"},
{"id": 363, "speaker": 1, "form": "dlg", "jp": "さっきのニュースの中継を見る限り、\nホテルの外には大勢の警察がいる。"},
{"id": 364, "speaker": 1, "form": "dlg", "jp": "きっと、誰かが気付いてくれるハズ！"},
{"id": 365, "speaker": 1, "form": "dlg", "jp": "‥‥‥‥‥って、"},
{"id": 366, "speaker": 1, "form": "dlg", "jp": "こっちのメッセージは伝わっても、\n向こうからのメッセージは受け取れない！"},
{"id": 367, "speaker": 1, "form": "dlg", "jp": "どうすればいいんだ‥‥"},
{"id": 368, "speaker": 1, "form": "dlg", "jp": "【窓から大声を出せば！！】"},
{"id": 369, "speaker": 1, "form": "dlg", "jp": "さっきのニュースの中継を見る限り、\nホテルの外には大勢の警察がいる。"},
{"id": 370, "speaker": 1, "form": "dlg", "jp": "きっと、誰かが気付いてくれるハズ！"},
{"id": 371, "speaker": 1, "form": "dlg", "jp": "‥‥‥‥‥って、"},
{"id": 372, "speaker": 1, "form": "dlg", "jp": "そんなことしたら、中にいる工作員の方にも\n聞こえてしまうよな‥‥"},
{"id": 373, "speaker": 1, "form": "dlg", "jp": "どうすればいいんだ‥‥"},
{"id": 374, "speaker": 1, "form": "dlg", "jp": "【とにかく、姉さんたちを助けださないと‥‥】"},
{"id": 375, "speaker": 1, "form": "dlg", "jp": "ボクは姉さんたちを助け出す方法を考えた。"},
{"id": 376, "speaker": 1, "form": "choice", "jp": "【まず、爆弾を見つけて解除しないと‥‥】"},
{"id": 377, "speaker": 1, "form": "choice", "jp": "【ボクの『能力』をつかえばなんとか‥‥】"},
{"id": 378, "speaker": 1, "form": "choice", "jp": "【とにかく、外と連絡を‥‥】"},
{"id": 379, "speaker": 1, "form": "dlg", "jp": "【ボクの『能力』をつかえばなんとか‥‥】"},
{"id": 380, "speaker": 1, "form": "dlg", "jp": "こんな時に役にたつ能力は‥‥"},
{"id": 381, "speaker": 1, "form": "choice", "jp": "【変身できる能力だ‥‥】"},
{"id": 382, "speaker": 1, "form": "choice", "jp": "【テレパシーの能力だ‥‥】"},
{"id": 383, "speaker": 1, "form": "dlg", "jp": "【テレパシーの能力だ‥‥】"},
{"id": 384, "speaker": 1, "form": "dlg", "jp": "テレパシーなら、電話が使えなくても\n外部と連絡が取れるハズだ。"},
{"id": 385, "speaker": 1, "form": "dlg", "jp": "【変身できる能力だ‥‥】"},
{"id": 386, "speaker": 1, "form": "dlg", "jp": "あの能力がある限り、テロの１人や２人ぐらい‥‥"},
{"id": 387, "speaker": 1, "form": "dlg", "jp": "ボクは姉さんたちを助ける為に\n『パーティー会場』に戻ることにした。"},
{"id": 388, "speaker": 1, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 389, "speaker": 1, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 390, "speaker": 4, "form": "dlg", "jp": "「オイ、どこへ行くつもりだ！？」"},
{"id": 391, "speaker": 4, "form": "dlg", "jp": "パーティー会場に戻ろうとするボクの前に\n銃をかまえた男が立ちふさがった。"},
{"id": 392, "speaker": 4, "form": "dlg", "jp": "コイツ！？"},
{"id": 393, "speaker": 4, "form": "dlg", "jp": "テロの一員だな‥‥"},
{"id": 394, "speaker": 2, "form": "dlg", "jp": "「これでも食らえっ！！」"},
{"id": 395, "speaker": 2, "form": "dlg", "jp": "「ブン！」"},
{"id": 396, "speaker": 2, "form": "dlg", "jp": "「バシッ！」"},
{"id": 397, "speaker": 2, "form": "dlg", "jp": "ボクは『能力』で硬くした拳で男を殴りつけた。"},
{"id": 398, "speaker": 2, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 399, "speaker": 2, "form": "dlg", "jp": "男は力なく、その場にくずれた。"},
{"id": 400, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥"},
{"id": 401, "speaker": 2, "form": "dlg", "jp": "なんだ‥‥"},
{"id": 402, "speaker": 2, "form": "dlg", "jp": "思ったより、あっけない‥‥"},
{"id": 403, "speaker": 2, "form": "dlg", "jp": "ボクは男の持っていた拳銃をうばい、\n『パーティー会場』へと向かった。"},
{"id": 404, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 405, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 406, "speaker": 2, "form": "dlg", "jp": "パーティー会場の入り口についたボクは\n深呼吸してから"},
{"id": 407, "speaker": 2, "form": "dlg", "jp": "いきおいをつけてドアを開いた。"},
{"id": 408, "speaker": 2, "form": "dlg", "jp": "「バーン！！」"},
{"id": 409, "speaker": 2, "form": "dlg", "jp": "その瞬間！！"},
{"id": 410, "speaker": 2, "form": "dlg", "jp": "「ドカーーーン！」"},
{"id": 411, "speaker": 2, "form": "dlg", "jp": "目の前が光につつまれた。"},
{"id": 412, "speaker": 2, "form": "dlg", "jp": "ボクは何が起きたのか\n全く理解できないまま意識を失った。"},
{"id": 413, "speaker": 2, "form": "dlg", "jp": "【まず、爆弾を見つけて解除しないと‥‥】"},
{"id": 414, "speaker": 2, "form": "dlg", "jp": "で、どうやって探す！？"},
{"id": 415, "speaker": 2, "form": "choice", "jp": "【たぶん、パーティー会場にしかけてるハズ‥‥】"},
{"id": 416, "speaker": 2, "form": "choice", "jp": "【ジーンに相談してみようか？】"},
{"id": 417, "speaker": 2, "form": "dlg", "jp": "【たぶん、パーティー会場にしかけてるハズ‥‥】"},
{"id": 418, "speaker": 2, "form": "dlg", "jp": "【ジーンに相談してみようか？】"},
{"id": 419, "speaker": 2, "form": "dlg", "jp": "確か彼女は\n『人間レーダー』の能力があるって言ってたし‥‥"},
{"id": 420, "speaker": 2, "form": "dlg", "jp": "テレパシーなら、電話が使えなくても\n外部と連絡が取れるハズだ。"},
{"id": 421, "speaker": 2, "form": "dlg", "jp": "ボクは『テレパシー』で\n『ジーン』を呼び出すことにした。"},
{"id": 422, "speaker": 2, "form": "dlg", "jp": "（ジーン！\n　気付いてくれ！）"},
{"id": 423, "speaker": 2, "form": "dlg", "jp": "（ジーン！）"},
{"id": 424, "speaker": 29, "form": "dlg", "jp": "（うるさいわねぇ！）"},
{"id": 425, "speaker": 2, "form": "dlg", "jp": "（通じた！！）"},
{"id": 426, "speaker": 29, "form": "dlg", "jp": "（自分から念じておいて\n　通じたも何もないでしょう！）"},
{"id": 427, "speaker": 2, "form": "dlg", "jp": "（ジーン、大変なことになったんだ！）"},
{"id": 428, "speaker": 29, "form": "dlg", "jp": "（何よ、大変なことって‥‥）"},
{"id": 429, "speaker": 2, "form": "dlg", "jp": "（実はテロに襲われて、\n　いまホテルに閉じ込められてるんだ！）"},
{"id": 430, "speaker": 29, "form": "dlg", "jp": "（まさか、今テレビで騒いでる\n　『ヤオイグランドホテル』じゃあ？）"},
{"id": 431, "speaker": 2, "form": "dlg", "jp": "（そうなんだ、そのまさかなんだよ！）"},
{"id": 432, "speaker": 29, "form": "dlg", "jp": "（なんで、そんな所にいるのよ！！）"},
{"id": 433, "speaker": 2, "form": "dlg", "jp": "（父さんが『ヤオイグループ』に\n　世話になってるんだよ！）"},
{"id": 434, "speaker": 29, "form": "dlg", "jp": "（もう、ナゴムには大きな使命があるのよ、\n　もっと注意して行動してよ！！）"},
{"id": 435, "speaker": 2, "form": "dlg", "jp": "（そんなこと言っても巻き込まれちゃったものは\n　仕方ないじゃないか‥‥）"},
{"id": 436, "speaker": 29, "form": "dlg", "jp": "（本当にもう！）"},
{"id": 437, "speaker": 2, "form": "dlg", "jp": "（ねえ、どうすればいい？）"},
{"id": 438, "speaker": 29, "form": "dlg", "jp": "（とにかく、状況を教えて‥‥）"},
{"id": 439, "speaker": 2, "form": "dlg", "jp": "（いや、コッチも状況がわかんないんだよ‥‥）"},
{"id": 440, "speaker": 2, "form": "dlg", "jp": "（とにかく、『コッチに来て』よ！）"},
{"id": 441, "speaker": 29, "form": "dlg", "jp": "（行けるわけないでしょう！）"},
{"id": 442, "speaker": 29, "form": "dlg", "jp": "（テレポーターじゃあるまいし！！）"},
{"id": 443, "speaker": 4, "form": "dlg", "jp": "（行きたいのはヤマヤマなんだけど‥‥）"},
{"id": 444, "speaker": 29, "form": "dlg", "jp": "（ちょっと誰よ！\n　勝手に会話にわりこまないで！！）"},
{"id": 445, "speaker": 2, "form": "dlg", "jp": "（‥‥って、今の『テレパシー』じゃぁ？）"},
{"id": 446, "speaker": 29, "form": "dlg", "jp": "（ホント！！）"},
{"id": 447, "speaker": 29, "form": "dlg", "jp": "（いったい、アナタは誰なの？）"},
{"id": 448, "speaker": 4, "form": "dlg", "jp": "（ワタシよ、ナゴムちゃん！）"},
{"id": 449, "speaker": 4, "form": "dlg", "jp": "‥‥‥‥‥‥！！"},
{"id": 450, "speaker": 4, "form": "dlg", "jp": "‥‥この呼び方！！"},
{"id": 451, "speaker": 2, "form": "dlg", "jp": "（アイコか？）"},
{"id": 452, "speaker": 15, "form": "dlg", "jp": "（そうよ！）"},
{"id": 453, "speaker": 29, "form": "dlg", "jp": "（ナゴム、知り合いなの？）"},
{"id": 454, "speaker": 2, "form": "dlg", "jp": "（ああ、幼なじみだよ‥‥）"},
{"id": 455, "speaker": 4, "form": "dlg", "jp": "（何言ってるの、アキラはアキラよ！）"},
{"id": 456, "speaker": 4, "form": "dlg", "jp": "‥‥‥‥‥‥！！"},
{"id": 457, "speaker": 2, "form": "dlg", "jp": "（って、長尾アキラか？）"},
{"id": 458, "speaker": 16, "form": "dlg", "jp": "（そうよ！）"},
{"id": 459, "speaker": 29, "form": "dlg", "jp": "（ナゴム、知り合いなの？）"},
{"id": 460, "speaker": 2, "form": "dlg", "jp": "（ああ、同級生だよ‥‥）"},
{"id": 461, "speaker": 29, "form": "dlg", "jp": "（ってことは、\n　２人目の仲間が見つかったってこと？）"},
{"id": 462, "speaker": 2, "form": "dlg", "jp": "（そうみたいだね‥‥）"},
{"id": 463, "speaker": 29, "form": "dlg", "jp": "（で、アナタはどこにいるの？）"},
{"id": 464, "speaker": 15, "form": "dlg", "jp": "（『エレベーター』の中‥‥）"},
{"id": 465, "speaker": 29, "form": "dlg", "jp": "（なんで、そんな所に？）"},
{"id": 466, "speaker": 15, "form": "dlg", "jp": "（下で大きな音がしたとたん止まっちゃったの‥‥）"},
{"id": 467, "speaker": 2, "form": "dlg", "jp": "（下でってことは！？）"},
{"id": 468, "speaker": 2, "form": "dlg", "jp": "（もしかしたら、３０階にいるのかい？）"},
{"id": 469, "speaker": 15, "form": "dlg", "jp": "（たぶん‥‥）"},
{"id": 470, "speaker": 15, "form": "dlg", "jp": "（でも、ドアが開かないの‥‥）"},
{"id": 471, "speaker": 16, "form": "dlg", "jp": "（『エレベーター』の中よ‥‥）"},
{"id": 472, "speaker": 29, "form": "dlg", "jp": "（なんで、そんな所に？）"},
{"id": 473, "speaker": 16, "form": "dlg", "jp": "（下で大きな音がしたとたん止まっちゃったの‥‥）"},
{"id": 474, "speaker": 2, "form": "dlg", "jp": "（下でってことは！？）"},
{"id": 475, "speaker": 2, "form": "dlg", "jp": "（もしかしたら、３０階にいるのかい？）"},
{"id": 476, "speaker": 16, "form": "dlg", "jp": "（たぶん‥‥）"},
{"id": 477, "speaker": 16, "form": "dlg", "jp": "（でも、ドアが開かないのよ‥‥）"},
{"id": 478, "speaker": 2, "form": "dlg", "jp": "（３０階ってこの階だよ‥‥）"},
{"id": 479, "speaker": 29, "form": "dlg", "jp": "（で、アナタの『能力』は何なの？）"},
{"id": 480, "speaker": 15, "form": "dlg", "jp": "（何よ、『能力』って？）"},
{"id": 481, "speaker": 2, "form": "dlg", "jp": "（アイコも『超能力者』なんだろう？）"},
{"id": 482, "speaker": 15, "form": "dlg", "jp": "（何言ってるの、ナゴムちゃん？）"},
{"id": 483, "speaker": 2, "form": "dlg", "jp": "（だって、『テレパシー』が使えてるじゃないか‥‥）"},
{"id": 484, "speaker": 15, "form": "dlg", "jp": "（えっ！）"},
{"id": 485, "speaker": 15, "form": "dlg", "jp": "（これって、やっぱり『テレパシー』なの？）"},
{"id": 486, "speaker": 16, "form": "dlg", "jp": "（何よ、『能力』って？）"},
{"id": 487, "speaker": 2, "form": "dlg", "jp": "（キミも『超能力者』なんだろう？）"},
{"id": 488, "speaker": 16, "form": "dlg", "jp": "（わけがわかんないわ？）"},
{"id": 489, "speaker": 2, "form": "dlg", "jp": "（だって、『テレパシー』が使えてるじゃないか‥‥）"},
{"id": 490, "speaker": 16, "form": "dlg", "jp": "（えっ！）"},
{"id": 491, "speaker": 16, "form": "dlg", "jp": "（これって、やっぱり『テレパシー』なの？）"},
{"id": 492, "speaker": 29, "form": "dlg", "jp": "（どうやら、\n　まだ自分の能力に気がついてないみたいね‥‥）"},
{"id": 493, "speaker": 29, "form": "dlg", "jp": "（仲間を２人も失うわけにはいかないわ‥‥）"},
{"id": 494, "speaker": 29, "form": "dlg", "jp": "（とにかく、ナゴムはなんとかして\n　そのコを助け出して合流しなさい！）"},
{"id": 495, "speaker": 29, "form": "dlg", "jp": "（そのコの能力が役に立つかもしれないし‥‥）"},
{"id": 496, "speaker": 2, "form": "dlg", "jp": "（助け出すってどうやって？）"},
{"id": 497, "speaker": 29, "form": "dlg", "jp": "（ちょっと待って、\n　今『リモートビュー』を試すから‥‥）"},
{"id": 498, "speaker": 15, "form": "dlg", "jp": "（ねえ、彼女はいったい何を言ってるの？）"},
{"id": 499, "speaker": 2, "form": "dlg", "jp": "（彼女は『遠隔透視』の『能力』を持ってるんだ‥‥）"},
{"id": 500, "speaker": 15, "form": "dlg", "jp": "（『遠隔透視』‥‥？）"},
{"id": 501, "speaker": 2, "form": "dlg", "jp": "（まあ、とにかくボクたちを信じて！）"},
{"id": 502, "speaker": 16, "form": "dlg", "jp": "（ねえ、彼女はいったい何を言ってるの？）"},
{"id": 503, "speaker": 2, "form": "dlg", "jp": "（彼女は『遠隔透視』の『能力』を持ってるんだ‥‥）"},
{"id": 504, "speaker": 16, "form": "dlg", "jp": "（『遠隔透視』‥‥？）"},
{"id": 505, "speaker": 2, "form": "dlg", "jp": "（まあ、とにかくボクたちを信じて！）"},
{"id": 506, "speaker": 29, "form": "dlg", "jp": "（見えたわ！）"},
{"id": 507, "speaker": 2, "form": "dlg", "jp": "（本当！？）"},
{"id": 508, "speaker": 29, "form": "dlg", "jp": "（今、ナゴムのいる部屋を出て、廊下を左に行くと\n　『エレベーターホール』があるわ！）"},
{"id": 509, "speaker": 2, "form": "dlg", "jp": "（そんなの知ってるよ！）"},
{"id": 510, "speaker": 29, "form": "dlg", "jp": "（で、そのコが閉じ込められてるのが\n　その左側の一番手前のエレベーターよ‥‥）"},
{"id": 511, "speaker": 2, "form": "dlg", "jp": "（で、テロの連中は？）"},
{"id": 512, "speaker": 29, "form": "dlg", "jp": "（『パーティーホール』の中はわからないけど‥‥）"},
{"id": 513, "speaker": 29, "form": "dlg", "jp": "（外にいるのは、階段を見張ってるのが４人、\n　『パーティーホール』の入り口に１人いるわ！）"},
{"id": 514, "speaker": 2, "form": "dlg", "jp": "（エレベータの周りは？）"},
{"id": 515, "speaker": 29, "form": "dlg", "jp": "（そこまでは人数が足りてないみたい‥‥）"},
{"id": 516, "speaker": 2, "form": "dlg", "jp": "（じゃあ、エレベータは大丈夫なんだね‥‥）"},
{"id": 517, "speaker": 29, "form": "dlg", "jp": "（今はね‥‥）"},
{"id": 518, "speaker": 2, "form": "dlg", "jp": "（わかった！）"},
{"id": 519, "speaker": 2, "form": "dlg", "jp": "（とにかく、アイコと合流するよ！）"},
{"id": 520, "speaker": 15, "form": "dlg", "jp": "（早く来てね！）"},
{"id": 521, "speaker": 29, "form": "dlg", "jp": "（気をつけてね‥‥）"},
{"id": 522, "speaker": 29, "form": "dlg", "jp": "ボクはエレベーターに閉じ込められている\nアイコを助け出すことにした。"},
{"id": 523, "speaker": 2, "form": "dlg", "jp": "（とにかく、長尾と合流するよ！）"},
{"id": 524, "speaker": 16, "form": "dlg", "jp": "（早く来てね！）"},
{"id": 525, "speaker": 29, "form": "dlg", "jp": "（気をつけてね‥‥）"},
{"id": 526, "speaker": 29, "form": "dlg", "jp": "ボクはエレベーターに閉じ込められている\n長尾を助け出すことにした。"},
{"id": 527, "speaker": 29, "form": "dlg", "jp": "失敗の原因は思いつきで行動したこと。\nもっと情報を集めるように。"},
{"id": 528, "speaker": 29, "form": "dlg", "jp": "失敗の原因は自分の能力を過信したこと。\nもっと相応しい能力の仲間がいたのでは？"}
]
