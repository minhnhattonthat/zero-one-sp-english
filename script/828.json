[
{"id": 0, "speaker": 29, "form": "dlg", "jp": "「そんなことより、あのロボットは\n　あのままにしておいて大丈夫なの？」"},
{"id": 1, "speaker": 31, "form": "dlg", "jp": "「自衛隊で収まりがつけられそうか？」"},
{"id": 2, "speaker": 35, "form": "dlg", "jp": "「わかんないけど‥‥」"},
{"id": 3, "speaker": 35, "form": "dlg", "jp": "「ここにある戦車や実弾程度じゃぁ\n　とても破壊できないだろうね」"},
{"id": 4, "speaker": 35, "form": "dlg", "jp": "「それに、\n　あれだけ大きな木が生えてたら‥‥」"},
{"id": 5, "speaker": 35, "form": "dlg", "jp": "「戦車だって」"},
{"id": 6, "speaker": 35, "form": "dlg", "jp": "ロボットを追う戦車は木にじゃまされて\n先に進めないようだ‥‥"},
{"id": 7, "speaker": 31, "form": "dlg", "jp": "「いったい、なんのための軍備なんだ！」"},
{"id": 8, "speaker": 35, "form": "dlg", "jp": "「『軍』じゃないよ！」"},
{"id": 9, "speaker": 31, "form": "dlg", "jp": "「うるさい！」"},
{"id": 10, "speaker": 31, "form": "dlg", "jp": "「早くなんとかしないと‥‥」"},
{"id": 11, "speaker": 29, "form": "dlg", "jp": "「見てっ！」"},
{"id": 12, "speaker": 29, "form": "dlg", "jp": "「アイツ、確実に町の方へ向かっているわ！」"},
{"id": 13, "speaker": 29, "form": "dlg", "jp": "「このまま放っておいたら‥‥」"},
{"id": 14, "speaker": 31, "form": "dlg", "jp": "「アンタたち、どうにかできないのか？」"},
{"id": 15, "speaker": 31, "form": "dlg", "jp": "（アイコォ！！）"},
{"id": 16, "speaker": 15, "form": "dlg", "jp": "（何ぃ？）"},
{"id": 17, "speaker": 31, "form": "dlg", "jp": "（この後どうなるんだ？）"},
{"id": 18, "speaker": 15, "form": "dlg", "jp": "（ダメよ、この先は夢に見ていないもの‥‥）"},
{"id": 19, "speaker": 31, "form": "dlg", "jp": "（アキラァ！！）"},
{"id": 20, "speaker": 16, "form": "dlg", "jp": "（何ぃ？）"},
{"id": 21, "speaker": 31, "form": "dlg", "jp": "（この後どうなるんだ？）"},
{"id": 22, "speaker": 16, "form": "dlg", "jp": "（ダメよ、この先は夢に見ていないもの‥‥）"},
{"id": 23, "speaker": 31, "form": "dlg", "jp": "（ナナセェ！！）"},
{"id": 24, "speaker": 18, "form": "dlg", "jp": "（何ですか？）"},
{"id": 25, "speaker": 31, "form": "dlg", "jp": "（この後どうなるんだ？）"},
{"id": 26, "speaker": 18, "form": "dlg", "jp": "（わかりません！）"},
{"id": 27, "speaker": 18, "form": "dlg", "jp": "（この先は夢で見ていないんです‥‥！）"},
{"id": 28, "speaker": 29, "form": "dlg", "jp": "「あの‥‥」"},
{"id": 29, "speaker": 35, "form": "dlg", "jp": "「アスカでいいよ‥‥」"},
{"id": 30, "speaker": 29, "form": "dlg", "jp": "「じゃあ、アスカ！」"},
{"id": 31, "speaker": 29, "form": "dlg", "jp": "「私たちを、\n　あのロボットの側まで連れていってくれない？」"},
{"id": 32, "speaker": 35, "form": "dlg", "jp": "「いいけど、どうするつもり？」"},
{"id": 33, "speaker": 29, "form": "dlg", "jp": "「私たちであのロボットを止めるのよ！」"},
{"id": 34, "speaker": 29, "form": "choice", "jp": "「うん、そうしよう！」"},
{"id": 35, "speaker": 29, "form": "choice", "jp": "「それはムチャだ！」"},
{"id": 36, "speaker": 29, "form": "choice", "jp": "「どうやって！？」"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "「うん、そうしよう！」"},
{"id": 38, "speaker": 35, "form": "dlg", "jp": "「ちょっと待って！！」"},
{"id": 39, "speaker": 35, "form": "dlg", "jp": "「止めるってどうやるの？」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「それはムチャだ！」"},
{"id": 41, "speaker": 35, "form": "dlg", "jp": "「オレもそう思うよ‥‥」"},
{"id": 42, "speaker": 35, "form": "dlg", "jp": "「だいたい、止めるってどうやるの？」"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「どうやって！？」"},
{"id": 44, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 45, "speaker": 29, "form": "dlg", "jp": "「破壊するのが一番簡単なのかしら？」"},
{"id": 46, "speaker": 35, "form": "dlg", "jp": "「ムリだよ！！」"},
{"id": 47, "speaker": 35, "form": "dlg", "jp": "「アレは最新式の戦車より頑丈なんだよ！」"},
{"id": 48, "speaker": 35, "form": "dlg", "jp": "「何言ってんの‥‥」"},
{"id": 49, "speaker": 29, "form": "dlg", "jp": "「大丈夫よ‥‥」"},
{"id": 50, "speaker": 29, "form": "dlg", "jp": "「何度も言うけど、\n　私たちも超能力者なのよ‥‥」"},
{"id": 51, "speaker": 29, "form": "dlg", "jp": "「小さな国の軍隊なんかより、\n　ずっと力を持ってるんだから‥‥」"},
{"id": 52, "speaker": 35, "form": "dlg", "jp": "「本当？」"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "「本当でもウソでもどっちでもいいの！」"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "「今言い切れることは、\n　誰かがなんとかしないと大変な事になるってことよ！」"},
{"id": 55, "speaker": 29, "form": "dlg", "jp": "「特にナゴムには、『不死身』の体があるんだから‥‥」"},
{"id": 56, "speaker": 29, "form": "dlg", "jp": "「あんな、ロボットぐらい簡単に‥‥」"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "「ねえ！」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 59, "speaker": 29, "form": "dlg", "jp": "「とにかく、早く連れてってよ！」"},
{"id": 60, "speaker": 29, "form": "dlg", "jp": "「人の為になりたいんでしょう？」"},
{"id": 61, "speaker": 35, "form": "dlg", "jp": "「わかった！！」"},
{"id": 62, "speaker": 35, "form": "dlg", "jp": "「じゃあ、いくよ！！」"},
{"id": 63, "speaker": 35, "form": "dlg", "jp": "ボクたちは松尾さんの能力を使って\nロボットに接近することになった。"},
{"id": 64, "speaker": 35, "form": "dlg", "jp": "「よっと！！」"},
{"id": 65, "speaker": 35, "form": "dlg", "jp": "「みんな大丈夫？」"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 67, "speaker": 31, "form": "dlg", "jp": "「ヒャッホウ！」"},
{"id": 68, "speaker": 31, "form": "dlg", "jp": "「コイツはスゴイや！！」"},
{"id": 69, "speaker": 35, "form": "dlg", "jp": "「アリガトウ‥‥」"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "「で、どうやってコイツを止めるつもり？」"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "「何かいいアイデアない？」"},
{"id": 72, "speaker": 31, "form": "dlg", "jp": "「ええっ！」"},
{"id": 73, "speaker": 31, "form": "dlg", "jp": "「考えもなく来ちゃったのかよ？」"},
{"id": 74, "speaker": 29, "form": "dlg", "jp": "「近くで見ればヒントが見つかるかと思って‥‥」"},
{"id": 75, "speaker": 31, "form": "dlg", "jp": "「仕方ないなぁ‥‥」"},
{"id": 76, "speaker": 31, "form": "dlg", "jp": "「オレに考えがあるぜ！！」"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "「どんなの？」"},
{"id": 78, "speaker": 31, "form": "dlg", "jp": "「このロボットをアスカの能力で\n　宇宙に移動させちゃうんだよ！」"},
{"id": 79, "speaker": 31, "form": "dlg", "jp": "「いい考えだろう？」"},
{"id": 80, "speaker": 35, "form": "dlg", "jp": "「ダメだよ！！」"},
{"id": 81, "speaker": 35, "form": "dlg", "jp": "「オレの能力は、イメージできる場所にしか\n　移動することができないんだ‥‥」"},
{"id": 82, "speaker": 35, "form": "dlg", "jp": "「宇宙なんてイメージできないよ！！」"},
{"id": 83, "speaker": 31, "form": "dlg", "jp": "「じゃあ、イメージできる場所で、\n　海とか、火山の噴火口とか‥‥」"},
{"id": 84, "speaker": 29, "form": "dlg", "jp": "「それも危険ね‥‥」"},
{"id": 85, "speaker": 31, "form": "dlg", "jp": "「なんで‥‥？」"},
{"id": 86, "speaker": 29, "form": "dlg", "jp": "「確かにこの問題は解決できるけど\n　後処理の方が大変になるわよ！」"},
{"id": 87, "speaker": 31, "form": "dlg", "jp": "「どういうことだ？」"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "「そんなハデなことをしたら、\n　私たちの存在がみんなにバレちゃうでしょ！」"},
{"id": 89, "speaker": 31, "form": "dlg", "jp": "「う～ん‥‥」"},
{"id": 90, "speaker": 29, "form": "dlg", "jp": "「とりあえず今は、\n　アレを止めることだけを考えましょう」"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "ボクたちはロボットを停止させる方法を\n考えることにした。"},
{"id": 92, "speaker": 29, "form": "choice", "jp": "【ロボットを見る】"},
{"id": 93, "speaker": 29, "form": "choice", "jp": "【仲間を見る】"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "【ロボットを見る】"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "ボクはロボットを観察した。"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "まるで、\nアニメに出てくるような巨大ロボットだ‥‥"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "これに比べたら、ルードのサイボーグなんて\nオモチャみたいなものだ‥‥"},
{"id": 98, "speaker": 29, "form": "dlg", "jp": "ジーンは本当にこんなものを\n相手に戦うつもりなんだろうか？"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "【仲間を見る】"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "ボクはメンバーの顔を見回した。"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "現在、ここにいるメンバーの能力は‥‥"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "ジーンの『人間レーダー』の能力‥‥"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "ケネスの『サイコキネシス』‥‥"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "松尾さんの『テレポーテーション』‥‥"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "それから‥‥"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "ボクの『変質』する力‥‥"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "いったい、誰の能力なら、\n止められると言うんだ？"},
{"id": 108, "speaker": 31, "form": "dlg", "jp": "「なあ、ジーン‥‥」"},
{"id": 109, "speaker": 31, "form": "dlg", "jp": "「本当にコイツを操ってるのは、\n　『ゲーマー』なのか？」"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "「ハッキリとは言えないけど、\n　その可能性はかなり高いんじゃないかしら」"},
{"id": 111, "speaker": 29, "form": "dlg", "jp": "「とりあえず、私が感知しているのは、\n　『イメージ出来ない信号』なんだけど‥‥」"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "「『イメージできない』ってとこが、人間や、\n　コンピュータの仕業じゃないって証拠だと‥‥」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「もし、本当に『ゲーマー』の仕業だとしたら‥‥」"},
{"id": 114, "speaker": 2, "form": "choice", "jp": "「どこからその信号を送ってるんだろう？」"},
{"id": 115, "speaker": 2, "form": "choice", "jp": "「スゴイパワーの持ち主だな‥‥」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「どこからその信号を送ってるんだろう？」"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "「そこまではわからないわ‥‥」"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「とにかく、その信号を止めることができたら、\n　コイツを止めることができるんだよね‥‥」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「となると、やっぱり『ゲーマー』を倒すしか‥‥」"},
{"id": 121, "speaker": 29, "form": "dlg", "jp": "「そんなに簡単に倒すことができるなら、\n　苦労はしないけど‥‥」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「だろうね‥‥」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「しかし『ゲーマー』って‥‥」"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「スゴイパワーの持ち主だな‥‥」"},
{"id": 125, "speaker": 35, "form": "dlg", "jp": "「ホント‥‥」"},
{"id": 126, "speaker": 35, "form": "dlg", "jp": "「あんな大きなもの自由に操ってるんだから‥‥」"},
{"id": 127, "speaker": 31, "form": "dlg", "jp": "「なんか、勘違いしてるな、お二人さん！」"},
{"id": 128, "speaker": 31, "form": "dlg", "jp": "「別にゲーマーがあのロボットを直接つかんで\n　持ち上げてるわけじゃないんだぜ！」"},
{"id": 129, "speaker": 29, "form": "dlg", "jp": "「『ゲーマー』の能力っていうのは\n　一種の催眠術みたいなものなの‥‥」"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "「つまり、地震や洪水なんかの天変地異を起こすのも\n　別に力づくってわけじゃなくて‥‥」"},
{"id": 131, "speaker": 29, "form": "dlg", "jp": "「地球にあるマグマの動きや潮の流れを狂わせるだけ‥‥」"},
{"id": 132, "speaker": 29, "form": "dlg", "jp": "「あのロボットを動かしてるパワーも、\n　あのロボット自身のパワーであって」"},
{"id": 133, "speaker": 29, "form": "dlg", "jp": "「『ゲーマー』はおかしな動きをするように\n　命令しているだけなの‥‥」"},
{"id": 134, "speaker": 29, "form": "choice", "jp": "「ちょっと待って！」"},
{"id": 135, "speaker": 29, "form": "choice", "jp": "「今の言葉プレイバック！！」"},
{"id": 136, "speaker": 29, "form": "choice", "jp": "「ちょうのように舞って‥‥」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「ちょうのように舞って‥‥」"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "「ハチのように刺す！！」"},
{"id": 139, "speaker": 31, "form": "dlg", "jp": "「それがどうかしたのか？」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「いや、なんかあのロボット動きは鈍そうだから‥‥」"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "「ヒット＆アウェイで倒せるんじゃぁないかな？」"},
{"id": 142, "speaker": 31, "form": "dlg", "jp": "「戦車の砲撃以上のヒットをどうやって\n　喰らわせるつもりだ？」"},
{"id": 143, "speaker": 31, "form": "dlg", "jp": "「ちょこちょこ殴っただけでは\n　破壊できないと思うけど？」"},
{"id": 144, "speaker": 31, "form": "choice", "jp": "「それはそうだけど‥‥」"},
{"id": 145, "speaker": 31, "form": "choice", "jp": "「弱点を攻めれば！！」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「弱点を攻めれば！！」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「どっか、弱い場所もあるんじゃないかな？」"},
{"id": 148, "speaker": 31, "form": "dlg", "jp": "「だから、そんなとこだけ壊しても、\n　止められないだろう！」"},
{"id": 149, "speaker": 29, "form": "dlg", "jp": "「待って、その考え方アリかも？」"},
{"id": 150, "speaker": 31, "form": "dlg", "jp": "「チョウの様に舞うのはアリの戦法だけど‥‥」"},
{"id": 151, "speaker": 29, "form": "dlg", "jp": "「違うわよ！！」"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "「『弱点』だけを狙うって作戦よ！」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「それはそうだけど‥‥」"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "「みんなの能力を使えば、\n　なんとかなるんじゃないかな？」"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "「例えば‥‥」"},
{"id": 156, "speaker": 2, "form": "choice", "jp": "「核爆弾をテレポートさせるとか‥‥」"},
{"id": 157, "speaker": 2, "form": "choice", "jp": "「ミサイルをコントロールしてぶつけるとか！」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「核爆弾をテレポートさせるとか‥‥」"},
{"id": 159, "speaker": 29, "form": "dlg", "jp": "「爆発に私たちも巻き込まれるわ！」"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "「だから、ヒット＆アウェイで逃げるんだよ！」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「コッチには松尾さんがいるんだから、\n　瞬時に逃げられるだろう？」"},
{"id": 162, "speaker": 29, "form": "dlg", "jp": "「敵は何でもコントロールできるのよ！」"},
{"id": 163, "speaker": 29, "form": "dlg", "jp": "「逆に核爆弾をコントロールされちゃったら‥‥」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「ミサイルをコントロールしてぶつけるとか！」"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "「ここになくっても、\n　別の国からでも持ってくること可能だろう？」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "「コッチには松尾さんがいるんだから‥‥」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「それをケネスの能力で、\n　コントロールしてぶつければ‥‥」"},
{"id": 168, "speaker": 29, "form": "dlg", "jp": "「敵は何でもコントロールできるのよ！」"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "「逆にミサイルをコントロールされちゃったら‥‥」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「ダメかな‥‥」"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "「ダメね‥‥」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「じゃあ、どうするんだよ！」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「あんな頑丈なヤツそう簡単に破壊できないだろう？」"},
{"id": 174, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "「別に破壊しなくてもいいんじゃない？」"},
{"id": 176, "speaker": 29, "form": "dlg", "jp": "「止めるだけで‥‥」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「だから止めるために破壊しないと‥‥」"},
{"id": 178, "speaker": 29, "form": "dlg", "jp": "「まあ、そうなんだけど‥‥」"},
{"id": 179, "speaker": 29, "form": "dlg", "jp": "「全部を壊さなくても、\n　『動力源』だけ壊せば‥‥」"},
{"id": 180, "speaker": 29, "form": "dlg", "jp": "「『ゲーマー』はパワーで動かしているのではなく、\n　ただコントロールしてるだけなんだから‥‥」"},
{"id": 181, "speaker": 29, "form": "dlg", "jp": "「『動力源』を破壊すれば、\n　『ゲーマー』も動かせなくなるんじゃない？」"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「今の言葉プレイバック！！」"},
{"id": 184, "speaker": 29, "form": "dlg", "jp": "「あのロボットを動かしてるパワーも、\n　あのロボット自身のパワーであって」"},
{"id": 185, "speaker": 29, "form": "dlg", "jp": "「ゲーマーはおかしな動きをするように\n　命令しているだけ‥‥」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「って、ことは‥‥」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「別に破壊しなくてもいいんじゃないかな？」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「止めるだけで‥‥」"},
{"id": 189, "speaker": 29, "form": "dlg", "jp": "「だから止めるために破壊しないと‥‥」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "「まあ、そうなんだけど‥‥」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「全部を壊さなくても、\n　『動力源』だけ壊せば‥‥」"},
{"id": 192, "speaker": 2, "form": "dlg", "jp": "「『ゲーマー』はパワーで動かしているのではなく、\n　ただコントロールしてるだけなんだから‥‥」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「『動力源』を破壊すれば、\n　『ゲーマー』も動かせなくなるんじゃぁ？」"},
{"id": 194, "speaker": 31, "form": "dlg", "jp": "「なるほど！！」"},
{"id": 195, "speaker": 31, "form": "dlg", "jp": "「バラバラにするよりはそっちの方が\n　まだ簡単かもしれないなぁ‥‥」"},
{"id": 196, "speaker": 31, "form": "dlg", "jp": "「ナァ、アイツの『動力源』はどこにあるんだ？」"},
{"id": 197, "speaker": 35, "form": "dlg", "jp": "「知らないなぁ～」"},
{"id": 198, "speaker": 35, "form": "dlg", "jp": "「オレたち下っ端にそこまでは教えてくれないから‥‥」"},
{"id": 199, "speaker": 29, "form": "dlg", "jp": "「ちょっと、アイツの動力源って何‥‥？」"},
{"id": 200, "speaker": 35, "form": "dlg", "jp": "「ディーゼル‥‥」"},
{"id": 201, "speaker": 29, "form": "dlg", "jp": "「わかった！」"},
{"id": 202, "speaker": 29, "form": "dlg", "jp": "「それなら、アイツの動力源は背中にあるわ！」"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "「背中？」"},
{"id": 204, "speaker": 29, "form": "dlg", "jp": "「ディーゼルエンジンの音が聞こえるから‥‥」"},
{"id": 205, "speaker": 31, "form": "dlg", "jp": "「じゃあ、そこを破壊すれば！」"},
{"id": 206, "speaker": 31, "form": "dlg", "jp": "「‥‥って、どうやってそこを破壊するんだ？」"},
{"id": 207, "speaker": 35, "form": "dlg", "jp": "「確かに！」"},
{"id": 208, "speaker": 35, "form": "dlg", "jp": "「背中も、同じ装甲だから、\n　戦車ぐらいの攻撃じゃビクともしないよ‥‥」"},
{"id": 209, "speaker": 29, "form": "dlg", "jp": "「‥‥？？」"},
{"id": 210, "speaker": 29, "form": "dlg", "jp": "「‥‥！！」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 212, "speaker": 29, "form": "dlg", "jp": "「ヘリコプターの音が聞こえる‥‥」"},
{"id": 213, "speaker": 35, "form": "dlg", "jp": "「応援を呼んだんだな‥‥」"},
{"id": 214, "speaker": 35, "form": "dlg", "jp": "「きっと空対地用の強力なミサイルを運んで来るんだ！」"},
{"id": 215, "speaker": 35, "form": "choice", "jp": "「やった！」"},
{"id": 216, "speaker": 35, "form": "choice", "jp": "「マズイ！」"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "「やった！」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「あとはそのヘリに任せよう！」"},
{"id": 219, "speaker": 29, "form": "dlg", "jp": "「バカ！！」"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「マズイ！」"},
{"id": 221, "speaker": 35, "form": "dlg", "jp": "「なんで？」"},
{"id": 222, "speaker": 35, "form": "dlg", "jp": "「あとはヘリに任せれば‥‥？」"},
{"id": 223, "speaker": 29, "form": "dlg", "jp": "「ダメよ！！」"},
{"id": 224, "speaker": 29, "form": "dlg", "jp": "「相手は『人間以外のあらゆるもの』を\n　コントロールできるのよ？」"},
{"id": 225, "speaker": 29, "form": "dlg", "jp": "「そんなミサイル、コントロールされちゃうに\n　決まってるじゃない！」"},
{"id": 226, "speaker": 31, "form": "dlg", "jp": "「オレなら、そのミサイルを民家に命中させるな‥‥」"},
{"id": 227, "speaker": 29, "form": "dlg", "jp": "「もう、時間がないわ‥‥」"},
{"id": 228, "speaker": 29, "form": "dlg", "jp": "「早くしないとヘリがやってきちゃう！！」"},
{"id": 229, "speaker": 29, "form": "dlg", "jp": "「こうなったら‥‥」"},
{"id": 230, "speaker": 29, "form": "dlg", "jp": "「ナゴムの能力にかけてみるしかないわね‥‥」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「へっ！？」"},
{"id": 232, "speaker": 29, "form": "dlg", "jp": "「ここにいる連中の能力の中で、\n　直接攻撃のできるのはキミだけでしょう！！」"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "「ヤツに間接攻撃をしても、\n　コントロールされちゃうだけだから‥‥」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「でも、戦車以上の攻撃力なんて‥‥」"},
{"id": 235, "speaker": 29, "form": "dlg", "jp": "「頭を使いなさい！！」"},
{"id": 236, "speaker": 29, "form": "dlg", "jp": "「キミは体を自由に変質できるんだから‥‥」"},
{"id": 237, "speaker": 29, "form": "dlg", "jp": "「体を強じんにするとか‥‥」"},
{"id": 238, "speaker": 29, "form": "dlg", "jp": "「筋力をアップさせるとか可能でしょう？」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「そんなことぐらいで戦車以上の破壊力が？」"},
{"id": 240, "speaker": 29, "form": "dlg", "jp": "「イメージ次第よ！！」"},
{"id": 241, "speaker": 29, "form": "dlg", "jp": "「戦車の何倍も凄い攻撃力をイメージできれば、\n　その攻撃力をくり出すことができるのよ！」"},
{"id": 242, "speaker": 29, "form": "dlg", "jp": "「迷ったり、疑っちゃダメ！！」"},
{"id": 243, "speaker": 29, "form": "dlg", "jp": "「早くっ！！」"},
{"id": 244, "speaker": 2, "form": "dlg", "jp": "「早くっていっても、直接攻撃だから、\n　ここからじゃぁ～～」"},
{"id": 245, "speaker": 2, "form": "choice", "jp": "「ケネス‥‥」"},
{"id": 246, "speaker": 2, "form": "choice", "jp": "「松尾さん‥‥」"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "「ケネス‥‥」"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "「悪いけど‥‥」"},
{"id": 249, "speaker": 31, "form": "dlg", "jp": "「わかった！」"},
{"id": 250, "speaker": 31, "form": "dlg", "jp": "「アイツの背中に運べばいいんだろ？」"},
{"id": 251, "speaker": 31, "form": "dlg", "jp": "「それぐらい、お安い御用だ！！」"},
{"id": 252, "speaker": 31, "form": "dlg", "jp": "ボクはケネスの能力で、\nあのロボットの背中に運んでもらうことになった。"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 254, "speaker": 2, "form": "dlg", "jp": "「松尾さん‥‥」"},
{"id": 255, "speaker": 2, "form": "dlg", "jp": "「悪いけど‥‥」"},
{"id": 256, "speaker": 35, "form": "dlg", "jp": "「何？」"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "「ボクをアイツの背中に移動させてください！！」"},
{"id": 258, "speaker": 35, "form": "dlg", "jp": "「いいけど‥‥」"},
{"id": 259, "speaker": 35, "form": "dlg", "jp": "「大丈夫なの？」"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "「わかんないけど‥‥」"},
{"id": 261, "speaker": 2, "form": "dlg", "jp": "「やるしかないんだよね‥‥」"},
{"id": 262, "speaker": 29, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 263, "speaker": 29, "form": "dlg", "jp": "「頼んだわよ‥‥」"},
{"id": 264, "speaker": 29, "form": "dlg", "jp": "ボクは松尾さんの能力で、\nあのロボットの背中に運んでもらうことになった。"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "（さてと‥‥）"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "ボクは拳を硬く変質させて、\n装甲を思いっきり殴り付けた。"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "「ガツ～～ン！」"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "（やっぱり、この程度じゃぁダメか‥‥）"},
{"id": 269, "speaker": 29, "form": "dlg", "jp": "（ナゴム、急いで！！）"},
{"id": 270, "speaker": 29, "form": "dlg", "jp": "（ヘリがやって来たわ！）"},
{"id": 271, "speaker": 2, "form": "dlg", "jp": "（わかってる！！）"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "（でも‥‥）"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "（ちくしょう！！）"},
{"id": 274, "speaker": 2, "form": "dlg", "jp": "（強力な破壊力か‥‥）"},
{"id": 275, "speaker": 2, "form": "choice", "jp": "（どうすればいいんだ！）"},
{"id": 276, "speaker": 2, "form": "choice", "jp": "（そうだ、筋力をアップしてみよう！！）"},
{"id": 277, "speaker": 2, "form": "choice", "jp": "（そうだ、シローなら！！）"},
{"id": 278, "speaker": 29, "form": "dlg", "jp": "（何してるの！）"},
{"id": 279, "speaker": 29, "form": "dlg", "jp": "（早く！！）"},
{"id": 280, "speaker": 29, "form": "dlg", "jp": "（もうダメ‥‥）"},
{"id": 281, "speaker": 29, "form": "dlg", "jp": "（逃げて！！）"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "（どうすればいいんだ！）"},
{"id": 283, "speaker": 29, "form": "dlg", "jp": "（何してるの！）"},
{"id": 284, "speaker": 29, "form": "dlg", "jp": "（早く！！）"},
{"id": 285, "speaker": 29, "form": "dlg", "jp": "（もうダメ‥‥）"},
{"id": 286, "speaker": 29, "form": "dlg", "jp": "（逃げて！！）"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "（そうだ、シローなら！！）"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "（『軍事衛星』の『シロー』なら‥‥）"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "「シロォ～～～！」"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "「見てるんだろ～～？」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「頼む～～！！」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「コイツを破壊してくれぇ～～！！」"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "（そうだ、筋力をアップしてみよう！！）"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "（ジーンが、\n　『イメージさえできれば‥‥』って言ってたな‥‥）"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "ボクは自分の筋力をアップするように\nイメージしてみることにした。"},
{"id": 296, "speaker": 29, "form": "dlg", "jp": "（何してるの！）"},
{"id": 297, "speaker": 29, "form": "dlg", "jp": "（早く！！）"},
{"id": 298, "speaker": 29, "form": "dlg", "jp": "（もうダメ‥‥）"},
{"id": 299, "speaker": 29, "form": "dlg", "jp": "（逃げて！！）"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "「やった！！」"},
{"id": 301, "speaker": 29, "form": "dlg", "jp": "（ナゴム、気をつけて！！）"},
{"id": 302, "speaker": 2, "form": "dlg", "jp": "（何！？）"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "（どうしたの‥‥？）"},
{"id": 304, "speaker": 29, "form": "dlg", "jp": "（エンジンを破壊したんだから、『爆発』するわよ！）"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "（『爆発』！？）"},
{"id": 306, "speaker": 29, "form": "dlg", "jp": "（早く逃げて！！）"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "（逃げてっても‥‥）"},
{"id": 308, "speaker": 2, "form": "choice", "jp": "（ジーン！！）"},
{"id": 309, "speaker": 2, "form": "choice", "jp": "（ケネス！！）"},
{"id": 310, "speaker": 2, "form": "choice", "jp": "（松尾さん！！）"},
{"id": 311, "speaker": 29, "form": "dlg", "jp": "（もうダメ‥‥）"},
{"id": 312, "speaker": 29, "form": "dlg", "jp": "（逃げて！！）"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "（ジーン！！）"},
{"id": 314, "speaker": 29, "form": "dlg", "jp": "（逃げて！！）"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "（ケネス！！）"},
{"id": 316, "speaker": 31, "form": "dlg", "jp": "（ダメだ！！）"},
{"id": 317, "speaker": 31, "form": "dlg", "jp": "（オレじゃぁ間にあわない！）"},
{"id": 318, "speaker": 29, "form": "dlg", "jp": "（逃げて！！）"},
{"id": 319, "speaker": 2, "form": "dlg", "jp": "（松尾さん！！）"},
{"id": 320, "speaker": 35, "form": "dlg", "jp": "（わかった！）"},
{"id": 321, "speaker": 35, "form": "dlg", "jp": "（まかせて！！）"},
{"id": 322, "speaker": 35, "form": "dlg", "jp": "ボクは松尾さんの能力で、\n安全な場所に移動させてもらった。"},
{"id": 323, "speaker": 15, "form": "dlg", "jp": "（ナゴムちゃん！！）"},
{"id": 324, "speaker": 15, "form": "dlg", "jp": "（ねぇ‥‥、大丈夫なの？）"},
{"id": 325, "speaker": 15, "form": "dlg", "jp": "（ナゴムちゃん‥‥）"},
{"id": 326, "speaker": 16, "form": "dlg", "jp": "（常光寺くん！！）"},
{"id": 327, "speaker": 16, "form": "dlg", "jp": "（ねぇ‥‥、大丈夫なの？）"},
{"id": 328, "speaker": 16, "form": "dlg", "jp": "（常光寺くん‥‥）"},
{"id": 329, "speaker": 18, "form": "dlg", "jp": "（常光寺くん！！）"},
{"id": 330, "speaker": 18, "form": "dlg", "jp": "（ねぇ‥‥、大丈夫なの？）"},
{"id": 331, "speaker": 18, "form": "dlg", "jp": "（常光寺くん‥‥）"},
{"id": 332, "speaker": 2, "form": "dlg", "jp": "（‥‥大丈夫だよ！！）"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "（松尾さんのおかげで‥‥）"},
{"id": 334, "speaker": 29, "form": "dlg", "jp": "「間に合ったわね‥‥」"},
{"id": 335, "speaker": 29, "form": "dlg", "jp": "「よかった‥‥」"},
{"id": 336, "speaker": 2, "form": "dlg", "jp": "「ああ、とりあえず町に被害は‥‥」"},
{"id": 337, "speaker": 31, "form": "dlg", "jp": "「バカ、ジーンはナゴムのことを\n　心配してたんだよ！」"},
{"id": 338, "speaker": 2, "form": "dlg", "jp": "「あ、ありがとう‥‥」"},
{"id": 339, "speaker": 2, "form": "dlg", "jp": "「まあ、松尾さんがいたから‥‥」"},
{"id": 340, "speaker": 2, "form": "dlg", "jp": "「‥‥やっぱ、松尾さんの能力はスゴイよ！！」"},
{"id": 341, "speaker": 35, "form": "dlg", "jp": "「君の能力の方がスゴイよ！！」"},
{"id": 342, "speaker": 35, "form": "dlg", "jp": "「戦車より強いんだから‥‥」"},
{"id": 343, "speaker": 29, "form": "dlg", "jp": "「あんまり、おだてない方がいいわよ！」"},
{"id": 344, "speaker": 29, "form": "dlg", "jp": "「まだまだ、危なっかしいんだから‥‥」"},
{"id": 345, "speaker": 31, "form": "dlg", "jp": "「それより、アンタ‥‥」"},
{"id": 346, "speaker": 31, "form": "dlg", "jp": "「戻らなくていいのか？」"},
{"id": 347, "speaker": 35, "form": "dlg", "jp": "「本当だ！！」"},
{"id": 348, "speaker": 35, "form": "dlg", "jp": "「やばい、叱られちゃうよ！！」"},
{"id": 349, "speaker": 35, "form": "dlg", "jp": "「じゃぁこれで‥‥」"},
{"id": 350, "speaker": 35, "form": "dlg", "jp": "松尾さんはあわてて、能力で立ち去った。"},
{"id": 351, "speaker": 29, "form": "dlg", "jp": "「変わった人ね‥‥」"},
{"id": 352, "speaker": 31, "form": "dlg", "jp": "「そんなことより‥‥」"},
{"id": 353, "speaker": 31, "form": "dlg", "jp": "「アイツがいなくなったら、\n　オレたちどうやって車に戻るんだ？」"},
{"id": 354, "speaker": 29, "form": "dlg", "jp": "「歩いて戻るしかなさそうね‥‥」"},
{"id": 355, "speaker": 2, "form": "dlg", "jp": "「歩くったって‥‥」"},
{"id": 356, "speaker": 2, "form": "dlg", "jp": "「ここは、迷うことで有名な『富士樹海』だよ？」"},
{"id": 357, "speaker": 29, "form": "dlg", "jp": "「大丈夫よ！！」"},
{"id": 358, "speaker": 29, "form": "dlg", "jp": "「私の能力があるから、絶対迷わないわ！！」"},
{"id": 359, "speaker": 31, "form": "dlg", "jp": "「だいたい、ナゴムはいろんなことを迷いすぎ‥‥」"},
{"id": 360, "speaker": 31, "form": "dlg", "jp": "「なんか、いつも迷ったり、悩んだりしてるみたいだぜ！」"},
{"id": 361, "speaker": 29, "form": "dlg", "jp": "「とにかく、ここからは簡単に抜けられるから」"},
{"id": 362, "speaker": 29, "form": "dlg", "jp": "「それより、別の心配をした方が良さそうね‥‥」"},
{"id": 363, "speaker": 2, "form": "dlg", "jp": "「『別の心配』？？」"},
{"id": 364, "speaker": 29, "form": "dlg", "jp": "「いよいよ、『ゲーマー』が行動を始めたってことよ！」"},
{"id": 365, "speaker": 31, "form": "dlg", "jp": "「でも、『ゲーマー』って、たいしたことなかったよな‥‥」"},
{"id": 366, "speaker": 29, "form": "dlg", "jp": "「ちょっと、勘違いしないでよ！」"},
{"id": 367, "speaker": 29, "form": "dlg", "jp": "「今のが『ゲーマー』の本気だとは思わないで！」"},
{"id": 368, "speaker": 29, "form": "dlg", "jp": "「多分、今のは『準備運動』とか、\n　宣戦布告のあいさつ程度じゃないかしら？」"},
{"id": 369, "speaker": 31, "form": "dlg", "jp": "「なんで、そんなことするんだ？」"},
{"id": 370, "speaker": 29, "form": "dlg", "jp": "「私たちの存在に気付いているってことでしょう？」"},
{"id": 371, "speaker": 31, "form": "dlg", "jp": "「まさか！！」"},
{"id": 372, "speaker": 29, "form": "dlg", "jp": "「多分、\n　私たちの力を試したんじゃないかしら？」"},
{"id": 373, "speaker": 29, "form": "dlg", "jp": "「とにかく、\n　残るメンバー探しは１名だけなんだし‥‥」"},
{"id": 374, "speaker": 29, "form": "dlg", "jp": "「早く見つけ出して、本部と合流した方が良さそうね‥‥」"},
{"id": 375, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 376, "speaker": 31, "form": "dlg", "jp": "「とにかく早く戻ろうぜ」"},
{"id": 377, "speaker": 31, "form": "dlg", "jp": "「日が暮れちまうよ‥‥」"},
{"id": 378, "speaker": 31, "form": "dlg", "jp": "こうして、『テレポーテーション』の能力を持つ\n『松尾さん』が新たな仲間に加わった。"},
{"id": 379, "speaker": 31, "form": "dlg", "jp": "これで、ジーンの探している仲間は\nあと１人となった。"},
{"id": 380, "speaker": 31, "form": "dlg", "jp": "しかし、今回の事件でわかったことは、\nすでに『ゲーマー』の活動が始まったであろうことと"},
{"id": 381, "speaker": 31, "form": "dlg", "jp": "その、圧倒的に強力な能力だった。"},
{"id": 382, "speaker": 31, "form": "dlg", "jp": "ジーンは\n『ゲーマー』はまだ本気を出していないという。"},
{"id": 383, "speaker": 31, "form": "dlg", "jp": "ボクたちは本当に『ゲーマー』から、\n人類を守ることなんてできるんだろうか？"},
{"id": 384, "speaker": 31, "form": "dlg", "jp": "ボクは不安を感じながら帰路についた。"},
{"id": 385, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 386, "speaker": 2, "form": "dlg", "jp": "ボクの体はロボットと共にバラバラになった‥‥"},
{"id": 387, "speaker": 2, "form": "dlg", "jp": "失敗の原因は判断ミス。\nもっと効果的な選択があったハズ。"},
{"id": 388, "speaker": 2, "form": "dlg", "jp": "失敗の原因は素早い判断ができなかったこと。\nもっと決断力をつけるように‥‥"},
{"id": 389, "speaker": 2, "form": "dlg", "jp": "失敗の原因は素早い判断ができなかったこと。\nもっと決断力をつけるように‥‥"},
{"id": 390, "speaker": 2, "form": "dlg", "jp": "失敗の原因は判断ミス。\nもっと効果的な選択があったハズ。"},
{"id": 391, "speaker": 2, "form": "dlg", "jp": "能力をうまく使いこなせなかったのが失敗の原因。\nもっと能力を使いこなせるようにトレーニングを‥‥"},
{"id": 392, "speaker": 2, "form": "dlg", "jp": "失敗の原因は素早い判断ができなかったこと。\nもっと決断力をつけるように‥‥"},
{"id": 393, "speaker": 2, "form": "dlg", "jp": "失敗の原因は判断ミス。\nジーンには脱出に適した能力はない。"},
