[
{"id": 0, "speaker": null, "form": "dlg", "jp": "「ピ・ポ・パ・ポ・ピ‥‥」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "「もしもし‥‥」"},
{"id": 2, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 3, "speaker": 29, "form": "dlg", "jp": "（ジーンだけど‥‥）"},
{"id": 4, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 5, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "（どう、アイツと連絡ついた？）"},
{"id": 7, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「ああ、１０時に神社のウラに来るって‥‥」"},
{"id": 9, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 10, "speaker": 29, "form": "dlg", "jp": "（アイツ、何か言ってた？）"},
{"id": 11, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「ううん‥‥何も‥‥」"},
{"id": 13, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 14, "speaker": 29, "form": "dlg", "jp": "（そう‥‥）"},
{"id": 15, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 16, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 17, "speaker": 29, "form": "dlg", "jp": "（じゃあ、ナゴムも９時半ごろに‥‥）"},
{"id": 18, "speaker": 29, "form": "dlg", "jp": "」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「ピッ！」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "出口はすんなりとボクの誘い出しにのってくれた。"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "もちろん、出口もそれだけ自信があるからだろう‥‥"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "２００５／０８／０５／ＰＭ０９：０５"},
{"id": 24, "speaker": 3, "form": "dlg", "jp": "「ちょっと、こんな時間にどこへ行くのよ？」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「別に‥‥」"},
{"id": 26, "speaker": 3, "form": "dlg", "jp": "「別にじゃないわよ！」"},
{"id": 27, "speaker": 3, "form": "dlg", "jp": "「ダメよ中学生がこんな時間に外出したら‥‥」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "ボクは部屋に戻ることにした。"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "さてと‥‥"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "これで、姉さんも安心するだろう‥‥"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「シュン！」"},
{"id": 35, "speaker": 31, "form": "dlg", "jp": "（おまたせ‥‥）"},
{"id": 36, "speaker": 31, "form": "dlg", "jp": "（準備はいいか？）"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 38, "speaker": 31, "form": "dlg", "jp": "（じゃあ行くぞ！）"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "（よろしく！）"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "ボクはケネスの能力で\n窓から抜け出す作戦を立てていたんだ。"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「シュン！」"},
{"id": 42, "speaker": 31, "form": "dlg", "jp": "（ホラよ！）"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "（ありがとう！）"},
{"id": 44, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "ボクたちは待ち合わせ場所の『神社』へと向かった。"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "２００５／０８／０５／ＰＭ０９：３８"},
{"id": 48, "speaker": 51, "form": "dlg", "jp": "「やっと来た！」"},
{"id": 49, "speaker": 29, "form": "dlg", "jp": "「家族の人は大丈夫？」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「たぶんね‥‥」"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "「で、今何時？」"},
{"id": 52, "speaker": 51, "form": "dlg", "jp": "「９時４０分‥‥」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「あと２０分か‥‥」"},
{"id": 54, "speaker": 51, "form": "dlg", "jp": "「アイツ、すんなり話を聞いてくれるかな？」"},
{"id": 55, "speaker": 16, "form": "dlg", "jp": "「やっと来た！」"},
{"id": 56, "speaker": 29, "form": "dlg", "jp": "「家族の人は大丈夫？」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "「たぶんね‥‥」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「で、今何時？」"},
{"id": 59, "speaker": 16, "form": "dlg", "jp": "「９時４０分‥‥」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「あと２０分か‥‥」"},
{"id": 61, "speaker": 16, "form": "dlg", "jp": "「アイツ、すんなり話を聞いてくれるかな？」"},
{"id": 62, "speaker": 31, "form": "dlg", "jp": "「なあに、『ジーンの能力』が復活して、\n　さらに『アイツの能力』もバレてしまったんだから」"},
{"id": 63, "speaker": 31, "form": "dlg", "jp": "「こないだみたいに\n　つっぱった態度はとらないだろうよ‥‥」"},
{"id": 64, "speaker": 29, "form": "dlg", "jp": "「そうだといいんだけど‥‥」"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "そして‥‥"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "２００５／０８／０５／ＰＭ０９：５０"},
{"id": 67, "speaker": 50, "form": "dlg", "jp": "「ずいぶん早くから来てたんだね‥‥」"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "「まあね‥‥」"},
{"id": 69, "speaker": 50, "form": "dlg", "jp": "「で、話ってなんだい？」"},
{"id": 70, "speaker": 29, "form": "dlg", "jp": "「まずは『ノア』を返しなさい‥‥」"},
{"id": 71, "speaker": 50, "form": "dlg", "jp": "「ダメ、それは『ありえない』よ‥‥」"},
{"id": 72, "speaker": 31, "form": "dlg", "jp": "「言っておくが、『オマエの能力の正体』は\n　もうバレてるんだぜ？」"},
{"id": 73, "speaker": 50, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 74, "speaker": 50, "form": "dlg", "jp": "「それで強迫しようってこと？」"},
{"id": 75, "speaker": 29, "form": "dlg", "jp": "「おどしじゃないわよ！」"},
{"id": 76, "speaker": 50, "form": "dlg", "jp": "「『ゲーマー』の攻撃が始まったから\n　あせってるようだね‥‥」"},
{"id": 77, "speaker": 16, "form": "dlg", "jp": "「そこまでわかってるならなんで？」"},
{"id": 78, "speaker": 51, "form": "dlg", "jp": "「そこまでわかってるならなんで？」"},
{"id": 79, "speaker": 50, "form": "dlg", "jp": "「だって、\n　キミたちに渡してもしかたないだろう？」"},
{"id": 80, "speaker": 50, "form": "dlg", "jp": "「このすばらしい『ノア』を」"},
{"id": 81, "speaker": 50, "form": "dlg", "jp": "「わずかな人間を救うために使うなんて‥‥」"},
{"id": 82, "speaker": 29, "form": "dlg", "jp": "「たしかに\n　わずかな人間しか救えないかもしれないけど」"},
{"id": 83, "speaker": 50, "form": "dlg", "jp": "「全滅か‥‥」"},
{"id": 84, "speaker": 50, "form": "dlg", "jp": "「それもいいかも‥‥」"},
{"id": 85, "speaker": 31, "form": "dlg", "jp": "「何バカなこと言ってるんだよ‥‥」"},
{"id": 86, "speaker": 31, "form": "dlg", "jp": "「オマエも死んじまうかもしれないんだぞ！」"},
{"id": 87, "speaker": 50, "form": "dlg", "jp": "「ご心配なく‥‥」"},
{"id": 88, "speaker": 50, "form": "dlg", "jp": "「ボクはどんなことがあっても\n　死にませんから‥‥」"},
{"id": 89, "speaker": 31, "form": "dlg", "jp": "「ケッ、相変わらずの自信だな‥」"},
{"id": 90, "speaker": 50, "form": "dlg", "jp": "「ああ、実力のある者が\n　自信を持つのは当然だろう？」"},
{"id": 91, "speaker": 16, "form": "dlg", "jp": "「じゃあ、やっぱり返すつもりはないのね？」"},
{"id": 92, "speaker": 51, "form": "dlg", "jp": "「じゃあ、やっぱり返すつもりはないんやね？」"},
{"id": 93, "speaker": 50, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 94, "speaker": 50, "form": "dlg", "jp": "「まあどうしても取りかえしたいなら」"},
{"id": 95, "speaker": 50, "form": "dlg", "jp": "「『力づく』で取りかえせばいいだろう？」"},
{"id": 96, "speaker": 50, "form": "dlg", "jp": "「どうせ、\n　そのつもりでこんな所に呼び出したんだろう？」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「そんなことはない、\n　ボクたちはちゃんと話し合いをするために‥‥」"},
{"id": 98, "speaker": 50, "form": "dlg", "jp": "「ムリだよ‥‥」"},
{"id": 99, "speaker": 31, "form": "dlg", "jp": "「ムリだとう？」"},
{"id": 100, "speaker": 50, "form": "dlg", "jp": "「ああ、アナタたちは何があっても\n　『ノア』をあきらめるつもりはなさそうだし‥‥」"},
{"id": 101, "speaker": 50, "form": "dlg", "jp": "「ボクも何があっても\n　『ノア』を手放すつもりはないから‥‥」"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "「つまり、どうあっても\n　敵対しあうってこと‥‥」"},
{"id": 103, "speaker": 50, "form": "dlg", "jp": "「いや、それは少し違うよ‥‥」"},
{"id": 104, "speaker": 50, "form": "dlg", "jp": "「ボクはアナタたちが『ノア』をあきらめてくれたら」"},
{"id": 105, "speaker": 50, "form": "dlg", "jp": "「一切、\n　アナタたちと敵対するつもりはないから‥‥」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「それじゃあ、『人類』は‥‥」"},
{"id": 107, "speaker": 50, "form": "dlg", "jp": "「『人類』？」"},
{"id": 108, "speaker": 50, "form": "dlg", "jp": "「その言葉がおおげさすぎるんだよ！」"},
{"id": 109, "speaker": 50, "form": "dlg", "jp": "「どうせ、『ノア』があっても\n　全員が生き残れるワケじゃないんだろう？」"},
{"id": 110, "speaker": 50, "form": "dlg", "jp": "「それに‥‥」"},
{"id": 111, "speaker": 50, "form": "dlg", "jp": "「『ゲーマー』が襲って来なくても\n　世界中で必ず誰かは死んでるわけだし‥‥」"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "「たしかにそうだけど‥‥」"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "「でも、『ノア』がないと、地球上から\n　人間が１人もいなくなるかもしれないのよ」"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "「その場合なら、\n　たった１人でも『人類』でしょう？」"},
{"id": 115, "speaker": 31, "form": "dlg", "jp": "「『１』と『０』とではまったく違うんだよ！」"},
{"id": 116, "speaker": 50, "form": "dlg", "jp": "「なんだ、アナタたちの言う人類っていうのは\n　『１人』だけでもいいのか？」"},
{"id": 117, "speaker": 50, "form": "dlg", "jp": "「それなら話は早いよ‥‥」"},
{"id": 118, "speaker": 31, "form": "dlg", "jp": "「どういう意味だ‥‥」"},
{"id": 119, "speaker": 50, "form": "dlg", "jp": "「ボクがその『１人』になってあげるよ‥‥」"},
{"id": 120, "speaker": 16, "form": "dlg", "jp": "「それ、本気で言ってるの？」"},
{"id": 121, "speaker": 50, "form": "dlg", "jp": "「もちろん本気だよ‥‥」"},
{"id": 122, "speaker": 51, "form": "dlg", "jp": "「はあ、ネボケてんの？」"},
{"id": 123, "speaker": 50, "form": "dlg", "jp": "「ネボケてなんかいないよ‥‥」"},
{"id": 124, "speaker": 50, "form": "dlg", "jp": "「『最後の人類』に相応しいのは\n　『最後まで死なない』ボクだろう？」"},
{"id": 125, "speaker": 31, "form": "dlg", "jp": "「ダメだコイツ‥‥」"},
{"id": 126, "speaker": 31, "form": "dlg", "jp": "「さっぱり、話が通じないぞ‥‥」"},
{"id": 127, "speaker": 50, "form": "dlg", "jp": "「アナタもそう思う？」"},
{"id": 128, "speaker": 50, "form": "dlg", "jp": "「ボクもアナタたちと話しているとそう思うよ‥‥」"},
{"id": 129, "speaker": 50, "form": "dlg", "jp": "「ということで、\n　これ以上話をするのはムダみたいだね‥‥」"},
{"id": 130, "speaker": 50, "form": "dlg", "jp": "「じゃあ、ボクは帰るよ！」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「待ってくれ！」"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "「もうちょっと話を聞いてくれないか‥‥」"},
{"id": 133, "speaker": 50, "form": "dlg", "jp": "「ムダだよ‥‥」"},
{"id": 134, "speaker": 29, "form": "dlg", "jp": "「ナゴム、ムダよ‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「ジーン‥‥」"},
{"id": 136, "speaker": 29, "form": "dlg", "jp": "「やっぱり、こうなる運命だったようね‥‥」"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "ジーンは拳銃を取り出し、\n出口の方に銃口を向けた。"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "「おどしじゃないわよ‥‥」"},
{"id": 139, "speaker": 29, "form": "dlg", "jp": "「もう一度、ちゃんと答えてくれる？」"},
{"id": 140, "speaker": 29, "form": "dlg", "jp": "「『ノア』を返してくれるのか？\n　それとも返さないのか？」"},
{"id": 141, "speaker": 50, "form": "dlg", "jp": "「何度も同じことを言わせないでくれるかな‥‥」"},
{"id": 142, "speaker": 50, "form": "dlg", "jp": "「返さないよ‥‥」"},
{"id": 143, "speaker": 50, "form": "dlg", "jp": "「バキューン！」"},
{"id": 144, "speaker": 50, "form": "dlg", "jp": "エイジが返事をした瞬間、\nジーンは引き金を引いた。"},
{"id": 145, "speaker": 50, "form": "dlg", "jp": "「くっ‥‥」"},
{"id": 146, "speaker": 50, "form": "dlg", "jp": "出口の腕からは血がしたたっている。"},
{"id": 147, "speaker": 50, "form": "dlg", "jp": "「本当に撃つとは‥‥」"},
{"id": 148, "speaker": 29, "form": "dlg", "jp": "「ワタシをナメないで‥‥」"},
{"id": 149, "speaker": 29, "form": "dlg", "jp": "「次は心臓よ‥‥」"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "「じゃあ、次で最後よ‥‥」"},
{"id": 151, "speaker": 29, "form": "dlg", "jp": "「返してもらえるかしら？」"},
{"id": 152, "speaker": 50, "form": "dlg", "jp": "「断わる！！」"},
{"id": 153, "speaker": 50, "form": "dlg", "jp": "「シュン！」"},
{"id": 154, "speaker": 50, "form": "dlg", "jp": "出口は『能力』を使い姿を消した。"},
{"id": 155, "speaker": 29, "form": "dlg", "jp": "「ムダよ！」"},
{"id": 156, "speaker": 29, "form": "dlg", "jp": "ジーンはまるで出口の姿が見えているかのように\n迷うことなく銃をかまえなおした。"},
{"id": 157, "speaker": 29, "form": "dlg", "jp": "そして‥‥"},
{"id": 158, "speaker": 29, "form": "dlg", "jp": "「バキューン！」"},
{"id": 159, "speaker": 50, "form": "dlg", "jp": "「ウワァッ！」"},
{"id": 160, "speaker": 50, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 161, "speaker": 50, "form": "dlg", "jp": "地面に何かが倒れるような音がひびき、\nそこに胸を打ち抜かれた出口の姿が現れた。"},
{"id": 162, "speaker": 31, "form": "dlg", "jp": "「殺したのか？」"},
{"id": 163, "speaker": 29, "form": "dlg", "jp": "「しょうがないでしょう‥‥」"},
{"id": 164, "speaker": 29, "form": "dlg", "jp": "「とにかく、『ノア』を探して！」"},
{"id": 165, "speaker": 29, "form": "dlg", "jp": "「きっと、この子が持ってるハズだから‥‥」"},
{"id": 166, "speaker": 29, "form": "dlg", "jp": "ボクたちはまっくらな地面に横たわっている\n出口から『ノア』を取りかえすことにした。"},
{"id": 167, "speaker": 29, "form": "dlg", "jp": "その時！"},
{"id": 168, "speaker": 29, "form": "dlg", "jp": "死んでいるハズの出口が素早く起き上がった。"},
{"id": 169, "speaker": 29, "form": "choice", "jp": "【ボクはとっさに目をかたくとじた】"},
{"id": 170, "speaker": 29, "form": "choice", "jp": "【ボクはとっさに体をかわした】"},
{"id": 171, "speaker": 29, "form": "choice", "jp": "【ボクはとっさに体をかたくした】"},
{"id": 172, "speaker": 29, "form": "dlg", "jp": "【ボクはとっさに目をかたくとじた】"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「ウッ！」"},
{"id": 174, "speaker": 29, "form": "dlg", "jp": "「ナゴムッ！」"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "目をあけると、出口の光線によって\n右手がうち抜かれていた。"},
{"id": 176, "speaker": 31, "form": "dlg", "jp": "「大丈夫か？」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「な、なんとか‥‥」"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "【ボクはとっさに体をかわした】"},
{"id": 179, "speaker": 29, "form": "dlg", "jp": "「ナゴムッ！」"},
{"id": 180, "speaker": 31, "form": "dlg", "jp": "「大丈夫か？」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「な、なんとか‥‥」"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "【ボクはとっさに体をかたくした】"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "しかし‥‥"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「ウワァ～～」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "出口の光線はかたくしたハズの\n右腕を貫通した。"},
{"id": 186, "speaker": 29, "form": "dlg", "jp": "「ナゴムッ！」"},
{"id": 187, "speaker": 31, "form": "dlg", "jp": "「大丈夫か！？」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「な、なんとか‥‥」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「ウワァ～～」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "不意をつかれたボクは右腕に\n出口の光線を浴びてしまった。"},
{"id": 191, "speaker": 29, "form": "dlg", "jp": "「ナゴムッ！」"},
{"id": 192, "speaker": 31, "form": "dlg", "jp": "「大丈夫か？」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「な、なんとか‥‥」"},
{"id": 194, "speaker": 50, "form": "dlg", "jp": "「さっきも、言っただろう？」"},
{"id": 195, "speaker": 50, "form": "dlg", "jp": "「『ノア』は渡さないって‥‥」"},
{"id": 196, "speaker": 31, "form": "dlg", "jp": "「コ、コイツ‥‥！？」"},
{"id": 197, "speaker": 51, "form": "dlg", "jp": "「ど、どういうこと！！」"},
{"id": 198, "speaker": 29, "form": "dlg", "jp": "「たしかに、『心臓』に命中したハズ‥‥」"},
{"id": 199, "speaker": 31, "form": "dlg", "jp": "「拳銃ぐらいじゃ、死なないってことなのか‥‥？」"},
{"id": 200, "speaker": 50, "form": "dlg", "jp": "「拳銃だけじゃないよ‥‥」"},
{"id": 201, "speaker": 50, "form": "dlg", "jp": "「あらゆる武器をもってしても、\n　ボクの命をうばうことは不可能だよ‥‥」"},
{"id": 202, "speaker": 16, "form": "dlg", "jp": "「ど、どういうこと！！」"},
{"id": 203, "speaker": 29, "form": "dlg", "jp": "「たしかに、『心臓』に命中したハズ‥‥」"},
{"id": 204, "speaker": 31, "form": "dlg", "jp": "「拳銃ぐらいじゃ、死なないってことなのか‥‥？」"},
{"id": 205, "speaker": 50, "form": "dlg", "jp": "「拳銃だけじゃないよ‥‥」"},
{"id": 206, "speaker": 50, "form": "dlg", "jp": "「あらゆる武器をもってしても、\n　ボクの命をうばうことは不可能だよ‥‥」"},
{"id": 207, "speaker": 50, "form": "dlg", "jp": "「さあ、どうする？」"},
{"id": 208, "speaker": 50, "form": "dlg", "jp": "「次の３つのうちから選ばせてあげるよ‥‥」"},
{"id": 209, "speaker": 50, "form": "dlg", "jp": "「１つ目は２度とボクに関わらない‥‥」"},
{"id": 210, "speaker": 50, "form": "dlg", "jp": "「２つ目はボクに関わるけど、ボクの家来になる‥‥」"},
{"id": 211, "speaker": 50, "form": "dlg", "jp": "「３つ目はボクに逆らって『死ぬ』‥‥」"},
{"id": 212, "speaker": 50, "form": "dlg", "jp": "「まず、常光寺くんから選ばせてあげるよ‥‥」"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "「な、何言ってるんだ‥‥」"},
{"id": 214, "speaker": 50, "form": "dlg", "jp": "「さあ、早く選びなよ‥‥」"},
{"id": 215, "speaker": 50, "form": "choice", "jp": "「わかった、キミにはもう関わらない‥‥」"},
{"id": 216, "speaker": 50, "form": "choice", "jp": "「わかった、家来になるよ‥‥」"},
{"id": 217, "speaker": 50, "form": "choice", "jp": "「わかった、コロシてくれよ‥‥」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「わかった、キミにはもう関わらない‥‥」"},
{"id": 219, "speaker": 51, "form": "dlg", "jp": "「ちょっと、何言ってんのよ！」"},
{"id": 220, "speaker": 16, "form": "dlg", "jp": "「ちょっと、何言ってるのよ！」"},
{"id": 221, "speaker": 29, "form": "dlg", "jp": "「ナゴム！」"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "「仕方ないよ‥‥」"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "「ボクたちにはもう選択肢はないんだ‥‥」"},
{"id": 224, "speaker": 50, "form": "dlg", "jp": "「やっぱり、ボクが見込んだ人物だね」"},
{"id": 225, "speaker": 29, "form": "dlg", "jp": "「でも『ノア』はどうするの！」"},
{"id": 226, "speaker": 29, "form": "dlg", "jp": "「もう、『ゲーマー』の攻撃は始まってるのよ！」"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「出口には関わらない‥‥」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「でも、『ノア』はあきらめないよ‥‥」"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "「たのむ、この通りだ！」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「『ノア』を返してくれ！」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「そうしたら、２度と出口には関わらないから‥‥」"},
{"id": 232, "speaker": 50, "form": "dlg", "jp": "「くだらない‥‥」"},
{"id": 233, "speaker": 50, "form": "dlg", "jp": "「そんな言葉遊びみたいなことはうんざりだ‥‥」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 235, "speaker": 50, "form": "dlg", "jp": "「ザンネンだよ‥‥」"},
{"id": 236, "speaker": 50, "form": "dlg", "jp": "「キミもここで死んでもらうことになるとは‥‥」"},
{"id": 237, "speaker": 50, "form": "dlg", "jp": "そういって、出口は大きく目を見開いた。"},
{"id": 238, "speaker": 50, "form": "dlg", "jp": "やられる！"},
{"id": 239, "speaker": 50, "form": "dlg", "jp": "ボクはとっさに身をかわした。"},
{"id": 240, "speaker": 50, "form": "dlg", "jp": "しかし、出口は正確にボクの胸に狙いを定めて来た。"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "「うわぁ～～！」"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "「わかった、家来になるよ‥‥」"},
{"id": 243, "speaker": 50, "form": "dlg", "jp": "「まさか、\n　キミの口からその言葉は聞けるとは‥‥」"},
{"id": 244, "speaker": 51, "form": "dlg", "jp": "「ちょっと、何言ってんのよ！」"},
{"id": 245, "speaker": 29, "form": "dlg", "jp": "「ナゴム！」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「仕方ないよ‥‥」"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "「ボクたちにはもう選択肢はないんだ‥‥」"},
{"id": 248, "speaker": 50, "form": "dlg", "jp": "「やっぱり、ボクが見込んだ人物だね」"},
{"id": 249, "speaker": 29, "form": "dlg", "jp": "「私たちを裏切るってことは\n　どうなるかわかってるでしょうね‥‥」"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "「そんなオドシはもう十分だよ‥‥」"},
{"id": 251, "speaker": 29, "form": "dlg", "jp": "「オドシじゃないわよ‥‥」"},
{"id": 252, "speaker": 29, "form": "dlg", "jp": "「バキューン！」"},
{"id": 253, "speaker": 29, "form": "dlg", "jp": "ジーンの手に握られていた拳銃が火をふいた。"},
{"id": 254, "speaker": 51, "form": "dlg", "jp": "「常光寺っ！」"},
{"id": 255, "speaker": null, "form": "dlg", "jp": "ボクの意識はこの瞬間に途切れた。"},
{"id": 256, "speaker": 16, "form": "dlg", "jp": "「ちょっと、何言ってるのよ！」"},
{"id": 257, "speaker": 29, "form": "dlg", "jp": "「ナゴム！」"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "「仕方ないよ‥‥」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「ボクたちにはもう選択肢はないんだ‥‥」"},
{"id": 260, "speaker": 50, "form": "dlg", "jp": "「やっぱり、ボクが見込んだ人物だね」"},
{"id": 261, "speaker": 29, "form": "dlg", "jp": "「私たちを裏切るってことは\n　どうなるかわかってるでしょうね‥‥」"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "「そんなオドシはもう十分だよ‥‥」"},
{"id": 263, "speaker": 29, "form": "dlg", "jp": "「オドシじゃないわよ‥‥」"},
{"id": 264, "speaker": 29, "form": "dlg", "jp": "「バキューン！」"},
{"id": 265, "speaker": 29, "form": "dlg", "jp": "ジーンの手に握られていた拳銃が火をふいた。"},
{"id": 266, "speaker": 16, "form": "dlg", "jp": "「常光寺くん！」"},
{"id": 267, "speaker": null, "form": "dlg", "jp": "ボクの意識はこの瞬間に途切れた。"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "「わかった、コロシてくれよ‥‥」"},
{"id": 269, "speaker": 50, "form": "dlg", "jp": "「選べないのかい？」"},
{"id": 270, "speaker": 2, "form": "dlg", "jp": "「あたりまえだろう！」"},
{"id": 271, "speaker": 50, "form": "dlg", "jp": "「ザンネンだよ‥‥」"},
{"id": 272, "speaker": 50, "form": "dlg", "jp": "「キミはもっとリコウなヤツだと思ってたのに‥‥」"},
{"id": 273, "speaker": 50, "form": "dlg", "jp": "「じゃあ、\n　キミも死んでもらうことにするよ‥‥」"},
{"id": 274, "speaker": 31, "form": "dlg", "jp": "「させるかぁ～～～～！」"},
{"id": 275, "speaker": 31, "form": "dlg", "jp": "ケネスは『サイコキネシス』で\n出口を吹き飛ばした。"},
{"id": 276, "speaker": 31, "form": "dlg", "jp": "「ドスーン‥‥」"},
{"id": 277, "speaker": 31, "form": "dlg", "jp": "出口は神社の木に頭から思いきりぶつかった。"},
{"id": 278, "speaker": 31, "form": "dlg", "jp": "出口の首がおかしな方向にグニャリと曲がった。"},
{"id": 279, "speaker": 51, "form": "dlg", "jp": "「ケネス、やりすぎや！」"},
{"id": 280, "speaker": 16, "form": "dlg", "jp": "「ケネス、やりすぎよ！」"},
{"id": 281, "speaker": 16, "form": "dlg", "jp": "しかし‥‥"},
{"id": 282, "speaker": 50, "form": "dlg", "jp": "「イタタタタ‥‥」"},
{"id": 283, "speaker": 50, "form": "dlg", "jp": "出口はすんなりと立ち上がった。"},
{"id": 284, "speaker": 50, "form": "dlg", "jp": "「カン違いしないでくれ！」"},
{"id": 285, "speaker": 50, "form": "dlg", "jp": "「たしかに\n　アナタたちには『死んでもらう』けど‥‥」"},
{"id": 286, "speaker": 50, "form": "dlg", "jp": "「ボクが手を下すことはしないよ‥‥」"},
{"id": 287, "speaker": 29, "form": "dlg", "jp": "「どういう意味？」"},
{"id": 288, "speaker": 50, "form": "dlg", "jp": "「ボクが何もしなくても、\n　キミたちは『ゲーマー』に殺されるんだろう？」"},
{"id": 289, "speaker": 31, "form": "dlg", "jp": "「なら、なんでさっきは‥‥」"},
{"id": 290, "speaker": 50, "form": "dlg", "jp": "「思い知ってもらうためだよ‥‥」"},
{"id": 291, "speaker": 50, "form": "dlg", "jp": "「でもアナタたちはわからないようだね‥‥」"},
{"id": 292, "speaker": 50, "form": "dlg", "jp": "「ボクに刃向かってもムダだと言うことが‥‥」"},
{"id": 293, "speaker": 50, "form": "choice", "jp": "「どうやら、そうみたいだね‥‥」"},
{"id": 294, "speaker": 50, "form": "choice", "jp": "「ムダかもしれないけど‥‥」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "「ムダかもしれないけど‥‥」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「あきらめるわけにはいかないんだ‥‥」"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "「たのむ、この通りだ！」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "「『ノア』を返してくれ！」"},
{"id": 299, "speaker": 50, "form": "dlg", "jp": "「ザンネンだよ‥‥」"},
{"id": 300, "speaker": 50, "form": "dlg", "jp": "「キミもここで死んでもらうことになるとは‥‥」"},
{"id": 301, "speaker": 50, "form": "dlg", "jp": "そういって、出口は大きく目を見開いた。"},
{"id": 302, "speaker": 50, "form": "dlg", "jp": "やられる！"},
{"id": 303, "speaker": 50, "form": "dlg", "jp": "ボクはとっさに身をかわした。"},
{"id": 304, "speaker": 50, "form": "dlg", "jp": "しかし、出口は正確にボクの胸に狙いを定めて来た。"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「うわぁ～～！」"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "「どうやら、そうみたいだね‥‥」"},
{"id": 307, "speaker": 31, "form": "dlg", "jp": "「何言い出すんだ！」"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "「ケネスも見ただろう？」"},
{"id": 309, "speaker": 2, "form": "dlg", "jp": "「出口にはボクたちの攻撃は通用しないんだよ」"},
{"id": 310, "speaker": 2, "form": "dlg", "jp": "「説得もダメ‥‥」"},
{"id": 311, "speaker": 2, "form": "dlg", "jp": "「力づくもダメ‥‥」"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "「今のボクたちにできることはないんだよ‥‥」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "「今日のところはひきさがった方が‥‥」"},
{"id": 314, "speaker": 29, "form": "dlg", "jp": "「ナゴムの言う通りよ‥‥」"},
{"id": 315, "speaker": 31, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 316, "speaker": 2, "form": "dlg", "jp": "「ということだよ、出口‥‥」"},
{"id": 317, "speaker": 2, "form": "dlg", "jp": "「ボクたちの負けだ‥‥」"},
{"id": 318, "speaker": 2, "form": "dlg", "jp": "「呼び出してわるかったな‥‥」"},
{"id": 319, "speaker": 50, "form": "dlg", "jp": "「やっとわかってもらえたんだね‥‥」"},
{"id": 320, "speaker": 50, "form": "dlg", "jp": "「これからは２度と呼び出さないでくれるかな？」"},
{"id": 321, "speaker": 2, "form": "dlg", "jp": "「それは約束できないけど‥‥」"},
{"id": 322, "speaker": 50, "form": "dlg", "jp": "「キミらしい発言だ‥‥」"},
{"id": 323, "speaker": 50, "form": "dlg", "jp": "「まあ、何度やっても同じことだけど‥‥」"},
{"id": 324, "speaker": 50, "form": "dlg", "jp": "「じゃあ、ボクはこれで帰らせてもらうよ‥‥」"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "出口は何もなかったように\n涼しい顔をして立ち去った。"},
{"id": 327, "speaker": 31, "form": "dlg", "jp": "「ちくしょうっ！」"},
{"id": 328, "speaker": 29, "form": "dlg", "jp": "「これでよかったのよ‥‥」"},
{"id": 329, "speaker": 29, "form": "dlg", "jp": "「今の私たちでは絶対どうしようもないんだから‥‥」"},
{"id": 330, "speaker": 31, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 331, "speaker": 31, "form": "dlg", "jp": "その日はそれでボクたちも解散した。"},
{"id": 332, "speaker": 31, "form": "dlg", "jp": "失敗の原因は弱気になったこと。\nもっと別の選択があったのでは？"},
{"id": 333, "speaker": 31, "form": "dlg", "jp": "何があっても仲間を裏切ってはいけない。\n常に『正義』の中に身をよせるべし。"},
{"id": 334, "speaker": 31, "form": "dlg", "jp": "敵の謎が解けないかぎり勝ち目はない。\nここは一旦、引き下がるベキだったのでは‥‥"}
]
