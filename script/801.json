[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／１１／ＰＭ０９：２０"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "（‥‥？？）"},
{"id": 2, "speaker": 2, "form": "dlg", "jp": "（窓が開いている？）"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "（なぜだ？）"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「シュンッ！」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "何かが風を切る音が聞こえた。"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "「コンバンハ‥‥」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「ジーン！！」"},
{"id": 8, "speaker": 31, "form": "dlg", "jp": "「オジャマしてるよ‥‥」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "「ケネス！！」"},
{"id": 10, "speaker": 31, "form": "dlg", "jp": "「キミのことが心配だから来たんだよ！」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「心配？」"},
{"id": 12, "speaker": 29, "form": "dlg", "jp": "「なんでもいいけど、声を出さないで！」"},
{"id": 13, "speaker": 29, "form": "dlg", "jp": "「家の人いるんでしょう？」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 15, "speaker": 29, "form": "dlg", "jp": "「今からは『テレパシー』で会話しましょう」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「で、何しに来たの？」"},
{"id": 18, "speaker": 29, "form": "dlg", "jp": "（だから！　『テレパシー』を使いなさい！）"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "（ゴメン‥‥）"},
{"id": 20, "speaker": 31, "form": "dlg", "jp": "（キミがそんな風に危なっかしいから、\n　わざわざ来てやったんだよ！）"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "（危なっかしい？）"},
{"id": 22, "speaker": 29, "form": "dlg", "jp": "（『真実』にたえられないんじゃないかと思ってね‥‥）"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "（『真実』にたえられない？）"},
{"id": 24, "speaker": 29, "form": "dlg", "jp": "（あの『バンパイア』みたいにね‥‥）"},
{"id": 25, "speaker": 29, "form": "dlg", "jp": "（人間は相反する２つの感情を認知しづらいの‥‥）"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "（‥‥‥？）"},
{"id": 27, "speaker": 31, "form": "dlg", "jp": "（『認知的共和』だな‥‥）"},
{"id": 28, "speaker": 29, "form": "dlg", "jp": "（心理学用語よ‥‥）"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "（‥‥‥？）"},
{"id": 30, "speaker": 31, "form": "dlg", "jp": "（例えば、キミが『タバコを吸う女性』がキライで、\n　ある『女性アイドル』のことが好きだとする）"},
{"id": 31, "speaker": 31, "form": "dlg", "jp": "（でもって、その『女性アイドル』が\n　『タバコを吸う』とする）"},
{"id": 32, "speaker": 31, "form": "dlg", "jp": "（とたん、キミの脳はパニックになり‥‥）"},
{"id": 33, "speaker": 31, "form": "dlg", "jp": "（その『女性アイドル』のことがキライになったり、\n　『タバコを吸う女性』を認めたりし始めるだろう？）"},
{"id": 34, "speaker": 31, "form": "dlg", "jp": "（そういうことさ‥‥）"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "（せっかくの例えだけど、何を言いたいのか‥‥？）"},
{"id": 36, "speaker": 29, "form": "dlg", "jp": "（パニックになると間違った答えを出すってことよ！）"},
{"id": 37, "speaker": 29, "form": "dlg", "jp": "（さっきの例だとその中でのキミの頭の中での正解は）"},
{"id": 38, "speaker": 29, "form": "dlg", "jp": "（『タバコを吸う女性』がキライで\n　『女性アイドル』がスキってことなのに‥‥）"},
{"id": 39, "speaker": 29, "form": "dlg", "jp": "（２つの異なる条件が合わさったことで、\n　頭の中の考えがパニックで変わってしまう）"},
{"id": 40, "speaker": 29, "form": "dlg", "jp": "（つまり、今日のことでアナタがパニックになって\n　おかしな行動をしないか心配してやって来たのよ！）"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "（おかしな考え？）"},
{"id": 42, "speaker": 31, "form": "dlg", "jp": "（あんなスゴイ能力を手に入れたことに\n　間違った『意味付け』をしないかと心配してんだよ）"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "（『意味付け』‥‥）"},
{"id": 44, "speaker": 29, "form": "dlg", "jp": "（人間は『意味』を求める生き物なの）"},
{"id": 45, "speaker": 29, "form": "dlg", "jp": "（風景写真に『顔みたいなカゲ』が写ってたら、\n　『死んだ人』の霊だと思い込んだり）"},
{"id": 46, "speaker": 29, "form": "dlg", "jp": "（まん中に梅干しをおいた弁当を\n　国旗だと思ったり‥‥）"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "（『意味』を求めちゃいけないの？）"},
{"id": 48, "speaker": 29, "form": "dlg", "jp": "（そうじゃないわ！）"},
{"id": 49, "speaker": 29, "form": "dlg", "jp": "（勝手に『間違った意味』を付けることが危険なのよ！）"},
{"id": 50, "speaker": 29, "form": "dlg", "jp": "（風景写真に写った『顔みたいなカゲ』は『陰』だし）"},
{"id": 51, "speaker": 29, "form": "dlg", "jp": "（まん中に梅干しを置くのはゴハンに\n　その味をしみ込ませるタメ‥‥）"},
{"id": 52, "speaker": 29, "form": "dlg", "jp": "（本当の意味はそういうものなの‥‥）"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "（それがボクの『能力』とどう関係あるの？）"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "（『能力』を間違った使い方しないで欲しいってこと）"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "（はぁ‥‥）"},
{"id": 56, "speaker": 29, "form": "dlg", "jp": "（あの『バンパイア』は自分の回復する能力に）"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "（『自分はバンパイアだ』という\n　間違った意味付けをしてしまった‥‥）"},
{"id": 58, "speaker": 29, "form": "dlg", "jp": "（まあ、彼はマシな方だったけど‥‥）"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "（マシ？）"},
{"id": 60, "speaker": 31, "form": "dlg", "jp": "（そうだな‥‥）"},
{"id": 61, "speaker": 31, "form": "dlg", "jp": "（もっとひどいヤツは『神』に選ばれた人間だと\n　思い込んで『能力』を悪用するからな‥‥）"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "（『悪用』？）"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "（『バンパイア』の場合、\n　単に精神を能力がおかしただけ‥‥）"},
{"id": 64, "speaker": 29, "form": "dlg", "jp": "（でも中にはそうじゃなく『悪用』する人間も‥‥）"},
{"id": 65, "speaker": 31, "form": "dlg", "jp": "（例えばキミの『能力』で『透明人間』になって\n　女風呂をのぞくとかだ！）"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "（そんなコトできるの？）"},
{"id": 67, "speaker": 31, "form": "dlg", "jp": "（キミが『透明な体』をイメージできたらな‥‥）"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "（まあ、本当にそんなことをしたら間違いなく\n　『Ｅ－ｇｒｏ』のメンバーに暗殺されるけど‥‥）"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "（『暗殺』！！）"},
{"id": 70, "speaker": 29, "form": "dlg", "jp": "（世間に『超能力者』が危険な存在だと思われて\n　一番困るのは『Ｅ－ｇｒｏ』だから‥‥）"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "（言っておくけど、『Ｅ－ｇｒｏ』は決して\n　『超能力者』のサークルじゃないから‥‥）"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "（ちゃんと『目的をもった集団』なの）"},
{"id": 73, "speaker": 31, "form": "dlg", "jp": "（だから目的の為なら暗殺ぐらいは‥‥）"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "（暗殺ぐらいって‥‥）"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "（それって『犯罪』だろう！？）"},
{"id": 76, "speaker": 31, "form": "dlg", "jp": "（言っておくが、『のぞき』も犯罪だぜ‥‥）"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "（それに『殺人』がすべて犯罪ではないわ‥‥）"},
{"id": 78, "speaker": 31, "form": "dlg", "jp": "（戦争で兵士が兵士を殺すのは殺人じゃないだろう？）"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "（私たちは『兵士』なの‥‥）"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "（でも、ボクは‥‥）"},
{"id": 81, "speaker": 29, "form": "dlg", "jp": "（アナタも『兵士』よ！）"},
{"id": 82, "speaker": 29, "form": "dlg", "jp": "（言ったでしょう、『私たち』って‥‥）"},
{"id": 83, "speaker": 31, "form": "dlg", "jp": "（オレたちの『能力』は\n　『戦うため』の『能力』なんだ‥‥）"},
{"id": 84, "speaker": 31, "form": "dlg", "jp": "（『戦うための能力』を持っている以上、\n　『兵士』なんだよ‥‥）"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "（でも、ボクは戦うつもりは‥‥）"},
{"id": 86, "speaker": 31, "form": "dlg", "jp": "（日本人らしい、意見だな‥‥）"},
{"id": 87, "speaker": 31, "form": "dlg", "jp": "（じゃあ、『戦う力』を持った『自衛隊』が\n　戦争で殺されたら『民間人』が死んだことになるのか？）"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "（キミがどう思おうと、キミが『能力者』であるかぎり\n　キミは『兵士』なのよ！）"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "（『兵士』が『民間人』にその『力』を行使するのなら\n　さばかれるのは当たり前でしょう？）"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "（じゃぁ、ボクのこの『能力』の意味は‥‥）"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "（『戦うための力』だと思ってくれればいいわ‥‥）"},
{"id": 92, "speaker": 29, "form": "dlg", "jp": "（『クリエーター』と‥‥）"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "（だから、その『クリエーター』っていったい？）"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "（長い話だけど大丈夫？？）"},
{"id": 95, "speaker": 29, "form": "choice", "jp": "（ああ、わかった！）"},
{"id": 96, "speaker": 29, "form": "choice", "jp": "（手短にお願いします）"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "（手短にお願いします）"},
{"id": 98, "speaker": 29, "form": "dlg", "jp": "（わかったわ‥‥）"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "（じゃあ、簡単に説明するから‥‥）"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "説明によると、人類は"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "『クリエーター』"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "と\n呼ばれている存在に造られたものらしい‥‥"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "『クリエーター』は人類の進化を見張っているらしく、\n人類が思うように進化しなかった場合絶滅させるというのだ。"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "人類はまだ、一度も『クリエーター』の思い通りに\n『進化』をしたことがないらしく、"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "すでに『クリエーター』によって\n何度となく滅ぼされているという。"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "『クリエーター』は人類が思い通りの進化をするまで、\n創造と破壊をくり返してており、"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "今の人類は何代目かの地球人類ということらしい。"},
{"id": 108, "speaker": 29, "form": "dlg", "jp": "『アトランティス』や『ムー』の水没なども\nすべて『クリエーター』の仕業だと‥‥"},
{"id": 109, "speaker": 29, "form": "dlg", "jp": "つまり、『クリエーター』は何千年、何万年という単位で\n人類を襲う次元の違う『敵』なんだという。"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "（どう？\n　わかってくれた？）"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "（なんとなくだけど‥‥）"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "（ただ‥‥）"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "（何よ？）"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "（そんな何万年単位のことを\n　どうしてキミたちが知ってるんだ？）"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "（ああ、わかった！）"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "（まず、わかって欲しいのは‥‥）"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "（私たち人類は『クリエーター』が造ったものなの‥‥）"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "（さっき聞いたよ‥‥）"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "（そのことは理解してくれるのね？）"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "（納得できないけど‥‥）"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "（もし、その話が本当だったとしたら、\n　いったい何のために？）"},
{"id": 122, "speaker": 29, "form": "dlg", "jp": "（わからないわ‥‥）"},
{"id": 123, "speaker": 29, "form": "choice", "jp": "（わからない？）"},
{"id": 124, "speaker": 29, "form": "choice", "jp": "（その話本当なの？）"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "（その話本当なの？）"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "（たぶんね‥‥）"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "（たぶん？）"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "（わからない？）"},
{"id": 129, "speaker": 29, "form": "dlg", "jp": "（そう‥‥）"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "（『クリエーター』の行動はスケールが大きすぎて\n　私たちには把握しきれないのよ！）"},
{"id": 131, "speaker": 31, "form": "dlg", "jp": "（産まれたての赤ん坊が自分の側にいる親を\n　本当の親かどうかは見抜けないだろう？）"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "（そんなあいまいな話なの？）"},
{"id": 133, "speaker": 29, "form": "dlg", "jp": "（あいまいじゃないの！）"},
{"id": 134, "speaker": 29, "form": "dlg", "jp": "（ハッキリとした『真実』なの！）"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "（でも‥‥）"},
{"id": 136, "speaker": 31, "form": "dlg", "jp": "（だから、スケールの問題なんだって‥‥）"},
{"id": 137, "speaker": 31, "form": "dlg", "jp": "（『宇宙』は『有限』なのは『真実』なんだけど\n　その『真実』をつかみきれないだろう？）"},
{"id": 138, "speaker": 31, "form": "dlg", "jp": "（それと同じだよ‥‥）"},
{"id": 139, "speaker": 31, "form": "dlg", "jp": "（とにかく、\n　『クリエーター』はオレたちの進化を見張っている）"},
{"id": 140, "speaker": 31, "form": "dlg", "jp": "（そして、思い通りに進化しなかった時は\n　『絶滅』させるってことだ‥‥）"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "（で、私たち人類は一度も\n　思い通りに進化しなかった‥‥）"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "（ちょっと待って！）"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "（一度もって‥‥）"},
{"id": 144, "speaker": 31, "form": "dlg", "jp": "（すでに何回か全滅させられてるんだよ‥‥）"},
{"id": 145, "speaker": 29, "form": "dlg", "jp": "（『アトランティス』とか『ムー』とか、\n　失われた文明の話を聞いたことがあるでしょう？）"},
{"id": 146, "speaker": 29, "form": "dlg", "jp": "（あれもすべて、『クリエーター』の仕業よ‥‥）"},
{"id": 147, "speaker": 31, "form": "dlg", "jp": "（つまり、『クリエーター』は何千年、何万年という単位で\n　人類を襲う次元の違う『敵』ってことだ‥‥）"},
{"id": 148, "speaker": 31, "form": "dlg", "jp": "ぜんぜん話が見えてこない‥‥"},
{"id": 149, "speaker": 31, "form": "choice", "jp": "【少し、ツッコんでみるか】"},
{"id": 150, "speaker": 31, "form": "choice", "jp": "【もう少し話を聞いてみよう】"},
{"id": 151, "speaker": 31, "form": "dlg", "jp": "【少し、ツッコんでみるか】"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "（その話には『ムジュン』があるだろう）"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "（『人類滅亡』を『した』のなら、\n　ボクたちはここにいないはずだろう？）"},
{"id": 154, "speaker": 31, "form": "dlg", "jp": "（その通りだな‥‥）"},
{"id": 155, "speaker": 31, "form": "dlg", "jp": "（だから‥‥）"},
{"id": 156, "speaker": 31, "form": "dlg", "jp": "（オレたちは何代目かの地球人類ということになるな‥‥）"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "（何代目か？）"},
{"id": 158, "speaker": 31, "form": "dlg", "jp": "（そうだ‥‥）"},
{"id": 159, "speaker": 31, "form": "dlg", "jp": "【もう少し話を聞いてみよう】"},
{"id": 160, "speaker": 31, "form": "dlg", "jp": "（人類はすでに何度か滅ぼされている‥‥）"},
{"id": 161, "speaker": 31, "form": "dlg", "jp": "（つまり‥‥）"},
{"id": 162, "speaker": 31, "form": "dlg", "jp": "（オレたちは何代目かの地球人類ということになるな‥‥）"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "（何代目か？）"},
{"id": 164, "speaker": 31, "form": "dlg", "jp": "（そうだ‥‥）"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "（じゃあ、ボクたち以外にも人類がいたの？）"},
{"id": 166, "speaker": 29, "form": "dlg", "jp": "（いたでしょうね‥‥）"},
{"id": 167, "speaker": 29, "form": "dlg", "jp": "（数千年とか数万年前には‥‥）"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "（はぁ？）"},
{"id": 169, "speaker": 2, "form": "choice", "jp": "（どうしてキミたちは知ってるの？）"},
{"id": 170, "speaker": 2, "form": "choice", "jp": "（それなら、ソイツももう死んでるんじゃぁ？）"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "（それなら、ソイツももう死んでるんじゃぁ？）"},
{"id": 172, "speaker": 31, "form": "dlg", "jp": "（死んでないんだ‥‥）"},
{"id": 173, "speaker": 31, "form": "dlg", "jp": "（人間じゃないから‥‥）"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "（人間じゃないにしても、\n　そんなに長生きできないだろう？）"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "（『クリエーター』は\n　私たちとは違う時間に生きているの‥‥）"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "（どうしてキミたちは知ってるの？）"},
{"id": 177, "speaker": 29, "form": "dlg", "jp": "（『百聞は一見にしかず』よ！）"},
{"id": 178, "speaker": 29, "form": "dlg", "jp": "（『映像』が残ってるの‥‥）"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "（『映像』？）"},
{"id": 180, "speaker": 29, "form": "dlg", "jp": "（『アカシックレコード』が‥‥）"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "（『アカシックレコード』‥‥）"},
{"id": 182, "speaker": 2, "form": "choice", "jp": "（何それ？）"},
{"id": 183, "speaker": 2, "form": "choice", "jp": "（知ってるよそれ！）"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "（知ってるよそれ！）"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "（よく、ＳＦなんかで出てくる、\n　未来の出来事がすべて記されてるってヤツだろう？）"},
{"id": 186, "speaker": 29, "form": "dlg", "jp": "（それは作り話の中の話ね‥‥）"},
{"id": 187, "speaker": 29, "form": "dlg", "jp": "（本物は本部にある過去の出来事が記録された\n　『不思議な石』よ‥‥）"},
{"id": 188, "speaker": 29, "form": "dlg", "jp": "（『アカシックレコード』には過去の\n　『クリエーター』の仕打ちが全て記録されているの）"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "（何それ？）"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "（私たちの本部にある過去の出来事が記録された\n　『不思議な石』よ‥‥）"},
{"id": 191, "speaker": 29, "form": "dlg", "jp": "（『アカシックレコード』には過去の\n　『クリエーター』の仕打ちが全て記録されているの）"},
{"id": 192, "speaker": 2, "form": "dlg", "jp": "（それってつまり‥‥）"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "（『人類誕生以前の記録』ってことだろう？）"},
{"id": 194, "speaker": 31, "form": "dlg", "jp": "（正確には『現人類誕生以前の記録』ってことだが‥‥）"},
{"id": 195, "speaker": 2, "form": "dlg", "jp": "（どうしてそんなものが？）"},
{"id": 196, "speaker": 29, "form": "dlg", "jp": "（わからないわ‥‥）"},
{"id": 197, "speaker": 29, "form": "dlg", "jp": "（もしかしたら‥‥）"},
{"id": 198, "speaker": 29, "form": "dlg", "jp": "（『戒め（イマシメ）』かも‥‥）"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "（『戒め（イマシメ）』？）"},
{"id": 200, "speaker": 31, "form": "dlg", "jp": "（人類が間違った進化をしないように\n　クリエーターが設置したのかもしれないってことだよ）"},
{"id": 201, "speaker": 31, "form": "choice", "jp": "（でも、必ず滅ぼされるってワケじゃないよね？）"},
{"id": 202, "speaker": 31, "form": "choice", "jp": "（前の人類はどうなったの？）"},
{"id": 203, "speaker": 31, "form": "choice", "jp": "（なぜ、本部に『アカシックレコード』が？）"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "（前の人類はどうなったの？）"},
{"id": 205, "speaker": 31, "form": "dlg", "jp": "（『絶滅』だな‥‥）"},
{"id": 206, "speaker": 2, "form": "dlg", "jp": "（ちょっと待ってよ、\n　『絶滅』したらボクたちは存在しないハズじゃあ？）"},
{"id": 207, "speaker": 31, "form": "dlg", "jp": "（関係ないよ、\n　クリエーターは０から人類を造り直すから‥‥）"},
{"id": 208, "speaker": 2, "form": "dlg", "jp": "（でも、ボクたちの前に人類がいたのなら\n　その証拠とかあるんじゃないの？）"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "（『遺跡（イセキ）』とか『化石』とか‥‥）"},
{"id": 210, "speaker": 29, "form": "dlg", "jp": "（そんなものはなんの意味もないの‥‥）"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "（意味がない？）"},
{"id": 212, "speaker": 29, "form": "dlg", "jp": "（そう‥‥）"},
{"id": 213, "speaker": 29, "form": "dlg", "jp": "（なぜなら、クリエーターは『遺跡』や『化石』も\n　造りだせるから‥‥）"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "（はあ？）"},
{"id": 215, "speaker": 31, "form": "dlg", "jp": "（人類誕生からの８００万年の歴史すら\n　あやしいんだよ‥‥）"},
{"id": 216, "speaker": 29, "form": "dlg", "jp": "（もし、クリエーターが８００万年の歴史ごと\n　人類を誕生させたのだとしたら）"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "（人類は昨日産まれたばかりかもしれないの‥‥）"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "（何それ？）"},
{"id": 219, "speaker": 31, "form": "dlg", "jp": "（つまり、昨日までの記憶といっしょに\n　今日ナゴムが誕生しても）"},
{"id": 220, "speaker": 31, "form": "dlg", "jp": "（ナゴムは自分が今日産まれたばかりだとは\n　気付かないってことだよ！）"},
{"id": 221, "speaker": 29, "form": "dlg", "jp": "（まあ、昨日今日ってことはないでしょうけど）"},
{"id": 222, "speaker": 29, "form": "dlg", "jp": "（人類の過去ってそれぐらい、\n　あやしいものなの‥‥）"},
{"id": 223, "speaker": 29, "form": "dlg", "jp": "（とりあえず信じられるのは今、この瞬間だけなの‥‥）"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "（じゃあ、前の人類の情報って結局\n　『アカシックレコード』の情報だけなの？）"},
{"id": 225, "speaker": 29, "form": "dlg", "jp": "（まあ、そうね‥‥）"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "（でも、必ず滅ぼされるってワケじゃないよね？）"},
{"id": 227, "speaker": 31, "form": "dlg", "jp": "（当たり前だろう？）"},
{"id": 228, "speaker": 31, "form": "dlg", "jp": "（そのために戦おうって話をしてるんだから‥‥）"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "（そうじゃなくって‥‥）"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "（クリエーターの気に入った進化をしていれば\n　問題はないんだろう？）"},
{"id": 231, "speaker": 29, "form": "dlg", "jp": "（たしかにね‥‥）"},
{"id": 232, "speaker": 29, "form": "dlg", "jp": "（でも、\n　すでにクリエーターは気に入らないみたいよ‥‥）"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "（はぁ？）"},
{"id": 234, "speaker": 29, "form": "dlg", "jp": "（少しずつだけど、\n　クリエーターの破壊活動が始まってるの‥‥）"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "（ウソ！！）"},
{"id": 236, "speaker": 29, "form": "dlg", "jp": "（本当よ‥‥）"},
{"id": 237, "speaker": 31, "form": "dlg", "jp": "（それに、今の人間をみて\n　クリエーターが満足すると思うか？）"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥）"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "（なぜ、本部に『アカシックレコード』が？）"},
{"id": 240, "speaker": 29, "form": "dlg", "jp": "（本部に『アカシックレコード』というよりは‥‥）"},
{"id": 241, "speaker": 29, "form": "dlg", "jp": "（『アカシックレコード』のあった場所に\n　本部を造ったっていう方が正しいかも‥‥）"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "（で、本部ってどこにあるの？）"},
{"id": 243, "speaker": 29, "form": "dlg", "jp": "（夕方にも言ったじゃない！）"},
{"id": 244, "speaker": 29, "form": "dlg", "jp": "（『ペルー』よ‥‥）"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "（また、『ペルー』‥‥？）"},
{"id": 246, "speaker": 31, "form": "dlg", "jp": "（そういえば、こないだまで『ペルー』にいたんだな？）"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "（なぜ、そんなことを？）"},
{"id": 248, "speaker": 31, "form": "dlg", "jp": "（調べさせてもらったんだよ‥‥）"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "（それでボクの名前を？）"},
{"id": 250, "speaker": 29, "form": "dlg", "jp": "（それはまた別の理由よ‥‥）"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "（別の理由？）"},
{"id": 252, "speaker": 29, "form": "dlg", "jp": "（死んだアナタの『お母さん』が\n　私たちの仲間だったからよ‥‥）"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "（『母さん』が！？）"},
{"id": 254, "speaker": 2, "form": "dlg", "jp": "（ってことは‥‥）"},
{"id": 255, "speaker": 31, "form": "dlg", "jp": "（『能力者』だったんだよ‥‥）"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "（そんな話聞いたことなかったよ！）"},
{"id": 257, "speaker": 31, "form": "dlg", "jp": "（当たり前だろう？）"},
{"id": 258, "speaker": 31, "form": "dlg", "jp": "（誰にも知られちゃいけないっていう決まりだからな‥‥）"},
{"id": 259, "speaker": 31, "form": "choice", "jp": "（でも、必ず滅ぼされるってワケじゃないよね？）"},
{"id": 260, "speaker": 31, "form": "choice", "jp": "（前の人類はどうなったの？）"},
{"id": 261, "speaker": 31, "form": "choice", "jp": "（でも、必ず滅ぼされるってワケじゃないよね？）"},
{"id": 262, "speaker": 31, "form": "choice", "jp": "（なぜ、本部に『アカシックレコード』が？）"},
{"id": 263, "speaker": 31, "form": "choice", "jp": "（前の人類はどうなったの？）"},
{"id": 264, "speaker": 31, "form": "choice", "jp": "（なぜ、本部に『アカシックレコード』が？）"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "（でも、そんな『神様』みたいなヤツと\n　戦って勝ち目はあるの？）"},
{"id": 266, "speaker": 29, "form": "dlg", "jp": "（だから、『神』でもなんでもないわよ！）"},
{"id": 267, "speaker": 31, "form": "dlg", "jp": "（軽々しく『神』の名前を口にするのが\n　日本人の悪いところだ‥‥）"},
{"id": 268, "speaker": 29, "form": "dlg", "jp": "（とにかく、『勝ち目』があるかないかは\n　まったくわからないわ）"},
{"id": 269, "speaker": 29, "form": "dlg", "jp": "（ただ、あきらめるワケにはいかないでしょう？）"},
{"id": 270, "speaker": 2, "form": "dlg", "jp": "（そうだけど‥‥）"},
{"id": 271, "speaker": 31, "form": "dlg", "jp": "（あと、『勝ち目』とは言わないけど\n　戦ってみる価値はありそうなんだよ‥‥）"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "（どういうこと？）"},
{"id": 273, "speaker": 31, "form": "dlg", "jp": "（どうやら、『クリエーター』のヤロウは）"},
{"id": 274, "speaker": 31, "form": "dlg", "jp": "（造るのは得意だけど、\n　壊すのはニガテみたいなんだよ‥‥）"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "（壊すのはニガテ？）"},
{"id": 276, "speaker": 31, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 277, "speaker": 31, "form": "dlg", "jp": "（実際、『アカシックレコード』の記録の中でも\n　クリエーター自身が手をくだしたり）"},
{"id": 278, "speaker": 31, "form": "dlg", "jp": "（一瞬で人類を絶滅させたような記録はないんだ）"},
{"id": 279, "speaker": 31, "form": "dlg", "jp": "（オカシイだろう？）"},
{"id": 280, "speaker": 31, "form": "dlg", "jp": "（『絶滅』させちゃうぐらいだから‥‥）"},
{"id": 281, "speaker": 31, "form": "dlg", "jp": "（遊びやゲーム感覚で人類を攻撃してるわけじゃないんだよ）"},
{"id": 282, "speaker": 29, "form": "dlg", "jp": "（つまり、いきなり『絶滅』させるような力は\n　持っていないということなの‥‥）"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "（じゃあ、今まではどんな攻撃を‥‥）"},
{"id": 284, "speaker": 31, "form": "dlg", "jp": "（操るんだよ‥‥）"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "（『操る』？）"},
{"id": 286, "speaker": 29, "form": "dlg", "jp": "（そう、世界にあるものすべてを‥‥）"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "（世界にあるものすべて！？）"},
{"id": 288, "speaker": 29, "form": "dlg", "jp": "（人間以外の動くものすべてよ‥‥）"},
{"id": 289, "speaker": 29, "form": "dlg", "jp": "（例えば、\n　地震や洪水みたいな自然現象を操ることだって‥‥）"},
{"id": 290, "speaker": 29, "form": "dlg", "jp": "（実際、そうした自然現象を使って\n　人類を滅ぼしたみたいね‥‥）"},
{"id": 291, "speaker": 31, "form": "dlg", "jp": "（もちろん、\n　今なら『核兵器』なんかを操るんだろうけどな‥‥）"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "（やっぱり勝ち目はないんじゃぁ？）"},
{"id": 293, "speaker": 29, "form": "dlg", "jp": "（ただ、人間だけはあやつれない‥‥）"},
{"id": 294, "speaker": 31, "form": "dlg", "jp": "（つまり、人間なら戦える可能性があるんだよ‥‥）"},
{"id": 295, "speaker": 31, "form": "choice", "jp": "（すでに攻撃が始まってるんだよね？）"},
{"id": 296, "speaker": 31, "form": "choice", "jp": "（どうして人間はあやつれないの？）"},
{"id": 297, "speaker": 31, "form": "choice", "jp": "（２人ともコワくないの？）"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "（すでに攻撃が始まってるんだよね？）"},
{"id": 299, "speaker": 29, "form": "dlg", "jp": "（そうよ‥‥）"},
{"id": 300, "speaker": 29, "form": "dlg", "jp": "（最近、よく機械が暴走する事件があるでしょう？）"},
{"id": 301, "speaker": 29, "form": "dlg", "jp": "（アレは『クリエーター』が操ってるからだと思うの‥‥）"},
{"id": 302, "speaker": 2, "form": "dlg", "jp": "（それはないだろう？）"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "（だって、相手は『天変地異』とかも\n　操れるんだろう？）"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "（それなのに、どうしてそんな小さな攻撃を？）"},
{"id": 305, "speaker": 31, "form": "dlg", "jp": "（『警告』かもしれないな‥‥）"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "（『警告』？）"},
{"id": 307, "speaker": 31, "form": "dlg", "jp": "（『アカシックレコード』もそうだけど、\n　いきなり絶滅させるつもりはないのかもな‥‥）"},
{"id": 308, "speaker": 29, "form": "dlg", "jp": "（あと考えられるのはまだ十分な力が\n　貯えられていない‥‥）"},
{"id": 309, "speaker": 31, "form": "dlg", "jp": "（うん、それも十分に考えられるな‥‥）"},
{"id": 310, "speaker": 2, "form": "dlg", "jp": "（それって、ムリやりっぽく聞こえるんだけど‥‥）"},
{"id": 311, "speaker": 2, "form": "dlg", "jp": "（だいたい、機械の暴走が\n　クリエーターの仕業っていう証拠は？）"},
{"id": 312, "speaker": 29, "form": "dlg", "jp": "（感じるのよ‥‥）"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "（感じる？）"},
{"id": 314, "speaker": 29, "form": "dlg", "jp": "（私の『能力』よ‥‥）"},
{"id": 315, "speaker": 29, "form": "dlg", "jp": "（機械が暴走する時、\n　『邪悪な感覚』を感じるの‥‥）"},
{"id": 316, "speaker": 2, "form": "dlg", "jp": "（そ、そう‥）"},
{"id": 317, "speaker": 2, "form": "dlg", "jp": "（どうして人間はあやつれないの？）"},
{"id": 318, "speaker": 29, "form": "dlg", "jp": "（それはわからないわ‥‥）"},
{"id": 319, "speaker": 31, "form": "dlg", "jp": "（案外、クリエーターが人類を気に入らないのは\n　操れないからかもしれないな‥‥）"},
{"id": 320, "speaker": 2, "form": "dlg", "jp": "（２人ともコワくないの？）"},
{"id": 321, "speaker": 29, "form": "dlg", "jp": "（コワイわよ‥‥）"},
{"id": 322, "speaker": 31, "form": "dlg", "jp": "（コワイから戦うんじゃないか！）"},
{"id": 323, "speaker": 29, "form": "dlg", "jp": "（そうよ‥‥）"},
{"id": 324, "speaker": 29, "form": "dlg", "jp": "（私たちは戦えるからまだマシよ‥‥）"},
{"id": 325, "speaker": 29, "form": "dlg", "jp": "（みんなは一方的に殺されてしまうのよ‥‥）"},
{"id": 326, "speaker": 29, "form": "dlg", "jp": "（その方がよっぽどコワイでしょう？）"},
{"id": 327, "speaker": 29, "form": "choice", "jp": "（どうして人間はあやつれないの？）"},
{"id": 328, "speaker": 29, "form": "choice", "jp": "（２人ともコワくないの？）"},
{"id": 329, "speaker": 29, "form": "choice", "jp": "（すでに攻撃が始まってるんだよね？）"},
{"id": 330, "speaker": 29, "form": "choice", "jp": "（どうして人間はあやつれないの？）"},
{"id": 331, "speaker": 29, "form": "choice", "jp": "（すでに攻撃が始まってるんだよね？）"},
{"id": 332, "speaker": 29, "form": "choice", "jp": "（２人ともコワくないの？）"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "（ジーンたちはスゴイんだね‥‥）"},
{"id": 334, "speaker": 31, "form": "dlg", "jp": "（違うよ！）"},
{"id": 335, "speaker": 31, "form": "dlg", "jp": "（オレたちだけじゃなく、オマエもだ‥‥）"},
{"id": 336, "speaker": 2, "form": "dlg", "jp": "（でも、そんなヤツ相手にボクらだけで‥‥）"},
{"id": 337, "speaker": 29, "form": "dlg", "jp": "（私たちじゃないと戦えないのよ！）"},
{"id": 338, "speaker": 29, "form": "dlg", "jp": "（ヤツには『人間以外をコントロールできる』から、\n　一切『武器』は通用しないの）"},
{"id": 339, "speaker": 29, "form": "dlg", "jp": "（つまり、ヤツと戦えるのは人間でありながら\n　『戦闘能力』をもった私たちだけなの‥‥）"},
{"id": 340, "speaker": 31, "form": "dlg", "jp": "（強いモノが弱いモノを守ってやらなければいけない\n　ってのは理解できるだろう？）"},
{"id": 341, "speaker": 31, "form": "dlg", "jp": "（それだけのことだよ‥‥）"},
{"id": 342, "speaker": 2, "form": "dlg", "jp": "（それだけのことって‥‥）"},
{"id": 343, "speaker": 29, "form": "dlg", "jp": "（ザンネンだけど、私たちにも戦って勝てる相手か\n　どうかなんてわかってないの‥‥）"},
{"id": 344, "speaker": 29, "form": "dlg", "jp": "（でも、確実に言えることは、\n　戦わなきゃ『みんな死んじゃう』ってこと‥‥）"},
{"id": 345, "speaker": 2, "form": "dlg", "jp": "（『みんな死んじゃう』‥‥）"},
{"id": 346, "speaker": 31, "form": "dlg", "jp": "（１００％死ぬ方を選ぶのか、\n　生き残れる可能性のある方を選ぶのか？）"},
{"id": 347, "speaker": 31, "form": "dlg", "jp": "（キミならどっちを選ぶ）"},
{"id": 348, "speaker": 31, "form": "dlg", "jp": "（簡単な答えだよな‥‥）"},
{"id": 349, "speaker": 31, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 350, "speaker": 31, "form": "choice", "jp": "【生き残れる可能性のある方】"},
{"id": 351, "speaker": 31, "form": "choice", "jp": "【生き残れる可能性のある方】"},
{"id": 352, "speaker": 31, "form": "choice", "jp": "【生き残れる可能性のある方】"},
{"id": 353, "speaker": 31, "form": "dlg", "jp": "選択の余地なんてないじゃないか‥‥"},
{"id": 354, "speaker": 29, "form": "dlg", "jp": "（そうよ、選択の余地なんてないの‥‥）"},
{"id": 355, "speaker": 29, "form": "dlg", "jp": "（それに、戦うのは私たち３人だけじゃないわ‥‥）"},
{"id": 356, "speaker": 29, "form": "dlg", "jp": "（『Ｅ－ｇｒｏ』のメンバーは世界中に\n　３００人以上いるから‥‥）"},
{"id": 357, "speaker": 31, "form": "dlg", "jp": "（それにまだまだ増える予定だ‥‥）"},
{"id": 358, "speaker": 29, "form": "dlg", "jp": "（それが私たちがこの国にやってきた第１の目的よ！）"},
{"id": 359, "speaker": 2, "form": "dlg", "jp": "（『目的』？）"},
{"id": 360, "speaker": 29, "form": "dlg", "jp": "（そう‥‥）"},
{"id": 361, "speaker": 29, "form": "dlg", "jp": "（私たちはこの国にいる『能力者』を\n　仲間にするためにやって来たの‥‥）"},
{"id": 362, "speaker": 29, "form": "dlg", "jp": "（この国にはキミを含めて５人の能力者が\n　存在するはずなの‥‥）"},
{"id": 363, "speaker": 2, "form": "dlg", "jp": "（あと、４人も！？）"},
{"id": 364, "speaker": 29, "form": "dlg", "jp": "（あの『バンパイア』が消えたから\n　あと３人ね‥‥）"},
{"id": 365, "speaker": 29, "form": "dlg", "jp": "（とにかく味方は１人でも多い方がいいの！）"},
{"id": 366, "speaker": 29, "form": "dlg", "jp": "（一日も早く彼らを見つけだして仲間にしないと‥‥）"},
{"id": 367, "speaker": 2, "form": "dlg", "jp": "（で、その３人の目星は？）"},
{"id": 368, "speaker": 31, "form": "dlg", "jp": "（まだ、何もないな‥‥）"},
{"id": 369, "speaker": 29, "form": "dlg", "jp": "（今の今までキミとバンパイアを\n　探す作業をしてたんだから‥‥）"},
{"id": 370, "speaker": 29, "form": "dlg", "jp": "（とにかく、　『能力者』はお互いひかれあう運命なの‥‥）"},
{"id": 371, "speaker": 29, "form": "dlg", "jp": "（きっと、近々見つかるはずよ‥‥）"},
{"id": 372, "speaker": 31, "form": "dlg", "jp": "（それに今までは２人で探してたのが\n　明日からは３人だしな‥‥）"},
{"id": 373, "speaker": 2, "form": "dlg", "jp": "（３人！？）"},
{"id": 374, "speaker": 29, "form": "dlg", "jp": "（キミも手伝うのよ！）"},
{"id": 375, "speaker": 31, "form": "dlg", "jp": "（早く見つけないとメンドウなことに\n　なりかねないからな‥‥）"},
{"id": 376, "speaker": 2, "form": "dlg", "jp": "（メンドウなこと？）"},
{"id": 377, "speaker": 31, "form": "dlg", "jp": "（『能力の暴走』とか‥‥）"},
{"id": 378, "speaker": 2, "form": "dlg", "jp": "（『能力の暴走』？）"},
{"id": 379, "speaker": 29, "form": "dlg", "jp": "（『能力』を持て余してしまうってこと‥‥）"},
{"id": 380, "speaker": 29, "form": "dlg", "jp": "（人より優れた能力を手に入れてしまい、\n　そのことを誰にも相談できず悩んだり）"},
{"id": 381, "speaker": 29, "form": "dlg", "jp": "（もしくはその能力を『悪用』したりするってこと‥‥）"},
{"id": 382, "speaker": 31, "form": "dlg", "jp": "（『悩む』ぐらいだったらいいけど、\n　『悪用』されるとかなりマズイからな‥‥）"},
{"id": 383, "speaker": 2, "form": "dlg", "jp": "（あのバンパイアみたいに？）"},
{"id": 384, "speaker": 31, "form": "dlg", "jp": "（それこそ一般人が『能力者』に不信感を抱いたり、\n　敵視し始めないとも限らないしな‥‥）"},
{"id": 385, "speaker": 29, "form": "dlg", "jp": "（『能力』の『悪用』を覚えた人間は\n　『仲間になりにくい』ってデータもあるし‥‥）"},
{"id": 386, "speaker": 2, "form": "dlg", "jp": "（どうして？）"},
{"id": 387, "speaker": 29, "form": "dlg", "jp": "（自分のために『能力』を使うことを覚えた人間は\n　他人のために使うなんてバカらしいのよ）"},
{"id": 388, "speaker": 29, "form": "dlg", "jp": "（それに『Ｅ－ｇｒｏ』のメンバーになると\n　『能力』の使用を制限されちゃうしね）"},
{"id": 389, "speaker": 2, "form": "dlg", "jp": "（で、仲間にならなかったらどうなるの？）"},
{"id": 390, "speaker": 29, "form": "dlg", "jp": "（もちろん‥‥）"},
{"id": 391, "speaker": 29, "form": "dlg", "jp": "（『死んでもらう』わ‥‥）"},
{"id": 392, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥！！"},
{"id": 393, "speaker": 29, "form": "dlg", "jp": "（私たちの使命には『全人類の命』がかかってるの\n　それより優先されるものなど何もないハズ‥‥）"},
{"id": 394, "speaker": 2, "form": "dlg", "jp": "（そうだろうけど‥‥）"},
{"id": 395, "speaker": 29, "form": "dlg", "jp": "（くれぐれも、\n　キミも『能力』を悪用しないように‥‥）"},
{"id": 396, "speaker": 29, "form": "dlg", "jp": "ジーンは恐ろしい表情でボクをにらみつけた。"},
{"id": 397, "speaker": 2, "form": "dlg", "jp": "（わ、わかったよ‥‥）"},
{"id": 398, "speaker": 29, "form": "dlg", "jp": "（近いうちに"},
{"id": 399, "speaker": 29, "form": "dlg", "jp": "『ペルーの本部』"},
{"id": 400, "speaker": 29, "form": "dlg", "jp": "に来てもらって、\n　『リーダー』に紹介するわ‥‥）"},
{"id": 401, "speaker": 29, "form": "dlg", "jp": "（詳しいことは、『リーダー』から\n　聞いてちょうだい‥‥）"},
{"id": 402, "speaker": 2, "form": "dlg", "jp": "（また、ペルーか‥‥‥‥）"},
{"id": 403, "speaker": 29, "form": "dlg", "jp": "（じゃ、遅くなったんで私たちは\n　いったんホテルに戻るから‥‥）"},
{"id": 404, "speaker": 29, "form": "dlg", "jp": "（何かあったら、ホテルの方に連絡ちょうだい‥‥）"},
{"id": 405, "speaker": 29, "form": "dlg", "jp": "『ジーン』は連絡先の書かれたメモを手渡した。"},
{"id": 406, "speaker": 2, "form": "dlg", "jp": "（戻るってどうやって‥‥）"},
{"id": 407, "speaker": 29, "form": "dlg", "jp": "（窓からに決まってるでしょう？）"},
{"id": 408, "speaker": 2, "form": "dlg", "jp": "（ここ、２階だけど‥‥）"},
{"id": 409, "speaker": 31, "form": "dlg", "jp": "（オレの『能力』を忘れたのか？）"},
{"id": 410, "speaker": 31, "form": "dlg", "jp": "（人間の１人や、２人軽いものさ‥‥）"},
{"id": 411, "speaker": 29, "form": "dlg", "jp": "（じゃぁね！）"},
{"id": 412, "speaker": 29, "form": "dlg", "jp": "「シュンッ！」"},
{"id": 413, "speaker": 29, "form": "dlg", "jp": "２人は窓から飛び去った‥‥"},
{"id": 414, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥\n‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 415, "speaker": 29, "form": "dlg", "jp": "２人がテレビヒーローの様に窓から飛び立つ姿を\n見てもまだすべてを飲み込むことができなかった。"},
{"id": 416, "speaker": 29, "form": "dlg", "jp": "いったい、\nボクは何に巻き込まれてしまったんだろう。"}
]
