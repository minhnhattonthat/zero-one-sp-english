[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０７／２７／ＡＭ０８：４０"},
{"id": 1, "speaker": 3, "form": "dlg", "jp": "「じゃあ、姉さん出かけるからね‥‥」"},
{"id": 2, "speaker": 3, "form": "dlg", "jp": "「ちゃんと宿題するのよ‥‥」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "さてと‥‥"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "姉さんも出かけたことだし‥‥"},
{"id": 8, "speaker": 2, "form": "choice", "jp": "【『事件の現場』にでも行ってみるか‥‥】"},
{"id": 9, "speaker": 2, "form": "choice", "jp": "【『犬の専門家』のところにでも行ってみるか‥‥】"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "【『犬の専門家』のところにでも行ってみるか‥‥】"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "って言っても、『犬の専門家』なんて\n知り合いにいないよなぁ～"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "ボクは知り合いの中で\n『犬』に詳しそうな人物のことを考えてみた。"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "そうだな、身近なとこじゃあ、\nやっぱ『科学の先生』かな？"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "たしか、科学の『高塚先生』は大学時代は\n『生物』を『専攻』してたハズ‥‥"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "よし、『高塚先生』に聞いてみよう！"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "ボクは『科学の高塚先生』に会うために、\n学校へ行くことにした。"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "夏休み中だけど先生来てるかな？"},
{"id": 20, "speaker": 17, "form": "dlg", "jp": "「オイ、常光寺！！」"},
{"id": 21, "speaker": 17, "form": "dlg", "jp": "ゲゲ、また大本だ！！"},
{"id": 22, "speaker": 17, "form": "dlg", "jp": "「なんだキョロキョロして‥‥」"},
{"id": 23, "speaker": 17, "form": "dlg", "jp": "よし、高塚先生の居場所を聞いてみるか？"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「先生、今日は『高塚先生』は？」"},
{"id": 25, "speaker": 17, "form": "dlg", "jp": "「ああ、あのナンジャク教師か‥‥」"},
{"id": 26, "speaker": 17, "form": "dlg", "jp": "「さっき、廊下であったから、\n　今日も出勤してるんじゃないか？」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 28, "speaker": 17, "form": "dlg", "jp": "「たぶん、\n　『科学室』にでもこもってるんだろう？」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「どうも、ありがとうございます！」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "よし、『科学室』へ行ってみよう。"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「ガラガラガラ‥‥」"},
{"id": 32, "speaker": 57, "form": "dlg", "jp": "「うん！？」"},
{"id": 33, "speaker": 57, "form": "dlg", "jp": "「キミはたしか‥‥」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「常光寺です！」"},
{"id": 35, "speaker": 57, "form": "dlg", "jp": "「常光寺くん？」"},
{"id": 36, "speaker": 57, "form": "dlg", "jp": "「何か用ですか？」"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "「先生、先生はたしか大学では\n　『生物』を専攻してたんですよね？」"},
{"id": 38, "speaker": 57, "form": "dlg", "jp": "「そうですが、何か？」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「じゃあ、\n　『動物』のことはくわしいですよね？」"},
{"id": 40, "speaker": 57, "form": "dlg", "jp": "「さあ、どうでしょうか‥‥」"},
{"id": 41, "speaker": 57, "form": "dlg", "jp": "「たぶん、そこいらの『動物学者』程度にしか\n　くわしくないと思いますよ‥‥」"},
{"id": 42, "speaker": 57, "form": "dlg", "jp": "それで十分だけど‥‥"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「じゃあ、『犬』なんかのことは？」"},
{"id": 44, "speaker": 57, "form": "dlg", "jp": "「『犬』ですか‥‥」"},
{"id": 45, "speaker": 57, "form": "dlg", "jp": "「『犬』については、食べたことがないので\n　『味』についてはくわしくないですが‥‥」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「味のことはどうでもいいです！」"},
{"id": 47, "speaker": 57, "form": "dlg", "jp": "「『味』以外なら、それなりにくわしいかも‥‥」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「じゃあ、最近ニュースになっている\n　『犬が人を襲う事件』をどう思います？」"},
{"id": 49, "speaker": 57, "form": "dlg", "jp": "「どうって？」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「あれってやっぱり、\n　新しい『狂犬病』なんでしょうか？」"},
{"id": 51, "speaker": 57, "form": "dlg", "jp": "「その事件って、犬が『突然凶暴になって』、\n　『突然大人しくなる』んでしょう？」"},
{"id": 52, "speaker": 57, "form": "dlg", "jp": "「そんな都合のいい病気はありえませんよ‥‥」"},
{"id": 53, "speaker": 57, "form": "dlg", "jp": "「実は数週間前に、ボクの家の近所でも\n　同様の事件が起きてですねぇ」"},
{"id": 54, "speaker": 57, "form": "dlg", "jp": "「"},
{"id": 55, "speaker": 57, "form": "dlg", "jp": "警察"},
{"id": 56, "speaker": 57, "form": "dlg", "jp": "やらなにやらに同じようなこと\n　聞かれたんですけど？」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "「『警察』ですか！？」"},
{"id": 58, "speaker": 57, "form": "dlg", "jp": "「ええ、警察です‥‥」"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "「警察が調べてるってことは‥‥？」"},
{"id": 60, "speaker": 57, "form": "dlg", "jp": "「警察は『狂犬病』だとは思っていないみたいですよ？」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "「そうなんですか？」"},
{"id": 62, "speaker": 57, "form": "dlg", "jp": "「そうですよ‥‥」"},
{"id": 63, "speaker": 57, "form": "dlg", "jp": "「よく考えてみてくださいよ！」"},
{"id": 64, "speaker": 57, "form": "dlg", "jp": "「ノラ犬以外の犬が人間を襲うことなんか\n　まずありえないんですよ！」"},
{"id": 65, "speaker": 57, "form": "dlg", "jp": "「でも、ノラ人間じゃない、教育を受けた人間ですら\n　平気で人間を襲う‥‥」"},
{"id": 66, "speaker": 57, "form": "dlg", "jp": "「つまり、人間にくらべて犬なんてものは\n　おとなしくて、従順な生き物なんですよ」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 68, "speaker": 57, "form": "dlg", "jp": "「だから、\n　警察は『人間の仕業』と考えているみたいですね‥‥」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「じゃあ、警察は『人間が人間にかみついた』と？」"},
{"id": 70, "speaker": 57, "form": "dlg", "jp": "「そうではありません」"},
{"id": 71, "speaker": 57, "form": "dlg", "jp": "「ただ、\n　『人間が指示を出した』のでは？　と‥‥」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "「『人間が指示を出した』？」"},
{"id": 73, "speaker": 57, "form": "dlg", "jp": "「そうです‥‥」"},
{"id": 74, "speaker": 57, "form": "dlg", "jp": "「犬は従順な動物ですから」"},
{"id": 75, "speaker": 57, "form": "dlg", "jp": "「普通の状態で犬が人を襲うことなんて\n　ほとんどありませんが‥‥」"},
{"id": 76, "speaker": 57, "form": "dlg", "jp": "「人間が指示を出せば\n　簡単に人を襲うものです」"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "「それ、本当ですか？」"},
{"id": 78, "speaker": 57, "form": "dlg", "jp": "「テレビで警察犬の訓練とか見たことないですか？」"},
{"id": 79, "speaker": 57, "form": "dlg", "jp": "「トレーナーが指示を出したら、\n　指示に従って人間にかみついたりする映像を‥‥」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「見たことあります！」"},
{"id": 81, "speaker": 57, "form": "dlg", "jp": "「まあそういうことです‥‥」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "「じゃあ警察はこの『犬の事件』については\n　背後に『人間』がいると‥‥」"},
{"id": 84, "speaker": 57, "form": "dlg", "jp": "「まあ、半々みたいですけど‥‥」"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "「半々？」"},
{"id": 86, "speaker": 57, "form": "dlg", "jp": "「そうです、犬をけしかけた人間がいるのなら\n　その人間には"},
{"id": 87, "speaker": 57, "form": "dlg", "jp": "『動機』"},
{"id": 88, "speaker": 57, "form": "dlg", "jp": "があるハズなんですが‥‥」"},
{"id": 89, "speaker": 57, "form": "dlg", "jp": "「警察でも"},
{"id": 90, "speaker": 57, "form": "dlg", "jp": "動機"},
{"id": 91, "speaker": 57, "form": "dlg", "jp": "がまったくわからないそうです」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "やっぱり『動機』が問題なんだ！！"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ボクはこれで帰りますので‥‥」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「いろいろ教えてくれてありがとうございます」"},
{"id": 96, "speaker": 57, "form": "dlg", "jp": "「まあ、\n　動物のことならなんでも聞いてください」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「じゃあ、失礼します！」"},
{"id": 98, "speaker": 57, "form": "dlg", "jp": "「ハイ、さようなら‥‥」"},
{"id": 99, "speaker": 57, "form": "dlg", "jp": "ボクは一旦、家へ帰ることにした。"},
{"id": 100, "speaker": 57, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 101, "speaker": 57, "form": "dlg", "jp": "【『事件の現場』にでも行ってみるか‥‥】"},
{"id": 102, "speaker": 57, "form": "dlg", "jp": "ボクはアイコが事件を目撃した\n『伊東さんの家』付近を調べて見ることにした。"},
{"id": 103, "speaker": 57, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 104, "speaker": 57, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 105, "speaker": 57, "form": "dlg", "jp": "『伊東さん』の家は父さんの助手の三田さんの家の\nちょうどとなりで"},
{"id": 106, "speaker": 57, "form": "dlg", "jp": "家はボクたちの通学路の途中にあり\n決して人通りの少ない場所ではない‥‥"},
{"id": 107, "speaker": 57, "form": "dlg", "jp": "たとえ早朝であっても、誰か目撃者がいても\nまったくおかしくない場所だ。"},
{"id": 108, "speaker": 57, "form": "dlg", "jp": "ボクは手がかりを探しながら\n『伊東さん』の家の周りを歩き回った。"},
{"id": 109, "speaker": 57, "form": "dlg", "jp": "しかし‥‥"},
{"id": 110, "speaker": 57, "form": "dlg", "jp": "手がかりらしいものはまったく見つからなかった。"},
{"id": 111, "speaker": 57, "form": "dlg", "jp": "まあ、そんなそう簡単に見つかるわけないか‥‥"},
{"id": 112, "speaker": 26, "form": "dlg", "jp": "「ナゴムくん！」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「えっ？」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「三田さん！！」"},
{"id": 115, "speaker": 26, "form": "dlg", "jp": "「どうしたんだい、こんなところで‥‥」"},
{"id": 116, "speaker": 26, "form": "dlg", "jp": "三田さんは父さんの助手の１人で、\n父さんがもっとも信頼している人物で、"},
{"id": 117, "speaker": 26, "form": "dlg", "jp": "父さんだけではなく、ボクたち姉弟も\nかなり世話になっている。"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「別に‥‥」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「昨日、クロが通行人を襲ったって聞いたから‥‥」"},
{"id": 120, "speaker": 26, "form": "dlg", "jp": "「ヤジウマだね‥‥」"},
{"id": 121, "speaker": 26, "form": "dlg", "jp": "そうだ！"},
{"id": 122, "speaker": 26, "form": "dlg", "jp": "三田さんなら何か知ってるかも？"},
{"id": 123, "speaker": 26, "form": "choice", "jp": "【よし、三田さんに話を聞いてみよう！】"},
{"id": 124, "speaker": 26, "form": "choice", "jp": "【いや、それはちょっとちがうよな‥‥】"},
{"id": 125, "speaker": 26, "form": "dlg", "jp": "【よし、三田さんに話を聞いてみよう！】"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「三田さん、聞きたいことがあるんだけど‥‥」"},
{"id": 127, "speaker": 26, "form": "dlg", "jp": "「いいよ、とにかく立ち話もなんだし‥‥」"},
{"id": 128, "speaker": 26, "form": "dlg", "jp": "「あがりなよ‥‥」"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "「あっ、すいません‥‥」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "ボクは三田さんのウチに\nあがらせてもらうことになった。"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「おじゃまします‥‥」"},
{"id": 132, "speaker": 26, "form": "dlg", "jp": "「エンリョしなくていいよ‥‥」"},
{"id": 133, "speaker": 26, "form": "dlg", "jp": "「で、聞きたいことって‥‥？」"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "「おとなりのクロのことなんだけど‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「最近おかしいと思ったことはなかったですか？」"},
{"id": 136, "speaker": 26, "form": "dlg", "jp": "「もしかして探偵ゴッコかい？」"},
{"id": 137, "speaker": 26, "form": "dlg", "jp": "「昨日、\n　同じようなことを"},
{"id": 138, "speaker": 26, "form": "dlg", "jp": "警察"},
{"id": 139, "speaker": 26, "form": "dlg", "jp": "の人にも聞かれたよ‥‥」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「警察？」"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "「どうして警察が？」"},
{"id": 142, "speaker": 26, "form": "dlg", "jp": "「うん、なんでもこう似たような事件が続くと\n　単なる事故じゃなく事件の可能性もあるって‥‥」"},
{"id": 143, "speaker": 26, "form": "dlg", "jp": "そうか‥‥"},
{"id": 144, "speaker": 26, "form": "dlg", "jp": "やっぱり警察も、\nなんかオカシイって思ってるんだな‥‥"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「で、三田さんはどう答えたの？」"},
{"id": 146, "speaker": 26, "form": "dlg", "jp": "「どうも何も、\n　別にクロにおかしいことなんてなかったから‥‥」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 148, "speaker": 26, "form": "dlg", "jp": "「まあ、おかしいことがないのに\n　あんなことになったのがおかしいんだけど‥‥」"},
{"id": 149, "speaker": 26, "form": "dlg", "jp": "「だから警察まで動きだしてるんだろうね？」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「やっぱり、ただの事故じゃないと‥‥？」"},
{"id": 151, "speaker": 26, "form": "dlg", "jp": "「だって、\n　犬ってかしこくて従順な動物だからね‥‥」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「でも、新種の『狂犬病』ってことも‥‥」"},
{"id": 153, "speaker": 26, "form": "dlg", "jp": "「そんな都合のいい病原菌なんていないよ‥‥」"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "「じゃあ？」"},
{"id": 155, "speaker": 26, "form": "dlg", "jp": "「誰かに操られたんじゃないかな？」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「操る？」"},
{"id": 157, "speaker": 26, "form": "dlg", "jp": "「警察もそう思ってるみたいだよ‥‥」"},
{"id": 158, "speaker": 26, "form": "dlg", "jp": "「さっきも言っただろう？\n　犬ってかしこくて従順な動物だって‥‥」"},
{"id": 159, "speaker": 26, "form": "dlg", "jp": "「普通の状態で犬が人を襲うことなんて\n　ほとんどありえないけど」"},
{"id": 160, "speaker": 26, "form": "dlg", "jp": "「人間が指示を出せば結構簡単に‥‥」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「それ、本当なの？」"},
{"id": 162, "speaker": 26, "form": "dlg", "jp": "「テレビで警察犬の訓練とか見たことない？」"},
{"id": 163, "speaker": 26, "form": "dlg", "jp": "「トレーナーが指示を出したら、\n　指示に従って人間にかみついたりするの‥‥」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「見たことあるよ！」"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "「じゃあ、\n　三田さんはやっぱり背後に人間がいると‥‥？」"},
{"id": 166, "speaker": 26, "form": "dlg", "jp": "「多分、ボクだけじゃなくて\n　警察もそう思って動いてるんじゃないかな？」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「でも、そうなると『動機』はなんだと思いますか？」"},
{"id": 169, "speaker": 26, "form": "dlg", "jp": "「『動機』ねぇ‥‥」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「意味もなく犬をけしかけるとは思えないでしょう？」"},
{"id": 171, "speaker": 26, "form": "dlg", "jp": "「うん、\n　警察もそのことを気にしてたみたいだけど‥‥」"},
{"id": 172, "speaker": 26, "form": "dlg", "jp": "「そこまではボクはわからないよ‥‥」"},
{"id": 173, "speaker": 26, "form": "dlg", "jp": "やっぱり、"},
{"id": 174, "speaker": 26, "form": "dlg", "jp": "『動機』"},
{"id": 175, "speaker": 26, "form": "dlg", "jp": "が問題なんだ‥‥"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「いろいろありがとうございます！」"},
{"id": 177, "speaker": 26, "form": "dlg", "jp": "「なんだ、\n　本当に『事件』のことが知りたかったの？」"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 179, "speaker": 26, "form": "dlg", "jp": "「少年がいろんなものにキョウミを持つのは\n　悪いことじゃないけど‥‥」"},
{"id": 180, "speaker": 26, "form": "dlg", "jp": "「事件とかそういうのに\n　巻き込まれないようにしないといけないよ」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「うん、気をつけるよ‥‥」"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ボクはこれで‥‥」"},
{"id": 183, "speaker": 26, "form": "dlg", "jp": "「リツコさんによろしくね‥‥」"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "ボクは一旦、家へ帰ることにした。"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "【いや、それはちょっとちがうよな‥‥】"},
{"id": 187, "speaker": 26, "form": "dlg", "jp": "「どうかしたのかい？」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「いいえ、なんでもないです‥‥」"},
{"id": 189, "speaker": 26, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "「じゃあ、サヨナラ‥‥」"},
{"id": 191, "speaker": 26, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 192, "speaker": 26, "form": "dlg", "jp": "『犬の専門家』のところにでも行ってみるか‥‥"},
{"id": 193, "speaker": 26, "form": "dlg", "jp": "やっぱり、警察もあやしんでるんだな‥‥"},
{"id": 194, "speaker": 26, "form": "choice", "jp": "【情報が手に入れやすくなるかも‥‥】"},
{"id": 195, "speaker": 26, "form": "choice", "jp": "【情報が手に入れにくくなるかも‥‥】"},
{"id": 196, "speaker": 26, "form": "dlg", "jp": "【情報が手に入れにくくなるかも‥‥】"},
{"id": 197, "speaker": 26, "form": "dlg", "jp": "たしか、『２０年前』の事件は\n『報道規制』がされて情報が流れなくなったんだ‥‥"},
{"id": 198, "speaker": 26, "form": "dlg", "jp": "もしかしたら、\nすでに警察が情報を隠しちゃってるかも‥‥"},
{"id": 199, "speaker": 26, "form": "dlg", "jp": "その場合は\nどうやってその情報を引き出すかだな‥‥"},
{"id": 200, "speaker": 26, "form": "dlg", "jp": "【情報が手に入れやすくなるかも‥‥】"},
{"id": 201, "speaker": 26, "form": "dlg", "jp": "ボクたちが調べ回らなくても、\n警察が色々調べてくれるに違いない。"},
{"id": 202, "speaker": 26, "form": "dlg", "jp": "あとはその情報をボクたちが\nどうやって手に入れるかだな‥‥"},
{"id": 203, "speaker": 14, "form": "dlg", "jp": "「オイ、ナゴム！！」"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "「シンちゃん！！」"},
{"id": 205, "speaker": 14, "form": "dlg", "jp": "「ちょうどいいとこで会った！」"},
{"id": 206, "speaker": 2, "form": "dlg", "jp": "「なんだよ‥‥」"},
{"id": 207, "speaker": 14, "form": "dlg", "jp": "「午後から、『スーパーヒーロー』に行こうって\n　ツトムと話してたんだけど‥‥」"},
{"id": 208, "speaker": 14, "form": "dlg", "jp": "「オマエも来るだろう？」"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "「いや、ボクはちょっと‥‥」"},
{"id": 210, "speaker": 14, "form": "dlg", "jp": "「なんだ、なんか用事あるのか？」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「用事はないけど‥‥」"},
{"id": 212, "speaker": 14, "form": "dlg", "jp": "「用事ないんならいっしょに行こうぜ！」"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "「ちょっと、今は返事できないよ‥‥」"},
{"id": 214, "speaker": 14, "form": "dlg", "jp": "「なんだよ、それ‥‥」"},
{"id": 215, "speaker": 14, "form": "dlg", "jp": "「わかった、\n　じゃあ、あとでむかえに行くから‥‥」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「たぶん、あとでも同じだと‥‥」"},
{"id": 217, "speaker": 14, "form": "dlg", "jp": "「じゃあな‥‥」"},
{"id": 218, "speaker": 14, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 219, "speaker": 14, "form": "dlg", "jp": "シンちゃんは自分の言いたいことだけ言って\n立ち去ってしまった。"},
{"id": 220, "speaker": 14, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 221, "speaker": 14, "form": "dlg", "jp": "さてと‥‥"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "（小田のヤツ、なんか情報つかめたのかな？）"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "（誰だろう？）"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "「タン、タン、タン、タン、タン‥‥」"},
{"id": 226, "speaker": 51, "form": "dlg", "jp": "「すみませーん！」"},
{"id": 227, "speaker": 51, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 229, "speaker": 51, "form": "dlg", "jp": "「どうかしたのじゃないし！」"},
{"id": 230, "speaker": 51, "form": "dlg", "jp": "「ジーンがここに来いって言うから、\n　クラブ抜け出して来たんや！」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「ジーンが？」"},
{"id": 232, "speaker": 51, "form": "dlg", "jp": "「ジーンも、もうすぐ来るハズや‥‥」"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "「もう来てるわよ‥‥」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「き、今日は２階からじゃないんだね？」"},
{"id": 235, "speaker": 31, "form": "dlg", "jp": "「さっき、\n　電話をかけて留守なのを確認したからな‥‥」"},
{"id": 236, "speaker": 31, "form": "dlg", "jp": "「それに昼間は目立つから、\n　あんまり飛びたくないんだよ‥‥」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 238, "speaker": 31, "form": "dlg", "jp": "「とりあえず、\n　ここじゃ目立つから上がらせてもらうぜ‥‥」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「あ、ああ‥‥」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "「で、急に集まったりしてどうかしたの？」"},
{"id": 243, "speaker": 29, "form": "dlg", "jp": "「ちょっと気になる情報が手に入ったのよ‥‥」"},
{"id": 244, "speaker": 29, "form": "dlg", "jp": "「ちょっとみんなの情報をまとめてみない？」"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "とりあえず、ボクたちはそれぞれが集めた情報を\n発表しあうことにした。"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "（長尾のヤツ、なんか情報つかめたのかな？）"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "（誰だろう？）"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "「タン、タン、タン、タン、タン‥‥」"},
{"id": 251, "speaker": 16, "form": "dlg", "jp": "「ごめんくださーい！」"},
{"id": 252, "speaker": 16, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 253, "speaker": 16, "form": "dlg", "jp": "そこには血相を変えた長尾の姿があった。"},
{"id": 254, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 255, "speaker": 16, "form": "dlg", "jp": "「常光寺くん、いるなら電話に出てよ！」"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "「いや、ちょっと外出していて\n　今帰って来たとこなんだよ‥‥」"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "「で、なんか用？」"},
{"id": 258, "speaker": 16, "form": "dlg", "jp": "「見ちゃったのよ！」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「何を？」"},
{"id": 260, "speaker": 16, "form": "dlg", "jp": "「"},
{"id": 261, "speaker": 16, "form": "dlg", "jp": "『夢』"},
{"id": 262, "speaker": 16, "form": "dlg", "jp": "よっ！！」"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "『夢』"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "！？」"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "「まさかっ例の"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "『予知夢』"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "！？」"},
{"id": 269, "speaker": 16, "form": "dlg", "jp": "「さぁ、\n　それはその時がこないとわからないけど‥‥」"},
{"id": 270, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 271, "speaker": 2, "form": "dlg", "jp": "「で、どんな『夢』だったの？」"},
{"id": 272, "speaker": 16, "form": "dlg", "jp": "「常光寺くんのお姉さんが‥‥」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「姉さんが？」"},
{"id": 274, "speaker": 16, "form": "dlg", "jp": "「"},
{"id": 275, "speaker": 16, "form": "dlg", "jp": "『犬に襲われる夢』"},
{"id": 276, "speaker": 16, "form": "dlg", "jp": "‥‥」"},
{"id": 277, "speaker": 2, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "「それって、いつ？」"},
{"id": 279, "speaker": 16, "form": "dlg", "jp": "「日にちまでわからないわ！」"},
{"id": 280, "speaker": 16, "form": "dlg", "jp": "「ただ、"},
{"id": 281, "speaker": 16, "form": "dlg", "jp": "景色は『夕焼け』"},
{"id": 282, "speaker": 16, "form": "dlg", "jp": "だったわ‥‥」"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "「よし、とにかく『姉さん』を保護しないと‥‥」"},
{"id": 284, "speaker": 29, "form": "dlg", "jp": "「待ちなさい！」"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "「ジーン！？」"},
{"id": 286, "speaker": 16, "form": "dlg", "jp": "「今日は２階からじゃないの？」"},
{"id": 287, "speaker": 31, "form": "dlg", "jp": "「さっき、\n　電話をかけて留守なのを確認したからな‥‥」"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「ジーン、姉さんが‥‥」"},
{"id": 289, "speaker": 29, "form": "dlg", "jp": "「聞いてたわよ‥‥」"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "「早くなんとかしないと‥‥」"},
{"id": 291, "speaker": 29, "form": "dlg", "jp": "「そんな必要ないでしょ！」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「なんてことを言うんだよ！」"},
{"id": 293, "speaker": 29, "form": "dlg", "jp": "「おちつきなさいっ！」"},
{"id": 294, "speaker": 29, "form": "dlg", "jp": "「アキラの"},
{"id": 295, "speaker": 29, "form": "dlg", "jp": "『夢』"},
{"id": 296, "speaker": 29, "form": "dlg", "jp": "じゃぁ"},
{"id": 297, "speaker": 29, "form": "dlg", "jp": "『夕焼け』"},
{"id": 298, "speaker": 29, "form": "dlg", "jp": "だったんでしょう？」"},
{"id": 299, "speaker": 29, "form": "dlg", "jp": "「じゃあ、『夕方』まで大丈夫ってことじゃない‥‥」"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 301, "speaker": 29, "form": "dlg", "jp": "「とりあえずあがらせてもらうわよ‥‥」"},
{"id": 302, "speaker": 29, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 303, "speaker": 29, "form": "dlg", "jp": "「バタン！」"},
{"id": 304, "speaker": 29, "form": "dlg", "jp": "「で、もう少し詳しく説明してくれる？」"},
{"id": 305, "speaker": 29, "form": "dlg", "jp": "「アキラの見た『夢』って言うのを‥‥」"},
{"id": 306, "speaker": 29, "form": "dlg", "jp": "「もしかしたら、『犬』を操ってるやつの\n　ヒントがわかるかも‥‥」"},
{"id": 307, "speaker": 16, "form": "dlg", "jp": "「そ、そうね‥‥」"},
{"id": 308, "speaker": 16, "form": "dlg", "jp": "「とりあえず、空は"},
{"id": 309, "speaker": 16, "form": "dlg", "jp": "『夕焼け』"},
{"id": 310, "speaker": 16, "form": "dlg", "jp": "だったわ‥‥」"},
{"id": 311, "speaker": 29, "form": "dlg", "jp": "「それはさっき聞いたわ‥‥」"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "「場所は？」"},
{"id": 313, "speaker": 16, "form": "dlg", "jp": "「たしか‥‥」"},
{"id": 314, "speaker": 16, "form": "dlg", "jp": "「ほら、２丁目の工事現場‥‥\n　あの辺りだと思うの‥‥」"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "「で、なんで姉さんは襲われたの？」"},
{"id": 316, "speaker": 16, "form": "dlg", "jp": "「そんなのわからないわ！」"},
{"id": 317, "speaker": 29, "form": "dlg", "jp": "「それより‥‥」"},
{"id": 318, "speaker": 29, "form": "dlg", "jp": "「襲われた時の状況は？」"},
{"id": 319, "speaker": 16, "form": "dlg", "jp": "「状況？」"},
{"id": 320, "speaker": 29, "form": "dlg", "jp": "「そこには『犬』しかいなかったの？」"},
{"id": 321, "speaker": 29, "form": "dlg", "jp": "「それとも誰かいたの？」"},
{"id": 322, "speaker": 16, "form": "dlg", "jp": "「誰もいなかったわ‥‥」"},
{"id": 323, "speaker": 16, "form": "dlg", "jp": "「アキラたち以外‥‥」"},
{"id": 324, "speaker": 29, "form": "dlg", "jp": "「アキラたち以外って‥‥\n　アナタはそこにいたのね！？」"},
{"id": 325, "speaker": 16, "form": "dlg", "jp": "「常光寺くんもいたわ‥‥」"},
{"id": 326, "speaker": 31, "form": "dlg", "jp": "「で、オマエたちは襲われなかったのか？」"},
{"id": 327, "speaker": 16, "form": "dlg", "jp": "「常光寺くんのお姉さんが襲われた時点で\n　おどろいて目が覚めたから‥‥」"},
{"id": 328, "speaker": 29, "form": "dlg", "jp": "「ってことは、その先の未来は\n　まだどうなるかわからないのね‥‥」"},
{"id": 329, "speaker": 31, "form": "dlg", "jp": "「よしっ、\n　ナゴムの姉さんが助かる可能性もあるんだな？」"},
{"id": 330, "speaker": 29, "form": "dlg", "jp": "「そうみたいね‥‥」"},
{"id": 331, "speaker": 2, "form": "dlg", "jp": "「ホント！？」"},
{"id": 332, "speaker": 31, "form": "dlg", "jp": "「ただし、ナゴム次第っぽいけどな‥‥」"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "「ボク次第？」"},
{"id": 334, "speaker": 31, "form": "dlg", "jp": "「アキラの夢の通りなら、\n　オマエが側にいる時に襲われるんだろう？」"},
{"id": 335, "speaker": 29, "form": "dlg", "jp": "「つまり、ナゴムがどう行動しても\n　かならず現場に出くわすってことよ！」"},
{"id": 336, "speaker": 29, "form": "dlg", "jp": "「とにかく、\n　今のうちに情報をまとめましょう！」"},
{"id": 337, "speaker": 29, "form": "dlg", "jp": "「気になる情報も手に入ったことだし‥‥」"},
{"id": 338, "speaker": 2, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 339, "speaker": 2, "form": "dlg", "jp": "とりあえず、ボクたちはそれぞれが集めた情報を\n発表しあうことにした。"},
{"id": 340, "speaker": 2, "form": "dlg", "jp": "「で、『気になる情報』って？」"},
{"id": 341, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 342, "speaker": 29, "form": "dlg", "jp": "『２０年前の事件』"},
{"id": 343, "speaker": 29, "form": "dlg", "jp": "についてだけど‥‥」"},
{"id": 344, "speaker": 29, "form": "dlg", "jp": "「犯人は"},
{"id": 345, "speaker": 29, "form": "dlg", "jp": "『無罪』"},
{"id": 346, "speaker": 29, "form": "dlg", "jp": "になってるのよ‥‥」"},
{"id": 347, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 348, "speaker": 2, "form": "dlg", "jp": "『無罪』"},
{"id": 349, "speaker": 2, "form": "dlg", "jp": "って？」"},
{"id": 350, "speaker": 31, "form": "dlg", "jp": "「実際は『犯人』ではなく、\n　『容疑者』なんだけどな‥‥」"},
{"id": 351, "speaker": 2, "form": "dlg", "jp": "「それって、『未成年』だから？」"},
{"id": 352, "speaker": 29, "form": "dlg", "jp": "「違うわ‥‥」"},
{"id": 353, "speaker": 31, "form": "dlg", "jp": "「一般的な発表は\n　"},
{"id": 354, "speaker": 31, "form": "dlg", "jp": "『証拠不十分』"},
{"id": 355, "speaker": 31, "form": "dlg", "jp": "ってことになっているみたいだ‥‥」"},
{"id": 356, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 357, "speaker": 2, "form": "dlg", "jp": "『証拠不十分』"},
{"id": 358, "speaker": 2, "form": "dlg", "jp": "？」"},
{"id": 359, "speaker": 29, "form": "dlg", "jp": "「『証拠不十分』も何も、\n　『現行犯逮捕』だったんだけどね‥‥」"},
{"id": 360, "speaker": 51, "form": "dlg", "jp": "「『現行犯逮捕』で、\n　『証拠不十分』ってどう言うこと？」"},
{"id": 361, "speaker": 29, "form": "dlg", "jp": "「『インメツ』されたみたい‥‥」"},
{"id": 362, "speaker": 51, "form": "dlg", "jp": "「『インメツ』！？」"},
{"id": 363, "speaker": 16, "form": "dlg", "jp": "「『現行犯逮捕』で、\n　『証拠不十分』ってどう言うこと？」"},
{"id": 364, "speaker": 29, "form": "dlg", "jp": "「『インメツ』されたみたい‥‥」"},
{"id": 365, "speaker": 16, "form": "dlg", "jp": "「『インメツ』！？」"},
{"id": 366, "speaker": 29, "form": "dlg", "jp": "「当時、若い女性が『通り魔』に『ノド』を\n　かみ切られ殺される事件が４件も発生していたの」"},
{"id": 367, "speaker": 29, "form": "dlg", "jp": "「で、警察はこれ以上被害が広がらないように\n　警戒体制をとってたらしいの‥‥」"},
{"id": 368, "speaker": 29, "form": "dlg", "jp": "「そんな中で５件目の事件が発生したらしいの‥‥」"},
{"id": 369, "speaker": 29, "form": "dlg", "jp": "「警戒体制中だった警官は\n　悲鳴が聞こえてからすぐに現場にかけつけ」"},
{"id": 370, "speaker": 29, "form": "dlg", "jp": "「そこで、ひん死状態の被害者にかみついている\n　血まみれの容疑者を見つけて逮捕したんだけど‥‥」"},
{"id": 371, "speaker": 29, "form": "dlg", "jp": "「数日後、容疑を否認しちゃったの‥‥」"},
{"id": 372, "speaker": 2, "form": "dlg", "jp": "「容疑を否認もなにも現行犯なんだろう？」"},
{"id": 373, "speaker": 29, "form": "dlg", "jp": "「その警官以外に証人がいなかったの‥‥」"},
{"id": 374, "speaker": 29, "form": "choice", "jp": "「血痕（ケッコン）とかは？」"},
{"id": 375, "speaker": 29, "form": "choice", "jp": "「その被害者は？」"},
{"id": 376, "speaker": 29, "form": "choice", "jp": "「歯形が証拠になるんじゃ？」"},
{"id": 377, "speaker": 2, "form": "dlg", "jp": "「歯形が証拠になるんじゃ？」"},
{"id": 378, "speaker": 29, "form": "dlg", "jp": "「歯形ものこらないくらい\n　ぐちゃぐちゃにかまれていたらしいわ‥‥」"},
{"id": 379, "speaker": 2, "form": "dlg", "jp": "「ウゲっ‥‥」"},
{"id": 380, "speaker": 2, "form": "dlg", "jp": "「血痕（ケッコン）とかは？」"},
{"id": 381, "speaker": 2, "form": "dlg", "jp": "「その容疑者は『返り血』を浴びてなかったの？」"},
{"id": 382, "speaker": 31, "form": "dlg", "jp": "「血まみれだったらしいぜ‥‥」"},
{"id": 383, "speaker": 2, "form": "dlg", "jp": "「じゃあ、どうして？」"},
{"id": 384, "speaker": 29, "form": "dlg", "jp": "「被害者を介抱しようとして\n　血がついたって証言したらしいの‥‥」"},
{"id": 385, "speaker": 2, "form": "dlg", "jp": "「そんな不自然な‥‥」"},
{"id": 386, "speaker": 2, "form": "dlg", "jp": "「その被害者は？」"},
{"id": 387, "speaker": 2, "form": "dlg", "jp": "「襲われた被害者は死んでないんだろう？」"},
{"id": 388, "speaker": 31, "form": "dlg", "jp": "「ああ、\n　奇跡的に一命はとりとめたハズだったんだが‥‥」"},
{"id": 389, "speaker": 2, "form": "dlg", "jp": "「ハズだった？」"},
{"id": 390, "speaker": 29, "form": "dlg", "jp": "「病院に運ばれた時はまだ、\n　意識があったんだけど‥‥」"},
{"id": 391, "speaker": 29, "form": "dlg", "jp": "「治療室に運ばれたとたん\n　死んじゃったらしいの‥‥」"},
{"id": 392, "speaker": 2, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 393, "speaker": 31, "form": "dlg", "jp": "「まあ、一番問題になったのが\n　やっぱり"},
{"id": 394, "speaker": 31, "form": "dlg", "jp": "『動機』"},
{"id": 395, "speaker": 31, "form": "dlg", "jp": "だな‥‥」"},
{"id": 396, "speaker": 2, "form": "dlg", "jp": "「『動機』？」"},
{"id": 397, "speaker": 31, "form": "dlg", "jp": "「あやしいって言えば、\n　とことんあやしいヤツなんだけど‥‥」"},
{"id": 398, "speaker": 31, "form": "dlg", "jp": "「やっぱり『動機』がみつからなかったんだよ‥‥」"},
{"id": 399, "speaker": 31, "form": "dlg", "jp": "「まさか、本当に『ドラキュラ』でもあるまいし\n　意味もなく人にかみつかないだろう？」"},
{"id": 400, "speaker": 31, "form": "dlg", "jp": "「『動機』もなく」"},
{"id": 401, "speaker": 31, "form": "dlg", "jp": "「『証人』もなく」"},
{"id": 402, "speaker": 31, "form": "dlg", "jp": "「『証拠』もないんだから『無罪』になったんだよ‥‥」"},
{"id": 403, "speaker": 2, "form": "dlg", "jp": "「でも、その逮捕した警官は？」"},
{"id": 404, "speaker": 29, "form": "dlg", "jp": "「手柄が欲しくて『ねつ造』したってことにされて\n　『自殺』しちゃったわ‥‥」"},
{"id": 405, "speaker": 29, "form": "dlg", "jp": "「たぶん『インメツ』されたんだと‥‥」"},
{"id": 406, "speaker": 51, "form": "dlg", "jp": "「『インメツ』！？」"},
{"id": 407, "speaker": 51, "form": "dlg", "jp": "「もし、ソイツが本当に犯人だったら\n　ムチャクチャな話やな～」"},
{"id": 408, "speaker": 16, "form": "dlg", "jp": "「『インメツ』！？」"},
{"id": 409, "speaker": 16, "form": "dlg", "jp": "「もし、ソイツが本当に犯人だったら\n　その人たちかわいそう‥‥」"},
{"id": 410, "speaker": 2, "form": "dlg", "jp": "「それってやっぱり、\n　『大物議員』と関係あるのかな？」"},
{"id": 411, "speaker": 29, "form": "dlg", "jp": "「たぶんね‥‥」"},
{"id": 412, "speaker": 29, "form": "dlg", "jp": "「バックに何もない事件が\n　こんな風にかたづけられるとは思えないわね」"},
{"id": 413, "speaker": 31, "form": "dlg", "jp": "「まあ、ここまでテッテイしてまうと\n　逆にソイツのあやしさがますんだけどな‥‥」"},
{"id": 414, "speaker": 29, "form": "dlg", "jp": "「とにかく、この『２０年前』の事件を調べるのは\n　簡単に行かないでしょうね‥‥」"},
{"id": 415, "speaker": 29, "form": "dlg", "jp": "「警察もマスコミもこの事件を\n　必死で隠そうとしているみたいだし‥‥」"},
{"id": 416, "speaker": 2, "form": "dlg", "jp": "「それなんだけど‥‥」"},
{"id": 417, "speaker": 2, "form": "dlg", "jp": "「実はこの『犬の事件』も\n　警察があやしんでいるみたいなんだ」"},
{"id": 418, "speaker": 29, "form": "dlg", "jp": "「あやしんでいるって？」"},
{"id": 419, "speaker": 2, "form": "dlg", "jp": "「どうやら警察も『犬を操っている人間』が\n　いると思っているみたいだよ？」"},
{"id": 420, "speaker": 31, "form": "dlg", "jp": "「マズイな‥‥」"},
{"id": 421, "speaker": 31, "form": "dlg", "jp": "「今回もインメツされてしまうかもしれないな‥‥」"},
{"id": 422, "speaker": 29, "form": "dlg", "jp": "「で、他になにか情報は‥‥？」"},
{"id": 423, "speaker": 29, "form": "dlg", "jp": "ボクはそれ以外に手に入れた情報を打ち明けた。"},
{"id": 424, "speaker": 31, "form": "dlg", "jp": "「で、トモの方は？」"},
{"id": 425, "speaker": 51, "form": "dlg", "jp": "「一応、\n　三船ちゃんに話を聞いてみたんやけど」"},
{"id": 426, "speaker": 51, "form": "dlg", "jp": "「彼女、車のナンバーとか\n　ぜんぜん覚えていないんやって‥‥」"},
{"id": 427, "speaker": 51, "form": "dlg", "jp": "「ただ、寝ていたオジさんの顔は\n　覚えてるって‥‥」"},
{"id": 428, "speaker": 51, "form": "dlg", "jp": "「写真か何かみたら、絶対わかるって‥‥」"},
{"id": 429, "speaker": 31, "form": "dlg", "jp": "「で、アキラの方は？」"},
{"id": 430, "speaker": 16, "form": "dlg", "jp": "「一応、\n　アイコちゃんに話を聞いてみたんだけど」"},
{"id": 431, "speaker": 16, "form": "dlg", "jp": "「彼女、車のナンバーとか\n　ぜんぜん覚えていないんだって‥‥」"},
{"id": 432, "speaker": 16, "form": "dlg", "jp": "「ただ、寝ていたオジさんの顔は\n　覚えてるって‥‥」"},
{"id": 433, "speaker": 16, "form": "dlg", "jp": "「写真か何かみたら、絶対わかるって‥‥」"},
{"id": 434, "speaker": 31, "form": "dlg", "jp": "「写真を見たらわかるか‥‥」"},
{"id": 435, "speaker": 31, "form": "dlg", "jp": "「写真があるんなら、\n　とっくにとっ捕まえてるって‥‥」"},
{"id": 436, "speaker": 29, "form": "dlg", "jp": "「まあ、そうね‥‥」"},
{"id": 437, "speaker": 29, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 438, "speaker": 29, "form": "dlg", "jp": "「ナゴム、誰か来たわよ！」"},
{"id": 439, "speaker": 2, "form": "dlg", "jp": "「きっとシンちゃんだよ‥‥」"},
{"id": 440, "speaker": 29, "form": "dlg", "jp": "「シンちゃん？」"},
{"id": 441, "speaker": 2, "form": "dlg", "jp": "「友だちだよ‥‥」"},
{"id": 442, "speaker": 2, "form": "dlg", "jp": "「さっき、『ゲームセンターに行こう』って‥‥」"},
{"id": 443, "speaker": 51, "form": "dlg", "jp": "「『ゲームセンター』！？」"},
{"id": 444, "speaker": 51, "form": "dlg", "jp": "「こんな時に！？」"},
{"id": 445, "speaker": 16, "form": "dlg", "jp": "「『ゲームセンター』！？」"},
{"id": 446, "speaker": 16, "form": "dlg", "jp": "「こんな時に！？」"},
{"id": 447, "speaker": 2, "form": "dlg", "jp": "「ボクは断わったんだけど‥‥」"},
{"id": 448, "speaker": 2, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 449, "speaker": 2, "form": "dlg", "jp": "「ちょっとゴメン‥‥」"},
{"id": 450, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 451, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 452, "speaker": 14, "form": "dlg", "jp": "「オッス！」"},
{"id": 453, "speaker": 2, "form": "dlg", "jp": "「シンちゃん！！」"},
{"id": 454, "speaker": 14, "form": "dlg", "jp": "「どうだ、行く決心はついたか？」"},
{"id": 455, "speaker": 2, "form": "dlg", "jp": "「いや、その‥‥」"},
{"id": 456, "speaker": 29, "form": "dlg", "jp": "（行って来なさい‥‥）"},
{"id": 457, "speaker": 29, "form": "dlg", "jp": "それはジーンのテレパシーだった‥‥"},
{"id": 458, "speaker": 2, "form": "dlg", "jp": "（ジーン‥‥）"},
{"id": 459, "speaker": 29, "form": "dlg", "jp": "（あやしまれないためにも、\n　なるべく普段通りふるまった方がいいわ‥‥）"},
{"id": 460, "speaker": 2, "form": "dlg", "jp": "（でも‥‥）"},
{"id": 461, "speaker": 29, "form": "dlg", "jp": "（どうせナゴムはたいした情報を\n　集めてこないんだから‥‥）"},
{"id": 462, "speaker": 2, "form": "dlg", "jp": "（姉さんが襲われるんだろう？）"},
{"id": 463, "speaker": 29, "form": "dlg", "jp": "（心配しなくても、\n　『夢の通り』になるんだったら‥‥）"},
{"id": 464, "speaker": 29, "form": "dlg", "jp": "（ナゴムとアキラは必ず現場に出くわすのよ！）"},
{"id": 465, "speaker": 2, "form": "dlg", "jp": "（そうだけど‥‥）"},
{"id": 466, "speaker": 14, "form": "dlg", "jp": "「どうしたんだよ？」"},
{"id": 467, "speaker": 14, "form": "dlg", "jp": "「オマエ、最近オカシイぞ？」"},
{"id": 468, "speaker": 29, "form": "dlg", "jp": "（ホラ、早く！！）"},
{"id": 469, "speaker": 2, "form": "dlg", "jp": "「な、なんでも無いよ‥‥」"},
{"id": 470, "speaker": 2, "form": "dlg", "jp": "「さあ、行こう！！」"},
{"id": 471, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 472, "speaker": 2, "form": "dlg", "jp": "結局ボクはシンちゃんたちと\n『ゲームセンター』に行くことにした。"},
{"id": 473, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 474, "speaker": 14, "form": "dlg", "jp": "「なあ、本当に何かあったんじゃないのか？」"},
{"id": 475, "speaker": 2, "form": "dlg", "jp": "「な、何がだよ？」"},
{"id": 476, "speaker": 14, "form": "dlg", "jp": "「やっぱ、最近ヘンだぜオマエ？」"},
{"id": 477, "speaker": 2, "form": "dlg", "jp": "「なんにもないよ、ホントに‥‥」"},
{"id": 478, "speaker": 14, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 479, "speaker": 14, "form": "dlg", "jp": "「それならいいんだけど‥‥」"},
{"id": 480, "speaker": 14, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 481, "speaker": 13, "form": "dlg", "jp": "「おそいよ‥‥」"},
{"id": 482, "speaker": 14, "form": "dlg", "jp": "「いや、ナゴムがしぶりやがったから‥‥」"},
{"id": 483, "speaker": 13, "form": "dlg", "jp": "「ナゴムぅー」"},
{"id": 484, "speaker": 13, "form": "dlg", "jp": "「オマエ、『ゲーム』をなめてるんじゃないか？」"},
{"id": 485, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 486, "speaker": 2, "form": "dlg", "jp": "なんだかわからないけどボクはツトムにあやまった。"},
{"id": 487, "speaker": 2, "form": "dlg", "jp": "ツトムがゲームのことでさわぎ始めたら、\n下手に出ておくのが一番だ。"},
{"id": 488, "speaker": 2, "form": "dlg", "jp": "ヘタにさからうと１時間近くは\nゲームについてのレクチャーを聞かされることになる。"},
{"id": 489, "speaker": 13, "form": "dlg", "jp": "「今日のナゴムくんは素直だな‥‥」"},
{"id": 490, "speaker": 13, "form": "dlg", "jp": "「その素直さに免じて\n　今日はオレが対戦相手をつとめてあげよう！」"},
{"id": 491, "speaker": 2, "form": "dlg", "jp": "「ヤだよ‥‥」"},
{"id": 492, "speaker": 2, "form": "dlg", "jp": "「ツトム相手に勝てるわけないだろう！」"},
{"id": 493, "speaker": 13, "form": "dlg", "jp": "「安心しろ、手かげんはしてやるから‥‥」"},
{"id": 494, "speaker": 13, "form": "dlg", "jp": "「じゃあ、かかって来たまえ‥‥」"},
{"id": 495, "speaker": 13, "form": "dlg", "jp": "「けっ！」"},
{"id": 496, "speaker": 13, "form": "dlg", "jp": "「手かげんされて、勝ってうれしいか？」"},
{"id": 497, "speaker": 2, "form": "dlg", "jp": "「ツトムが勝手に手かげんしたんだろう？」"},
{"id": 498, "speaker": 13, "form": "dlg", "jp": "「とにかく、もう１回勝負だ！！」"},
{"id": 499, "speaker": 2, "form": "dlg", "jp": "「仕方ないなぁ～」"},
{"id": 500, "speaker": 13, "form": "dlg", "jp": "「オイオイ、今度はまぐれ勝ちかよ‥‥」"},
{"id": 501, "speaker": 13, "form": "dlg", "jp": "「よし、今度は本気を出すぞ！」"},
{"id": 502, "speaker": 2, "form": "dlg", "jp": "「おい、まだやるのかよ‥‥」"},
{"id": 503, "speaker": 13, "form": "dlg", "jp": "「まぐれで勝ってうれしいか？」"},
{"id": 504, "speaker": 13, "form": "dlg", "jp": "「とにかく、もう１回勝負だ！！」"},
{"id": 505, "speaker": 2, "form": "dlg", "jp": "「仕方ないなぁ～」"},
{"id": 506, "speaker": 13, "form": "dlg", "jp": "「オマエ、インチキしてないか？」"},
{"id": 507, "speaker": 13, "form": "dlg", "jp": "「シンちゃん、今度はコイツが\n　インチキしないように見張っててくれ！」"},
{"id": 508, "speaker": 2, "form": "dlg", "jp": "「ええ！また‥‥？」"},
{"id": 509, "speaker": 13, "form": "dlg", "jp": "「オレは勝つまで止めないんだよ！」"},
{"id": 510, "speaker": 2, "form": "dlg", "jp": "「いいかげんにしてくれよ～」"},
{"id": 511, "speaker": 13, "form": "dlg", "jp": "「なんだ、せっかく手かげんしてやったのに‥‥」"},
{"id": 512, "speaker": 14, "form": "dlg", "jp": "「ナゴムがゲームでオマエに勝てるわけないだろう？」"},
{"id": 513, "speaker": 13, "form": "dlg", "jp": "「しかたないヤツだなぁ～」"},
{"id": 514, "speaker": 13, "form": "dlg", "jp": "「フフフフフフ‥‥」"},
{"id": 515, "speaker": 13, "form": "dlg", "jp": "「９年早いんだよ！！」"},
{"id": 516, "speaker": 14, "form": "dlg", "jp": "「ナゴムがゲームでオマエに勝てるわけないだろう？」"},
{"id": 517, "speaker": 13, "form": "dlg", "jp": "「しかたないヤツだなぁ～」"},
{"id": 518, "speaker": 14, "form": "dlg", "jp": "「オレが相手してやるよ！」"},
{"id": 519, "speaker": 13, "form": "dlg", "jp": "「よし、かかってきなさい！」"},
{"id": 520, "speaker": 13, "form": "dlg", "jp": "こんなことしてる場合じゃないんだけど‥‥"},
{"id": 521, "speaker": 16, "form": "dlg", "jp": "「アラ、常光寺くん！\n　こんなとこにいたの？」"},
{"id": 522, "speaker": 13, "form": "dlg", "jp": "「ちょーっと待った！！」"},
{"id": 523, "speaker": 13, "form": "dlg", "jp": "「今、『こんな所』って言わなかったか？」"},
{"id": 524, "speaker": 16, "form": "dlg", "jp": "「うるさいわね！」"},
{"id": 525, "speaker": 16, "form": "dlg", "jp": "「今はアンタにかまってる場合じゃないの！」"},
{"id": 526, "speaker": 13, "form": "dlg", "jp": "「ゆるせないなぁ、神聖なる\n　『ゲームセンター』をそんな風に言うのは！」"},
{"id": 527, "speaker": 16, "form": "dlg", "jp": "「何が『神聖なる』ゲームセンターよ‥‥」"},
{"id": 528, "speaker": 16, "form": "dlg", "jp": "「『神聖なるアキラ』に軽々しく話しかけないで！」"},
{"id": 529, "speaker": 14, "form": "dlg", "jp": "「ハハハハハハハ‥‥」"},
{"id": 530, "speaker": 14, "form": "dlg", "jp": "「ツトム、オマエの負けだな‥‥」"},
{"id": 531, "speaker": 13, "form": "dlg", "jp": "「けっ、ゲーム以外で負けても\n　ぜんぜんくやしくないよ！」"},
{"id": 532, "speaker": 14, "form": "dlg", "jp": "「で、ナゴムになんか用か？」"},
{"id": 533, "speaker": 16, "form": "dlg", "jp": "「ちょっとね！」"},
{"id": 534, "speaker": 16, "form": "dlg", "jp": "「とりあえず、アキラは急いでるのよ！」"},
{"id": 535, "speaker": 16, "form": "dlg", "jp": "「さあ、行きましょう！」"},
{"id": 536, "speaker": 13, "form": "dlg", "jp": "「早く、行っちゃってくれ！」"},
{"id": 537, "speaker": 2, "form": "dlg", "jp": "「あ、ああ‥‥」"},
{"id": 538, "speaker": 14, "form": "dlg", "jp": "「じゃあな‥‥」"},
{"id": 539, "speaker": 51, "form": "dlg", "jp": "「なんや、\n　アンタらまたこんな所で遊んでるんかいな？」"},
{"id": 540, "speaker": 14, "form": "dlg", "jp": "「なんだ、小田か‥‥」"},
{"id": 541, "speaker": 13, "form": "dlg", "jp": "「ちょーっと待った！！」"},
{"id": 542, "speaker": 13, "form": "dlg", "jp": "「今、『こんな所』って言わなかったか？」"},
{"id": 543, "speaker": 51, "form": "dlg", "jp": "「ゆーたよ？」"},
{"id": 544, "speaker": 51, "form": "dlg", "jp": "「それがどうかしたん？」"},
{"id": 545, "speaker": 13, "form": "dlg", "jp": "「ゆるせないなぁ、神聖なる\n　『ゲームセンター』をそんな風に言うのは！」"},
{"id": 546, "speaker": 51, "form": "dlg", "jp": "「ゆるせないってどうするつもり？」"},
{"id": 547, "speaker": 13, "form": "dlg", "jp": "「倒してやる！！」"},
{"id": 548, "speaker": 13, "form": "dlg", "jp": "「さあ、コインを入れてかかってきなさい！」"},
{"id": 549, "speaker": 51, "form": "dlg", "jp": "「イヤやって！　バカらしい‥‥」"},
{"id": 550, "speaker": 13, "form": "dlg", "jp": "「なんだとぉう！」"},
{"id": 551, "speaker": 51, "form": "dlg", "jp": "「ウチはアンタには用はないの！」"},
{"id": 552, "speaker": 51, "form": "dlg", "jp": "「さあ、行くで！」"},
{"id": 553, "speaker": 51, "form": "dlg", "jp": "小田はボクの腕を引っ張った。"},
{"id": 554, "speaker": 14, "form": "dlg", "jp": "「おい、ナゴムをどうするつもりだ？」"},
{"id": 555, "speaker": 51, "form": "dlg", "jp": "「どうもせぇへんわっ！」"},
{"id": 556, "speaker": 51, "form": "dlg", "jp": "「常光寺のお父さんに、\n　連れて来てくれって言われたんよ」"},
{"id": 557, "speaker": 14, "form": "dlg", "jp": "「オジさんが？」"},
{"id": 558, "speaker": 14, "form": "dlg", "jp": "「何かあったのか？」"},
{"id": 559, "speaker": 51, "form": "dlg", "jp": "「そんなん知らんわ！」"},
{"id": 560, "speaker": 51, "form": "dlg", "jp": "「イタズラでもしたんちゃうのん？」"},
{"id": 561, "speaker": 13, "form": "dlg", "jp": "「しょうがないヤツだなぁ～」"},
{"id": 562, "speaker": 13, "form": "dlg", "jp": "「ホラ、行ってこいよ！」"},
{"id": 563, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 564, "speaker": 51, "form": "dlg", "jp": "「ホラ、急いで‥‥」"},
{"id": 565, "speaker": 51, "form": "dlg", "jp": "ボクはゲームセンターを後にした。"}
]
