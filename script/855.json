{"id": 36, "speaker": null, "form": "dlg", "jp": "アキラです。"},
{"id": 37, "speaker": null, "form": "dlg", "jp": "トモです。"},
{"id": 38, "speaker": null, "form": "dlg", "jp": "ナナセです。"},
{"id": 39, "speaker": null, "form": "dlg", "jp": "ジーンを気にする？"},
{"id": 40, "speaker": null, "form": "choice", "jp": "【しない】"},
{"id": 41, "speaker": null, "form": "choice", "jp": "【する】"},
{"id": 42, "speaker": null, "form": "dlg", "jp": "【しない】"},
{"id": 43, "speaker": null, "form": "dlg", "jp": "【する】"},
{"id": 44, "speaker": null, "form": "dlg", "jp": "ではゲームスタート！"},
{"id": 45, "speaker": null, "form": "dlg", "jp": "２００５／０８／１８／ＰＭ０７：４０"},
{"id": 46, "speaker": null, "form": "dlg", "jp": "ルードの残党たちによる\n『ホテルジャック』は失敗に終わり、"},
{"id": 47, "speaker": null, "form": "dlg", "jp": "こんどこそボクはルードの脅威（キョウイ）から\n解放されることになった。"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "（ねえ、どうしてここに集まるんだよ？）"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "（ジーンたちの部屋でいいじゃないか‥‥）"},
{"id": 50, "speaker": 31, "form": "dlg", "jp": "（アソコは大人数が座るにはせまいだろう？）"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "（でも、姉さんたちに気付かれたら‥‥）"},
{"id": 52, "speaker": 31, "form": "dlg", "jp": "（ここなら、日本ならではの\n　どこでも座れる床があるし‥‥）"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "（それなら、アイコの家でも‥‥）"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "（それなら、長尾の家でも‥‥）"},
{"id": 55, "speaker": 16, "form": "dlg", "jp": "（ウチは別に大丈夫よ！）"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "（それなら、堤さんの家でも‥‥）"},
{"id": 57, "speaker": 18, "form": "dlg", "jp": "（ウチは別に問題ないケド‥‥）"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "（それなら、小田の家でも‥‥）"},
{"id": 59, "speaker": 51, "form": "dlg", "jp": "（ウチはアカンで！）"},
{"id": 60, "speaker": 31, "form": "dlg", "jp": "（女の子の部屋はマズイだろう‥‥）"},
{"id": 61, "speaker": 29, "form": "dlg", "jp": "（ナゴムは男のくせに細かいことを気にしすぎるのよ！）"},
{"id": 62, "speaker": 31, "form": "dlg", "jp": "（それより、新しい情報は？）"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "（ぜんぜん‥‥）"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "（だいたい、フツーの中学生なんだから、\n　『情報』っていっても‥‥）"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "（でも、ナゴムたちはこの国の人間なんだから、\n　私たちよりは動きやすいんじゃない？）"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "（アイコ、何か新しい予知夢みてない？）"},
{"id": 67, "speaker": 15, "form": "dlg", "jp": "（見たのは見たけど‥‥）"},
{"id": 68, "speaker": 31, "form": "dlg", "jp": "（どんな夢だ！？）"},
{"id": 69, "speaker": 15, "form": "dlg", "jp": "（ここにこうして集まる夢‥‥）"},
{"id": 70, "speaker": 31, "form": "dlg", "jp": "（その夢にどんな意味があるんだ？）"},
{"id": 71, "speaker": 15, "form": "dlg", "jp": "（夢の中でもその台詞言ってた！！）"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "（アキラ、何か新しい予知夢みてない？）"},
{"id": 74, "speaker": 16, "form": "dlg", "jp": "（見たわよ！）"},
{"id": 75, "speaker": 31, "form": "dlg", "jp": "（どんな夢だ！？）"},
{"id": 76, "speaker": 16, "form": "dlg", "jp": "（ここにこうして集まる夢‥‥）"},
{"id": 77, "speaker": 31, "form": "dlg", "jp": "（その夢にどんな意味があるんだ？）"},
{"id": 78, "speaker": 16, "form": "dlg", "jp": "（夢の中でもその台詞言ってた！！）"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 80, "speaker": 18, "form": "dlg", "jp": "（もしかして、『不法入国』なんですか？）"},
{"id": 81, "speaker": 31, "form": "dlg", "jp": "（まあな‥‥）"},
{"id": 82, "speaker": 18, "form": "dlg", "jp": "（それって、警察にみつかると‥‥）"},
{"id": 83, "speaker": 29, "form": "dlg", "jp": "（だから、アナタたちにもっと\n　情報集めをして欲しいのよ！）"},
{"id": 84, "speaker": 18, "form": "dlg", "jp": "（はあ‥‥）"},
{"id": 85, "speaker": 51, "form": "dlg", "jp": "（もしかして、『不法入国』？）"},
{"id": 86, "speaker": 31, "form": "dlg", "jp": "（まあな‥‥）"},
{"id": 87, "speaker": 51, "form": "dlg", "jp": "（それってメチャメチャマズイやん！）"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "（だから、アナタたちにもっと\n　情報集めをして欲しいのよ！）"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "（小田んところって、\n　代々『能力』を引き継いできたってことは）"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "（家族とか親戚とかに\n　『能力者』がいるんじゃぁ？）"},
{"id": 91, "speaker": 51, "form": "dlg", "jp": "（それがオランねん！）"},
{"id": 92, "speaker": 51, "form": "dlg", "jp": "（たぶん、死んだジイさんだけやったんちゃうかな？）"},
{"id": 93, "speaker": 51, "form": "dlg", "jp": "（常光寺のところも\n　お母さんが超能力者やったんやろう？）"},
{"id": 94, "speaker": 51, "form": "dlg", "jp": "（それこそ家族とか親戚とかに‥‥）"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "（ウチもいないよ‥‥）"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "（本部からの情報はないの？）"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "（ないわ‥‥）"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "（そう‥‥‥）"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "（今日のところは解散しましょう‥‥）"},
{"id": 100, "speaker": 31, "form": "dlg", "jp": "（うん、そうだな‥‥）"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "（とにかく、『能力者』は普通の存在とは違うから\n　活動すればきっと普通じゃないことが起きるはずなの）"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "（２人とも『普通じゃないこと』に注意してね！）"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "（わかった！）"},
{"id": 104, "speaker": 31, "form": "dlg", "jp": "（じゃあな！）"},
{"id": 105, "speaker": 31, "form": "dlg", "jp": "「シュン！」"},
{"id": 106, "speaker": 31, "form": "dlg", "jp": "２人はこの前の夜のように\n窓から飛んでいってしまった。"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「ゴメン、暗くなっちゃったね‥‥」"},
{"id": 108, "speaker": 15, "form": "dlg", "jp": "「ねえ、ウチまで送ってよ！」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「って、すぐ隣じゃないか！」"},
{"id": 110, "speaker": 15, "form": "dlg", "jp": "「最近"},
{"id": 111, "speaker": 15, "form": "dlg", "jp": "『あの事件』"},
{"id": 112, "speaker": 15, "form": "dlg", "jp": "のこともあるし‥‥」"},
{"id": 113, "speaker": 15, "form": "dlg", "jp": "「玄関を出たとたんにさらわれるってことも‥‥」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「そんなワケないだろう？」"},
{"id": 115, "speaker": 15, "form": "dlg", "jp": "「わからないでしょう！」"},
{"id": 116, "speaker": 15, "form": "dlg", "jp": "「なんか、キモチ悪いのよ‥‥」"},
{"id": 117, "speaker": 15, "form": "dlg", "jp": "「いいじゃない、近くなんだから‥‥」"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「仕方ないなぁ‥‥」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「ゴメンね、暗くなっちゃったね‥‥」"},
{"id": 120, "speaker": 16, "form": "dlg", "jp": "「常光寺くんがあやまらなくても‥‥」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 122, "speaker": 16, "form": "dlg", "jp": "「でも、こう暗くなると１人で帰るの気持ち悪いな～」"},
{"id": 123, "speaker": 16, "form": "dlg", "jp": "「最近"},
{"id": 124, "speaker": 16, "form": "dlg", "jp": "『あの事件』"},
{"id": 125, "speaker": 16, "form": "dlg", "jp": "のこともあるし‥‥」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「送って行くよ！」"},
{"id": 127, "speaker": 16, "form": "dlg", "jp": "「本当！！」"},
{"id": 128, "speaker": 16, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "「ゴメンね、暗くなっちゃったね‥‥」"},
{"id": 130, "speaker": 18, "form": "dlg", "jp": "「どうしてあやまるの？」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "「とりあえず、送って行くよ！」"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "「最近"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "『あの事件』"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "もあるし‥‥」"},
{"id": 136, "speaker": 18, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「ゴメンね、暗くなっちゃったね‥‥」"},
{"id": 138, "speaker": 51, "form": "dlg", "jp": "「別に常光寺があやまることじゃないやん！」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「とりあえず、送って行くよ」"},
{"id": 141, "speaker": 51, "form": "dlg", "jp": "「ええよ、ウチの方が破壊力があるんだから‥‥」"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「でも、『生きてる物』には使えないんだろう？」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「チカンとかに襲われたらどうする？」"},
{"id": 144, "speaker": 51, "form": "dlg", "jp": "「フツーの人間が相手やったら、\n　『奥義』なしでも勝てるって！」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「さっき、ジーンが言ってただろう、\n　『普通じゃないこと』に気をつけろって‥‥」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「それに、最近"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "『あの事件』"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "もあるし‥‥」"},
{"id": 149, "speaker": 51, "form": "dlg", "jp": "「イヤなこと言うな‥‥」"},
{"id": 150, "speaker": 51, "form": "dlg", "jp": "『あの事件』"},
{"id": 151, "speaker": 51, "form": "dlg", "jp": "‥‥"},
{"id": 152, "speaker": 51, "form": "dlg", "jp": "『少女』が『大人の男』に誘拐される事件‥‥"},
{"id": 153, "speaker": 51, "form": "dlg", "jp": "最近、頻発（ヒンパツ）しているイヤな事件だ。"},
{"id": 154, "speaker": 51, "form": "dlg", "jp": "世間はこの事件をフツーだとは思っていないらしく、\nマスコミはセンセーショナルな報道の仕方をしている。"},
{"id": 155, "speaker": 51, "form": "dlg", "jp": "そのワケは犯行の動機が営利目的ではなく\n『トモダチが欲しかった』という理由だったりするからだ。"},
{"id": 156, "speaker": 51, "form": "dlg", "jp": "大人が子供の友だちを欲しがるんだから\nとても普通ではないんだけど‥‥"},
{"id": 157, "speaker": 51, "form": "dlg", "jp": "ボクたちからすれば『フツーの事件』でしかない。"},
{"id": 158, "speaker": 51, "form": "dlg", "jp": "なぜ『フツー』かというと、ほとんどの事件が\nすでに犯人が捕まって解決しており、"},
{"id": 159, "speaker": 51, "form": "dlg", "jp": "それぞれが別々の犯人だからだ‥‥"},
{"id": 160, "speaker": 51, "form": "dlg", "jp": "つまり、『警察が解決する事件』であり、\nボクたちが探している『フツーではない』とは違う。"},
{"id": 161, "speaker": 51, "form": "dlg", "jp": "こうしてボクはアイコを家の前まで\n送ることになった。"},
{"id": 162, "speaker": 15, "form": "dlg", "jp": "「本当に『クリエーター』って襲ってくるのかな？」"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「ジーンの話ではもう襲ってきてるんだって‥‥」"},
{"id": 164, "speaker": 15, "form": "dlg", "jp": "「ぜんぜん、実感がわかないんだけど‥‥」"},
{"id": 165, "speaker": 15, "form": "dlg", "jp": "「人類が滅亡するっていうのに‥‥」"},
{"id": 166, "speaker": 15, "form": "dlg", "jp": "こうしてボクは長尾を送って帰ることになった。"},
{"id": 167, "speaker": 16, "form": "dlg", "jp": "「本当に『クリエーター』って襲ってくるのかな？」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「ジーンの話ではもう襲ってきてるんだって‥‥」"},
{"id": 169, "speaker": 16, "form": "dlg", "jp": "「ぜんぜん、実感がわかないんだけど‥‥」"},
{"id": 170, "speaker": 16, "form": "dlg", "jp": "「人類が滅亡するっていうのに‥‥」"},
{"id": 171, "speaker": 16, "form": "dlg", "jp": "こうしてボクは堤さんを送ることになった。"},
{"id": 172, "speaker": 18, "form": "dlg", "jp": "「本当に『クリエーター』って襲ってくるのかな？」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「ジーンの話ではもう襲ってきてるんだって‥‥」"},
{"id": 174, "speaker": 18, "form": "dlg", "jp": "「ぜんぜん、実感がわかないんだけど‥‥」"},
{"id": 175, "speaker": 18, "form": "dlg", "jp": "「人類が滅亡するっていうのに‥‥」"},
{"id": 176, "speaker": 18, "form": "dlg", "jp": "こうしてボクは小田を送ることになった。"},
{"id": 177, "speaker": 51, "form": "dlg", "jp": "「本当に『クリエーター』って襲ってくるんかな？」"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「ジーンの話ではもう襲ってきてるんだって‥‥」"},
{"id": 179, "speaker": 51, "form": "dlg", "jp": "「ぜんぜん、実感わかへんよなぁ？」"},
{"id": 180, "speaker": 51, "form": "dlg", "jp": "「人類が滅亡するっていうのに‥‥」"},
{"id": 181, "speaker": 51, "form": "choice", "jp": "「そうかな？」"},
{"id": 182, "speaker": 51, "form": "choice", "jp": "「そうだね‥‥」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「そうかな？」"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「ボクは恐怖を感じるけど‥‥」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "「まあ、ボクの場合はこないだまで\n　いろいろあったからかな？」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「それよりも、ルードの方がよっぽど恐く思ったよ」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「これって、災害のニュースとか見ても\n　ピンとこないのと同じなんだろうね」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "その時！"},
{"id": 190, "speaker": 4, "form": "dlg", "jp": "「ナゴム！」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「シンちゃん？」"},
{"id": 192, "speaker": 14, "form": "dlg", "jp": "「なんだ、夜のデートか？」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「な、何言ってるんだよ！」"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "「暗くなったから送ってあげてるんだよ！」"},
{"id": 195, "speaker": 15, "form": "dlg", "jp": "「やいてるの？」"},
{"id": 196, "speaker": 14, "form": "dlg", "jp": "「バカ、そんなわけないだろう？」"},
{"id": 197, "speaker": 14, "form": "dlg", "jp": "「そんなことより、オマエら明日あいてるか？」"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 199, "speaker": 14, "form": "dlg", "jp": "「ああ、『遊園地のチケット』が手に入ったんだよ」"},
{"id": 200, "speaker": 14, "form": "dlg", "jp": "「ヒマなんだったら、いっしょに行かないか？」"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "「明日？」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "（どうする？\n　ボクはヒマなんだけど‥‥）"},
{"id": 203, "speaker": 15, "form": "dlg", "jp": "（でも、『仲間探し』が‥‥）"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "（そんなことシンちゃんには言えないだろう？）"},
{"id": 205, "speaker": 15, "form": "dlg", "jp": "（そうね‥‥）"},
{"id": 206, "speaker": 15, "form": "dlg", "jp": "「ええ、私はヒマよ‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「ボ、ボクも‥‥」"},
{"id": 208, "speaker": 14, "form": "dlg", "jp": "「じゃあ、三船は他の女の子にも\n　連絡回しておいてよ！」"},
{"id": 209, "speaker": 15, "form": "dlg", "jp": "「うん、わかった！」"},
{"id": 210, "speaker": 16, "form": "dlg", "jp": "「恋人同士みたいに見えた？」"},
{"id": 211, "speaker": 14, "form": "dlg", "jp": "「冗談だよ！」"},
{"id": 212, "speaker": 14, "form": "dlg", "jp": "「そんなことより、オマエら明日あいてるか？」"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 214, "speaker": 14, "form": "dlg", "jp": "「ああ、『遊園地のチケット』が手に入ったんだよ」"},
{"id": 215, "speaker": 14, "form": "dlg", "jp": "「ヒマなんだったら、いっしょに行かないか？」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「明日？」"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "（どうする？\n　ボクはヒマなんだけど‥‥）"},
{"id": 218, "speaker": 16, "form": "dlg", "jp": "「大丈夫、アキラはヒマよ！」"},
{"id": 219, "speaker": 16, "form": "dlg", "jp": "「常光寺くんもヒマだって！！」"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "（オイ！\n　何勝手に答えてるんだよ！！）"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "（仲間探しはどうするんだよ！）"},
{"id": 222, "speaker": 16, "form": "dlg", "jp": "（でも、そんなの説明できないでしょう！）"},
{"id": 223, "speaker": 16, "form": "dlg", "jp": "（常光寺くんうまくごまかせる？）"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "（ムリかも‥‥）"},
{"id": 225, "speaker": 16, "form": "dlg", "jp": "（そうでしょう？）"},
{"id": 226, "speaker": 14, "form": "dlg", "jp": "「じゃあ、長尾は他の女の子にも\n　連絡回しておいてよ！」"},
{"id": 227, "speaker": 16, "form": "dlg", "jp": "「まかせておいて！」"},
{"id": 228, "speaker": 18, "form": "dlg", "jp": "「ホ、ホントウよ！」"},
{"id": 229, "speaker": 14, "form": "dlg", "jp": "「そんなことより、オマエら明日あいてるか？」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 231, "speaker": 14, "form": "dlg", "jp": "「ああ、『遊園地のチケット』が手に入ったんだよ」"},
{"id": 232, "speaker": 14, "form": "dlg", "jp": "「ヒマなんだったら、いっしょに行かないか？」"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "「明日？」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "（どうする？\n　ボクはヒマなんだけど‥‥）"},
{"id": 235, "speaker": 18, "form": "dlg", "jp": "（私も大丈夫だけど『仲間探し』をしないと‥‥）"},
{"id": 236, "speaker": 18, "form": "dlg", "jp": "（常光寺くんうまくごまかせる？）"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "（ムリかも‥‥）"},
{"id": 238, "speaker": 18, "form": "dlg", "jp": "（しかたないわね‥‥）"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「あ、あいてるけど‥‥」"},
{"id": 240, "speaker": 18, "form": "dlg", "jp": "「わ、ワタシも‥‥」"},
{"id": 241, "speaker": 14, "form": "dlg", "jp": "「じゃあ、堤は他の女の子にも\n　連絡回しておいてよ！」"},
{"id": 242, "speaker": 18, "form": "dlg", "jp": "「う、うん！」"},
{"id": 243, "speaker": 51, "form": "dlg", "jp": "「うらやましいんか？」"},
{"id": 244, "speaker": 14, "form": "dlg", "jp": "「そういう切り返しができるオマエの性格が\n　うらやましいよ！」"},
{"id": 245, "speaker": 51, "form": "dlg", "jp": "「『切り返し』は剣道の基本や！」"},
{"id": 246, "speaker": 14, "form": "dlg", "jp": "「その話術もな‥‥」"},
{"id": 247, "speaker": 51, "form": "dlg", "jp": "「『始めに言葉ありき』‥‥」"},
{"id": 248, "speaker": 51, "form": "dlg", "jp": "「人間と動物の１番の違いは\n　『言葉』を持ってるか持ってないかや」"},
{"id": 249, "speaker": 51, "form": "dlg", "jp": "「『言葉』が操れないヤツは『人間失格』や！」"},
{"id": 250, "speaker": 14, "form": "dlg", "jp": "「正確には『芸人失格』だろう？」"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "「そうかな、パントマイムとかあるから\n　『関西芸人失格』とか‥‥」"},
{"id": 252, "speaker": 14, "form": "dlg", "jp": "「そうだな！」"},
{"id": 253, "speaker": 14, "form": "dlg", "jp": "「だいたい方言で話してる時点で\n　『言葉』を操れてるとは言えないな‥‥」"},
{"id": 254, "speaker": 51, "form": "dlg", "jp": "「はぁ？」"},
{"id": 255, "speaker": 51, "form": "dlg", "jp": "「『方言』って言うのは『地方の言葉』ってことやで？」"},
{"id": 256, "speaker": 51, "form": "dlg", "jp": "「関西は『地方』とちゃうで！」"},
{"id": 257, "speaker": 51, "form": "dlg", "jp": "「そもそも、飛鳥時代から１０００年以上\n　日本の中心は関西やで？」"},
{"id": 258, "speaker": 51, "form": "dlg", "jp": "「関東が中心の時代って数百年やろう？」"},
{"id": 259, "speaker": 51, "form": "dlg", "jp": "「百と千、どっちが大きいかわかるやろう？」"},
{"id": 260, "speaker": 51, "form": "dlg", "jp": "「算数もできひんのか？」"},
{"id": 261, "speaker": 14, "form": "dlg", "jp": "「オマエの理論じゃあ、\n　ゴール真際までずっと１位だった選手が」"},
{"id": 262, "speaker": 14, "form": "dlg", "jp": "「ゴールで抜かされても１位だっていうことになるな‥‥」"},
{"id": 263, "speaker": 51, "form": "dlg", "jp": "「日本の歴史はもうゴールなんか？」"},
{"id": 264, "speaker": 51, "form": "dlg", "jp": "「また、関西が抜き返すかもしらんやろう！」"},
{"id": 265, "speaker": 14, "form": "dlg", "jp": "「ナゴム、止めてくれよ！」"},
{"id": 266, "speaker": 14, "form": "choice", "jp": "「もういいよ！」"},
{"id": 267, "speaker": 14, "form": "choice", "jp": "「もうええわ！」"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "「もういいよ！」"},
{"id": 269, "speaker": 51, "form": "dlg", "jp": "「何ソレ？」"},
{"id": 270, "speaker": 51, "form": "dlg", "jp": "「それじゃあ、終わられへんやん！」"},
{"id": 271, "speaker": 51, "form": "dlg", "jp": "「終わりの合図は、\n　『モウエエワ！』か『エエカゲンニセエ！』やろう？」"},
{"id": 272, "speaker": 51, "form": "dlg", "jp": "「ホンマにセンスないんやから‥‥」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「もうええわ！」"},
{"id": 274, "speaker": 51, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 275, "speaker": 14, "form": "dlg", "jp": "「本当に止まったぜ！？」"},
{"id": 276, "speaker": 14, "form": "dlg", "jp": "「そんなことより、オマエら明日あいてるか？」"},
{"id": 277, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 278, "speaker": 14, "form": "dlg", "jp": "「ああ、『遊園地のチケット』が手に入ったんだよ」"},
{"id": 279, "speaker": 14, "form": "dlg", "jp": "「ヒマなんだったら、いっしょに行かないか？」"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "「明日？」"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "（どうする？\n　ボクはヒマなんだけど‥‥）"},
{"id": 282, "speaker": 51, "form": "dlg", "jp": "（ウチもヒマやけど、『仲間探し』もあるしなぁ‥‥）"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "（断わる？）"},
{"id": 284, "speaker": 51, "form": "dlg", "jp": "（それも不自然やしな～～）"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "（どうしようか？）"},
{"id": 286, "speaker": 51, "form": "dlg", "jp": "「ええよ！」"},
{"id": 287, "speaker": 51, "form": "dlg", "jp": "「常光寺もヒマやって言ってたし‥‥」"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "（オイ！）"},
{"id": 289, "speaker": 51, "form": "dlg", "jp": "（ヘンに断わったら怪しまれるやろう！）"},
{"id": 290, "speaker": 14, "form": "dlg", "jp": "「じゃあ、小田は他の女の子にも\n　連絡回しておいて！」"},
