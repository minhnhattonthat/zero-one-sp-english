[
{"id": 0, "speaker": null, "form": "dlg", "jp": "まず、クラブを選びます。"},
{"id": 1, "speaker": null, "form": "choice", "jp": "【運動部】"},
{"id": 2, "speaker": null, "form": "choice", "jp": "【文化部】"},
{"id": 3, "speaker": null, "form": "choice", "jp": "【入らない】"},
{"id": 4, "speaker": null, "form": "dlg", "jp": "【運動部】"},
{"id": 5, "speaker": null, "form": "dlg", "jp": "運動部の何部？"},
{"id": 6, "speaker": null, "form": "choice", "jp": "【野球部】"},
{"id": 7, "speaker": null, "form": "choice", "jp": "【サッカー部】"},
{"id": 8, "speaker": null, "form": "choice", "jp": "【格闘部】"},
{"id": 9, "speaker": null, "form": "dlg", "jp": "【野球部】"},
{"id": 10, "speaker": null, "form": "dlg", "jp": "野球部に入っています。"},
{"id": 11, "speaker": null, "form": "dlg", "jp": "【サッカー部】"},
{"id": 12, "speaker": null, "form": "dlg", "jp": "サッカー部に入っています。"},
{"id": 13, "speaker": null, "form": "dlg", "jp": "【格闘部】"},
{"id": 14, "speaker": null, "form": "dlg", "jp": "格闘部に入っています。"},
{"id": 15, "speaker": null, "form": "dlg", "jp": "【文化部】"},
{"id": 16, "speaker": null, "form": "dlg", "jp": "文化部の何部？"},
{"id": 17, "speaker": null, "form": "choice", "jp": "【科学部】"},
{"id": 18, "speaker": null, "form": "choice", "jp": "【マンガ部】"},
{"id": 19, "speaker": null, "form": "dlg", "jp": "【科学部】"},
{"id": 20, "speaker": null, "form": "dlg", "jp": "科学部に入っています。"},
{"id": 21, "speaker": null, "form": "dlg", "jp": "【マンガ部】"},
{"id": 22, "speaker": null, "form": "dlg", "jp": "マンガ部に入っています。"},
{"id": 23, "speaker": null, "form": "dlg", "jp": "【入らない】"},
{"id": 24, "speaker": null, "form": "dlg", "jp": "クラブには入っていません。"},
{"id": 25, "speaker": null, "form": "dlg", "jp": "パートナーを選びます。"},
{"id": 26, "speaker": null, "form": "dlg", "jp": "運動部以外は次の３人が候補です。"},
{"id": 27, "speaker": null, "form": "choice", "jp": "【アイコ】"},
{"id": 28, "speaker": null, "form": "choice", "jp": "【アキラ】"},
{"id": 29, "speaker": null, "form": "choice", "jp": "【ナナセ】"},
{"id": 30, "speaker": null, "form": "dlg", "jp": "パートナーを選びます。"},
{"id": 31, "speaker": null, "form": "dlg", "jp": "運動部の場合は次の３人が候補です。"},
{"id": 32, "speaker": null, "form": "choice", "jp": "【アイコ】"},
{"id": 33, "speaker": null, "form": "choice", "jp": "【アキラ】"},
{"id": 34, "speaker": null, "form": "choice", "jp": "【トモ】"},
{"id": 35, "speaker": null, "form": "dlg", "jp": "アイコです。"},
{"id": 36, "speaker": null, "form": "dlg", "jp": "アキラです。"},
{"id": 37, "speaker": null, "form": "dlg", "jp": "トモです。"},
{"id": 38, "speaker": null, "form": "dlg", "jp": "ナナセです。"},
{"id": 39, "speaker": null, "form": "dlg", "jp": "ジーンを気にする？"},
{"id": 40, "speaker": null, "form": "choice", "jp": "【しない】"},
{"id": 41, "speaker": null, "form": "choice", "jp": "【する】"},
{"id": 42, "speaker": null, "form": "dlg", "jp": "【しない】"},
{"id": 43, "speaker": null, "form": "dlg", "jp": "【する】"},
{"id": 44, "speaker": null, "form": "dlg", "jp": "ではゲームスタート！"},
{"id": 45, "speaker": null, "form": "dlg", "jp": "２００５／０８／２４／ＡＭ１０：４０"},
{"id": 46, "speaker": 58, "form": "dlg", "jp": "「どうもゴチソウサマでした‥‥」"},
{"id": 47, "speaker": 3, "form": "dlg", "jp": "「いいえ、どういたしまして‥‥」"},
{"id": 48, "speaker": 26, "form": "dlg", "jp": "「本当にスミマセンね‥‥」"},
{"id": 49, "speaker": 3, "form": "dlg", "jp": "「気にしないでください」"},
{"id": 50, "speaker": 3, "form": "dlg", "jp": "「いつも、父さんが世話になってるんですから‥‥」"},
{"id": 51, "speaker": 26, "form": "dlg", "jp": "「いえいえ、\n　世話になってるのはボクの方ですから‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「そんなこと言うのは三田さんぐらいだよ‥‥」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "あれから３日が過ぎた‥‥"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "未だに『清田さん』は見つかっていない‥‥"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "ジーンたちが言うように清田さんや\n五島マサシの精神が破壊されたのならば、"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "『清田さんの肉体』が勝手に動くことは\nないはずなんだけど‥‥"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "とにかくイヤな事件だ‥‥"},
{"id": 59, "speaker": 3, "form": "dlg", "jp": "「じゃあ、オヤスミナサイ」"},
{"id": 60, "speaker": 58, "form": "dlg", "jp": "「ハイ、オヤスミナサイ」"},
{"id": 61, "speaker": 58, "form": "dlg", "jp": "「じゃあね！」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "「うん、バイバイ！！」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "まあ、マイちゃんが明るくふるまってくれるのが\n唯一の救いだ‥‥"},
{"id": 64, "speaker": 3, "form": "dlg", "jp": "「本当にどこへ行っちゃったのかしら？」"},
{"id": 65, "speaker": 3, "form": "dlg", "jp": "「清田さん‥‥」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「さあ‥‥」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "警察は失そう前の状況と、\nあの常人では理解不可能な『機械』から"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "清田さんは実験の失敗で正気を失い、\n失そうしたと判断したようだ。"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "マイちゃんも、その見解に納得しているらしく"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "小さいながら新しい生活に溶け込もうと\n明るくふるまっているようだった。"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 73, "speaker": 31, "form": "dlg", "jp": "（元気そうじゃないか）"},
{"id": 74, "speaker": 31, "form": "dlg", "jp": "（あの子‥‥）"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 76, "speaker": 31, "form": "dlg", "jp": "（兄さんがいなくなった方が良かったんじゃないか？）"},
{"id": 77, "speaker": 31, "form": "dlg", "jp": "（なんか、前より明るくなったように見えるぞ？）"},
{"id": 78, "speaker": 29, "form": "dlg", "jp": "（そんなワケないでしょう！！）"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "（アレは新しい環境に早くうちとけるために\n　ムリして明るくふるまってるのよ！）"},
{"id": 80, "speaker": 31, "form": "dlg", "jp": "（そうなのか？）"},
{"id": 81, "speaker": 29, "form": "dlg", "jp": "（あの子の歳じゃあ、\n　１人では生きてゆけないから）"},
{"id": 82, "speaker": 29, "form": "dlg", "jp": "（周りの大人に気に入られるように必死なのよ！！）"},
{"id": 83, "speaker": 31, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "（ねえ、\n　本当にジーンの能力で清田さんを探せないの？）"},
{"id": 85, "speaker": 29, "form": "dlg", "jp": "（見つけてあげたいのはヤマヤマだけど‥‥）"},
{"id": 86, "speaker": 29, "form": "dlg", "jp": "（今はそれだけに集中できないから‥‥）"},
{"id": 87, "speaker": 31, "form": "dlg", "jp": "（‥‥‥‥‥‥！！）"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "（どうかしたの？）"},
{"id": 89, "speaker": 31, "form": "dlg", "jp": "（いや、ジーンらしくない台詞だと思って‥‥）"},
{"id": 90, "speaker": 31, "form": "dlg", "jp": "（いつものジーンなら）"},
{"id": 91, "speaker": 31, "form": "dlg", "jp": "（『そんなコトより仲間探しが先決よ！！』）"},
{"id": 92, "speaker": 31, "form": "dlg", "jp": "（とか冷たく言いそうなのに‥‥）"},
{"id": 93, "speaker": 29, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "（そ、そのとおりよ！！）"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "（早くしないと、『クリエーター』の攻撃が‥‥）"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "（どうかしたの？）"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "（ええ‥‥）"},
{"id": 98, "speaker": 29, "form": "dlg", "jp": "（以前から、『クリエーターの攻撃』はあったんだけど‥‥）"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "（あったの！？）"},
{"id": 100, "speaker": 31, "form": "dlg", "jp": "（前にも言っただろう‥‥）"},
{"id": 101, "speaker": 31, "form": "dlg", "jp": "（世界中でちょこちょこ機械が狂うって‥‥）"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "（そ、そうだったね‥‥）"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "（それの規模がだんだんと大きくなってきてるの）"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "（今までは小さな被害しか出てなかったけど‥‥）"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "（大きな被害が出始めてるの？‥）"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "（あの『新幹線の事故』をどう思う？）"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "（『新幹線の事故』！？）"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "（最近ずっと『ニュース』でやってるヤツ！？）"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "（じゃあ、こないだの『旅客機』も！？）"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "（たぶんね‥‥）"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "（アレってものスゴイ被害だったんじゃ？）"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "（今回は海に落下したから、\n　アレでも被害は少ない方よ‥‥）"},
{"id": 113, "speaker": 31, "form": "dlg", "jp": "（都会のまん中に落とされたら‥‥）"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥！？）"},
{"id": 115, "speaker": 31, "form": "dlg", "jp": "（あの何倍もの被害になっただろうな‥‥）"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "（とにかく）"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "（早く残りの１人を見つけだして\n　本部のメンバーと合流しないと‥‥）"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "（そうだね‥‥）"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "（手がかりはないの？）"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "（あるわよ‥‥）"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "（ウソ！！）"},
{"id": 122, "speaker": 29, "form": "dlg", "jp": "（本部から連絡があったの‥‥）"},
{"id": 123, "speaker": 29, "form": "dlg", "jp": "（『この町から５０Ｋｍ以内』で\n　『テレポーテーション』が使われたって‥‥）"},
{"id": 124, "speaker": 29, "form": "choice", "jp": "（『この町から５０Ｋｍ以内』？）"},
{"id": 125, "speaker": 29, "form": "choice", "jp": "（『テレポーテーション』？）"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "（『この町から５０Ｋｍ以内』？）"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "（それって近いの？遠いの？）"},
{"id": 128, "speaker": 31, "form": "dlg", "jp": "（そんなに遠くはないな‥‥）"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "（『テレポーテーション』？）"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "（『テレポーテーション』って、\n　あの『瞬間移動』の？）"},
{"id": 131, "speaker": 31, "form": "dlg", "jp": "（他にどの『テレポーテーション』があるんだ？）"},
{"id": 132, "speaker": 29, "form": "dlg", "jp": "（本部では世界中で『能力』が使われる時の\n　『イメージ』を観測しているの‥‥）"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "（『イメージの観測』？）"},
{"id": 134, "speaker": 29, "form": "dlg", "jp": "（まあ、テレパシーの受信みたいなものね‥‥）"},
{"id": 135, "speaker": 31, "form": "dlg", "jp": "（ジーンも昔はその観測チームにいたんだよ‥‥）"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "（ジーンはその『イメージ』を感知していないの？）"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "（２４時間、\n　ずっとそれをしていられるわけじゃないから‥‥）"},
{"id": 138, "speaker": 29, "form": "choice", "jp": "（そうだよね‥‥）"},
{"id": 139, "speaker": 29, "form": "choice", "jp": "（ちょっと待って！）"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "（そうだよね‥‥）"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "（せっかく５０Ｋｍ以内にいるのに‥‥）"},
{"id": 142, "speaker": 29, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥）"},
{"id": 143, "speaker": 29, "form": "dlg", "jp": "（何かいい方法はないかしら‥‥）"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "（ちょっと待って！）"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "（『この町から５０Ｋｍ以内』って、\n　ジーンのテレパシーが届く範囲じゃないか？）"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "（テレパシーで呼びつけるっていうのは？）"},
{"id": 147, "speaker": 29, "form": "dlg", "jp": "（それがムリなのよ‥‥）"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "（どうして！？）"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "（ジーンのテレパシーは届くんだろう？）"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "（その通りよ‥‥）"},
{"id": 151, "speaker": 29, "form": "dlg", "jp": "（たぶん、私のテレパシーは\n　その『テレポーター』に届いているハズよ！）"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "（じゃあ？）"},
{"id": 153, "speaker": 29, "form": "dlg", "jp": "（相手の『テレパシー』の能力が低すぎて\n　会話にならないのよ！）"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "（ハア？）"},
{"id": 155, "speaker": 31, "form": "dlg", "jp": "（つまり、『声の大きな人間』と\n　『声の小さな人間』が会話してるみたいなもんだよ）"},
{"id": 156, "speaker": 31, "form": "dlg", "jp": "（お互い目隠しして‥‥）"},
{"id": 157, "speaker": 31, "form": "dlg", "jp": "（『声の大きな人間』の声は\n　『声の小さな人間』に聞こえてるんだけど）"},
{"id": 158, "speaker": 31, "form": "dlg", "jp": "（その返事の声は小さすぎて\n　『声の大きな人間』には聞こえない‥‥）"},
{"id": 159, "speaker": 31, "form": "dlg", "jp": "（つまり、会話にならないんだ‥‥）"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "（そんなぁ～～）"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "（そう言えばアイコは？）"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "（そう言えば長尾は？）"},
{"id": 163, "speaker": 31, "form": "dlg", "jp": "（夜は出られないって‥‥）"},
{"id": 164, "speaker": 31, "form": "dlg", "jp": "（女の子だからな‥‥）"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "（まあそうだね‥‥）"},
{"id": 166, "speaker": 29, "form": "dlg", "jp": "（何かおかしな『夢』を\n　見たって言ってたけど‥‥）"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "（おかしな『夢』？）"},
{"id": 168, "speaker": 29, "form": "dlg", "jp": "（なんでも‥‥）"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "（『小さな部屋で数字合わせをしてる夢』\n　だって‥‥）"},
{"id": 170, "speaker": 31, "form": "dlg", "jp": "（まあ、仲間探しとは関係ない夢だな‥‥）"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "（まあそうだろうね‥‥）"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "（そう言えば堤さんは？）"},
{"id": 173, "speaker": 31, "form": "dlg", "jp": "（女の子だからな‥‥）"},
{"id": 174, "speaker": 31, "form": "dlg", "jp": "（夜に呼び出すわけにはいかないだろう？）"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "（まあそうだね‥‥）"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "（そう言えば小田は？）"},
{"id": 177, "speaker": 31, "form": "dlg", "jp": "（女の子だからな‥‥）"},
{"id": 178, "speaker": 31, "form": "dlg", "jp": "（夜に呼び出すわけにはいかないだろう？）"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "（まあそうだね‥‥）"}
]
