[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／１１／ＰＭ０４：００"},
{"id": 1, "speaker": 14, "form": "dlg", "jp": "「夏休みもこれで１日終了か‥‥」"},
{"id": 2, "speaker": 14, "form": "dlg", "jp": "「なんか、最近１日が終わるの早くないか？」"},
{"id": 3, "speaker": 13, "form": "dlg", "jp": "「別にまだ１日が終わったわけじゃないけどな」"},
{"id": 4, "speaker": 14, "form": "dlg", "jp": "「まあ、そうだけど‥‥」"},
{"id": 5, "speaker": 13, "form": "dlg", "jp": "「しかし、長尾のヤツはどうして\n　次から次へとおかしなことを思い付くんだろうな」"},
{"id": 6, "speaker": 14, "form": "dlg", "jp": "「思い付いたんじゃなくて、\n　本当に見たんだろう？」"},
{"id": 7, "speaker": 13, "form": "dlg", "jp": "「シンちゃんまで信じるのか？」"},
{"id": 8, "speaker": 14, "form": "dlg", "jp": "「別にアイツが『吸血鬼』を見たとは思ってねえよ！」"},
{"id": 9, "speaker": 14, "form": "dlg", "jp": "「ただ、アイツが『吸血鬼』だと思い込むようなものを\n　見た可能性は否定できないよな‥‥」"},
{"id": 10, "speaker": 13, "form": "dlg", "jp": "「まあ、そりゃそうだな‥‥」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「やっぱり、シンちゃんもそう思うの？」"},
{"id": 12, "speaker": 14, "form": "dlg", "jp": "「ああいうタイプのヤツはウソはつかないだろう？」"},
{"id": 13, "speaker": 14, "form": "dlg", "jp": "「あるとしたら『ウソ』を信じ込んでるだけだろうな‥‥」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「ボクもそう思うよ！！」"},
{"id": 15, "speaker": 13, "form": "dlg", "jp": "「そういえば、三船のことはいいのか？」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「アイコのこと？」"},
{"id": 17, "speaker": 13, "form": "dlg", "jp": "「いっしょに帰ってやらなくても？」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「別に子供じゃないんだから‥‥」"},
{"id": 19, "speaker": 13, "form": "dlg", "jp": "「ならいいんだけど‥‥」"},
{"id": 20, "speaker": 13, "form": "dlg", "jp": "こうしてボクはシンちゃんたちと別れた。"},
{"id": 21, "speaker": 13, "form": "dlg", "jp": "そして‥‥"},
{"id": 22, "speaker": 16, "form": "dlg", "jp": "「常光寺くん！！」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「長尾！？」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 25, "speaker": 16, "form": "dlg", "jp": "「また見ちゃったのよ！」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「『見ちゃった』？」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「何を？」"},
{"id": 28, "speaker": 16, "form": "dlg", "jp": "「『吸血鬼』よ！！」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「『吸血鬼』！？」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "「本当なの！？」"},
{"id": 31, "speaker": 16, "form": "dlg", "jp": "「間違いないわ！！」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "（やっぱり、ウソをついてるようには思えないな‥‥）"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "（となると、『ルードのサイボーグ』！？）"},
{"id": 34, "speaker": 16, "form": "dlg", "jp": "「ねえ、ちょっとついてきてよ！！」"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "「えっ、えええ！！」"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "ボクは無理矢理『倉庫街』へつれて行かれることになった。"}
]
