{"id": 45, "speaker": 18, "form": "dlg", "jp": "「あの『シロー』っていう人と下に降りていったけど」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「わるいけど、姉さんと話してきていいかな？」"},
{"id": 47, "speaker": 29, "form": "dlg", "jp": "「いいわよ‥‥」"},
{"id": 48, "speaker": 29, "form": "dlg", "jp": "「じっくり話してきなさい‥‥」"},
{"id": 49, "speaker": 29, "form": "dlg", "jp": "「あと、アイコとアスカも家族の人に\n　キチンと話をしてきなさい！」"},
{"id": 50, "speaker": 35, "form": "dlg", "jp": "「まあ、ウチはすんなりＯＫしてくれると思うよ！」"},
{"id": 51, "speaker": 31, "form": "dlg", "jp": "「なんか、そんな感じがするよ‥‥」"},
{"id": 52, "speaker": 31, "form": "dlg", "jp": "「でも、アイコの所はそんなに簡単にいかないだろう？」"},
{"id": 53, "speaker": 31, "form": "dlg", "jp": "「なんなら、ついていってやろうか？」"},
{"id": 54, "speaker": 31, "form": "dlg", "jp": "「いっしょに説得してやるよ！」"},
{"id": 55, "speaker": 15, "form": "dlg", "jp": "「いいわよ」"},
{"id": 56, "speaker": 15, "form": "dlg", "jp": "「それぐらい自分でちゃんと説明するから」"},
{"id": 57, "speaker": 15, "form": "dlg", "jp": "「ウチのお母さん、モノわかりいい人だし‥‥」"},
{"id": 58, "speaker": 15, "form": "dlg", "jp": "「まあ、\n　お父さんを説得するのは難しいかもしれないけど‥‥」"},
{"id": 59, "speaker": 15, "form": "dlg", "jp": "「ＵＦＯやロボットを破壊するよりは\n　簡単なことだと思うの‥‥」"},
{"id": 60, "speaker": 31, "form": "dlg", "jp": "「エライ、よく言った！」"},
{"id": 61, "speaker": 29, "form": "dlg", "jp": "「あと、アキラとアスカも家族の人に\n　キチンと話をしてきなさい！」"},
{"id": 62, "speaker": 35, "form": "dlg", "jp": "「まあ、ウチはすんなりＯＫしてくれると思うよ！」"},
{"id": 63, "speaker": 31, "form": "dlg", "jp": "「なんか、そんな感じがするよ‥‥」"},
{"id": 64, "speaker": 31, "form": "dlg", "jp": "「でも、アキラの所はそんなに簡単にいかないだろう？」"},
{"id": 65, "speaker": 31, "form": "dlg", "jp": "「なんなら、ついていってやろうか？」"},
{"id": 66, "speaker": 31, "form": "dlg", "jp": "「いっしょに説得してやるよ！」"},
{"id": 67, "speaker": 16, "form": "dlg", "jp": "「アラ、ウチは多分大丈夫よ！」"},
{"id": 68, "speaker": 16, "form": "dlg", "jp": "「みんな私のすることに興味ないみたいだから‥‥」"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "「まあ、あんな服つくってても何も注意しないんだものね？」"},
{"id": 70, "speaker": 16, "form": "dlg", "jp": "「説明しても、\n　マンガか小説の話と思うぐらいじゃないかしら？」"},
{"id": 71, "speaker": 16, "form": "dlg", "jp": "「大人ってそんなもんでしょう？」"},
{"id": 72, "speaker": 31, "form": "dlg", "jp": "「なんて返事したらいいのやら‥‥」"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「あと、ナナセとアスカも家族の人に\n　キチンと話をしてきなさい！」"},
{"id": 74, "speaker": 35, "form": "dlg", "jp": "「まあ、ウチはすんなりＯＫしてくれると思うよ！」"},
{"id": 75, "speaker": 31, "form": "dlg", "jp": "「なんか、そんな感じがするよ‥‥」"},
{"id": 76, "speaker": 31, "form": "dlg", "jp": "「でも、ナナセの所はそんなに簡単にいかないだろう？」"},
{"id": 77, "speaker": 31, "form": "dlg", "jp": "「なんなら、ついていってやろうか？」"},
{"id": 78, "speaker": 31, "form": "dlg", "jp": "「いっしょに説得してやるよ！」"},
{"id": 79, "speaker": 18, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 80, "speaker": 18, "form": "dlg", "jp": "「ウチの家族を説得するのは難しいかも‥‥」"},
{"id": 81, "speaker": 31, "form": "dlg", "jp": "「オレが説得してやるよ！」"},
{"id": 82, "speaker": 18, "form": "dlg", "jp": "「ダメよ！」"},
{"id": 83, "speaker": 18, "form": "dlg", "jp": "「男の人と一緒に外国に行きます！」"},
{"id": 84, "speaker": 18, "form": "dlg", "jp": "「なんて言ったら、余計に反対されちゃうわ！」"},
{"id": 85, "speaker": 18, "form": "dlg", "jp": "「１人で、きちんと説明してくるわ」"},
{"id": 86, "speaker": 18, "form": "dlg", "jp": "「あのＵＦＯのこともあるんだから、\n　ある程度はわかってくれると思うの」"},
{"id": 87, "speaker": 18, "form": "dlg", "jp": "「それでダメだったら、勝手に飛び出してくるわ！」"},
{"id": 88, "speaker": 31, "form": "dlg", "jp": "「なんて返事したらいいのやら‥‥」"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "「じゃあ、私たちもホテルに戻って\n　出発の準備をしましょう！」"},
{"id": 90, "speaker": 29, "form": "dlg", "jp": "「８時にここに集合ということで！」"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "ボクたちは一旦解散することになった。"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "（さてと、姉さんに説明しないとな‥‥）"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "ボクはリビングに降りて行くことにした。"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 95, "speaker": 5, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 96, "speaker": 5, "form": "dlg", "jp": "「戻ってきたんだね‥‥」"},
{"id": 97, "speaker": 3, "form": "dlg", "jp": "「お帰りなさい‥‥」"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "「ただいま‥‥」"},
{"id": 99, "speaker": 3, "form": "dlg", "jp": "「テレビ観てたわよ‥‥」"},
{"id": 100, "speaker": 3, "form": "dlg", "jp": "「ごくろうさま‥‥」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 102, "speaker": 3, "form": "dlg", "jp": "「話はアイコちゃんと、シローから聞いたわ‥‥」"},
{"id": 103, "speaker": 3, "form": "dlg", "jp": "「話はアキラちゃんと、シローから聞いたわ‥‥」"},
{"id": 104, "speaker": 3, "form": "dlg", "jp": "「話は堤さんと、シローから聞いたわ‥‥」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 106, "speaker": 3, "form": "dlg", "jp": "「また、大変なことに巻き込まれたみたいね‥‥」"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「やんなっちゃうね‥‥」"},
{"id": 108, "speaker": 3, "form": "dlg", "jp": "「テレビに映ってなかったけど、\n　あれ、ナゴムが破壊したの？」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「まあね‥‥」"},
{"id": 110, "speaker": 3, "form": "dlg", "jp": "「テレビを観ながら、\n　もう、『おかえり』って言えないんじゃないかって」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "「大丈夫だよ、あの程度のものなら‥‥」"},
{"id": 112, "speaker": 3, "form": "dlg", "jp": "「また、出て行くんでしょう？」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「いよいよ『決戦』らしいよ‥‥」"},
{"id": 115, "speaker": 3, "form": "dlg", "jp": "「自信はあるの？」"},
{"id": 116, "speaker": 3, "form": "choice", "jp": "「まあまあかなぁ‥‥」"},
{"id": 117, "speaker": 3, "form": "choice", "jp": "「ばっちりさ！」"},
{"id": 118, "speaker": 3, "form": "choice", "jp": "「ジシンはマグニチュード６」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「まあまあかなぁ‥‥」"},
{"id": 120, "speaker": 5, "form": "dlg", "jp": "「『ミ◯キーはまあまあの味』」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「姉さんくだらないこと教えたんだね‥‥」\n"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「ばっちりさ！」"},
{"id": 123, "speaker": 3, "form": "dlg", "jp": "「ばっちりどうなの？」"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「フグのおなべ」"},
{"id": 125, "speaker": 3, "form": "dlg", "jp": "「それがどうかしたの？」"},
{"id": 126, "speaker": 5, "form": "dlg", "jp": "「リツコ、関西ではフグのおなべのことを\n　『てっちり』っていうんだよ」"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「姉さんくだらないこと教えたんだね‥‥」\n"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "「ジシンはマグニチュード６」"},
{"id": 129, "speaker": 5, "form": "dlg", "jp": "「ナゴム、リツコが聞いたジシンって\n　そのジシンのことじゃないよ！」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「姉さんくだらないこと教えたんだね‥‥」"},
{"id": 131, "speaker": 3, "form": "dlg", "jp": "「フフフフフ‥‥」"},
{"id": 132, "speaker": 3, "form": "dlg", "jp": "「そのぶんじゃあ、大丈夫そうね‥‥」"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "「うん、大丈夫だよ」\n"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "「多分‥‥」\n"},
{"id": 135, "speaker": 5, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 136, "speaker": 5, "form": "dlg", "jp": "「本当にボクが手伝えることは？」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「だから、シローはここにいて、\n　姉さんを守ってくれていれば、それでいいよ！」\n"},
{"id": 138, "speaker": 5, "form": "dlg", "jp": "「だけど‥‥」"},
{"id": 139, "speaker": 5, "form": "dlg", "jp": "「ボクはキミたち２人を守るように命令されて‥‥」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「だから、姉さんを守ってくれてれば、\n　結果それがボクを守ってることにも‥‥」"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "「誰かが姉さんをちゃんと守ってくれてると思えば」"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「ボクも安心して戦えるし‥‥」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「結果、ボクを守ることにもなるんだよ！」"},
{"id": 144, "speaker": 5, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 145, "speaker": 3, "form": "dlg", "jp": "「大丈夫なのね‥‥」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「姉さんにはもう一度、\n　『おかえり』って言わせてあげるよ！」"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 149, "speaker": 3, "form": "dlg", "jp": "「誰かしらこんな時に？」"},
{"id": 150, "speaker": 3, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「ボクがでるよ！！」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「プルルルルルル‥‥」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 154, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 155, "speaker": 14, "form": "dlg", "jp": "（もしもし‥‥）"},
{"id": 156, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "「シンちゃん？」"},
{"id": 158, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 159, "speaker": 14, "form": "dlg", "jp": "（その声はナゴムか？）"},
{"id": 160, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 162, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 163, "speaker": 14, "form": "dlg", "jp": "（生きてたんだな‥‥）"},
{"id": 164, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 166, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 167, "speaker": 14, "form": "dlg", "jp": "（さっき電話したら、\n　オマエの姉さんが外出してるって‥‥）"},
{"id": 168, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "「ちょっとね‥‥」"},
{"id": 170, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 171, "speaker": 14, "form": "dlg", "jp": "（こんな大変な時に外出するなよ！）"},
{"id": 172, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 173, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 174, "speaker": 14, "form": "dlg", "jp": "（オマエは事件に\n　巻き込まれやすい体質なんだから‥‥）"},
{"id": 175, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「で、何の用？」"},
{"id": 177, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 178, "speaker": 14, "form": "dlg", "jp": "（バカ、安否の確認に決まってるだろう！！）"},
{"id": 179, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 180, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 181, "speaker": 14, "form": "dlg", "jp": "（で、水とかは買いだめしたのか？）"},
{"id": 182, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「さあ‥‥」"},
{"id": 184, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 185, "speaker": 14, "form": "dlg", "jp": "（何、ノンキなこと言ってるんだ！！）"},
{"id": 186, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 187, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 188, "speaker": 14, "form": "dlg", "jp": "（もうスーパーはパニック状態だぞ！！）"},
{"id": 189, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 191, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 192, "speaker": 14, "form": "dlg", "jp": "（とにかく、ウチのババァが\n　余分に買ったみたいだから）"},
{"id": 193, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 194, "speaker": 14, "form": "dlg", "jp": "「"},
{"id": 195, "speaker": 14, "form": "dlg", "jp": "（後で水とカセットコンロを届けてやるよ‥‥）"},
{"id": 196, "speaker": 14, "form": "dlg", "jp": "」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "「もしかしたら、\n　また外出してるかもしれないから」"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "「姉さんに渡しておいてよ！」"},
