{"id": 298, "speaker": 29, "form": "dlg", "jp": "「今、あの中よ‥‥」"},
{"id": 299, "speaker": 51, "form": "dlg", "jp": "（じゃあ、いくでぇぇぇぇぇぇぇ！）"},
{"id": 300, "speaker": 51, "form": "dlg", "jp": "（たぁぁぁぁぁぁぁっ！）"},
{"id": 301, "speaker": 29, "form": "dlg", "jp": "「アスカ！！」"},
{"id": 302, "speaker": 35, "form": "dlg", "jp": "「ホイきたっ！」"},
{"id": 303, "speaker": 15, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥！」"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "「アイコ！！」"},
{"id": 305, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃんの言った通り、ヒントがはってあったわ！」"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "「なんて？」"},
{"id": 307, "speaker": 15, "form": "dlg", "jp": "「『平安京５０周年記念』って‥‥」"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "「そんなの誰でもわかるじゃないか！」"},
{"id": 309, "speaker": 35, "form": "dlg", "jp": "「えっ、わかんないよ！」"},
{"id": 310, "speaker": 15, "form": "dlg", "jp": "「『５０周年記念』ってとこがヒッカケだからね！」"},
{"id": 311, "speaker": 35, "form": "dlg", "jp": "「あと、『夢』がどうのって？」"},
{"id": 312, "speaker": 35, "form": "dlg", "jp": "「いったい、どういうこと？」"},
{"id": 313, "speaker": 16, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥！」"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "「長尾！！」"},
{"id": 315, "speaker": 16, "form": "dlg", "jp": "「常光寺くんの言った通り、ヒントがはってあったわ！」"},
{"id": 316, "speaker": 2, "form": "dlg", "jp": "「なんて？」"},
{"id": 317, "speaker": 16, "form": "dlg", "jp": "「『ニコラ・テスラは何年生まれか？』って‥‥」"},
{"id": 318, "speaker": 2, "form": "dlg", "jp": "「そんなの長尾じゃないとわからないよな‥‥」"},
{"id": 319, "speaker": 35, "form": "dlg", "jp": "「誰、『ニッカボッカ』って？」"},
{"id": 320, "speaker": 16, "form": "dlg", "jp": "「『ニコラ・テスラ』よ！」"},
{"id": 321, "speaker": 35, "form": "dlg", "jp": "「あと、『夢』がどうのって？」"},
{"id": 322, "speaker": 35, "form": "dlg", "jp": "「いったい、どういうこと？」"},
{"id": 323, "speaker": 18, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥！」"},
{"id": 324, "speaker": 2, "form": "dlg", "jp": "「堤さん！！」"},
{"id": 325, "speaker": 18, "form": "dlg", "jp": "「やったのね！」"},
{"id": 326, "speaker": 35, "form": "dlg", "jp": "「うん！！」"},
{"id": 327, "speaker": 35, "form": "dlg", "jp": "「スゴイねキミは！！」"},
{"id": 328, "speaker": 35, "form": "dlg", "jp": "「で、どうやって番号を解読したの？」"},
{"id": 329, "speaker": 51, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥！」"},
{"id": 330, "speaker": 2, "form": "dlg", "jp": "「小田ぁ！！」"},
{"id": 331, "speaker": 51, "form": "dlg", "jp": "「どや、スゴイやろう？」"},
{"id": 332, "speaker": 35, "form": "dlg", "jp": "「うん！！」"},
{"id": 333, "speaker": 35, "form": "dlg", "jp": "「あれってどうやったの？」"},
{"id": 334, "speaker": 31, "form": "dlg", "jp": "「アスカにはいろんなことを教える必要があるな‥‥」"},
{"id": 335, "speaker": 35, "form": "dlg", "jp": "「オネガイシマス‥‥」"},
{"id": 336, "speaker": 29, "form": "dlg", "jp": "「そんなことより‥‥」"},
{"id": 337, "speaker": 29, "form": "dlg", "jp": "「仕事中じゃなかったの？」"},
{"id": 338, "speaker": 35, "form": "dlg", "jp": "「わ、忘れてた！！」"},
{"id": 339, "speaker": 35, "form": "dlg", "jp": "「ま、また今晩にでも電話するよ！」"},
{"id": 340, "speaker": 35, "form": "dlg", "jp": "「じゃぁこれで‥‥」"},
{"id": 341, "speaker": 35, "form": "dlg", "jp": "松尾さんはあわてて、能力で立ち去った。"},
{"id": 342, "speaker": 29, "form": "dlg", "jp": "「変わった人ね‥‥」"},
{"id": 343, "speaker": 31, "form": "dlg", "jp": "「そんなことより‥‥」"},
{"id": 344, "speaker": 31, "form": "dlg", "jp": "「アイツがいなくなったら、\n　オレたちどうやって戻るんだ？」"},
{"id": 345, "speaker": 29, "form": "dlg", "jp": "「歩いて戻るしかなさそうね‥‥」"},
{"id": 346, "speaker": 15, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥！」"},
{"id": 347, "speaker": 15, "form": "dlg", "jp": "「ってここ、迷うので有名な『富士の樹海』よ！」"},
{"id": 348, "speaker": 16, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥！」"},
{"id": 349, "speaker": 16, "form": "dlg", "jp": "「ってここ、迷うので有名な『富士の樹海』よ！」"},
{"id": 350, "speaker": 18, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥！」"},
{"id": 351, "speaker": 18, "form": "dlg", "jp": "「ってここ、迷うので有名な『富士の樹海』よ！」"},
{"id": 352, "speaker": 51, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥！」"},
{"id": 353, "speaker": 51, "form": "dlg", "jp": "「ってここ、迷うので有名な『富士の樹海』やないか！」"},
{"id": 354, "speaker": 29, "form": "dlg", "jp": "「大丈夫よ！！」"},
{"id": 355, "speaker": 29, "form": "dlg", "jp": "「私の能力があるから、絶対迷わないわ！！」"},
{"id": 356, "speaker": 29, "form": "dlg", "jp": "こうしてボクたちは、\n歩いてふもとの町に下りて行くことになり、\n"},
{"id": 357, "speaker": 29, "form": "dlg", "jp": "結局、家についたのは夜の９時だった。"},
