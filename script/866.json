[
{"id": 0, "speaker": 29, "form": "dlg", "jp": "（ここならわかるんでしょう？）"},
{"id": 1, "speaker": 4, "form": "dlg", "jp": "「うん、ここならわかったよ！」"},
{"id": 2, "speaker": 31, "form": "dlg", "jp": "「だ、誰だオマエ‥‥」"},
{"id": 3, "speaker": 4, "form": "dlg", "jp": "「松尾アスカだけど‥‥」"},
{"id": 4, "speaker": 31, "form": "dlg", "jp": "「『松尾アスカ』！？」"},
{"id": 5, "speaker": 31, "form": "dlg", "jp": "「まさかオマエが！？」"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "「どうやらそうみたいね‥‥」"},
{"id": 7, "speaker": 35, "form": "dlg", "jp": "「アンタたちが『テレパシー』の‥‥」"},
{"id": 8, "speaker": 35, "form": "dlg", "jp": "「やっとあえたんだね‥‥」"},
{"id": 9, "speaker": 31, "form": "dlg", "jp": "「どうでもいいけど、\n　もっと人目に付かない場所はムリだったのかよ！」"},
{"id": 10, "speaker": 35, "form": "dlg", "jp": "「だってココしか‥‥」"},
{"id": 11, "speaker": 15, "form": "dlg", "jp": "（そのカッコウ‥‥）"},
{"id": 12, "speaker": 15, "form": "dlg", "jp": "（もしかして、松尾さん？）"},
{"id": 13, "speaker": 16, "form": "dlg", "jp": "（どうでもいいけど、そのカッコウ‥‥）"},
{"id": 14, "speaker": 16, "form": "dlg", "jp": "（もしかして、松尾さん？）"},
{"id": 15, "speaker": 18, "form": "dlg", "jp": "（そのカッコウ‥‥）"},
{"id": 16, "speaker": 18, "form": "dlg", "jp": "（もしかして、松尾さん？）"},
{"id": 17, "speaker": 51, "form": "dlg", "jp": "（どうでもいいけど、そのカッコウ‥‥）"},
{"id": 18, "speaker": 51, "form": "dlg", "jp": "（もしかして、松尾さん？）"},
{"id": 19, "speaker": 35, "form": "dlg", "jp": "「そうだよ、『自衛官』！」"},
{"id": 20, "speaker": 35, "form": "dlg", "jp": "「今も大変なところを抜け出して来たんだよ！」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「『大変なところ』！？」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「もしかして！？」"},
{"id": 23, "speaker": 35, "form": "dlg", "jp": "「あの演習場にいたんだよ‥‥」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「それ、本当！？」"},
{"id": 25, "speaker": 29, "form": "dlg", "jp": "「それは好都合ね‥‥」"},
{"id": 26, "speaker": 29, "form": "dlg", "jp": "「とにかく時間がないの、\n　私たちをあのロボットの所につれて行ってよ！」"},
{"id": 27, "speaker": 35, "form": "dlg", "jp": "「いいけど、どうするつもり？」"},
{"id": 28, "speaker": 29, "form": "dlg", "jp": "「私たちであのロボットを止めるのよ！」"},
{"id": 29, "speaker": 35, "form": "dlg", "jp": "「そんなことできるの！？」"},
{"id": 30, "speaker": 29, "form": "dlg", "jp": "「わからないわ‥‥」"},
{"id": 31, "speaker": 29, "form": "dlg", "jp": "「ただ、このまま放っておけないでしょう？」"},
{"id": 32, "speaker": 29, "form": "dlg", "jp": "「とにかく、早く連れてってよ！」"},
{"id": 33, "speaker": 35, "form": "dlg", "jp": "「わかった！！」"},
{"id": 34, "speaker": 35, "form": "dlg", "jp": "「じゃあ、いくよ！！」"},
{"id": 35, "speaker": 35, "form": "dlg", "jp": "ボクたちは松尾さんの能力を使って\nロボットの所に行くことになった。"},
{"id": 36, "speaker": 35, "form": "dlg", "jp": "「よっと！！」"},
{"id": 37, "speaker": 35, "form": "dlg", "jp": "「みんな大丈夫？」"},
{"id": 38, "speaker": 29, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 39, "speaker": 31, "form": "dlg", "jp": "「ヒャッホウ！」"},
{"id": 40, "speaker": 31, "form": "dlg", "jp": "「コイツはスゴイや！！」"},
{"id": 41, "speaker": 35, "form": "dlg", "jp": "「アリガトウ‥‥」"},
{"id": 42, "speaker": 29, "form": "dlg", "jp": "「ねえ、\n　自衛隊はコイツを止められないの？」"},
{"id": 43, "speaker": 35, "form": "dlg", "jp": "「たぶん、戦車の砲撃ぐらいじゃ無理だね‥‥」"},
{"id": 44, "speaker": 35, "form": "dlg", "jp": "「それに木がじゃまで、\n　ここまで戦車は入れないだろうし‥‥」"},
{"id": 45, "speaker": 35, "form": "dlg", "jp": "たしかに、戦車は木にはばまれて\nこのロボットに近よることができないようだ。"},
{"id": 46, "speaker": 35, "form": "dlg", "jp": "「あ、あぶない！」"},
{"id": 47, "speaker": 31, "form": "dlg", "jp": "「何っ！？」"},
{"id": 48, "speaker": 31, "form": "dlg", "jp": "戦車の流れ弾がコチラに向かって飛んで来た。"},
{"id": 49, "speaker": 31, "form": "dlg", "jp": "「ちくしょうっ！」"},
{"id": 50, "speaker": 31, "form": "dlg", "jp": "「早くなんとかしないと、\n　命がいくらあっても足りないぜ‥‥」"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "「でも、どうやって！？」"},
{"id": 52, "speaker": 29, "form": "dlg", "jp": "「アイツっていざという時の、\n　"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "『自爆装置』"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "とかないの？」"},
{"id": 55, "speaker": 35, "form": "dlg", "jp": "「あるけど‥‥」"},
{"id": 56, "speaker": 35, "form": "dlg", "jp": "「外部からのヤツは、\n　コントロールは今は受け付けないから‥‥」"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "「外部からのヤツ？」"},
{"id": 58, "speaker": 29, "form": "dlg", "jp": "「じゃあ、別のヤツもあるの？」"},
{"id": 59, "speaker": 35, "form": "dlg", "jp": "「あるよ！」"},
{"id": 60, "speaker": 35, "form": "dlg", "jp": "「"},
{"id": 61, "speaker": 35, "form": "dlg", "jp": "『コックピットの中』"},
{"id": 62, "speaker": 35, "form": "dlg", "jp": "だけど‥‥」"},
{"id": 63, "speaker": 35, "form": "dlg", "jp": "「外部からそれを操作されないように、\n　"},
{"id": 64, "speaker": 35, "form": "dlg", "jp": "手動式のヤツ"},
{"id": 65, "speaker": 35, "form": "dlg", "jp": "なんだ‥‥」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「手動式？」"},
{"id": 67, "speaker": 35, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 68, "speaker": 35, "form": "dlg", "jp": "「ダイヤルで"},
{"id": 69, "speaker": 35, "form": "dlg", "jp": "数字をあわせる"},
{"id": 70, "speaker": 35, "form": "dlg", "jp": "アナログなヤツ‥‥」"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "「それなら、『ケネス』の能力で発動できるんじゃ？」"},
{"id": 72, "speaker": 31, "form": "dlg", "jp": "「ムチャ言うなよ‥‥」"},
{"id": 73, "speaker": 31, "form": "dlg", "jp": "「数字をあわせるってことは\n　"},
{"id": 74, "speaker": 31, "form": "dlg", "jp": "『暗証番号』"},
{"id": 75, "speaker": 31, "form": "dlg", "jp": "があるんだろう？」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「その数字とかわからないの？」"},
{"id": 77, "speaker": 35, "form": "dlg", "jp": "「隊の『重要機密』だから‥‥」"},
{"id": 78, "speaker": 35, "form": "dlg", "jp": "「オレのランクには‥‥」"},
{"id": 79, "speaker": 31, "form": "dlg", "jp": "「トーゼンだな‥‥」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「その『暗証番号』って‥‥」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「アイコの見た\n　"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "『数字をあわせる夢』"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "に関係あるんじゃないかな？」"},
{"id": 84, "speaker": 15, "form": "dlg", "jp": "「‥‥‥！！」"},
{"id": 85, "speaker": 15, "form": "dlg", "jp": "「たしかにそうかも！」"},
{"id": 86, "speaker": 31, "form": "dlg", "jp": "「何いいかげんなこと言ってるんだよ？」"},
{"id": 87, "speaker": 15, "form": "dlg", "jp": "「いいかげんじゃないわよ！」"},
{"id": 88, "speaker": 15, "form": "dlg", "jp": "「間違いなく、\n　夢の中で必死に"},
{"id": 89, "speaker": 15, "form": "dlg", "jp": "『数字をあわせてた』"},
{"id": 90, "speaker": 15, "form": "dlg", "jp": "もん！」"},
{"id": 91, "speaker": 31, "form": "dlg", "jp": "「その『夢』が本当なら」"},
{"id": 92, "speaker": 31, "form": "dlg", "jp": "「『番号』と\n　『起爆装置の場所と形』さえ教えてくれたら」"},
{"id": 93, "speaker": 31, "form": "dlg", "jp": "「オレの能力で数字ぐらいあわせてやるよ‥‥」"},
{"id": 94, "speaker": 31, "form": "dlg", "jp": "「アイコ、何番なんだ？」"},
{"id": 95, "speaker": 15, "form": "dlg", "jp": "「思いだせないのよ‥‥」"},
{"id": 96, "speaker": 31, "form": "dlg", "jp": "「夢で見たんだろう？」"},
{"id": 97, "speaker": 15, "form": "dlg", "jp": "「しかたないでしょう、思い出せないだもん！」"},
{"id": 98, "speaker": 29, "form": "dlg", "jp": "「ムリよ！」"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "「アイコが見た夢が本当にこのことなら」"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "「暗証番号をセットするのはアイコってことだから、\n　ケネスがセットすることはできないのよ！」"},
{"id": 101, "speaker": 31, "form": "dlg", "jp": "「その話、ちょっとオカシイぞ！」"},
{"id": 102, "speaker": 31, "form": "dlg", "jp": "「アイコが『暗証番号を知っていて、\n　解除する』ならわかるけど」"},
{"id": 103, "speaker": 31, "form": "dlg", "jp": "「知らないのにどうして解除できるんだよ？」"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "「『夢』で知ったとか‥‥」"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "「アイコの夢は実際に\n　『未来に起きたこと』を見るんでしょう？」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「『未来に起きたこと』‥‥」"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "「アイコが『暗証番号』を知らないのに、\n　未来に起きるワケないでしょう？」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「今は知らなくても"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "その場で知る"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "とか‥‥」"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "「どうやって？」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「例えば"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "ヒントが書いてある"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "とか！」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「インターネットのパスワードを忘れた時に、\n　本人しか知らないような情報で確認を取るだろう？」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「ああいうヤツ！」"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「グウゼン、アイコの知っている情報が\n　ヒントになってることも！」"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "「なるほど！」"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "「その可能性はあるわね！」"},
{"id": 121, "speaker": 29, "form": "dlg", "jp": "「アスカ、この子をアイツのコックピットに\n　瞬間移動させてあげて！」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「その『暗証番号』って‥‥」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「長尾の見た\n　『数字をあわせる夢』に関係あるんじゃないかな？」"},
{"id": 124, "speaker": 16, "form": "dlg", "jp": "「‥‥‥！！」"},
{"id": 125, "speaker": 16, "form": "dlg", "jp": "「たしかにそうかも！」"},
