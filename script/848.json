[
{"id": 0, "speaker": 2, "form": "dlg", "jp": "「ねえ、『核ミサイル』なんて\n　どうやって止めるつもりなんだよ！」"},
{"id": 1, "speaker": 29, "form": "dlg", "jp": "「そんなの簡単じゃない！」"},
{"id": 2, "speaker": 2, "form": "dlg", "jp": "「簡単じゃないだろう？」"},
{"id": 3, "speaker": 29, "form": "dlg", "jp": "「仕組みさえわかれば簡単よ！」"},
{"id": 4, "speaker": 35, "form": "dlg", "jp": "「ナゴムくん、『核ミサイル』ってのは『シンカン』ってのが\n　『爆薬』を爆発させて『臨界』まで温度をあげて」"},
{"id": 5, "speaker": 35, "form": "dlg", "jp": "「核爆発を発生させるんだよ！」"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "「つまり、『爆薬』の部分を取り除いちゃえばいいのよ！」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「どうやって‥‥」"},
{"id": 8, "speaker": 35, "form": "dlg", "jp": "「まあ、まかせておいて！」"},
{"id": 9, "speaker": 35, "form": "dlg", "jp": "そうこうしているうちに『ミサイル』が飛んで来た。"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "（キタ～～ッ！！）"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "（早くなんとかしないと‥‥）"},
{"id": 12, "speaker": 35, "form": "dlg", "jp": "（落ち着いて‥‥）"},
{"id": 13, "speaker": 35, "form": "dlg", "jp": "（あわてなくても大丈夫だよ！！）"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "（ダメだ、\n　松尾さんは事態の大変さに気付いていない！）"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "（どうにかしないと‥‥）"},
{"id": 16, "speaker": 35, "form": "dlg", "jp": "（まかせてくれって！！）"},
{"id": 17, "speaker": 35, "form": "choice", "jp": "（そうだ、『シンカン』を破壊すれば！！）"},
{"id": 18, "speaker": 35, "form": "choice", "jp": "（このまま空中で爆発させてしまえば！！）"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "（そうだ、『シンカン』を破壊すれば！！）"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "ボクは思いっきり\nミサイルの『シンカン』を殴りつけた。"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「ガツ～～ン！！」"},
{"id": 22, "speaker": 31, "form": "dlg", "jp": "「バカっ！！」"},
{"id": 23, "speaker": 31, "form": "dlg", "jp": "「なんてことを！！」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "（このまま空中で爆発させてしまえば！！）"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "（被害を最小限に食い止めるにはそれしか‥‥）"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "ボクは思いっきり\nミサイルの『シンカン』を殴りつけた。"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「ガツ～～ン！！」"},
{"id": 29, "speaker": 31, "form": "dlg", "jp": "「バカっ！！」"},
{"id": 30, "speaker": 31, "form": "dlg", "jp": "「なんてことを！！」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥）"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "（やっぱり、\n　松尾さんに任せるしか方法はないのか？）"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「松尾さん、頼んだよ！！」"},
{"id": 35, "speaker": 35, "form": "dlg", "jp": "「ＯＫ！」"},
{"id": 36, "speaker": 35, "form": "dlg", "jp": "「シュン！」"},
{"id": 37, "speaker": 35, "form": "dlg", "jp": "「もう大丈夫だ！」"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "「へっ！？」"},
{"id": 39, "speaker": 31, "form": "dlg", "jp": "「本当だな‥‥」"},
{"id": 40, "speaker": 35, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "（そんな‥‥‥）"},
{"id": 42, "speaker": 29, "form": "dlg", "jp": "「じゃあ戻りましょう！」"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「『ミサイル』はどうするの？」"},
{"id": 44, "speaker": 35, "form": "dlg", "jp": "「アレはもう大丈夫だ！」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥）"},
{"id": 46, "speaker": 35, "form": "dlg", "jp": "「じゃあ帰るよ！」"},
{"id": 47, "speaker": 35, "form": "dlg", "jp": "「シュン！」"},
{"id": 48, "speaker": 35, "form": "dlg", "jp": "そういって松尾さんはボクたちをテレポートさせた！"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「ねえ、このままじゃあ『ミサイル』が‥‥」"},
{"id": 50, "speaker": 35, "form": "dlg", "jp": "「大丈夫だよ！」"},
{"id": 51, "speaker": 35, "form": "dlg", "jp": "「爆発のための『爆薬』も『核燃料』も"},
{"id": 52, "speaker": 35, "form": "dlg", "jp": "本体から抜き取って\n　バラバラにテレポートさせちゃった"},
{"id": 53, "speaker": 35, "form": "dlg", "jp": "から」"},
{"id": 54, "speaker": 35, "form": "dlg", "jp": "「あの『ミサイル』は１００％核爆発しないよ‥‥」"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "「そうなの？」"},
{"id": 57, "speaker": 35, "form": "dlg", "jp": "「だって、『爆薬』がなけりゃ爆発しないし」"},
{"id": 58, "speaker": 35, "form": "dlg", "jp": "「爆発しなけりゃ『核分裂』も起こらないだろう？」"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "「それならはじめから松尾さん１人だけで行けば‥‥」"},
{"id": 60, "speaker": 35, "form": "dlg", "jp": "「冷たいこと言うなよ、仲間だろう？」"},
{"id": 61, "speaker": 35, "form": "dlg", "jp": "「で、こっちはどうなったの？」"},
{"id": 62, "speaker": 46, "form": "dlg", "jp": "「何も進展はありません‥‥」"},
{"id": 63, "speaker": 13, "form": "dlg", "jp": "「なんか方法があると思うんだけどな‥‥」"},
{"id": 64, "speaker": 46, "form": "dlg", "jp": "「ジーン、『ゲージ』は今どんな感じですか？」"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "「はい‥‥」"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "ジーンは『アカシックレコード』を確認するために、\n『コンピュータルーム』に向かった。"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "そして！"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "「リーダー！」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「どうだったの？」"},
{"id": 70, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "少し『ゲージ』が減ってる"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "！」"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「どうして？」"},
{"id": 74, "speaker": 13, "form": "dlg", "jp": "「驚くことないんじゃない？」"},
{"id": 75, "speaker": 13, "form": "dlg", "jp": "「ごく当たり前のことだよ‥‥」"},
{"id": 76, "speaker": 29, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 77, "speaker": 13, "form": "dlg", "jp": "「ゲーマーのヤツ、\n　"},
{"id": 78, "speaker": 13, "form": "dlg", "jp": "無駄に『コマンド』を使った"},
{"id": 79, "speaker": 13, "form": "dlg", "jp": "んだと思うぜ！」"},
{"id": 80, "speaker": 29, "form": "dlg", "jp": "「『コマンド』？」"},
{"id": 81, "speaker": 13, "form": "dlg", "jp": "「たぶん、コッチが燃料を抜いちゃってるのを知らずに\n　いろんなものを暴走させようとしたんじゃないかな？」"},
{"id": 82, "speaker": 29, "form": "dlg", "jp": "「じゃあ、また"},
{"id": 83, "speaker": 29, "form": "dlg", "jp": "ゲージがたまるまで\n　『天変地異』は起せない"},
{"id": 84, "speaker": 29, "form": "dlg", "jp": "ってこと？」"},
{"id": 85, "speaker": 13, "form": "dlg", "jp": "「だろうね‥‥」"},
{"id": 86, "speaker": 29, "form": "dlg", "jp": "「ラッキー！！」"},
{"id": 87, "speaker": 46, "form": "dlg", "jp": "「ラッキーではないですね‥‥」"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "「どうしてですか？」"},
{"id": 89, "speaker": 46, "form": "dlg", "jp": "「これで『ゲーマー』は気付いたはずです」"},
{"id": 90, "speaker": 46, "form": "dlg", "jp": "「もう"},
{"id": 91, "speaker": 46, "form": "dlg", "jp": "『機械の暴走』は私たちに通用しない"},
{"id": 92, "speaker": 46, "form": "dlg", "jp": "と‥‥」"},
{"id": 93, "speaker": 46, "form": "dlg", "jp": "「つまり、今度『ゲージ』がたまった時には間違い無く」"},
{"id": 94, "speaker": 46, "form": "dlg", "jp": "「取っておきの\n　"},
{"id": 95, "speaker": 46, "form": "dlg", "jp": "『天変地異』をしかけてくる"},
{"id": 96, "speaker": 46, "form": "dlg", "jp": "はずです」"},
{"id": 97, "speaker": 46, "form": "dlg", "jp": "「ジーン、あとどれぐらいで\n　また『ゲージ』がたまりそうですか？」"},
{"id": 98, "speaker": 29, "form": "dlg", "jp": "「減り具合と増える速度から考えて\n　"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "あと２０時間ぐらい"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "かと‥‥」"},
{"id": 101, "speaker": 46, "form": "dlg", "jp": "「と、いうことは私たちのタイムリミットは\n　"},
{"id": 102, "speaker": 46, "form": "dlg", "jp": "あと２０時間"},
{"id": 103, "speaker": 46, "form": "dlg", "jp": "ということですね‥‥」"},
{"id": 104, "speaker": 46, "form": "dlg", "jp": "「とりあえず、ジーンたちは休憩をとってください」"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "「そんな悠長なことを言っている場合じゃ！」"},
{"id": 106, "speaker": 13, "form": "dlg", "jp": "「イヤ、今アンタらができることは何もないんだ‥‥」"},
{"id": 107, "speaker": 13, "form": "dlg", "jp": "「それなら『天変地異』にそなえて\n　体を休ませておいてくれた方がいいな‥‥」"},
{"id": 108, "speaker": 13, "form": "dlg", "jp": "「アンタらの能力があれば『天変地異』の時に\n　生き残る人間の数が少しは増えそうだからな‥‥」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「ツトム、恐くないのか？」"},
{"id": 110, "speaker": 13, "form": "dlg", "jp": "「これは『ゲーマー』の『ゲーム』なんだろう？」"},
{"id": 111, "speaker": 13, "form": "dlg", "jp": "「『ゲーム』だと思うとちっともコワくないんだよ‥‥」"},
{"id": 112, "speaker": 13, "form": "dlg", "jp": "「逆に『ワクワク』するぐらいかな‥‥」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「オマエ、死んじゃうかもしれないんだぞ？」"},
{"id": 114, "speaker": 13, "form": "dlg", "jp": "「‥‥っていうか、オレは負ける気がしないんだよ！」"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "「はあ？」"},
{"id": 116, "speaker": 13, "form": "dlg", "jp": "「たしかに『力の差』はあるけど、\n　この『ゲーマー』って『ゲーム』うまくないぜ！」"},
{"id": 117, "speaker": 13, "form": "dlg", "jp": "「せっかく『ゲージ』が満タンになってるのに\n　くだらないことで消費しちゃうなんて‥‥」"},
{"id": 118, "speaker": 13, "form": "dlg", "jp": "「そんな『ヘボゲーマー』にオレが負けると思う？」"},
{"id": 119, "speaker": 13, "form": "dlg", "jp": "「オレは『野球』ではリトルリーグにでも負けるけど\n　『野球ゲーム』なら大リーガーにも負けないし」"},
{"id": 120, "speaker": 13, "form": "dlg", "jp": "「『空手』なら『茶帯』にも負けるけど\n　『格闘ゲーム』なら『プロレスラー』にも負けないよ！」"},
{"id": 121, "speaker": 13, "form": "dlg", "jp": "「つまり、"},
{"id": 122, "speaker": 13, "form": "dlg", "jp": "オレは『ヘボゲーマー』には\n　『ゲーム』では負けない"},
{"id": 123, "speaker": 13, "form": "dlg", "jp": "んだな！」"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「意味はわかんないけど、とにかくスゴイ自信だな‥‥」"},
{"id": 125, "speaker": 13, "form": "dlg", "jp": "「ヘの突っ張りはいらないんだよ！」"},
{"id": 126, "speaker": 46, "form": "dlg", "jp": "「とにかくアナタがたは\n　休めるウチに体を休めておいてください‥‥」"},
{"id": 127, "speaker": 46, "form": "dlg", "jp": "「もし、次に『ゲーマー』から攻撃があるときは間違いなく」"},
{"id": 128, "speaker": 46, "form": "dlg", "jp": "「　"},
{"id": 129, "speaker": 46, "form": "dlg", "jp": "『　決　戦　』"},
{"id": 130, "speaker": 46, "form": "dlg", "jp": "　で　す　」"},
{"id": 131, "speaker": 29, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 132, "speaker": 29, "form": "dlg", "jp": "「さあ、行きましょう‥‥」"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "ボクたちは『宿泊棟』に戻ることになった。"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "失敗の原因は冷静にならなかったこと‥‥\n冷静に判断すれば本当に『答え』が見えるハズ。\n『解なし』もまた『解』なり‥‥"}
]
