[
{"id": 0, "speaker": 13, "form": "dlg", "jp": "「うわっ！」"},
{"id": 1, "speaker": 13, "form": "dlg", "jp": "「オイコラ！　ドコへ連れて行く気だ！」"},
{"id": 2, "speaker": 13, "form": "dlg", "jp": "この声は『ツトム』！？"},
{"id": 3, "speaker": 45, "form": "dlg", "jp": "「さあ、大人しくするんだ！」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「ツトム！！」"},
{"id": 5, "speaker": 13, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 6, "speaker": 46, "form": "dlg", "jp": "「知り合いなんですね？」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「ハイ、同級生です‥‥」"},
{"id": 8, "speaker": 13, "form": "dlg", "jp": "「シンちゃんが大変な時に、\n　なんでコスプレなんかしてるんだよ！」"},
{"id": 9, "speaker": 31, "form": "dlg", "jp": "「コスプレ！？」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「コレには理由があるんだ‥‥」"},
{"id": 11, "speaker": 13, "form": "dlg", "jp": "「なんだよ、理由って？」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「それより、『シンちゃん』は？」"},
{"id": 13, "speaker": 13, "form": "dlg", "jp": "「運びこまれた病院はわかったんだけど、\n　そこからさらに別の病院に‥‥」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「なんで？」"},
{"id": 15, "speaker": 13, "form": "dlg", "jp": "「そこの病院ではできない手術をするんだって‥‥」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「じゃあ？」"},
{"id": 17, "speaker": 13, "form": "dlg", "jp": "「まだ、会えてないんだよ‥‥」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "「ちょっと、いいかしら？」"},
{"id": 20, "speaker": 13, "form": "dlg", "jp": "「アンタはプールの‥‥？」"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "「いったい、何しに来たの？」"},
{"id": 22, "speaker": 13, "form": "dlg", "jp": "「はあ？」"},
{"id": 23, "speaker": 13, "form": "dlg", "jp": "「ナゴム、この人はいったい何言ってるんだぁ？」"},
{"id": 24, "speaker": 45, "form": "dlg", "jp": "「たぶん、彼は何もわかってないハズです‥‥」"},
{"id": 25, "speaker": 45, "form": "dlg", "jp": "「私が間違って呼び寄せただけですから‥‥」"},
{"id": 26, "speaker": 50, "form": "dlg", "jp": "「コチラのミスじゃあ、殺すわけにはいかないですね‥‥」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「出口！！」"},
{"id": 28, "speaker": 13, "form": "dlg", "jp": "「殺す！？」"},
{"id": 29, "speaker": 46, "form": "dlg", "jp": "「たしかにそうですね‥‥」"},
{"id": 30, "speaker": 50, "form": "dlg", "jp": "「リーダーの能力で記憶を消して\n　送り返してあげるというのは？」"},
{"id": 31, "speaker": 45, "form": "dlg", "jp": "「そ、それがいいですね！」"},
{"id": 32, "speaker": 46, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 33, "speaker": 46, "form": "dlg", "jp": "「でも、その前にこの少年と少し話をさせてくだい‥‥」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「はあ？」"},
{"id": 35, "speaker": 46, "form": "dlg", "jp": "「彼からは不思議なオーラを感じるのです」"},
{"id": 36, "speaker": 18, "form": "dlg", "jp": "「たしかに、角川くんって、\n　ちょっと『不思議』よね‥‥」"},
{"id": 37, "speaker": 13, "form": "dlg", "jp": "「堤がコスプレしてる方がよっぽど不思議だよ！」"},
{"id": 38, "speaker": 16, "form": "dlg", "jp": "「あのう‥‥」"},
{"id": 39, "speaker": 16, "form": "dlg", "jp": "「外国人からすれば\n　『不思議』に見えるかもしれないけど‥‥」"},
{"id": 40, "speaker": 16, "form": "dlg", "jp": "「彼は日本ではフツーのどこにでもいる\n　『オタク』って人種なんだけど‥‥」"},
{"id": 41, "speaker": 46, "form": "dlg", "jp": "「『日本』にはどこにでもいる？」"},
{"id": 42, "speaker": 46, "form": "dlg", "jp": "「『竹島』や『尖閣諸島』にも？」"},
{"id": 43, "speaker": 16, "form": "dlg", "jp": "「まあ、そこまでは知らないけど‥‥」"},
{"id": 44, "speaker": 16, "form": "dlg", "jp": "「『秋葉原』や『日本橋』、\n　『大須』にはウジャウジャと‥‥」"},
{"id": 45, "speaker": 13, "form": "dlg", "jp": "「コスプレヤロウに『オタク』とか言われたくねえよ！」"},
{"id": 46, "speaker": 15, "form": "dlg", "jp": "「あのう‥‥」"},
{"id": 47, "speaker": 15, "form": "dlg", "jp": "「『不思議』なんじゃなくって\n　ただ『変わり者』なだけなんですけど‥‥」"},
{"id": 48, "speaker": 13, "form": "dlg", "jp": "「コスプレヤロウに『変わり者』とか言われたくねえよ！」"},
{"id": 49, "speaker": 51, "form": "dlg", "jp": "「ちょっといい？」"},
{"id": 50, "speaker": 51, "form": "dlg", "jp": "「たしかに、コイツは変わってるけど」"},
{"id": 51, "speaker": 51, "form": "dlg", "jp": "「それは日本では『不思議』とは言わず『変』って言うの」"},
{"id": 52, "speaker": 51, "form": "dlg", "jp": "「つまり、ただの『変』なヤツや！」"},
{"id": 53, "speaker": 13, "form": "dlg", "jp": "「コスプレヤロウに『変』とか言われたくねえよ！」"},
{"id": 54, "speaker": 13, "form": "dlg", "jp": "「なんだ、みんな似たような服着やがって！」"},
{"id": 55, "speaker": 13, "form": "dlg", "jp": "「オカシな団体じゃないだろうな？」"},
{"id": 56, "speaker": 13, "form": "dlg", "jp": "「もしかして、オマエたちがあの『ＵＦＯ』の‥‥？」"},
{"id": 57, "speaker": 46, "form": "dlg", "jp": "「たしかにあの『ＵＦＯ』は私たちのものです‥‥」"},
{"id": 58, "speaker": 13, "form": "dlg", "jp": "「じゃあ、オマエたちが『シンちゃん』を‥‥！」"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "「ちょっと、待てよ！」"},
{"id": 60, "speaker": 13, "form": "dlg", "jp": "「ナゴム、オマエもソイツらの仲間なのか！？」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "「話を聞いてくれよ！！」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "ボクは『クリエーター』のことや、\n『Ｅ－ｇｒｏ』のことをツトムに説明した。"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「どう？\n　わかってくれた？」"},
{"id": 64, "speaker": 13, "form": "dlg", "jp": "「言いたいことはわかったよっ！」"},
{"id": 65, "speaker": 13, "form": "dlg", "jp": "「でも、そんな幼稚なウソにはだまされないぞ‥‥」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「ウソじゃないんだ！」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「信じてくれよ！」"},
{"id": 68, "speaker": 13, "form": "dlg", "jp": "「信じようがないだろう？」"},
{"id": 69, "speaker": 13, "form": "dlg", "jp": "「本当だとしたらオマエたちの能力で\n　オレの記憶を消しちゃうんだから‥‥」"},
{"id": 70, "speaker": 13, "form": "dlg", "jp": "「で、オレの記憶を消せないんなら、\n　オマエたちの言うことはウソだってことになるし‥‥」"},
{"id": 71, "speaker": 13, "form": "dlg", "jp": "「だいたい、ウソじゃないんだったら」"},
{"id": 72, "speaker": 13, "form": "dlg", "jp": "「いつまで、\n　その『クリエーター』のスキにさせてるんだよ！」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「それは‥‥」"},
{"id": 74, "speaker": 29, "form": "dlg", "jp": "「防ぐ手段がないからよ‥‥」"},
{"id": 75, "speaker": 31, "form": "dlg", "jp": "「相手は姿も見せないんだ、\n　止めようがないだろろう？」"},
{"id": 76, "speaker": 13, "form": "dlg", "jp": "「それが『ウソ』だって言うんだよ！」"},
{"id": 77, "speaker": 13, "form": "dlg", "jp": "「『遠隔操作』なんだから、\n　いくらでも止めようがあるだろう！？」"},
{"id": 78, "speaker": 46, "form": "dlg", "jp": "「ちょっと待って下さい！」"},
{"id": 79, "speaker": 46, "form": "dlg", "jp": "「アナタはその方法がわかるのですか？」"},
{"id": 80, "speaker": 13, "form": "dlg", "jp": "「わかるだろう？」"},
{"id": 81, "speaker": 13, "form": "dlg", "jp": "「フツー‥‥」"},
{"id": 82, "speaker": 31, "form": "dlg", "jp": "「本当にわかるのか！？」"},
{"id": 83, "speaker": 13, "form": "dlg", "jp": "「えっ、何？」"},
{"id": 84, "speaker": 13, "form": "dlg", "jp": "「みんな、本当にわからないの？」"},
{"id": 85, "speaker": 46, "form": "dlg", "jp": "「残念ながら‥‥」"},
{"id": 86, "speaker": 46, "form": "dlg", "jp": "「良ければ、教えてもらえませんか？」"},
{"id": 87, "speaker": 13, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 88, "speaker": 13, "form": "dlg", "jp": "「本気なのか？」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 90, "speaker": 13, "form": "dlg", "jp": "「信じられないなぁ‥‥」"},
{"id": 91, "speaker": 51, "form": "dlg", "jp": "「本当や、信じて！」"},
{"id": 92, "speaker": 13, "form": "dlg", "jp": "「小田まで‥‥！？」"},
{"id": 93, "speaker": 15, "form": "dlg", "jp": "「本当よ、信じて！」"},
{"id": 94, "speaker": 13, "form": "dlg", "jp": "「三船まで‥‥！？」"},
{"id": 95, "speaker": 16, "form": "dlg", "jp": "「本当よ、信じて！」"},
{"id": 96, "speaker": 13, "form": "dlg", "jp": "「長尾まで‥‥！？」"},
{"id": 97, "speaker": 18, "form": "dlg", "jp": "「本当よ、信じて！」"},
{"id": 98, "speaker": 13, "form": "dlg", "jp": "「堤まで‥‥！？」"},
{"id": 99, "speaker": 13, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "「教えてくれるのね？」"},
{"id": 101, "speaker": 13, "form": "dlg", "jp": "「そのかわり、殺さないでくれよ！」"},
{"id": 102, "speaker": 46, "form": "dlg", "jp": "「無関係な人間が秘密を知ったのなら、\n　それなりの処置が必要になりますが」"},
{"id": 103, "speaker": 46, "form": "dlg", "jp": "「ワレワレに有益な人間なら、\n　話はまったく別です‥‥」"},
{"id": 104, "speaker": 13, "form": "dlg", "jp": "「じゃあ、話すけど‥‥」"},
{"id": 105, "speaker": 13, "form": "dlg", "jp": "「相手は『遠隔攻撃』なんだろう？」"},
{"id": 106, "speaker": 13, "form": "dlg", "jp": "「つまり、離れた場所から操ってるんだろう？」"},
{"id": 107, "speaker": 13, "form": "dlg", "jp": "「いったいどうやって？」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "「どうやって‥‥」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「離れた場所から操るとしたら‥‥」"},
{"id": 110, "speaker": 2, "form": "choice", "jp": "「事前に命令を出しておく？」"},
{"id": 111, "speaker": 2, "form": "choice", "jp": "「命令の信号を送る？」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「事前に命令を出しておく？」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「つまり、『タイマー機能』みたいなの‥‥」"},
{"id": 114, "speaker": 13, "form": "dlg", "jp": "「事前っていつなんだよ！」"},
{"id": 115, "speaker": 13, "form": "dlg", "jp": "「あの『ＵＦＯ』は事前に命令を入力されていたのか？」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 117, "speaker": 2, "form": "choice", "jp": "「わからない‥‥」"},
{"id": 118, "speaker": 2, "form": "choice", "jp": "「命令の信号を送る？」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「わからない‥‥」"},
{"id": 120, "speaker": 13, "form": "dlg", "jp": "「オマエ、ふざけてるだろう？」"},
{"id": 121, "speaker": 13, "form": "dlg", "jp": "「本当にわからないのか？」"},
{"id": 122, "speaker": 13, "form": "dlg", "jp": "「わかるだろう遠隔操作っていったら、\n　事前に命令を入力しておくか」"},
{"id": 123, "speaker": 13, "form": "dlg", "jp": "「離れた場所から命令信号を送るかの\n　どちらかだろう？」"},
{"id": 124, "speaker": 13, "form": "dlg", "jp": "「で、事前に命令を入力してないんだったら？」"},
{"id": 125, "speaker": 13, "form": "choice", "jp": "「事前に命令を出しておく？」"},
{"id": 126, "speaker": 13, "form": "choice", "jp": "「命令の信号を送る？」"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「事前に命令を出しておく？」"},
{"id": 128, "speaker": 13, "form": "dlg", "jp": "「だから、それは違うんだろう！」"},
{"id": 129, "speaker": 13, "form": "dlg", "jp": "「イギリスのコントじゃないんだぞ！」"},
{"id": 130, "speaker": 13, "form": "dlg", "jp": "「シュールな冗談は鼻につくんだよ！」"},
{"id": 131, "speaker": 13, "form": "dlg", "jp": "「もう１回聞くぞ！」"},
{"id": 132, "speaker": 13, "form": "dlg", "jp": "「離れた場所から命令信号を送るかの\n　どちらかだろう？」"},
{"id": 133, "speaker": 13, "form": "dlg", "jp": "「で、事前に命令を入力してないんだったら？」"},
{"id": 134, "speaker": 13, "form": "choice", "jp": "「事前に命令を出しておく？」"},
{"id": 135, "speaker": 13, "form": "choice", "jp": "「命令の信号を送る？」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「事前に命令を出しておく？」"},
{"id": 137, "speaker": 13, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 138, "speaker": 13, "form": "choice", "jp": "「事前に命令を出しておく？」"},
{"id": 139, "speaker": 13, "form": "choice", "jp": "「命令の信号を送る？」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「事前に命令を出しておく？」"},
{"id": 141, "speaker": 13, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「いや、違うな！」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「命令を事前に出しておくか？」"},
{"id": 144, "speaker": 13, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「ジゼンニ　メイレイヲ　ダシテオーク？」"},
{"id": 147, "speaker": 13, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「自然に年齢が増していくだっけ？」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「記念にめいめいがダッシュする？」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「奥手のメイメイが自転車に乗る？」"},
{"id": 151, "speaker": 13, "form": "dlg", "jp": "「もういいよ！」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「いいのか、自転車に乗らなくて？」"},
{"id": 153, "speaker": 13, "form": "dlg", "jp": "「乗らないよ！！」"},
{"id": 154, "speaker": 13, "form": "dlg", "jp": "「本当に人類のピンチなのか？」"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "「えっ！」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「自転車に乗れないと人類はピンチなのか！？」"},
{"id": 157, "speaker": 13, "form": "dlg", "jp": "「自転車はいいんだよ！」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「じゃあ、年増のメイメイは？」"},
{"id": 159, "speaker": 13, "form": "dlg", "jp": "「誰なんだよ！！」"},
{"id": 160, "speaker": 13, "form": "dlg", "jp": "「『年増のメイメイ』って！」"},
{"id": 161, "speaker": 13, "form": "dlg", "jp": "「中国人か！？」"},
{"id": 162, "speaker": 13, "form": "dlg", "jp": "「それに\n　さっきは『奥手のメイメイ』って言ってただろう？」"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「奥手で年増の中国人なんだ‥‥」"},
{"id": 164, "speaker": 13, "form": "dlg", "jp": "「まあ、中国人もピンチだろうけどよ！」"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "「やっぱり中国って言えば『自転車』だよな！」"},
{"id": 166, "speaker": 13, "form": "dlg", "jp": "「だから、中国人はかんけいないだろう？」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「そんなことはないよ！」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「人類の４分の１は中国人だし‥‥」"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "「残りの半分はやさしさから出来てるって‥‥」"},
{"id": 170, "speaker": 13, "form": "dlg", "jp": "「残りは４分の３だろう？」"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "「あ、そうそう‥‥」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「ポテトチップスの残の８分３はどこにいったんだろう？」"},
{"id": 173, "speaker": 13, "form": "dlg", "jp": "「冗談もいいかげんにしろよ！」"},
{"id": 174, "speaker": 13, "form": "dlg", "jp": "「まあ、\n　オレはオマエたちの話を信じてないからいいけど‥‥」"},
{"id": 175, "speaker": 13, "form": "dlg", "jp": "「信じてるヤツが聞いたら激怒するぞ？」"},
{"id": 176, "speaker": 13, "form": "dlg", "jp": "「世の中は心の広い人間ばかりじゃないんだぞ？」"},
{"id": 177, "speaker": 13, "form": "dlg", "jp": "「壮大なストーリーのゲームの前半に\n　チョロっと出てくる冗談が許せないヤツもいるんだ！」"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「で、そんなヤツは全体の何分の１なんだ？」"},
{"id": 180, "speaker": 13, "form": "dlg", "jp": "「あああああああああああ～～～～～っ！」"},
{"id": 181, "speaker": 13, "form": "dlg", "jp": "「コロスぞっ！！」"},
{"id": 182, "speaker": 13, "form": "dlg", "jp": "こうして、ボクはツトムをからかい続けた。"},
{"id": 183, "speaker": 13, "form": "dlg", "jp": "‥‥‥"},
{"id": 184, "speaker": 13, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 185, "speaker": 13, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「命令の信号を送る？」"},
{"id": 187, "speaker": 13, "form": "dlg", "jp": "「バカ！！」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「違うのか？」"},
{"id": 189, "speaker": 13, "form": "dlg", "jp": "「オマエはギャグのセンス『０』だな‥‥」"},
{"id": 190, "speaker": 13, "form": "dlg", "jp": "「ツマランギャグは３回くり返すのが基本だろう！！」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 192, "speaker": 13, "form": "dlg", "jp": "「まあ、信号を送るのは正解だけどな‥‥」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「命令の信号を送る？」"},
{"id": 194, "speaker": 31, "form": "dlg", "jp": "「まあ、そうだろうな‥‥」"},
{"id": 195, "speaker": 29, "form": "dlg", "jp": "「『クリエーター』が活動する時には\n　必ず『邪悪な感覚』を感じるし‥‥」"},
{"id": 196, "speaker": 13, "form": "dlg", "jp": "「じゃあ、\n　その『信号』を遮断（シャダン）すればいいだけじゃん！」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 198, "speaker": 13, "form": "dlg", "jp": "「『信号』がコントロールしてるんだろう？」"},
{"id": 199, "speaker": 13, "form": "dlg", "jp": "「その『信号』させ遮断すれば、\n　何もコントロールできなくなるだろ！」"},
{"id": 200, "speaker": 46, "form": "dlg", "jp": "「た、たしかに‥‥」"},
{"id": 201, "speaker": 13, "form": "dlg", "jp": "「この世界のどこかに『クリエーター』の\n　信号の『受信装置』があるハズだよ！」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「ジーン‥‥」"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "「キミの能力で探せないかな？」"},
{"id": 204, "speaker": 29, "form": "dlg", "jp": "「ダメ、\n　具体的に『イメージ』が出来ないものは探せないわ！」"},
{"id": 205, "speaker": 13, "form": "dlg", "jp": "「アンタら本当に大丈夫か？」"},
{"id": 206, "speaker": 13, "form": "dlg", "jp": "「探す必要なんかないじゃないか？」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 208, "speaker": 13, "form": "dlg", "jp": "「アンタらの話をまとめれば、\n　『受信装置』は１つしか考えられないだろう？」"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "「まさか？」"},
{"id": 210, "speaker": 13, "form": "dlg", "jp": "「そうだよ！」"},
{"id": 211, "speaker": 13, "form": "dlg", "jp": "「その『アカシのタコ』だよ！」"},
{"id": 212, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 213, "speaker": 29, "form": "dlg", "jp": "『アカシックレコード』"},
{"id": 214, "speaker": 29, "form": "dlg", "jp": "が！？」"},
{"id": 215, "speaker": 13, "form": "dlg", "jp": "「そうじゃないの？」"},
{"id": 216, "speaker": 46, "form": "dlg", "jp": "「ジーン‥‥」"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って‥‥」"},
{"id": 218, "speaker": 29, "form": "dlg", "jp": "ジーンは『アカシックレコード』を調べ始めた。"},
{"id": 219, "speaker": 31, "form": "dlg", "jp": "「どうなんだ？」"},
{"id": 220, "speaker": 29, "form": "dlg", "jp": "「たしかに、『アカシックレコード』の周りが\n　一番、『邪悪な感覚』が‥‥」"},
{"id": 221, "speaker": 31, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 222, "speaker": 35, "form": "dlg", "jp": "「でも、『アカシックレコード』が『信号』の発信源なら、\n　ちょっと困ったことになるよね」"},
{"id": 223, "speaker": 31, "form": "dlg", "jp": "「ああ、そうだな‥‥」"},
{"id": 224, "speaker": 13, "form": "dlg", "jp": "「どうして？」"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "「『アカシックレコード』は破壊不可能なんだよ‥‥」"},
{"id": 226, "speaker": 13, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 227, "speaker": 13, "form": "dlg", "jp": "「どうして、そう難しく考えるかなぁ？」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 229, "speaker": 13, "form": "dlg", "jp": "「『信号』を遮断するだけでいいんだから、\n　別に破壊しなくてもいいじゃないか！！」"},
{"id": 230, "speaker": 46, "form": "dlg", "jp": "「どういうことですか？」"},
{"id": 231, "speaker": 13, "form": "dlg", "jp": "「ナゴム教えてやれよ！」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「えっ、ボクが！？」"},
{"id": 233, "speaker": 13, "form": "dlg", "jp": "「一般的な答えでいいんだよ！」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「一般的？」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「普通、こういう場合は‥‥」"},
{"id": 236, "speaker": 2, "form": "choice", "jp": "「『妨害電波』を出す‥‥」"},
{"id": 237, "speaker": 2, "form": "choice", "jp": "「『信号』の発信源をこわす‥‥」"},
{"id": 238, "speaker": 2, "form": "choice", "jp": "「『遮断壁』をたてる‥‥」"},
{"id": 239, "speaker": 13, "form": "dlg", "jp": "「なんだよ！」"},
{"id": 240, "speaker": 13, "form": "dlg", "jp": "「いろいろあるだろう？」"},
{"id": 241, "speaker": 13, "form": "dlg", "jp": "「『妨害電波』を出すとか」"},
{"id": 242, "speaker": 13, "form": "dlg", "jp": "「『遮断壁』をたてるとか‥‥」"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「『信号』の発信源をこわす‥‥」"},
{"id": 244, "speaker": 13, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 245, "speaker": 13, "form": "dlg", "jp": "「こわせないんだろう？」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 247, "speaker": 2, "form": "choice", "jp": "「『妨害電波』を出す‥‥」"},
{"id": 248, "speaker": 2, "form": "choice", "jp": "「『遮断壁』をたてる‥‥」"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "「『妨害電波』を出す‥‥」"},
{"id": 250, "speaker": 13, "form": "dlg", "jp": "「うん、正解だな‥‥」"},
{"id": 251, "speaker": 13, "form": "dlg", "jp": "「あと、『遮断壁』をたてるってのもアリだな‥‥」"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "「『遮断壁』をたてる‥‥」"},
{"id": 253, "speaker": 13, "form": "dlg", "jp": "「うん、正解だな‥‥」"},
{"id": 254, "speaker": 13, "form": "dlg", "jp": "「あと、『妨害電波』を流すってのもアリだな‥‥」"},
{"id": 255, "speaker": 50, "form": "dlg", "jp": "「なるほど！」"},
{"id": 256, "speaker": 13, "form": "dlg", "jp": "「だから、その『アカシなんとか‥‥』の周りを\n　『信号』を遮断する何かで囲んでやれば‥‥」"},
{"id": 257, "speaker": 46, "form": "dlg", "jp": "「た、たしかに！！」"},
{"id": 258, "speaker": 35, "form": "dlg", "jp": "「でも、その『信号』ってどうやって遮断するの？」"},
{"id": 259, "speaker": 35, "form": "dlg", "jp": "「その信号って、ジーンもわからない、\n　"},
{"id": 260, "speaker": 35, "form": "dlg", "jp": "『未知の信号』"},
{"id": 261, "speaker": 35, "form": "dlg", "jp": "なんだろう？」"},
{"id": 262, "speaker": 29, "form": "dlg", "jp": "「そ、そうね‥‥」"},
{"id": 263, "speaker": 13, "form": "dlg", "jp": "「ただ、信号を消すだけだったら、\n　『未知』も『既知』も関係ないだろう？」"},
{"id": 264, "speaker": 31, "form": "dlg", "jp": "「そんなことはないだろう？」"},
{"id": 265, "speaker": 13, "form": "dlg", "jp": "「さっきからの話を聞いてないのかよ！」"},
{"id": 266, "speaker": 13, "form": "dlg", "jp": "「アンタらはすべての物事を難しく考えすぎなんだよ！」"},
{"id": 267, "speaker": 13, "form": "dlg", "jp": "「『信号』をかき消すって、\n　どうやるか考えればわかるだろう？」"},
{"id": 268, "speaker": 35, "form": "dlg", "jp": "「どうするの？」"},
{"id": 269, "speaker": 13, "form": "dlg", "jp": "「元の信号を"},
{"id": 270, "speaker": 13, "form": "dlg", "jp": "『ひっくり返してぶつける』"},
{"id": 271, "speaker": 13, "form": "dlg", "jp": "んだよ！」"},
{"id": 272, "speaker": 13, "form": "dlg", "jp": "「山には谷、谷には山をぶつければ、\n　フラットになるだろう？」"},
{"id": 273, "speaker": 13, "form": "dlg", "jp": "「つまり、あそこから出てきている『信号』を\n　"},
{"id": 274, "speaker": 13, "form": "dlg", "jp": "ひっくり返す装置"},
{"id": 275, "speaker": 13, "form": "dlg", "jp": "さえあれば」"},
{"id": 276, "speaker": 13, "form": "dlg", "jp": "「何も難しい装置も技術もいらないだろう！」"},
{"id": 277, "speaker": 46, "form": "dlg", "jp": "「た、たしかにそうですね‥‥」"},
{"id": 278, "speaker": 46, "form": "dlg", "jp": "「ジーンすぐに『エンジニア』の手配を！」"},
{"id": 279, "speaker": 29, "form": "dlg", "jp": "「は、はい！」"},
{"id": 280, "speaker": 29, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 281, "speaker": 13, "form": "dlg", "jp": "「で、オレは殺されるのかな？」"},
{"id": 282, "speaker": 46, "form": "dlg", "jp": "「とんでもありません！」"},
{"id": 283, "speaker": 46, "form": "dlg", "jp": "「『作戦参謀』になっていただきたいぐらいです！」"},
{"id": 284, "speaker": 13, "form": "dlg", "jp": "「なら、いいんだけど‥‥」"},
{"id": 285, "speaker": 46, "form": "dlg", "jp": "「ナゴム、アスカ‥‥」"},
{"id": 286, "speaker": 46, "form": "dlg", "jp": "「彼を送っていってあげてください」"},
{"id": 287, "speaker": 35, "form": "dlg", "jp": "「えっ！」"},
{"id": 288, "speaker": 35, "form": "dlg", "jp": "「日本に帰っていいの？」"},
{"id": 289, "speaker": 31, "form": "dlg", "jp": "「そのコを送り帰したら、\n　すぐに戻ってくるんだよ！」"},
{"id": 290, "speaker": 35, "form": "dlg", "jp": "「な～～んだ‥‥」"},
{"id": 291, "speaker": 31, "form": "dlg", "jp": "「早くいけよ！」"},
{"id": 292, "speaker": 13, "form": "dlg", "jp": "「ちょっと待ってよ！」"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "「どうしたんだよ？」"},
{"id": 294, "speaker": 13, "form": "dlg", "jp": "「オレもココに残るよっ！」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "「なんで？」"},
{"id": 296, "speaker": 13, "form": "dlg", "jp": "「オマエたちだけじゃ危なっかしいだろう？」"},
{"id": 297, "speaker": 29, "form": "dlg", "jp": "「大丈夫よ！」"},
{"id": 298, "speaker": 29, "form": "dlg", "jp": "「ここには優秀なエンジニアもたくさんいるから」"},
{"id": 299, "speaker": 29, "form": "dlg", "jp": "「キミが言った通りの装置ぐらい簡単に‥‥」"},
{"id": 300, "speaker": 13, "form": "dlg", "jp": "「オレもシンちゃんのカタキを取りたいんだよ！」"},
{"id": 301, "speaker": 13, "form": "dlg", "jp": "「せめて、その装置が完成するまで、\n　ここにいちゃいけませんか？」"},
{"id": 302, "speaker": 46, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 303, "speaker": 46, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 304, "speaker": 46, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 305, "speaker": 46, "form": "dlg", "jp": "「いいでしょう‥‥」"},
{"id": 306, "speaker": 46, "form": "dlg", "jp": "「ただし‥‥」"},
{"id": 307, "speaker": 46, "form": "dlg", "jp": "「家族の方が心配しないように、\n　一度帰って話をして来て下さい‥‥」"},
{"id": 308, "speaker": 13, "form": "dlg", "jp": "「ありがとう！」"},
{"id": 309, "speaker": 13, "form": "dlg", "jp": "こうして、ツトムもココに残ることになった。"}
]
