[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／２９／ＰＭ０８：００"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "そして、８時になった。"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "ニュースでは、『アメリカ』と『イギリス』のＵＦＯは\nまだ、活動を停止しておらず"},
{"id": 3, "speaker": null, "form": "dlg", "jp": "『アメリカ』ではいまだ軍と戦闘中。"},
{"id": 4, "speaker": null, "form": "dlg", "jp": "『イギリス』は２回に渡る攻撃が失敗し、"},
{"id": 5, "speaker": null, "form": "dlg", "jp": "現在、軍は事態を見守っているらしい。"},
{"id": 6, "speaker": null, "form": "dlg", "jp": "さらに、ＵＦＯは『中国』と『インド』、\nそして『ロシア』にも現れたという。"},
{"id": 7, "speaker": null, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 8, "speaker": null, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 9, "speaker": 15, "form": "dlg", "jp": "「ゴメンなさい！」"},
{"id": 10, "speaker": 15, "form": "dlg", "jp": "「説得に手間取っちゃって‥‥」"},
{"id": 11, "speaker": 31, "form": "dlg", "jp": "「気にするな！」"},
{"id": 12, "speaker": 31, "form": "dlg", "jp": "「すんなり、説得できるとは思ってなかったよ！」"},
{"id": 13, "speaker": 15, "form": "dlg", "jp": "「それより、テレビ観た！？」"},
{"id": 14, "speaker": 15, "form": "dlg", "jp": "「アメリカ軍、スゴイことになってるわね！」"},
{"id": 15, "speaker": 15, "form": "dlg", "jp": "「もうＵＦＯより、それを破壊しようとする\n　軍の戦闘機の暴走の方がひどくって‥‥」"},
{"id": 16, "speaker": 15, "form": "dlg", "jp": "「もう１００機ぐらい戦闘機壊されちゃってるわよ！」"},
{"id": 17, "speaker": 16, "form": "dlg", "jp": "「ゴメンなさい！」"},
{"id": 18, "speaker": 16, "form": "dlg", "jp": "「説得に手間取っちゃって‥‥」"},
{"id": 19, "speaker": 31, "form": "dlg", "jp": "「気にするな！」"},
{"id": 20, "speaker": 31, "form": "dlg", "jp": "「すんなり、説得できるとは思ってなかったよ！」"},
{"id": 21, "speaker": 16, "form": "dlg", "jp": "「それより、テレビ観た！？」"},
{"id": 22, "speaker": 16, "form": "dlg", "jp": "「アメリカ軍、スゴイことになってるわね！」"},
{"id": 23, "speaker": 16, "form": "dlg", "jp": "「もうＵＦＯより、それを破壊しようとする\n　軍の戦闘機の暴走の方がひどくって‥‥」"},
{"id": 24, "speaker": 16, "form": "dlg", "jp": "「もう１００機ぐらい戦闘機壊されちゃってるわよ！」"},
{"id": 25, "speaker": 18, "form": "dlg", "jp": "「ゴメンなさい！」"},
{"id": 26, "speaker": 18, "form": "dlg", "jp": "「説得に手間取っちゃって‥‥」"},
{"id": 27, "speaker": 31, "form": "dlg", "jp": "「気にするな！」"},
{"id": 28, "speaker": 31, "form": "dlg", "jp": "「すんなり、説得できるとは思ってなかったよ！」"},
{"id": 29, "speaker": 18, "form": "dlg", "jp": "「それより、テレビ観ました！？」"},
{"id": 30, "speaker": 18, "form": "dlg", "jp": "「アメリカが大変なことに‥‥」"},
{"id": 31, "speaker": 18, "form": "dlg", "jp": "「ＵＦＯを破壊しようとする\n　軍の戦闘機の暴走の方がひどくって‥‥」"},
{"id": 32, "speaker": 18, "form": "dlg", "jp": "「もう１００機ぐらい戦闘機壊されたみたいなの！」"},
{"id": 33, "speaker": 31, "form": "dlg", "jp": "「心配するな！」"},
{"id": 34, "speaker": 31, "form": "dlg", "jp": "「あの国では戦闘機の１００機ぐらい、\n　痛くもかゆくもないよ‥‥」"},
{"id": 35, "speaker": 29, "form": "dlg", "jp": "「まあ、必死で破壊したいキモチはわかるけど‥‥」"},
{"id": 36, "speaker": 29, "form": "dlg", "jp": "「あのＵＦＯが本当はＵＦＯじゃなくって、\n　米軍の兵器だってバレたら世界中大騒ぎに‥‥」"},
{"id": 37, "speaker": 31, "form": "dlg", "jp": "「案外、それが『ゲーマー』の作戦かも‥‥」"},
{"id": 38, "speaker": 31, "form": "dlg", "jp": "「アメリカの兵器が世界中攻撃してるってなると」"},
{"id": 39, "speaker": 31, "form": "dlg", "jp": "「間違いなく世界戦争になるな‥‥」"},
{"id": 40, "speaker": 29, "form": "dlg", "jp": "「人間のバカさ加減を考えたら、\n　ゲーマーじゃなくても全滅させたくなるわね‥‥」"},
{"id": 41, "speaker": 31, "form": "dlg", "jp": "「まあ、罪のない人間もいるのは間違いないんだから‥‥」"},
{"id": 42, "speaker": 31, "form": "dlg", "jp": "「早くなんとかしてやんないとな‥‥」"},
{"id": 43, "speaker": 31, "form": "dlg", "jp": "「そのうち『核』なんか持ち出したりしたら‥‥」"},
{"id": 44, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 45, "speaker": 29, "form": "dlg", "jp": "「みんなそろったことだし、\n　早速出発しましょう！」"},
{"id": 46, "speaker": 29, "form": "dlg", "jp": "「アスカ、お願いね！」"},
{"id": 47, "speaker": 35, "form": "dlg", "jp": "「お願いって‥‥」"},
{"id": 48, "speaker": 35, "form": "dlg", "jp": "「オレは本部の場所なんて知らないから‥‥」"},
{"id": 49, "speaker": 29, "form": "dlg", "jp": "「大丈夫よ！」"},
{"id": 50, "speaker": 35, "form": "dlg", "jp": "「ダメだよ！」"},
{"id": 51, "speaker": 35, "form": "dlg", "jp": "「オレ、イメージできない場所には行けないんだって！」"},
{"id": 52, "speaker": 29, "form": "dlg", "jp": "「大丈夫だって！」"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "「本部はイメージしやすい場所にあるから‥‥」"},
{"id": 54, "speaker": 35, "form": "dlg", "jp": "「無理だって！」"},
{"id": 55, "speaker": 35, "form": "dlg", "jp": "「オレ、『ペルー』のこと本当に知らないんだよ！」"},
{"id": 56, "speaker": 35, "form": "dlg", "jp": "「多分みんなも知らないと思うよ！」"},
{"id": 57, "speaker": 35, "form": "dlg", "jp": "「ナゴムくん、ペルーの首都はどこ？」"},
{"id": 58, "speaker": 35, "form": "choice", "jp": "「リオデジャネーロ！」"},
{"id": 59, "speaker": 35, "form": "choice", "jp": "「リマ！」"},
{"id": 60, "speaker": 35, "form": "choice", "jp": "「オスロ！」"},
{"id": 61, "speaker": 35, "form": "dlg", "jp": "「ホラ、わからないだろう？」"},
{"id": 62, "speaker": 35, "form": "dlg", "jp": "「だから無理なの！」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「リオデジャネーロ！」"},
{"id": 64, "speaker": 35, "form": "dlg", "jp": "「なんだ、ナゴムくん知ってるんだ！」"},
{"id": 65, "speaker": 35, "form": "dlg", "jp": "「スゴイな～～！」"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "「間違ってるわよ！」"},
{"id": 67, "speaker": 35, "form": "dlg", "jp": "「じゃあ、みんな知らないんだ！」"},
{"id": 68, "speaker": 35, "form": "dlg", "jp": "「ってわけで無理なの！」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「リマ！」"},
{"id": 70, "speaker": 35, "form": "dlg", "jp": "「なんだ、ナゴムくん知ってるんだ！」"},
{"id": 71, "speaker": 35, "form": "dlg", "jp": "「スゴイな～～！」"},
{"id": 72, "speaker": 35, "form": "dlg", "jp": "「でも、オレは中学生でも知ってることを知らないの！」"},
{"id": 73, "speaker": 35, "form": "dlg", "jp": "「ってわけで無理なの！」"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "「オスロ！」"},
{"id": 75, "speaker": 35, "form": "dlg", "jp": "「なんだ、ナゴムくん知ってるんだ！」"},
{"id": 76, "speaker": 35, "form": "dlg", "jp": "「スゴイな～～！」"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "「間違ってるわよ！」"},
{"id": 78, "speaker": 35, "form": "dlg", "jp": "「じゃあ、みんな知らないんだ！」"},
{"id": 79, "speaker": 35, "form": "dlg", "jp": "「ってわけで無理なの！」"},
{"id": 80, "speaker": 29, "form": "dlg", "jp": "「具体的にその場所を知らなくても、\n　イメージできればどこでも行けるんでしょう？」"},
{"id": 81, "speaker": 29, "form": "dlg", "jp": "「じゃあ、大丈夫よ！」"},
{"id": 82, "speaker": 29, "form": "dlg", "jp": "「多分知っている場所だから‥‥」"},
{"id": 83, "speaker": 35, "form": "dlg", "jp": "「どこなんだよ？」"},
{"id": 84, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 85, "speaker": 29, "form": "dlg", "jp": "『マチュピチュ』"},
{"id": 86, "speaker": 29, "form": "dlg", "jp": "‥‥」"},
{"id": 87, "speaker": 35, "form": "dlg", "jp": "「なんだそれ？」"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "「ちょっと！」"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "「『マチュピチュ』もしらないの？」"},
{"id": 90, "speaker": 29, "form": "dlg", "jp": "「あの有名な"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "『空中都市』"},
{"id": 92, "speaker": 29, "form": "dlg", "jp": "よ！」"},
{"id": 93, "speaker": 35, "form": "dlg", "jp": "「『ラピュタ』のこと？」"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "「空に浮いているんじゃなくて、\n　高い山の上に遺跡のある『観光名所』よ！」"},
{"id": 95, "speaker": 35, "form": "dlg", "jp": "「あっ、それならテレビでよく見るぞ！」"},
{"id": 96, "speaker": 35, "form": "dlg", "jp": "「あれだろう！？」"},
{"id": 97, "speaker": 35, "form": "dlg", "jp": "「観光客相手に高速で走って手をふる子供がいる！！」"},
{"id": 98, "speaker": 29, "form": "dlg", "jp": "「片寄った知識だけど間違いじゃないわ‥‥」"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "「で、それならイメージできそう？」"},
{"id": 100, "speaker": 35, "form": "dlg", "jp": "「ああ、行けると思うよ！」"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "「じゃあ、お願い‥‥」"},
{"id": 102, "speaker": 35, "form": "dlg", "jp": "「わかった！」"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "「というわけで、ナゴムくんをしばらくお借りします」"},
{"id": 104, "speaker": 3, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「じゃあ、行ってくるよ‥‥」"},
{"id": 106, "speaker": 3, "form": "dlg", "jp": "「いってらっしゃい‥‥」"},
{"id": 107, "speaker": 3, "form": "dlg", "jp": "「シュン！」"},
{"id": 108, "speaker": 3, "form": "dlg", "jp": "こうしてボクたちは『本部』のある\n『マチュピチュ』に向かった。"}
]
