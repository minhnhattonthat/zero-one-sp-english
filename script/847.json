[
{"id": 0, "speaker": null, "form": "dlg", "jp": "「コン！コン！」"},
{"id": 1, "speaker": 29, "form": "dlg", "jp": "「ジーンだけど、"},
{"id": 2, "speaker": 29, "form": "dlg", "jp": "入るわよ」"},
{"id": 3, "speaker": 29, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 4, "speaker": 29, "form": "dlg", "jp": "「ナゴム、"},
{"id": 5, "speaker": 29, "form": "dlg", "jp": "起きて！」"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "ボクはジーンの声で目をさました。"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「また、出撃かい？」"},
{"id": 8, "speaker": 29, "form": "dlg", "jp": "「いいえ、そうじゃないわ‥‥」"},
{"id": 9, "speaker": 29, "form": "dlg", "jp": "「ただ、\n　ナゴムのお姉さんたちが"},
{"id": 10, "speaker": 29, "form": "dlg", "jp": "信号の解読に成功した"},
{"id": 11, "speaker": 29, "form": "dlg", "jp": "みたい」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「ホント！？」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "ボクたちは『コンピュータルーム』に行ってみることにした。"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 16, "speaker": 31, "form": "dlg", "jp": "「ナゴム、聞いたか！？」"},
{"id": 17, "speaker": 31, "form": "dlg", "jp": "「『ゲーマーの信号』の解析が完了したって！」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「聞いたよ‥‥」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「今からボクも様子を見に行くところなんだ‥‥」"},
{"id": 20, "speaker": 31, "form": "dlg", "jp": "「コレで『ゲーマーの恐怖』ともオサラバってことだな‥‥」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「そうだといいんだけど‥‥」"},
{"id": 22, "speaker": 3, "form": "dlg", "jp": "「アラ、ナゴム！」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「姉さん‥‥」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「解析が終了したって本当？」"},
{"id": 25, "speaker": 3, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 26, "speaker": 3, "form": "dlg", "jp": "「シローの活躍のおかげよ！」"},
{"id": 27, "speaker": 5, "form": "dlg", "jp": "「あくまでもグウゼンなんだけど、\n　ゲーマーの信号が"},
{"id": 28, "speaker": 5, "form": "dlg", "jp": "人間の思考に近い形"},
{"id": 29, "speaker": 5, "form": "dlg", "jp": "だったから‥‥」"},
{"id": 30, "speaker": 46, "form": "dlg", "jp": "「その話、もっと詳しく聞かせてもらえますか？」"},
{"id": 31, "speaker": 5, "form": "dlg", "jp": "「ええ、かまいませんよ‥‥」"},
{"id": 32, "speaker": 46, "form": "dlg", "jp": "「"},
{"id": 33, "speaker": 46, "form": "dlg", "jp": "人間の思考に近い"},
{"id": 34, "speaker": 46, "form": "dlg", "jp": "っていうのはどういうことなのですか？」"},
{"id": 35, "speaker": 5, "form": "dlg", "jp": "「そうですね、人間の言葉で説明すると\n　"},
{"id": 36, "speaker": 5, "form": "dlg", "jp": "『思念』"},
{"id": 37, "speaker": 5, "form": "dlg", "jp": "みたいなものなんですよ！」"},
{"id": 38, "speaker": 5, "form": "dlg", "jp": "「つまり、具体的な作業手順が\n　デジタル信号化されたようなものではなくて」"},
{"id": 39, "speaker": 5, "form": "dlg", "jp": "「もっと"},
{"id": 40, "speaker": 5, "form": "dlg", "jp": "『アナログな命令』"},
{"id": 41, "speaker": 5, "form": "dlg", "jp": "が信号化されている感じです」"},
{"id": 42, "speaker": 46, "form": "dlg", "jp": "「"},
{"id": 43, "speaker": 46, "form": "dlg", "jp": "『アナログな命令』"},
{"id": 44, "speaker": 46, "form": "dlg", "jp": "？」"},
{"id": 45, "speaker": 5, "form": "dlg", "jp": "「たぶん、アナタたちの"},
{"id": 46, "speaker": 5, "form": "dlg", "jp": "『能力』に似たもの"},
{"id": 47, "speaker": 5, "form": "dlg", "jp": "なんだと‥‥」"},
{"id": 48, "speaker": 5, "form": "dlg", "jp": "「例えば、離れた場所の物を移動させるには\n　なんらかのコントロール信号が必要となるのですが」"},
{"id": 49, "speaker": 5, "form": "dlg", "jp": "「ケネスさんの場合は、\n　念じるというアナログな行為でそれを行っています」"},
{"id": 50, "speaker": 5, "form": "dlg", "jp": "「つまり、\n　それと同様のことを『ゲーマー』は行っている様です」"},
{"id": 51, "speaker": 46, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 52, "speaker": 5, "form": "dlg", "jp": "「また、この信号を調べていてわかったことが\n　その"},
{"id": 53, "speaker": 5, "form": "dlg", "jp": "『思考パターン』が人間と似ている"},
{"id": 54, "speaker": 5, "form": "dlg", "jp": "ということです」"},
{"id": 55, "speaker": 5, "form": "dlg", "jp": "「『ゲーマー』が人間をコントロールできないのは」"},
{"id": 56, "speaker": 5, "form": "dlg", "jp": "「そのコントロール信号のパターンが\n　人間の思考と似ているので相殺しあい」"},
{"id": 57, "speaker": 5, "form": "dlg", "jp": "「効力を発することができないからみたいです」"},
{"id": 58, "speaker": 46, "form": "dlg", "jp": "「つまり、『ゲーマー』は\n　『火山よ噴火しろ！』と念じることはできても‥‥」"},
{"id": 59, "speaker": 46, "form": "dlg", "jp": "「『アリスよ眠れ！』と念じることはできないのですね？」"},
{"id": 60, "speaker": 5, "form": "dlg", "jp": "「いいえ、念じることは可能なのでしょうが\n　念じられたアナタがそれに反応しないだけです」"},
{"id": 61, "speaker": 46, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "「で、ウイルスを送り込むことは可能なのかい？」"},
{"id": 63, "speaker": 5, "form": "dlg", "jp": "「問題はそこです‥‥」"},
{"id": 64, "speaker": 5, "form": "dlg", "jp": "「可能と言えば可能なんですが‥‥」"},
{"id": 65, "speaker": 46, "form": "dlg", "jp": "「何か問題でも？」"},
{"id": 66, "speaker": 5, "form": "dlg", "jp": "「理解していただきたいのが、この作戦が\n　いくつかの行程に分かれているということです」"},
{"id": 67, "speaker": 5, "form": "dlg", "jp": "「目的は『ウイルス』によって\n　『通信システム』を破壊させることです」"},
{"id": 68, "speaker": 5, "form": "dlg", "jp": "「つまり『ウイルス』には\n　『通信システム』を破壊できる能力が必要です」"},
{"id": 69, "speaker": 46, "form": "dlg", "jp": "「それは難しいのですか？」"},
{"id": 70, "speaker": 5, "form": "dlg", "jp": "「まあ、そうした『ウイルス』を作ること自体は\n　そう難しくはありません」"},
{"id": 71, "speaker": 46, "form": "dlg", "jp": "「そうでしょうね？」"},
{"id": 72, "speaker": 46, "form": "dlg", "jp": "「高度なシステムほど、少し書き換えるだけで\n　不都合が発生するでしょうから‥‥」"},
{"id": 73, "speaker": 5, "form": "dlg", "jp": "「ただ、難しいのがその手前の段階なんです！」"},
{"id": 74, "speaker": 46, "form": "dlg", "jp": "「手前とは？」"},
{"id": 75, "speaker": 5, "form": "dlg", "jp": "「『通信システム』まで\n　『ウイルス』が無事にたどり着くかどうかです‥‥」"},
{"id": 76, "speaker": 5, "form": "dlg", "jp": "「これは我々人間が使っている\n　ネットワーク環境でも同じですが」"},
{"id": 77, "speaker": 5, "form": "dlg", "jp": "「余程のことがないかぎり、『ウイルス』の侵入を\n　すんなりと受け入れることはないでしょう？」"},
{"id": 78, "speaker": 46, "form": "dlg", "jp": "「"},
{"id": 79, "speaker": 46, "form": "dlg", "jp": "『ウイルス駆除ソフト』"},
{"id": 80, "speaker": 46, "form": "dlg", "jp": "や"},
{"id": 81, "speaker": 46, "form": "dlg", "jp": "『ファイアウォール』"},
{"id": 82, "speaker": 46, "form": "dlg", "jp": "ですね？」"},
{"id": 83, "speaker": 5, "form": "dlg", "jp": "「そうです‥‥」"},
{"id": 84, "speaker": 35, "form": "dlg", "jp": "「ちょっとまってよ‥‥」"},
{"id": 85, "speaker": 35, "form": "dlg", "jp": "「ファイアなんとかって何？」"},
{"id": 86, "speaker": 31, "form": "dlg", "jp": "「『ファイアウォール』！！」"},
{"id": 87, "speaker": 31, "form": "dlg", "jp": "「コンピューターのシステムなんかを守る\n　壁みたいなものだよ！」"},
{"id": 88, "speaker": 31, "form": "dlg", "jp": "「ウイルスなんかをせきとめるんだ！！」"},
{"id": 89, "speaker": 35, "form": "dlg", "jp": "「ふ～ん‥‥」"},
{"id": 90, "speaker": 5, "form": "dlg", "jp": "「それに、\n　もし無事にそれらの網をくぐり抜けられたとしても‥‥」"},
{"id": 91, "speaker": 5, "form": "dlg", "jp": "「『ゲーマー』の能力‥‥」"},
{"id": 92, "speaker": 5, "form": "dlg", "jp": "「つまり、\n　"},
{"id": 93, "speaker": 5, "form": "dlg", "jp": "『人間以外のものをコントロールする力』"},
{"id": 94, "speaker": 5, "form": "dlg", "jp": "によって」"},
{"id": 95, "speaker": 5, "form": "dlg", "jp": "「『ウイルス』としての効果が\n　消失させられる可能性が‥‥」"},
{"id": 96, "speaker": 46, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 97, "speaker": 46, "form": "dlg", "jp": "「話はわかりました‥‥」"},
{"id": 98, "speaker": 46, "form": "dlg", "jp": "「それに関しては簡単な解決方法が‥‥」"},
{"id": 99, "speaker": 46, "form": "dlg", "jp": "「『ウイルス』を\n　人間の思考に限り無く近付けたものにすれば」"},
{"id": 100, "speaker": 46, "form": "dlg", "jp": "「『ゲーマー』にコントロールされることは\n　ないんですよね」"},
{"id": 101, "speaker": 46, "form": "dlg", "jp": "「たしかナゴムのお姉さまは、人間に限り無く近い\n　人工知能を作っていたのでは？」"},
{"id": 102, "speaker": 3, "form": "dlg", "jp": "「そうですけど‥‥」"},
{"id": 103, "speaker": 46, "form": "dlg", "jp": "「同じタイプのプログラムに\n　『ウイルス』としてのプログラムを追加してみては？」"},
{"id": 104, "speaker": 3, "form": "dlg", "jp": "「しかし、それ以前の問題が‥‥」"},
{"id": 105, "speaker": 46, "form": "dlg", "jp": "「それ以前の問題？」"},
{"id": 106, "speaker": 27, "form": "dlg", "jp": "「その件については以前説明させて頂いたと思いますが」"},
{"id": 107, "speaker": 27, "form": "dlg", "jp": "「この"},
{"id": 108, "speaker": 27, "form": "dlg", "jp": "『アカシックレコード』に接続するすべ"},
{"id": 109, "speaker": 27, "form": "dlg", "jp": "が\n　私たちにはまったくないんですよ！」"},
{"id": 110, "speaker": 27, "form": "dlg", "jp": "「まあ逆に言えば『接続』さえできれば\n　あとはどうにでもなるんですけど」"},
{"id": 111, "speaker": 46, "form": "dlg", "jp": "「どういうことですか？」"},
{"id": 112, "speaker": 27, "form": "dlg", "jp": "「私の以前の助手の『清田くん』の発明した\n　脳に信号を直接送る機械があります」"},
{"id": 113, "speaker": 27, "form": "dlg", "jp": "「それを逆流させれば『意識』を\n　信号化して送りだすことは可能なんですよ」"},
{"id": 114, "speaker": 27, "form": "dlg", "jp": "「ただ、その機械をどうやっても\n　『アカシックレコード』につなげられないんです」"},
{"id": 115, "speaker": 46, "form": "dlg", "jp": "「つまり、その機械を\n　アカシックレコードに接続することができれば」"},
{"id": 116, "speaker": 46, "form": "dlg", "jp": "「ウイルスなどを用意しなくても」"},
{"id": 117, "speaker": 46, "form": "dlg", "jp": "「直接人間の意識を\n　アカシックレコードに送り込めるってことですね」"},
{"id": 118, "speaker": 27, "form": "dlg", "jp": "「ですから、接続するすべがないんですよ」"},
{"id": 119, "speaker": 46, "form": "dlg", "jp": "「つまり‥‥」"},
{"id": 120, "speaker": 46, "form": "dlg", "jp": "「ゲーマーの『通信システムを破壊する』という作戦は\n　現時点では不可能ということですね‥‥」"},
{"id": 121, "speaker": 13, "form": "dlg", "jp": "「カーーッ！」"},
{"id": 122, "speaker": 13, "form": "dlg", "jp": "「いい作戦だと思ったんだけどな‥‥」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「オマエまだいたのか？」"},
{"id": 124, "speaker": 13, "form": "dlg", "jp": "「残ってくれと頼まれたんだよ！」"},
{"id": 125, "speaker": 46, "form": "dlg", "jp": "「彼には『参謀』として、\n　ここに残ってもらうことにしました」"},
{"id": 126, "speaker": 13, "form": "dlg", "jp": "「とにかく、オレの作戦は間違ってないと思うぜ！」"},
{"id": 127, "speaker": 13, "form": "dlg", "jp": "「なんとかして、そのアカシックレコードに\n　接続する方法を見つけだすことだな！」"},
{"id": 128, "speaker": 27, "form": "dlg", "jp": "「まあ、もう少し研究してみますが‥‥」"},
{"id": 129, "speaker": 46, "form": "dlg", "jp": "「お願いします」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「それより、ゲーマーの攻撃は今どうなってるの？」"},
{"id": 131, "speaker": 46, "form": "dlg", "jp": "「兵器については主要国すべてのトップに\n　"},
{"id": 132, "speaker": 46, "form": "dlg", "jp": "『燃料』を抜く"},
{"id": 133, "speaker": 46, "form": "dlg", "jp": "ように暗示をかけてきました」"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "「そうか、『燃料』がなければ\n　勝手に動いちゃうことはないんだね！」"},
{"id": 135, "speaker": 46, "form": "dlg", "jp": "「ただ、私にできたのは表立った『兵器』だけですから‥‥」"},
{"id": 136, "speaker": 46, "form": "dlg", "jp": "「『裏組織』たちの兵器までは‥‥」"},
{"id": 137, "speaker": 46, "form": "dlg", "jp": "「まあ、さいわい最大の『裏組織』はすでに\n　『ナゴム』たちが壊滅してくれてますから」"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "「別にボクが壊滅させたわけじゃないけど‥‥」"},
{"id": 139, "speaker": 46, "form": "dlg", "jp": "「とにかく、すべての兵器が停止できたわけではありません」"},
{"id": 140, "speaker": 46, "form": "dlg", "jp": "「さらに、現代社会では『兵器』でなくても\n　危険なものが多いので‥‥」"},
{"id": 141, "speaker": 46, "form": "dlg", "jp": "「飛行機や原発、自動車だって\n　十分人殺しの道具にはなりますから‥‥」"},
{"id": 142, "speaker": 46, "form": "dlg", "jp": "「とりあえず、世界のトップやマスコミには‥‥」"},
{"id": 143, "speaker": 46, "form": "dlg", "jp": "「"},
{"id": 144, "speaker": 46, "form": "dlg", "jp": "『宇宙からの電波で機械が誤作動する』"},
{"id": 145, "speaker": 46, "form": "dlg", "jp": "と\n　思い込ませています」"},
{"id": 146, "speaker": 46, "form": "dlg", "jp": "「ニュースではすでに旅客機の運行は\n　当分の間、行われないようです」"},
{"id": 147, "speaker": 13, "form": "dlg", "jp": "「なんだか、昔あった『２０００年問題』みたいだな‥‥」"},
{"id": 148, "speaker": 46, "form": "dlg", "jp": "「あと一番心配なのが"},
{"id": 149, "speaker": 46, "form": "dlg", "jp": "『人間の暴走』"},
{"id": 150, "speaker": 46, "form": "dlg", "jp": "です‥‥」"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「それは大丈夫だろう？」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「ゲーマーは\n　『人間をコントロール』できないんだから‥‥」"},
{"id": 153, "speaker": 46, "form": "dlg", "jp": "「いいえ、私が心配しているのは\n　『人間』が本当に『暴走』することです‥‥」"},
{"id": 154, "speaker": 46, "form": "dlg", "jp": "「アナタはちゃんと新聞を読んでいますか？」"},
{"id": 155, "speaker": 46, "form": "dlg", "jp": "「今の世界というのは多くの貧しい国と\n　わずかな豊かな国で構成されています」"},
{"id": 156, "speaker": 46, "form": "dlg", "jp": "「そして、そのわずかな豊かな国が\n　多くの貧しい国の上に立っているのですよ」"},
{"id": 157, "speaker": 46, "form": "dlg", "jp": "「多くの貧しい国は豊かな国に不満を持っているのです」"},
{"id": 158, "speaker": 46, "form": "dlg", "jp": "「豊かな国は『力』を持っているから\n　それらの貧しい国をおさえつけていられるのですよ！」"},
{"id": 159, "speaker": 46, "form": "dlg", "jp": "「おさえつけられている貧しい国の人たちが\n　暴動を起こしたりするんじゃないかと‥‥」"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "「それは大丈夫なんじゃないかな？」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「『ゲーマー』のことは知らないにしても」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「世界が大変な時期だっていうのは\n　みんな知っているんだろう？」"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「そんな時におかしなことをするような\n　不謹慎な人間なんていないよ！」"},
{"id": 164, "speaker": 13, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 165, "speaker": 13, "form": "dlg", "jp": "「『２０００年問題』の時も、便乗して\n　おかしなことをする連中もほとんどいなかったもんな！」"},
{"id": 166, "speaker": 46, "form": "dlg", "jp": "「私もそう思いたいのです‥‥」"},
{"id": 167, "speaker": 46, "form": "dlg", "jp": "「いざとなれば、\n　人類すべてに『催眠術』をかけることも可能ですが」"},
{"id": 168, "speaker": 46, "form": "dlg", "jp": "「そんなことをしたくはないのです」"},
{"id": 169, "speaker": 46, "form": "dlg", "jp": "「逆にこんな時に自分勝手な行動をとる生き物ならば\n　『人間』なんてほろびてしまってもいいと‥‥」"},
{"id": 170, "speaker": 13, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "「まあ、『機械の誤作動』の問題はそれでいいとして‥‥」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「『天変地異』の方は？」"},
{"id": 173, "speaker": 46, "form": "dlg", "jp": "「それは私ではわかりません‥‥」"},
{"id": 174, "speaker": 13, "form": "dlg", "jp": "「確か『ゲージ』の増え具合は\n　『ジーン』がわかるんじゃあ？」"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って‥‥」"},
{"id": 176, "speaker": 29, "form": "dlg", "jp": "「『アカシックレコード』をのぞいてみるわ‥‥」"},
{"id": 177, "speaker": 29, "form": "dlg", "jp": "ジーンは『アカシックレコード』に手をかざし"},
{"id": 178, "speaker": 29, "form": "dlg", "jp": "情報を読み取り始めた。"},
{"id": 179, "speaker": 29, "form": "dlg", "jp": "そして‥‥"},
{"id": 180, "speaker": 29, "form": "dlg", "jp": "「具体的には説明できないけど‥‥」"},
{"id": 181, "speaker": 29, "form": "dlg", "jp": "「イメージとしては"},
{"id": 182, "speaker": 29, "form": "dlg", "jp": "コップから水があふれそう"},
{"id": 183, "speaker": 29, "form": "dlg", "jp": "な感じ‥‥」"},
{"id": 184, "speaker": 13, "form": "dlg", "jp": "「オイオイ！」"},
{"id": 185, "speaker": 13, "form": "dlg", "jp": "「それって、"},
{"id": 186, "speaker": 13, "form": "dlg", "jp": "『ゲージ満タン』"},
{"id": 187, "speaker": 13, "form": "dlg", "jp": "ってことじゃないか！」"},
{"id": 188, "speaker": 29, "form": "dlg", "jp": "「それってマズイの？」"},
{"id": 189, "speaker": 13, "form": "dlg", "jp": "「まあ、向こうの仕組みが見えないから断言はできないけど」"},
{"id": 190, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 191, "speaker": 13, "form": "dlg", "jp": "『ゲージ満タン』"},
{"id": 192, "speaker": 13, "form": "dlg", "jp": "ってことは、\n　"},
{"id": 193, "speaker": 13, "form": "dlg", "jp": "十分『力を貯えた』"},
{"id": 194, "speaker": 13, "form": "dlg", "jp": "ってことだぞ！」"},
{"id": 195, "speaker": 29, "form": "dlg", "jp": "「じゃあ、いつでも『天変地異』を実行できるってこと？」"},
{"id": 196, "speaker": 29, "form": "dlg", "jp": "「でも、なんですぐに使わないの？」"},
{"id": 197, "speaker": 46, "form": "dlg", "jp": "「機を待っているのでしょう‥‥」"},
{"id": 198, "speaker": 46, "form": "dlg", "jp": "「それとも、楽しみを最後にキープしているとか‥‥」"},
{"id": 199, "speaker": 13, "form": "dlg", "jp": "「まあ、切り札はすぐには使わないものだな‥‥」"},
{"id": 200, "speaker": 13, "form": "dlg", "jp": "「『インロウ』は最後の最後に出すもんだよ！」"},
{"id": 201, "speaker": 13, "form": "dlg", "jp": "「なっ！」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「ボクに同意を求めるなよ！」"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "「どっちにしろ、『ゲーマー』はいつでも\n　『天変地異』を起すことができると‥‥」"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "「早く手を打たないと！」"},
{"id": 205, "speaker": 46, "form": "dlg", "jp": "「とにかく、皆さんは"},
{"id": 206, "speaker": 46, "form": "dlg", "jp": "『ウイルス』の開発"},
{"id": 207, "speaker": 46, "form": "dlg", "jp": "と\n　"},
{"id": 208, "speaker": 46, "form": "dlg", "jp": "『接続方法』の解明"},
{"id": 209, "speaker": 46, "form": "dlg", "jp": "をお願いします」"},
{"id": 210, "speaker": 46, "form": "dlg", "jp": "ボクたち超能力者は『メインホール』に移動した。"},
{"id": 211, "speaker": 15, "form": "dlg", "jp": "「やっぱり、\n　私たちの力ではどうすることもできないのかしら？」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "「さあ、それはなんとも‥‥」"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "「それより、本当にアイコは『夢』を見ていないの？」"},
{"id": 214, "speaker": 15, "form": "dlg", "jp": "「えっ‥‥‥」"},
{"id": 215, "speaker": 15, "form": "dlg", "jp": "「ええ‥‥‥」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「本当？」"},
{"id": 217, "speaker": 15, "form": "dlg", "jp": "「私、能力がなくなっちゃったのかも‥‥」"},
{"id": 218, "speaker": 16, "form": "dlg", "jp": "「やっぱり、\n　アキラたちの力ではどうすることもできないのかしら？」"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "「さあ、それはなんとも‥‥」"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「それより、本当に長尾は『夢』を見ていないの？」"},
{"id": 221, "speaker": 16, "form": "dlg", "jp": "「えっ‥‥‥」"},
{"id": 222, "speaker": 16, "form": "dlg", "jp": "「ううん‥‥‥」"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "「本当？」"},
{"id": 224, "speaker": 16, "form": "dlg", "jp": "「アキラ、能力がなくなっちゃったのかも‥‥」"},
{"id": 225, "speaker": 18, "form": "dlg", "jp": "「やっぱり、\n　私たちの力ではどうすることもできないのかしら？」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「さあ、それはなんとも‥‥」"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「それより、本当に堤さんは『夢』を見ていないの？」"},
{"id": 228, "speaker": 18, "form": "dlg", "jp": "「えっ‥‥‥」"},
{"id": 229, "speaker": 18, "form": "dlg", "jp": "「ええ‥‥‥」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「本当？」"},
{"id": 231, "speaker": 18, "form": "dlg", "jp": "「私、能力がなくなっちゃったのかも‥‥」"},
{"id": 232, "speaker": 31, "form": "dlg", "jp": "「なあ、『ゲーマー』を倒したり、\n　『天変地異』を止めようってするんじゃなくて」"},
{"id": 233, "speaker": 31, "form": "dlg", "jp": "「『天変地異』から逃れる作戦に切り替える\n　っていうのはどうだ？」"},
{"id": 234, "speaker": 31, "form": "dlg", "jp": "「たぶんこのままではそっちの方が現実的じゃないのか？」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「たしかにそうかも‥‥」"},
{"id": 236, "speaker": 46, "form": "dlg", "jp": "「いえ、それはそれで難しいですね‥‥」"},
{"id": 237, "speaker": 31, "form": "dlg", "jp": "「どうして‥‥？」"},
{"id": 238, "speaker": 46, "form": "dlg", "jp": "「今の地球は\n　それでなくても『人間』があふれるような状態です！」"},
{"id": 239, "speaker": 46, "form": "dlg", "jp": "「世界規模の『天変地異』が起きたとして\n　それだけの人間を避難させられる場所なんて‥‥」"},
{"id": 240, "speaker": 15, "form": "dlg", "jp": "「じゃあ私たちはどうすればいいんですか！！」"},
{"id": 241, "speaker": 46, "form": "dlg", "jp": "「その答えはアナタ自身が\n　知っているのではありませんか？」"},
{"id": 242, "speaker": 15, "form": "dlg", "jp": "「へっ！？」"},
{"id": 243, "speaker": 15, "form": "dlg", "jp": "「私は何も‥‥」"},
{"id": 244, "speaker": 16, "form": "dlg", "jp": "「じゃあアキラたちはどうすればいいんですか！！」"},
{"id": 245, "speaker": 46, "form": "dlg", "jp": "「その答えはアナタ自身が\n　知っているのではありませんか？」"},
{"id": 246, "speaker": 16, "form": "dlg", "jp": "「へっ！？」"},
{"id": 247, "speaker": 16, "form": "dlg", "jp": "「アキラは何も‥‥」"},
{"id": 248, "speaker": 18, "form": "dlg", "jp": "「私たちはどうすれば‥‥」"},
{"id": 249, "speaker": 46, "form": "dlg", "jp": "「その答えはアナタ自身が\n　知っているのではありませんか？」"},
{"id": 250, "speaker": 18, "form": "dlg", "jp": "「えっ！？」"},
{"id": 251, "speaker": 18, "form": "dlg", "jp": "「私は何も‥‥」"},
{"id": 252, "speaker": 46, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 253, "speaker": 46, "form": "dlg", "jp": "「アナタがわからないのなら、私たちも‥‥」"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "「まあ、彼女の場合は夢を見ないかぎり\n　どうしようもないですから‥‥」"},
{"id": 255, "speaker": 29, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 256, "speaker": 45, "form": "dlg", "jp": "「『リーダー』！！」"},
{"id": 257, "speaker": 46, "form": "dlg", "jp": "「どうしました？」"},
{"id": 258, "speaker": 45, "form": "dlg", "jp": "「『ロシア』から、"},
{"id": 259, "speaker": 45, "form": "dlg", "jp": "『核』を搭載した『ミサイル』"},
{"id": 260, "speaker": 45, "form": "dlg", "jp": "が！！」"},
{"id": 261, "speaker": 46, "form": "dlg", "jp": "「本当ですか！？」"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "「燃料を抜かせたんじゃあ？」"},
{"id": 263, "speaker": 45, "form": "dlg", "jp": "「正規の軍のものじゃなくって\n　『旧ソ連』の盗難されたものらしい！」"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "「そんな大きなものが『盗難』されるって‥‥」"},
{"id": 265, "speaker": 31, "form": "dlg", "jp": "「崩壊間際のドサクサで\n　いろんなものが流失した時期があったからな‥‥」"},
{"id": 266, "speaker": 31, "form": "dlg", "jp": "「で、予想着弾地点は？」"},
{"id": 267, "speaker": 46, "form": "dlg", "jp": "「"},
{"id": 268, "speaker": 46, "form": "dlg", "jp": "ここ"},
{"id": 269, "speaker": 46, "form": "dlg", "jp": "なんですね？」"},
{"id": 270, "speaker": 45, "form": "dlg", "jp": "「その通りです‥‥」"},
{"id": 271, "speaker": 46, "form": "dlg", "jp": "「当然ですね‥‥」"},
{"id": 272, "speaker": 46, "form": "dlg", "jp": "「『ゲーマー』も\n　こちらのことは気付いているでしょうから‥‥」"},
{"id": 273, "speaker": 45, "form": "dlg", "jp": "「"},
{"id": 274, "speaker": 45, "form": "dlg", "jp": "約１２分後"},
{"id": 275, "speaker": 45, "form": "dlg", "jp": "に着弾します」"},
{"id": 276, "speaker": 45, "form": "dlg", "jp": "「早く止めないと！」"},
{"id": 277, "speaker": 46, "form": "dlg", "jp": "「あわてることはありません‥‥」"},
{"id": 278, "speaker": 46, "form": "dlg", "jp": "「たかが『核ミサイル』です」"},
{"id": 279, "speaker": 46, "form": "dlg", "jp": "「そんなものは上空で弾頭を外してしまえばいいだけです」"},
{"id": 280, "speaker": 13, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 281, "speaker": 13, "form": "dlg", "jp": "「それよりもワザワザここを狙ってきていることの方が‥‥」"},
{"id": 282, "speaker": 13, "form": "dlg", "jp": "「ここを狙って攻撃してくるってことは\n　オレたちは『ゲーマー』にとって」"},
{"id": 283, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 284, "speaker": 13, "form": "dlg", "jp": "『攻撃に値する存在』"},
{"id": 285, "speaker": 13, "form": "dlg", "jp": "なんじゃないか？」"},
{"id": 286, "speaker": 46, "form": "dlg", "jp": "「そうなりますね」"},
{"id": 287, "speaker": 13, "form": "dlg", "jp": "「それってやっぱりオレたちが『ゲーマー』を\n　"},
{"id": 288, "speaker": 13, "form": "dlg", "jp": "『ゲームオーバー』にできる"},
{"id": 289, "speaker": 13, "form": "dlg", "jp": "ってことじゃないのか？」"},
{"id": 290, "speaker": 46, "form": "dlg", "jp": "「私もそう思います‥‥」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「そんなことより、早く『ミサイル』を止めないと！」"},
{"id": 292, "speaker": 46, "form": "dlg", "jp": "「それはアナタたちのチームだけで十分でしょう」"},
{"id": 293, "speaker": 46, "form": "dlg", "jp": "「よろしくたのみます」"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "「はあ？」"},
{"id": 295, "speaker": 29, "form": "dlg", "jp": "「行くわよ！」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「ちょっとまって‥‥」"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "「シュン！」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "ボクたちは"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "『核ミサイル』"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "を停止するために\n出撃することになった。"}
]
