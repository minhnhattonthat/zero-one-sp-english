[
{"id": 0, "speaker": 11, "form": "dlg", "jp": "「ウン？」"},
{"id": 1, "speaker": 11, "form": "dlg", "jp": "「どうかしたのか、息を切らせて‥‥」"},
{"id": 2, "speaker": 2, "form": "dlg", "jp": "「ヤツらが‥‥」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「ヤツラが現れました‥‥」"},
{"id": 4, "speaker": 11, "form": "dlg", "jp": "「なんだって！！」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "「今も追われてここまで‥‥」"},
{"id": 6, "speaker": 11, "form": "dlg", "jp": "「で、ウチの連中は‥‥」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「殺されました‥‥」"},
{"id": 8, "speaker": 11, "form": "dlg", "jp": "「なにぃ～～！！」"},
{"id": 9, "speaker": 21, "form": "dlg", "jp": "「アキヤマ、館内を封鎖して！！」"},
{"id": 10, "speaker": 22, "form": "dlg", "jp": "「了解しました！」"},
{"id": 11, "speaker": 21, "form": "dlg", "jp": "「ミスターオオツキ、\n　ホテルの利用客に部屋から出るなと‥‥」"},
{"id": 12, "speaker": 11, "form": "dlg", "jp": "「はっ！」"},
{"id": 13, "speaker": 11, "form": "dlg", "jp": "このホテルの中に殺人犯がいるということで、\nただちに建物全体が封鎖され、"},
{"id": 14, "speaker": 11, "form": "dlg", "jp": "ホテルは厳戒体制の中に置かれた。"},
{"id": 15, "speaker": 11, "form": "dlg", "jp": "ボクは部屋に戻り厳重なガードの中で\n事件の説明をすることになった。"},
{"id": 16, "speaker": 20, "form": "dlg", "jp": "「警部、お姉さんの方と連絡が取れました！」"},
{"id": 17, "speaker": 20, "form": "dlg", "jp": "「あちらの方はこれといって異常は無いようです」"},
{"id": 18, "speaker": 11, "form": "dlg", "jp": "「うむ、そうか‥‥」"},
{"id": 19, "speaker": 11, "form": "dlg", "jp": "「敵はわざわざ\n　警備の厚いコチラを狙ってきたということか‥‥」"},
{"id": 20, "speaker": 11, "form": "dlg", "jp": "「なめられたもんだな‥‥」"},
{"id": 21, "speaker": 21, "form": "dlg", "jp": "「当然のことね‥‥」"},
{"id": 22, "speaker": 11, "form": "dlg", "jp": "「はあ？」"},
{"id": 23, "speaker": 21, "form": "dlg", "jp": "「ドクタージョウコウジを精神的に追い込むには\n　より警備の厚い方を襲った方が効果あるでしょう」"},
{"id": 24, "speaker": 11, "form": "dlg", "jp": "「しかし、\n　これだけの警備の中わざわざ襲ってくるなんて‥‥」"},
{"id": 25, "speaker": 21, "form": "dlg", "jp": "「だから、日本は『平和ボケ』っていわれるのよ」"},
{"id": 26, "speaker": 21, "form": "dlg", "jp": "「相手は小さな国の軍隊ぐらいの力を持った組織‥‥」"},
{"id": 27, "speaker": 21, "form": "dlg", "jp": "「日本の警察なんて‥‥」"},
{"id": 28, "speaker": 11, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 29, "speaker": 11, "form": "dlg", "jp": "「それよりナゴム君‥‥」"},
{"id": 30, "speaker": 11, "form": "dlg", "jp": "「君を襲ったヤツってのは、\n　刀をふりまわしていたっていうが‥‥」"},
{"id": 31, "speaker": 11, "form": "dlg", "jp": "「コイツらの遺体を見る限り、\n　とても刀で斬られたようには‥‥」"},
{"id": 32, "speaker": 21, "form": "dlg", "jp": "「"},
{"id": 33, "speaker": 21, "form": "dlg", "jp": "『レイガン』"},
{"id": 34, "speaker": 21, "form": "dlg", "jp": "ね‥‥」"},
{"id": 35, "speaker": 11, "form": "dlg", "jp": "「『レイガン』？？」"},
{"id": 36, "speaker": 21, "form": "dlg", "jp": "「光線銃よ‥‥」"},
{"id": 37, "speaker": 21, "form": "dlg", "jp": "「『レイガン』で暗殺されたとなると‥‥」"},
{"id": 38, "speaker": 22, "form": "dlg", "jp": "「もしかして‥‥」"},
{"id": 39, "speaker": 21, "form": "dlg", "jp": "「『連続要人密室暗殺事件』と同一犯かも‥‥」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「レンゾクヨウジンミッシツアンサツジケン？」"},
{"id": 41, "speaker": 21, "form": "dlg", "jp": "「現在、インターポールが抱えている\n　もうひとつの大きな事件よ」"},
{"id": 42, "speaker": 21, "form": "dlg", "jp": "「世界の要人たちが、厳重に警備されている密室で\n　たて続けに暗殺されている事件よ‥‥」"},
{"id": 43, "speaker": 22, "form": "dlg", "jp": "「犯人はつかまるどころか、手がかりすら‥‥」"},
{"id": 44, "speaker": 22, "form": "dlg", "jp": "「唯一の手がかりがすべての犯行に\n　『レイガン』が使われているってことぐらいで‥‥」"},
{"id": 45, "speaker": 11, "form": "dlg", "jp": "「確かに光線銃なら銃声もひびかないし、\n　暗殺にはもってこいかも‥‥」"},
{"id": 46, "speaker": 11, "form": "dlg", "jp": "「ナゴム君、君は銃声は聞いたのか？」"},
{"id": 47, "speaker": 11, "form": "choice", "jp": "「はい、聞きました！」"},
{"id": 48, "speaker": 11, "form": "choice", "jp": "「はい、聞きませんでした！」"},
{"id": 49, "speaker": 11, "form": "choice", "jp": "「いいえ、聞きませんでした！」"},
{"id": 50, "speaker": 11, "form": "dlg", "jp": "「憶えていないんだね‥‥」"},
{"id": 51, "speaker": 11, "form": "dlg", "jp": "「まあ、仕方ないな‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「はい、聞きました！」"},
{"id": 53, "speaker": 21, "form": "dlg", "jp": "「そんなハズはないわ‥‥」"},
{"id": 54, "speaker": 21, "form": "dlg", "jp": "「彼らは明らかに『レイガン』で撃たれているし」"},
{"id": 55, "speaker": 21, "form": "dlg", "jp": "「この部屋から硝煙反応も出ていない‥‥」"},
{"id": 56, "speaker": 21, "form": "dlg", "jp": "「今までの彼の証言も疑った方がいいかもしれないわ‥‥」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "（そんな‥‥）"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「はい、聞きませんでした！」"},
{"id": 59, "speaker": 21, "form": "dlg", "jp": "「そうでしょうね‥‥」"},
{"id": 60, "speaker": 21, "form": "dlg", "jp": "「この人たちは明らかに『レイガン』で撃たれているし」"},
{"id": 61, "speaker": 21, "form": "dlg", "jp": "「この部屋から硝煙反応も出ていない‥‥」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "「いいえ、聞きませんでした！」"},
{"id": 63, "speaker": 21, "form": "dlg", "jp": "「そうでしょうね‥‥」"},
{"id": 64, "speaker": 21, "form": "dlg", "jp": "「この人たちは明らかに『レイガン』で撃たれているし」"},
{"id": 65, "speaker": 21, "form": "dlg", "jp": "「この部屋から硝煙反応も出ていない‥‥」"},
{"id": 66, "speaker": 20, "form": "dlg", "jp": "「警部っ！」"},
{"id": 67, "speaker": 20, "form": "dlg", "jp": "「まだ断定はできませんが‥‥」"},
{"id": 68, "speaker": 20, "form": "dlg", "jp": "「遺体を見る限り\n　光線銃はこの部屋の中から発射されているようです！」"},
{"id": 69, "speaker": 11, "form": "dlg", "jp": "「それに加えて、ここは密室だった‥‥」"},
{"id": 70, "speaker": 11, "form": "dlg", "jp": "「ナゴム君、本当にここには誰もいなかったんだね‥‥」"},
{"id": 71, "speaker": 11, "form": "choice", "jp": "「はい！」"},
{"id": 72, "speaker": 11, "form": "choice", "jp": "「いいえ‥‥」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「はい！」"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "「誰もいませんでした」"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "「いいえ‥‥」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「ボクたち以外は誰も‥‥」"},
{"id": 77, "speaker": 11, "form": "dlg", "jp": "「フロントでドアの開閉についても\n　コンピュータで管理しているんだが‥‥」"},
{"id": 78, "speaker": 11, "form": "dlg", "jp": "「おかしな時間にドアが開いた記録もない‥‥」"},
{"id": 79, "speaker": 22, "form": "dlg", "jp": "「で、窓も開いていない‥‥」"},
{"id": 80, "speaker": 21, "form": "dlg", "jp": "「間違いないわね、『連続要人密室暗殺事件』と\n　同一犯人のようね‥‥」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「じゃ、あの刀をふりまわしていたヤツは‥‥」"},
{"id": 82, "speaker": 2, "form": "choice", "jp": "「『連続要人密室暗殺事件』の犯人！？」"},
{"id": 83, "speaker": 2, "form": "choice", "jp": "「いったい、誰なんですか？」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「『連続要人密室暗殺事件』の犯人！？」"},
{"id": 85, "speaker": 21, "form": "dlg", "jp": "「それは違うわね‥‥」"},
{"id": 86, "speaker": 21, "form": "dlg", "jp": "「君の話からすると、そいつは間違いなく\n　『カマキリジャック』‥‥」"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "「『カマキリジャック』！？」"},
{"id": 88, "speaker": 21, "form": "dlg", "jp": "「『ルード』のサイコな殺し屋‥‥」"},
{"id": 89, "speaker": 21, "form": "dlg", "jp": "「刀で人を斬り付けるのが趣味の『変質者』よ！」"},
{"id": 90, "speaker": 21, "form": "dlg", "jp": "「ウワサでは\n　最近サイボーグ手術を受けたって聞いてたけど‥‥」"},
{"id": 91, "speaker": 21, "form": "dlg", "jp": "「わざわざレイガンで狙撃なんて考えられない！」"},
{"id": 92, "speaker": 21, "form": "dlg", "jp": "「アイツは、切り裂くことに快楽を感じる\n　サイコ野郎よ！」"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "「じゃあ、最低でも２人の刺客がこのホテルに‥‥」"},
{"id": 94, "speaker": 21, "form": "dlg", "jp": "「そういうことになるわね‥‥」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「いったい、誰なんですか？」"},
{"id": 96, "speaker": 21, "form": "dlg", "jp": "「君の話からすると、そいつは間違いなく\n　『カマキリジャック』‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「『カマキリジャック』！？」"},
{"id": 98, "speaker": 21, "form": "dlg", "jp": "「『ルード』のサイコな殺し屋‥‥」"},
{"id": 99, "speaker": 21, "form": "dlg", "jp": "「刀で人を斬り付けるのが趣味の『変質者』よ！」"},
{"id": 100, "speaker": 21, "form": "dlg", "jp": "「ウワサでは\n　最近サイボーグ手術を受けたって聞いてたけど‥‥」"},
{"id": 101, "speaker": 21, "form": "dlg", "jp": "「こんな子供相手の殺人を引き受けるとは‥‥」"},
{"id": 102, "speaker": 11, "form": "dlg", "jp": "「そいつが『連続要人密室ナントカ』の‥‥」"},
{"id": 103, "speaker": 21, "form": "dlg", "jp": "「違うわね！」"},
{"id": 104, "speaker": 21, "form": "dlg", "jp": "「アイツが\n　わざわざレイガンで狙撃なんて考えられない！」"},
{"id": 105, "speaker": 21, "form": "dlg", "jp": "「アイツは、切り裂くことに快楽を感じる\n　サイコ野郎よ！」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「じゃあ、最低でも２人の刺客がこのホテルに‥‥」"},
{"id": 107, "speaker": 21, "form": "dlg", "jp": "「そういうことになるわね‥‥」"},
{"id": 108, "speaker": 11, "form": "dlg", "jp": "「とりあえず、こんな事件のあった部屋に\n　泊まってもらうわけにはいかないんで」"},
{"id": 109, "speaker": 11, "form": "dlg", "jp": "「別の部屋を用意しよう！」"},
{"id": 110, "speaker": 11, "form": "dlg", "jp": "「それから、リツコさんにも安全のため\n　すぐに帰ってきてもらうことにする」"},
{"id": 111, "speaker": 11, "form": "dlg", "jp": "「オマエたちは、全室くまなくチェックして、\n　『カマキリ』を捜し出すんだ！！」"},
{"id": 112, "speaker": 20, "form": "dlg", "jp": "「はいっ！」"},
{"id": 113, "speaker": 20, "form": "dlg", "jp": "こうして、\nボクたちは別の部屋に移されることになった。"}
]
