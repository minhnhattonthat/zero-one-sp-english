{"id": 180, "speaker": 2, "form": "dlg", "jp": "「だからやけになって‥‥」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「サラリーマンが自分の会社の悪事を\n　インターネットで暴露するみたいな‥‥」"},
{"id": 182, "speaker": 3, "form": "dlg", "jp": "「そんな感じじゃなかったわよあの人‥‥」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「『裏切りモノ』とか‥‥」"},
{"id": 184, "speaker": 3, "form": "dlg", "jp": "「『裏切りモノ』って‥‥」"},
{"id": 185, "speaker": 3, "form": "dlg", "jp": "「ただ、裏切るだけで\n　どうして私たちを助けたりするの？」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「例えば、一度は悪の道に進んだけど、\n　人の世の愛や夢にふれて」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「『この美しいものを守りたい！』って\n　思うようになったとか‥‥」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「体は改造されちゃったケド、\n　脳を改造される前に脱走してきたとか‥‥」"},
{"id": 190, "speaker": 3, "form": "dlg", "jp": "「う～ん」"},
{"id": 191, "speaker": 3, "form": "dlg", "jp": "「それじゃあ、あまりにマンガチック過ぎない？」"},
{"id": 192, "speaker": 2, "form": "dlg", "jp": "「じゃあ、姉さんはどう思うの？」"},
{"id": 193, "speaker": 3, "form": "dlg", "jp": "「私は‥‥」"},
{"id": 194, "speaker": 3, "form": "dlg", "jp": "「私はサイボーグを倒した『あの人』と、\n　『通報してくれた人』が同じ人だと‥‥」"},
{"id": 195, "speaker": 2, "form": "dlg", "jp": "「じゃあ、あの人はどうして\n　ボクたちを助けてくれたの？」"},
{"id": 196, "speaker": 3, "form": "dlg", "jp": "「『あの人』はたぶん‥‥」"},
{"id": 197, "speaker": 3, "form": "dlg", "jp": "「私たちの知っている人じゃあ‥‥」"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "（ボクたちの知っている人？）"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "（まさかっ！）"},
{"id": 200, "speaker": 2, "form": "choice", "jp": "（『父さん』！？）"},
{"id": 201, "speaker": 2, "form": "choice", "jp": "（『シロー』！？）"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "（『シロー』！？）"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "（たしかに最初に襲われた時は\n　『シロー』は一緒にいたけど‥‥）"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "（姉さんは『人』っていったよなぁ‥‥）"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "（『父さん』！？）"},
{"id": 206, "speaker": 2, "form": "dlg", "jp": "（まさか、\n　姉さんは父さんが改造して若返ったと‥‥）"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「姉さんはいったい誰だと思っているの？」"},
{"id": 208, "speaker": 3, "form": "dlg", "jp": "「となりに警察の人たちがいるから\n　大きな声では言えないけど‥‥」"},
{"id": 209, "speaker": 3, "form": "dlg", "jp": "「もしかしたら、"},
{"id": 210, "speaker": 3, "form": "dlg", "jp": "『シロー』"},
{"id": 211, "speaker": 3, "form": "dlg", "jp": "じゃないかと‥‥」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "「シローってただのソフトじゃないか！」"},
{"id": 213, "speaker": 3, "form": "dlg", "jp": "「ソフトだけど、ただのソフトじゃないわ」"},
{"id": 214, "speaker": 3, "form": "dlg", "jp": "「ちゃんとした人格を持っているのよ‥‥」"},
{"id": 215, "speaker": 3, "form": "dlg", "jp": "「肉体さえあれば‥‥」"},
{"id": 216, "speaker": 3, "form": "dlg", "jp": "「それにシローがハードディスクから消えてから\n　『あの人』が現れたし‥‥」"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "「う～ん‥‥」"},
{"id": 218, "speaker": 3, "form": "dlg", "jp": "「あ、もうこんな時間！！」"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 220, "speaker": 3, "form": "dlg", "jp": "「大学へ行かなくっちゃ‥‥」"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "「危ないよ」"},
{"id": 222, "speaker": 3, "form": "dlg", "jp": "「もうすぐ学会だし‥‥」"},
{"id": 223, "speaker": 3, "form": "dlg", "jp": "「大丈夫、\n　警部さんにいってガードをつけてもらうから」"},
{"id": 224, "speaker": 3, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 225, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 226, "speaker": 3, "form": "dlg", "jp": "そう言って姉さんは出ていってしまった。"}
]
