[
{"id": 0, "speaker": 3, "form": "dlg", "jp": "「ねえ、足は大丈夫なの？」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 2, "speaker": 3, "form": "dlg", "jp": "「あんまりムチャしないでね」"},
{"id": 3, "speaker": 3, "form": "dlg", "jp": "「そんな足じゃ\n　いざという時に逃げられないわよ！」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「そうだね、気をつけるよ！」"},
{"id": 5, "speaker": 3, "form": "dlg", "jp": "「なんか、だんだんおおげさなことになってゆくわね」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「恐いの？」"},
{"id": 7, "speaker": 3, "form": "dlg", "jp": "「あたりまえじゃない！」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「でも、こんだけガードされていたら‥‥」"},
{"id": 9, "speaker": 3, "form": "dlg", "jp": "「昨日は警察がいたのに襲ってきたのよ」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「それに、あの『サイボーグ』はもういないんだし」"},
{"id": 11, "speaker": 3, "form": "dlg", "jp": "「私が恐いのは、襲われることもだけど‥‥」"},
{"id": 12, "speaker": 3, "form": "dlg", "jp": "「襲われる理由が\n　ハッキリとわかっていないってことも‥‥」"},
{"id": 13, "speaker": 3, "form": "choice", "jp": "「理由は父さんの居所を知るためじゃぁ？」"},
{"id": 14, "speaker": 3, "form": "choice", "jp": "「理由は父さんをおびき出すためじゃあ？」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「理由は父さんの居所を知るためじゃぁ？」"},
{"id": 16, "speaker": 3, "form": "dlg", "jp": "「そうかもしれないけど、\n　父さんの居所を知ってどうするつもり？」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「サイボーグを造らせるんじゃあ？」"},
{"id": 18, "speaker": 3, "form": "dlg", "jp": "「すでに『サイボーグ』は造られてるじゃない？」"},
{"id": 19, "speaker": 3, "form": "dlg", "jp": "「あの『サイボーグ』は誰が‥‥」"},
{"id": 20, "speaker": 3, "form": "choice", "jp": "「父さんが‥‥？」"},
{"id": 21, "speaker": 3, "form": "choice", "jp": "「いや、父さんは造っていない！！」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「父さんが‥‥」"},
{"id": 23, "speaker": 3, "form": "dlg", "jp": "「それじゃあおかしいでしょう？」"},
{"id": 24, "speaker": 3, "form": "dlg", "jp": "「あの人たちは父さんの居場所を知らないんだから‥‥」"},
{"id": 25, "speaker": 3, "form": "dlg", "jp": "「もし、父さんが造ったんだとしたら‥‥」"},
{"id": 26, "speaker": 3, "form": "dlg", "jp": "「造らされた後で逃げ出したってことじゃない？」"},
{"id": 27, "speaker": 3, "form": "dlg", "jp": "「そして、逃げ出した父さんをあの人たちは探している」"},
{"id": 28, "speaker": 3, "form": "dlg", "jp": "「何のために！？」"},
{"id": 29, "speaker": 3, "form": "choice", "jp": "「捕まえて処刑するため？」"},
{"id": 30, "speaker": 3, "form": "choice", "jp": "「もっとスゴイ『サイボーグ』を造らせるため？」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「捕まえて処刑するため‥‥」"},
{"id": 32, "speaker": 3, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 33, "speaker": 3, "form": "dlg", "jp": "「そのためにあんなに必死で父さんの居場所を‥‥」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ボクたちが襲われているウチは大丈夫だけど\n　襲われなくなった時は‥‥」"},
{"id": 35, "speaker": 3, "form": "dlg", "jp": "「父さんはつかまって‥‥」"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "「殺されてしまった時ってこと‥‥」"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "「そう考えると襲われている方がマシに思えて来た‥‥」"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "「もっとスゴイ『サイボーグ』を造らせるため‥‥」"},
{"id": 39, "speaker": 3, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 40, "speaker": 3, "form": "dlg", "jp": "「そのためにあんなに必死で父さんの居場所を‥‥」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ボクたちが襲われているウチは大丈夫だけど\n　襲われなくなった時は‥‥」"},
{"id": 42, "speaker": 3, "form": "dlg", "jp": "「父さんはつかまって‥‥」"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「もっとスゴイ『サイボーグ』を造らされた時‥‥」"},
{"id": 44, "speaker": 3, "form": "dlg", "jp": "「今の『サイボーグ』ですら十分恐ろしいのに、\n　それよりスゴイ『サイボーグ』って‥‥」"},
{"id": 45, "speaker": 3, "form": "dlg", "jp": "「いったい、どんなことに使うつもりで‥‥」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「そう考えると襲われている方がマシに思えて来た‥‥」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「いや、父さんは造っていない！！」"},
{"id": 48, "speaker": 3, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 49, "speaker": 3, "form": "dlg", "jp": "「父さんがあんな恐ろしいモノつくるはずが‥‥」"},
{"id": 50, "speaker": 3, "form": "dlg", "jp": "「だとしたら、あの人たちはいったい何のために\n　父さんを探しているの？」"},
{"id": 51, "speaker": 3, "form": "choice", "jp": "「もっとスゴイ『サイボーグ』を造らせるため？？」"},
{"id": 52, "speaker": 3, "form": "choice", "jp": "「他にも何か理由がある！？」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「他にも何か理由がある！？」"},
{"id": 54, "speaker": 3, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 55, "speaker": 3, "form": "dlg", "jp": "「そのためにあんなに必死で父さんの居場所を‥‥」"},
{"id": 56, "speaker": 3, "form": "dlg", "jp": "「でもその理由っていったい‥‥？」"},
{"id": 57, "speaker": 3, "form": "dlg", "jp": "「警察も恐れずに襲ってくる彼等が\n　必死になる理由って‥‥」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "「理由は父さんをおびき出すためじゃあ？」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「ほら、父さんを探すより、\n　ボクらを人質にして誘いだした方が‥‥」"},
{"id": 61, "speaker": 3, "form": "dlg", "jp": "「そうかもしれないけど、\n　父さん誘い出してどうするつもり？」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "「捕まえて、サイボーグを造らせるんじゃあ？」"},
{"id": 63, "speaker": 3, "form": "dlg", "jp": "「すでに『サイボーグ』は造られてるじゃない？」"},
{"id": 64, "speaker": 3, "form": "dlg", "jp": "「あの『サイボーグ』は誰が‥‥」"},
