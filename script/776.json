[
{"id": 0, "speaker": null, "form": "dlg", "jp": "‥‥"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "‥‥‥‥"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 3, "speaker": null, "form": "dlg", "jp": "少しずつ‥‥"},
{"id": 4, "speaker": null, "form": "dlg", "jp": "少しずつ、いろんな音が聞こえてくるようになる‥‥"},
{"id": 5, "speaker": null, "form": "dlg", "jp": "正確には、『いろんな音がわかるようになる』かも‥‥"},
{"id": 6, "speaker": null, "form": "dlg", "jp": "そして、いろんなことを思い出す。"},
{"id": 7, "speaker": null, "form": "dlg", "jp": "少しずつだけど、高速で‥‥"},
{"id": 8, "speaker": null, "form": "dlg", "jp": "ボクたちは『五色沢の研究施設』に行った。"},
{"id": 9, "speaker": null, "form": "dlg", "jp": "そこでルードの工作員に出会い‥‥"},
{"id": 10, "speaker": null, "form": "dlg", "jp": "そして、ボクは殴られた‥‥"},
{"id": 11, "speaker": null, "form": "dlg", "jp": "最後に聞いたのは姉さんの叫び声‥‥"},
{"id": 12, "speaker": null, "form": "dlg", "jp": "『姉さん』‥‥"},
{"id": 13, "speaker": null, "form": "dlg", "jp": "姉さんは‥‥！？"},
{"id": 14, "speaker": null, "form": "dlg", "jp": "正確には、『いろんな音がわかるようになる』かも‥‥"},
{"id": 15, "speaker": null, "form": "dlg", "jp": "そして、いろんなことを思い出す。"},
{"id": 16, "speaker": null, "form": "dlg", "jp": "少しずつだけど、高速で‥‥"},
{"id": 17, "speaker": null, "form": "dlg", "jp": "シローが撃たれ‥‥"},
{"id": 18, "speaker": null, "form": "dlg", "jp": "父さんが自爆し‥‥"},
{"id": 19, "speaker": null, "form": "dlg", "jp": "姉さんが縛られ‥‥"},
{"id": 20, "speaker": null, "form": "dlg", "jp": "ボクが殴られた‥‥"},
{"id": 21, "speaker": null, "form": "dlg", "jp": "そう、ボクは殴られて気絶していた‥‥"},
{"id": 22, "speaker": null, "form": "dlg", "jp": "姉さんは‥‥！？"},
{"id": 23, "speaker": 4, "form": "dlg", "jp": "「お目覚めかな‥‥？」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "（誰だ！？）"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "（ここは一体？？）"},
{"id": 26, "speaker": 3, "form": "dlg", "jp": "「ナゴム、気がついたの‥‥？」"},
{"id": 27, "speaker": 3, "form": "dlg", "jp": "そこにはイスにベルトで縛り付けられている\n姉さんの姿があった。"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「姉さん‥‥！！」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "立ち上がろうとしたが、体が動かない！"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "手足と腰が頑丈なベルトで固定されていた。"},
{"id": 31, "speaker": 4, "form": "dlg", "jp": "「機内で暴れられると危険なんで、\n　縛らせてもらったよ‥‥」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "（機内？？）"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「ここは一体？？」"},
{"id": 34, "speaker": 4, "form": "dlg", "jp": "「見てのとおり、飛行機の中だ‥‥」"},
{"id": 35, "speaker": 4, "form": "dlg", "jp": "「正確には大平洋の上空かな‥‥？」"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "「どこに連れて行くつもりだ！！」"},
{"id": 37, "speaker": 4, "form": "dlg", "jp": "「神秘と遺跡の国‥‥」"},
{"id": 38, "speaker": 4, "form": "dlg", "jp": "「‥‥"},
{"id": 39, "speaker": 4, "form": "dlg", "jp": "『ペルー』"},
{"id": 40, "speaker": 4, "form": "dlg", "jp": "‥‥」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「『ぺルー』だって！？」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "「まさか！！」"},
{"id": 43, "speaker": 4, "form": "dlg", "jp": "「そう、キミたち姉弟には\n　我々『ルード』の本部に来てもらう‥‥」"},
{"id": 44, "speaker": 4, "form": "dlg", "jp": "「おっと、自己紹介がまだだったな‥‥」"},
{"id": 45, "speaker": 4, "form": "dlg", "jp": "「私は、『ルード工作部隊隊長』の\n　『ロバート・ウィルソン大佐』だ‥‥」"},
{"id": 46, "speaker": 28, "form": "dlg", "jp": "「向こうに着いたら、\n　私の指示で働いてもらうことになる」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「働くって‥‥？」"},
{"id": 48, "speaker": 28, "form": "dlg", "jp": "「君たちのお父さんが\n　気分よく働けるように」"},
{"id": 49, "speaker": 28, "form": "dlg", "jp": "「君たちに応援してもらいたいんだ‥‥」"},
{"id": 50, "speaker": 3, "form": "dlg", "jp": "「つまり、\n　私たちをエサに父に言うことをきかせようと！」"},
{"id": 51, "speaker": 28, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 52, "speaker": 28, "form": "dlg", "jp": "「まあ、\n　聞こえを悪く言うとそうかもしれないな‥‥」"},
{"id": 53, "speaker": 3, "form": "dlg", "jp": "「断わりますっ！」"},
{"id": 54, "speaker": 28, "form": "dlg", "jp": "「状況がよく、飲み込めていないようだな‥‥」"},
{"id": 55, "speaker": 28, "form": "dlg", "jp": "「キミたちには断わるとか、\n　断わらないとかの権利は一切ないんだよ‥‥」"},
{"id": 56, "speaker": 28, "form": "dlg", "jp": "「そっちのキミはわかるだろう？」"},
{"id": 57, "speaker": 28, "form": "choice", "jp": "「わかったよ‥‥」"},
{"id": 58, "speaker": 28, "form": "choice", "jp": "「わからない！」"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 60, "speaker": 28, "form": "dlg", "jp": "「よろしい‥‥」"},
{"id": 61, "speaker": 28, "form": "dlg", "jp": "「力に屈するのは決して恥ずべき行為ではない‥‥」"},
{"id": 62, "speaker": 28, "form": "dlg", "jp": "「むしろ、もっとも利口な行為と言えよう‥‥」"},
{"id": 63, "speaker": 28, "form": "dlg", "jp": "「ドクタージョウコウジもキミの様な\n　子供を持ってさぞ、幸せだろう‥‥」"},
{"id": 64, "speaker": 3, "form": "dlg", "jp": "「父は‥‥？」"},
{"id": 65, "speaker": 3, "form": "dlg", "jp": "「父もこの飛行機に乗ってるんですか！？」"},
{"id": 66, "speaker": 28, "form": "dlg", "jp": "「一足さきに本部に到着しているみたいだな‥‥」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「じゃあ、父さんも捕まっている！？」"},
{"id": 68, "speaker": 28, "form": "dlg", "jp": "「ずいぶん手こずったが、キミたちのおかげで\n　無事捕まえることができたよ‥‥」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「ボクたちのおかげ！？」"},
{"id": 70, "speaker": 28, "form": "dlg", "jp": "「ハッハハハハハハハ‥‥」"},
{"id": 71, "speaker": 28, "form": "dlg", "jp": "「本当にワレワレがキミたちごときを\n　殺せないとでも思ってたのかい？」"},
{"id": 72, "speaker": 28, "form": "dlg", "jp": "「ワレワレはキミたちに\n　ドクターを見つけてもらうために」"},
{"id": 73, "speaker": 28, "form": "dlg", "jp": "「あえて、生かしておいたんだよ‥‥」"},
{"id": 74, "speaker": 3, "form": "dlg", "jp": "「じゃあ、ずっと私たちのことを‥‥？」"},
{"id": 75, "speaker": 28, "form": "dlg", "jp": "「そうさ‥‥」"},
{"id": 76, "speaker": 28, "form": "dlg", "jp": "「ずっと監視させてもらったよ‥‥」"},
{"id": 77, "speaker": 3, "form": "dlg", "jp": "「いったいどうやって？」"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "「スパイを使ったんだろう？」"},
{"id": 79, "speaker": 3, "form": "dlg", "jp": "「『スパイ』！？」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「三田さんのお母さんが言ってたよ‥‥」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「『警察にスパイがいて盗聴される』って‥‥」"},
{"id": 82, "speaker": 28, "form": "dlg", "jp": "「その通り‥‥」"},
{"id": 83, "speaker": 28, "form": "dlg", "jp": "「キミたちは警察も\n　たよりにすることはできないってワケだ‥‥」"},
{"id": 84, "speaker": 28, "form": "dlg", "jp": "「さらに、あの『アンドロイド』も\n　警察に捕まっている‥‥」"},
{"id": 85, "speaker": 28, "form": "dlg", "jp": "「つまり、キミたちはこの状況から\n　どうやっても助かることはないというワケだ‥‥」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「ちくしょう！」"},
{"id": 87, "speaker": 28, "form": "dlg", "jp": "「ハッハハハハハハハ‥‥」"},
{"id": 88, "speaker": 28, "form": "dlg", "jp": "「どうだ、『絶望』を味わう気分は？」"},
{"id": 89, "speaker": 3, "form": "dlg", "jp": "「そうでしょうか？」"},
{"id": 90, "speaker": 28, "form": "dlg", "jp": "「うん？」"},
{"id": 91, "speaker": 28, "form": "dlg", "jp": "「『絶望』していないのか？」"},
{"id": 92, "speaker": 3, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 93, "speaker": 28, "form": "dlg", "jp": "「ほう‥‥」"},
{"id": 94, "speaker": 28, "form": "dlg", "jp": "「どういうことかな？」"},
{"id": 95, "speaker": 3, "form": "dlg", "jp": "「今のアナタの発言で、\n　１つ『希望の光』が見えました」"},
{"id": 96, "speaker": 28, "form": "dlg", "jp": "「なんだと！？」"},
{"id": 97, "speaker": 3, "form": "dlg", "jp": "「父はまだ、\n　アナタたちに協力していないということです‥‥」"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥！？」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「そう言われてみれば！！」"},
{"id": 100, "speaker": 28, "form": "dlg", "jp": "「たしかに‥‥」"},
{"id": 101, "speaker": 28, "form": "dlg", "jp": "「『今はまだ』、協力はしてもらっていない‥‥」"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「じゃあ、あのサイボーグたちは\n　父さんと無関係なんだね！？」"},
{"id": 103, "speaker": 28, "form": "dlg", "jp": "「その通りだ‥‥」"},
{"id": 104, "speaker": 28, "form": "dlg", "jp": "「しかし‥‥」"},
{"id": 105, "speaker": 28, "form": "dlg", "jp": "「さっきも言った通り『今はまだ』だ‥‥」"},
{"id": 106, "speaker": 28, "form": "dlg", "jp": "「これからはキミたちの働きによって、\n　うんと協力してもらえるだろう‥‥」"},
{"id": 107, "speaker": 3, "form": "dlg", "jp": "「どうでしょう？」"},
{"id": 108, "speaker": 3, "form": "dlg", "jp": "「父が『犯罪』に手を貸すとは思えませんが‥‥」"},
{"id": 109, "speaker": 28, "form": "dlg", "jp": "「『犯罪』？」"},
{"id": 110, "speaker": 28, "form": "dlg", "jp": "「それはキミたちの『法律』だ‥‥」"},
{"id": 111, "speaker": 28, "form": "dlg", "jp": "「『法律』なんてものは、\n　『国』ごとに違うものだよ‥‥」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「でも、アナタたちは『殺人』を犯している！」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「『人殺し』は世界中で『犯罪』だろう？」"},
{"id": 114, "speaker": 28, "form": "dlg", "jp": "「そんなことはないな‥‥」"},
{"id": 115, "speaker": 28, "form": "dlg", "jp": "「『人を殺す』のが『犯罪』なら、\n　『死刑執行人』も『犯罪者』になる‥‥」"},
{"id": 116, "speaker": 28, "form": "dlg", "jp": "「『犯罪』か『犯罪でない』かは、\n　『正義』か『悪』かで判断されるベキなのでは？」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「じゃあ、アナタたちは『正義』だと？」"},
{"id": 118, "speaker": 28, "form": "dlg", "jp": "「もちろん！」"},
{"id": 119, "speaker": 28, "form": "dlg", "jp": "「ワレワレは常に『正義』に基づいて行動している！」"},
{"id": 120, "speaker": 3, "form": "dlg", "jp": "「殺人や武器の密売が『正義』？」"},
{"id": 121, "speaker": 28, "form": "dlg", "jp": "「ワレワレは悪人を殺害し、\n　正義の味方に武器を販売しているのだ‥‥」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「『正義の味方』が密売で買うわけないだろう？」"},
{"id": 123, "speaker": 28, "form": "dlg", "jp": "「それは、\n　『悪』が武器の売買を管理しているからだ‥‥」"},
{"id": 124, "speaker": 28, "form": "dlg", "jp": "「『悪』からすれば自由に武器の販売をしている\n　ワレワレの行為が犯罪に見えるかもしれない」"},
{"id": 125, "speaker": 28, "form": "dlg", "jp": "「しかし、誰にでも公平にビジネスをするワレワレと」"},
{"id": 126, "speaker": 28, "form": "dlg", "jp": "「自分たちの都合で、武器の売り先を決めている連中と\n　どちらが悪かは、小学生でもわかるだろう？」"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「たしかにそうだけど‥‥」"},
{"id": 128, "speaker": 3, "form": "dlg", "jp": "「ナゴム、だまされちゃダメよ！」"},
{"id": 129, "speaker": 3, "form": "dlg", "jp": "「『正義の味方』がこんなことすると思う？」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 131, "speaker": 28, "form": "dlg", "jp": "「くだらない‥‥」"},
{"id": 132, "speaker": 28, "form": "dlg", "jp": "「乱暴な手段を使うから正義じゃないと？」"},
{"id": 133, "speaker": 28, "form": "dlg", "jp": "「キミたちの『正義』というのは\n　そんなに安っぽいものなのか？」"},
{"id": 134, "speaker": 28, "form": "dlg", "jp": "「『正義』とは\n　どんなことをしてもつら抜くものじゃないのか？」"},
{"id": 135, "speaker": 28, "form": "dlg", "jp": "「まあ、いい‥‥」"},
{"id": 136, "speaker": 28, "form": "dlg", "jp": "「そのウチ、キミたちにも\n　『本当の正義』がわかるようになるだろう‥‥」"},
{"id": 137, "speaker": 28, "form": "dlg", "jp": "「これから仲良くする必要があるんだ‥‥」"},
{"id": 138, "speaker": 28, "form": "dlg", "jp": "「くだらない言い争いはこれぐらいでヤメておこう」"},
{"id": 139, "speaker": 28, "form": "dlg", "jp": "「長旅になるんでゆっくり休んでくれたまえ」"},
{"id": 140, "speaker": 28, "form": "dlg", "jp": "「ハッハハハ‥‥」"},
{"id": 141, "speaker": 28, "form": "dlg", "jp": "そう言ってウィルソン大佐は立ち去った。"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「姉さん‥‥」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「今の話‥‥」"},
{"id": 144, "speaker": 3, "form": "dlg", "jp": "「ダマされちゃダメよ！」"},
{"id": 145, "speaker": 3, "form": "dlg", "jp": "「『正義』なんてものは、\n　他人に押し付けられるものじゃないわ！」"},
{"id": 146, "speaker": 3, "form": "dlg", "jp": "「何が正しくて、何が正しくないかは\n　『良心』が判断するハズよ」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 148, "speaker": 3, "form": "dlg", "jp": "「とにかく、\n　こうなった以上はあわててもしかたないわ‥‥」"},
{"id": 149, "speaker": 3, "form": "dlg", "jp": "「とにかく、いざと言う時のために\n　体力を貯えておきましょう‥‥」"},
{"id": 150, "speaker": 3, "form": "dlg", "jp": "ボクたちは、体力を温存するために\nとりあえず眠ることにした。"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「わからない！」"},
{"id": 152, "speaker": 28, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 153, "speaker": 28, "form": "dlg", "jp": "「ちょっと難しすぎたかな‥‥」"},
{"id": 154, "speaker": 28, "form": "dlg", "jp": "「じゃあ、簡単に、\n　わかりやすく話をしよう‥‥」"},
{"id": 155, "speaker": 28, "form": "dlg", "jp": "「私はこの通り拳銃を持っている」"},
{"id": 156, "speaker": 28, "form": "dlg", "jp": "「キミたちは『ロープ』で縛られている」"},
{"id": 157, "speaker": 28, "form": "dlg", "jp": "「私の聞きたい言葉は『わかった』‥‥」"},
{"id": 158, "speaker": 28, "form": "dlg", "jp": "「さあ、なんて答える？」"},
{"id": 159, "speaker": 28, "form": "choice", "jp": "「わかったよ‥‥」"},
{"id": 160, "speaker": 28, "form": "choice", "jp": "「わからない！」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "「わからない！」"},
{"id": 162, "speaker": 28, "form": "dlg", "jp": "「どうやら、\n　キミは一生わからないみたいだ‥‥」"},
{"id": 163, "speaker": 28, "form": "dlg", "jp": "「お姉さまに物わかりが良くなってもらうために」"},
{"id": 164, "speaker": 28, "form": "dlg", "jp": "「キミには死んでもらうとしよう‥‥」"},
{"id": 165, "speaker": 3, "form": "dlg", "jp": "「ナゴムッ！」"},
{"id": 166, "speaker": 3, "form": "dlg", "jp": "「バキューーーン！」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「うわぁぁぁぁぁ～っ！」"},
{"id": 168, "speaker": 28, "form": "dlg", "jp": "「君ではない！　リツコさんの方だ‥‥」"},
{"id": 169, "speaker": 28, "form": "dlg", "jp": "「もちろん、ある意味\n　君にも働いてもらうことになるがな‥‥」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "（どういう意味だ？）"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "（もう、ボクたちには用はないハズじゃあ‥‥）"},
{"id": 172, "speaker": 2, "form": "choice", "jp": "（まさか、父さんが生きている！！）"},
{"id": 173, "speaker": 2, "form": "choice", "jp": "（いや、そんなハズはない！！）"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "（まさか、父さんが生きている！！）"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "「父さんは生きているんですか？」"},
{"id": 176, "speaker": 28, "form": "dlg", "jp": "「そんなハズはないだろう‥‥？」"},
{"id": 177, "speaker": 28, "form": "dlg", "jp": "「あの爆発で何人の部下が死んだと思ってるんだ‥‥」"},
{"id": 178, "speaker": 28, "form": "dlg", "jp": "「８人だぞ、８人‥‥！！」"},
{"id": 179, "speaker": 28, "form": "dlg", "jp": "「その爆心地にいた人間が生きていると思うのか？」"},
{"id": 180, "speaker": 3, "form": "dlg", "jp": "「じゃあ、なぜ私たちを‥‥？」"},
{"id": 181, "speaker": 28, "form": "dlg", "jp": "「まだ、自分の発明のすごさに気付いていないようだな‥‥」"},
{"id": 182, "speaker": 28, "form": "dlg", "jp": "「確かにお父様の神経工学の技術を活かし、\n　『死の恐怖心』を取り除くというのも魅力的だったが」"},
{"id": 183, "speaker": 28, "form": "dlg", "jp": "「アナタの発明は、それを上回るものじゃないか‥‥」"},
{"id": 184, "speaker": 28, "form": "dlg", "jp": "「『人工知能』‥‥」"},
{"id": 185, "speaker": 28, "form": "dlg", "jp": "「命令絶対、『死を恐れない心』‥‥」"},
{"id": 186, "speaker": 28, "form": "dlg", "jp": "「それを持った『アンドロイド』が量産できれば\n　戦争で命をなくす兵隊が減るのだから」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "（いや、そんなハズはない！！）"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "（じゃあ、なぜ！！）"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「ボクたちを捕まえても、もう父さんは‥‥！！」"},
{"id": 190, "speaker": 28, "form": "dlg", "jp": "「確かにお父様の神経工学の技術を活かし、\n　『死の恐怖心』を取り除くというのも魅力的だったが」"},
{"id": 191, "speaker": 28, "form": "dlg", "jp": "「アナタの発明は、それを上回るものじゃないか‥‥」"},
{"id": 192, "speaker": 28, "form": "dlg", "jp": "「リツコさん、アナタの発明品を見た今となっては\n　アナタのお父様のことはもうどうでも‥‥」"},
{"id": 193, "speaker": 3, "form": "dlg", "jp": "「一体何のことです！？」"},
{"id": 194, "speaker": 28, "form": "dlg", "jp": "「まだ、自分の発明のすごさに気付いていないようだな‥‥」"},
{"id": 195, "speaker": 28, "form": "dlg", "jp": "「『人工知能』‥‥」"},
{"id": 196, "speaker": 28, "form": "dlg", "jp": "「命令絶対、『死を恐れない心』‥‥」"},
{"id": 197, "speaker": 28, "form": "dlg", "jp": "「それを持った『アンドロイド』が量産できれば\n　戦争で命をなくす兵隊が減るのだから」"},
{"id": 198, "speaker": 28, "form": "dlg", "jp": "「リツコさんには、大学なんかよりもっと\n　良い環境で研究をしてもらう」"},
{"id": 199, "speaker": 28, "form": "dlg", "jp": "「協力してくれるね‥‥？」"},
{"id": 200, "speaker": 3, "form": "dlg", "jp": "「お断わりします！！」"},
{"id": 201, "speaker": 3, "form": "dlg", "jp": "「犯罪に手を貸すようなことは出来ません！！」"},
{"id": 202, "speaker": 28, "form": "dlg", "jp": "「『犯罪』‥‥」"},
{"id": 203, "speaker": 28, "form": "dlg", "jp": "「それは『アナタの基準』だ‥‥」"},
{"id": 204, "speaker": 28, "form": "dlg", "jp": "「確かに、我々は『武器の密売』をしている」"},
{"id": 205, "speaker": 28, "form": "dlg", "jp": "「場合によっては『人の命』も奪う」"},
{"id": 206, "speaker": 28, "form": "dlg", "jp": "「しかし、それは『正義のため』だ」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「そんな『正義』聞いたことないぞ！」"},
{"id": 208, "speaker": 28, "form": "dlg", "jp": "「だから、それは『ソッチの基準』だからだ‥‥」"},
{"id": 209, "speaker": 28, "form": "dlg", "jp": "「大国は『自分たちの基準』で勝手に\n　武器の売り先を決める‥‥」"},
{"id": 210, "speaker": 28, "form": "dlg", "jp": "「そして勝手に戦争をして、勝手に人の命を奪う‥‥」"},
{"id": 211, "speaker": 28, "form": "dlg", "jp": "「武器を買えないものは、\n　ただ無惨に命を奪われていく‥‥」"},
{"id": 212, "speaker": 28, "form": "dlg", "jp": "「かわいそうじゃないか？」"},
{"id": 213, "speaker": 28, "form": "dlg", "jp": "「一方的に殺されるんだぞ？」"},
{"id": 214, "speaker": 28, "form": "dlg", "jp": "「だから、我々『ルード』は\n　公平に誰にでも『武器』を売る‥‥」"},
{"id": 215, "speaker": 28, "form": "dlg", "jp": "「人の命も奪いもするが、\n　それとて、必要最小限であって」"},
{"id": 216, "speaker": 28, "form": "dlg", "jp": "「大国の軍隊の様に、\n　無差別に大量に殺しているわけではない‥‥」"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "「しかし‥‥！！」"},
{"id": 218, "speaker": 2, "form": "choice", "jp": "「どんな理由があっても人殺しは犯罪だ！」"},
{"id": 219, "speaker": 2, "form": "choice", "jp": "「父さんの命を奪ったヤツの言いなりにはならない！！」"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「どんな理由があっても人殺しは犯罪だ！」"},
{"id": 221, "speaker": 28, "form": "dlg", "jp": "「立派な意見だ‥‥」"},
{"id": 222, "speaker": 28, "form": "dlg", "jp": "「じゃあ、聞く？」"},
{"id": 223, "speaker": 28, "form": "dlg", "jp": "「君のお父様の爆弾によって、\n　私の部下が８人も死んだ‥‥」"},
{"id": 224, "speaker": 28, "form": "dlg", "jp": "「君は自分の父親を『犯罪者』だと思うのか？」"},
{"id": 225, "speaker": 28, "form": "choice", "jp": "「それはオマエたちが‥‥」"},
{"id": 226, "speaker": 28, "form": "choice", "jp": "「父さんも犯罪者だ！」"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「それはオマエたちが‥‥」"},
{"id": 228, "speaker": 28, "form": "dlg", "jp": "「理由は関係ないんだろう？」"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 230, "speaker": 3, "form": "dlg", "jp": "「アナタの部下たちは単なる事故死です！」"},
{"id": 231, "speaker": 3, "form": "dlg", "jp": "「しかし、父さんは『立派な犯罪者』です！！」"},
{"id": 232, "speaker": 3, "form": "dlg", "jp": "「あの人は私たちの父を殺した『殺人犯』です！」"},
{"id": 233, "speaker": 3, "form": "dlg", "jp": "「私はあの人が死んだ今でも、\n　その事を決して許していません！」"},
{"id": 234, "speaker": 28, "form": "dlg", "jp": "「立派な模範解答を有難う‥‥」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「父さんも犯罪者だ！」"},
{"id": 236, "speaker": 28, "form": "dlg", "jp": "「ほう、そう答えるか‥‥」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「父さんは、他の手段を選ぶべきだった‥‥」"},
{"id": 238, "speaker": 28, "form": "dlg", "jp": "「立派な模範解答を有難う‥‥」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「父さんの命を奪ったヤツの言いなりにはならない！！」"},
{"id": 240, "speaker": 28, "form": "dlg", "jp": "「まあ、\n　君たちの言いたいことはわからないでもない‥‥」"},
{"id": 241, "speaker": 28, "form": "dlg", "jp": "「我々も無闇に人の命が奪われるのは反対だ‥‥」"},
{"id": 242, "speaker": 28, "form": "choice", "jp": "「それはウソだ！！」"},
{"id": 243, "speaker": 28, "form": "choice", "jp": "「じゃあ、なぜ？」"},
{"id": 244, "speaker": 2, "form": "dlg", "jp": "「それはウソだ！！」"},
{"id": 245, "speaker": 28, "form": "dlg", "jp": "「ウソじゃない。　そのために\n　我々は『アンドロイド』の量産を行いたいんだ‥‥」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「じゃあ、なぜ？」"},
{"id": 247, "speaker": 28, "form": "dlg", "jp": "「我々は無駄に命が奪われることをなくすために\n　武器や兵隊の供給を‥‥」"},
{"id": 248, "speaker": 28, "form": "dlg", "jp": "「そして、さらに無駄に兵隊を死なせないために\n　我々は『アンドロイド』の量産を行いたいんだ‥‥」"},
{"id": 249, "speaker": 28, "form": "dlg", "jp": "「平和な国に生まれた君たちには\n　判らないだろうが‥‥」"},
{"id": 250, "speaker": 28, "form": "dlg", "jp": "「世界中ではナゴム君ぐらいの子供が\n　兵隊として戦場にかり出されてるんだ‥‥」"},
{"id": 251, "speaker": 28, "form": "dlg", "jp": "「もし、アンドロイドの兵隊が量産されると\n　そうした子供たちが戦場から開放されるんだ‥‥」"},
{"id": 252, "speaker": 28, "form": "dlg", "jp": "「どうだ、すばらしいとは思わないか？」"},
{"id": 253, "speaker": 28, "form": "choice", "jp": "「思わない！！」"},
{"id": 254, "speaker": 28, "form": "choice", "jp": "「思うけど‥‥」"},
{"id": 255, "speaker": 2, "form": "dlg", "jp": "「思わない！！」"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "「戦争の道具をすばらしいなんて‥‥」"},
{"id": 257, "speaker": 28, "form": "dlg", "jp": "「Е弁だな‥‥」"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "「思うけど‥‥」"},
{"id": 259, "speaker": 28, "form": "dlg", "jp": "「そうだろう‥‥」"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "「だけど、何か間違っているような気がする‥‥」"},
{"id": 261, "speaker": 2, "form": "dlg", "jp": "「だいたい、戦争って兵隊だけが死ぬわけでは‥‥」"},
{"id": 262, "speaker": 28, "form": "dlg", "jp": "「たしかにそうだな‥‥」"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "「すごい兵器が開発されればされる程、\n　兵隊以外の弱い人もたくさん死ぬんじゃ‥‥」"},
{"id": 264, "speaker": 28, "form": "dlg", "jp": "「それは、自然の原理では？」"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "「？？？」"},
{"id": 266, "speaker": 28, "form": "dlg", "jp": "「この世界では弱いものは生き残れないんだよ‥‥」"},
{"id": 267, "speaker": 28, "form": "dlg", "jp": "「君は『進化論』を知らないのか？」"},
{"id": 268, "speaker": 28, "form": "dlg", "jp": "「すべての象が、鼻が長くなったんじゃぁない‥‥」"},
{"id": 269, "speaker": 28, "form": "dlg", "jp": "「鼻が長くなった象だけが生き残ったんだ‥‥」"},
{"id": 270, "speaker": 28, "form": "dlg", "jp": "「人間がどんなに偽善的なことを考えても、\n　『神』は残酷な判断しかくださない」"},
{"id": 271, "speaker": 28, "form": "dlg", "jp": "「強いもの、力のあるものしか生き残れないんだよ‥‥」"},
{"id": 272, "speaker": 28, "form": "dlg", "jp": "「だから我々は『力』をビジネスにしているんだ」"},
{"id": 273, "speaker": 3, "form": "dlg", "jp": "「そんな考え方に協力することはできません！」"},
{"id": 274, "speaker": 28, "form": "dlg", "jp": "「はじめから\n　すんなりと協力してもらえるとは思っていないよ」"},
{"id": 275, "speaker": 28, "form": "dlg", "jp": "「だから、ナゴムくんにも来てもらったんだ‥‥」"},
{"id": 276, "speaker": 28, "form": "dlg", "jp": "「まあ、意地をはっていられるのは、今のうちだ‥‥」"},
{"id": 277, "speaker": 28, "form": "dlg", "jp": "「向こうに着けばイヤでも協力したくなる」"},
{"id": 278, "speaker": 28, "form": "dlg", "jp": "「長旅になるんでゆっくり休んでくれたまえ」"},
{"id": 279, "speaker": 28, "form": "dlg", "jp": "「ハッハハハ‥‥」"},
{"id": 280, "speaker": 28, "form": "dlg", "jp": "そう言ってウィルソン大佐は立ち去った。"},
{"id": 281, "speaker": 28, "form": "dlg", "jp": "どうやら、ヤツらはボクをエサにして、\n姉さんに協力をしいるつもりらしい‥‥"},
{"id": 282, "speaker": 28, "form": "dlg", "jp": "ボクは震えが止まらなかった。"},
{"id": 283, "speaker": 28, "form": "dlg", "jp": "それは、自分の身を案じてのものではなく、\n姉さんを案じてだ。"},
{"id": 284, "speaker": 28, "form": "dlg", "jp": "ボクは姉さんが父さんと同じような選択をするのでは\nという不安に震えていた。"},
{"id": 285, "speaker": 28, "form": "dlg", "jp": "姉さんは、黙ってずっと窓の外を眺めていた。"},
{"id": 286, "speaker": 28, "form": "dlg", "jp": "ボクは何も話しかけることができなかった。"},
{"id": 287, "speaker": 28, "form": "dlg", "jp": "そして、いろんなことを考えているうちに\nいつのまにか眠ってしまった。"},
{"id": 288, "speaker": 28, "form": "dlg", "jp": "失敗の原因は状況を把握してなかったこと。‥‥\n自分の立場を見極めることが必要。"}
]
