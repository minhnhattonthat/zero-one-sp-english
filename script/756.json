[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０７／２１／ＡＭ０８：１０"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "次の日の朝"},
{"id": 2, "speaker": 11, "form": "dlg", "jp": "「すこしぐらい眠れたかい？」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「ええ、少しだけ‥‥」"},
{"id": 4, "speaker": 3, "form": "dlg", "jp": "「顔は洗ったの？」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "「洗ったよ‥‥」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "どうやら姉さんたちは眠らなかったみたいだ。"},
{"id": 7, "speaker": 11, "form": "dlg", "jp": "「すまないが、簡単な事情聴取をしたいんだけど‥‥」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「別にかまいませんけど‥‥」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "「今日は『ブラバスキー警視』は？」"},
{"id": 10, "speaker": 11, "form": "dlg", "jp": "「警視が学校の方の検証にいってるよ‥‥」"},
{"id": 11, "speaker": 2, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 12, "speaker": 11, "form": "dlg", "jp": "「インターポールは『ルード』の方が優先だしな‥‥」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「そうなんですか？」"},
{"id": 14, "speaker": 11, "form": "dlg", "jp": "「一応、警視から話は聞いているけど、\n　どんな理由があるにしろ」"},
{"id": 15, "speaker": 11, "form": "dlg", "jp": "「夜中に学校に忍び込むのはいけないな‥‥」"},
{"id": 16, "speaker": 11, "form": "dlg", "jp": "「本当なら、『不法侵入』で逮捕するところだぞ‥‥」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「すみません‥‥」"},
{"id": 18, "speaker": 11, "form": "dlg", "jp": "「で、今までに学校に\n　おかしなヤツがやってきたことは？」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「ありません‥‥」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「昨日が初めてです‥‥」"},
{"id": 21, "speaker": 11, "form": "dlg", "jp": "「何人だった？」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「ボクが見たのは１人だけです」"},
{"id": 23, "speaker": 11, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 24, "speaker": 11, "form": "dlg", "jp": "「警視の話によると、キミの方に現れたのが\n　『アキス』ってヤツだから‥‥」"},
{"id": 25, "speaker": 11, "form": "dlg", "jp": "「コッチに現れたのは\n　その相棒の『ゼネコ』ってヤツだな‥‥」"},
{"id": 26, "speaker": 11, "form": "dlg", "jp": "結局、せっかくの夏休み初日は取り調べと現場検証で、\nつぶれてしまうことになった。"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「父さんはいったいどこに？」"},
{"id": 28, "speaker": 11, "form": "dlg", "jp": "「さあ、大学の方でもこの１ヶ月ほど\n　まったく連絡が取れてないそうだ‥‥」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「こんな時にいったいどこへ？」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "どうやら、昨日の夜のうちに、\n姉さんの調べは終わっているらしく、"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "ボクの証言と姉さんの証言を\n照らしあわせようとしているらしい。"},
{"id": 32, "speaker": 3, "form": "dlg", "jp": "「ナゴム、ちょっと‥‥」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「なんだい？」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "姉さんは手招きでボクを呼び寄せた。"},
{"id": 35, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 36, "speaker": 3, "form": "dlg", "jp": "（"},
{"id": 37, "speaker": 3, "form": "dlg", "jp": "『シロー』のこと話しちゃダメよ"},
{"id": 38, "speaker": 3, "form": "dlg", "jp": "）"},
{"id": 39, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "（どうして？）"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 43, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 44, "speaker": 3, "form": "dlg", "jp": "（なんだか、ややこしくなりそうだから‥‥）"},
{"id": 45, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 46, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 47, "speaker": 3, "form": "dlg", "jp": "（それに、昨日の停電のせいだとおもうけど、\n"},
{"id": 48, "speaker": 3, "form": "dlg", "jp": "　『シローのデータが完全に消えてしまってる』"},
{"id": 49, "speaker": 3, "form": "dlg", "jp": "のよ！）"},
{"id": 50, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "（ホントに！？）"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 54, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 55, "speaker": 3, "form": "dlg", "jp": "（ええ‥‥）"},
{"id": 56, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "（バックアップとかとってなかったの？）"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 60, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 61, "speaker": 3, "form": "dlg", "jp": "（人格のバックアップだなんて‥‥）"},
{"id": 62, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "（わかった！）"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "（シローのことは言わないよ！）"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 69, "speaker": 11, "form": "dlg", "jp": "「どうかされましたか？」"},
{"id": 70, "speaker": 3, "form": "dlg", "jp": "「いえ、なんでも‥‥」"},
{"id": 71, "speaker": 3, "form": "dlg", "jp": "「それより、みなさん朝食は？」"},
{"id": 72, "speaker": 3, "form": "dlg", "jp": "「ところで、みなさん朝食は？」"},
{"id": 73, "speaker": 3, "form": "dlg", "jp": "「簡単なものなら用意いたしますけど‥‥」"},
{"id": 74, "speaker": 3, "form": "dlg", "jp": "そして、ボクは昨日の夜のことを\nくわしく聞かれることになった。"},
{"id": 75, "speaker": 11, "form": "dlg", "jp": "「ほんとすみませんねぇ、気をつかわせて‥‥」"},
{"id": 76, "speaker": 3, "form": "dlg", "jp": "「いえ、気になさらないでください」"},
{"id": 77, "speaker": 11, "form": "dlg", "jp": "「で、昨日の夜のことなんだけど‥‥」"},
{"id": 78, "speaker": 11, "form": "dlg", "jp": "「事件の時、君は起きてた？」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「はい、起きていました」"},
{"id": 80, "speaker": 11, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 81, "speaker": 11, "form": "dlg", "jp": "「受験生だもんなぁ‥‥」"},
{"id": 82, "speaker": 11, "form": "dlg", "jp": "「大変だろう？　勉強とか‥‥」"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "「ええまあ‥‥」"},
{"id": 84, "speaker": 11, "form": "dlg", "jp": "「まあ、そんなことはどうでもいいか‥‥」"},
{"id": 85, "speaker": 11, "form": "dlg", "jp": "「で、連中が侵入してきた時はどこにいたの？」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「姉と１階の『研究室』にいました」"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "「暑くてねむれなかったので‥‥」"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "「あそこは、コンピュータがあって、\n　冷房がかかっていて涼しいから‥‥」"},
{"id": 89, "speaker": 11, "form": "dlg", "jp": "「なるほど、なるほど‥‥」"},
{"id": 90, "speaker": 11, "form": "dlg", "jp": "「で、そこには姉さんとナゴムくん以外には？」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「誰もいませんでした‥‥」"},
{"id": 92, "speaker": 11, "form": "dlg", "jp": "「研究室以外の部屋には？」"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "「この家にはボクたち以外誰も‥‥」"},
{"id": 94, "speaker": 11, "form": "dlg", "jp": "「お姉さんもそう言ってるんだけどね‥‥」"},
{"id": 95, "speaker": 11, "form": "dlg", "jp": "「気になるのが、\n　通報をくれた"},
{"id": 96, "speaker": 11, "form": "dlg", "jp": "『若い男性』"},
{"id": 97, "speaker": 11, "form": "dlg", "jp": "のことなんだけど‥‥」"},
{"id": 98, "speaker": 11, "form": "dlg", "jp": "「ナゴムくんは心当たりは？」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「ありません‥‥」"},
{"id": 100, "speaker": 11, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 101, "speaker": 11, "form": "dlg", "jp": "「ピンポーン！！」"},
{"id": 102, "speaker": 11, "form": "dlg", "jp": "「ピンポーン！！」"},
{"id": 103, "speaker": 13, "form": "dlg", "jp": "「ナ～ゴ～ム～くん！！」"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "（ツトムだ！！）"},
{"id": 105, "speaker": 11, "form": "dlg", "jp": "「友達かい？」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「あっ、ハイ！！」"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「ちょっといいですか？」"},
{"id": 108, "speaker": 11, "form": "dlg", "jp": "「ああ、かまわないよ‥‥」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 111, "speaker": 13, "form": "dlg", "jp": "「ウィッス！！」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「ったく‥‥\n　カッコワルイだろぅ！」"},
{"id": 113, "speaker": 13, "form": "dlg", "jp": "「なんかあったのか！？」"},
{"id": 114, "speaker": 13, "form": "dlg", "jp": "「あれ警察だろ！？」"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "「なんでもないよ！」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「またあとで電話するから‥‥」"},
{"id": 117, "speaker": 13, "form": "dlg", "jp": "「オイ、なんかあったんだろ？」"},
{"id": 118, "speaker": 13, "form": "dlg", "jp": "「拳銃は見せてもらったのか？」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「だから、後で電話するって言ってるだろう！」"},
{"id": 120, "speaker": 13, "form": "dlg", "jp": "「ハイハイ、わかったよ‥‥」"},
{"id": 121, "speaker": 13, "form": "dlg", "jp": "「ちゃんと、電話くれよな！」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 123, "speaker": 13, "form": "dlg", "jp": "「ハイハイ、んじゃ後で‥‥」"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「おまたせしました」"},
{"id": 125, "speaker": 11, "form": "dlg", "jp": "「いや、かまわないよ‥‥」"},
{"id": 126, "speaker": 11, "form": "dlg", "jp": "「連中、かなり大胆というか大雑把というか‥‥」"},
{"id": 127, "speaker": 11, "form": "dlg", "jp": "「まあ、乱暴に仕事をしてくれたおかげで、\n　指紋に足跡、証拠がいっぱい残ってるんだよ」"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "「そんなにですか？」"},
{"id": 129, "speaker": 11, "form": "dlg", "jp": "「世界的な組織だからなぁ、警察をなめてるんだろ！」"},
{"id": 130, "speaker": 11, "form": "dlg", "jp": "「身元が割れてもつかまらないと‥‥」"},
{"id": 131, "speaker": 11, "form": "dlg", "jp": "「‥で、たしか２人組だったらしいけど‥‥」"},
{"id": 132, "speaker": 11, "form": "dlg", "jp": "「まさか『名前』を言ってなかったかい？」"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "「言ってました」"},
{"id": 134, "speaker": 11, "form": "dlg", "jp": "「思い出せるかい？」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「ハイ！　たしか‥‥」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「『アキス』と『ゼネコ』だったと‥‥」"},
{"id": 137, "speaker": 11, "form": "dlg", "jp": "「『アキス』と『ゼネコ』か‥‥」"},
{"id": 138, "speaker": 11, "form": "dlg", "jp": "「オイ！　『アキス』と『ゼネコ』調べてくれ！」"},
{"id": 139, "speaker": 11, "form": "dlg", "jp": "結局、せっかくの夏休み初日は取り調べと現場検証で、\nつぶれてしまうことになった。"},
{"id": 140, "speaker": 3, "form": "dlg", "jp": "「で、父とは連絡は‥‥？」"},
{"id": 141, "speaker": 11, "form": "dlg", "jp": "「さあ、大学の方でもこの１ヶ月ほど\n　まったく連絡が取れてないそうです‥‥」"},
{"id": 142, "speaker": 3, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「こんな時にいったいどこへ？」"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "２００５／０７／２１／ＰＭ１２：２０"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "こうして、取り調べは昼過ぎまで続いた。"},
{"id": 146, "speaker": 11, "form": "dlg", "jp": "「もうこんな時間か‥‥」"},
{"id": 147, "speaker": 11, "form": "dlg", "jp": "「いろいろありがとう‥‥」"},
{"id": 148, "speaker": 11, "form": "dlg", "jp": "「"},
{"id": 149, "speaker": 11, "form": "dlg", "jp": "『宿題』"},
{"id": 150, "speaker": 11, "form": "dlg", "jp": "とかあるんだろう？」"},
{"id": 151, "speaker": 11, "form": "dlg", "jp": "「もう自由にしてもらってかまわないよ」"},
{"id": 152, "speaker": 11, "form": "dlg", "jp": "（『自由に』って言うわりには、\n　"},
{"id": 153, "speaker": 11, "form": "dlg", "jp": "『宿題』"},
{"id": 154, "speaker": 11, "form": "dlg", "jp": "を強調してたよな‥‥）"},
{"id": 155, "speaker": 11, "form": "dlg", "jp": "「ただし、外出する時は声をかけてくれ」"},
{"id": 156, "speaker": 11, "form": "dlg", "jp": "「警備のモノをつけるから‥‥」"},
{"id": 157, "speaker": 11, "form": "dlg", "jp": "（要は『おとなしくしろ』ってことだよな‥‥）"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「わかりました！」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "（せっかくの夏休みがつまらないことで\n　半日つぶれちゃったな‥‥）"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "（さてと、これからどうしようかな？）"},
{"id": 161, "speaker": 2, "form": "choice", "jp": "【移動】"},
{"id": 162, "speaker": 2, "form": "choice", "jp": "【話す】"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "【移動】"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "何所へ移動する？"},
{"id": 165, "speaker": 2, "form": "choice", "jp": "【自分の部屋】"},
{"id": 166, "speaker": 2, "form": "choice", "jp": "【外に出る】"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "【自分の部屋】"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "（部屋でおとなしくしておくか‥‥）"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "（こんな時間から外出してもしかたないし‥‥）"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ボクは部屋に戻ります‥‥」"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "「あんまりウロウロしていると\n　警備の人にもメイワクがかかるでしょうし‥‥」"},
{"id": 172, "speaker": 11, "form": "dlg", "jp": "「イヤ、気にしなくてもいいのに‥‥」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「それに、昨日はあんまり寝てないんで‥‥」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「ちょっと眠らせてもらいます」"},
{"id": 175, "speaker": 11, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 176, "speaker": 3, "form": "dlg", "jp": "「ナゴム、ちょっと‥‥」"},
{"id": 177, "speaker": 3, "form": "dlg", "jp": "リビングを出たとたん、\n姉さんがボクを呼び寄せた。"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 179, "speaker": 3, "form": "dlg", "jp": "「アナタ、\n　夕べ『シロー』と話してたでしょう？」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "「うん、それが？」"},
{"id": 181, "speaker": 3, "form": "dlg", "jp": "「何か変わったことはなかった？」"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "「さあ、シローの存在自体変わってるから‥‥」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「何かあったの？」"},
{"id": 184, "speaker": 3, "form": "dlg", "jp": "「実は‥‥」"},
{"id": 185, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 186, "speaker": 3, "form": "dlg", "jp": "（今朝、コンピューターを起動したら\n　シローがいなくなっていたの‥‥）"},
{"id": 187, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「ウソ！？」"},
{"id": 189, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 190, "speaker": 3, "form": "dlg", "jp": "（大きな声を出さないで！！）"},
{"id": 191, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 192, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "（ゴメン‥‥）"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 195, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "（それ本当なの？）"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 198, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 199, "speaker": 3, "form": "dlg", "jp": "（ええ‥‥）"},
{"id": 200, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 201, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 202, "speaker": 3, "form": "dlg", "jp": "（ファイルの断片すら残ってないの‥‥）"},
{"id": 203, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 204, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 205, "speaker": 3, "form": "dlg", "jp": "（ねえ、夕べはどんな感じだったの？）"},
{"id": 206, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 208, "speaker": 2, "form": "dlg", "jp": "（フツーだったよ‥‥）"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "（ちょっと警察不信にはなってたみたいだけど‥‥）"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 213, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 214, "speaker": 3, "form": "dlg", "jp": "（そう‥‥）"},
{"id": 215, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 216, "speaker": 11, "form": "dlg", "jp": "「どうかされましたか？」"},
{"id": 217, "speaker": 3, "form": "dlg", "jp": "「いえ、なにも！！」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "ボクは部屋でおとなしくすることにした。"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "昨夜のバタバタで寝不足ギミだったボクは\nそのまま熟睡してしまった。"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "【外に出る】"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ちょっと出かけて来ます」"},
{"id": 226, "speaker": 11, "form": "dlg", "jp": "「まあ、\n　ワレワレにまかせておけば大丈夫だよ！」"},
{"id": 227, "speaker": 11, "form": "dlg", "jp": "ボクは外へ出ることにした。"},
{"id": 228, "speaker": 3, "form": "dlg", "jp": "「ナゴム、ちょっと‥‥」"},
{"id": 229, "speaker": 3, "form": "dlg", "jp": "リビングを出たとたん、\n姉さんがボクを呼び寄せた。"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 231, "speaker": 3, "form": "dlg", "jp": "「アナタ、\n　夕べ『シロー』と話してたでしょう？」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「うん、それが？」"},
{"id": 233, "speaker": 3, "form": "dlg", "jp": "「何か変わったことはなかった？」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「さあ、シローの存在自体変わってるから‥‥」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「何かあったの？」"},
{"id": 236, "speaker": 3, "form": "dlg", "jp": "「実は‥‥」"},
{"id": 237, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 238, "speaker": 3, "form": "dlg", "jp": "（今朝、コンピューターを起動したら\n　シローがいなくなっていたの‥‥）"},
{"id": 239, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「ウソ！？」"},
{"id": 241, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 242, "speaker": 3, "form": "dlg", "jp": "（大きな声を出さないで！！）"},
{"id": 243, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 244, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "（ゴメン‥‥）"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "（それ本当なの？）"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 250, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 251, "speaker": 3, "form": "dlg", "jp": "（ええ‥‥）"},
{"id": 252, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 253, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 254, "speaker": 3, "form": "dlg", "jp": "（ファイルの断片すら残ってないの‥‥）"},
{"id": 255, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 256, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 257, "speaker": 3, "form": "dlg", "jp": "（ねえ、夕べはどんな感じだったの？）"},
{"id": 258, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "（フツーだったよ‥‥）"},
{"id": 261, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "（ちょっと警察不信にはなってたみたいだけど‥‥）"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 265, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 266, "speaker": 3, "form": "dlg", "jp": "（そう‥‥）"},
{"id": 267, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 268, "speaker": 11, "form": "dlg", "jp": "「どうかされましたか？」"},
{"id": 269, "speaker": 3, "form": "dlg", "jp": "「いえ、なにも！！」"},
{"id": 270, "speaker": 3, "form": "dlg", "jp": "「じゃあ、いってらっしゃい！」"},
{"id": 271, "speaker": 2, "form": "dlg", "jp": "「う、うん！」"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 274, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "（さてと、どこにいこうかな？）"},
{"id": 276, "speaker": 2, "form": "choice", "jp": "【駅前】"},
{"id": 277, "speaker": 2, "form": "choice", "jp": "【ゲームセンター】"},
{"id": 278, "speaker": 2, "form": "choice", "jp": "【公園】"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "【駅前】"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "（『駅前』でも行ってみるか‥‥）"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "（せっかくの夏休みだもんな‥‥）"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "【ゲームセンター】"},
{"id": 284, "speaker": 2, "form": "dlg", "jp": "（『ゲームセンター』でも行ってみるか‥‥）"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "（ツトムがいるかも知れないしな‥‥）"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "しかし‥‥"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "（なんだ、ツトムのヤツ来てないのか‥‥）"},
{"id": 290, "speaker": 17, "form": "dlg", "jp": "「オイ、常光寺ィ！！」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「せ、先生‥‥」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "『大本』‥‥\nボクたちの学校の体育教師だ。"},
{"id": 293, "speaker": 17, "form": "dlg", "jp": "「聞いたぞ！」"},
{"id": 294, "speaker": 17, "form": "dlg", "jp": "「夕べは大変だったらしいな‥‥」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "「ええ、まあ‥‥」"},
{"id": 296, "speaker": 17, "form": "dlg", "jp": "「で、\n　こんなところでウロウロしていていいのか？」"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "「ええ、まあ‥‥」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "「ホラ、警察の人がガードを‥‥」"},
{"id": 299, "speaker": 17, "form": "dlg", "jp": "「何を言ってる！」"},
{"id": 300, "speaker": 17, "form": "dlg", "jp": "「それじゃあ、\n　警察にメイワクがかかるだろう！」"},
{"id": 301, "speaker": 17, "form": "dlg", "jp": "「事件が解決するまで\n　おとなしくしておけよ！」"},
{"id": 302, "speaker": 2, "form": "dlg", "jp": "「そ、そうですね‥‥」"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "（やっぱり、家でおとなしくしておくべきか‥‥）"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "ボクは家でおとなしくすることにした。"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "【公園】"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "（『公園』でも行ってみるか‥‥）"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 308, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん！」"},
{"id": 309, "speaker": 2, "form": "dlg", "jp": "「アイコ！！」"},
{"id": 310, "speaker": 15, "form": "dlg", "jp": "「こんな所にいていいの？」"},
{"id": 311, "speaker": 15, "form": "dlg", "jp": "「昨日大変だったんでしょう？」"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "「ホラ、警察の人がガードを‥‥」"},
{"id": 314, "speaker": 15, "form": "dlg", "jp": "「ダメじゃない！\n　ウロウロしてちゃ警察の人も大変でしょう！」"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "「まあ、そうなんだけど‥‥」"},
{"id": 316, "speaker": 15, "form": "dlg", "jp": "「事件が解決するまで\n　おとなしくしときなさいよ！」"},
{"id": 317, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 318, "speaker": 15, "form": "dlg", "jp": "「だいたい、ナゴムちゃんっていつもそうなのよね！」"},
{"id": 319, "speaker": 15, "form": "dlg", "jp": "「もっと周りの人の気持ちも、ちゃんと考えなさいよ！」"},
{"id": 320, "speaker": 15, "form": "dlg", "jp": "「どれだけ皆に心配かけてると思ってるの？」"},
{"id": 321, "speaker": 2, "form": "dlg", "jp": "「ご、ごめん‥‥」"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "（やっぱり、家でおとなしくしておくべきか‥‥）"},
{"id": 323, "speaker": 2, "form": "dlg", "jp": "ボクは家でおとなしくすることにした。"},
{"id": 324, "speaker": 18, "form": "dlg", "jp": "「アラ、常光寺くん！」"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "「堤さん‥‥」"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "（『堤ナナセ』‥‥）"},
{"id": 327, "speaker": 2, "form": "dlg", "jp": "（ボクの学校の生徒会長だ‥‥）"},
{"id": 328, "speaker": 2, "form": "dlg", "jp": "（生徒会長と言っても、別にいじめられっこでも、\n　目立ちたがりやでもない‥‥）"},
{"id": 329, "speaker": 2, "form": "dlg", "jp": "（ただ成績が良く、性格も良いので、\n　教師たちに無理矢理に生徒会長をさせられている‥‥）"},
{"id": 330, "speaker": 2, "form": "dlg", "jp": "（また、彼女自身、性格がいいので、\n　そうした押し付け仕事をいやがってはいない。）"},
{"id": 331, "speaker": 18, "form": "dlg", "jp": "「こんな所にいても大丈夫なの？」"},
{"id": 332, "speaker": 18, "form": "dlg", "jp": "「昨日、大変だったんでしょう？」"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "「なんで知ってるの？」"},
{"id": 334, "speaker": 18, "form": "dlg", "jp": "「さっき、三船さんに会ったから‥‥」"},
{"id": 335, "speaker": 2, "form": "dlg", "jp": "「アイコが？」"},
{"id": 336, "speaker": 2, "form": "dlg", "jp": "「あのオシャベリめ‥‥」"},
{"id": 337, "speaker": 18, "form": "dlg", "jp": "「で、いいの？」"},
{"id": 338, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 339, "speaker": 2, "form": "dlg", "jp": "「ホラ、警察の人がガードを‥‥」"},
{"id": 340, "speaker": 18, "form": "dlg", "jp": "「いくら警察の人がガードしてるって言っても‥‥」"},
{"id": 341, "speaker": 2, "form": "dlg", "jp": "「まあ、そうなんだけど‥‥」"},
{"id": 342, "speaker": 18, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥」"},
{"id": 343, "speaker": 18, "form": "dlg", "jp": "「やっぱりアブナイと思うの‥‥」"},
{"id": 344, "speaker": 18, "form": "dlg", "jp": "「おウチの中にいた方がいいんじゃないかしら‥‥」"},
{"id": 345, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 346, "speaker": 2, "form": "dlg", "jp": "（やっぱり、家でおとなしくしておくべきか‥‥）"},
{"id": 347, "speaker": 2, "form": "dlg", "jp": "ボクは家でおとなしくすることにした。"},
{"id": 348, "speaker": 14, "form": "dlg", "jp": "「よう、ナゴム！！」"},
{"id": 349, "speaker": 2, "form": "dlg", "jp": "「シンちゃん！」"},
{"id": 350, "speaker": 14, "form": "dlg", "jp": "「昨日、大変だったんだろ？」"},
{"id": 351, "speaker": 14, "form": "dlg", "jp": "「こんな所にいても大丈夫なのか？」"},
{"id": 352, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 353, "speaker": 2, "form": "dlg", "jp": "「ホラ、警察の人もガードをつけてくれてるし‥‥」"},
{"id": 354, "speaker": 14, "form": "dlg", "jp": "「後ろ、ついて来てるの、警察の人だよな‥‥？」"},
{"id": 355, "speaker": 2, "form": "dlg", "jp": "「うん、そうだよ‥‥」"},
{"id": 356, "speaker": 14, "form": "dlg", "jp": "「まさか、"},
{"id": 357, "speaker": 14, "form": "dlg", "jp": "オマエを狙っている連中じゃあ‥‥」"},
{"id": 358, "speaker": 2, "form": "dlg", "jp": "「やなこと言うなよ！」"},
{"id": 359, "speaker": 14, "form": "dlg", "jp": "「ハハハハハ‥‥」"},
{"id": 360, "speaker": 14, "form": "dlg", "jp": "「安心しろっ！」"},
{"id": 361, "speaker": 14, "form": "dlg", "jp": "「いざとなったら、オレが守ってやるから‥‥」"},
{"id": 362, "speaker": 2, "form": "dlg", "jp": "「ありがと‥‥」"},
{"id": 363, "speaker": 14, "form": "dlg", "jp": "「とにかく、今日はウチで大人しくしてろ！」"},
{"id": 364, "speaker": 2, "form": "dlg", "jp": "「そ、そうだね‥‥」"},
{"id": 365, "speaker": 2, "form": "dlg", "jp": "（やっぱり、家でおとなしくしておくべきか‥‥）"},
{"id": 366, "speaker": 2, "form": "dlg", "jp": "ボクは家でおとなしくすることにした。"},
{"id": 367, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 368, "speaker": 2, "form": "dlg", "jp": "「ただいまぁ‥‥」"},
{"id": 369, "speaker": 11, "form": "dlg", "jp": "「うん？」"},
{"id": 370, "speaker": 11, "form": "dlg", "jp": "「早かったね？」"},
{"id": 371, "speaker": 2, "form": "dlg", "jp": "「あんまりウロウロしていると\n　警備の人にもメイワクがかかるでしょうし‥‥」"},
{"id": 372, "speaker": 11, "form": "dlg", "jp": "「イヤ、気にしなくてもいいのに‥‥」"},
{"id": 373, "speaker": 2, "form": "dlg", "jp": "「いえ、\n　せめて今日１日は家でおとなしくしておきます‥‥」"},
{"id": 374, "speaker": 11, "form": "dlg", "jp": "「そうか、ありがとう‥‥」"},
{"id": 375, "speaker": 11, "form": "dlg", "jp": "ボクは部屋でおとなしくすることにした。"},
{"id": 376, "speaker": 11, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 377, "speaker": 11, "form": "dlg", "jp": "「バタン！」"},
{"id": 378, "speaker": 11, "form": "dlg", "jp": "そして‥‥"},
{"id": 379, "speaker": 11, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 380, "speaker": 11, "form": "dlg", "jp": "昨夜のバタバタで寝不足ギミだったボクは\nそのまま熟睡してしまった。"},
{"id": 381, "speaker": 11, "form": "dlg", "jp": "昨夜のバタバタで寝不足ギミだったボクは\n少し眠ることにした。"},
{"id": 382, "speaker": 11, "form": "dlg", "jp": "その時‥‥"},
{"id": 383, "speaker": 11, "form": "dlg", "jp": "「プルルルルル‥‥」"},
{"id": 384, "speaker": 11, "form": "dlg", "jp": "ボクの携帯電話がなった。"},
{"id": 385, "speaker": 2, "form": "dlg", "jp": "（誰だろう？）"},
{"id": 386, "speaker": 2, "form": "dlg", "jp": "「ピッ！」"},
{"id": 387, "speaker": 2, "form": "dlg", "jp": "「もしもし‥‥」"},
{"id": 388, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 389, "speaker": 50, "form": "dlg", "jp": "（『出口』だけど‥‥）"},
{"id": 390, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 391, "speaker": 2, "form": "dlg", "jp": "（『出口エイジ』だ‥‥）"},
{"id": 392, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 393, "speaker": 50, "form": "dlg", "jp": "（夕べは大変だったね？）"},
{"id": 394, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 395, "speaker": 2, "form": "dlg", "jp": "「キミが人騒がせなことするから‥‥」"},
{"id": 396, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 397, "speaker": 50, "form": "dlg", "jp": "（違うよ！）"},
{"id": 398, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 399, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 400, "speaker": 50, "form": "dlg", "jp": "（『ルード』の事だよ！）"},
{"id": 401, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 402, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥！？」"},
{"id": 403, "speaker": 2, "form": "dlg", "jp": "「ちょっと待ってよ！」"},
{"id": 404, "speaker": 2, "form": "dlg", "jp": "「何でそのことを！？」"},
{"id": 405, "speaker": 2, "form": "dlg", "jp": "「もしかして、アイコから？」"},
{"id": 406, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 407, "speaker": 50, "form": "dlg", "jp": "（ちがうよ！）"},
{"id": 408, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 409, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 410, "speaker": 50, "form": "dlg", "jp": "（ボク見てたんだよ‥‥）"},
{"id": 411, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 412, "speaker": 2, "form": "dlg", "jp": "「見てた！？」"},
{"id": 413, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 414, "speaker": 50, "form": "dlg", "jp": "（うん、グウゼン‥‥）"},
{"id": 415, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 416, "speaker": 2, "form": "dlg", "jp": "「もしかして、警察に？」"},
{"id": 417, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 418, "speaker": 50, "form": "dlg", "jp": "（通報したよ‥‥）"},
{"id": 419, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 420, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 421, "speaker": 50, "form": "dlg", "jp": "（当然だろう？）"},
{"id": 422, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 423, "speaker": 2, "form": "dlg", "jp": "「アリガトウ！」"},
{"id": 424, "speaker": 2, "form": "dlg", "jp": "「出口のオカゲで助かったよ‥‥」"},
{"id": 425, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 426, "speaker": 50, "form": "dlg", "jp": "（で、今は大丈夫なのかい？）"},
{"id": 427, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 428, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 429, "speaker": 2, "form": "dlg", "jp": "「警察が厳重にガードしてくれてるよ！」"},
{"id": 430, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 431, "speaker": 50, "form": "dlg", "jp": "（警察にお父さんの居場所は教えてないの？）"},
{"id": 432, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 433, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 434, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 435, "speaker": 50, "form": "dlg", "jp": "（どうして？）"},
{"id": 436, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 437, "speaker": 2, "form": "dlg", "jp": "「うん、\n　ボクたちも父さんの居場所を知らないんだよ‥‥」"},
{"id": 438, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 439, "speaker": 50, "form": "dlg", "jp": "（そうなんだ‥‥）"},
{"id": 440, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 441, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 442, "speaker": 50, "form": "dlg", "jp": "（大変だね‥‥）"},
{"id": 443, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 444, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 445, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 446, "speaker": 50, "form": "dlg", "jp": "（でも、無事みたいでよかったよ‥‥）"},
{"id": 447, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 448, "speaker": 2, "form": "dlg", "jp": "「アリガトウ‥‥」"},
{"id": 449, "speaker": 50, "form": "dlg", "jp": "「"},
{"id": 450, "speaker": 50, "form": "dlg", "jp": "（じゃあね‥‥）"},
{"id": 451, "speaker": 50, "form": "dlg", "jp": "」"},
{"id": 452, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 453, "speaker": 2, "form": "dlg", "jp": "「ピッ！」"},
{"id": 454, "speaker": 2, "form": "dlg", "jp": "（そうか‥‥）"},
{"id": 455, "speaker": 2, "form": "dlg", "jp": "（出口が通報してくれたんだ‥‥）"},
{"id": 456, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥！？）"},
{"id": 457, "speaker": 2, "form": "dlg", "jp": "（アイツ、\n　やっぱり夜中にウロウロしてるってことか‥‥）"},
{"id": 458, "speaker": 2, "form": "dlg", "jp": "（ヘンなヤツだな‥‥）"},
{"id": 459, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥）"},
{"id": 460, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 461, "speaker": 2, "form": "dlg", "jp": "ボクはそのまま眠ってしまった。"},
{"id": 462, "speaker": 2, "form": "dlg", "jp": "【話す】"},
{"id": 463, "speaker": 2, "form": "dlg", "jp": "誰と話す？"},
{"id": 464, "speaker": 2, "form": "choice", "jp": "【大槻警部】"},
{"id": 465, "speaker": 2, "form": "choice", "jp": "【姉さん】"},
{"id": 466, "speaker": 11, "form": "dlg", "jp": "「うん？」"},
{"id": 467, "speaker": 11, "form": "dlg", "jp": "「出かけるのかい？」"},
{"id": 468, "speaker": 11, "form": "dlg", "jp": "「じゃあ、ガードをつけよう」"},
{"id": 469, "speaker": 2, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 470, "speaker": 11, "form": "dlg", "jp": "「気にしないで、ワレワレも仕事だし‥‥」"},
{"id": 471, "speaker": 11, "form": "dlg", "jp": "「大丈夫だよ！」"},
{"id": 472, "speaker": 11, "form": "dlg", "jp": "「ワレワレがいるかぎり、襲われることないよ！」"},
{"id": 473, "speaker": 3, "form": "dlg", "jp": "「警察のメイワクにならないようにね！」"},
{"id": 474, "speaker": 3, "form": "dlg", "jp": "「何度もおなじこと言わせないで！」"},
{"id": 475, "speaker": 3, "form": "dlg", "jp": "そして‥‥"},
{"id": 476, "speaker": 3, "form": "dlg", "jp": "「キャーッ！」"},
{"id": 477, "speaker": 3, "form": "dlg", "jp": "姉さんの悲鳴で目を覚ましたボクは\nあわてて姉さんのいる１階へとかけ下りた。"},
{"id": 478, "speaker": 3, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 479, "speaker": 3, "form": "dlg", "jp": "２００５／０７／２１／ＰＭ１１：３０"},
{"id": 480, "speaker": 2, "form": "dlg", "jp": "「コ、コイツ‥‥‥！」"},
{"id": 481, "speaker": 2, "form": "dlg", "jp": "たしか、ニュースに映っていた『サイボーグ』‥‥！？"},
{"id": 482, "speaker": 11, "form": "dlg", "jp": "「よくも、ノコノコと‥‥」"},
{"id": 483, "speaker": 4, "form": "dlg", "jp": "「警察か‥‥」"},
{"id": 484, "speaker": 11, "form": "dlg", "jp": "「ただの警察じゃないぞ！」"},
{"id": 485, "speaker": 11, "form": "dlg", "jp": "「世界で１番優秀な日本警察だ！」"},
{"id": 486, "speaker": 4, "form": "dlg", "jp": "「痛い目にあいたくなければおとなしくしていろ！」"},
{"id": 487, "speaker": 11, "form": "dlg", "jp": "「それはこっちの台詞だ！！」"},
{"id": 488, "speaker": 4, "form": "dlg", "jp": "「フフフフフ‥‥！」"},
{"id": 489, "speaker": 4, "form": "dlg", "jp": "「その女‥‥」"},
{"id": 490, "speaker": 4, "form": "dlg", "jp": "「もらって行く‥‥」"},
{"id": 491, "speaker": 4, "form": "dlg", "jp": "大男は警察を無視して、姉さんをさらおうとした。"},
{"id": 492, "speaker": 11, "form": "dlg", "jp": "「かまわん、撃てっ！」"},
{"id": 493, "speaker": 11, "form": "dlg", "jp": "ニュースの時と同じだ！！"},
{"id": 494, "speaker": 11, "form": "dlg", "jp": "このサイボーグには拳銃は通用しない！"},
{"id": 495, "speaker": 11, "form": "dlg", "jp": "「へっ？」"},
{"id": 496, "speaker": 4, "form": "dlg", "jp": "「そんなオモチャで、オレを倒せるつもりか？」"},
{"id": 497, "speaker": 11, "form": "dlg", "jp": "「サイボーグ！！」"},
{"id": 498, "speaker": 4, "form": "dlg", "jp": "「じゃあ、お嬢さんいっしょに来てもらおうか？」"},
{"id": 499, "speaker": 2, "form": "dlg", "jp": "（マズイ！！）"},
{"id": 500, "speaker": 2, "form": "dlg", "jp": "（姉さんがさらわれてしまう！）"},
{"id": 501, "speaker": 2, "form": "choice", "jp": "（もうダメだ‥‥）"},
{"id": 502, "speaker": 2, "form": "choice", "jp": "（助けなきゃ！）"},
{"id": 503, "speaker": 2, "form": "dlg", "jp": "（助けなきゃ！）"},
{"id": 504, "speaker": 2, "form": "dlg", "jp": "（でも、一体どうやって？）"},
{"id": 505, "speaker": 2, "form": "choice", "jp": "【頭を殴りつける！】"},
{"id": 506, "speaker": 2, "form": "choice", "jp": "【足をける！】"},
{"id": 507, "speaker": 2, "form": "dlg", "jp": "（もうダメだ‥‥）"},
{"id": 508, "speaker": 2, "form": "dlg", "jp": "（こうなったらおしまいだ！）"},
{"id": 509, "speaker": 3, "form": "dlg", "jp": "「放してくださいっ！」"},
{"id": 510, "speaker": 3, "form": "dlg", "jp": "警察も人質をとられた状態では手出しすることができず、\n姉さんは連れ去られてしまった。"},
{"id": 511, "speaker": 3, "form": "dlg", "jp": "そして‥‥"},
{"id": 512, "speaker": 3, "form": "dlg", "jp": "それから姉さんも、父さんも、\n２度と帰ってくることはなかった。"},
{"id": 513, "speaker": 3, "form": "dlg", "jp": "また、あの日『通報』でボクたちを助けてくれた\n『若い男の人』が誰だったかも判らず‥‥"},
{"id": 514, "speaker": 3, "form": "dlg", "jp": "すべての謎が謎のまま、事件は未解決で終わり、"},
{"id": 515, "speaker": 3, "form": "dlg", "jp": "武器密売シンジケート『ルード』は\nその勢力を拡大し続けた。"},
{"id": 516, "speaker": 3, "form": "dlg", "jp": "そして、『ルード』による\nテロなどの無秩序な行為によって、"},
{"id": 517, "speaker": 3, "form": "dlg", "jp": "世界は荒廃していった。"},
{"id": 518, "speaker": 3, "form": "dlg", "jp": "すべての謎が謎のまま、事件は未解決で終わり、"},
{"id": 519, "speaker": 3, "form": "dlg", "jp": "武器密売シンジケート『ルード』は\nその勢力を拡大し続けた。"},
{"id": 520, "speaker": 3, "form": "dlg", "jp": "そして、『ルード』による\nテロなどの無秩序な行為によって、"},
{"id": 521, "speaker": 3, "form": "dlg", "jp": "世界は荒廃していった。"},
{"id": 522, "speaker": 3, "form": "dlg", "jp": "【頭を殴りつける！】"},
{"id": 523, "speaker": 3, "form": "dlg", "jp": "ボクは思いっきりソイツの頭を殴りつけた。"},
{"id": 524, "speaker": 3, "form": "dlg", "jp": "「ガツ～～ン！！」"},
{"id": 525, "speaker": 4, "form": "dlg", "jp": "「ウガァッ！！」"},
{"id": 526, "speaker": 4, "form": "dlg", "jp": "さすがに『頭』は『改造手術』を\n受けていないようで、"},
{"id": 527, "speaker": 4, "form": "dlg", "jp": "不意の攻撃で、大男はひるんだ。"},
{"id": 528, "speaker": 2, "form": "dlg", "jp": "「姉さん逃げてっ！！」"},
{"id": 529, "speaker": 2, "form": "dlg", "jp": "【足をける！】"},
{"id": 530, "speaker": 2, "form": "dlg", "jp": "ボクは思いっきりソイツの足をけりつけた。"},
{"id": 531, "speaker": 2, "form": "dlg", "jp": "「ガツ～～ン！！」"},
{"id": 532, "speaker": 2, "form": "dlg", "jp": "「痛っ！！」"},
{"id": 533, "speaker": 2, "form": "dlg", "jp": "ボクの足に激痛が走った。"},
{"id": 534, "speaker": 2, "form": "dlg", "jp": "（コイツ、足まで改造しているのかっ！？）"},
{"id": 535, "speaker": 4, "form": "dlg", "jp": "「ちくしょう！\n　このゴートさまをなめやがって！」"},
{"id": 536, "speaker": 19, "form": "dlg", "jp": "「うがーーっ！」"},
{"id": 537, "speaker": 2, "form": "dlg", "jp": "「うわあっ！！」"},
{"id": 538, "speaker": 2, "form": "dlg", "jp": "「ドス～～ン！」"},
{"id": 539, "speaker": 2, "form": "dlg", "jp": "（っつう！！）"},
{"id": 540, "speaker": 19, "form": "dlg", "jp": "「じゃあな‥‥」"},
{"id": 541, "speaker": 2, "form": "dlg", "jp": "（くくっ‥‥）"},
{"id": 542, "speaker": 11, "form": "dlg", "jp": "「コラ、"},
{"id": 543, "speaker": 11, "form": "dlg", "jp": "待てっ！！」"},
{"id": 544, "speaker": 11, "form": "dlg", "jp": "警察も人質をとられた状態では手も足もでないようだ。"},
{"id": 545, "speaker": 11, "form": "dlg", "jp": "ボクたちはただ姉さんが連れ去られるのを\n見守るしかないのか‥‥"},
{"id": 546, "speaker": 11, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 547, "speaker": 11, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 548, "speaker": 11, "form": "dlg", "jp": "‥‥ダメだっ！"},
{"id": 549, "speaker": 11, "form": "dlg", "jp": "姉さんを見捨てることはできない！"},
{"id": 550, "speaker": 11, "form": "dlg", "jp": "ボクはサイボーグを追って外に飛び出した。"},
{"id": 551, "speaker": 11, "form": "dlg", "jp": "「ナゴムくん、キケンだ！！」"},
{"id": 552, "speaker": 11, "form": "dlg", "jp": "警部さんの引き止める声が後ろで聞こえる。"},
{"id": 553, "speaker": 11, "form": "dlg", "jp": "しかし、立ち止まるわけにはいかない。"},
{"id": 554, "speaker": 11, "form": "dlg", "jp": "今‥‥"},
{"id": 555, "speaker": 11, "form": "dlg", "jp": "今止めないと‥‥"},
{"id": 556, "speaker": 11, "form": "dlg", "jp": "外に出ると、ゆっくりと歩いている\nサイボーグの姿があった‥‥"},
{"id": 557, "speaker": 11, "form": "dlg", "jp": "『不死身の体』と『人質』を持っているソイツは\nまったく何も警戒していない。"},
{"id": 558, "speaker": 2, "form": "dlg", "jp": "「待てっ！」"},
{"id": 559, "speaker": 2, "form": "dlg", "jp": "サイボーグはボクのことなど、\nまったく気にしていない。"},
{"id": 560, "speaker": 2, "form": "dlg", "jp": "後を追われることも、それによって\n行く先を知られることも"},
{"id": 561, "speaker": 2, "form": "dlg", "jp": "何も恐れていないのだろう‥‥"},
{"id": 562, "speaker": 11, "form": "dlg", "jp": "「ナゴムくん、今はあきらめるんだ！」"},
{"id": 563, "speaker": 11, "form": "dlg", "jp": "ダメだ‥‥"},
{"id": 564, "speaker": 11, "form": "dlg", "jp": "おびえてちゃダメだ‥‥"},
{"id": 565, "speaker": 11, "form": "dlg", "jp": "どうにかしないと‥‥"},
{"id": 566, "speaker": 11, "form": "dlg", "jp": "アイツに『弱点』はないのか？"},
{"id": 567, "speaker": 11, "form": "choice", "jp": "【『弱点』なんてない‥‥】"},
{"id": 568, "speaker": 11, "form": "choice", "jp": "【『弱点』はある！！】"},
{"id": 569, "speaker": 11, "form": "dlg", "jp": "【『弱点』はある！！】"},
{"id": 570, "speaker": 11, "form": "dlg", "jp": "さっき、アイツは頭を殴られて一瞬ひるんだ‥‥"},
{"id": 571, "speaker": 11, "form": "dlg", "jp": "つまり、アイツは『頭』は改造されていないんだ！"},
{"id": 572, "speaker": 11, "form": "dlg", "jp": "もう一度頭を攻撃すれば‥‥"},
{"id": 573, "speaker": 11, "form": "dlg", "jp": "もしかしたら！！"},
{"id": 574, "speaker": 11, "form": "dlg", "jp": "でも、さっきも大きなダメージを与えることは‥‥"},
{"id": 575, "speaker": 11, "form": "dlg", "jp": "たしかに、足は改造されてたけど‥‥"},
{"id": 576, "speaker": 11, "form": "dlg", "jp": "見る限り首から上は生身のようだ‥‥"},
{"id": 577, "speaker": 11, "form": "dlg", "jp": "もしかしたら！！"},
{"id": 578, "speaker": 11, "form": "dlg", "jp": "頭を攻撃すれば‥‥"},
{"id": 579, "speaker": 11, "form": "dlg", "jp": "でも、そんなことできるのか？"},
{"id": 580, "speaker": 11, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 581, "speaker": 11, "form": "dlg", "jp": "ええい！！"},
{"id": 582, "speaker": 11, "form": "dlg", "jp": "考えてる場合じゃない！"},
{"id": 583, "speaker": 11, "form": "dlg", "jp": "とにかく姉さんを助けるんだ！"},
{"id": 584, "speaker": 11, "form": "dlg", "jp": "ボクは姉さんを連れ去るソイツに駆け寄った。"},
{"id": 585, "speaker": 11, "form": "dlg", "jp": "一発だ‥‥"},
{"id": 586, "speaker": 11, "form": "dlg", "jp": "一発で決めてやる！"},
{"id": 587, "speaker": 11, "form": "dlg", "jp": "サイボーグは\nボクの足音などまったく気にしていない。"},
{"id": 588, "speaker": 11, "form": "dlg", "jp": "今だ‥‥　今なら確実に‥‥"},
{"id": 589, "speaker": 11, "form": "dlg", "jp": "ボクは右の拳に目一杯力を込めた。"},
{"id": 590, "speaker": 11, "form": "dlg", "jp": "そして‥‥"},
{"id": 591, "speaker": 2, "form": "dlg", "jp": "「くらえぇ～～～～～～～～～～～～～！」"},
{"id": 592, "speaker": 2, "form": "dlg", "jp": "「ガツ～～ン！！」"},
{"id": 593, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 594, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 595, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 596, "speaker": 2, "form": "dlg", "jp": "拳に確かな感触があった‥‥"},
{"id": 597, "speaker": 2, "form": "dlg", "jp": "しかし‥‥"},
{"id": 598, "speaker": 2, "form": "dlg", "jp": "目の前にはあのサイボーグの姿は見えない‥‥"},
{"id": 599, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥"},
{"id": 600, "speaker": 2, "form": "dlg", "jp": "逃げられた？‥‥‥‥"},
{"id": 601, "speaker": 2, "form": "dlg", "jp": "「ドサッ」"},
{"id": 602, "speaker": 2, "form": "dlg", "jp": "前方で重たい物の落下音がひびいた。"},
{"id": 603, "speaker": 2, "form": "dlg", "jp": "‥‥‥！？"},
{"id": 604, "speaker": 2, "form": "dlg", "jp": "ボクは恐る恐るその音の方を見た‥‥"},
{"id": 605, "speaker": 2, "form": "dlg", "jp": "そこにはあの『サイボーグ』が、うつぶせに倒れていた。"},
{"id": 606, "speaker": 11, "form": "dlg", "jp": "「は、早く取り押さえるんだ！！」"},
{"id": 607, "speaker": 11, "form": "dlg", "jp": "まさか‥‥！！"},
{"id": 608, "speaker": 11, "form": "dlg", "jp": "ボクがやったのか？"},
{"id": 609, "speaker": 11, "form": "dlg", "jp": "『サイボーグ』は２Ｍほど前で倒れている‥‥"},
{"id": 610, "speaker": 11, "form": "dlg", "jp": "「ドタドタドタドタ‥‥」"},
{"id": 611, "speaker": 11, "form": "dlg", "jp": "警察があわただしく、『サイボーグ』を取り囲む‥‥"},
{"id": 612, "speaker": 11, "form": "dlg", "jp": "「す、すごいな‥‥」"},
{"id": 613, "speaker": 2, "form": "dlg", "jp": "「アレはボクが？」"},
{"id": 614, "speaker": 11, "form": "dlg", "jp": "「ああ、火事場のクソ力ってヤツかな？」"},
{"id": 615, "speaker": 3, "form": "dlg", "jp": "「ナゴム‥‥‥‥」"},
{"id": 616, "speaker": 2, "form": "dlg", "jp": "「姉さん！」"},
{"id": 617, "speaker": 2, "form": "dlg", "jp": "「大丈夫？」"},
{"id": 618, "speaker": 3, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 619, "speaker": 19, "form": "dlg", "jp": "「ウググググ‥‥」"},
{"id": 620, "speaker": 12, "form": "dlg", "jp": "「ウワッ！　目を覚ました！」"},
{"id": 621, "speaker": 2, "form": "dlg", "jp": "「頭、頭が弱点です！！」"},
{"id": 622, "speaker": 11, "form": "dlg", "jp": "「頭に銃をつきつけるんだ！」"},
{"id": 623, "speaker": 19, "form": "dlg", "jp": "「お、おのれ‥‥」"},
{"id": 624, "speaker": 19, "form": "dlg", "jp": "さすがのサイボーグも、頭に拳銃をつきつけられては\n抵抗することができないようだ‥‥"},
{"id": 625, "speaker": 19, "form": "dlg", "jp": "サイボーグ『ゴート』は捕らえられ、\nボクは、２度目の命拾いをした。"},
{"id": 626, "speaker": 19, "form": "dlg", "jp": "しかし、ただ命拾いをしただけで、\n何かが解決したわけではなかった。"},
{"id": 627, "speaker": 19, "form": "dlg", "jp": "『行方不明の父親』‥‥"},
{"id": 628, "speaker": 19, "form": "dlg", "jp": "その行方を探すためにボクたち姉弟を狙う\n『国際的犯罪組織』‥‥"},
{"id": 629, "speaker": 19, "form": "dlg", "jp": "ボクは多くの謎を夏休みの宿題として\n抱えることになってしまった。"},
{"id": 630, "speaker": 19, "form": "dlg", "jp": "【『弱点』なんてない‥‥】"},
{"id": 631, "speaker": 11, "form": "dlg", "jp": "「無茶はよすんだ！」"},
{"id": 632, "speaker": 11, "form": "dlg", "jp": "『無茶』‥‥"},
{"id": 633, "speaker": 11, "form": "dlg", "jp": "そうだ‥‥\n今ボクが行動を起こすのは『無茶』すぎる‥‥"},
{"id": 634, "speaker": 11, "form": "dlg", "jp": "とにかく、ここは一旦引き下がるしか‥‥"},
{"id": 635, "speaker": 11, "form": "dlg", "jp": "「後のことはワレワレに任せるんだ‥‥」"},
{"id": 636, "speaker": 11, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 637, "speaker": 11, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 638, "speaker": 11, "form": "dlg", "jp": "ボクたちは姉さんを連れ去るサイボーグの\n後ろ姿をただ黙って見守るしかなかった‥‥"},
{"id": 639, "speaker": 2, "form": "dlg", "jp": "（‥‥！？）"},
{"id": 640, "speaker": 11, "form": "dlg", "jp": "「何っ！？」"},
{"id": 641, "speaker": 19, "form": "dlg", "jp": "「おのれっ！！」"},
{"id": 642, "speaker": 4, "form": "dlg", "jp": "「リツコ、離れて！」"},
{"id": 643, "speaker": 4, "form": "dlg", "jp": "「いくぞっ！」"},
{"id": 644, "speaker": 19, "form": "dlg", "jp": "「ま、まさかっ！」"},
{"id": 645, "speaker": 19, "form": "dlg", "jp": "「キサマも‥‥！」"},
{"id": 646, "speaker": 19, "form": "dlg", "jp": "「バキッ！」"},
{"id": 647, "speaker": 19, "form": "dlg", "jp": "「ゴロゴロ‥」"},
{"id": 648, "speaker": 19, "form": "dlg", "jp": "「うお～～～っ！」"},
{"id": 649, "speaker": 4, "form": "dlg", "jp": "「頭が弱点です！」"},
{"id": 650, "speaker": 4, "form": "dlg", "jp": "「はやくっ！」"},
{"id": 651, "speaker": 11, "form": "dlg", "jp": "「あ、ああ！」"},
{"id": 652, "speaker": 11, "form": "dlg", "jp": "「なんだ、頭は改造されてないのか？」"},
{"id": 653, "speaker": 19, "form": "dlg", "jp": "「お、おのれ‥‥」"},
{"id": 654, "speaker": 11, "form": "dlg", "jp": "「泣き言は留置所で聞いてやろう！」"},
{"id": 655, "speaker": 11, "form": "dlg", "jp": "さすがのサイボーグも、頭に拳銃をつきつけられては\n抵抗することができないようだ‥‥"},
{"id": 656, "speaker": 2, "form": "dlg", "jp": "（それにしてもスゴイ人だ‥‥）"},
{"id": 657, "speaker": 2, "form": "dlg", "jp": "（この人もサイボーグなんだろうか？）"},
{"id": 658, "speaker": 2, "form": "dlg", "jp": "（うん？）"},
{"id": 659, "speaker": 2, "form": "dlg", "jp": "「あの人がいなくなった！！」"},
{"id": 660, "speaker": 11, "form": "dlg", "jp": "「なんだってっ！？」"},
{"id": 661, "speaker": 11, "form": "dlg", "jp": "「オイ！　重要参考人だぞ！」"},
{"id": 662, "speaker": 3, "form": "dlg", "jp": "「行ってしまったわ‥‥」"},
{"id": 663, "speaker": 3, "form": "dlg", "jp": "「ブロロロロ‥‥！」"},
{"id": 664, "speaker": 11, "form": "dlg", "jp": "「追うんだ！！」"},
{"id": 665, "speaker": 20, "form": "dlg", "jp": "「警部、バイクがっ！！」"},
{"id": 666, "speaker": 11, "form": "dlg", "jp": "「早く追うんだ！！」"},
{"id": 667, "speaker": 11, "form": "dlg", "jp": "こうして、\n突如あらわれた謎の青年のおかげで、"},
{"id": 668, "speaker": 11, "form": "dlg", "jp": "サイボーグ『ゴート』は捕らえられ、\nボクたちは命拾いをした。"},
{"id": 669, "speaker": 11, "form": "dlg", "jp": "しかし、ただ命拾いをしただけで、\n何かが解決したわけではなかった。"},
{"id": 670, "speaker": 11, "form": "dlg", "jp": "『行方不明の父親』‥‥"},
{"id": 671, "speaker": 11, "form": "dlg", "jp": "その行方を探すためにボクたち姉弟を狙う\n『国際的犯罪組織』‥‥"},
{"id": 672, "speaker": 11, "form": "dlg", "jp": "そして、サイボーグを素手で倒した謎の青年‥‥"},
{"id": 673, "speaker": 11, "form": "dlg", "jp": "ボクは多くの謎を夏休みの宿題として\n抱えることになってしまった。"},
{"id": 674, "speaker": 11, "form": "dlg", "jp": "こうして、\n突如あらわれた謎の青年のおかげで、"},
{"id": 675, "speaker": 11, "form": "dlg", "jp": "サイボーグ『ゴート』は捕らえられ、\nボクたちは、２度目の命拾いをした。"},
{"id": 676, "speaker": 11, "form": "dlg", "jp": "しかし、ただ命拾いをしただけで、\n何かが解決したわけではなかった。"},
{"id": 677, "speaker": 11, "form": "dlg", "jp": "それどころか、事件はだんだんと大きく\n複雑になっていっているようだった。"},
{"id": 678, "speaker": 11, "form": "dlg", "jp": "『行方不明の父親』‥‥"},
{"id": 679, "speaker": 11, "form": "dlg", "jp": "その行方を探すためにボクたち姉弟を狙う\n『国際的犯罪組織』‥‥"},
{"id": 680, "speaker": 11, "form": "dlg", "jp": "ボクたちのピンチを警察に通報した謎の人物‥‥"},
{"id": 681, "speaker": 11, "form": "dlg", "jp": "そして、サイボーグを素手で倒した謎の青年‥‥"},
{"id": 682, "speaker": 11, "form": "dlg", "jp": "ボクは多くの謎を夏休みの宿題として\n抱えることになってしまった。"},
{"id": 683, "speaker": 11, "form": "dlg", "jp": "失敗の原因は素早い判断ができなかった事。\n何を優先するべきかを常に考えておけばこんな事には‥"},
{"id": 684, "speaker": 11, "form": "dlg", "jp": "失敗の原因はあきらめた事。\n主人公は何があってもあきらめてはいけない。"},
{"id": 685, "speaker": 11, "form": "dlg", "jp": "失敗の原因は推理力不足。\nヤツにも弱点は必ずある。"}
]
