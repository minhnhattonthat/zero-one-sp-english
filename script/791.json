[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／１８／ＡＭ０８：４０"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "結局、２人はそのままボクの部屋に泊まった。"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 3, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～！！」"},
{"id": 4, "speaker": 3, "form": "dlg", "jp": "「ツトムくんよ～～！」"},
{"id": 5, "speaker": 3, "form": "dlg", "jp": "「起きてるんでしょ～う？」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「ああ、ちょっと待って！」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "（オイ、起きてくれよ！）"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 10, "speaker": 29, "form": "dlg", "jp": "「オハヨ‥‥」"},
{"id": 11, "speaker": 29, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "（シッ！！）"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "（声を出さないでくれよ！）"},
{"id": 16, "speaker": 29, "form": "dlg", "jp": "（ゴメン、ゴメン‥‥）"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "（お客が来たから‥‥）"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "（見つからないようにしてくれよ！）"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "（わかったわ‥‥）"},
{"id": 20, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～！！」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「今行くよ！」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 25, "speaker": 13, "form": "dlg", "jp": "「よっ！」"},
{"id": 26, "speaker": 13, "form": "dlg", "jp": "「準備は出来てるか？」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「準備ってなんの？」"},
{"id": 28, "speaker": 14, "form": "dlg", "jp": "「今日は『プール』に行くって言っただろう？」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「あっ、そうだったな‥‥」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "（‥‥コイツら、\n　まだ『アイコのコト』を知らないんだ！）"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "（‥‥コイツら、\n　まだ『長尾のコト』を知らないんだ！）"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "（‥‥コイツら、\n　まだ『堤さんのコト』を知らないんだ！）"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「ちょっと、待ってて」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「準備してくるから‥‥」"},
{"id": 35, "speaker": 14, "form": "dlg", "jp": "「早くしろよな！」"},
{"id": 36, "speaker": 14, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 37, "speaker": 14, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 38, "speaker": 14, "form": "dlg", "jp": "「バタン！」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "（どうしよう？）"},
{"id": 40, "speaker": 31, "form": "dlg", "jp": "（どうしたんだ、朝っぱらから？）"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "（友達が『プールに行こう』って‥‥）"},
{"id": 42, "speaker": 31, "form": "dlg", "jp": "（そんなことか？）"},
{"id": 43, "speaker": 31, "form": "dlg", "jp": "（行ってくればいいじゃないか？）"},
{"id": 44, "speaker": 2, "form": "dlg", "jp": "（でも‥‥）"},
{"id": 45, "speaker": 29, "form": "dlg", "jp": "（そうね‥‥）"},
{"id": 46, "speaker": 29, "form": "dlg", "jp": "（できるだけ、\n　『普通』の暮らしをした方がいいわね‥‥）"},
{"id": 47, "speaker": 29, "form": "dlg", "jp": "（いってらっしゃい！）"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "（わかった‥‥）"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "２００５／０８／１８／ＡＭ１０：３０"},
{"id": 50, "speaker": 14, "form": "dlg", "jp": "「ああ～\n　夏休みもあと少しだな‥‥」"},
{"id": 51, "speaker": 14, "form": "dlg", "jp": "「なんかこのまま、\n　たいしたことなく２学期なんだろうなぁ～」"},
{"id": 52, "speaker": 13, "form": "dlg", "jp": "「いいんじゃない、それで？」"},
{"id": 53, "speaker": 13, "form": "dlg", "jp": "「ナゴムみたいに色々あるのも‥‥」"},
{"id": 54, "speaker": 13, "form": "choice", "jp": "「ちぇっ、ヒドイなぁ～」"},
{"id": 55, "speaker": 13, "form": "choice", "jp": "「ホントそう思うよ‥‥」"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "「ちぇっ、ヒドイなぁ～」"},
{"id": 57, "speaker": 14, "form": "dlg", "jp": "「ツトム、ちょっとは気をつかえよ！」"},
{"id": 58, "speaker": 13, "form": "dlg", "jp": "「ゴメン、ゴメン‥‥」"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "「ホントそう思うよ‥‥」"},
{"id": 60, "speaker": 14, "form": "dlg", "jp": "「まあ、オマエは特別だよ！」"},
{"id": 61, "speaker": 13, "form": "dlg", "jp": "「日頃の行ないが悪いんじゃないか？」"},
{"id": 62, "speaker": 14, "form": "dlg", "jp": "「結局オレたち、\n　また男ばっかでプールに来てるんだな」"},
{"id": 63, "speaker": 13, "form": "dlg", "jp": "「ヘヘヘヘヘ‥‥」"},
{"id": 64, "speaker": 13, "form": "dlg", "jp": "「さみし～い！」"},
{"id": 65, "speaker": 14, "form": "dlg", "jp": "「そういえば、こないだここに来た時にいた女の子、\n　かわいかったよなぁ～」"},
{"id": 66, "speaker": 13, "form": "dlg", "jp": "「あ、あの外国人のコ？」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "（ジーンのことだ‥‥）"},
{"id": 68, "speaker": 14, "form": "dlg", "jp": "「また、来ないかなぁ？」"},
{"id": 69, "speaker": 13, "form": "dlg", "jp": "「オイ、\n　アレはそうじゃないのか？」"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "「‥‥へっ？」"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "そこには家にいるハズの\n『ジーン』と『ケネス』の姿があった。"},
{"id": 72, "speaker": 13, "form": "dlg", "jp": "「オイ、コッチに来るぞ！」"},
{"id": 73, "speaker": 14, "form": "dlg", "jp": "「ウソッ！？」"},
{"id": 74, "speaker": 29, "form": "dlg", "jp": "「コンニチハ‥‥」"},
{"id": 75, "speaker": 14, "form": "dlg", "jp": "「コ、コンニチハ‥‥」"},
{"id": 76, "speaker": 29, "form": "dlg", "jp": "「ナゴムのお友達？」"},
{"id": 77, "speaker": 14, "form": "dlg", "jp": "「ハ、ハイ‥‥」"},
{"id": 78, "speaker": 13, "form": "dlg", "jp": "「オイ、オマエの知り合いなのか？」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「えっ‥‥」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「あの‥‥」"},
{"id": 81, "speaker": 31, "form": "dlg", "jp": "「ナゴムくんのお父さんに世話になってたんだよ」"},
{"id": 82, "speaker": 31, "form": "dlg", "jp": "「オレたち‥‥」"},
{"id": 83, "speaker": 31, "form": "dlg", "jp": "「なあ、『ナゴムくん』‥‥！」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「あ、そう、そうだよ‥‥」"},
{"id": 85, "speaker": 14, "form": "dlg", "jp": "「どうして、\n　こないだは紹介してくれなかったんだよ！」"},
{"id": 86, "speaker": 14, "form": "choice", "jp": "「忘れてたんだ！」"},
{"id": 87, "speaker": 14, "form": "choice", "jp": "「シンちゃん、目が血走ってたし‥‥」"},
{"id": 88, "speaker": 14, "form": "choice", "jp": "「必要ないと思ってさ‥‥」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「忘れてたんだ！」"},
{"id": 90, "speaker": 14, "form": "dlg", "jp": "「‥‥オマエは『忘れ物番長』か！」"},
{"id": 91, "speaker": 14, "form": "dlg", "jp": "「どうして、こんな重要なこと忘れるんだよ！！」"},
{"id": 92, "speaker": 31, "form": "dlg", "jp": "「ナゴムくんの『忘れ物』は\n　南米でも有名だから‥‥」"},
{"id": 93, "speaker": 31, "form": "dlg", "jp": "「そうだろ？」"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "「そ、そうね‥‥」"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "「そのくせ、くだらないことは\n　いつまでも覚えてて」"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "「ぐずぐずしてるけど‥‥」"},
{"id": 97, "speaker": 13, "form": "dlg", "jp": "「それは言えてる！」"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "「シンちゃん、目が血走ってたし‥‥」"},
{"id": 99, "speaker": 14, "form": "dlg", "jp": "「どういうことだよ！」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "「鼻血出しちゃうだろう？」"},
{"id": 101, "speaker": 2, "form": "choice", "jp": "「ジーンなんか紹介したら‥‥」"},
{"id": 102, "speaker": 2, "form": "choice", "jp": "「ケネスなんか紹介したら‥‥」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「ジーンなんか紹介したら‥‥」"},
{"id": 104, "speaker": 13, "form": "dlg", "jp": "「それは言えてる！」"},
{"id": 105, "speaker": 14, "form": "dlg", "jp": "「そんなわけないだろう！」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「ケネスなんか紹介したら‥‥」"},
{"id": 107, "speaker": 13, "form": "dlg", "jp": "「それは言えてる！」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "「必要ないと思ってさ‥‥」"},
{"id": 109, "speaker": 14, "form": "dlg", "jp": "「勝手に決めるなよ！」"},
{"id": 110, "speaker": 14, "form": "dlg", "jp": "「そんなことだから、\n　いつまでも日本は島国根性って言われるんだよ！」"},
{"id": 111, "speaker": 13, "form": "dlg", "jp": "「それは言えてる！」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「わかったよ」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「紹介するよ‥‥」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「コッチが『ジーン・ライト』‥‥」"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "「よろしく‥‥」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「で、コッチが\n　『ケネス・アーノルド』‥‥」"},
{"id": 117, "speaker": 31, "form": "dlg", "jp": "「オッス！\n　オラ、『ケネス』だ‥‥」"},
{"id": 118, "speaker": 13, "form": "dlg", "jp": "「ププププ‥‥」"},
{"id": 119, "speaker": 13, "form": "dlg", "jp": "「おもしろい外国人だなぁ‥‥」"},
{"id": 120, "speaker": 31, "form": "dlg", "jp": "「サンキュー！」"},
{"id": 121, "speaker": 31, "form": "dlg", "jp": "「いやぁ、それにしても\n　日本のプールはキレイだね‥‥」"},
{"id": 122, "speaker": 31, "form": "dlg", "jp": "「南米じゃあ、プールなんて‥‥」"},
{"id": 123, "speaker": 31, "form": "dlg", "jp": "「一部の金持ちと日本人と結婚した女ぐらいしか\n　入ること出来ないからな‥‥」"},
{"id": 124, "speaker": 31, "form": "dlg", "jp": "ケネスがシンちゃんたちと話をしている間に\nボクはジーンにテレパシーを送った。"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "（どうしてここに‥‥？）"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "（アナタ１人にしておけないでしょう！）"},
{"id": 127, "speaker": 29, "form": "dlg", "jp": "（そんなことより‥‥）"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "（このプールに『超能力者』がいるわよ‥‥）"},
{"id": 129, "speaker": 29, "form": "choice", "jp": "（まさか‥‥）"},
{"id": 130, "speaker": 29, "form": "choice", "jp": "（どうしてわかるの？）"},
{"id": 131, "speaker": 29, "form": "choice", "jp": "（えっ、誰？）"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "（まさか‥‥）"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "（どうしてわかるの？）"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "（えっ、誰？）"},
{"id": 135, "speaker": 29, "form": "dlg", "jp": "（誰かは分からないわ‥‥）"},
{"id": 136, "speaker": 29, "form": "dlg", "jp": "（でも‥‥）"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "（私の能力が『感じる』のよ‥‥）"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "（ここに私たち以外の『超能力者がいる』って‥‥）"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "（それが本当だとしたら‥‥）"},
{"id": 140, "speaker": 29, "form": "dlg", "jp": "（この町にいる私たち以外の超能力者‥‥）"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "（つまり‥‥）"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "（昨日の『通り魔』！！）"},
{"id": 143, "speaker": 29, "form": "dlg", "jp": "（かもしれないわね‥‥）"},
{"id": 144, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん‥‥！」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「アイコ！」"},
{"id": 146, "speaker": 15, "form": "dlg", "jp": "「昨日はゴメンね‥‥」"},
{"id": 147, "speaker": 15, "form": "dlg", "jp": "「お礼も言わずに逃げ出すようなことをして‥‥」"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「あ、あ、気にしてないから‥‥」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「それより、\n　ここじゃぁなんだし場所をかえないか？」"},
{"id": 150, "speaker": 15, "form": "dlg", "jp": "「いいわよ‥‥」"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「ちょっとコイツと話があるから‥‥」"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "「どうぞ‥‥」"},
{"id": 153, "speaker": 29, "form": "dlg", "jp": "「いってらっしゃい‥‥」"},
{"id": 154, "speaker": 29, "form": "dlg", "jp": "ボクはアイコを更衣室の方へ連れて行った。"},
{"id": 155, "speaker": 15, "form": "dlg", "jp": "「本当に昨日はありがとう」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 157, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん‥‥怒ってない？」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「別に‥‥」"},
{"id": 159, "speaker": 15, "form": "dlg", "jp": "「たぶん、私、気が動転していたんだ‥‥」"},
{"id": 160, "speaker": 15, "form": "dlg", "jp": "「おかしい話だけど‥‥」"},
{"id": 161, "speaker": 15, "form": "dlg", "jp": "「あの時、ナゴムちゃんが、\n　怪物みたいに見えたんだ‥‥」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「あ、その話なんだけど‥‥」"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「誰かに話したりした？」"},
{"id": 164, "speaker": 15, "form": "dlg", "jp": "「心配するといやだから、\n　家族にもまだ‥‥」"},
{"id": 165, "speaker": 15, "form": "dlg", "jp": "「でも、\n　警察には言っておいた方がいいわよね？」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "「あ～\n　‥‥‥‥」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「悪いけど、警察には‥‥」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「‥‥って、いうより、\n　誰にも内緒にしてもらえないかな？」"},
{"id": 169, "speaker": 15, "form": "dlg", "jp": "「どうして？」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「理由は言えないけど‥‥」"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "「‥‥頼む！」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「この通り！！」"},
{"id": 173, "speaker": 15, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 174, "speaker": 15, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 175, "speaker": 15, "form": "dlg", "jp": "「『命の恩人』がそう言うのなら‥‥」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「ありがとう！」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "（よし、これでＯＫだ！）"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「じゃあ、戻ろうか？」"},
{"id": 179, "speaker": 16, "form": "dlg", "jp": "「常光寺くん！」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "「長尾！」"},
