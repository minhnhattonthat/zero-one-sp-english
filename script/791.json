{"id": 566, "speaker": 2, "form": "dlg", "jp": "「この通り！！」"},
{"id": 567, "speaker": 18, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 568, "speaker": 18, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 569, "speaker": 18, "form": "dlg", "jp": "「『私の命の恩人』の頼みなら‥‥」"},
{"id": 570, "speaker": 2, "form": "dlg", "jp": "「ありがとう！」"},
{"id": 571, "speaker": 2, "form": "dlg", "jp": "（よし、これでＯＫだ！）"},
{"id": 572, "speaker": 2, "form": "dlg", "jp": "「じゃあ、戻ろうか？」"},
{"id": 573, "speaker": 13, "form": "dlg", "jp": "「なんだぁ？\n　２人で消えたりして‥‥」"},
{"id": 574, "speaker": 13, "form": "dlg", "jp": "「怪しいぞ、オマエら‥‥」"},
{"id": 575, "speaker": 2, "form": "dlg", "jp": "「なんでもないよ！」"},
{"id": 576, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 577, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥\n　ナゴム、帰るわよ！」"},
{"id": 578, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 579, "speaker": 29, "form": "dlg", "jp": "「話があるの‥‥」"},
{"id": 580, "speaker": 29, "form": "choice", "jp": "（まさか、バレた！）"},
{"id": 581, "speaker": 29, "form": "choice", "jp": "（いや、そんなハズはない！）"},
{"id": 582, "speaker": 2, "form": "dlg", "jp": "（まさか、バレた！）"},
{"id": 583, "speaker": 2, "form": "dlg", "jp": "（たしか『ジーン』は遠くの音を聞くことが！）"},
{"id": 584, "speaker": 29, "form": "dlg", "jp": "（‥‥‥‥）"},
{"id": 585, "speaker": 29, "form": "dlg", "jp": "（そう！）"},
{"id": 586, "speaker": 29, "form": "dlg", "jp": "（聞こえたわ‥‥）"},
{"id": 587, "speaker": 2, "form": "dlg", "jp": "（いや、そんなハズはない！）"},
{"id": 588, "speaker": 2, "form": "dlg", "jp": "（ここまで声が聞こえるとは思えない）"},
{"id": 589, "speaker": 2, "form": "dlg", "jp": "（じゃぁ‥‥）"},
{"id": 590, "speaker": 2, "form": "dlg", "jp": "（もう１人の『超能力者』が現れたとか？）"},
{"id": 591, "speaker": 29, "form": "dlg", "jp": "（違うわよ‥‥！）"},
{"id": 592, "speaker": 29, "form": "dlg", "jp": "（私の『能力』を忘れたの？）"},
{"id": 593, "speaker": 29, "form": "dlg", "jp": "（遠くのものを見たり聞いたりできるのよ！）"},
{"id": 594, "speaker": 2, "form": "dlg", "jp": "（しまった！）"},
{"id": 595, "speaker": 31, "form": "dlg", "jp": "「悪いなぁ、オレたちナゴムくんと\n　込み入った話があるんで‥‥」"},
{"id": 596, "speaker": 14, "form": "dlg", "jp": "「えっ帰っちゃうのぉ～～」"},
{"id": 597, "speaker": 29, "form": "dlg", "jp": "「またね！」"},
{"id": 598, "speaker": 31, "form": "dlg", "jp": "「じゃぁな‥‥」"},
{"id": 599, "speaker": 31, "form": "dlg", "jp": "ボクは２人と一緒に帰ることになった。"},
{"id": 600, "speaker": 31, "form": "dlg", "jp": "そして‥‥"},
{"id": 601, "speaker": 29, "form": "dlg", "jp": "「キャッ！」"},
{"id": 602, "speaker": 29, "form": "dlg", "jp": "更衣室で着替えていると、\nとなりの更衣室から悲鳴が聞こえた。"},
{"id": 603, "speaker": 2, "form": "dlg", "jp": "（『ジーン』の声だ！！）"},
{"id": 604, "speaker": 2, "form": "dlg", "jp": "ボクは隣の更衣室へと急いだ。"},
{"id": 605, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 606, "speaker": 29, "form": "dlg", "jp": "「‥‥‥！」"},
