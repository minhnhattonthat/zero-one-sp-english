{"id": 200, "speaker": 16, "form": "dlg", "jp": "「でも、\n　警察には言っておいた方がいいわよね？」"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "「あ～\n　‥‥‥‥」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「悪いけど、警察には‥‥」"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "「‥‥って、いうより、\n　誰にも内緒にしてもらえないかな？」"},
{"id": 204, "speaker": 16, "form": "dlg", "jp": "「どうして？」"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "「理由は言えないけど‥‥」"},
{"id": 206, "speaker": 2, "form": "dlg", "jp": "「‥‥頼む！」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「この通り！！」"},
{"id": 208, "speaker": 16, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 209, "speaker": 16, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 210, "speaker": 16, "form": "dlg", "jp": "「『命の恩人クン』に\n　そこまで言われるのなら‥‥」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「ありがとう！」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "（よし、これでＯＫだ！）"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "「じゃあ、戻ろうか？」"},
{"id": 214, "speaker": 18, "form": "dlg", "jp": "「常光寺くん‥‥」"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "「堤さん‥‥！」"},
{"id": 216, "speaker": 18, "form": "dlg", "jp": "「昨日はごめんなさい‥‥」"},
{"id": 217, "speaker": 18, "form": "dlg", "jp": "「お礼も言わずに逃げ出しちゃったりして‥‥」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「あ、あ、気にしてないから‥‥」"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "「それより、\n　ここじゃぁなんだし場所をかえないか？」"},
{"id": 220, "speaker": 18, "form": "dlg", "jp": "「いいけど‥‥」"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "「ちょっと彼女と話があるんで‥‥」"},
{"id": 222, "speaker": 29, "form": "dlg", "jp": "「どうぞ‥‥」"},
{"id": 223, "speaker": 29, "form": "dlg", "jp": "「いってらっしゃい‥‥」"},
{"id": 224, "speaker": 29, "form": "dlg", "jp": "ボクは堤さんを更衣室の方へ連れて行った。"},
{"id": 225, "speaker": 18, "form": "dlg", "jp": "「本当に昨日はありがとう」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 227, "speaker": 18, "form": "dlg", "jp": "「常光寺くん\n　怒って‥‥ない‥‥？」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「別に‥‥」"},
{"id": 229, "speaker": 18, "form": "dlg", "jp": "「私、あの時どうかしてたの‥‥」"},
{"id": 230, "speaker": 18, "form": "dlg", "jp": "「おかしい話だけど‥‥」"},
{"id": 231, "speaker": 18, "form": "dlg", "jp": "「あの時、常光寺くんが、\n　怪物みたいに見えたの‥‥」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「あ、その話なんだけど‥‥」"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "「誰かに話したりした？」"},
{"id": 234, "speaker": 18, "form": "dlg", "jp": "「心配するといやだから、\n　誰にもまだ‥‥」"},
{"id": 235, "speaker": 18, "form": "dlg", "jp": "「でも、\n　警察には言っておいた方がいいのかな？」"},
{"id": 236, "speaker": 2, "form": "dlg", "jp": "「あ～\n　‥‥‥‥」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「悪いけど、警察には‥‥」"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "「‥‥って、言うより、\n　誰にも内緒にしてもらえないかな？」"},
{"id": 239, "speaker": 18, "form": "dlg", "jp": "「どうして‥‥？」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「理由は言えないけど‥‥」"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "「‥‥頼む！」"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "「この通り！！」"},
{"id": 243, "speaker": 18, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 244, "speaker": 18, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 245, "speaker": 18, "form": "dlg", "jp": "「『私の命の恩人』の頼みなら‥‥」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「ありがとう！」"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "（よし、これでＯＫだ！）"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "「じゃあ、戻ろうか？」"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "（『アイコを殺した犯人』が‥‥）"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "（『長尾を殺した犯人』が‥‥）"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "（『堤さんを殺した犯人』が‥‥）"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "（昨日の『通り魔』！？）"},
{"id": 253, "speaker": 29, "form": "dlg", "jp": "（かもしれないわね‥‥）"},
{"id": 254, "speaker": 31, "form": "dlg", "jp": "「日本の女の子って\n　もっと色が白いと思ってたよ！」"},
{"id": 255, "speaker": 13, "form": "dlg", "jp": "「白いのも黒いのもいるんだよ！」"},
{"id": 256, "speaker": 13, "form": "dlg", "jp": "「ナゴムのお姉さんは白いだろう？」"},
{"id": 257, "speaker": 31, "form": "dlg", "jp": "「そうだね！」"},
{"id": 258, "speaker": 14, "form": "dlg", "jp": "「オレも南米の水着って\n　もっと小さいんだと‥‥」"},
{"id": 259, "speaker": 31, "form": "dlg", "jp": "「ガハハハハ‥‥」"},
{"id": 260, "speaker": 31, "form": "dlg", "jp": "「それは水着じゃないよ！」"},
{"id": 261, "speaker": 31, "form": "dlg", "jp": "「サンバの衣装だよ！」"},
{"id": 262, "speaker": 31, "form": "dlg", "jp": "「さすがにあんなのじゃ泳げないよ！」"},
{"id": 263, "speaker": 31, "form": "dlg", "jp": "「ガハハハハ‥‥」"},
{"id": 264, "speaker": 31, "form": "dlg", "jp": "「オマエら面白いなぁ～」"},
{"id": 265, "speaker": 31, "form": "dlg", "jp": "いつの間にか、ケネスとシンちゃんたちは\n仲良くなっていた。"},
{"id": 266, "speaker": 29, "form": "dlg", "jp": "「ケネス、帰るわよ！」"},
{"id": 267, "speaker": 31, "form": "dlg", "jp": "「なんだ、もう帰るのか？」"},
{"id": 268, "speaker": 14, "form": "dlg", "jp": "「えっ帰っちゃうのぉ～～」"},
{"id": 269, "speaker": 29, "form": "dlg", "jp": "「またね！」"},
{"id": 270, "speaker": 31, "form": "dlg", "jp": "「オイ待てよ！」"},
{"id": 271, "speaker": 31, "form": "dlg", "jp": "２人は更衣室の方へと立ち去った。"},
{"id": 272, "speaker": 13, "form": "dlg", "jp": "「さすが、世界的な工学博士だな‥‥」"},
{"id": 273, "speaker": 13, "form": "dlg", "jp": "「『外国人』の知り合いがいるなんて‥‥」"},
{"id": 274, "speaker": 2, "form": "dlg", "jp": "「それってスゴイことなのかなぁ～」"},
{"id": 275, "speaker": 14, "form": "dlg", "jp": "「スゴイよ！」"},
{"id": 276, "speaker": 14, "form": "dlg", "jp": "「あんな美人の知り合いがいるなんて！」"},
{"id": 277, "speaker": 13, "form": "dlg", "jp": "「そうそう、それに\n　ナゴムんちはお姉さんも美人だし‥‥」"},
{"id": 278, "speaker": 14, "form": "dlg", "jp": "「それじゃぁ、\n　オレたちも帰ろうか？」"},
{"id": 279, "speaker": 13, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 280, "speaker": 29, "form": "dlg", "jp": "「キャッ！」"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "（『ジーン』の声だ！！）"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "ボクたちは更衣室へと急いだ。"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 284, "speaker": 29, "form": "dlg", "jp": "「‥‥‥！」"},
{"id": 285, "speaker": 14, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 286, "speaker": 29, "form": "dlg", "jp": "「べ、別に‥‥」"},
{"id": 287, "speaker": 14, "form": "dlg", "jp": "「‥‥『別に』って？」"},
{"id": 288, "speaker": 29, "form": "dlg", "jp": "「ちょっと、ゴキブリが‥‥」"},
{"id": 289, "speaker": 14, "form": "dlg", "jp": "「ふ～ん、しっかりしてそうに見えて\n　ゴキブリがコワイんだ？」"},
{"id": 290, "speaker": 29, "form": "dlg", "jp": "「ナゴム、ちょっと来て‥‥」"},
{"id": 291, "speaker": 29, "form": "choice", "jp": "「なんだよ‥‥？」"},
{"id": 292, "speaker": 29, "form": "choice", "jp": "「イヤだぜ、ゴキブリ退治なんて‥‥」"},
{"id": 293, "speaker": 29, "form": "choice", "jp": "「ゴキブリ退治はまかせなさい！」"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "「なんだよ‥‥？」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "「イヤだぜ、ゴキブリ退治なんて‥‥」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「ゴキブリ退治はまかせなさい！」"},
{"id": 297, "speaker": 29, "form": "dlg", "jp": "「いいから、早く！！」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "（なんだよぉ！）"},
{"id": 299, "speaker": 29, "form": "dlg", "jp": "（あらわれたのよ！）"},
{"id": 300, "speaker": 29, "form": "choice", "jp": "（『超能力者』がかい？）"},
{"id": 301, "speaker": 29, "form": "choice", "jp": "（『ゴキブリ』だろう？）"},
{"id": 302, "speaker": 29, "form": "choice", "jp": "（『ラスカル』にかい？）"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "（『超能力者』がかい？）"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "（『ゴキブリ』だろう？）"},
{"id": 305, "speaker": 29, "form": "dlg", "jp": "（もう１人の『超能力者』よ！）"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "（ウソッ！！）"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "（『ラスカル』にかい？）"},
{"id": 308, "speaker": 29, "form": "dlg", "jp": "（洗われたんじゃないわよ！）"},
{"id": 309, "speaker": 29, "form": "dlg", "jp": "（現れたのよ！！）"},
{"id": 310, "speaker": 29, "form": "dlg", "jp": "（もう１人の『超能力者』が！）"},
{"id": 311, "speaker": 2, "form": "dlg", "jp": "（ウソ！！）"},
{"id": 312, "speaker": 29, "form": "dlg", "jp": "（たぶんね！）"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "（どこに？）"},
{"id": 314, "speaker": 29, "form": "dlg", "jp": "（さっきは『女子更衣室』に‥‥）"},
{"id": 315, "speaker": 29, "form": "dlg", "jp": "（今は目の前にいるわ‥‥）"},
{"id": 316, "speaker": 2, "form": "dlg", "jp": "（目の前‥‥）"},
{"id": 317, "speaker": 29, "form": "dlg", "jp": "（‥‥やっぱり、見えないのね）"},
{"id": 318, "speaker": 2, "form": "dlg", "jp": "（ジーンは見えてるの？）"},
{"id": 319, "speaker": 29, "form": "dlg", "jp": "（ええ‥‥）"},
{"id": 320, "speaker": 29, "form": "dlg", "jp": "（ビデオカメラを持って、\n　こそこそと逃げて行ってるわ‥‥）"},
{"id": 321, "speaker": 29, "form": "dlg", "jp": "（あれを見て‥‥）"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "（‥‥？）"},
{"id": 323, "speaker": 29, "form": "dlg", "jp": "（わかった？）"},
{"id": 324, "speaker": 2, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 325, "speaker": 29, "form": "dlg", "jp": "（じゃあ、行くわよ！）"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "（どこへ？）"},
{"id": 327, "speaker": 29, "form": "dlg", "jp": "（追っかけるのよ！）"},
{"id": 328, "speaker": 29, "form": "dlg", "jp": "（追っかけて、\n　『ビデオカメラ』を取りかえすのよ！）"},
{"id": 329, "speaker": 2, "form": "dlg", "jp": "（とりかえす？）"},
{"id": 330, "speaker": 29, "form": "dlg", "jp": "（何でもいいから、ついて来て！）"},
{"id": 331, "speaker": 29, "form": "dlg", "jp": "（あっ！）"},
{"id": 332, "speaker": 29, "form": "dlg", "jp": "（走り出したわ！）"},
{"id": 333, "speaker": 29, "form": "dlg", "jp": "（追うわよ！）"},
{"id": 334, "speaker": 29, "form": "dlg", "jp": "（早く！！）"},
{"id": 335, "speaker": 29, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 336, "speaker": 29, "form": "dlg", "jp": "ボクはジーンについてプールの裏へと向かった。"},
{"id": 337, "speaker": 29, "form": "dlg", "jp": "「さあ、行き止まりよ！」"},
{"id": 338, "speaker": 29, "form": "dlg", "jp": "「おとなしく『ビデオカメラ』を渡しなさい！！」"},
{"id": 339, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥"},
{"id": 340, "speaker": 2, "form": "dlg", "jp": "「本当にそこにいるのかい？」"},
{"id": 341, "speaker": 29, "form": "dlg", "jp": "「私には見えているのよ！」"},
{"id": 342, "speaker": 29, "form": "dlg", "jp": "「早く、『カメラ』を渡しなさい！」"},
{"id": 343, "speaker": 2, "form": "dlg", "jp": "「ジーン‥‥」"},
{"id": 344, "speaker": 29, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 345, "speaker": 29, "form": "dlg", "jp": "「もう逃げられないって\n　証拠を見せてあげる」"},
{"id": 346, "speaker": 29, "form": "dlg", "jp": "「ナゴム、正面右を殴り付けて！」"},
{"id": 347, "speaker": 29, "form": "dlg", "jp": "「早くっ！」"},
{"id": 348, "speaker": 29, "form": "choice", "jp": "「なんで？」"},
{"id": 349, "speaker": 29, "form": "choice", "jp": "「正面右だね！」"},
{"id": 350, "speaker": 29, "form": "choice", "jp": "「正面左だったかな？」"},
{"id": 351, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 352, "speaker": 29, "form": "dlg", "jp": "「何してんの！！」"},
{"id": 353, "speaker": 29, "form": "dlg", "jp": "「早く！！」"},
{"id": 354, "speaker": 2, "form": "dlg", "jp": "「わ、わかった！」"},
{"id": 355, "speaker": 2, "form": "dlg", "jp": "「なんで？」"},
{"id": 356, "speaker": 29, "form": "dlg", "jp": "「もう！」"},
{"id": 357, "speaker": 29, "form": "dlg", "jp": "「早く！！」"},
{"id": 358, "speaker": 2, "form": "dlg", "jp": "「わ、わかったよ！」"},
{"id": 359, "speaker": 2, "form": "dlg", "jp": "「正面左だったかな？」"},
{"id": 360, "speaker": 2, "form": "dlg", "jp": "ボクは正面左を殴り付けた。"},
{"id": 361, "speaker": 2, "form": "dlg", "jp": "『ブン！』"},
{"id": 362, "speaker": 2, "form": "dlg", "jp": "しかし、何も起こらなかった。"},
{"id": 363, "speaker": 29, "form": "dlg", "jp": "「もう！　何やってんの！」"},
{"id": 364, "speaker": 29, "form": "dlg", "jp": "「正面右側よ！！」"},
{"id": 365, "speaker": 29, "form": "dlg", "jp": "「早く！！」"},
{"id": 366, "speaker": 2, "form": "dlg", "jp": "「わ、わかったよ！」"},
{"id": 367, "speaker": 29, "form": "dlg", "jp": "「待って！」"},
{"id": 368, "speaker": 2, "form": "dlg", "jp": "「へっ！？」"},
{"id": 369, "speaker": 29, "form": "dlg", "jp": "「逃げてっ！」"},
{"id": 370, "speaker": 2, "form": "dlg", "jp": "「何だよ、いったい！」"},
{"id": 371, "speaker": 2, "form": "dlg", "jp": "『ブン！』"},
{"id": 372, "speaker": 2, "form": "dlg", "jp": "目の前で刃物が風を切る音が聞こえた。"},
{"id": 373, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 374, "speaker": 2, "form": "dlg", "jp": "ボクはそのまま意識を失った‥‥"},
{"id": 375, "speaker": 2, "form": "dlg", "jp": "「正面右だね！」"},
{"id": 376, "speaker": 2, "form": "dlg", "jp": "ボクは正面右を殴り付けた。"},
{"id": 377, "speaker": 2, "form": "dlg", "jp": "『ブン！』"},
{"id": 378, "speaker": 2, "form": "dlg", "jp": "『ガツン！』"},
{"id": 379, "speaker": 4, "form": "dlg", "jp": "「イテッ！」"},
{"id": 380, "speaker": 4, "form": "dlg", "jp": "空中からいきなりビデオカメラが現れた。"},
{"id": 381, "speaker": 4, "form": "dlg", "jp": "『ゴロゴロ！』"},
{"id": 382, "speaker": 29, "form": "dlg", "jp": "「やったわ！」"},
{"id": 383, "speaker": 4, "form": "dlg", "jp": "「ちくしょうっ！」"},
{"id": 384, "speaker": 4, "form": "dlg", "jp": "「本当にオレのことが見えてるみたいだな‥‥！」"},
{"id": 385, "speaker": 4, "form": "dlg", "jp": "「仕方ないな‥‥」"},
{"id": 386, "speaker": 4, "form": "dlg", "jp": "『シャキーン！！』"},
{"id": 387, "speaker": 29, "form": "dlg", "jp": "「ナゴム、逃げてっ！」"},
{"id": 388, "speaker": 29, "form": "choice", "jp": "「へっ？」"},
{"id": 389, "speaker": 29, "form": "choice", "jp": "「わかった！」"},
{"id": 390, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 391, "speaker": 4, "form": "dlg", "jp": "「死ね～い！」"},
{"id": 392, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 393, "speaker": 4, "form": "dlg", "jp": "「死ね～い！」"},
{"id": 394, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 395, "speaker": 4, "form": "dlg", "jp": "「死ね～い！」"},
{"id": 396, "speaker": 4, "form": "dlg", "jp": "ボクはとっさに飛び退いた。"},
{"id": 397, "speaker": 4, "form": "dlg", "jp": "『ブン！』"},
{"id": 398, "speaker": 4, "form": "dlg", "jp": "目の前で刃物が風を切る音が聞こえた。"},
{"id": 399, "speaker": 4, "form": "dlg", "jp": "「ちくしょう！」"},
{"id": 400, "speaker": 29, "form": "dlg", "jp": "「ムダよ！」"},
{"id": 401, "speaker": 29, "form": "dlg", "jp": "「私たちには見えてるんだから‥‥」"},
{"id": 402, "speaker": 4, "form": "dlg", "jp": "「ぐぐぐぐぐ‥‥」"},
{"id": 403, "speaker": 29, "form": "dlg", "jp": "「逃げる気よっ！」"},
{"id": 404, "speaker": 29, "form": "dlg", "jp": "「捕まえてっ！」"},
{"id": 405, "speaker": 2, "form": "dlg", "jp": "「捕まえてったって‥‥」"},
{"id": 406, "speaker": 2, "form": "dlg", "jp": "「‥‥どこに？」"},
{"id": 407, "speaker": 29, "form": "dlg", "jp": "「この状況から考えれば、\n　塀を乗り越えるに決まってるでしょう！」"},
{"id": 408, "speaker": 29, "form": "dlg", "jp": "「早くっ！」"},
{"id": 409, "speaker": 2, "form": "dlg", "jp": "「あ、あぁ‥‥」"},
{"id": 410, "speaker": 29, "form": "dlg", "jp": "「‥‥\n　あ～あぁ～」"},
{"id": 411, "speaker": 2, "form": "dlg", "jp": "「‥‥へっ？」"},
{"id": 412, "speaker": 29, "form": "dlg", "jp": "「もう塀の向こうよ！」"},
{"id": 413, "speaker": 29, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 414, "speaker": 31, "form": "dlg", "jp": "「オイ、どうかしたのか？」"},
{"id": 415, "speaker": 29, "form": "dlg", "jp": "「ちょっと、遅いわよ！」"},
{"id": 416, "speaker": 31, "form": "dlg", "jp": "「‥‥何があったんだよ？」"},
{"id": 417, "speaker": 29, "form": "dlg", "jp": "「いたのよ、もう１人の超能力者が‥‥」"},
{"id": 418, "speaker": 31, "form": "dlg", "jp": "「ホントか？」"},
{"id": 419, "speaker": 2, "form": "dlg", "jp": "「ボクには見えなかったんだけど‥‥」"},
{"id": 420, "speaker": 29, "form": "dlg", "jp": "「思った通り\n　姿を見えなくする『能力』よ！」"},
{"id": 421, "speaker": 31, "form": "dlg", "jp": "「で？」"},
{"id": 422, "speaker": 29, "form": "dlg", "jp": "「ナゴムがグズグズしてたから\n　逃げちゃったわよ！」"},
{"id": 423, "speaker": 2, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 424, "speaker": 2, "form": "choice", "jp": "「ボクは見えないのに‥‥」"},
{"id": 425, "speaker": 2, "form": "choice", "jp": "「そんなら自分で捕まえたら‥‥」"},
{"id": 426, "speaker": 2, "form": "dlg", "jp": "「ボクは見えないのに‥‥」"},
{"id": 427, "speaker": 29, "form": "dlg", "jp": "「それはそうだけど‥‥」"},
{"id": 428, "speaker": 2, "form": "dlg", "jp": "「そんなら自分で捕まえたら‥‥」"},
{"id": 429, "speaker": 29, "form": "dlg", "jp": "「私の能力は『戦闘向け』じゃないの！」"},
{"id": 430, "speaker": 29, "form": "dlg", "jp": "「まあ、いいわ‥‥」"},
{"id": 431, "speaker": 29, "form": "dlg", "jp": "「ビデオを奪い取ることができただけでも\n　良しとしなくちゃね‥‥」"},
{"id": 432, "speaker": 31, "form": "dlg", "jp": "「何が映ってんだ、そのビデオ？」"},
{"id": 433, "speaker": 29, "form": "dlg", "jp": "「女子更衣室にカメラを持って入って来たのよ！」"},
{"id": 434, "speaker": 29, "form": "dlg", "jp": "「何を映してるのかなんて、想像がつくでしょう！」"},
{"id": 435, "speaker": 31, "form": "dlg", "jp": "「とりあえず、再生してみるか？」"},
{"id": 436, "speaker": 31, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 437, "speaker": 29, "form": "dlg", "jp": "「そんなことしたらコロスから‥‥」"},
{"id": 438, "speaker": 31, "form": "dlg", "jp": "「まあ、冗談はさておき‥‥」"},
{"id": 439, "speaker": 31, "form": "dlg", "jp": "「シンたちがナゴムのこと探してたぞ！」"},
{"id": 440, "speaker": 31, "form": "dlg", "jp": "「早く戻らないと怪しまれるぞ‥‥」"},
{"id": 441, "speaker": 2, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 442, "speaker": 2, "form": "dlg", "jp": "ボクはシンちゃんたちのところに戻ることにした。"},
{"id": 443, "speaker": 31, "form": "dlg", "jp": "「ルール違反のナゴムのことのほうが‥‥」"},
{"id": 444, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 445, "speaker": 29, "form": "dlg", "jp": "「そっちの解決の方を先にしないとね‥‥」"},
{"id": 446, "speaker": 29, "form": "dlg", "jp": "「さあ、帰りましょう‥‥」"},
{"id": 447, "speaker": 29, "form": "dlg", "jp": "ボクたちは家に戻ることにした。"},
{"id": 448, "speaker": 29, "form": "dlg", "jp": "結局、いいアイデアが浮かばないまま\n朝をむかえた。"},
{"id": 449, "speaker": 2, "form": "dlg", "jp": "（しかたない、\n　『アイコ』にきつく口止めしておくか‥‥）"},
{"id": 450, "speaker": 2, "form": "dlg", "jp": "（アイツが言わなけりゃ、\n　ジーンたちにはバレないだろう‥‥）"},
{"id": 451, "speaker": 2, "form": "dlg", "jp": "（しかたない、\n　『長尾』にきつく口止めしておくか‥‥）"},
{"id": 452, "speaker": 2, "form": "dlg", "jp": "（アイツが言わなけりゃ、\n　ジーンたちにはバレないだろう‥‥）"},
{"id": 453, "speaker": 2, "form": "dlg", "jp": "（しかたない、\n　『堤さん』にきつく口止めしておくか‥‥）"},
{"id": 454, "speaker": 2, "form": "dlg", "jp": "（彼女が言わなけりゃ、\n　ジーンたちにはバレないだろう‥‥）"},
{"id": 455, "speaker": 2, "form": "dlg", "jp": "「ピーンポーン！」"},
{"id": 456, "speaker": 3, "form": "dlg", "jp": "「ナゴム～～！！」"},
{"id": 457, "speaker": 3, "form": "dlg", "jp": "「ツトムくんよ～～！」"},
{"id": 458, "speaker": 2, "form": "dlg", "jp": "（そういえば、プールに行く約束してたんだ！）"},
{"id": 459, "speaker": 3, "form": "dlg", "jp": "「起きてるんでしょ～う？」"},
{"id": 460, "speaker": 2, "form": "dlg", "jp": "「ああ、ちょっと待って！」"},
{"id": 461, "speaker": 2, "form": "dlg", "jp": "「今行くよ！」"},
{"id": 462, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 463, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 464, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 465, "speaker": 13, "form": "dlg", "jp": "「よっ！」"},
{"id": 466, "speaker": 2, "form": "dlg", "jp": "「ゴメン、待たせたな‥‥」"},
{"id": 467, "speaker": 13, "form": "dlg", "jp": "「じゃあ行くぞ！」"},
{"id": 468, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん‥‥！」"},
{"id": 469, "speaker": 2, "form": "dlg", "jp": "「アイコ！」"},
{"id": 470, "speaker": 15, "form": "dlg", "jp": "「昨日はゴメンね‥‥」"},
{"id": 471, "speaker": 15, "form": "dlg", "jp": "「お礼も言わずに逃げ出すようなことをして‥‥」"},
{"id": 472, "speaker": 2, "form": "dlg", "jp": "「あ、あ、気にしてないから‥‥」"},
{"id": 473, "speaker": 2, "form": "dlg", "jp": "「それより、\n　ここじゃぁなんだし場所をかえないか？」"},
{"id": 474, "speaker": 15, "form": "dlg", "jp": "「いいわよ‥‥」"},
{"id": 475, "speaker": 2, "form": "dlg", "jp": "「ちょっとコイツと話があるから‥‥」"},
{"id": 476, "speaker": 29, "form": "dlg", "jp": "「どうぞ‥‥」"},
{"id": 477, "speaker": 29, "form": "dlg", "jp": "「いってらっしゃい‥‥」"},
{"id": 478, "speaker": 29, "form": "dlg", "jp": "ボクはアイコを更衣室の方へ連れて行った。"},
{"id": 479, "speaker": 15, "form": "dlg", "jp": "「本当に昨日はありがとう」"},
{"id": 480, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 481, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん‥‥怒ってない？」"},
{"id": 482, "speaker": 2, "form": "dlg", "jp": "「別に‥‥」"},
{"id": 483, "speaker": 15, "form": "dlg", "jp": "「たぶん、私、気が動転していたんだ‥‥」"},
{"id": 484, "speaker": 15, "form": "dlg", "jp": "「おかしい話だけど‥‥」"},
{"id": 485, "speaker": 15, "form": "dlg", "jp": "「あの時、ナゴムちゃんが、\n　怪物みたいに見えたんだ‥‥」"},
{"id": 486, "speaker": 2, "form": "dlg", "jp": "「あ、その話なんだけど‥‥」"},
{"id": 487, "speaker": 2, "form": "dlg", "jp": "「誰かに話したりした？」"},
{"id": 488, "speaker": 15, "form": "dlg", "jp": "「心配するといやだから、\n　家族にもまだ‥‥」"},
{"id": 489, "speaker": 15, "form": "dlg", "jp": "「でも、\n　警察には言っておいた方がいいわよね？」"},
{"id": 490, "speaker": 2, "form": "dlg", "jp": "「あ～\n　‥‥‥‥」"},
{"id": 491, "speaker": 2, "form": "dlg", "jp": "「悪いけど、警察には‥‥」"},
{"id": 492, "speaker": 2, "form": "dlg", "jp": "「‥‥って、いうより、\n　誰にも内緒にしてもらえないかな？」"},
{"id": 493, "speaker": 15, "form": "dlg", "jp": "「どうして？」"},
{"id": 494, "speaker": 2, "form": "dlg", "jp": "「理由は言えないけど‥‥」"},
{"id": 495, "speaker": 2, "form": "dlg", "jp": "「‥‥頼む！」"},
{"id": 496, "speaker": 2, "form": "dlg", "jp": "「この通り！！」"},
{"id": 497, "speaker": 15, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 498, "speaker": 15, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 499, "speaker": 15, "form": "dlg", "jp": "「『命の恩人』がそう言うのなら‥‥」"},
{"id": 500, "speaker": 2, "form": "dlg", "jp": "「ありがとう！」"},
{"id": 501, "speaker": 2, "form": "dlg", "jp": "（よし、これでＯＫだ！）"},
{"id": 502, "speaker": 2, "form": "dlg", "jp": "「じゃあ、戻ろうか？」"},
