[
{"id": 0, "speaker": null, "form": "dlg", "jp": "その時！"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「プルルルルル‥‥」"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "ボクの携帯電話がなった。"},
{"id": 3, "speaker": null, "form": "dlg", "jp": "「ピッ！」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「もしもし‥‥」"},
{"id": 5, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 6, "speaker": 4, "form": "dlg", "jp": "（ソンナコトデ、ニゲラレルトオモッテイルノカ‥‥）"},
{"id": 7, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「‥‥‥！！」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "「誰だ、オマエは！！」"},
{"id": 10, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 11, "speaker": 4, "form": "dlg", "jp": "（シツモンスルノハ、コチラノホウダ‥‥）"},
{"id": 12, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 13, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 14, "speaker": 4, "form": "dlg", "jp": "（オヤジハ　ドコニイル‥‥）"},
{"id": 15, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "（アイツらだ！！）"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "（そうだ！）"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "（となりの部屋に警察が‥‥！）"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "携帯電話を持ったまま\n警察に知らせるために隣の部屋へ向かった。"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「すいません‥‥！」"},
{"id": 22, "speaker": 20, "form": "dlg", "jp": "「うわぁ！」"},
{"id": 23, "speaker": 42, "form": "dlg", "jp": "「うぎゃぁ！」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "（悲鳴！！）"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "あわててボクはドアを開いた‥‥"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "（うわぁ‥‥！）"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "ボクは再び携帯電話を耳にあてた。"},
{"id": 30, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 31, "speaker": 4, "form": "dlg", "jp": "（ドウダ、オドロイタカ‥‥）"},
{"id": 32, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "（コイツ、コッチのことが見えているのか‥‥！）"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「オマエがやったのか‥‥！？」"},
{"id": 35, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 36, "speaker": 4, "form": "dlg", "jp": "（ナンドモ　イワセルナ‥‥）"},
{"id": 37, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 38, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 39, "speaker": 4, "form": "dlg", "jp": "（シツモンスルノハ　コッチダ‥‥）"},
{"id": 40, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 41, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 42, "speaker": 4, "form": "dlg", "jp": "（オヤジハ　ドコダ？）"},
{"id": 43, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 44, "speaker": 2, "form": "dlg", "jp": "「知らない！」"},
{"id": 45, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 46, "speaker": 4, "form": "dlg", "jp": "（ホントウニ　シラナイノカ？）"},
{"id": 47, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「本当だっ！！」"},
{"id": 49, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 50, "speaker": 4, "form": "dlg", "jp": "（ドウヤラ　ホントウニシラナイヨウダナ‥‥）"},
{"id": 51, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 52, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 53, "speaker": 4, "form": "dlg", "jp": "（ナラバ　シンデモラオウ‥‥）"},
{"id": 54, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 55, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 56, "speaker": 4, "form": "dlg", "jp": "（オマエガ　コロサレレバ\n　アノ　ガンコオヤジモ　デテクルダロウ）"},
{"id": 57, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "（なんだって！）"},
{"id": 59, "speaker": 2, "form": "choice", "jp": "（ホテルの内線で警部さんに連絡を！）"},
{"id": 60, "speaker": 2, "form": "choice", "jp": "（もう少し、話を聞いてみよう‥‥）"},
{"id": 61, "speaker": 2, "form": "choice", "jp": "（とりあえずこの部屋を逃げ出そう！）"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "（ホテルの内線で警部さんに連絡を！）"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "ボクはそなえつけの電話の受話器を手にとった。"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 65, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 66, "speaker": 4, "form": "dlg", "jp": "（ムダダ‥‥）"},
{"id": 67, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "（何っ！？）"},
{"id": 69, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 70, "speaker": 4, "form": "dlg", "jp": "（デンワセンハ　キッテイル‥‥）"},
{"id": 71, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "（‥‥！！）"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "たしかに備え付けの電話器の受話器からは\nなんの音も聞こえない‥‥"},
{"id": 74, "speaker": 2, "form": "choice", "jp": "（いつの間に！？）"},
{"id": 75, "speaker": 2, "form": "choice", "jp": "（どうやって！？）"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "（いつの間に！？）"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "（さっきまで、警部さんたちがいたんだ。\n　電話線を切るなんて不可能だ！！）"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "（だいだい、どこからこちらの様子を‥‥）"},
{"id": 79, "speaker": 2, "form": "choice", "jp": "（窓から！？）"},
{"id": 80, "speaker": 2, "form": "choice", "jp": "（監視カメラ！？）"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "（どうやって！？）"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "（さっきまで、警部さんたちがいたんだ。\n　電話線を切るなんて不可能だ！！）"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "（だいだい、どこからこちらの様子を‥‥）"},
{"id": 84, "speaker": 2, "form": "choice", "jp": "（窓から！？）"},
{"id": 85, "speaker": 2, "form": "choice", "jp": "（監視カメラ！？）"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "（窓から！？）"},
{"id": 87, "speaker": 2, "form": "dlg", "jp": "（窓から、こちらの様子を‥‥）"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "（じゃあ、警察の人たちも窓から狙撃された！？）"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "（いや、ここはこの辺りで一番の高層ホテルの最上階！）"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "（窓の外にそれらしき建物は見あたらない！）"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "（それに隣の部屋の窓もしまっている！！）"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "（と、いうことは‥‥）"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "（この部屋のどこかに隠れている！？）"},
{"id": 94, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 95, "speaker": 4, "form": "dlg", "jp": "（ドウシタ‥‥）"},
{"id": 96, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 97, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 98, "speaker": 4, "form": "dlg", "jp": "（ナゼ　ダマッテイル？）"},
{"id": 99, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "（いったいどこに？）"},
{"id": 101, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 102, "speaker": 4, "form": "dlg", "jp": "（ドンナニ　カンガエコンデモムダダ‥‥）"},
{"id": 103, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 104, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 105, "speaker": 4, "form": "dlg", "jp": "（モウ　オマエハ　シヌノダカラ‥‥）"},
{"id": 106, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "（どうする？）"},
{"id": 108, "speaker": 2, "form": "choice", "jp": "（とりあえずここから逃げ出そう！）"},
{"id": 109, "speaker": 2, "form": "choice", "jp": "（どこに隠れているか見つけだしてやろう！）"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "（とりあえずここから逃げ出そう！）"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "ボクは電話を投げ捨てこの部屋を出ることにした。"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "（監視カメラ！？）"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "（監視カメラで、こちらの様子を‥‥）"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "（じゃあ、警察の人たちが殺されたのは？）"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "（たしか隣の部屋の窓はしまっていた！！）"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "（遠隔からの狙撃はありえない！）"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "（と、いうことは‥‥）"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "（この部屋のどこかに隠れている！？）"},
{"id": 119, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 120, "speaker": 4, "form": "dlg", "jp": "（ドウシタ‥‥）"},
{"id": 121, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 122, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 123, "speaker": 4, "form": "dlg", "jp": "（ナゼ　ダマッテイル？）"},
{"id": 124, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "（いったいどこに？）"},
{"id": 126, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 127, "speaker": 4, "form": "dlg", "jp": "（ドンナニ　カンガエコンデモムダダ‥‥）"},
{"id": 128, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 129, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 130, "speaker": 4, "form": "dlg", "jp": "（モウ　オマエハ　シヌノダカラ‥‥）"},
{"id": 131, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "（どうする？）"},
{"id": 133, "speaker": 2, "form": "choice", "jp": "（とりあえずここから逃げ出そう！）"},
{"id": 134, "speaker": 2, "form": "choice", "jp": "（どこに隠れているか見つけだしてやろう！）"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "（とりあえずここから逃げ出そう！）"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "ボクは電話を投げ捨てこの部屋を出ることにした。"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "（どこに隠れているか見つけだしてやろう！）"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "ボクはベッドの裏側を覗き込んだ。"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "ボクは胸に激しい痛みを感じた‥‥"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "（もう少し、話を聞いてみよう‥‥"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「そこからココが見えるの？」"},
{"id": 144, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 145, "speaker": 4, "form": "dlg", "jp": "（ミエル‥‥）"},
{"id": 146, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 147, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 148, "speaker": 4, "form": "dlg", "jp": "（ミエルダケジャナイ‥‥）"},
{"id": 149, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 150, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 151, "speaker": 4, "form": "dlg", "jp": "（トナリノ　ケイサツノヨウニ\n　コロスコトモ　デキル‥‥）"},
{"id": 152, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "（いったい、どこからこちらの様子を‥‥）"},
{"id": 154, "speaker": 2, "form": "choice", "jp": "（窓から！？）"},
{"id": 155, "speaker": 2, "form": "choice", "jp": "（監視カメラ！？）"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "（とりあえずこの部屋を逃げ出そう！）"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "（間違いなく、ここにいたら殺されてしまう！）"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "ボクは電話を投げ捨てこの部屋を出ることにした。"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "（とりあえず、\n　ロビーにいる警部さんの所へ行けばなんとか‥‥）"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "（問題はロビーのある１階へどうやって行くか、だ‥‥）"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "（部屋を出て左のエレベーターを使うか、\n　右の階段を使うか‥‥）"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "（この建物のどこに\n　アイツらがいるかわからないからな‥‥）"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "（イタタタ‥‥）"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "また、足が痛みだした。"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "（こんな状態で襲われたら逃げたり、\n　戦ったりなんかできない！）"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "（とにかく早く警部さんのところにゆかないと‥‥）"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "（しめた、エレベーターだ！！）"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "（‥‥‥！）"},
{"id": 169, "speaker": 4, "form": "dlg", "jp": "「次はオマエの番だ‥‥」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "（コイツ‥‥！！）"},
{"id": 171, "speaker": 2, "form": "choice", "jp": "（逃げなくちゃ！）"},
{"id": 172, "speaker": 2, "form": "choice", "jp": "（ちくしょう！これでも喰らえ！）"},
{"id": 173, "speaker": 4, "form": "dlg", "jp": "「何考えてんだぁ？」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "（‥‥‥！）"},
{"id": 175, "speaker": 4, "form": "dlg", "jp": "「無駄なんだよ！」"},
{"id": 176, "speaker": 4, "form": "dlg", "jp": "「逃げられると思ったのか‥‥？」"},
{"id": 177, "speaker": 4, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 178, "speaker": 4, "form": "dlg", "jp": "「死ねっ！」"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "（逃げなくちゃ！）"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "（イタッ！）"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "（ダメだ足が痛くて走れない！）"},
{"id": 183, "speaker": 4, "form": "dlg", "jp": "「何考えてんだぁ？」"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "（‥‥‥！）"},
{"id": 185, "speaker": 4, "form": "dlg", "jp": "「無駄なんだよ！」"},
{"id": 186, "speaker": 4, "form": "dlg", "jp": "「逃げられると思ったのか‥‥？」"},
{"id": 187, "speaker": 4, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 188, "speaker": 4, "form": "dlg", "jp": "「死ねっ！」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "（ちくしょう！これでも喰らえ！）"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "ボクは警部さんがくれた"},
{"id": 192, "speaker": 2, "form": "dlg", "jp": "スプレー"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "を男の顔に吹き付けた。"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "「シューーーーッ！」"},
{"id": 195, "speaker": 4, "form": "dlg", "jp": "「うわっ！」"},
{"id": 196, "speaker": 4, "form": "dlg", "jp": "「ちくしょう！　何しやがる！」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "（よし、今のうちだ！）"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "ボクはエレベーターに飛び乗った。"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "「ガシャァン」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "（やったぞ！！）"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "「ウィィィィン」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "ボクはエレベーターで警部さんたちのいる\nロビーに向かった。"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "（しめた、丁度エレベーターがくるぞ！）"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "（‥‥‥！）"},
{"id": 206, "speaker": 4, "form": "dlg", "jp": "「次はオマエの番だ‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "（コイツ‥‥！！）"},
{"id": 208, "speaker": 2, "form": "dlg", "jp": "（逃げなくちゃ‥‥！！）"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "（階段‥‥！？）"},
{"id": 210, "speaker": 2, "form": "choice", "jp": "（とりあえず、下の階へ）"},
{"id": 211, "speaker": 2, "form": "choice", "jp": "（イヤ、相手の裏をかいて上の階へ）"},
{"id": 212, "speaker": 4, "form": "dlg", "jp": "「何考えてんだぁ？」"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "（‥‥‥！）"},
{"id": 214, "speaker": 4, "form": "dlg", "jp": "「無駄なんだよ！」"},
{"id": 215, "speaker": 4, "form": "dlg", "jp": "「逃げられると思ったのか‥‥？」"},
{"id": 216, "speaker": 4, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 217, "speaker": 4, "form": "dlg", "jp": "「死ねっ！」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "（‥‥‥！）"},
{"id": 220, "speaker": 4, "form": "dlg", "jp": "「逃げられると思ったのか‥‥？」"},
{"id": 221, "speaker": 4, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 222, "speaker": 4, "form": "dlg", "jp": "「死ねっ！」"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "（とりあえず、下の階へ‥‥‥）"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "（警部さんのところへ行けばなんとか‥‥‥）"},
{"id": 226, "speaker": 4, "form": "dlg", "jp": "「逃げられると思ったのか‥‥？」"},
{"id": 227, "speaker": 4, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 228, "speaker": 4, "form": "dlg", "jp": "「オマエの行動はお見通しだ！！」"},
{"id": 229, "speaker": 4, "form": "dlg", "jp": "「死ねっ！」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "（イヤ、相手の裏をかいて上の階へ）"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "（このフロアは最上階‥‥‥）"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "（まさか上にあがるとは思わないだろう‥‥）"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "ボクはあえて上の階へと駆け上がった。"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "思ったとおり、アイツは下の階へ降りていった。"},
{"id": 236, "speaker": 4, "form": "dlg", "jp": "「ちくしょう！！」"},
{"id": 237, "speaker": 4, "form": "dlg", "jp": "「その上は屋上だぞ！\n　逃げられると思ってるのか！？」"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "（上がってくる！！）"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "（どうにかしないと！！）"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "（‥‥！！）"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "（もしアイツがサイボーグだとしても、\n　頭は改造されてないハズ！）"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "（よし、この花瓶を頭にぶつければ‥‥！）"},
{"id": 243, "speaker": 4, "form": "dlg", "jp": "「こざかしいまねを‥‥」"},
{"id": 244, "speaker": 4, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 245, "speaker": 4, "form": "dlg", "jp": "「死ねっ！」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "（誰かくるぞ！）"},
{"id": 248, "speaker": 2, "form": "choice", "jp": "（助けを求めよう！）"},
{"id": 249, "speaker": 2, "form": "choice", "jp": "（イヤ、あの人も敵かも‥‥）"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "（イヤ、あの人も敵かも‥‥）"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "（たしか反対側にも階段があったハズ‥‥）"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "ボクは反対側の階段に行くことにした‥‥"},
{"id": 253, "speaker": 4, "form": "dlg", "jp": "「待ちやがれっ！」"},
{"id": 254, "speaker": 2, "form": "dlg", "jp": "（やっぱり敵！！）"},
{"id": 255, "speaker": 2, "form": "dlg", "jp": "（逃げなくちゃ‥‥！！）"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "（イタタタ‥‥）"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "また、足が痛みだした。"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "（ちくしょうっ走れない！）"},
{"id": 259, "speaker": 4, "form": "dlg", "jp": "「なんだ、走れないのか？」"},
{"id": 260, "speaker": 4, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 261, "speaker": 4, "form": "dlg", "jp": "「じゃあ、死ねや～～！」"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "（階段‥‥！？）"},
{"id": 264, "speaker": 2, "form": "choice", "jp": "（とりあえず、下の階へ）"},
{"id": 265, "speaker": 2, "form": "choice", "jp": "（イヤ、相手の裏をかいて上の階へ）"},
{"id": 266, "speaker": 4, "form": "dlg", "jp": "「何考えてんだぁ？」"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "（‥‥‥！）"},
{"id": 268, "speaker": 4, "form": "dlg", "jp": "「無駄なんだよ！」"},
{"id": 269, "speaker": 4, "form": "dlg", "jp": "「逃げられると思ったのか‥‥？」"},
{"id": 270, "speaker": 4, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 271, "speaker": 4, "form": "dlg", "jp": "「死ねっ！」"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "（助けを求めよう！）"},
{"id": 274, "speaker": 2, "form": "dlg", "jp": "「すみません！」"},
{"id": 275, "speaker": 4, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "「助けてください！　お願いします！」"},
{"id": 277, "speaker": 4, "form": "dlg", "jp": "「？？？」"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "「命を狙われているんです‥‥」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "「一緒に、ロビーまでついて来てもらえませんか？」"},
{"id": 280, "speaker": 4, "form": "dlg", "jp": "「こまったなぁ‥‥」"},
{"id": 281, "speaker": 4, "form": "dlg", "jp": "「一緒に行くことはできないよ‥‥」"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "「そんなぁ、"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "ウソじゃないんです‥‥」"},
{"id": 284, "speaker": 4, "form": "dlg", "jp": "「悪いけど、一人で行ってくれないか？」"},
{"id": 285, "speaker": 4, "form": "dlg", "jp": "「地獄に‥‥」"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "「‥‥‥！！」"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "「シャキーーーン！！」"},
{"id": 288, "speaker": 4, "form": "dlg", "jp": "「死ねっ！」"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "（やったぞ！！）"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "ボクは倒れているソイツの横をかけぬけて\n下の階へと急いだ‥‥"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "（こんな高層ホテルを階段でおりることになるとは‥‥）"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "失敗の原因は行動に慎重さがなかったこと。\nもっと慎重に行動するように‥‥"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "失敗の原因は素早い判断ができなかった事。\n何を優先するべきかを常に考えておけばこんな事には‥"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "失敗の原因は体力の問題。\n知力だけでなく、体力もないと‥"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "失敗の原因は行動が読まれていたこと‥‥\n相手のウラをかくことも必要‥‥"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "失敗の原因はタイミングを外したこと‥‥\nもっと確実性を‥‥"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "失敗の原因は自分の体調を把握してなかったこと‥‥\nその足では走るのはムリ‥‥"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "失敗の原因は判断力不足‥‥\n状況を理解していればこうはならなかったハズ‥‥"}
]
