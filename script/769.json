[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０７／２３／ＡＭ１１：２３"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "厳重（ゲンジュウ）な警備体制のホテルにまで\n『ルード』が襲撃してきたということで、"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "ホテルから、警察内に宿泊することになった。"},
{"id": 3, "speaker": null, "form": "dlg", "jp": "もちろん、厳重（ゲンジュウ）な警備というのは\n表向きの理由で、インターポールは"},
{"id": 4, "speaker": null, "form": "dlg", "jp": "ボクの腕を詳しく調べたかったのだろう。"},
{"id": 5, "speaker": null, "form": "dlg", "jp": "実際、ボクは朝から科学班に色んな検査をされた。"},
{"id": 6, "speaker": null, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「ただいま‥‥」"},
{"id": 8, "speaker": 3, "form": "dlg", "jp": "「おかえり‥‥」"},
{"id": 9, "speaker": 3, "form": "dlg", "jp": "この部屋が警察が用意してくれた部屋だ‥‥"},
{"id": 10, "speaker": 3, "form": "dlg", "jp": "何も無い部屋だけど、\nスイートルームなんかよりは落ち着く気がする。"},
{"id": 11, "speaker": 3, "form": "dlg", "jp": "「ゴメンナサイ‥‥」"},
{"id": 12, "speaker": 3, "form": "dlg", "jp": "「今まで内緒（ナイショ）にしてて‥‥」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「いいよ、どうして内緒にしていたのか\n　なんとなくわかるから‥‥」"},
{"id": 14, "speaker": 3, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥」"},
{"id": 15, "speaker": 3, "form": "dlg", "jp": "「で、どんなこと調べられたの？」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「色々だよ‥‥」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「人工皮膚（ヒフ）をはがすわけにいかないから\n　外側からいろんな検査道具をあてたり‥‥」"},
{"id": 18, "speaker": 3, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「ボクの腕と、ルードのサイボーグの腕の\n　違いを調べたいみたいだね‥‥」"},
{"id": 20, "speaker": 3, "form": "dlg", "jp": "「で、結果は？」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「教えてくれないよ‥‥」"},
{"id": 22, "speaker": 3, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「なんか、変な気持ちだよ‥‥」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「『この手』が自分の『手』じゃないなんて‥‥」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「１０年もつけてたからなのかな？」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「まったく、違和感を感じないなんて‥‥」"},
{"id": 27, "speaker": 3, "form": "dlg", "jp": "「それだけ、父さんがスゴイってことよ‥‥」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「う～ん」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「まだ、ぜんぜん信じられないよ‥‥」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "ボクは自分のことでありながら、\nまったく、『義手』のことが実感できなかった。"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "まあ、当然といえば当然なんだが‥‥"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "１０年もの間、ずっと『自分の腕』だと\n思い込んでいたんだから‥‥"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「やっぱり、ルードのサイボーグも\n　父さんが造ったのかな？」"},
{"id": 34, "speaker": 3, "form": "dlg", "jp": "「父さんがそんなことすると思う？」"},
{"id": 35, "speaker": 3, "form": "choice", "jp": "「絶対しないだろうね‥‥」"},
{"id": 36, "speaker": 3, "form": "choice", "jp": "「わからないよ‥‥」"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "「絶対しないだろうね‥‥」"},
{"id": 38, "speaker": 3, "form": "dlg", "jp": "「そうよねぇ‥‥」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「わからないよ‥‥」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「自分の意志ではやらないかもしれないけど‥‥」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「おどされたりしたら‥‥」"},
{"id": 42, "speaker": 3, "form": "dlg", "jp": "「そうよねぇ‥‥」"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「姉さんはどう思うの？」"},
{"id": 44, "speaker": 3, "form": "dlg", "jp": "「私は父さんを信じるわ！」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「ボクの『あの力』を見ても？」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "ただの中学生のボクが、警察でも歯が立たない\nサイボーグを殴りとばせる。"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "ボクに装着されている『この腕』が\n単なる『義手』なんかじゃないことは"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "間違いないんだ‥‥"},
{"id": 49, "speaker": 3, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「どうなの？」"},
{"id": 51, "speaker": 3, "form": "dlg", "jp": "「やっぱり、父さんを信じるわ‥‥」"},
{"id": 52, "speaker": 3, "form": "dlg", "jp": "「家族だもん‥‥」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「そうだよね‥‥」"},
{"id": 54, "speaker": 2, "form": "dlg", "jp": "その時！"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「コン、コン」"},
{"id": 56, "speaker": 21, "form": "dlg", "jp": "「ちょっといいかしら？」"},
{"id": 57, "speaker": 3, "form": "dlg", "jp": "「は、はい‥‥」"},
{"id": 58, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 59, "speaker": 21, "form": "dlg", "jp": "「失礼するわよ‥‥」"},
{"id": 60, "speaker": 22, "form": "dlg", "jp": "「オジャマします‥‥」"},
{"id": 61, "speaker": 22, "form": "dlg", "jp": "「バタン！」"},
{"id": 62, "speaker": 21, "form": "dlg", "jp": "「ちょっと聞きたいことがあるんだけど\n　いいかしら？」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「かまいませんよ‥‥」"},
{"id": 64, "speaker": 21, "form": "dlg", "jp": "「キミじゃないわ‥‥」"},
{"id": 65, "speaker": 21, "form": "dlg", "jp": "「お姉さんの方によ！」"},
{"id": 66, "speaker": 3, "form": "dlg", "jp": "「はあ、いいですけど‥‥」"},
{"id": 67, "speaker": 21, "form": "dlg", "jp": "「アナタはナゴムくんの腕のことを\n　知っていたみたいだけど‥‥」"},
{"id": 68, "speaker": 3, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 69, "speaker": 21, "form": "dlg", "jp": "「どうして、ドクタージョウコウジは\n　『あんな腕』を？」"},
{"id": 70, "speaker": 3, "form": "dlg", "jp": "「それは弟が事故で‥‥」"},
{"id": 71, "speaker": 21, "form": "dlg", "jp": "「そういう意味じゃないわ！」"},
{"id": 72, "speaker": 3, "form": "dlg", "jp": "「はぁ？」"},
{"id": 73, "speaker": 21, "form": "dlg", "jp": "「どうしてあんなに『危険な腕』を？」"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "「『危険』！？」"},
{"id": 75, "speaker": 21, "form": "dlg", "jp": "「キミには悪いけど、\n　『それ』って『凶器』よねぇ？」"},
{"id": 76, "speaker": 22, "form": "dlg", "jp": "「警視‥‥」"},
{"id": 77, "speaker": 22, "form": "dlg", "jp": "「本人の前で‥‥」"},
{"id": 78, "speaker": 21, "form": "dlg", "jp": "「本人の前だから言うのよ！」"},
{"id": 79, "speaker": 21, "form": "dlg", "jp": "「あんな『凶器』を持っているってことを\n　ちゃんと自覚してもらうためにもね‥‥」"},
{"id": 80, "speaker": 22, "form": "dlg", "jp": "「そうでしょうけど‥‥」"},
{"id": 81, "speaker": 21, "form": "dlg", "jp": "「アキヤマ、ちょっと黙っててもらえる？」"},
{"id": 82, "speaker": 22, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 83, "speaker": 21, "form": "dlg", "jp": "「どうなの？」"},
{"id": 84, "speaker": 3, "form": "dlg", "jp": "「わかりません‥‥」"},
{"id": 85, "speaker": 3, "form": "dlg", "jp": "「私は普通の義手をつけているものだと\n　思っていましたから‥‥」"},
{"id": 86, "speaker": 21, "form": "dlg", "jp": "「まあ、普通はそうよね‥‥」"},
{"id": 87, "speaker": 21, "form": "dlg", "jp": "「事故にあったからって、\n　わざわざ『凶器』を与える必要はないものね」"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って下さいよ！」"},
{"id": 89, "speaker": 2, "form": "choice", "jp": "「『この腕』は『凶器』なんですか？」"},
{"id": 90, "speaker": 2, "form": "choice", "jp": "「『この腕』は『凶器』じゃありません！」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「『この腕』は『凶器』なんですか？」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「『この腕』は『凶器』じゃありません！」"},
{"id": 93, "speaker": 21, "form": "dlg", "jp": "「『サイボーグを殴り倒せる道具』‥‥」"},
{"id": 94, "speaker": 21, "form": "dlg", "jp": "「立派な『凶器』よね‥‥」"},
{"id": 95, "speaker": 21, "form": "dlg", "jp": "「もし、\n　普通の人間とのケンカなんかに使われたら‥‥」"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「ケンカなんか‥‥」"},
{"id": 98, "speaker": 21, "form": "dlg", "jp": "「『もしも』の場合よ‥‥」"},
{"id": 99, "speaker": 2, "form": "dlg", "jp": "「それに‥‥」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥」"},
{"id": 101, "speaker": 21, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「今まで、\n　あんな力が出たことは無かったんです！」"},
{"id": 103, "speaker": 22, "form": "dlg", "jp": "「それは、本当ですか？」"},
{"id": 104, "speaker": 22, "form": "dlg", "jp": "本当だ‥‥"},
{"id": 105, "speaker": 22, "form": "dlg", "jp": "姉さんの話が本当なら、\nボクはもう１０年も父さんの手をつけている。"},
{"id": 106, "speaker": 22, "form": "dlg", "jp": "でも‥‥"},
{"id": 107, "speaker": 22, "form": "dlg", "jp": "級友とのケンカや、体育の授業の時だって‥‥"},
{"id": 108, "speaker": 22, "form": "dlg", "jp": "ただの１度も、あんな力が出たことはなかった。"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「本当です！」"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「もし、いつでもあんなに力がでるのなら\n　とっくに気付いていたハズでしょう！」"},
{"id": 111, "speaker": 22, "form": "dlg", "jp": "「そ、そういえば、そうですね‥‥」"},
{"id": 112, "speaker": 21, "form": "dlg", "jp": "「どういうことなの？」"},
{"id": 113, "speaker": 21, "form": "dlg", "jp": "警視は姉さんの顔を覗き込んだ。"},
{"id": 114, "speaker": 3, "form": "dlg", "jp": "「わかりません‥‥」"},
{"id": 115, "speaker": 3, "form": "dlg", "jp": "「わざわざ、日常生活に支障のでるような\n　機能をつけるとは‥‥」"},
{"id": 116, "speaker": 21, "form": "dlg", "jp": "「じゃあ、いきなり『あの機能』が発動したの？」"},
{"id": 117, "speaker": 3, "form": "dlg", "jp": "「まあ、１０年と言っても‥‥」"},
{"id": 118, "speaker": 3, "form": "dlg", "jp": "「体の成長に合わせて毎年新しいものに\n　交換してましたし‥‥」"},
{"id": 119, "speaker": 3, "form": "dlg", "jp": "「今のバージョンが\n　そういうバージョンなのかも‥‥」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「違うよ！」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「誕生日ごとに付け替えてるんなら\n　この腕は半年以上つけてるんだろう？」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「その間にもあんな力が出たことはなかったよ！」"},
{"id": 123, "speaker": 3, "form": "dlg", "jp": "「たぶん‥‥」"},
{"id": 124, "speaker": 21, "form": "dlg", "jp": "「たぶん？」"},
{"id": 125, "speaker": 3, "form": "dlg", "jp": "「父がその分野で他の研究者より優れているのが\n　『神経とのリンク』ですから‥‥」"},
{"id": 126, "speaker": 21, "form": "dlg", "jp": "「から？」"},
{"id": 127, "speaker": 3, "form": "dlg", "jp": "「ナゴムのなんらかの感情とリンクして\n　発動するような仕組みに‥‥」"},
{"id": 128, "speaker": 21, "form": "dlg", "jp": "「そんなことができるの？」"},
{"id": 129, "speaker": 3, "form": "dlg", "jp": "「よくはわかりませんが‥‥」"},
{"id": 130, "speaker": 3, "form": "dlg", "jp": "「コン、コン」"},
{"id": 131, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 132, "speaker": 11, "form": "dlg", "jp": "「失礼します！」"},
{"id": 133, "speaker": 11, "form": "dlg", "jp": "「バタン！」"},
{"id": 134, "speaker": 21, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 135, "speaker": 11, "form": "dlg", "jp": "「ナゴムくんの腕の検査報告の第一報がきました」"},
{"id": 136, "speaker": 21, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 137, "speaker": 3, "form": "dlg", "jp": "「『検査』って、いったい？」"},
{"id": 138, "speaker": 21, "form": "dlg", "jp": "「あの『カマキリ』と同一の構造になっているか\n　どうかの検査よ‥‥」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「そんなことを調べていったい？」"},
{"id": 140, "speaker": 21, "form": "dlg", "jp": "「もし類似点があるのなら、\n　ルードとドクターの関係がはっきりするでしょう」"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 142, "speaker": 3, "form": "dlg", "jp": "「で、結果は？」"},
{"id": 143, "speaker": 11, "form": "dlg", "jp": "「今の段階の報告では、\n　異なる設計者のモノではないかと‥‥」"},
{"id": 144, "speaker": 3, "form": "dlg", "jp": "「じゃあ、父さんは『ルード』と関係ないんですね！」"},
{"id": 145, "speaker": 11, "form": "dlg", "jp": "「完全には言い切れませんが‥‥」"},
{"id": 146, "speaker": 21, "form": "dlg", "jp": "「まあ、まったく無関係ってことは\n　ありえないと思うけど‥‥」"},
{"id": 147, "speaker": 21, "form": "dlg", "jp": "「あんなに必死で探しているんだから‥‥」"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「まだ、ヤツらが父さんを探している\n　理由はわからないんですか？」"},
{"id": 149, "speaker": 11, "form": "dlg", "jp": "「しっぽをつかませないからねぇ‥‥」"},
{"id": 150, "speaker": 21, "form": "dlg", "jp": "「ふつうに考えるとドクターの知識を\n　サイボーグに活かしたい‥‥」"},
{"id": 151, "speaker": 21, "form": "dlg", "jp": "「もしくは‥‥」"},
{"id": 152, "speaker": 21, "form": "dlg", "jp": "「すでにサイボーグ開発に協力していたけど\n　逃げ出したのでつかまえたい‥‥」"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "「もしその場合は？」"},
{"id": 154, "speaker": 21, "form": "dlg", "jp": "「当然、『処刑』するつもりでしょうね‥‥」"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 156, "speaker": 21, "form": "dlg", "jp": "「まあ、そうならないために\n　私たちも必死になってるのよ‥‥」"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "「ありがとうございます‥‥」"},
{"id": 158, "speaker": 3, "form": "dlg", "jp": "「あのう‥‥」"},
{"id": 159, "speaker": 3, "form": "dlg", "jp": "「何か新しい手がかりは見つかってないんですか？」"},
{"id": 160, "speaker": 21, "form": "dlg", "jp": "「‥‥‥‥！」"},
{"id": 161, "speaker": 21, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 162, "speaker": 21, "form": "dlg", "jp": "「ないわ！」"},
{"id": 163, "speaker": 3, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 164, "speaker": 21, "form": "dlg", "jp": "「あの、わるいけど、\n　ナゴムくんと２人っきりで話をさせてもらえない？」"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "「えっ？」"},
{"id": 166, "speaker": 21, "form": "dlg", "jp": "「ドクタージョウコウジの手がかりがみつかるかも‥‥」"},
{"id": 167, "speaker": 3, "form": "dlg", "jp": "「私はかまいませんが‥‥」"},
{"id": 168, "speaker": 3, "form": "choice", "jp": "「ボクもかまいませんよ」"},
{"id": 169, "speaker": 3, "form": "choice", "jp": "「いえ、それは困ります」"},
{"id": 170, "speaker": 3, "form": "dlg", "jp": "「私はかまいませんが‥‥」"},
{"id": 171, "speaker": 3, "form": "choice", "jp": "「ボクもかまいませんよ」"},
{"id": 172, "speaker": 3, "form": "choice", "jp": "「いえ、それは困ります」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「ボクもかまいませんよ」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "ボクはブラバスキー警視と２人きりで\n話をすることにした。"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "「いえ、それは困ります」"},
{"id": 176, "speaker": 21, "form": "dlg", "jp": "「どうして？」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「もし、警視が『ルード』のスパイだったら‥‥」"},
{"id": 178, "speaker": 21, "form": "dlg", "jp": "「『ルード』の人間が\n　インターポールに入れると思ってるの？」"},
{"id": 179, "speaker": 21, "form": "dlg", "jp": "「それに、キミにはその『腕』があるんだから\n　私１人ぐらい恐くないんじゃないかしら？」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "「それにどうして『２人っきり』なんですか？」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「姉さんに聞かれてマズイことでも？」"},
{"id": 182, "speaker": 21, "form": "dlg", "jp": "「ええ、少しね‥‥」"},
{"id": 183, "speaker": 3, "form": "dlg", "jp": "「‥‥‥！」"},
{"id": 184, "speaker": 3, "form": "dlg", "jp": "「それって、いったい？」"},
{"id": 185, "speaker": 21, "form": "dlg", "jp": "「だから、アナタに聞かせられないことよ！」"},
{"id": 186, "speaker": 21, "form": "dlg", "jp": "「もう一度お願いするけど、ダメかしら？」"},
{"id": 187, "speaker": 21, "form": "choice", "jp": "「断ります！」"},
{"id": 188, "speaker": 21, "form": "choice", "jp": "「わかりました‥‥」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "ボクはブラバスキー警視と２人きりで\n話をすることにした。"},
{"id": 191, "speaker": 21, "form": "dlg", "jp": "「じゃあ、悪いけどみんな出てもらえるかしら？」"},
{"id": 192, "speaker": 3, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 193, "speaker": 3, "form": "dlg", "jp": "「バタン！」"},
{"id": 194, "speaker": 3, "form": "dlg", "jp": "姉さんたちは警視とボクだけを\n部屋に残して出ていってしまった。"},
{"id": 195, "speaker": 3, "form": "dlg", "jp": "部屋の中にはなんとも言えない空気が流れた。"},
{"id": 196, "speaker": 2, "form": "dlg", "jp": "「で、姉さんに聞かれたくない話ってなんですか？」"},
{"id": 197, "speaker": 21, "form": "dlg", "jp": "「率直に言うわ！」"},
{"id": 198, "speaker": 21, "form": "dlg", "jp": "「キミの『その腕』を\n　『分解』させてもらえないかな？」"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥！」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "「な‥‥‥」"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "「何を言うんですか！」"},
{"id": 202, "speaker": 21, "form": "dlg", "jp": "「今のままではヤツらの目的がわからないのよ」"},
{"id": 203, "speaker": 21, "form": "dlg", "jp": "「せめて目的がハッキリすれば‥‥」"},
{"id": 204, "speaker": 21, "form": "dlg", "jp": "「その腕を分解して調べて行けば\n　ルードとの関係がはっきりするんじゃないかしら？」"},
{"id": 205, "speaker": 21, "form": "dlg", "jp": "「正直、今のままでは\n　私たちもどうしていいのかわからないの」"},
{"id": 206, "speaker": 21, "form": "dlg", "jp": "「もし、その腕とルードのサイボーグのモノとが\n　まったく違うのなら」"},
{"id": 207, "speaker": 21, "form": "dlg", "jp": "「ルードはドクターの『知識』を欲しているだけ‥‥」"},
{"id": 208, "speaker": 21, "form": "dlg", "jp": "「その場合は『知識』を手に入れるために\n　いろいろ工作してくるでしょうけど」"},
{"id": 209, "speaker": 21, "form": "dlg", "jp": "「『知識』の元である博士の命を\n　うばったりはしないわね！」"},
{"id": 210, "speaker": 21, "form": "dlg", "jp": "「つまり、アナタたちさえ\n　守っていればそんなに被害が出ることは‥‥」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「もし、ボクの腕とルードのモノとが同じ場合は？」"},
{"id": 212, "speaker": 21, "form": "dlg", "jp": "「その場合はたぶん‥‥」"},
{"id": 213, "speaker": 21, "form": "dlg", "jp": "「ドクターはルードを裏切って\n　逃げているということになるから」"},
{"id": 214, "speaker": 21, "form": "dlg", "jp": "「ドクター自身の命があぶないということに‥‥」"},
{"id": 215, "speaker": 21, "form": "dlg", "jp": "「つまり、一刻も早く\n　ドクタージョウコウジを保護しないと‥‥」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「でも、さっきの検査で\n　この腕とルードのとは関係ないって‥‥」"},
{"id": 217, "speaker": 21, "form": "dlg", "jp": "「まあ、皮膚の上からの検査だから‥‥」"},
{"id": 218, "speaker": 21, "form": "dlg", "jp": "「できれば１００％の検証をしたいの‥‥」"},
{"id": 219, "speaker": 21, "form": "dlg", "jp": "「わかるでしょう？」"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「ま、まあ‥‥」"},
{"id": 221, "speaker": 21, "form": "dlg", "jp": "「じゃあ、お願いだから『その腕』を\n　もう少し調べさせてもらえないかな？」"},
{"id": 222, "speaker": 21, "form": "choice", "jp": "「イヤですよ‥‥」"},
{"id": 223, "speaker": 21, "form": "choice", "jp": "「ちょっと考えさせて下さい」"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "「イヤですよ‥‥」"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "「ちょっと考えさせて下さい」"},
{"id": 226, "speaker": 21, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 227, "speaker": 21, "form": "dlg", "jp": "「しばらく考えておいて‥‥」"},
{"id": 228, "speaker": 21, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "「あのう‥‥」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「このコトは姉さんに‥‥？」"},
{"id": 231, "speaker": 21, "form": "dlg", "jp": "「キミの判断にまかせるわ‥‥」"},
{"id": 232, "speaker": 21, "form": "dlg", "jp": "「バタン！」"},
{"id": 233, "speaker": 21, "form": "dlg", "jp": "そう言って、警視は部屋を出ていった。"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「断ります！」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「ボクの腕は『凶器』じゃありませんし‥‥」"},
{"id": 236, "speaker": 2, "form": "dlg", "jp": "それに‥‥"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "もし、『凶器』として使えたとしても、\n警視さんを殴れる自信もないし‥‥"},
{"id": 238, "speaker": 21, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 239, "speaker": 22, "form": "dlg", "jp": "「ちょっと、いいですか？」"},
{"id": 240, "speaker": 22, "form": "dlg", "jp": "「警視とじゃイヤなら、\n　私と話をさせてくれませんか？」"},
{"id": 241, "speaker": 21, "form": "dlg", "jp": "「アキヤマ！？」"},
{"id": 242, "speaker": 22, "form": "dlg", "jp": "「だいたい、警視が何を話したいかわかりますし‥‥」"},
{"id": 243, "speaker": 22, "form": "choice", "jp": "「誰でも同じです」"},
{"id": 244, "speaker": 22, "form": "choice", "jp": "「そこまで言うなら秋山さんとなら‥‥」"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "「誰でも同じです」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「コソコソとしか言えないようなことに\n　付き合う気はありません！」"},
{"id": 247, "speaker": 22, "form": "dlg", "jp": "「まっ、もっともですけど‥‥」"},
{"id": 248, "speaker": 21, "form": "dlg", "jp": "「仕方ないわね‥‥」"},
{"id": 249, "speaker": 21, "form": "dlg", "jp": "「とにかく、\n　アナタたちはココで大人しくしててもらうわ！」"},
{"id": 250, "speaker": 21, "form": "dlg", "jp": "「それならドクタージョウコウジの方に\n　専念できるし‥‥」"},
{"id": 251, "speaker": 3, "form": "dlg", "jp": "「すいません‥‥」"},
{"id": 252, "speaker": 21, "form": "dlg", "jp": "「とにかく、\n　くれぐれも勝手な行動はとらないように！」"},
{"id": 253, "speaker": 3, "form": "dlg", "jp": "「わかりました」"},
{"id": 254, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 255, "speaker": 3, "form": "dlg", "jp": "「バタン！」"},
{"id": 256, "speaker": 3, "form": "dlg", "jp": "刑事さんたちはボクたちを残して\n部屋を出ていった。"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "「そこまで言うなら秋山さんとなら‥‥」"},
{"id": 258, "speaker": 21, "form": "dlg", "jp": "「ちょっとっ！」"},
{"id": 259, "speaker": 21, "form": "dlg", "jp": "「それって私が信用ならないってこと！？」"},
{"id": 260, "speaker": 22, "form": "dlg", "jp": "「まあまあ‥‥」"},
{"id": 261, "speaker": 22, "form": "dlg", "jp": "「彼ぐらいの年齢なら、\n　女の人と２人きりになるのはイヤがるものです」"},
{"id": 262, "speaker": 21, "form": "dlg", "jp": "「‥‥‥‥‥‥‥」"},
{"id": 263, "speaker": 21, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 264, "speaker": 22, "form": "dlg", "jp": "「大槻警部‥‥」"},
{"id": 265, "speaker": 22, "form": "dlg", "jp": "「ということなんで、\n　ちょっと２人きりにしてもらえますか？」"},
{"id": 266, "speaker": 11, "form": "dlg", "jp": "「わ、わかりました‥‥」"},
{"id": 267, "speaker": 11, "form": "dlg", "jp": "「じゃあ、リツコさん‥‥」"},
{"id": 268, "speaker": 3, "form": "dlg", "jp": "「は、はい‥‥」"},
{"id": 269, "speaker": 22, "form": "dlg", "jp": "「スミマセンね‥‥」"},
{"id": 270, "speaker": 22, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 271, "speaker": 22, "form": "dlg", "jp": "「バタン！」"},
{"id": 272, "speaker": 22, "form": "dlg", "jp": "こうしてボクは秋山刑事と２人きりで\n話をすることになった。"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「で、姉さんに聞かせたくないことって？」"},
{"id": 274, "speaker": 22, "form": "dlg", "jp": "「警視はたぶん‥‥」"},
{"id": 275, "speaker": 22, "form": "dlg", "jp": "「『キミの腕を分解させてくれ』と\n　言いたかったんだと思いますよ‥‥」"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "「ええっ！」"},
{"id": 277, "speaker": 2, "form": "dlg", "jp": "「そんなムチャクチャな！！」"},
{"id": 278, "speaker": 22, "form": "dlg", "jp": "「まあ、生の腕ならそうですが、\n　警視は『機械』だと思っていますから‥‥」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 280, "speaker": 22, "form": "dlg", "jp": "「その腕を分解して調べて行けば\n　ルードとの関係がはっきりすると‥‥」"},
{"id": 281, "speaker": 22, "form": "dlg", "jp": "「正直、今のままでは\n　ワレワレもどうしていいのかわからないです」"},
{"id": 282, "speaker": 22, "form": "dlg", "jp": "「もし、その腕とルードのサイボーグのモノとが\n　まったく違うのなら」"},
{"id": 283, "speaker": 22, "form": "dlg", "jp": "「ルードは博士の『知識』を欲しているだけです」"},
{"id": 284, "speaker": 22, "form": "dlg", "jp": "「その場合は『知識』を手に入れるために\n　いろいろ工作してきますが」"},
{"id": 285, "speaker": 22, "form": "dlg", "jp": "「『知識』の元である博士の命を\n　うばったりはしないでしょうから」"},
{"id": 286, "speaker": 22, "form": "dlg", "jp": "「とりあえず、ナゴムくんたちさえ\n　守っていればそんなに被害が出ることは‥‥」"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "「もし、ボクの腕とルードのモノとが同じ場合は？」"},
{"id": 288, "speaker": 22, "form": "dlg", "jp": "「その場合はたぶん‥‥」"},
{"id": 289, "speaker": 22, "form": "dlg", "jp": "「博士はルードを裏切って\n　逃げているということですから」"},
{"id": 290, "speaker": 22, "form": "dlg", "jp": "「博士自身の命があぶないということになります」"},
{"id": 291, "speaker": 22, "form": "dlg", "jp": "「つまり、一刻も早く博士を保護しないと‥‥」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「でも、さっきの検査で\n　この腕とルードのとは関係ないって‥‥」"},
{"id": 293, "speaker": 22, "form": "dlg", "jp": "「まあ、皮膚の上からの検査ですから‥‥」"},
{"id": 294, "speaker": 22, "form": "dlg", "jp": "「たぶん、\n　警視はネジの１本まで調べたいんですよ‥‥」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "「どうしてそこまで‥‥」"},
{"id": 296, "speaker": 22, "form": "dlg", "jp": "「まあ、『シエン』のようなものも多少は‥‥」"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "「はあ？」"},
{"id": 298, "speaker": 22, "form": "dlg", "jp": "「警視は恋人をルードの\n　サイボーグに殺されてますから‥‥」"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥！」"},
{"id": 300, "speaker": 22, "form": "dlg", "jp": "「まあ『サイボーグ』を恨んでいるんですよ‥‥」"},
{"id": 301, "speaker": 2, "form": "dlg", "jp": "「同情はしますが‥‥」"},
{"id": 302, "speaker": 22, "form": "dlg", "jp": "「ってことは？」"},
{"id": 303, "speaker": 22, "form": "dlg", "jp": "「腕の件は？」"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "「やっぱり、『この腕』は『ボクの腕』なんです」"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「普通の機械と同じように扱われるのは‥‥」"},
{"id": 306, "speaker": 22, "form": "dlg", "jp": "「まあ、そうですよね‥‥」"},
{"id": 307, "speaker": 22, "form": "dlg", "jp": "「わたしもこの腕ですから‥‥」"},
{"id": 308, "speaker": 22, "form": "dlg", "jp": "「わかりました」"},
{"id": 309, "speaker": 22, "form": "dlg", "jp": "「警視には私の方から話をしておきます」"},
{"id": 310, "speaker": 2, "form": "dlg", "jp": "「すみません‥‥」"},
{"id": 311, "speaker": 22, "form": "dlg", "jp": "「で、本当にお父さんの居場所の\n　心当たりはありませんか？」"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "「はい‥‥」"},
{"id": 313, "speaker": 22, "form": "dlg", "jp": "「警視は海外ばかり気にしていますが\n　私は案外国内のような気がするんです」"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "「はぁ‥‥」"},
{"id": 315, "speaker": 22, "form": "dlg", "jp": "「ルードがこの国で探しているということは\n　この国にひそんでいるように思いませんか？」"},
{"id": 316, "speaker": 2, "form": "dlg", "jp": "「そ、そうですね‥‥」"},
{"id": 317, "speaker": 22, "form": "dlg", "jp": "「誰か、博士か身を隠すような所は？」"},
{"id": 318, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 319, "speaker": 22, "form": "dlg", "jp": "「手がかりになりそうなことならなんでもいいんだ」"},
{"id": 320, "speaker": 2, "form": "dlg", "jp": "（インターポールも本当に知らないんだ‥‥）"},
{"id": 321, "speaker": 2, "form": "dlg", "jp": "（ってことは、\n　父さんはそれだけ必死で身を隠してるってこと？）"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "（ボクが手がかりを教えていいのかな？）"},
{"id": 323, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 324, "speaker": 2, "form": "choice", "jp": "「手がかりになるかどうか‥‥」"},
{"id": 325, "speaker": 2, "form": "choice", "jp": "「心当たりはありません‥‥」"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "「心当たりはありません‥‥」"},
{"id": 327, "speaker": 22, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 328, "speaker": 22, "form": "dlg", "jp": "「それは仕方ないね‥‥」"},
{"id": 329, "speaker": 2, "form": "dlg", "jp": "（なんか、気になるなぁ‥‥）"},
{"id": 330, "speaker": 22, "form": "dlg", "jp": "「じゃあ、ありがとう‥‥」"},
{"id": 331, "speaker": 2, "form": "dlg", "jp": "「手がかりになるかどうか‥‥」"},
{"id": 332, "speaker": 22, "form": "dlg", "jp": "「なんでもかまわないよ‥‥」"},
{"id": 333, "speaker": 22, "form": "dlg", "jp": "「博士が行きそうな場所の情報なら‥‥」"},
{"id": 334, "speaker": 2, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 335, "speaker": 2, "form": "choice", "jp": "「親戚の所は？」"},
{"id": 336, "speaker": 2, "form": "choice", "jp": "「三田さんの所は？」"},
{"id": 337, "speaker": 2, "form": "choice", "jp": "「ジョージの所は？」"},
{"id": 338, "speaker": 2, "form": "dlg", "jp": "「親戚の所は？」"},
{"id": 339, "speaker": 22, "form": "dlg", "jp": "「調査済みです‥‥」"},
{"id": 340, "speaker": 2, "form": "dlg", "jp": "「それじゃあ？」"},
{"id": 341, "speaker": 2, "form": "choice", "jp": "「三田さんの所は？」"},
{"id": 342, "speaker": 2, "form": "choice", "jp": "「ジョージの所は？」"},
{"id": 343, "speaker": 2, "form": "dlg", "jp": "「三田さんの所は？」"},
{"id": 344, "speaker": 22, "form": "dlg", "jp": "「『三田さん』って？」"},
{"id": 345, "speaker": 2, "form": "dlg", "jp": "「父さんの『助手』ですよ！」"},
{"id": 346, "speaker": 2, "form": "dlg", "jp": "「ジョージの所は？」"},
{"id": 347, "speaker": 22, "form": "dlg", "jp": "「『ジョージ』？」"},
{"id": 348, "speaker": 2, "form": "dlg", "jp": "「助手の三田さんの好きなタレントです」"},
{"id": 349, "speaker": 22, "form": "dlg", "jp": "「お父さんの顔見知りなのかい？」"},
{"id": 350, "speaker": 2, "form": "dlg", "jp": "「違います」"},
{"id": 351, "speaker": 22, "form": "dlg", "jp": "「それより、『助手の三田さん』って？」"},
{"id": 352, "speaker": 2, "form": "dlg", "jp": "「父さんの『助手』ですよ！」"},
{"id": 353, "speaker": 2, "form": "dlg", "jp": "「調べてないんですか？」"},
{"id": 354, "speaker": 22, "form": "dlg", "jp": "「調べてないってことはないと思いますが‥‥」"},
{"id": 355, "speaker": 22, "form": "dlg", "jp": "「まあ、もう一度調べてみます」"},
{"id": 356, "speaker": 22, "form": "dlg", "jp": "なんか、気になるなぁ‥‥"},
{"id": 357, "speaker": 22, "form": "dlg", "jp": "「じゃあ、ありがとう‥‥」"},
{"id": 358, "speaker": 2, "form": "dlg", "jp": "「あのう、このことは姉さんには？」"},
{"id": 359, "speaker": 22, "form": "dlg", "jp": "「ナゴムくんの判断に任せますよ‥‥」"},
{"id": 360, "speaker": 2, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 361, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 362, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 363, "speaker": 2, "form": "dlg", "jp": "秋山刑事は姉さんを呼び戻すために\n部屋を出ていった。"},
{"id": 364, "speaker": 11, "form": "dlg", "jp": "「まあ、むさ苦しい場所ですが、\n　カンベンしてください」"},
{"id": 365, "speaker": 11, "form": "dlg", "jp": "「スイートルームと比べるとなんですが、\n　警備体制だけでいうとここが一番かと‥‥」"},
{"id": 366, "speaker": 11, "form": "dlg", "jp": "２００５／０７／２３／ＡＭ１０：２５"},
{"id": 367, "speaker": 11, "form": "dlg", "jp": "厳重な警備体制のホテルにまで\n『ルード』が襲撃してきたということで、"},
{"id": 368, "speaker": 11, "form": "dlg", "jp": "ホテルから、警察内に宿泊することになった。"},
{"id": 369, "speaker": 11, "form": "dlg", "jp": "「ここなら、絶対ヤツらは入って来れませんよ！」"},
{"id": 370, "speaker": 11, "form": "dlg", "jp": "「まあ、内部に『ルード』の人間がいれば別ですが‥‥」"},
{"id": 371, "speaker": 21, "form": "dlg", "jp": "「それは『インターポール』に対するイヤミですか？」"},
{"id": 372, "speaker": 11, "form": "dlg", "jp": "「いや、そんなわけでは‥‥」"},
{"id": 373, "speaker": 3, "form": "dlg", "jp": "「で、『シロー』は？\n　あの『アンドロイド』はどうなりました？」"},
{"id": 374, "speaker": 11, "form": "dlg", "jp": "「現在、『科学班』が調査中です‥‥」"},
{"id": 375, "speaker": 11, "form": "dlg", "jp": "「どうやら、"},
{"id": 376, "speaker": 11, "form": "dlg", "jp": "『バッテリー切れ』"},
{"id": 377, "speaker": 11, "form": "dlg", "jp": "みたいなので、\n　朝一で、充電をしているようです」"},
{"id": 378, "speaker": 3, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 379, "speaker": 11, "form": "dlg", "jp": "「しかし、驚きですな‥‥」"},
{"id": 380, "speaker": 11, "form": "dlg", "jp": "「あんな人間みたいな『サイボーグ』が\n　現代の世の中にいるとは‥‥」"},
{"id": 381, "speaker": 21, "form": "dlg", "jp": "「"},
{"id": 382, "speaker": 21, "form": "dlg", "jp": "『アンドロイド』"},
{"id": 383, "speaker": 21, "form": "dlg", "jp": "です！」"},
{"id": 384, "speaker": 21, "form": "dlg", "jp": "「『アンドロイド』と『サイボーグ』は\n　まったくの別モノ」"},
{"id": 385, "speaker": 21, "form": "dlg", "jp": "「一緒にしないように！」"},
{"id": 386, "speaker": 11, "form": "dlg", "jp": "「そんなに違わないように思いますが？」"},
{"id": 387, "speaker": 11, "form": "choice", "jp": "「違いますよ！」"},
{"id": 388, "speaker": 11, "form": "choice", "jp": "「似たようなもんですね。」"},
{"id": 389, "speaker": 2, "form": "dlg", "jp": "「違いますよ！」"},
{"id": 390, "speaker": 11, "form": "dlg", "jp": "「どう、違うんだい？」"},
{"id": 391, "speaker": 11, "form": "choice", "jp": "「サイボーグは人間、アンドロイドはそうじゃない。」"},
{"id": 392, "speaker": 11, "form": "choice", "jp": "「サイボーグは生き物、アンドロイドは機械。」"},
{"id": 393, "speaker": 11, "form": "choice", "jp": "「サイボーグは『作戦』アンドロイドは『０指令』。」"},
{"id": 394, "speaker": 2, "form": "dlg", "jp": "「サイボーグは人間、アンドロイドはそうじゃない」"},
{"id": 395, "speaker": 11, "form": "dlg", "jp": "「うむ、よくわからんなぁ‥‥」"},
{"id": 396, "speaker": 21, "form": "dlg", "jp": "「『サイボーグ』は人工的に改造された人間」"},
{"id": 397, "speaker": 21, "form": "dlg", "jp": "「『アンドロイド』は人工的に造られた人間」"},
{"id": 398, "speaker": 11, "form": "dlg", "jp": "「『ライダー』と『アトム』の違いみたいなもんだな」"},
{"id": 399, "speaker": 2, "form": "dlg", "jp": "「サイボーグは生き物、アンドロイドは機械。」"},
{"id": 400, "speaker": 11, "form": "dlg", "jp": "「うむ、よくわからんなぁ‥‥」"},
