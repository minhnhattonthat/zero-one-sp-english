{"id": 517, "speaker": 21, "form": "dlg", "jp": "「"},
{"id": 518, "speaker": 21, "form": "dlg", "jp": "最強の人間"},
{"id": 519, "speaker": 21, "form": "dlg", "jp": "になれるでしょうね‥‥」"},
{"id": 520, "speaker": 2, "form": "dlg", "jp": "「最強の人間‥‥」"},
{"id": 521, "speaker": 12, "form": "dlg", "jp": "「失礼しますっ！」"},
{"id": 522, "speaker": 11, "form": "dlg", "jp": "「どうしたっ？」"},
{"id": 523, "speaker": 12, "form": "dlg", "jp": "「『アンドロイド』の充電が終了したそうです」"},
{"id": 524, "speaker": 11, "form": "dlg", "jp": "「わかった、すぐ行く！」"},
{"id": 525, "speaker": 21, "form": "dlg", "jp": "「念のため彼らも同席してもらったら？」"},
{"id": 526, "speaker": 11, "form": "dlg", "jp": "「そ、そうですな‥‥」"},
{"id": 527, "speaker": 11, "form": "dlg", "jp": "「じゃあ、一緒に来てもらえますか？」"},
{"id": 528, "speaker": 3, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 529, "speaker": 3, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 530, "speaker": 3, "form": "dlg", "jp": "「バタン！」"},
{"id": 531, "speaker": 3, "form": "dlg", "jp": "ボクたちはあの『アンドロイド』の事情聴取に\n立ち会うことになった。"}
