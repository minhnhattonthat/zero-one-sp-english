[
{"id": 0, "speaker": 31, "form": "dlg", "jp": "「オレなんて、なんの手伝いもできなかったからな‥‥」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "「気にしなくていいよ‥‥」"},
{"id": 2, "speaker": 31, "form": "dlg", "jp": "「今度、一杯おごってやるよ！」"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "「まだ、未成年だよ‥‥」"},
{"id": 4, "speaker": 31, "form": "dlg", "jp": "「じゃあ、５年後におごってやるよ！」"},
{"id": 5, "speaker": 31, "form": "dlg", "jp": "「５年分の利子をつけて‥‥」"},
{"id": 6, "speaker": 35, "form": "dlg", "jp": "「オレたちって究極の『正義の味方』だよな！」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「『人間』が『正義』ならね！」"},
{"id": 8, "speaker": 35, "form": "dlg", "jp": "「正義だよ！」"},
{"id": 9, "speaker": 35, "form": "dlg", "jp": "「たぶん、今回のことで、\n　世界中が平和の大切さに気付いたはずだから‥‥」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「松尾さんは立派だね！」"},
{"id": 11, "speaker": 35, "form": "dlg", "jp": "「ナゴムくんも立派な大人になれよ！」"},
{"id": 12, "speaker": 27, "form": "dlg", "jp": "「ちょっと見ない間に立派になったんだな‥‥」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「男子は３日みないと成長してるって言うだろう？」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「父さんは家を空けすぎなんだよ‥‥」"},
{"id": 15, "speaker": 27, "form": "dlg", "jp": "「そうだったな‥‥」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「まあ、もうちょっと家に寄り付くようにしてよ‥‥」"},
{"id": 17, "speaker": 27, "form": "dlg", "jp": "「そうさせてもらうよ‥‥」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「そうだ！」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「父さん、もう、シローの『命令』を解除してあげてよ！」"},
{"id": 20, "speaker": 27, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 21, "speaker": 27, "form": "dlg", "jp": "「もうシローが守らなくても、大丈夫だしな‥‥」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「シロー‥‥」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「いままでありがとう‥‥」"},
{"id": 24, "speaker": 5, "form": "dlg", "jp": "「ボクのしたことなんて、\n　ナゴムのしたことに比べたら大したことないよ！」"},
{"id": 25, "speaker": 5, "form": "dlg", "jp": "「それに、これからもナゴムたちの\n　力になってあげたいし‥‥」"},
{"id": 26, "speaker": 5, "form": "dlg", "jp": "「命令じゃなく、個人の意志でだけど‥‥」"},
{"id": 27, "speaker": 3, "form": "dlg", "jp": "「おかえりなさい‥‥」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「ただいま‥‥」"},
{"id": 29, "speaker": 3, "form": "dlg", "jp": "「なんか、大変な夏休みだったわね‥‥」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 31, "speaker": 3, "form": "dlg", "jp": "「宿題はできてるの？」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "「ばっちりさ！」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「シローに手伝ってもらうから‥‥」"},
{"id": 34, "speaker": 5, "form": "dlg", "jp": "「自分の意志で断わらせてもらうよ！」"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 36, "speaker": 3, "form": "dlg", "jp": "「フフフフフフ‥‥‥」"},
{"id": 37, "speaker": 3, "form": "dlg", "jp": "「がんばりなさいってことね！」"},
{"id": 38, "speaker": 13, "form": "dlg", "jp": "「宿題なんて、気にすることないよ！」"},
{"id": 39, "speaker": 13, "form": "dlg", "jp": "「オレたちは『世界の救世主』だぜ！」"},
{"id": 40, "speaker": 13, "form": "dlg", "jp": "「まあ、『ゲーマー』の歴史の教科書には\n　たぶん、載るだろうな？」"},
{"id": 41, "speaker": 13, "form": "dlg", "jp": "「『角川ツトムに\n　　ゲームで勝とうと思ってはいけない』って！」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 43, "speaker": 13, "form": "dlg", "jp": "「日本に帰ったら、大騒ぎなんだろうな？」"},
{"id": 44, "speaker": 13, "form": "dlg", "jp": "「『世界を救った天才ゲーマー関口ツトム！！』」"},
{"id": 45, "speaker": 13, "form": "dlg", "jp": "「もう気軽にゲームセンターにもいけないな、\n　マスコミに騒がれて‥‥」"},
{"id": 46, "speaker": 13, "form": "dlg", "jp": "「〆〇×♀★☆％＄￠＠§∞＞≠℃￥‥‥」"},
{"id": 47, "speaker": 13, "form": "dlg", "jp": "「※〇％＄×★☆仝〒≠℃￥￠＠§♀∞＞‥‥」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「どうしたんだ？」"},
{"id": 49, "speaker": 13, "form": "dlg", "jp": "「‥‥！！」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「オイ！」"},
{"id": 51, "speaker": 46, "form": "dlg", "jp": "「大丈夫です‥‥」"},
{"id": 52, "speaker": 46, "form": "dlg", "jp": "「ちょっと、気絶していただいただけですから‥‥」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 54, "speaker": 46, "form": "dlg", "jp": "「あと、ついでにココの記憶も消しておきました」"},
{"id": 55, "speaker": 46, "form": "dlg", "jp": "「あとあと、問題になりそうなので‥‥」"},
{"id": 56, "speaker": 46, "form": "dlg", "jp": "「ピリ、彼をお家に戻してあげて！」"},
{"id": 57, "speaker": 15, "form": "dlg", "jp": "「やったわね、ナゴムちゃん！」"},
{"id": 58, "speaker": 15, "form": "dlg", "jp": "「これで、もう大丈夫なのね？」"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 60, "speaker": 15, "form": "dlg", "jp": "「アリガトウ‥‥」"},
{"id": 61, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん‥‥」"},
{"id": 62, "speaker": 15, "form": "dlg", "jp": "「結局、いつもこうなのよね‥‥」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「何が？」"},
{"id": 64, "speaker": 15, "form": "dlg", "jp": "「世話をやいているつもりなのに\n　いつも私が助けてもらっているって感じ‥‥」"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "「だって『約束』だろう？」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「守ってやるって‥‥」"},
{"id": 67, "speaker": 15, "form": "dlg", "jp": "「そうだったわね‥‥」"},
{"id": 68, "speaker": 16, "form": "dlg", "jp": "「私たちが勝ったのね‥‥」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 70, "speaker": 16, "form": "dlg", "jp": "「よかった‥‥」"},
{"id": 71, "speaker": 16, "form": "dlg", "jp": "「アリガトウ‥‥」"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "「礼を言うのはボクの方だよ！」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「長尾が助言してくれなかったら‥‥」"},
{"id": 74, "speaker": 16, "form": "dlg", "jp": "「本当に常光寺くんはやさしいのね‥‥」"},
{"id": 75, "speaker": 16, "form": "dlg", "jp": "「まあ、それが常光寺くんのいいとこなんだけど‥‥」"},
{"id": 76, "speaker": 16, "form": "dlg", "jp": "「でも、あんまりみんなに優しいとかんちがいされるわよ！」"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "「かんちがい？」"},
{"id": 78, "speaker": 16, "form": "dlg", "jp": "「もしかしたら、アキラもかんちがいしてるかも‥‥」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「かんちがいじゃないよ！」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「長尾には優しくしてるつもいりだよ！」"},
{"id": 81, "speaker": 16, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 82, "speaker": 16, "form": "dlg", "jp": "「でも、なるべくなら\n　アキラにだけ優しくして欲しいんだけど‥‥」"},
{"id": 83, "speaker": 18, "form": "dlg", "jp": "「私たちが勝ったのね‥‥」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 85, "speaker": 18, "form": "dlg", "jp": "「よかった‥‥」"},
{"id": 86, "speaker": 18, "form": "dlg", "jp": "「アリガトウ‥‥」"},
{"id": 87, "speaker": 18, "form": "dlg", "jp": "「これでもう、\n　『恐い夢』を見る心配は、しなくていいのね？」"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "「どうだろう？」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「ゲーマー以外にも、恐いものはいっぱいあるだろう？」"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "「オバケとか、カミナリとか‥‥」"},
{"id": 91, "speaker": 18, "form": "dlg", "jp": "「『ゲーマーが恐い』んじゃあなくて‥‥」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「‥‥？」"},
{"id": 93, "speaker": 18, "form": "dlg", "jp": "「常光寺くんが巻き込まれるのが『恐かった』の‥‥」"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "「それは、どうも‥‥」"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "「なんか、家族全員巻き込んじゃったわね‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「いいよ‥‥」"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "「人類全員が巻き込まれるより‥‥」"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "「そう言ってくれると助かるわ‥‥」"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "「まあ、すでに助かったんだけどね‥‥」"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "「これで、『Ｅ－ｇｒｏ』も解散ね‥‥」"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「ジーンはこれからどうするの？」"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "「組織がお金を出してくれるって言うから、\n　『学校』へ行こうと思ってるの‥‥」"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "「実は私、学校に行ったことないんだ‥‥」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「がんばってね‥‥」"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "「もう、会うことはないのかな？」"},
{"id": 108, "speaker": 29, "form": "dlg", "jp": "「私たち‥‥」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「かもね‥‥」"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "「勉強がんばってね！」"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "「ナゴムもね‥‥」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "こうして、『人類対ゲーマー』のゲームは\n『人類』の勝利で幕を下ろした。"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "そして、ボクの義務教育最後の夏休みも終わり、"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "ボクは普通の中学生に戻った。"},
{"id": 118, "speaker": 11, "form": "dlg", "jp": "「ナゴムくん！」"},
{"id": 119, "speaker": 11, "form": "dlg", "jp": "「今から学校かい？」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「警部さん！」"},
{"id": 121, "speaker": 11, "form": "dlg", "jp": "「ハハハハハハハハ‥‥」"},
{"id": 122, "speaker": 11, "form": "dlg", "jp": "「実はもう警部じゃないんだ‥‥」"},
{"id": 123, "speaker": 11, "form": "dlg", "jp": "「ただの刑事だよ‥‥」"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「？？？」"},
{"id": 125, "speaker": 11, "form": "dlg", "jp": "「『インターポール』に移ったんだ‥‥」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「そうなんですか‥‥」"},
{"id": 127, "speaker": 11, "form": "dlg", "jp": "「まあ、大変だよ‥‥」"},
{"id": 128, "speaker": 21, "form": "dlg", "jp": "「オオツキ！！」"},
{"id": 129, "speaker": 21, "form": "dlg", "jp": "「こんなところで、何サボってるの！？」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「警視さん！！」"},
{"id": 131, "speaker": 21, "form": "dlg", "jp": "「あら、ひさしぶり！」"},
{"id": 132, "speaker": 21, "form": "dlg", "jp": "「ちょっと会わないうちに\n　りりしい顔つきになったわね？」"},
{"id": 133, "speaker": 21, "form": "dlg", "jp": "「じゃあ、これで失礼するわね！」"},
{"id": 134, "speaker": 21, "form": "dlg", "jp": "「行くわよっ！」"},
{"id": 135, "speaker": 11, "form": "dlg", "jp": "「ハイ！」"},
{"id": 136, "speaker": 14, "form": "dlg", "jp": "「しかし、『宇宙からの電磁波』で\n　世界中がパニックになるとは思っていなかったなぁ」"},
{"id": 137, "speaker": 14, "form": "dlg", "jp": "「まさに『機械文明の落とし穴』って感じだよな！」"},
{"id": 138, "speaker": 14, "form": "dlg", "jp": "「ツトム、オマエもゲームばっかしてないで、\n　体を鍛えた方がいいぞ！」"},
{"id": 139, "speaker": 13, "form": "dlg", "jp": "「そうなのかなぁ？」"},
{"id": 140, "speaker": 13, "form": "dlg", "jp": "「なんか、オレのゲームの知識が\n　世界の役に立つ時があると思うんだけどなぁ‥‥」"},
{"id": 141, "speaker": 14, "form": "dlg", "jp": "「ないよそんなの！」"},
{"id": 142, "speaker": 13, "form": "dlg", "jp": "「そうなのかなぁ？」"},
{"id": 143, "speaker": 13, "form": "dlg", "jp": "そして‥‥"},
{"id": 144, "speaker": 13, "form": "dlg", "jp": "百年後‥‥"},
{"id": 145, "speaker": 6, "form": "dlg", "jp": "「この『銅像』って、なんか意味あるの？」"},
{"id": 146, "speaker": 7, "form": "dlg", "jp": "「オマエ、知らないのか！？」"},
{"id": 147, "speaker": 6, "form": "dlg", "jp": "「有名なのかよ！？」"},
{"id": 148, "speaker": 7, "form": "dlg", "jp": "「ホラ、１００年前に『世界を救った少年』の銅像だよ‥‥」"},
{"id": 149, "speaker": 6, "form": "dlg", "jp": "「えっ、コレがそうなの？」"},
{"id": 150, "speaker": 7, "form": "dlg", "jp": "「そうだよ！」"},
{"id": 151, "speaker": 7, "form": "dlg", "jp": "「この少年のおかげで、今の世界があるんだよ！」"},
{"id": 152, "speaker": 6, "form": "dlg", "jp": "「そうなのか‥‥」"},
{"id": 153, "speaker": 6, "form": "dlg", "jp": "そして‥‥"},
{"id": 154, "speaker": 6, "form": "dlg", "jp": "半年後‥‥"},
{"id": 155, "speaker": 14, "form": "dlg", "jp": "「おいナゴム、何してんだよ！」"},
{"id": 156, "speaker": 14, "form": "dlg", "jp": "「グズグズしてると、始まっちまうぞ！」"},
{"id": 157, "speaker": 13, "form": "dlg", "jp": "「早く来いよ！」"},
{"id": 158, "speaker": 13, "form": "dlg", "jp": "「先に行ってるからな！」"},
{"id": 159, "speaker": 14, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 160, "speaker": 14, "form": "dlg", "jp": "「ホント、良かったな！」"},
{"id": 161, "speaker": 14, "form": "dlg", "jp": "「マジで、いろいろあったもんな‥‥」"},
{"id": 162, "speaker": 14, "form": "dlg", "jp": "「まぁ、今度また何かあったら、オレに言えよ！」"},
{"id": 163, "speaker": 14, "form": "dlg", "jp": "「じゃぁ、そろそろ行こうぜ！」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「まさか、日本の学校に転校してくるとは‥‥」"},
{"id": 165, "speaker": 29, "form": "dlg", "jp": "「アラ、どこの学校って言わなかったっけ？」"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "「それに、ジーンは１７だろう？」"},
{"id": 167, "speaker": 29, "form": "dlg", "jp": "「少し遅れてるから、中学からやり直すのよ！」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「遅れてるって、ボクより成績いいクセに‥‥」"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "「フフフフフフ‥‥」"},
{"id": 170, "speaker": 29, "form": "dlg", "jp": "「だから、ナゴムが行く高校くらいなら、\n　私も入学できるわよЬЫ」"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "「さぁ、始まるわよ！」"},
{"id": 172, "speaker": 29, "form": "dlg", "jp": "「行きましょう！」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「どう‥‥？」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「最近、『夢』は見ないの？」"},
{"id": 175, "speaker": 15, "form": "dlg", "jp": "「見たわよっ！」"},
{"id": 176, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃんが\n　『一生守ってくれる』って約束する『夢』ЬЫ」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「‥‥！？」"},
{"id": 178, "speaker": 15, "form": "dlg", "jp": "「知ってると思うけど、\n　私の『夢』は絶対『現実』になるのよ！」"},
{"id": 179, "speaker": 15, "form": "dlg", "jp": "「さぁ、始まるわよ！」"},
{"id": 180, "speaker": 15, "form": "dlg", "jp": "「行きましょう！」"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "「どう‥‥？」"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "「最近、『夢』は見ないの？」"},
{"id": 183, "speaker": 16, "form": "dlg", "jp": "「それが‥‥」"},
{"id": 184, "speaker": 16, "form": "dlg", "jp": "「見ちゃったのよ！！」"},
{"id": 185, "speaker": 16, "form": "dlg", "jp": "「常光寺くんが、アキラと手をつないで学校に通う夢ЬЫ」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「‥‥！？」"},
{"id": 187, "speaker": 16, "form": "dlg", "jp": "「知ってると思うけど、\n　アキラの『夢』は絶対『現実』になるから‥‥」"},
{"id": 188, "speaker": 16, "form": "dlg", "jp": "「さぁ、始まるわよ！」"},
{"id": 189, "speaker": 16, "form": "dlg", "jp": "「行きましょう！」"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "「どう‥‥？」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「最近、『夢』は見ないの？」"},
{"id": 192, "speaker": 18, "form": "dlg", "jp": "「見たわ！！」"},
