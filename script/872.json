[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／２９／ＰＭ０４：２０"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「シュン！」"},
{"id": 2, "speaker": 35, "form": "dlg", "jp": "「とりあえず、上手くいったね‥‥」"},
{"id": 3, "speaker": 29, "form": "dlg", "jp": "「まあ、これで『Ｅ－ｇｒｏ』のことが\n　バレるまでの時間稼ぎができるわね‥‥」"},
{"id": 4, "speaker": 29, "form": "dlg", "jp": "「でも、なんでアメリカとか中国とかの\n　大国じゃなく、わざわざ日本なんだ？」"},
{"id": 5, "speaker": 29, "form": "dlg", "jp": "「なんか理由があるかもね‥‥」"},
{"id": 6, "speaker": 51, "form": "dlg", "jp": "「理由っていったい？」"},
{"id": 7, "speaker": 29, "form": "dlg", "jp": "「わからないわ‥‥」"},
{"id": 8, "speaker": 18, "form": "dlg", "jp": "「理由っていったい？」"},
{"id": 9, "speaker": 29, "form": "dlg", "jp": "「わからないわ‥‥」"},
{"id": 10, "speaker": 15, "form": "dlg", "jp": "「おかえりなさい！」"},
{"id": 11, "speaker": 15, "form": "dlg", "jp": "「テレビで観てたわよ！」"},
{"id": 12, "speaker": 31, "form": "dlg", "jp": "「テレビに映ってたのか！？」"},
{"id": 13, "speaker": 15, "form": "dlg", "jp": "「ううん、みんなの姿は映ってなかったけど‥‥」"},
{"id": 14, "speaker": 29, "form": "dlg", "jp": "「映るわけないじゃない！」"},
{"id": 15, "speaker": 29, "form": "dlg", "jp": "「そのためのスーツなんだから‥‥」"},
{"id": 16, "speaker": 31, "form": "dlg", "jp": "「まあ、そうだけど‥‥」"},
{"id": 17, "speaker": 15, "form": "dlg", "jp": "「アレってナゴムちゃんがやったんでしょう？」"},
{"id": 18, "speaker": 15, "form": "dlg", "jp": "「スゴイわね！」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「そんなことより姉さんには？」"},
{"id": 20, "speaker": 15, "form": "dlg", "jp": "「ちゃんと説明しておいたわよ‥‥」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「で？」"},
{"id": 22, "speaker": 15, "form": "dlg", "jp": "「さあ、わかってくれたみたいだったけど‥‥」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「今どこに？」"},
{"id": 24, "speaker": 15, "form": "dlg", "jp": "「あの『シローさん』と下に降りていったけど」"},
{"id": 25, "speaker": 16, "form": "dlg", "jp": "「おかえりなさい！」"},
{"id": 26, "speaker": 16, "form": "dlg", "jp": "「テレビで観てたわよっ！」"},
{"id": 27, "speaker": 31, "form": "dlg", "jp": "「テレビに映ってたのか！？」"},
{"id": 28, "speaker": 16, "form": "dlg", "jp": "「ううん、みんなの姿は映ってなかったけど‥‥」"},
{"id": 29, "speaker": 29, "form": "dlg", "jp": "「映るわけないじゃない！」"},
