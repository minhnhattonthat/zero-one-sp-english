{"id": 38, "speaker": 2, "form": "dlg", "jp": "「今どこに？」"},
{"id": 39, "speaker": 16, "form": "dlg", "jp": "「あの『シローさん』と下に降りていったけど」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「わるいけど、姉さんと話してきていいかな？」"},
{"id": 41, "speaker": 29, "form": "dlg", "jp": "「いいわよ‥‥」"},
{"id": 42, "speaker": 29, "form": "dlg", "jp": "「じっくり話してきなさい‥‥」"},
{"id": 43, "speaker": 29, "form": "dlg", "jp": "「あと、トモとアスカも家族の人に\n　キチンと話をしてきなさい！」"},
{"id": 44, "speaker": 35, "form": "dlg", "jp": "「まあ、ウチはすんなりＯＫしてくれると思うよ！」"},
{"id": 45, "speaker": 31, "form": "dlg", "jp": "「なんか、そんな感じがするよ‥‥」"},
{"id": 46, "speaker": 31, "form": "dlg", "jp": "「でも、トモの所はそんなに簡単にいかないだろう？」"},
{"id": 47, "speaker": 31, "form": "dlg", "jp": "「なんなら、ついていってやろうか？」"},
{"id": 48, "speaker": 31, "form": "dlg", "jp": "「いっしょに説得してやるよ！」"},
{"id": 49, "speaker": 51, "form": "dlg", "jp": "「ウチは大丈夫や！」"},
{"id": 50, "speaker": 51, "form": "dlg", "jp": "「説明したら絶対わかってくれる！」"},
{"id": 51, "speaker": 51, "form": "dlg", "jp": "「『正義』のためならなんでも許してくれる！」"},
{"id": 52, "speaker": 31, "form": "dlg", "jp": "「いい家族だな！」"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "「あと、アイコとアスカも家族の人に\n　キチンと話をしてきなさい！」"},
{"id": 54, "speaker": 35, "form": "dlg", "jp": "「まあ、ウチはすんなりＯＫしてくれると思うよ！」"},
{"id": 55, "speaker": 31, "form": "dlg", "jp": "「なんか、そんな感じがするよ‥‥」"},
{"id": 56, "speaker": 31, "form": "dlg", "jp": "「でも、アイコの所はそんなに簡単にいかないだろう？」"},
{"id": 57, "speaker": 31, "form": "dlg", "jp": "「なんなら、ついていってやろうか？」"},
{"id": 58, "speaker": 31, "form": "dlg", "jp": "「いっしょに説得してやるよ！」"},
{"id": 59, "speaker": 15, "form": "dlg", "jp": "「いいわよ」"},
{"id": 60, "speaker": 15, "form": "dlg", "jp": "「それぐらい自分でちゃんと説明するから」"},
{"id": 61, "speaker": 15, "form": "dlg", "jp": "「ウチのお母さん、モノわかりいい人だし‥‥」"},
{"id": 62, "speaker": 15, "form": "dlg", "jp": "「まあ、\n　お父さんを説得するのは難しいかもしれないけど‥‥」"},
{"id": 63, "speaker": 15, "form": "dlg", "jp": "「ＵＦＯやロボットを破壊するよりは\n　簡単なことだと思うの‥‥」"},
{"id": 64, "speaker": 31, "form": "dlg", "jp": "「エライ、よく言った！」"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "「あと、アキラとアスカも家族の人に\n　キチンと話をしてきなさい！」"},
{"id": 66, "speaker": 35, "form": "dlg", "jp": "「まあ、ウチはすんなりＯＫしてくれると思うよ！」"},
{"id": 67, "speaker": 31, "form": "dlg", "jp": "「なんか、そんな感じがするよ‥‥」"},
{"id": 68, "speaker": 31, "form": "dlg", "jp": "「でも、アキラの所はそんなに簡単にいかないだろう？」"},
{"id": 69, "speaker": 31, "form": "dlg", "jp": "「なんなら、ついていってやろうか？」"},
{"id": 70, "speaker": 31, "form": "dlg", "jp": "「いっしょに説得してやるよ！」"},
{"id": 71, "speaker": 16, "form": "dlg", "jp": "「アラ、ウチは多分大丈夫よ！」"},
{"id": 72, "speaker": 16, "form": "dlg", "jp": "「みんな私のすることに興味ないみたいだから‥‥」"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「まあ、あんな服つくってても\n　何も注意しないんだものね」"},
{"id": 74, "speaker": 16, "form": "dlg", "jp": "「説明しても、\n　マンガか小説の話と思うぐらいじゃないかしら？」"},
{"id": 75, "speaker": 16, "form": "dlg", "jp": "「大人ってそんなもんでしょう？」"},
{"id": 76, "speaker": 31, "form": "dlg", "jp": "「なんて返事したらいいのやら‥‥」"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "「あと、ナナセとアスカも家族の人に\n　キチンと話をしてきなさい！」"},
{"id": 78, "speaker": 35, "form": "dlg", "jp": "「まあ、ウチはすんなりＯＫしてくれると思うよ！」"},
{"id": 79, "speaker": 31, "form": "dlg", "jp": "「なんか、そんな感じがするよ‥‥」"},
{"id": 80, "speaker": 31, "form": "dlg", "jp": "「でも、ナナセの所はそんなに簡単にいかないだろう？」"},
{"id": 81, "speaker": 31, "form": "dlg", "jp": "「なんなら、ついていってやろうか？」"},
{"id": 82, "speaker": 31, "form": "dlg", "jp": "「いっしょに説得してやるよ！」"},
{"id": 83, "speaker": 18, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 84, "speaker": 18, "form": "dlg", "jp": "「ウチの家族を説得するのは難しいかも‥‥」"},
{"id": 85, "speaker": 31, "form": "dlg", "jp": "「オレが説得してやるよ！」"},
{"id": 86, "speaker": 18, "form": "dlg", "jp": "「ダメよ！」"},
{"id": 87, "speaker": 18, "form": "dlg", "jp": "「男の人と一緒に外国に行きます！」"},
{"id": 88, "speaker": 18, "form": "dlg", "jp": "「なんて言ったら、余計に反対されちゃうわ！」"},
{"id": 89, "speaker": 18, "form": "dlg", "jp": "「１人で、きちんと説明してくるわ」"},
{"id": 90, "speaker": 18, "form": "dlg", "jp": "「あのＵＦＯのこともあるんだから、\n　ある程度はわかってくれると思うの」"},
{"id": 91, "speaker": 18, "form": "dlg", "jp": "「それでダメだったら、勝手に飛び出してくるわ！」"},
{"id": 92, "speaker": 31, "form": "dlg", "jp": "「なんて返事したらいいのやら‥‥」"},
{"id": 93, "speaker": 29, "form": "dlg", "jp": "「じゃあ、私たちもホテルに戻って\n　出発の準備をしましょう！」"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "「８時にここに集合ということで！」"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "ボクたちは一旦解散することになった。"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "（さてと、姉さんに説明しないとな‥‥）"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "ボクはリビングに降りて行くことにした。"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 99, "speaker": 5, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 100, "speaker": 5, "form": "dlg", "jp": "「戻ってきたんだね‥‥」"},
{"id": 101, "speaker": 3, "form": "dlg", "jp": "「お帰りなさい‥‥」"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「ただいま‥‥」"},
{"id": 103, "speaker": 3, "form": "dlg", "jp": "「テレビ観てたわよ‥‥」"},
{"id": 104, "speaker": 3, "form": "dlg", "jp": "「ごくろうさま‥‥」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 106, "speaker": 3, "form": "dlg", "jp": "「話はシローから聞いたわ‥‥」"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 108, "speaker": 3, "form": "dlg", "jp": "「また、大変なことに巻き込まれたみたいね‥‥」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「やんなっちゃうね‥‥」"},
{"id": 110, "speaker": 3, "form": "dlg", "jp": "「テレビに映ってなかったけど、\n　あれ、ナゴムたちが破壊したの？」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "「まあね‥‥」"},
{"id": 112, "speaker": 3, "form": "dlg", "jp": "「テレビを観ながら、\n　もう、『おかえり』って言えないんじゃないかって」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「大丈夫だよ、あの程度のものなら‥‥」"},
{"id": 114, "speaker": 3, "form": "dlg", "jp": "「また、出て行くんでしょう？」"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「いよいよ『決戦』らしいよ‥‥」"},
{"id": 117, "speaker": 3, "form": "dlg", "jp": "「自信はあるの？」"},
{"id": 118, "speaker": 3, "form": "choice", "jp": "「まあまあかなぁ‥‥」"},
{"id": 119, "speaker": 3, "form": "choice", "jp": "「ばっちりさ！」"},
{"id": 120, "speaker": 3, "form": "choice", "jp": "「ジシンはマグニチュード６」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「まあまあかなぁ‥‥」"},
{"id": 122, "speaker": 5, "form": "dlg", "jp": "「『ミ◯キーはまあまあの味』」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「姉さんくだらないこと教えたんだね‥‥」\n"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「ばっちりさ！」"},
{"id": 125, "speaker": 3, "form": "dlg", "jp": "「ばっちりどうなの？」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「フグのおなべ」"},
{"id": 127, "speaker": 3, "form": "dlg", "jp": "「それがどうかしたの？」"},
{"id": 128, "speaker": 5, "form": "dlg", "jp": "「リツコ、関西ではフグのおなべのことを\n　『てっちり』っていうんだよ」"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "「姉さんくだらないこと教えたんだね‥‥」\n"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「ジシンはマグニチュード６」"},
{"id": 131, "speaker": 5, "form": "dlg", "jp": "「ナゴム、リツコが聞いたジシンって\n　そのジシンのことじゃないよ！」"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "「姉さんくだらないこと教えたんだね‥‥」"},
{"id": 133, "speaker": 3, "form": "dlg", "jp": "「フフフフフ‥‥」"},
{"id": 134, "speaker": 3, "form": "dlg", "jp": "「そのぶんじゃあ、大丈夫そうね‥‥」"},
{"id": 135, "speaker": 2, "form": "dlg", "jp": "「うん、大丈夫だよ」\n"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「多分‥‥」\n"},
{"id": 137, "speaker": 5, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 138, "speaker": 5, "form": "dlg", "jp": "「ボクに手伝えることは？」"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「さあ、わからない‥‥」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「とにかく、姉さんのことを‥‥」"},
{"id": 141, "speaker": 5, "form": "dlg", "jp": "「ああ、それならまかしてくれ‥‥」"},
{"id": 142, "speaker": 5, "form": "dlg", "jp": "「リツコたちを守るコマンドは\n　まだキャンセルされていないから‥‥」"},
{"id": 143, "speaker": 5, "form": "dlg", "jp": "「何があっても守ってみせるよ！」"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "「あと、『マイちゃん』のことも‥‥」"},
{"id": 145, "speaker": 5, "form": "dlg", "jp": "「もちろんだよ！」"},
{"id": 146, "speaker": 5, "form": "dlg", "jp": "「この体を借りている以上、それは絶対だよ！」"},
{"id": 147, "speaker": 5, "form": "dlg", "jp": "「それに、『清田ユウリの精神の断片』が\n　きっとほって置かないハズだよ！」"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「そう言ってくれるとボクも安心して行けるよ‥‥」"},
{"id": 149, "speaker": 3, "form": "dlg", "jp": "「大丈夫なのね‥‥」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「姉さんにはもう一度、\n　『おかえり』って言わせてあげるよ！」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「プルルルルル‥‥」"},
{"id": 153, "speaker": 3, "form": "dlg", "jp": "「誰かしらこんな時に？」"},
{"id": 154, "speaker": 3, "form": "dlg", "jp": "「プルルルルル‥‥」"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "「ボクがでるよ！！」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 157, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 158, "speaker": 13, "form": "dlg", "jp": "（もしもし‥‥）"},
{"id": 159, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "「なんだ、ツトムか‥‥」"},
{"id": 161, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 162, "speaker": 13, "form": "dlg", "jp": "（その声はナゴムだな？）"},
{"id": 163, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 165, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 166, "speaker": 13, "form": "dlg", "jp": "（『シンちゃん』が‥‥）"},
{"id": 167, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 169, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 170, "speaker": 13, "form": "dlg", "jp": "（さっきのＵＦＯの事故に巻き込まれたって‥‥）"},
{"id": 171, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「何だって！！」"},
{"id": 173, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 174, "speaker": 13, "form": "dlg", "jp": "（今、病院に運ばれたらしい‥‥）"},
{"id": 175, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「で、『命』は？」"},
{"id": 177, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 178, "speaker": 13, "form": "dlg", "jp": "（オレが聞いた情報では、\n　命には別状はなさそうだって‥‥）"},
{"id": 179, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "「よかった‥‥」"},
{"id": 181, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 182, "speaker": 13, "form": "dlg", "jp": "（よくはなさそうだぜ‥‥）"},
{"id": 183, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "「‥‥‥？」"},
{"id": 185, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 186, "speaker": 13, "form": "dlg", "jp": "（なんでも、意識不明で、\n　両手がぐちゃぐちゃになってるらしい‥‥）"},
{"id": 187, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「で、どこの病院？」"},
{"id": 190, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 191, "speaker": 13, "form": "dlg", "jp": "（わからない！）"},
{"id": 192, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「わからないってっ！！」"},
{"id": 194, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 195, "speaker": 13, "form": "dlg", "jp": "（オバさんもパニくってるみたいで、\n　病院の名前を言わずに‥‥）"},
{"id": 196, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「じゃあ、どうすればいいんだよ！」"},
{"id": 198, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 199, "speaker": 13, "form": "dlg", "jp": "（『祈れ！』‥‥）"},
{"id": 200, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥！？」"},
{"id": 202, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 203, "speaker": 13, "form": "dlg", "jp": "（いっしょに無事を『祈ろう』‥‥）"},
{"id": 204, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "「そうじゃなくって！！」"},
{"id": 206, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 207, "speaker": 13, "form": "dlg", "jp": "（バカ、それ以外することがないんだから、\n　『祈る』んだよ！）"},
{"id": 208, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 209, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 210, "speaker": 13, "form": "dlg", "jp": "（できるだけのことを、めいっぱいやってやろうぜ！）"},
{"id": 211, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 212, "speaker": 13, "form": "dlg", "jp": "ボクには電話の向こうのツトムが泣いているように\n聞こえた‥‥"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "「めいっぱい『祈る』よ！」"},
{"id": 215, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 216, "speaker": 13, "form": "dlg", "jp": "（たのんだぞ！）"},
{"id": 217, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 218, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 219, "speaker": 13, "form": "dlg", "jp": "（オレは必死で祈るから、\n　もしシンちゃんに何かあったら）"},
{"id": 220, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 221, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 222, "speaker": 13, "form": "dlg", "jp": "（オマエの祈りが足りなかったってことだぞ！！）"},
{"id": 223, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "「わかったよ！」"},
{"id": 225, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 226, "speaker": 13, "form": "dlg", "jp": "（じゃあ、\n　まだ連絡しなくちゃいけないとこあるから‥‥）"},
{"id": 227, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 228, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 229, "speaker": 13, "form": "dlg", "jp": "（もし、オバさんからそっちに電話あったら、\n　病院の名前聞いておいてくれよ！）"},
{"id": 230, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「ガチャッ」"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥」"},
{"id": 234, "speaker": 3, "form": "dlg", "jp": "「どうかしたの‥‥？」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "「シンちゃんがＵＦＯの事故に巻き込まれて\n　病院に運ばれたって‥‥」"},
{"id": 236, "speaker": 3, "form": "dlg", "jp": "「どこの病院！？」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「分からないって‥‥」"},
{"id": 238, "speaker": 3, "form": "dlg", "jp": "「そうなの‥‥」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「とりあえず、命は大丈夫らしいんだけど‥‥」"},
{"id": 240, "speaker": 3, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 241, "speaker": 3, "form": "dlg", "jp": "「落胆している場合じゃないでしょう！！」"},
{"id": 242, "speaker": 3, "form": "dlg", "jp": "「アナタがちゃんとしてれば、\n　これ以上被害を出さないようにできるんでしょう！」"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥」"},
{"id": 244, "speaker": 3, "form": "dlg", "jp": "「アナタがしょげてたら、\n　守れるものも守れないわよ！」"},
{"id": 245, "speaker": 5, "form": "dlg", "jp": "「そうだね、入院しているところを\n　襲われたら逃げられないけど」"},
{"id": 246, "speaker": 5, "form": "dlg", "jp": "「ナゴムは襲わせないようにすることができるんだよね」"},
{"id": 247, "speaker": 5, "form": "dlg", "jp": "「うらやましいよ、できることがあるなんて‥‥」"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "「そうだね、ボクはまだ『やれること』があるんだよね！」"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "「わかった、きっとみんなを守ってみせるよ！」"},
{"id": 251, "speaker": 3, "form": "dlg", "jp": "「たのんだわよ！！」"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"}
]
