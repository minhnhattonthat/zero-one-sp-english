{"id": 549, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 550, "speaker": 15, "form": "dlg", "jp": "「そう言えば、シローはどうなったの？」"},
{"id": 551, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
