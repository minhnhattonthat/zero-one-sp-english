[
{"id": 0, "speaker": null, "form": "dlg", "jp": "そして‥‥"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "ボクとシンちゃんは松尾さんの能力で、\n『Ｅ－ｇｒｏ』本部に呼び戻された。"},
{"id": 2, "speaker": 13, "form": "dlg", "jp": "「シンちゃんカッコイイ！！」"},
{"id": 3, "speaker": 14, "form": "dlg", "jp": "「ナゴムのオヤジさんのおかげだよ！」"},
{"id": 4, "speaker": 27, "form": "dlg", "jp": "「いや、キミだからできたんだよ！」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "「父さんっ！」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「どうしてここに？」"},
{"id": 7, "speaker": 26, "form": "dlg", "jp": "「ボクが呼んでもらったんだ‥‥」"},
{"id": 8, "speaker": 26, "form": "dlg", "jp": "「親が自分の子供の行動を監視するのは当然のことだろう？」"},
{"id": 9, "speaker": 27, "form": "dlg", "jp": "「普段はほったらかしだったからな‥‥」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「父さん‥‥」"},
{"id": 11, "speaker": 27, "form": "dlg", "jp": "「シロー、キミの腕をちょっと借りたぞ‥‥」"},
{"id": 12, "speaker": 5, "form": "dlg", "jp": "「気にしないでください‥‥」"},
{"id": 13, "speaker": 5, "form": "dlg", "jp": "「あの腕はもともと\n　ナゴムたちを守るためのものですから‥‥」"},
{"id": 14, "speaker": 35, "form": "dlg", "jp": "「でも、本当にドキドキしたよ‥‥」"},
{"id": 15, "speaker": 14, "form": "dlg", "jp": "「あのタイミングでも、\n　テレポーテーションを使ったのがバレてたとは‥‥」"},
{"id": 16, "speaker": 35, "form": "dlg", "jp": "「あのタイミングじゃなかったら、\n　殺されてただろうね‥‥」"},
{"id": 17, "speaker": 31, "form": "dlg", "jp": "「でも本当にナゴムがクリエーターを倒すとはね‥‥」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「なんだよ、信じてくれてたんじゃぁ？」"},
{"id": 19, "speaker": 31, "form": "dlg", "jp": "「ハハハハハハハハハハ‥‥」"},
{"id": 20, "speaker": 31, "form": "dlg", "jp": "「信じてたよ‥‥」"},
{"id": 21, "speaker": 31, "form": "dlg", "jp": "「１％ぐらいは‥‥」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「１％って‥‥」"},
{"id": 23, "speaker": 13, "form": "dlg", "jp": "「１と０じゃ大違いだよ！」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「まあ、そうだけど‥‥」"},
{"id": 25, "speaker": 31, "form": "dlg", "jp": "「オマエはその１％でクリエーターを倒したんだよ！」"},
{"id": 26, "speaker": 46, "form": "dlg", "jp": "「違います‥‥」"},
{"id": 27, "speaker": 31, "form": "dlg", "jp": "「なんだ、リーダーはもっと信じてたのか？」"},
{"id": 28, "speaker": 46, "form": "dlg", "jp": "「そうではありません‥‥」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「はあ？」"},
{"id": 30, "speaker": 46, "form": "dlg", "jp": "「ナゴムは"},
{"id": 31, "speaker": 46, "form": "dlg", "jp": "『クリエーター』を\n　倒していない"},
{"id": 32, "speaker": 46, "form": "dlg", "jp": "ってことです‥‥」"},
{"id": 33, "speaker": 15, "form": "dlg", "jp": "「なんですって！？」"},
{"id": 34, "speaker": 16, "form": "dlg", "jp": "「なんですって！？」"},
{"id": 35, "speaker": 18, "form": "dlg", "jp": "「なんですって！？」"},
{"id": 36, "speaker": 51, "form": "dlg", "jp": "「なんやって！？」"},
{"id": 37, "speaker": 29, "form": "dlg", "jp": "「それは本当なんですか！？」"},
{"id": 38, "speaker": 46, "form": "dlg", "jp": "「本当です‥‥」"},
{"id": 39, "speaker": 29, "form": "dlg", "jp": "「いったいどういうことなんですか？」"},
{"id": 40, "speaker": 46, "form": "dlg", "jp": "「アレが"},
{"id": 41, "speaker": 46, "form": "dlg", "jp": "『クリエーター』ではない"},
{"id": 42, "speaker": 46, "form": "dlg", "jp": "ってことです‥‥」"},
{"id": 43, "speaker": 35, "form": "dlg", "jp": "「ハア？」"},
{"id": 44, "speaker": 46, "form": "dlg", "jp": "「アレは"},
{"id": 45, "speaker": 46, "form": "dlg", "jp": "『エンジェル』"},
{"id": 46, "speaker": 46, "form": "dlg", "jp": "という\n　"},
{"id": 47, "speaker": 46, "form": "dlg", "jp": "『クリエーター』の手先"},
{"id": 48, "speaker": 46, "form": "dlg", "jp": "にすぎません‥‥」"},
{"id": 49, "speaker": 31, "form": "dlg", "jp": "「『エンジェル』！？」"},
{"id": 50, "speaker": 46, "form": "dlg", "jp": "「そうです‥‥」"},
{"id": 51, "speaker": 46, "form": "dlg", "jp": "「『クリエーター』は\n　"},
{"id": 52, "speaker": 46, "form": "dlg", "jp": "何百もの『エンジェル』"},
{"id": 53, "speaker": 46, "form": "dlg", "jp": "を従えているのです」"},
{"id": 54, "speaker": 46, "form": "dlg", "jp": "「アレはその"},
{"id": 55, "speaker": 46, "form": "dlg", "jp": "『エンジェル』の中の１人"},
{"id": 56, "speaker": 46, "form": "dlg", "jp": "にすぎません‥‥」"},
{"id": 57, "speaker": 35, "form": "dlg", "jp": "「何百！？」"},
{"id": 58, "speaker": 31, "form": "dlg", "jp": "「じゃあ、\n　あんなのがまだ何百匹も襲ってくるってことかよ！？」"},
{"id": 59, "speaker": 46, "form": "dlg", "jp": "「それは‥‥」"},
{"id": 60, "speaker": 3, "form": "dlg", "jp": "「ちょっと待ってください！！」"},
{"id": 61, "speaker": 3, "form": "dlg", "jp": "「どうしてアリスさんはそんなことまで？」"},
{"id": 62, "speaker": 29, "form": "dlg", "jp": "「そ、そういえば‥‥」"},
{"id": 63, "speaker": 46, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "「もしかして‥‥」"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "「キミが、"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "『クリエーター』"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "なのか？」"},
{"id": 68, "speaker": 31, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "「まさか！？」"},
{"id": 70, "speaker": 46, "form": "dlg", "jp": "「その通りです‥‥」"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "「ほ、本当なんですか？」"},
{"id": 72, "speaker": 13, "form": "dlg", "jp": "「やっぱりな‥‥」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「やっぱりって、オマエ気付いてたのか？」"},
{"id": 74, "speaker": 13, "form": "dlg", "jp": "「だっておかしいだろう？」"},
{"id": 75, "speaker": 13, "form": "dlg", "jp": "「１人だけそのヘンなコスプレしてないんだから‥‥」"},
{"id": 76, "speaker": 27, "form": "dlg", "jp": "「そんなことより‥‥」"},
{"id": 77, "speaker": 27, "form": "dlg", "jp": "「正体を明かしたってことは‥‥」"},
{"id": 78, "speaker": 46, "form": "dlg", "jp": "「この『シミュレーター』から手をひきます‥‥」"},
{"id": 79, "speaker": 27, "form": "dlg", "jp": "「手をひく？」"},
{"id": 80, "speaker": 13, "form": "dlg", "jp": "「負けを認めるってことか？」"},
{"id": 81, "speaker": 46, "form": "dlg", "jp": "「いいえ‥‥」"},
{"id": 82, "speaker": 46, "form": "dlg", "jp": "「そもそも、勝ちとか負けとかは関係ありません」"},
{"id": 83, "speaker": 35, "form": "dlg", "jp": "「他人にケンカを売っておいて勝ち負けは関係ないって‥‥」"},
{"id": 84, "speaker": 46, "form": "dlg", "jp": "「別にケンカを売ったつもりは‥‥」"},
{"id": 85, "speaker": 31, "form": "dlg", "jp": "「ハァ？」"},
{"id": 86, "speaker": 31, "form": "dlg", "jp": "「本当にアンタが『クリエーター』なら、\n　今すぐ首根っこヘシおってやるつもりなんだが‥‥」"},
{"id": 87, "speaker": 3, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 88, "speaker": 3, "form": "dlg", "jp": "「さっき『シミュレーター』って言ってなかった？」"},
{"id": 89, "speaker": 13, "form": "dlg", "jp": "「言ってたな‥‥」"},
{"id": 90, "speaker": 3, "form": "dlg", "jp": "「つまり、\n　この世界はアナタが作ったシミュレーターってこと？」"},
{"id": 91, "speaker": 46, "form": "dlg", "jp": "「その通りです‥‥」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「シミュレーターって？」"},
{"id": 93, "speaker": 35, "form": "dlg", "jp": "「模擬実験装置だよ‥‥」"},
{"id": 94, "speaker": 35, "form": "dlg", "jp": "「簡単に言えばシミュレートする装置だね‥‥」"},
{"id": 95, "speaker": 3, "form": "dlg", "jp": "「アナタはいったい何をシミュレートしようとしてたの？」"},
{"id": 96, "speaker": 46, "form": "dlg", "jp": "「『未来』です‥‥」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「『未来』？」"},
{"id": 98, "speaker": 46, "form": "dlg", "jp": "「私が本来住んでいる世界は\n　この世界よりずっと文明の進んでいる世界なんです‥‥」"},
{"id": 99, "speaker": 3, "form": "dlg", "jp": "「でしょうね‥‥」"},
{"id": 100, "speaker": 31, "form": "dlg", "jp": "「その文明の進んでいる世界の住人が、\n　どうしてこんな野蛮なことを‥‥」"},
{"id": 101, "speaker": 26, "form": "dlg", "jp": "「それも子供が‥‥」"},
{"id": 102, "speaker": 46, "form": "dlg", "jp": "「私たちの世界では『未来』がなくなろうとしている‥‥」"},
{"id": 103, "speaker": 46, "form": "dlg", "jp": "「つまり、世界が滅ぼうとしているからです‥‥」"},
{"id": 104, "speaker": 26, "form": "dlg", "jp": "「いったいどうして？」"},
{"id": 105, "speaker": 46, "form": "dlg", "jp": "「文明というのは、私たちの世界でも\n　加速度的に進化をしていくものなのです‥‥」"},
{"id": 106, "speaker": 35, "form": "dlg", "jp": "「ハァ？」"},
{"id": 107, "speaker": 46, "form": "dlg", "jp": "「つまり、\n　石器が発明されてから蒸気機関が発明されるまでは」"},
{"id": 108, "speaker": 46, "form": "dlg", "jp": "「かなりの年月がかかりましたが」"},
{"id": 109, "speaker": 46, "form": "dlg", "jp": "「蒸気機関が発明されてからは\n　だんだんと短いスパンで色んな発明が‥‥」"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "「それって良いことじゃないの？」"},
{"id": 111, "speaker": 46, "form": "dlg", "jp": "「そうでもないのです‥‥」"},
{"id": 112, "speaker": 46, "form": "dlg", "jp": "「文明の進化の速度が早くなればなるほど、\n　新しい発明がされなくなってくるのです‥‥」"},
{"id": 113, "speaker": 3, "form": "dlg", "jp": "「たしかに、私たちの世界でも昔ほど画期的な発明が\n　発表されることは少なくなってきたかも‥‥」"},
{"id": 114, "speaker": 35, "form": "dlg", "jp": "「いいんじゃないの？」"},
{"id": 115, "speaker": 35, "form": "dlg", "jp": "「もう新しいものがいらないくらい\n　便利な社会ってことだろ？」"},
{"id": 116, "speaker": 46, "form": "dlg", "jp": "「そうではないのです‥‥」"},
{"id": 117, "speaker": 46, "form": "dlg", "jp": "「もう、新しいものを必要としなくなった世の中では\n　『子供』が『夢』を見なくなってしまうのです」"},
{"id": 118, "speaker": 3, "form": "dlg", "jp": "「子供が夢を見ない？」"},
{"id": 119, "speaker": 46, "form": "dlg", "jp": "「子供は本来、\n　新しい時代をつくることを夢見て成長します‥‥」"},
{"id": 120, "speaker": 46, "form": "dlg", "jp": "「しかし、新しい時代を必要としない世界では\n　そうした成長をしなくなるのです‥‥」"},
{"id": 121, "speaker": 46, "form": "dlg", "jp": "「さらに、医療の発達により長寿化が進んだ\n　私たちの世界では人口調整のため新しい人類‥‥」"},
{"id": 122, "speaker": 46, "form": "dlg", "jp": "「子供すら必要としない考えが生まれ始めています」"},
{"id": 123, "speaker": 46, "form": "dlg", "jp": "「現在、私たちの世界では、未来を夢見ることのできない\n　子供たちがセツナ的な行動に走り」"},
{"id": 124, "speaker": 46, "form": "dlg", "jp": "「今、私たちの世界は亡びようとしています」"},
{"id": 125, "speaker": 26, "form": "dlg", "jp": "「まあ、コッチの世界でも、\n　先進国ほど出生率が低いですからね‥‥」"},
{"id": 126, "speaker": 46, "form": "dlg", "jp": "「それは"},
{"id": 127, "speaker": 46, "form": "dlg", "jp": "『シミュレーター』"},
{"id": 128, "speaker": 46, "form": "dlg", "jp": "だから当然です‥‥」"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 130, "speaker": 46, "form": "dlg", "jp": "「つまり、"},
{"id": 131, "speaker": 46, "form": "dlg", "jp": "この世界"},
{"id": 132, "speaker": 46, "form": "dlg", "jp": "は私たちの世界を\n　シミュレートするための"},
{"id": 133, "speaker": 46, "form": "dlg", "jp": "『シミュレーター』"},
{"id": 134, "speaker": 46, "form": "dlg", "jp": "なんです」"},
{"id": 135, "speaker": 46, "form": "dlg", "jp": "「この『シミュレーター世界』は私たちの世界より\n　何倍も早い速度で時間が流れます」"},
{"id": 136, "speaker": 46, "form": "dlg", "jp": "「そのため、\n　この『シミュレーター世界』の行く末を見ることで」"},
{"id": 137, "speaker": 46, "form": "dlg", "jp": "「私たちの世界の"},
{"id": 138, "speaker": 46, "form": "dlg", "jp": "『未来』を\n　予測する"},
{"id": 139, "speaker": 46, "form": "dlg", "jp": "ことが可能なのです‥‥」"},
{"id": 140, "speaker": 27, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 141, "speaker": 27, "form": "dlg", "jp": "「つまり、こういうことだね‥‥」"},
{"id": 142, "speaker": 27, "form": "dlg", "jp": "「時間の進むのが早い"},
{"id": 143, "speaker": 27, "form": "dlg", "jp": "似たような世界を造って"},
{"id": 144, "speaker": 27, "form": "dlg", "jp": "、\n　その世界の"},
{"id": 145, "speaker": 27, "form": "dlg", "jp": "文明の進歩の先を見ようとしていた"},
{"id": 146, "speaker": 27, "form": "dlg", "jp": "‥‥」"},
{"id": 147, "speaker": 46, "form": "dlg", "jp": "「その通りです‥‥」"},
{"id": 148, "speaker": 51, "form": "dlg", "jp": "「ちょっと待ってや！」"},
{"id": 149, "speaker": 51, "form": "dlg", "jp": "「今の話でこの世界を造った理由はわかったけど‥‥」"},
{"id": 150, "speaker": 51, "form": "dlg", "jp": "「『滅ぼそうとした理由』は‥‥」"},
{"id": 151, "speaker": 16, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 152, "speaker": 16, "form": "dlg", "jp": "「今の話でこの世界を造った理由はわかったけど‥‥」"},
{"id": 153, "speaker": 16, "form": "dlg", "jp": "「『滅ぼそうとした理由』は‥‥」"},
{"id": 154, "speaker": 18, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 155, "speaker": 18, "form": "dlg", "jp": "「今の話でこの世界を造った理由はわかったけど‥‥」"},
{"id": 156, "speaker": 18, "form": "dlg", "jp": "「『滅ぼそうとした理由』は‥‥」"},
{"id": 157, "speaker": 15, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 158, "speaker": 15, "form": "dlg", "jp": "「今の話でこの世界を造った理由はわかったけど‥‥」"},
{"id": 159, "speaker": 15, "form": "dlg", "jp": "「『滅ぼそうとした理由』は‥‥」"},
{"id": 160, "speaker": 46, "form": "dlg", "jp": "「別に"},
{"id": 161, "speaker": 46, "form": "dlg", "jp": "意味はありません"},
{"id": 162, "speaker": 46, "form": "dlg", "jp": "‥‥」"},
{"id": 163, "speaker": 31, "form": "dlg", "jp": "「意味はない？」"},
{"id": 164, "speaker": 46, "form": "dlg", "jp": "「次の実験を開始するために\n　古いシミュレーターを"},
{"id": 165, "speaker": 46, "form": "dlg", "jp": "破棄"},
{"id": 166, "speaker": 46, "form": "dlg", "jp": "していただけです‥‥」"},
{"id": 167, "speaker": 31, "form": "dlg", "jp": "「なんだとう！」"},
{"id": 168, "speaker": 29, "form": "dlg", "jp": "「ケネス！！」"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "「彼女にとって、この世界はただの"},
{"id": 170, "speaker": 29, "form": "dlg", "jp": "実験装置"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "なのよ！」"},
{"id": 172, "speaker": 31, "form": "dlg", "jp": "「そ、そうだが‥‥」"},
{"id": 173, "speaker": 3, "form": "dlg", "jp": "「今まで、何度かこの世界を滅ぼしたってことは‥‥」"},
{"id": 174, "speaker": 46, "form": "dlg", "jp": "「実験は"},
{"id": 175, "speaker": 46, "form": "dlg", "jp": "失敗"},
{"id": 176, "speaker": 46, "form": "dlg", "jp": "でした‥‥」"},
{"id": 177, "speaker": 3, "form": "dlg", "jp": "「つまり、文明がある程度進化すると‥‥」"},
{"id": 178, "speaker": 46, "form": "dlg", "jp": "「子供たちは未来を夢見なくなり、\n　おろかな行動に‥‥」"},
{"id": 179, "speaker": 35, "form": "dlg", "jp": "「で、どうして『天変地異』や『エンジェル』なんかを？」"},
{"id": 180, "speaker": 46, "form": "dlg", "jp": "「『危機感』を抱かせるためです‥‥」"},
{"id": 181, "speaker": 46, "form": "dlg", "jp": "「豊かな世界でダラクしてしまった子供たちが\n　危機的な状況ではどう動くのか見たかったのです‥‥」"},
{"id": 182, "speaker": 3, "form": "dlg", "jp": "「で、どうだったの‥‥」"},
{"id": 183, "speaker": 46, "form": "dlg", "jp": "「ダメでした‥‥」"},
{"id": 184, "speaker": 46, "form": "dlg", "jp": "「過去のほとんどの実験では\n　すんなりと『滅亡』を受け入れてしまいました‥‥」"},
{"id": 185, "speaker": 46, "form": "dlg", "jp": "「しかし、今回\n　アナタたちはそうではありませんでした‥‥」"},
{"id": 186, "speaker": 46, "form": "dlg", "jp": "「圧倒的に力の差があるのにもかかわらず、\n　アナタたちは抵抗しようとしたのです‥‥」"},
{"id": 187, "speaker": 46, "form": "dlg", "jp": "「だから、今回\n　私は一旦このシミュレーターから手をひこうと‥‥」"},
{"id": 188, "speaker": 46, "form": "dlg", "jp": "「見てみたいのです‥‥」"},
{"id": 189, "speaker": 46, "form": "dlg", "jp": "「"},
{"id": 190, "speaker": 46, "form": "dlg", "jp": "ナゴムたちの造った未来"},
{"id": 191, "speaker": 46, "form": "dlg", "jp": "を‥‥」"},
{"id": 192, "speaker": 46, "form": "dlg", "jp": "「現在のこの世界は、私たちの世界と同じように\n　ほとんどの人間が未来をうれい」"},
{"id": 193, "speaker": 46, "form": "dlg", "jp": "「セツナ的に過ごしています‥‥」"},
{"id": 194, "speaker": 46, "form": "dlg", "jp": "「しかし、"},
{"id": 195, "speaker": 46, "form": "dlg", "jp": "ナゴムたちが造る未来なら"},
{"id": 196, "speaker": 46, "form": "dlg", "jp": "\n　また"},
{"id": 197, "speaker": 46, "form": "dlg", "jp": "違った世界"},
{"id": 198, "speaker": 46, "form": "dlg", "jp": "になっているのではと‥‥」"},
{"id": 199, "speaker": 13, "form": "dlg", "jp": "「ハァ？」"},
{"id": 200, "speaker": 46, "form": "dlg", "jp": "「とりあえず、"},
{"id": 201, "speaker": 46, "form": "dlg", "jp": "『猶予（ユウヨ）』"},
{"id": 202, "speaker": 46, "form": "dlg", "jp": "です‥‥」"},
{"id": 203, "speaker": 46, "form": "dlg", "jp": "「私たちの世界が未来に夢を抱けるような\n　そんな未来を造ってください」"},
{"id": 204, "speaker": 46, "form": "dlg", "jp": "「その時には、私は本当にこのシミュレーターを\n　アナタたちに解放します‥‥」"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "「もし、そんな未来を造れなかったら？」"},
{"id": 206, "speaker": 46, "form": "dlg", "jp": "「このシミュレーターを破棄するだけです‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「今度こそ滅ぼすってことだね‥‥」"},
{"id": 208, "speaker": 46, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "「責任重大だな‥‥」"},
{"id": 210, "speaker": 27, "form": "dlg", "jp": "「大丈夫だよ‥‥」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「父さん！？」"},
{"id": 212, "speaker": 27, "form": "dlg", "jp": "「まだまだ文明は進歩するよ！」"},
{"id": 213, "speaker": 27, "form": "dlg", "jp": "「私は今回のことでさらに研究意欲がわいたからね！」"},
{"id": 214, "speaker": 3, "form": "dlg", "jp": "「父さんは少し大人しくしてください！！」"},
{"id": 215, "speaker": 26, "form": "dlg", "jp": "「そうですね、\n　子供のために道をあけてやるのも大人の仕事ですよ！」"},
{"id": 216, "speaker": 14, "form": "dlg", "jp": "「とにかく、キミが憧れるような\n　未来を見せてやるよ！」"},
{"id": 217, "speaker": 46, "form": "dlg", "jp": "「期待しています‥‥」"},
{"id": 218, "speaker": 46, "form": "dlg", "jp": "「じゃあ、私は一旦自分の世界に帰ります‥‥」"},
{"id": 219, "speaker": 13, "form": "dlg", "jp": "「ちょっと待った！！」"},
{"id": 220, "speaker": 13, "form": "dlg", "jp": "「これだけ世界をムチャクチャにしておいて」"},
{"id": 221, "speaker": 13, "form": "dlg", "jp": "「『じゃあ』はないだろう、『じゃあ』は‥‥」"},
{"id": 222, "speaker": 35, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 223, "speaker": 46, "form": "dlg", "jp": "「安心してください‥‥」"},
{"id": 224, "speaker": 46, "form": "dlg", "jp": "「『エンジェル』が活動する前の時点の\n　セーブデータを残しています」"},
{"id": 225, "speaker": 46, "form": "dlg", "jp": "「ちゃんとその時点まで戻させてもらいます‥‥」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「じゃあ、出口も生き返るんだね？」"},
{"id": 227, "speaker": 46, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 228, "speaker": 26, "form": "dlg", "jp": "「それって、『ルード』とかも復活するってことじゃあ？」"},
{"id": 229, "speaker": 46, "form": "dlg", "jp": "「するでしょうね‥‥」"},
{"id": 230, "speaker": 27, "form": "dlg", "jp": "「もう一度、逃げ回ることになりそうだな‥‥」"},
{"id": 231, "speaker": 26, "form": "dlg", "jp": "「そんなぁ‥‥」"},
{"id": 232, "speaker": 5, "form": "dlg", "jp": "「大丈夫ですよ‥‥」"},
{"id": 233, "speaker": 5, "form": "dlg", "jp": "「ボクがお守りします‥‥」"},
{"id": 234, "speaker": 3, "form": "dlg", "jp": "「そ、そう言えば、シローはどうなるの？」"},
{"id": 235, "speaker": 29, "form": "dlg", "jp": "「たぶん、清田って人が生き返るから‥‥」"},
{"id": 236, "speaker": 27, "form": "dlg", "jp": "「今度はもっといい体を造ってあげるよ‥‥」"},
{"id": 237, "speaker": 5, "form": "dlg", "jp": "「お願いします‥‥」"},
{"id": 238, "speaker": 51, "form": "dlg", "jp": "「悪いヤツは生き返らさないってできひんの？」"},
{"id": 239, "speaker": 18, "form": "dlg", "jp": "「悪いヤツは生き返らさないってできないの？」"},
{"id": 240, "speaker": 16, "form": "dlg", "jp": "「悪いヤツは生き返らさないってできないの？」"},
{"id": 241, "speaker": 15, "form": "dlg", "jp": "「悪いヤツは生き返らさないってできないの？」"},
{"id": 242, "speaker": 46, "form": "dlg", "jp": "「それをするとシミュレーターの意味がなくなります‥‥」"},
{"id": 243, "speaker": 35, "form": "dlg", "jp": "「それなら、このままの方がいいかもね‥‥」"},
{"id": 244, "speaker": 46, "form": "dlg", "jp": "「私はどちらでもかまいませんが‥‥」"},
{"id": 245, "speaker": 45, "form": "dlg", "jp": "「ここはやっぱり、ナゴムくんに選んでもらうのが\n　いいんじゃないかな？」"},
{"id": 246, "speaker": 31, "form": "dlg", "jp": "「ウン、そうだな‥‥」"},
{"id": 247, "speaker": 29, "form": "dlg", "jp": "「ナゴム、どっちがいいの？」"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "「そうだなぁ～」"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 250, "speaker": 2, "form": "choice", "jp": "「みんなを戻して‥‥」"},
{"id": 251, "speaker": 2, "form": "choice", "jp": "「このままの方が‥‥」"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "「このままの方が‥‥」"},
{"id": 253, "speaker": 31, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥！？」"},
{"id": 254, "speaker": 2, "form": "dlg", "jp": "「時間を戻しちゃうと、\n　関係のない出来事までもう一度くり返されるんだろう？」"},
{"id": 255, "speaker": 46, "form": "dlg", "jp": "「まあ、そうなりますね‥‥」"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "「たしかにいろいろ被害は出たけど、\n　それを人類は受け入れないといけないんじゃあ‥‥」"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "「もともとは人類がだらしないから\n　天罰みたいなもんなんだろう？」"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "「そういうのを受け止めてこそ、\n　次の未来に進んでいけるように‥‥」"},
{"id": 259, "speaker": 13, "form": "dlg", "jp": "「何言ってるんだよ！」"},
{"id": 260, "speaker": 13, "form": "dlg", "jp": "「じゃあ、シンちゃんの腕は！！」"},
{"id": 261, "speaker": 14, "form": "dlg", "jp": "「オレはかまわないよ‥‥」"},
{"id": 262, "speaker": 14, "form": "dlg", "jp": "「ナゴムの言うとおり、なんでも\n　やり直したからチャラっていうのは間違いだよ‥‥」"},
{"id": 263, "speaker": 14, "form": "dlg", "jp": "「オマエだって、ゲームのリセットをくり返して\n　パーフェクトを狙うのってキライだろう？」"},
{"id": 264, "speaker": 13, "form": "dlg", "jp": "「まあ、そうだけど‥‥」"},
{"id": 265, "speaker": 31, "form": "dlg", "jp": "「エイジは‥‥」"},
{"id": 266, "speaker": 31, "form": "dlg", "jp": "「エイジはどうなるんだよ！！」"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 268, "speaker": 31, "form": "dlg", "jp": "「オマエ、エイジが死んで悲しくないのかよ！」"},
{"id": 269, "speaker": 31, "form": "dlg", "jp": "「エイジが殺されて悔しくないのかよ！」"},
{"id": 270, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 271, "speaker": 2, "form": "dlg", "jp": "「ボクは出口が殺されて悔しかった‥‥」"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "「というより、出口が殺されたから」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「その怒りの感情のおかげで\n　ボクはエンジェルに勝てたんだと思ってる‥‥」"},
{"id": 274, "speaker": 29, "form": "dlg", "jp": "「じゃあ、どうして‥‥」"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "「忘れちゃいけないと思うんだ‥‥」"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "「出口が死んだことを‥‥」"},
{"id": 277, "speaker": 31, "form": "dlg", "jp": "「はぁ？」"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "「アリスがこの世界を滅ぼそうとしたのは\n　この世界の未来に期待ができなかったからだろう？」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "「今回人類は、\n　出口を含め色んな悲しい目にあったけど‥‥」"},
{"id": 280, "speaker": 35, "form": "dlg", "jp": "「その原因が人間にもあったってことだね‥‥」"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "「アリスはこの世界の未来を\n　見てみたいと思ってくれたけど‥‥」"},
{"id": 283, "speaker": 35, "form": "dlg", "jp": "「現在は見るにたえなかったワケだしね‥‥」"},
{"id": 284, "speaker": 46, "form": "dlg", "jp": "「スイマセン‥‥」"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "「ボクは一生恨むと思うよ‥‥」"},
{"id": 287, "speaker": 46, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「でも、それはアリスやエンジェルのことじゃなく、\n　そんな世界を造った大人を‥‥」"},
{"id": 289, "speaker": 27, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "「で、そのウラミのキモチを後向きにぶつけるんじゃなく、\n　反面教師にして未来をつくりたいんだ‥‥」"},
{"id": 291, "speaker": 13, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 292, "speaker": 14, "form": "dlg", "jp": "「オマエ、カッコイイな‥‥」"},
{"id": 293, "speaker": 26, "form": "dlg", "jp": "「常光寺一門ですから‥‥」"},
{"id": 294, "speaker": 46, "form": "dlg", "jp": "「本当にいいのですね‥‥」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "「ああ、エンジェルの破壊した街も\n　数年で元に戻るよ‥‥」"},
{"id": 296, "speaker": 49, "form": "dlg", "jp": "「でも、エンジェルに殺された人たちは‥‥」"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 298, "speaker": 35, "form": "dlg", "jp": "「交通事故や凶悪犯罪で\n　殺された人より少ないんじゃないかな？」"},
{"id": 299, "speaker": 29, "form": "dlg", "jp": "「数の問題じゃないわね‥‥」"},
{"id": 300, "speaker": 35, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 301, "speaker": 31, "form": "dlg", "jp": "「悲しいけど戦争なんだよな‥‥」"},
{"id": 302, "speaker": 31, "form": "dlg", "jp": "「勝っても負けても死んだものは生き返らない‥‥」"},
{"id": 303, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 304, "speaker": 13, "form": "dlg", "jp": "「ゲームの世界じゃないってことだな‥‥」"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "「ボクたちはゲームキャラクターじゃないんだ！」"},
{"id": 307, "speaker": 29, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 308, "speaker": 46, "form": "dlg", "jp": "「本当にスミマセン‥‥」"},
{"id": 309, "speaker": 46, "form": "dlg", "jp": "こうして、アリスは自分の世界に帰って行った。"},
{"id": 310, "speaker": 46, "form": "dlg", "jp": "そして‥‥"},
{"id": 311, "speaker": 46, "form": "dlg", "jp": "アリスは世界を元には戻さなかったが、\n『催眠術』を使って世界中の人の記憶を操作した。"},
{"id": 312, "speaker": 46, "form": "dlg", "jp": "そのため、エスパー以外の人々は\nエンジェルが襲って来たことなどは全く覚えていない。"},
{"id": 313, "speaker": 46, "form": "dlg", "jp": "あれだけ大きな被害も\n大地震や何かの天変地異だと思い込んでいるようだ‥‥"},
{"id": 314, "speaker": 46, "form": "dlg", "jp": "まあ、なんであれ、世界規模の恐怖を味わったんだから、\nうまい具合に世界中に助け合いの心が芽生えたようだ。"},
{"id": 315, "speaker": 46, "form": "dlg", "jp": "エンジェルによって被害を受けた街は\n３年程ですっかり元に‥‥"},
{"id": 316, "speaker": 46, "form": "dlg", "jp": "いや、元の街よりもずっと優れた街として復活し、\n世界中が明るい未来を夢見て順調に動き始めている。"},
{"id": 317, "speaker": 46, "form": "dlg", "jp": "これでしばらくはアリスも安心して\nこの世界を見守ってくれるだろう。"},
{"id": 318, "speaker": 46, "form": "dlg", "jp": "あれから、長い年月が過ぎた‥‥"},
{"id": 319, "speaker": 46, "form": "dlg", "jp": "ボクたちもすっかり大人と呼ばれる人種だ‥‥"},
{"id": 320, "speaker": 46, "form": "dlg", "jp": "シンちゃんはお母さんの後をついで、\n美容師の道に進み‥‥"},
{"id": 321, "speaker": 46, "form": "dlg", "jp": "一時は『カリスマ美容師』としてさわがれ、"},
{"id": 322, "speaker": 46, "form": "dlg", "jp": "今では世界に５０店舗のお店を持っている。"},
{"id": 323, "speaker": 46, "form": "dlg", "jp": "ツトムは大学卒業後、『ネット関係』の会社を立ち上げ\nいまでは『社長さん』だ‥‥"},
{"id": 324, "speaker": 46, "form": "dlg", "jp": "ボクたちは\nゲームの会社に就職するもんだと思っていたのだが、"},
{"id": 325, "speaker": 46, "form": "dlg", "jp": "なんでも、\n大好きなゲームとは距離を取りたいということらしい。"},
{"id": 326, "speaker": 46, "form": "dlg", "jp": "堤さんは高校を卒業後、\n絵画の勉強をするためにヨーロッパに留学した。"},
{"id": 327, "speaker": 46, "form": "dlg", "jp": "今では現地の人と結婚し、\nソッチで生活をしている。"},
{"id": 328, "speaker": 46, "form": "dlg", "jp": "大人しかった堤さんからは\n想像できないぐらい思い切った行動だ。"},
{"id": 329, "speaker": 46, "form": "dlg", "jp": "長尾は変わった政党から選挙に出馬し\n今では国会議員だ‥‥"},
{"id": 330, "speaker": 46, "form": "dlg", "jp": "本気なのか冗談なのかわからない\n例の『長尾節』が人気で、"},
{"id": 331, "speaker": 46, "form": "dlg", "jp": "ちょくちょくバラエティー番組にも出演してる。"},
{"id": 332, "speaker": 46, "form": "dlg", "jp": "アイコは婦人警官になった。"},
{"id": 333, "speaker": 46, "form": "dlg", "jp": "世話好きのアイコにはぴったりなんだけど、"},
{"id": 334, "speaker": 46, "form": "dlg", "jp": "相変わらずボクにはきびしく、\nきっちり駐車違反のキップを切られた。"},
{"id": 335, "speaker": 46, "form": "dlg", "jp": "小田は家業をついで、\n剣道場の師範をやっている。"},
{"id": 336, "speaker": 46, "form": "dlg", "jp": "剣道が正式種目になったばかりの\nオリンピックでは金メダルまで取ってしまった。"},
{"id": 337, "speaker": 46, "form": "dlg", "jp": "まあ、アイツならそれぐらいはやると\n思ってたけど‥‥"},
{"id": 338, "speaker": 46, "form": "dlg", "jp": "おもしろいのは松尾さんだ‥‥"},
{"id": 339, "speaker": 46, "form": "dlg", "jp": "あのあと、市民運動に参加するようになり、"},
{"id": 340, "speaker": 46, "form": "dlg", "jp": "今ではなんと『防衛庁長官』になってしまった。"},
{"id": 341, "speaker": 46, "form": "dlg", "jp": "ケネスは、\nハリウッドで映画プロデューサとして大成功し、"},
{"id": 342, "speaker": 46, "form": "dlg", "jp": "ウワサでは松尾さんに対抗して\n『大統領になる』と言い出してるらしい。"},
{"id": 343, "speaker": 46, "form": "dlg", "jp": "ジーンは、ハリウッドの映画会社からスカウトされ"},
{"id": 344, "speaker": 46, "form": "dlg", "jp": "今ではすっかり『大女優』だ‥‥"},
{"id": 345, "speaker": 46, "form": "dlg", "jp": "で、ケネスもそのコネで映画界に入り"},
{"id": 346, "speaker": 46, "form": "dlg", "jp": "こちらもすっかり大物プロデューサーになったらしい‥‥"},
{"id": 347, "speaker": 46, "form": "dlg", "jp": "そうそう‥‥"},
{"id": 348, "speaker": 46, "form": "dlg", "jp": "あの『自称モテない男』"},
{"id": 349, "speaker": 46, "form": "dlg", "jp": "三田さんも結婚して子供までいる‥‥"},
{"id": 350, "speaker": 46, "form": "dlg", "jp": "相手はなんと‥‥"},
{"id": 351, "speaker": 46, "form": "dlg", "jp": "あのマイちゃんだ‥‥"},
{"id": 352, "speaker": 46, "form": "dlg", "jp": "婚約発表をした時には、みんなから\n『ハンザイシャ』呼ばわりをされてたけど、"},
{"id": 353, "speaker": 46, "form": "dlg", "jp": "トシの差に関係なく上手くやってるそうだ‥‥"},
{"id": 354, "speaker": 46, "form": "dlg", "jp": "まあ、そんな感じだ‥‥"},
{"id": 355, "speaker": 46, "form": "dlg", "jp": "１人１人は時間とともに確実に成長したんじゃないかな。"},
{"id": 356, "speaker": 46, "form": "dlg", "jp": "でも、『世界』が大きく成長したのかどうかは\nボクでは判断できない。"},
{"id": 357, "speaker": 46, "form": "dlg", "jp": "ただ‥‥"},
{"id": 358, "speaker": 46, "form": "dlg", "jp": "今のところ、アリスの攻撃はない‥‥"},
{"id": 359, "speaker": 46, "form": "dlg", "jp": "つまり、\nこの『未来』にアリスは満足してくれてるのだろう‥‥"},
{"id": 360, "speaker": 46, "form": "dlg", "jp": "まあ、\nアリスの世界の時間では大した時間じゃないだろうけど‥‥"},
{"id": 361, "speaker": 46, "form": "dlg", "jp": "この先の未来は今の子供たちに任せることにする。"},
{"id": 362, "speaker": 46, "form": "dlg", "jp": "決して逃げるわけではない。"},
{"id": 363, "speaker": 46, "form": "dlg", "jp": "子供たちが未来へ進みやすいように\n道をあけてやるだけだ‥‥"},
{"id": 364, "speaker": 4, "form": "dlg", "jp": "「もう、父さん！！」"},
{"id": 365, "speaker": 4, "form": "dlg", "jp": "「いつまで寝てるつもり！！」"},
{"id": 366, "speaker": 4, "form": "dlg", "jp": "「たまの休みぐらい家族サービスしようとか思わないの？」"},
{"id": 367, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥ゴメン‥‥」"},
{"id": 368, "speaker": 4, "form": "dlg", "jp": "「ほんとにもう！！」"},
{"id": 369, "speaker": 2, "form": "dlg", "jp": "「なあ？」"},
{"id": 370, "speaker": 4, "form": "dlg", "jp": "「どうしました？」"},
{"id": 371, "speaker": 2, "form": "dlg", "jp": "「アイツ、リツコ姉さんに似て来たと思わないか？」"},
{"id": 372, "speaker": 4, "form": "dlg", "jp": "「フフフフフフ‥‥」"},
{"id": 373, "speaker": 4, "form": "dlg", "jp": "「そうですね‥‥」"},
{"id": 374, "speaker": 4, "form": "dlg", "jp": "「フフフフフフ‥‥」"},
{"id": 375, "speaker": 4, "form": "dlg", "jp": "「そういうアナタもお義父さんにそっくりですよ‥‥」"},
{"id": 376, "speaker": 2, "form": "dlg", "jp": "「そ、そうか？」"},
{"id": 377, "speaker": 2, "form": "dlg", "jp": "「それはマズイな‥‥」"},
{"id": 378, "speaker": 2, "form": "dlg", "jp": "「よし、今度の休みは家族で旅行でも行こうか‥‥」"},
{"id": 379, "speaker": 2, "form": "dlg", "jp": "「何がおかしいんだい？」"},
{"id": 380, "speaker": 2, "form": "dlg", "jp": "「トモ‥‥」"},
{"id": 381, "speaker": 51, "form": "dlg", "jp": "「フフフフフフフフフ‥‥」"},
{"id": 382, "speaker": 2, "form": "dlg", "jp": "「ナナセ‥‥」"},
{"id": 383, "speaker": 18, "form": "dlg", "jp": "「フフフフフフフフフ‥‥」"},
{"id": 384, "speaker": 2, "form": "dlg", "jp": "「アキラ‥‥」"},
{"id": 385, "speaker": 16, "form": "dlg", "jp": "「フフフフフフフフフ‥‥」"},
{"id": 386, "speaker": 2, "form": "dlg", "jp": "「ジーン‥‥」"},
{"id": 387, "speaker": 29, "form": "dlg", "jp": "「フフフフフフフフフ‥‥」"},
{"id": 388, "speaker": 2, "form": "dlg", "jp": "「アイコ‥‥」"},
{"id": 389, "speaker": 15, "form": "dlg", "jp": "「フフフフフフフフフ‥‥」"},
{"id": 390, "speaker": 2, "form": "dlg", "jp": "「みんなを戻して‥‥」"},
{"id": 391, "speaker": 14, "form": "dlg", "jp": "「当然だな‥‥」"},
{"id": 392, "speaker": 46, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 393, "speaker": 46, "form": "dlg", "jp": "こうして、世界は不思議な光に包まれた。"},
{"id": 394, "speaker": 46, "form": "dlg", "jp": "そして‥‥"},
{"id": 395, "speaker": 46, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 396, "speaker": 46, "form": "dlg", "jp": "‥‥‥"},
{"id": 397, "speaker": 14, "form": "dlg", "jp": "「おいっ！」"},
{"id": 398, "speaker": 14, "form": "dlg", "jp": "「おいってば‥‥」"},
{"id": 399, "speaker": 14, "form": "dlg", "jp": "「何、ほうけてるんだ？」"},
{"id": 400, "speaker": 2, "form": "dlg", "jp": "「べ、べつに‥‥」"},
{"id": 401, "speaker": 2, "form": "dlg", "jp": "「ちょっと考えごとをしていただけだよ‥‥」"},
{"id": 402, "speaker": 14, "form": "dlg", "jp": "「考え事？」"},
{"id": 403, "speaker": 14, "form": "dlg", "jp": "「新しい先生のことだろう？」"},
{"id": 404, "speaker": 14, "form": "dlg", "jp": "まあ、こういう感じだ‥‥"},
{"id": 405, "speaker": 14, "form": "dlg", "jp": "どうやら、\nボク以外のみんなは記憶を消されちゃったみたいだ‥‥"},
{"id": 406, "speaker": 14, "form": "dlg", "jp": "まあ、その方がいいだろう‥‥"},
{"id": 407, "speaker": 14, "form": "dlg", "jp": "とにかく、\nボクはもう一度夏休みの宿題をやることになった。"},
{"id": 408, "speaker": 14, "form": "dlg", "jp": "まあ、一度終わらせてる問題だから\n１からやるよりはマシなんだけど‥‥"},
{"id": 409, "speaker": 14, "form": "dlg", "jp": "それよりも、\n大変なことが今夜起きるハズなんだ‥‥"},
{"id": 410, "speaker": 14, "form": "dlg", "jp": "そっちの方をどうにかしないと‥‥"},
{"id": 411, "speaker": 14, "form": "dlg", "jp": "ボクはそのためにキモダメシの誘いを断わった。"},
{"id": 412, "speaker": 14, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 413, "speaker": 8, "form": "dlg", "jp": "「大人しくしろっ！」"},
{"id": 414, "speaker": 8, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 415, "speaker": 8, "form": "dlg", "jp": "「‥‥‥‥‥‥！？」"},
{"id": 416, "speaker": 8, "form": "dlg", "jp": "「いないじゃないか！？」"},
{"id": 417, "speaker": 2, "form": "dlg", "jp": "「大人しくするのは、オマエの方だよ‥‥」"},
{"id": 418, "speaker": 2, "form": "dlg", "jp": "「ア・キ・ス‥‥」"},
{"id": 419, "speaker": 8, "form": "dlg", "jp": "「なんでオレの名前を！！」"},
{"id": 420, "speaker": 2, "form": "dlg", "jp": "「どうでもいいだろ、そんなこと‥‥」"},
{"id": 421, "speaker": 8, "form": "dlg", "jp": "「ナマイキなコゾウだ‥‥」"},
{"id": 422, "speaker": 8, "form": "dlg", "jp": "「丸ゴシの子供１人で、\n　拳銃をもった大人に勝てると思ってるのか？」"},
{"id": 423, "speaker": 2, "form": "dlg", "jp": "「丸ゴシの子供１人じゃないからね‥‥」"},
{"id": 424, "speaker": 8, "form": "dlg", "jp": "「何だとうっ！」"},
{"id": 425, "speaker": 21, "form": "dlg", "jp": "「インターポールよ！」"},
{"id": 426, "speaker": 21, "form": "dlg", "jp": "「大人しくしなさい！！」"},
{"id": 427, "speaker": 21, "form": "dlg", "jp": "「キミの情報どおりの時間に現れたわね‥‥」"},
{"id": 428, "speaker": 2, "form": "dlg", "jp": "「言った通りでしょう？」"},
{"id": 429, "speaker": 8, "form": "dlg", "jp": "「オ、オノレ～～～イ！」"},
{"id": 430, "speaker": 8, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 431, "speaker": 21, "form": "dlg", "jp": "「待ちなさい！」"},
{"id": 432, "speaker": 21, "form": "dlg", "jp": "しまった！\nここで逃がしたらすべてが台無しに‥‥"},
{"id": 433, "speaker": 21, "form": "dlg", "jp": "その時！！"},
{"id": 434, "speaker": 21, "form": "dlg", "jp": "「ガツ～～ン！」"},
{"id": 435, "speaker": 8, "form": "dlg", "jp": "「ウギャッ！」"},
{"id": 436, "speaker": 8, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 437, "speaker": 8, "form": "dlg", "jp": "玄関の方からだ‥‥"},
{"id": 438, "speaker": 8, "form": "dlg", "jp": "ボクは急いで玄関へとかけていった。"},
{"id": 439, "speaker": 8, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 440, "speaker": 8, "form": "dlg", "jp": "そこにはアキスが大の字になった倒れていた。"},
{"id": 441, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥！？」"},
{"id": 442, "speaker": 21, "form": "dlg", "jp": "「キミっ、そんな所で何してるの！？」"},
{"id": 443, "speaker": 21, "form": "dlg", "jp": "「そのバットは何！？」"},
{"id": 444, "speaker": 2, "form": "dlg", "jp": "「バット！？」"},
{"id": 445, "speaker": 51, "form": "dlg", "jp": "「いえ、あやしい人が飛び出してきたからつい‥‥」"},
{"id": 446, "speaker": 2, "form": "dlg", "jp": "「小田ァ！？」"},
{"id": 447, "speaker": 2, "form": "dlg", "jp": "「なんで、バットなんか‥‥」"},
{"id": 448, "speaker": 51, "form": "dlg", "jp": "（木刀を持ち歩いてたらヘンやろう？）"},
{"id": 449, "speaker": 2, "form": "dlg", "jp": "「まさかっ、小田！？」"},
{"id": 450, "speaker": 51, "form": "dlg", "jp": "（声を出さんといて！）"},
{"id": 451, "speaker": 51, "form": "dlg", "jp": "（みんなにバレるやろう！）"},
{"id": 452, "speaker": 2, "form": "dlg", "jp": "（ゴメン‥‥‥‥‥）"},
{"id": 453, "speaker": 18, "form": "dlg", "jp": "「いえ、あやしい人が飛び出してきたからつい‥‥」"},
{"id": 454, "speaker": 2, "form": "dlg", "jp": "「堤さん！？」"},
{"id": 455, "speaker": 2, "form": "dlg", "jp": "「なんで、バットなんか‥‥」"},
{"id": 456, "speaker": 18, "form": "dlg", "jp": "（だって、素手じゃかなわないでしょう？）"},
{"id": 457, "speaker": 2, "form": "dlg", "jp": "「堤さん、まさかっ！」"},
{"id": 458, "speaker": 18, "form": "dlg", "jp": "（声を出さないで！）"},
{"id": 459, "speaker": 18, "form": "dlg", "jp": "（みんなにバレちゃうわ）"},
{"id": 460, "speaker": 2, "form": "dlg", "jp": "（ゴメン‥‥‥‥‥）"},
{"id": 461, "speaker": 16, "form": "dlg", "jp": "「いえ、あやしい人が飛び出してきたからつい‥‥」"},
{"id": 462, "speaker": 2, "form": "dlg", "jp": "「長尾ォ！？」"},
{"id": 463, "speaker": 2, "form": "dlg", "jp": "「なんで、バットなんか‥‥」"},
{"id": 464, "speaker": 16, "form": "dlg", "jp": "（だって、素手じゃかなわないでしょう？）"},
{"id": 465, "speaker": 2, "form": "dlg", "jp": "「長尾、まさかっ！」"},
{"id": 466, "speaker": 16, "form": "dlg", "jp": "（声を出さないでよ！）"},
{"id": 467, "speaker": 16, "form": "dlg", "jp": "（みんなにバレるでしょう！）"},
{"id": 468, "speaker": 2, "form": "dlg", "jp": "（ゴメン‥‥‥‥‥）"},
{"id": 469, "speaker": 15, "form": "dlg", "jp": "「いえ、あやしい人が飛び出してきたからつい‥‥」"},
{"id": 470, "speaker": 2, "form": "dlg", "jp": "「アイコォ！？」"},
{"id": 471, "speaker": 2, "form": "dlg", "jp": "「なんで、バットなんか‥‥」"},
{"id": 472, "speaker": 15, "form": "dlg", "jp": "（だって、素手じゃかなわないでしょう？）"},
{"id": 473, "speaker": 2, "form": "dlg", "jp": "「オマエまさかっ！」"},
{"id": 474, "speaker": 15, "form": "dlg", "jp": "（声を出さないでよ！）"},
{"id": 475, "speaker": 15, "form": "dlg", "jp": "（みんなにバレるでしょう！）"},
{"id": 476, "speaker": 2, "form": "dlg", "jp": "（ゴメン‥‥‥‥‥）"},
{"id": 477, "speaker": 21, "form": "dlg", "jp": "「ドクタージョウコウジの無事が確認されたわよ‥‥」"},
{"id": 478, "speaker": 2, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 479, "speaker": 21, "form": "dlg", "jp": "「今、こっちに警備の人間といっしょに‥‥」"},
{"id": 480, "speaker": 11, "form": "dlg", "jp": "「博士をお連れしました！」"},
{"id": 481, "speaker": 3, "form": "dlg", "jp": "「父さん‥‥」"},
{"id": 482, "speaker": 3, "form": "dlg", "jp": "「大丈夫でした？」"},
{"id": 483, "speaker": 27, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 484, "speaker": 27, "form": "dlg", "jp": "「心配かけたな‥‥」"},
{"id": 485, "speaker": 11, "form": "dlg", "jp": "「それはそうと！」"},
{"id": 486, "speaker": 11, "form": "dlg", "jp": "「さっき、\n　車の中で話してたスパイの話は本当なんですか？」"},
{"id": 487, "speaker": 26, "form": "dlg", "jp": "「ええ、たぶん‥‥」"},
{"id": 488, "speaker": 26, "form": "dlg", "jp": "「強迫電話の中で言ってましたから‥‥」"},
{"id": 489, "speaker": 11, "form": "dlg", "jp": "「いったい誰のことなんだろう？」"},
{"id": 490, "speaker": 2, "form": "dlg", "jp": "「『秋山警部補』ですよ‥‥」"},
{"id": 491, "speaker": 21, "form": "dlg", "jp": "「『アキヤマ』！！」"},
{"id": 492, "speaker": 21, "form": "dlg", "jp": "「キミはどうしてそんなことまで！！」"},
{"id": 493, "speaker": 2, "form": "dlg", "jp": "「アイツらが話してるのを聞いたんです‥‥」"},
{"id": 494, "speaker": 21, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 495, "speaker": 21, "form": "dlg", "jp": "「アキヤマを一度調べてみるわ‥‥」"},
{"id": 496, "speaker": 2, "form": "dlg", "jp": "「あと‥‥」"},
{"id": 497, "speaker": 21, "form": "dlg", "jp": "「何？」"},
{"id": 498, "speaker": 2, "form": "dlg", "jp": "「秋山警部補は手に光線銃を仕込んでいるらしいので\n　十分気をつけて下さい‥‥」"},
{"id": 499, "speaker": 11, "form": "dlg", "jp": "「アイツらそんなことまで話してたのか？」"},
{"id": 500, "speaker": 2, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 501, "speaker": 2, "form": "dlg", "jp": "（まさか、小田も記憶が残ってたなんて‥‥）"},
{"id": 502, "speaker": 51, "form": "dlg", "jp": "（ワルイ‥‥？）"},
{"id": 503, "speaker": 2, "form": "dlg", "jp": "（でも、アブナイまねしなくても‥‥）"},
{"id": 504, "speaker": 51, "form": "dlg", "jp": "（何言うてるん！）"},
{"id": 505, "speaker": 51, "form": "dlg", "jp": "（未来のためにも\n　こういう悪いヤツは倒しておかな‥‥）"},
{"id": 506, "speaker": 2, "form": "dlg", "jp": "（そうだけど‥‥）"},
{"id": 507, "speaker": 51, "form": "dlg", "jp": "（それとも常光寺はこんな悪いヤツがいる未来の世界を\n　アリスに見られてもいいん？）"},
{"id": 508, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 509, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 510, "speaker": 51, "form": "dlg", "jp": "「そう言えば、シローはどうなったん？」"},
{"id": 511, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 512, "speaker": 2, "form": "dlg", "jp": "「シローなら‥‥」"},
{"id": 513, "speaker": 2, "form": "dlg", "jp": "（まさか、堤さんも記憶が残ってたなんて‥‥）"},
{"id": 514, "speaker": 18, "form": "dlg", "jp": "（いけない‥‥？）"},
{"id": 515, "speaker": 2, "form": "dlg", "jp": "（う～ん‥‥）"},
{"id": 516, "speaker": 2, "form": "dlg", "jp": "（でも、アブナイまねは‥‥）"},
{"id": 517, "speaker": 18, "form": "dlg", "jp": "（何言ってるのよ！）"},
{"id": 518, "speaker": 18, "form": "dlg", "jp": "（未来のためにも\n　こういう悪いヤツは倒しておかないと‥‥）"},
{"id": 519, "speaker": 2, "form": "dlg", "jp": "（そうだけど‥‥）"},
{"id": 520, "speaker": 18, "form": "dlg", "jp": "（それとも常光寺くんはこんな悪いヤツがいる未来の世界を\n　アリスに見られてもいいの？）"},
{"id": 521, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 522, "speaker": 2, "form": "dlg", "jp": "「堤さん、キャラ変わった？」"},
{"id": 523, "speaker": 18, "form": "dlg", "jp": "（少しは強くなったかも‥‥）"},
{"id": 524, "speaker": 2, "form": "dlg", "jp": "「そ、そうかもね‥‥」"},
{"id": 525, "speaker": 18, "form": "dlg", "jp": "「そう言えば、シローはどうなったの？」"},
{"id": 526, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
