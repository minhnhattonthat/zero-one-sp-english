{"id": 554, "speaker": 21, "form": "dlg", "jp": "「オノレ‥‥」"},
{"id": 555, "speaker": 19, "form": "dlg", "jp": "「フフフフフ‥‥！」"},
{"id": 556, "speaker": 19, "form": "dlg", "jp": "「死んでもらうぜ‥‥」"},
