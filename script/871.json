{"id": 203, "speaker": 31, "form": "dlg", "jp": "「そりゃぁムリだ！」"},
{"id": 204, "speaker": 31, "form": "dlg", "jp": "「アイツの『マシンガン』は『実弾』じゃないんだ！」"},
{"id": 205, "speaker": 29, "form": "dlg", "jp": "「レーザーマシンガンなの‥‥」"},
{"id": 206, "speaker": 29, "form": "dlg", "jp": "「ケネスも『質量』のない『光』までは‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 208, "speaker": 2, "form": "dlg", "jp": "「松尾さんの能力で弾を消しちゃうとか‥‥」"},
{"id": 209, "speaker": 29, "form": "dlg", "jp": "「それはムリね！」"},
{"id": 210, "speaker": 31, "form": "dlg", "jp": "「アイツの『マシンガン』は『実弾』じゃないんだ！」"},
{"id": 211, "speaker": 29, "form": "dlg", "jp": "「レーザーマシンガンよ‥‥」"},
{"id": 212, "speaker": 29, "form": "dlg", "jp": "「アスカは『質量』のない『光』までは‥‥」"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "「ボクがタテになるとか‥‥」"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "「ボクが体をかたくして、\n　堤さんのタテになれば‥‥」"},
{"id": 216, "speaker": 29, "form": "dlg", "jp": "「それならいけそうね！」"},
{"id": 217, "speaker": 18, "form": "dlg", "jp": "「本当に大丈夫なの？」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「命にかえてでも守ってみせるよ！」"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "「で、どれぐらい時間稼ぎすれば？」"},
{"id": 220, "speaker": 18, "form": "dlg", "jp": "「３０秒ぐらいかな‥‥」"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "「わかった、３０秒だね！」"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "「じゃあ、松尾さんボクたちをアイツの上に‥‥」"},
{"id": 223, "speaker": 35, "form": "dlg", "jp": "「ＯＫ！！」"},
{"id": 224, "speaker": 29, "form": "dlg", "jp": "「多分、攻撃はいきなりよ‥‥\n　あらかじめ体をかたく‥‥」"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "ボクは体をかたくした。"},
{"id": 227, "speaker": 35, "form": "dlg", "jp": "「じゃあ、行くよ！」"},
{"id": 228, "speaker": 18, "form": "dlg", "jp": "「お願いします‥‥」"},
{"id": 229, "speaker": 18, "form": "dlg", "jp": "「シュン！」"},
{"id": 230, "speaker": 18, "form": "dlg", "jp": "「じゃあ、お願いね‥‥」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 232, "speaker": 18, "form": "dlg", "jp": "「アリガトウ！」"},
{"id": 233, "speaker": 18, "form": "dlg", "jp": "「『解除コード』がわかったわ！」"},
{"id": 234, "speaker": 18, "form": "dlg", "jp": "堤さんは『解除コード』を入力した。"},
{"id": 235, "speaker": 18, "form": "dlg", "jp": "「入力完了っ！！」"},
{"id": 236, "speaker": 2, "form": "dlg", "jp": "「やったんだね？」"},
{"id": 237, "speaker": 18, "form": "dlg", "jp": "「うん！」"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "「よし、じゃあひきあげよう！」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「松尾さん！」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「シュン！」"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "「シュン！」"},
{"id": 242, "speaker": 18, "form": "dlg", "jp": "「キャッ！」"},
{"id": 243, "speaker": 35, "form": "dlg", "jp": "「やっぱ、ナナセちゃんはスゴイね！」"},
{"id": 244, "speaker": 18, "form": "dlg", "jp": "「常光寺くんのおかげよ！」"},
{"id": 245, "speaker": 18, "form": "dlg", "jp": "「キャアアアア！」"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「堤さぁぁぁん！」"},
{"id": 247, "speaker": 51, "form": "dlg", "jp": "「『壊す』だけやったら、\n　ウチの能力で『壊せる』で！」"},
{"id": 248, "speaker": 51, "form": "dlg", "jp": "「ただし、直接『触れたら』やけど‥‥」"},
{"id": 249, "speaker": 35, "form": "dlg", "jp": "「アイツ、『タロス』よりかたそうだけど‥‥」"},
{"id": 250, "speaker": 51, "form": "dlg", "jp": "「どんなもんでも『生き物以外』なら大丈夫や！」"},
{"id": 251, "speaker": 51, "form": "dlg", "jp": "「多分‥‥」"},
{"id": 252, "speaker": 51, "form": "dlg", "jp": "「ただ‥‥」"},
{"id": 253, "speaker": 51, "form": "dlg", "jp": "「どんな素材なんか、『感覚』がつかめんと‥‥」"},
{"id": 254, "speaker": 51, "form": "choice", "jp": "「小田がいると心強いよ！」"},
{"id": 255, "speaker": 51, "form": "choice", "jp": "「こわすだけならボクだって‥‥」"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "「小田がいると心強いよ！」"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "「こわすだけならボクだって‥‥」"},
{"id": 258, "speaker": 29, "form": "dlg", "jp": "「まあ、アレに近づくことが出来れば、\n　ナゴムでも破壊できるわね‥‥」"},
{"id": 259, "speaker": 31, "form": "dlg", "jp": "「問題はどうやって近づくかだな‥‥」"},
{"id": 260, "speaker": 35, "form": "dlg", "jp": "「アレの『武装』しだいだね‥‥」"},
{"id": 261, "speaker": 35, "form": "dlg", "jp": "「『白兵戦用』の兵器がないんなら、\n　オレが運んでやるよ‥‥」"},
{"id": 262, "speaker": 29, "form": "dlg", "jp": "「アレの武装は、さっきの対中距離用の\n　『レーザー砲』と‥‥」"},
{"id": 263, "speaker": 29, "form": "dlg", "jp": "「『白兵戦用』の『対人マシンガン』‥‥」"},
{"id": 264, "speaker": 35, "form": "dlg", "jp": "「マシンガンの死角はないの？」"},
{"id": 265, "speaker": 29, "form": "dlg", "jp": "「ないわ‥‥」"},
{"id": 266, "speaker": 29, "form": "dlg", "jp": "「装甲の真上に張りついた敵も射殺可能よ‥‥」"},
{"id": 267, "speaker": 35, "form": "dlg", "jp": "「ダメジャン！！」"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "「もうちょっと様子を見てみよう！」"},
{"id": 269, "speaker": 35, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 270, "speaker": 35, "form": "dlg", "jp": "「自衛隊の援軍も来るだろうし‥‥」"},
{"id": 271, "speaker": 31, "form": "dlg", "jp": "「ちょっと待て！！」"},
{"id": 272, "speaker": 31, "form": "dlg", "jp": "「それはマズイぞ‥‥！」"},
{"id": 273, "speaker": 35, "form": "dlg", "jp": "「なんで？」"},
{"id": 274, "speaker": 29, "form": "dlg", "jp": "「また、敵が増えるだけじゃない！」"},
{"id": 275, "speaker": 35, "form": "dlg", "jp": "「そうか！」"},
{"id": 276, "speaker": 35, "form": "dlg", "jp": "「援軍も『クリエーター』に操られるかもしれないね！」"},
{"id": 277, "speaker": 51, "form": "dlg", "jp": "「なあ、本当にこのスーツ、\n　テレビにうつらへんの？」"},
{"id": 278, "speaker": 29, "form": "dlg", "jp": "「うつらないけど、それがどうかしたの？」"},
{"id": 279, "speaker": 51, "form": "dlg", "jp": "「じゃあ、ウチがなぐってきたろか？」"},
{"id": 280, "speaker": 51, "form": "dlg", "jp": "「マシンガンの弾なら、\n　ウチの体に触れた瞬間にはこわせると思うねん‥‥」"},
{"id": 281, "speaker": 35, "form": "dlg", "jp": "「なるほど！！」"},
{"id": 282, "speaker": 35, "form": "dlg", "jp": "「着弾と同時に破壊するんだね！」"},
{"id": 283, "speaker": 31, "form": "dlg", "jp": "「それはムリだ‥‥」"},
{"id": 284, "speaker": 51, "form": "dlg", "jp": "「なんで？」"},
{"id": 285, "speaker": 31, "form": "dlg", "jp": "「アイツの『マシンガン』は『実弾』じゃない！」"},
{"id": 286, "speaker": 29, "form": "dlg", "jp": "「レーザーマシンガンよ‥‥」"},
{"id": 287, "speaker": 29, "form": "dlg", "jp": "「アナタは『質量』のない光まで破壊できるの？」"},
{"id": 288, "speaker": 31, "form": "dlg", "jp": "「ここはやっぱり、ナゴムの方が‥‥」"},
{"id": 289, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 290, "speaker": 29, "form": "dlg", "jp": "「対人用兵器だから、\n　鋼鉄まで貫けないでしょうし‥‥」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って‥‥」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「ボクがあの『ＵＦＯ』の攻撃を防げるからって‥‥」"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "「ボクの攻撃があの『ＵＦＯ』に通用するとは‥‥」"},
{"id": 294, "speaker": 51, "form": "dlg", "jp": "「そうやっ！」"},
{"id": 295, "speaker": 51, "form": "dlg", "jp": "「常光寺の攻撃じゃ、動力を停める程度で\n　『証拠インメツ』まではムリやろう」"},
{"id": 296, "speaker": 31, "form": "dlg", "jp": "「じゃあ、どうするんだよ！」"},
{"id": 297, "speaker": 51, "form": "dlg", "jp": "「常光寺が『たて』になればいいんちゃうん？」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "「‥‥‥！！」"},
{"id": 299, "speaker": 35, "form": "dlg", "jp": "「それいいアイデア！！」"},
{"id": 300, "speaker": 31, "form": "dlg", "jp": "「なるほど！！」"},
{"id": 301, "speaker": 31, "form": "choice", "jp": "「ムチャ言うなよ！」"},
{"id": 302, "speaker": 31, "form": "choice", "jp": "「仕方ないなぁ‥‥」"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "「ムチャ言うなよ！」"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "「仕方ないなぁ‥‥」"},
{"id": 305, "speaker": 51, "form": "dlg", "jp": "「男なんやから、命がけでウチを守ってよ！」"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "「そんなにうまく行くかな‥‥？」"},
{"id": 307, "speaker": 29, "form": "dlg", "jp": "「とにかく、うまくやるしかないわね‥‥」"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "「思いきり他人ごとだし‥‥」"},
{"id": 309, "speaker": 51, "form": "dlg", "jp": "「ぐずぐず言うてんと、早く終わらせてしまお！」"},
{"id": 310, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥」"},
{"id": 311, "speaker": 51, "form": "dlg", "jp": "「じゃあ、松尾さんたのんだで‥‥」"},
{"id": 312, "speaker": 35, "form": "dlg", "jp": "「ＯＫ！！」"},
{"id": 313, "speaker": 29, "form": "dlg", "jp": "「多分、攻撃はいきなりよ‥‥\n　あらかじめ体をかたく‥‥」"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "ボクは体をかたくした。"},
{"id": 316, "speaker": 51, "form": "dlg", "jp": "「だいたい３０秒ぐらい、持ちこたえて！」"},
{"id": 317, "speaker": 51, "form": "dlg", "jp": "「それぐらいで、装甲の解析ができると思うから‥‥」"},
{"id": 318, "speaker": 35, "form": "dlg", "jp": "「じゃあ、行くよ！」"},
{"id": 319, "speaker": 51, "form": "dlg", "jp": "「早くして！」"},
{"id": 320, "speaker": 51, "form": "dlg", "jp": "「シュン！」"},
{"id": 321, "speaker": 51, "form": "dlg", "jp": "「たのんだで！」"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 323, "speaker": 51, "form": "dlg", "jp": "「よしっ！」"},
{"id": 324, "speaker": 51, "form": "dlg", "jp": "「とりゃああああああああ！」"},
{"id": 325, "speaker": 51, "form": "dlg", "jp": "小田は思いきり木刀を振り下ろした。"},
{"id": 326, "speaker": 51, "form": "dlg", "jp": "「手ごたえアリ！」"},
{"id": 327, "speaker": 2, "form": "dlg", "jp": "「やったんだね？」"},
{"id": 328, "speaker": 51, "form": "dlg", "jp": "「ああ！」"},
{"id": 329, "speaker": 51, "form": "dlg", "jp": "「そんなことより、早く逃げな‥‥」"},
{"id": 330, "speaker": 51, "form": "dlg", "jp": "「コレ、『粉々になる』でぇ！」"},
{"id": 331, "speaker": 2, "form": "dlg", "jp": "「松尾さん！」"},
{"id": 332, "speaker": 2, "form": "dlg", "jp": "「シュン！」"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "「シュン！」"},
{"id": 334, "speaker": 51, "form": "dlg", "jp": "「キャッ！」"},
{"id": 335, "speaker": 35, "form": "dlg", "jp": "「やっぱ、トモちゃんはスゴイね！」"},
{"id": 336, "speaker": 51, "form": "dlg", "jp": "「常光寺のおかげや！」"},
{"id": 337, "speaker": 51, "form": "dlg", "jp": "「キャアアアア！」"},
{"id": 338, "speaker": 2, "form": "dlg", "jp": "「小田ァアアアアアアアアアアアアアア！」"},
{"id": 339, "speaker": 29, "form": "dlg", "jp": "「見て！」"},
{"id": 340, "speaker": 31, "form": "dlg", "jp": "「ざまあ見ろ！！」"},
{"id": 341, "speaker": 2, "form": "dlg", "jp": "「そういえば」"},
{"id": 342, "speaker": 2, "form": "dlg", "jp": "「応援の戦闘機はどうなったの？」"},
{"id": 343, "speaker": 29, "form": "dlg", "jp": "「引き返したみたい‥‥」"},
{"id": 344, "speaker": 2, "form": "dlg", "jp": "「じゃあ？」"},
{"id": 345, "speaker": 29, "form": "dlg", "jp": "「ここはもう大丈夫よ！」"},
{"id": 346, "speaker": 29, "form": "dlg", "jp": "「さあ、戻って本部へ行く準備をしましょう！」"},
{"id": 347, "speaker": 31, "form": "dlg", "jp": "「うんそうだな‥‥」"},
{"id": 348, "speaker": 31, "form": "dlg", "jp": "「シュン！」"},
{"id": 349, "speaker": 31, "form": "dlg", "jp": "失敗の原因は『反射神経』の問題。\n強敵と戦うには『知力』だけでは難しい。\nもっと、反射神経をみがけ。"}
]
