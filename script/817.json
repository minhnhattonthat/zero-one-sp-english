[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／０６／ＡＭ１１：０５"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "次の日‥‥"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "ジーンたちは朝からボクの部屋に集まっていた。"},
{"id": 3, "speaker": 31, "form": "dlg", "jp": "（アイツはやっぱり『不死身』なのか？）"},
{"id": 4, "speaker": 29, "form": "dlg", "jp": "（そんなハズはないわ！）"},
{"id": 5, "speaker": 29, "form": "dlg", "jp": "（昨日確かめてわかったの‥‥）"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "（あのコの『能力』は間違いなく\n　『光を操る能力』だって‥‥）"},
{"id": 7, "speaker": 31, "form": "dlg", "jp": "（それって、間違いないのか？）"},
{"id": 8, "speaker": 29, "form": "dlg", "jp": "（間違いないわよ！）"},
{"id": 9, "speaker": 29, "form": "dlg", "jp": "（だから、拳銃が命中したのよ！）"},
{"id": 10, "speaker": 51, "form": "dlg", "jp": "（そうやんな‥‥）"},
{"id": 11, "speaker": 51, "form": "choice", "jp": "（やっぱり、能力を２つ持ってるとか‥‥）"},
{"id": 12, "speaker": 51, "form": "choice", "jp": "（『能力』以外に何かヒミツがあるとか‥‥）"},
{"id": 13, "speaker": 16, "form": "dlg", "jp": "（そうよね‥‥）"},
{"id": 14, "speaker": 16, "form": "choice", "jp": "（やっぱり、能力を２つ持ってるとか‥‥）"},
{"id": 15, "speaker": 16, "form": "choice", "jp": "（『能力』以外に何かヒミツがあるとか‥‥）"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "（『能力』以外に何かヒミツがあるとか‥‥）"},
{"id": 17, "speaker": 29, "form": "dlg", "jp": "（例えば？）"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "（やっぱり、能力を２つ持ってるとか‥‥）"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "（だから、それはありえないのよ！）"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "（じゃあ、やっぱり出口の能力は『光を操る』‥‥？）"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "（そのハズよ‥‥）"},
{"id": 22, "speaker": 31, "form": "dlg", "jp": "（でも実際にアイツは『不死身』だったじゃないか‥‥）"},
{"id": 23, "speaker": 31, "form": "choice", "jp": "（何かトリックを使ったとか‥‥）"},
{"id": 24, "speaker": 31, "form": "choice", "jp": "（やっぱり『ノア』が関係あるんじゃぁ‥‥）"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "（何かトリックを使ったとか‥‥）"},
{"id": 26, "speaker": 31, "form": "dlg", "jp": "（トリックってどんな？）"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "（だから、\n　攻撃が命中したように見せかけてるだけだとか‥‥）"},
{"id": 28, "speaker": 29, "form": "dlg", "jp": "（それはないわね‥‥）"},
{"id": 29, "speaker": 29, "form": "dlg", "jp": "（私の銃弾だけじゃなく、\n　ケネスの『投げ』も平気だったんだから‥‥）"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "（となると‥‥）"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "（やっぱり『ノア』が関係あるんじゃぁ‥‥）"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "（『ノア』って『人類を救う石』なんだろう？）"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "（それが、出口を守ってるとか‥‥）"},
{"id": 34, "speaker": 31, "form": "dlg", "jp": "（それは違うな‥‥）"},
{"id": 35, "speaker": 31, "form": "dlg", "jp": "（『ノア』は持ってるだけで\n　『人類を救う』ものじゃないからな‥‥）"},
{"id": 36, "speaker": 31, "form": "dlg", "jp": "（『ノア』が発した『光』を浴びたものだけが\n　『救われる』んだよ‥‥）"},
{"id": 37, "speaker": 29, "form": "dlg", "jp": "（『光を浴びたもの』！？）"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "（もしかして、出口は『ノアの光』すら\n　操れるんじゃあ？）"},
{"id": 39, "speaker": 51, "form": "dlg", "jp": "（そう言えば、アイツの話やったら）"},
{"id": 40, "speaker": 51, "form": "dlg", "jp": "（アイツの仲間になったら、『ゲーマー』に\n　襲われても死なへんって感じやったな‥‥）"},
{"id": 41, "speaker": 31, "form": "dlg", "jp": "（じゃあ、\n　アイツは『不死身』ってことか？）"},
{"id": 42, "speaker": 29, "form": "dlg", "jp": "（ちょっと違うけど‥‥）"},
{"id": 43, "speaker": 51, "form": "dlg", "jp": "（ちょっと違う？）"},
{"id": 44, "speaker": 29, "form": "dlg", "jp": "（『ノアの光』を浴びたからといって\n　絶対『死なない』わけじゃないから‥‥）"},
{"id": 45, "speaker": 29, "form": "dlg", "jp": "（そうじゃないと、今までノアの光を浴びた人間って\n　現代まで生きてることになるでしょう）"},
{"id": 46, "speaker": 29, "form": "dlg", "jp": "（ノアは浴びた直後から数ヶ月『不死』になるだけ‥‥）"},
{"id": 47, "speaker": 31, "form": "dlg", "jp": "（じゃあ、数ヶ月後にはアイツを倒すことも？）"},
{"id": 48, "speaker": 29, "form": "dlg", "jp": "（それはどうかしら？）"},
{"id": 49, "speaker": 29, "form": "dlg", "jp": "（『ノア』はあのコの手もとにあり）"},
{"id": 50, "speaker": 29, "form": "dlg", "jp": "（あのコは自由に『ノアの光』をコントロールできる）"},
{"id": 51, "speaker": 29, "form": "dlg", "jp": "（その気になれば何度でも『光』を‥‥）"},
{"id": 52, "speaker": 51, "form": "dlg", "jp": "（ほな、やっぱり『不死身』といっしょやん！）"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "（それにすでに『ゲーマー』の攻撃が始まってるのに\n　数ヶ月も待てないわ‥‥）"},
{"id": 54, "speaker": 51, "form": "dlg", "jp": "（でも、相手が『不死身』やったらどうすることも‥‥）"},
{"id": 55, "speaker": 16, "form": "dlg", "jp": "（そう言えば、アイツの話だったら）"},
{"id": 56, "speaker": 16, "form": "dlg", "jp": "（アイツの仲間になったら、『ゲーマー』に\n　襲われても死なないって感じだったわね‥‥）"},
{"id": 57, "speaker": 31, "form": "dlg", "jp": "（じゃあ、\n　アイツは『不死身』ってことか？）"},
{"id": 58, "speaker": 29, "form": "dlg", "jp": "（ちょっと違うけど‥‥）"},
{"id": 59, "speaker": 16, "form": "dlg", "jp": "（ちょっと違う？）"},
{"id": 60, "speaker": 29, "form": "dlg", "jp": "（『ノアの光』を浴びたからといって\n　絶対『死なない』わけじゃないから‥‥）"},
{"id": 61, "speaker": 29, "form": "dlg", "jp": "（そうじゃないと、今までノアの光を浴びた人間って\n　現代まで生きてることになるでしょう）"},
{"id": 62, "speaker": 29, "form": "dlg", "jp": "（ノアは浴びた直後から数ヶ月『不死』になるだけ‥‥）"},
{"id": 63, "speaker": 31, "form": "dlg", "jp": "（じゃあ、数ヶ月後にはアイツを倒すことも？）"},
{"id": 64, "speaker": 29, "form": "dlg", "jp": "（それはどうかしら？）"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "（『ノア』はあのコの手もとにあり）"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "（あのコは自由に『ノアの光』をコントロールできる）"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "（その気になれば何度でも『光』を‥‥）"},
{"id": 68, "speaker": 16, "form": "dlg", "jp": "（じゃあ、やっぱり『不死身』といっしょじゃない！）"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "（それにすでに『ゲーマー』の攻撃が始まってるのに\n　数ヶ月も待てないわ‥‥）"},
{"id": 70, "speaker": 16, "form": "dlg", "jp": "（でも、相手が『不死身』じゃあどうすることも‥‥）"},
{"id": 71, "speaker": 16, "form": "dlg", "jp": "その時！"},
{"id": 72, "speaker": 16, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 73, "speaker": 16, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 74, "speaker": 3, "form": "dlg", "jp": "「ナゴム、大変よ！」"},
{"id": 75, "speaker": 3, "form": "dlg", "jp": "「あ、あれ、お客さん来てたの？」"},
{"id": 76, "speaker": 29, "form": "dlg", "jp": "「おじゃましてます‥‥」"},
{"id": 77, "speaker": 3, "form": "dlg", "jp": "「いいえ‥‥」"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "「そんなことよりどうしたの？」"},
{"id": 79, "speaker": 3, "form": "dlg", "jp": "「ちょっと、テレビをつけてみて！」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「テレビがどうかしたの？」"},
{"id": 81, "speaker": 3, "form": "dlg", "jp": "「いいから早く！」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 83, "speaker": 2, "form": "dlg", "jp": "ボクはテレビをつけた"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「ブチッ！」"},
{"id": 85, "speaker": 44, "form": "dlg", "jp": "「ごらんください！」"},
{"id": 86, "speaker": 44, "form": "dlg", "jp": "「今みなさんが御覧になっている映像は\n　現実のニュース映像です」"},
{"id": 87, "speaker": 44, "form": "dlg", "jp": "「決してドラマや映画のような\n　作られた映像ではありません！」"},
{"id": 88, "speaker": 44, "form": "dlg", "jp": "「私自身まだ半信半疑ですが‥‥」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「ＵＦＯって‥‥！？」"},
{"id": 90, "speaker": 3, "form": "dlg", "jp": "「私もジョーク番組かと思ったんだけど‥‥」"},
{"id": 91, "speaker": 3, "form": "dlg", "jp": "「どのチャンネルも今はこの映像ばっかりよ！！」"},
{"id": 92, "speaker": 29, "form": "dlg", "jp": "「みんな、ちょっと落ち着いて‥‥」"},
{"id": 93, "speaker": 29, "form": "dlg", "jp": "「お姉さん、\n　ニュースでは、このＵＦＯのことをなんて？」"},
{"id": 94, "speaker": 3, "form": "dlg", "jp": "「へっ？」"},
{"id": 95, "speaker": 3, "form": "dlg", "jp": "「ニューヨークのまん中に、\n　巨大なＵＦＯが現れましたって‥‥」"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "「で、アメリカ政府とかは\n　アレの正体はわかってるの？」"},
{"id": 97, "speaker": 3, "form": "dlg", "jp": "「さあ、政府も調査中だって‥‥」"},
{"id": 98, "speaker": 51, "form": "dlg", "jp": "「もしかしたら、『ゲーマー』の‥‥」"},
{"id": 99, "speaker": 31, "form": "dlg", "jp": "「可能性は大だな‥‥」"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "「９９％間違いないわね‥‥」"},
{"id": 101, "speaker": 31, "form": "dlg", "jp": "「ちくしょう！　時間切れか‥‥」"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「ジーン、どうかしたの？」"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "「感じるのよ‥‥」"},
{"id": 105, "speaker": 51, "form": "dlg", "jp": "「感じる？」"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "「『巨大なエネルギー』が蓄積されてゆく音を‥‥」"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "「今にも、あふれそうな感じよ‥‥」"},
{"id": 108, "speaker": 31, "form": "dlg", "jp": "「なんだって！」"},
{"id": 109, "speaker": 3, "form": "dlg", "jp": "「ねえ、あれっ！」"},
{"id": 110, "speaker": 31, "form": "dlg", "jp": "「やりやがった！」"},
{"id": 111, "speaker": 29, "form": "dlg", "jp": "「あふれそうだったエネルギーが減少したわ‥‥」"},
{"id": 112, "speaker": 51, "form": "dlg", "jp": "「もしかして、今の攻撃のエネルギーを\n　感じていたん？」"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "「どうやらそうみたいね‥‥」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「テレビうつらなくなったけど‥‥」"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "「ニューヨークの町もろとも、\n　中継車も破壊されたんでしょうね‥‥」"},
{"id": 116, "speaker": 31, "form": "dlg", "jp": "「あんな攻撃何度もくらったら‥‥」"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "「もう、ニューヨークを攻撃することはないわ‥‥」"},
{"id": 118, "speaker": 51, "form": "dlg", "jp": "「なんで？」"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "「たぶん、もうそんな町は存在しなくなったから‥‥」"},
{"id": 120, "speaker": 51, "form": "dlg", "jp": "「ウソ！」"},
{"id": 121, "speaker": 29, "form": "dlg", "jp": "「本当よ‥‥」"},
{"id": 122, "speaker": 29, "form": "dlg", "jp": "「早くどうにかしないと、\n　本当に人類は全滅してしまうわ！」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「どうにかって‥‥」"},
{"id": 124, "speaker": 29, "form": "dlg", "jp": "「誰かがあのＵＦＯを破壊するってことね‥‥」"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "「そんなことできるの？」"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "「できるかどうかはわからないわ‥‥」"},
{"id": 127, "speaker": 29, "form": "dlg", "jp": "「でも、それをするための組織が\n　私たち『Ｅ－ｇｒｏ』なのよ‥‥」"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "「たぶん、本部の仲間たちが今頃\n　アイツを破壊するために出撃しているはずよ‥‥」"},
{"id": 129, "speaker": 51, "form": "dlg", "jp": "「その人たちがＵＦＯをこわせへんかったら？」"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "「『ノア』のない今の状態では人類は全滅ね‥‥」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「全滅！？」"},
{"id": 132, "speaker": 31, "form": "dlg", "jp": "「ちくしょうっ！」"},
{"id": 133, "speaker": 31, "form": "dlg", "jp": "「どうにかして、\n　『ノア』を取りかえす方法はないのかよ！」"},
{"id": 134, "speaker": 3, "form": "dlg", "jp": "「あのう‥‥」"},
{"id": 135, "speaker": 3, "form": "dlg", "jp": "「みなさんはさっきからいったい何を‥‥」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「姉さんには関係ないよ‥‥」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「気にしないで‥‥」"},
{"id": 138, "speaker": 3, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 139, "speaker": 3, "form": "dlg", "jp": "「‥‥‥！」"},
{"id": 140, "speaker": 3, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 141, "speaker": 3, "form": "dlg", "jp": "とつぜん、姉さんは気を失ってその場に倒れた。"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「姉さん！」"},
{"id": 143, "speaker": 51, "form": "dlg", "jp": "「大変や、お医者さんを‥‥」"},
{"id": 144, "speaker": 4, "form": "dlg", "jp": "「心配ありません‥‥」"},
{"id": 145, "speaker": 4, "form": "dlg", "jp": "気絶していた姉さんはゆっくりと起き上がった。"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「姉さん！」"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "「大丈夫なの？」"},
{"id": 148, "speaker": 4, "form": "dlg", "jp": "「私はリツコではありません‥‥」"},
{"id": 149, "speaker": 31, "form": "dlg", "jp": "「はぁ？」"},
{"id": 150, "speaker": 4, "form": "dlg", "jp": "「今、アナタたちを助けるために\n　リツコの肉体を借りているのです‥‥」"},
{"id": 151, "speaker": 29, "form": "dlg", "jp": "「肉体を借りている？」"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "「もしかして、母さん！？」"},
{"id": 153, "speaker": 54, "form": "dlg", "jp": "「そうです‥‥」"},
{"id": 154, "speaker": 51, "form": "dlg", "jp": "「常光寺のおかあさんって死んでるんちゃうの？」"},
{"id": 155, "speaker": 54, "form": "dlg", "jp": "「私の命はすでにこの世に存在しません‥‥」"},
{"id": 156, "speaker": 54, "form": "dlg", "jp": "「今、リツコの体を借りているのは\n　私の『残存思念』です‥‥」"},
{"id": 157, "speaker": 51, "form": "dlg", "jp": "「『残存思念』？」"},
{"id": 158, "speaker": 29, "form": "dlg", "jp": "「意識を肉体以外の場所に\n　残しておく『能力』よ‥‥」"},
{"id": 159, "speaker": 54, "form": "dlg", "jp": "「私の『能力』もだんだん薄れています」"},
{"id": 160, "speaker": 54, "form": "dlg", "jp": "「これが最後のメッセージです‥‥」"},
{"id": 161, "speaker": 54, "form": "dlg", "jp": "「よく聞きなさい‥‥」"},
{"id": 162, "speaker": 54, "form": "dlg", "jp": "「今、アナタたちは『不死身の敵』を相手に\n　苦しんでいることでしょう‥‥」"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「どうしてそれを‥‥？」"},
{"id": 164, "speaker": 54, "form": "dlg", "jp": "「私は過去に未来の『魂』を宿したことがあるのです‥‥」"},
{"id": 165, "speaker": 31, "form": "dlg", "jp": "「いったい、どういう意味だ？」"},
{"id": 166, "speaker": 29, "form": "dlg", "jp": "「ナゴムのお母さんは『霊媒師』だったから、\n　『未来の魂』を呼び出したってことじゃないの？」"},
{"id": 167, "speaker": 31, "form": "dlg", "jp": "「そんなことができるのか？」"},
{"id": 168, "speaker": 29, "form": "dlg", "jp": "「わからないわ‥‥」"},
{"id": 169, "speaker": 54, "form": "dlg", "jp": "「『魂』は『肉体』ほど、\n　『時間』の影響をうけません‥‥」"},
{"id": 170, "speaker": 51, "form": "dlg", "jp": "「どうでもええんちゃうん？」"},
{"id": 171, "speaker": 51, "form": "dlg", "jp": "「今は幽霊の言うことでも信じるしか‥‥」"},
{"id": 172, "speaker": 16, "form": "dlg", "jp": "「もしかしたら、『ゲーマー』の‥‥」"},
{"id": 173, "speaker": 31, "form": "dlg", "jp": "「可能性は大だな‥‥」"},
{"id": 174, "speaker": 29, "form": "dlg", "jp": "「９９％間違いないわね‥‥」"},
{"id": 175, "speaker": 31, "form": "dlg", "jp": "「ちくしょう！　時間切れか‥‥」"},
{"id": 176, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「ジーン、どうかしたの？」"},
{"id": 178, "speaker": 29, "form": "dlg", "jp": "「感じるのよ‥‥」"},
{"id": 179, "speaker": 16, "form": "dlg", "jp": "「感じる？」"},
{"id": 180, "speaker": 29, "form": "dlg", "jp": "「『巨大なエネルギー』が蓄積されてゆく音を‥‥」"},
{"id": 181, "speaker": 29, "form": "dlg", "jp": "「今にも、あふれそうな感じよ‥‥」"},
{"id": 182, "speaker": 31, "form": "dlg", "jp": "「なんだって！」"},
{"id": 183, "speaker": 3, "form": "dlg", "jp": "「ねえ、あれっ！」"},
{"id": 184, "speaker": 31, "form": "dlg", "jp": "「やりやがった！」"},
{"id": 185, "speaker": 29, "form": "dlg", "jp": "「あふれそうだったエネルギーが減少したわ‥‥」"},
{"id": 186, "speaker": 16, "form": "dlg", "jp": "「もしかして、今の攻撃のエネルギーを\n　感じていたの？」"},
{"id": 187, "speaker": 29, "form": "dlg", "jp": "「どうやらそうみたいね‥‥」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「テレビうつらなくなったけど‥‥」"},
{"id": 189, "speaker": 29, "form": "dlg", "jp": "「ニューヨークの町もろとも、\n　中継車も破壊されたんでしょうね‥‥」"},
{"id": 190, "speaker": 31, "form": "dlg", "jp": "「あんな攻撃何度もくらったら‥‥」"},
{"id": 191, "speaker": 29, "form": "dlg", "jp": "「もう、ニューヨークを攻撃することはないわ‥‥」"},
{"id": 192, "speaker": 16, "form": "dlg", "jp": "「どうして？」"},
{"id": 193, "speaker": 29, "form": "dlg", "jp": "「たぶん、もうそんな町は存在しなくなったから‥‥」"},
{"id": 194, "speaker": 16, "form": "dlg", "jp": "「ウソ！」"},
{"id": 195, "speaker": 29, "form": "dlg", "jp": "「本当よ‥‥」"},
{"id": 196, "speaker": 29, "form": "dlg", "jp": "「早くどうにかしないと、\n　本当に人類は全滅してしまうわ！」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「どうにかって‥‥」"},
{"id": 198, "speaker": 29, "form": "dlg", "jp": "「誰かがあのＵＦＯを破壊するってことね‥‥」"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "「そんなことできるの？」"},
{"id": 200, "speaker": 29, "form": "dlg", "jp": "「できるかどうかはわからないわ‥‥」"},
{"id": 201, "speaker": 29, "form": "dlg", "jp": "「でも、それをするための組織が\n　私たち『Ｅ－ｇｒｏ』なのよ‥‥」"},
{"id": 202, "speaker": 29, "form": "dlg", "jp": "「たぶん、本部の仲間たちが今頃\n　アイツを破壊するために出撃しているはずよ‥‥」"},
{"id": 203, "speaker": 16, "form": "dlg", "jp": "「その人たちがＵＦＯをこわせなかったら？」"},
{"id": 204, "speaker": 29, "form": "dlg", "jp": "「『ノア』のない今の状態では人類は全滅ね‥‥」"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "「全滅！？」"},
{"id": 206, "speaker": 31, "form": "dlg", "jp": "「ちくしょうっ！」"},
{"id": 207, "speaker": 31, "form": "dlg", "jp": "「どうにかして、\n　『ノア』を取りかえす方法はないのかよ！」"},
{"id": 208, "speaker": 3, "form": "dlg", "jp": "「あのう‥‥」"},
{"id": 209, "speaker": 3, "form": "dlg", "jp": "「みなさんはさっきからいったい何を‥‥」"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "「姉さんには関係ないよ‥‥」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「気にしないで‥‥」"},
{"id": 212, "speaker": 3, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 213, "speaker": 3, "form": "dlg", "jp": "「‥‥‥！」"},
{"id": 214, "speaker": 3, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 215, "speaker": 3, "form": "dlg", "jp": "とつぜん、姉さんは気を失ってその場に倒れた。"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「姉さん！」"},
{"id": 217, "speaker": 16, "form": "dlg", "jp": "「大変、お医者さんを‥‥」"},
{"id": 218, "speaker": 4, "form": "dlg", "jp": "「心配ありません‥‥」"},
{"id": 219, "speaker": 4, "form": "dlg", "jp": "気絶していた姉さんはゆっくりと起き上がった。"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "「姉さん！」"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "「大丈夫なの？」"},
{"id": 222, "speaker": 4, "form": "dlg", "jp": "「私はリツコではありません‥‥」"},
{"id": 223, "speaker": 31, "form": "dlg", "jp": "「はぁ？」"},
{"id": 224, "speaker": 4, "form": "dlg", "jp": "「今、アナタたちを助けるために\n　リツコの肉体を借りているのです‥‥」"},
{"id": 225, "speaker": 29, "form": "dlg", "jp": "「肉体を借りている？」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「もしかして、母さん！？」"},
{"id": 227, "speaker": 54, "form": "dlg", "jp": "「そうです‥‥」"},
{"id": 228, "speaker": 16, "form": "dlg", "jp": "「常光寺くんのおかあさんって死んでるんじゃ？」"},
{"id": 229, "speaker": 54, "form": "dlg", "jp": "「私の命はすでにこの世に存在しません‥‥」"},
{"id": 230, "speaker": 54, "form": "dlg", "jp": "「今、リツコの体を借りているのは\n　私の『残存思念』です‥‥」"},
{"id": 231, "speaker": 16, "form": "dlg", "jp": "「『残存思念』？」"},
{"id": 232, "speaker": 29, "form": "dlg", "jp": "「意識を肉体以外の場所に\n　残しておく『能力』よ‥‥」"},
{"id": 233, "speaker": 54, "form": "dlg", "jp": "「私の『能力』もだんだん薄れています」"},
{"id": 234, "speaker": 54, "form": "dlg", "jp": "「これが最後のメッセージです‥‥」"},
{"id": 235, "speaker": 54, "form": "dlg", "jp": "「よく聞きなさい‥‥」"},
{"id": 236, "speaker": 54, "form": "dlg", "jp": "「今、アナタたちは『不死身の敵』を相手に\n　苦しんでいることでしょう‥‥」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「どうしてそれを‥‥？」"},
{"id": 238, "speaker": 54, "form": "dlg", "jp": "「私は過去に未来の『魂』を宿したことがあるのです‥‥」"},
{"id": 239, "speaker": 31, "form": "dlg", "jp": "「いったい、どういう意味だ？」"},
{"id": 240, "speaker": 29, "form": "dlg", "jp": "「ナゴムのお母さんは『霊媒師』だったから、\n　『未来の魂』を呼び出したってことじゃないの？」"},
{"id": 241, "speaker": 31, "form": "dlg", "jp": "「そんなことができるのか？」"},
{"id": 242, "speaker": 29, "form": "dlg", "jp": "「わからないわ‥‥」"},
{"id": 243, "speaker": 54, "form": "dlg", "jp": "「『魂』は『肉体』ほど、\n　『時間』の影響をうけません‥‥」"},
{"id": 244, "speaker": 16, "form": "dlg", "jp": "「どうでもいいじゃない？」"},
{"id": 245, "speaker": 16, "form": "dlg", "jp": "「今は幽霊の言うことでも信じるしか‥‥」"},
{"id": 246, "speaker": 29, "form": "dlg", "jp": "「そ、そうね‥‥」"},
{"id": 247, "speaker": 54, "form": "dlg", "jp": "「たしかに『不死身』の相手を\n　殺すことはできないでしょう‥‥」"},
{"id": 248, "speaker": 54, "form": "dlg", "jp": "「しかし、『不死身』の相手であっても\n　倒すことはできるハズです」"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "「その方法は‥‥」"},
{"id": 250, "speaker": 54, "form": "dlg", "jp": "「その方法は‥‥」"},
{"id": 251, "speaker": 29, "form": "dlg", "jp": "「マズイわっ！」"},
{"id": 252, "speaker": 29, "form": "dlg", "jp": "「『残存思念』のエネルギーが弱まっている！」"},
{"id": 253, "speaker": 54, "form": "dlg", "jp": "「私の『逆』を‥‥」"},
{"id": 254, "speaker": 2, "form": "dlg", "jp": "「『逆』！？」"},
{"id": 255, "speaker": 54, "form": "dlg", "jp": "「ナゴムの能力なら‥‥」"},
{"id": 256, "speaker": 54, "form": "dlg", "jp": "「‥‥ユウゴウ‥‥」"},
{"id": 257, "speaker": 54, "form": "dlg", "jp": "「‥‥るハズ‥‥」"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "「母さんっ！！」"},
{"id": 259, "speaker": 54, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 260, "speaker": 54, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 261, "speaker": 54, "form": "dlg", "jp": "エネルギーを使い果たした母さんの意識は消滅し、\n姉さんの肉体は解放された。"},
{"id": 262, "speaker": 3, "form": "dlg", "jp": "「う、ううん‥‥」"},
{"id": 263, "speaker": 3, "form": "dlg", "jp": "「いったい、私は‥‥？」"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "「ショッキングな映像をみたから\n　貧血でもおこしたんじゃぁ？」"},
{"id": 265, "speaker": 3, "form": "dlg", "jp": "「そ、そうかしら‥‥」"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "「とりあえず、部屋に戻って横になったら？」"},
{"id": 267, "speaker": 3, "form": "dlg", "jp": "「そ、そうするわ‥‥」"},
{"id": 268, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 269, "speaker": 3, "form": "dlg", "jp": "「バタン！」"},
{"id": 270, "speaker": 3, "form": "dlg", "jp": "姉さんは自分の部屋へと戻っていった。"},
{"id": 271, "speaker": 51, "form": "dlg", "jp": "「常光寺のお母さん、\n　いったい何が言いたかったんやろう？」"},
{"id": 272, "speaker": 16, "form": "dlg", "jp": "「常光寺くんのお母さん、\n　いったい何が言いたかったのかしら？」"},
{"id": 273, "speaker": 31, "form": "dlg", "jp": "「『逆』とか、『ユウゴウ』とか言ってたよな‥‥」"},
{"id": 274, "speaker": 29, "form": "dlg", "jp": "「いったい、どういうことかしら？」"},
{"id": 275, "speaker": 29, "form": "choice", "jp": "「『ユウゴウ』の『逆』ってことじゃぁ？」"},
{"id": 276, "speaker": 29, "form": "choice", "jp": "「『私』の『逆』って言ってたよね？」"},
{"id": 277, "speaker": 29, "form": "choice", "jp": "「『逆』に『ユウゴウ』しろってことじゃぁ？」"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "「『ユウゴウ』の『逆』ってことじゃぁ？」"},
{"id": 279, "speaker": 31, "form": "dlg", "jp": "「なんだよ、『ユウゴウ』の『逆』って‥‥」"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "「『ゴウユウ』？」"},
{"id": 281, "speaker": 31, "form": "dlg", "jp": "「『ゴウユウ』してどうするんだよ！」"},
{"id": 282, "speaker": 29, "form": "dlg", "jp": "「まじめに考えなさい！」"},
{"id": 283, "speaker": 29, "form": "choice", "jp": "「『私』の『逆』って言ってたよね？」"},
{"id": 284, "speaker": 29, "form": "choice", "jp": "「『逆』に『ユウゴウ』しろってことじゃぁ？」"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "「『逆』に『ユウゴウ』しろってことじゃぁ？」"},
{"id": 286, "speaker": 31, "form": "dlg", "jp": "「『融合』してどうなるんだ？」"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "「出口は『ノアの光』のせいで\n　『ダメージ』から守られているだろう‥‥」"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「だから『攻撃』をしても、一切通用しない‥‥」"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "「でも、\n　『融合』なら『ダメージ』を与えないから‥‥」"},
{"id": 290, "speaker": 29, "form": "dlg", "jp": "「直接『意識』を攻撃できる！！」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「だろう？」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「どうやって融合するかが問題だけど‥‥」"},
{"id": 293, "speaker": 29, "form": "dlg", "jp": "「ナゴムの『能力』を使うに決まってるでしょう！」"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "「『私』の『逆』って言ってたよね？」"},
{"id": 295, "speaker": 31, "form": "dlg", "jp": "「ああ、そんな感じのことを言ってた！」"},
{"id": 296, "speaker": 29, "form": "dlg", "jp": "「ナゴムのお母さんの『逆』って‥‥」"},
{"id": 297, "speaker": 29, "form": "choice", "jp": "「やっぱ、『能力』のことかなぁ？」"},
{"id": 298, "speaker": 29, "form": "choice", "jp": "「『残存思念』のことかな？」"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "「やっぱ、『能力』のことかなぁ？」"},
{"id": 300, "speaker": 31, "form": "dlg", "jp": "「『霊媒』の『能力』の『逆』？」"},
{"id": 301, "speaker": 31, "form": "choice", "jp": "「生きてる人を呼び出すとか？」"},
{"id": 302, "speaker": 31, "form": "choice", "jp": "「相手に乗り移るとか？」"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "「相手に乗り移るとか？」"},
{"id": 304, "speaker": 31, "form": "dlg", "jp": "「何言ってんだ？」"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「『霊媒』って死んだ人の魂を呼び出すんだろう？」"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "「その逆に相手に『魂』を送り込むっていうことじゃあ？」"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "「つまり、『意識』を送り込んで\n　相手の『意識』と戦うってこと‥‥」"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "「肉体を倒せなくても、\n　『意識』なら倒せるんじゃあ！」"},
{"id": 309, "speaker": 31, "form": "dlg", "jp": "「たしかにそうだけど‥‥」"},
{"id": 310, "speaker": 31, "form": "dlg", "jp": "「オマエのお母さんは\n　『オマエの能力』みたいなこと言って無かったか？」"},
{"id": 311, "speaker": 31, "form": "dlg", "jp": "「オマエにそんな能力ないだろう？」"},
{"id": 312, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥！？」"},
{"id": 313, "speaker": 29, "form": "dlg", "jp": "「ナゴムの能力で意識を送り込めるかも‥‥」"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "「ボクの能力で？」"},
{"id": 315, "speaker": 29, "form": "dlg", "jp": "「そうよ、『融合』すれば！」"},
{"id": 316, "speaker": 2, "form": "dlg", "jp": "「『融合』？」"},
{"id": 317, "speaker": 2, "form": "dlg", "jp": "「生きてる人を呼び出すとか？」"},
{"id": 318, "speaker": 31, "form": "dlg", "jp": "「何言ってんだ？」"},
{"id": 319, "speaker": 2, "form": "dlg", "jp": "「『霊媒』って死んだ人の魂を呼び出すんだろう？」"},
{"id": 320, "speaker": 29, "form": "dlg", "jp": "「それはちょっと違うわ！」"},
{"id": 321, "speaker": 29, "form": "dlg", "jp": "「本当の『霊媒』っていうのは\n　残された『意識』を読み取るだけなの‥‥」"},
{"id": 322, "speaker": 29, "form": "dlg", "jp": "「だから、その『意識』の『生死』は関係ないのよ」"},
{"id": 323, "speaker": 2, "form": "dlg", "jp": "「じゃあ、『生きている人間』の『意識』を\n　呼び出すことは可能なんだろう？」"},
{"id": 324, "speaker": 29, "form": "dlg", "jp": "「そういうことね‥‥」"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "「じゃあ、出口の『意識』だけを呼び出すことも！」"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "「肉体を倒せなくても、\n　『意識』なら倒せるんじゃあ！」"},
{"id": 327, "speaker": 31, "form": "dlg", "jp": "「たしかにそうだけど‥‥」"},
{"id": 328, "speaker": 31, "form": "dlg", "jp": "「オマエのお母さんは\n　『オマエの能力』みたいなこと言って無かったか？」"},
{"id": 329, "speaker": 31, "form": "dlg", "jp": "「オマエにそんな能力ないだろう？」"},
{"id": 330, "speaker": 31, "form": "dlg", "jp": "「それに呼び出すんなら\n　『逆』でもなんでもないし‥‥」"},
{"id": 331, "speaker": 29, "form": "dlg", "jp": "「‥‥‥！」"},
{"id": 332, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 333, "speaker": 29, "form": "dlg", "jp": "「わかったわ！」"},
{"id": 334, "speaker": 2, "form": "dlg", "jp": "「何が？」"},
{"id": 335, "speaker": 29, "form": "dlg", "jp": "「『逆』の意味よ！」"},
{"id": 336, "speaker": 29, "form": "dlg", "jp": "「『意識を呼び出す』の『逆』ってことよ！」"},
{"id": 337, "speaker": 31, "form": "dlg", "jp": "「つまり？」"},
{"id": 338, "speaker": 29, "form": "dlg", "jp": "「『意識を送り込む』のよ！」"},
{"id": 339, "speaker": 31, "form": "dlg", "jp": "「ちょっと待て、そんなことできるのかよ！」"},
{"id": 340, "speaker": 29, "form": "dlg", "jp": "「できる人間が１人いるでしょう？」"},
{"id": 341, "speaker": 2, "form": "dlg", "jp": "「ボ、ボクがぁ？」"},
{"id": 342, "speaker": 29, "form": "dlg", "jp": "「そうよ、『融合』すれば！」"},
{"id": 343, "speaker": 2, "form": "dlg", "jp": "「『融合』？」"},
{"id": 344, "speaker": 2, "form": "dlg", "jp": "「『残存思念』のことかな？」"},
{"id": 345, "speaker": 51, "form": "dlg", "jp": "「ちょっとええかな？」"},
{"id": 346, "speaker": 51, "form": "dlg", "jp": "「ウチ、その『残存思念』っていうのが\n　よくわからへんねんけど‥‥」"},
{"id": 347, "speaker": 51, "form": "dlg", "jp": "「常光寺のお母さんって、\n　『霊媒』と『残存思念』の能力を持ってたん？」"},
{"id": 348, "speaker": 16, "form": "dlg", "jp": "「ちょっといいかしら？」"},
{"id": 349, "speaker": 16, "form": "dlg", "jp": "「私、その『残存思念』っていうのが\n　よくわからないんけど‥‥」"},
{"id": 350, "speaker": 16, "form": "dlg", "jp": "「常光寺くんのお母さんって、\n　『霊媒』と『残存思念』の能力を持ってたの？」"},
{"id": 351, "speaker": 29, "form": "dlg", "jp": "「２つの能力を持つことはないんだって！」"},
{"id": 352, "speaker": 29, "form": "dlg", "jp": "「ナゴムのお母さんは、『意識』を\n　移動させる『能力』を持っていたのよ‥‥」"},
{"id": 353, "speaker": 29, "form": "dlg", "jp": "「だから、他人の『意識』を呼び出したり、\n　自分の『意識』を残したりできたのよ‥‥」"},
{"id": 354, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥！！」"},
{"id": 355, "speaker": 2, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 356, "speaker": 29, "form": "dlg", "jp": "「わかったのよ！」"},
{"id": 357, "speaker": 2, "form": "dlg", "jp": "「何が？」"},
{"id": 358, "speaker": 29, "form": "dlg", "jp": "「あのコを倒す方法よ！」"},
{"id": 359, "speaker": 2, "form": "dlg", "jp": "「本当？」"},
{"id": 360, "speaker": 29, "form": "dlg", "jp": "「ええ！」"},
{"id": 361, "speaker": 29, "form": "dlg", "jp": "「たしかにあのコの『命』をうばうことはできないけど、\n　あのコの『意識』を失わせることは‥‥」"},
{"id": 362, "speaker": 29, "form": "dlg", "jp": "「ナゴムのお母さんは\n　『命』は失ってるけど『意識』を残した‥‥」"},
{"id": 363, "speaker": 29, "form": "dlg", "jp": "「その『逆』ってことは『命』を残して\n　『意識』を失わせるってことじゃない？」"},
{"id": 364, "speaker": 31, "form": "dlg", "jp": "「うん？」"},
{"id": 365, "speaker": 31, "form": "dlg", "jp": "「つまり、『気絶』させるってことか？」"},
{"id": 366, "speaker": 29, "form": "dlg", "jp": "「まあ、そういうことね‥‥」"},
{"id": 367, "speaker": 51, "form": "dlg", "jp": "「でも、アイツはダメージを受けないのに\n　どうやって‥‥」"},
{"id": 368, "speaker": 16, "form": "dlg", "jp": "「でも、アイツはダメージを受けないのに\n　どうしたら‥‥」"},
{"id": 369, "speaker": 29, "form": "dlg", "jp": "「直接、『意識』を攻撃するのよ！」"},
{"id": 370, "speaker": 2, "form": "dlg", "jp": "「それこそどうやって？」"},
{"id": 371, "speaker": 29, "form": "dlg", "jp": "「それが『融合』ってことじゃないの？」"},
{"id": 372, "speaker": 2, "form": "dlg", "jp": "「‥‥‥？」"},
{"id": 373, "speaker": 29, "form": "dlg", "jp": "「あのコは『ノアの光』のせいで\n　『ダメージ』から守られている‥‥」"},
{"id": 374, "speaker": 29, "form": "dlg", "jp": "「だからあのコに『攻撃』をしても\n　一切通用しない‥‥」"},
{"id": 375, "speaker": 29, "form": "dlg", "jp": "「でも、\n　『融合』なら『ダメージ』を与えないから‥‥」"},
{"id": 376, "speaker": 2, "form": "dlg", "jp": "「ちょっと待ってよ！」"},
{"id": 377, "speaker": 2, "form": "dlg", "jp": "「話はなんとなくわかったけど、\n　実際どうやって『融合』するんだよ！」"},
{"id": 378, "speaker": 29, "form": "dlg", "jp": "「ナゴムの『能力』を使うに決まってるでしょう！」"},
{"id": 379, "speaker": 2, "form": "dlg", "jp": "「ボクの能力？」"},
{"id": 380, "speaker": 29, "form": "dlg", "jp": "「ナゴムは自分の体を自由に変質できるんだから」"},
{"id": 381, "speaker": 29, "form": "dlg", "jp": "「その『能力』を使って、\n　あのコと『一体化』すれば‥‥」"},
{"id": 382, "speaker": 31, "form": "dlg", "jp": "「なるほど！！」"},
{"id": 383, "speaker": 31, "form": "dlg", "jp": "「『肉体』が１つになれば、\n　神経を通って直接アイツの意識と戦える！！」"},
{"id": 384, "speaker": 2, "form": "dlg", "jp": "「そんなことできるのかなぁ？」"},
{"id": 385, "speaker": 29, "form": "dlg", "jp": "「ダメよ疑ったら！！」"},
{"id": 386, "speaker": 29, "form": "dlg", "jp": "「『能力』は『イメージ』の強さに左右されるの！」"},
{"id": 387, "speaker": 29, "form": "dlg", "jp": "「疑う心が働いたら、\n　できることもできなくなるわよ！」"},
{"id": 388, "speaker": 0, "form": "dlg", "jp": "「臨時ニュースです」"},
{"id": 389, "speaker": 31, "form": "dlg", "jp": "「オイ、まだニュースが続いてたみたいだぜ！」"},
{"id": 390, "speaker": 0, "form": "dlg", "jp": "「先ほどニューヨークに現れた\n　『謎の飛行物体』と同じものが」"},
{"id": 391, "speaker": 0, "form": "dlg", "jp": "「『上海』上空にも現れたもようです‥‥」"},
{"id": 392, "speaker": 31, "form": "dlg", "jp": "「おい、急がないと！」"},
{"id": 393, "speaker": 31, "form": "dlg", "jp": "「ジーン、アイツの居場所わかるか？」"},
{"id": 394, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 395, "speaker": 29, "form": "dlg", "jp": "ジーンは『能力』を使って\n出口のことを探し始めた。"},
{"id": 396, "speaker": 29, "form": "dlg", "jp": "「見つけたわ！」"},
{"id": 397, "speaker": 31, "form": "dlg", "jp": "「で、どこに？」"},
{"id": 398, "speaker": 29, "form": "dlg", "jp": "「例のホテルにいるわ！」"},
{"id": 399, "speaker": 31, "form": "dlg", "jp": "「よしっ、行こう！」"},
{"id": 400, "speaker": 31, "form": "dlg", "jp": "ボクたちは一刻も早くノアを取りかえすため、\n出口のいるホテルへと向かった。"}
]
