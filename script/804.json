[
{"id": 0, "speaker": 2, "form": "dlg", "jp": "「静かだね‥‥」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "「これってもう使われてない倉庫じゃないのか？」"},
{"id": 2, "speaker": 16, "form": "dlg", "jp": "「それっておかしくない？」"},
{"id": 3, "speaker": 16, "form": "dlg", "jp": "「使ってない倉庫に入って行くなんて‥‥」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「ま、それもそうだね‥‥」"},
{"id": 5, "speaker": 16, "form": "dlg", "jp": "「ちょっと、中をのぞいてみましょうか？」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「いいけど‥‥」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "ボクたちは倉庫の中をのぞいてみることにした！"},
{"id": 8, "speaker": 16, "form": "dlg", "jp": "「真っ暗ね‥‥」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "「やっぱり、使われてないみたいね‥‥」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "倉庫の中は灯もなく、\nまったく使われている様子はなかった。"},
{"id": 11, "speaker": 16, "form": "dlg", "jp": "「どうしてこんなトコ入っていったのかな？」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「さあ‥‥」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「とにかく、ここには誰もいないみたいだね‥‥」"},
{"id": 14, "speaker": 16, "form": "dlg", "jp": "「ちょっと待ってよ！」"},
{"id": 15, "speaker": 4, "form": "dlg", "jp": "「誰だ！！」"},
{"id": 16, "speaker": 4, "form": "dlg", "jp": "‥‥‥‥‥！！"},
{"id": 17, "speaker": 4, "form": "dlg", "jp": "倉庫の奥から男の人が現れた。"},
{"id": 18, "speaker": 4, "form": "dlg", "jp": "「こんなところで何してる？」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「い、いえ‥‥」"},
{"id": 20, "speaker": 16, "form": "dlg", "jp": "「な、なんにも‥‥」"},
{"id": 21, "speaker": 4, "form": "dlg", "jp": "「なんか、怪しいねキミたち‥‥」"},
{"id": 22, "speaker": 4, "form": "dlg", "jp": "「まさか‥‥キミたち‥‥」"},
{"id": 23, "speaker": 4, "form": "dlg", "jp": "‥‥‥‥‥！！"},
{"id": 24, "speaker": 4, "form": "dlg", "jp": "「ひとけがないからって、\n　ここに入ってきてイチャつこうとしてたんじゃ？」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「ち、ちがい‥‥」"},
{"id": 26, "speaker": 16, "form": "dlg", "jp": "「ば、ばれちゃいました！」"},
{"id": 27, "speaker": 16, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 28, "speaker": 16, "form": "dlg", "jp": "「もう、ナゴムったらエッチなんだから‥‥」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「はぁ‥‥」"},
{"id": 30, "speaker": 4, "form": "dlg", "jp": "「今の子供はとんでもないなぁ‥‥」"},
{"id": 31, "speaker": 4, "form": "dlg", "jp": "「親が泣くよ、親が‥‥」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 33, "speaker": 4, "form": "dlg", "jp": "「夏休みの宿題とかあるんだろう？」"},
{"id": 34, "speaker": 4, "form": "dlg", "jp": "「とっとと帰って親孝行でもしなさい！」"},
{"id": 35, "speaker": 4, "form": "dlg", "jp": "こうしてボクたちは倉庫を追い出されてしまった。"},
{"id": 36, "speaker": 16, "form": "dlg", "jp": "「お、おどろいたわね‥‥」"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "「それはコッチの台詞だよ！」"},
{"id": 38, "speaker": 2, "form": "dlg", "jp": "「何が『幽霊』だよ、\n　ただのおじさんじゃないか‥‥」"},
{"id": 39, "speaker": 16, "form": "dlg", "jp": "「違うわよ、あの人！」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「えっ？」"},
{"id": 41, "speaker": 16, "form": "dlg", "jp": "「アキラが言ってるのはもっと若い男の人！」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "「じゃあ、あの人は？」"},
{"id": 43, "speaker": 16, "form": "dlg", "jp": "「さあ、倉庫の管理人かなにかじゃないの？」"},
{"id": 44, "speaker": 2, "form": "dlg", "jp": "「そうかな？」"},
{"id": 45, "speaker": 16, "form": "dlg", "jp": "「そうよ、じゃないと使ってない倉庫に\n　どうしているのよ！」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「でも、あの人は倉庫の奥から出て来たよ？」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「管理人なら、\n　外から入ってくるんじゃないかな？」"},
{"id": 48, "speaker": 16, "form": "dlg", "jp": "「常光寺くんて細かいこと気にするのね‥‥」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「だって‥‥」"},
{"id": 50, "speaker": 16, "form": "dlg", "jp": "「あの人が誰でもいいんじゃないの？」"},
{"id": 51, "speaker": 16, "form": "dlg", "jp": "「アキラが知りたいのは『幽霊』の正体だけ‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「それなら、あそこにはいなかったんだから\n　もういいんじゃないかな？」"},
{"id": 53, "speaker": 16, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 54, "speaker": 16, "form": "dlg", "jp": "「いいわ、今日は解散ってことで‥‥」"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「『今日は』って？」"},
{"id": 56, "speaker": 16, "form": "dlg", "jp": "「だって、\n　何もわからないのキモチ悪いでしょう？」"},
{"id": 57, "speaker": 16, "form": "dlg", "jp": "「また、手がかりが見つかったらお願いするわ！」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「勝手なんだから‥‥」"},
{"id": 59, "speaker": 51, "form": "dlg", "jp": "「それならそれでおかしいんちゃうん？」"},
