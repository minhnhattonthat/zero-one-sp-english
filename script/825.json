{"id": 31, "speaker": null, "form": "dlg", "jp": "ナナセです。"},
{"id": 32, "speaker": null, "form": "dlg", "jp": "ではゲームスタート！"},
{"id": 33, "speaker": null, "form": "dlg", "jp": "２００５／０８／２２／ＡＭ１０：４０"},
{"id": 34, "speaker": null, "form": "dlg", "jp": "この日、朝早くにアイコから電話がかかってきた。"},
{"id": 35, "speaker": null, "form": "dlg", "jp": "この日、朝早くに長尾から電話がかかってきた。"},
{"id": 36, "speaker": null, "form": "dlg", "jp": "この日、朝早くに堤さんから電話がかかってきた。"},
{"id": 37, "speaker": null, "form": "dlg", "jp": "電話によると、\n新しい仲間が増える『夢』を見たという。"},
{"id": 38, "speaker": 31, "form": "dlg", "jp": "「本当にそんなところに仲間がいるのか？」"},
{"id": 39, "speaker": 15, "form": "dlg", "jp": "「だって、そういう『夢』見ちゃったんだもん！」"},
{"id": 40, "speaker": 16, "form": "dlg", "jp": "「だって、そういう『夢』見ちゃったんだもん！」"},
{"id": 41, "speaker": 18, "form": "dlg", "jp": "「だって、そういう『夢』を見ちゃったんです」"},
{"id": 42, "speaker": 31, "form": "dlg", "jp": "「なんでよりによって、『富士山』なんだよ？」"},
{"id": 43, "speaker": 15, "form": "dlg", "jp": "「行けばわかるわ！」"},
{"id": 44, "speaker": 16, "form": "dlg", "jp": "「行けばわかるわよ！」"},
{"id": 45, "speaker": 18, "form": "dlg", "jp": "「行けばわかります」"},
{"id": 46, "speaker": 29, "form": "dlg", "jp": "「で、ソイツは本当に仲間になってくれるの？」"},
{"id": 47, "speaker": 29, "form": "dlg", "jp": "「この間のヘンタイみたいなことはないでしょうね？」"},
{"id": 48, "speaker": 15, "form": "dlg", "jp": "「大丈夫！　夢の通りならすぐに見つかって\n　すぐに仲間になってくれるから‥‥」"},
{"id": 49, "speaker": 16, "form": "dlg", "jp": "「大丈夫！　夢の通りならすぐに見つかって\n　すぐに仲間になってくれるから‥‥」"},
{"id": 50, "speaker": 18, "form": "dlg", "jp": "「大丈夫です、夢の通りならすぐに見つかって\n　すぐに仲間になってくれるはずです‥‥」"},
{"id": 51, "speaker": 18, "form": "dlg", "jp": "「キーッ！」"},
{"id": 52, "speaker": 31, "form": "dlg", "jp": "「オイ、ありゃなんだ？」"},
{"id": 53, "speaker": 34, "form": "dlg", "jp": "「ちょっと、この先は『侵入禁止』ですよ！」"},
{"id": 54, "speaker": 31, "form": "dlg", "jp": "「ハァ？」"},
{"id": 55, "speaker": 34, "form": "dlg", "jp": "「本日は自衛隊の演習がありますから、\n　一般人の侵入は禁止しています」"},
{"id": 56, "speaker": 34, "form": "dlg", "jp": "「まことにお手数ですが、\n　迂回してもらえますでしょうか？」"},
{"id": 57, "speaker": 31, "form": "dlg", "jp": "「ナゴム、コイツ何言ってんだ？」"},
{"id": 58, "speaker": 31, "form": "choice", "jp": "「ここから先には進めないよって‥‥」"},
{"id": 59, "speaker": 31, "form": "choice", "jp": "「無視して行っちゃいなよ！」"},
{"id": 60, "speaker": 31, "form": "choice", "jp": "「悪いけど別の道を通れって‥‥」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "「ここから先には進めないよって‥‥」"},
{"id": 62, "speaker": 31, "form": "dlg", "jp": "「どうして？」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「自衛隊の軍事演習があるんだって‥‥」"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "「無視して行っちゃいなよ！」"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "「ダメよ！」"},
{"id": 66, "speaker": 31, "form": "dlg", "jp": "「どうして？」"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "「この先で軍事演習をしてるんだって‥‥」"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "「悪いけど別の道を通れって‥‥」"},
{"id": 69, "speaker": 31, "form": "dlg", "jp": "「どうして？」"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "「自衛隊の軍事演習があるんだって‥‥」"},
{"id": 71, "speaker": 31, "form": "dlg", "jp": "「オイオイ！」"},
{"id": 72, "speaker": 31, "form": "dlg", "jp": "「ニホンに軍隊は無いんだろう？」"},
{"id": 73, "speaker": 34, "form": "dlg", "jp": "「ハイ、軍事演習ではありません！」"},
{"id": 74, "speaker": 34, "form": "dlg", "jp": "「ただの演習です」"},
{"id": 75, "speaker": 31, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 76, "speaker": 31, "form": "dlg", "jp": "「オレ、コイツの言ってることがわかんないんだけど？」"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "「まあ、そういう国なんだよ‥‥」"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "「この先に進むのはあきらめよう‥‥」"},
{"id": 79, "speaker": 31, "form": "dlg", "jp": "「アイコ、本当にこんなところにいるのか？」"},
{"id": 80, "speaker": 31, "form": "dlg", "jp": "「新しい仲間‥‥」"},
{"id": 81, "speaker": 15, "form": "dlg", "jp": "「いるわよ！」"},
{"id": 82, "speaker": 15, "form": "dlg", "jp": "「だって彼、自衛隊員だもん！」"},
{"id": 83, "speaker": 31, "form": "dlg", "jp": "「アキラ、本当にこんなところにいるのか？」"},
{"id": 84, "speaker": 31, "form": "dlg", "jp": "「新しい仲間‥‥」"},
{"id": 85, "speaker": 16, "form": "dlg", "jp": "「いるわよ！」"},
{"id": 86, "speaker": 16, "form": "dlg", "jp": "「だって彼、自衛隊員だもん！」"},
{"id": 87, "speaker": 31, "form": "dlg", "jp": "「ナナセ、本当にこんなところにいるのか？」"},
{"id": 88, "speaker": 31, "form": "dlg", "jp": "「新しい仲間‥‥」"},
{"id": 89, "speaker": 18, "form": "dlg", "jp": "「います！」"},
{"id": 90, "speaker": 18, "form": "dlg", "jp": "「だって彼、自衛隊員なんです！」"},
{"id": 91, "speaker": 31, "form": "dlg", "jp": "「‥‥どうする、ジーン？」"},
{"id": 92, "speaker": 29, "form": "dlg", "jp": "「仕方ないわね‥‥」"},
{"id": 93, "speaker": 29, "form": "dlg", "jp": "「こっそり入っちゃおうか？」"},
{"id": 94, "speaker": 34, "form": "dlg", "jp": "「今、何か言いませんでしたか？」"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "「いいえ、何も‥‥」"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "「じゃあ、私たち引き返しますんで‥‥」"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 98, "speaker": 29, "form": "dlg", "jp": "ボクたちは車をおいて、山道を通り\nこっそりと演習場に潜り込んだ。"}
]
