{"id": 177, "speaker": 2, "form": "dlg", "jp": "「この後どうなるのかなって思って‥‥」"},
{"id": 178, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 179, "speaker": 29, "form": "dlg", "jp": "「私には『予知能力』はないから‥‥」"},
{"id": 180, "speaker": 29, "form": "dlg", "jp": "「アイコならわかるかもしれないわね‥‥」"},
{"id": 181, "speaker": 29, "form": "dlg", "jp": "「アキラならわかるかもしれないわね‥‥」"},
{"id": 182, "speaker": 29, "form": "dlg", "jp": "「ナナセならわかるかもしれないわね‥‥」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「でも、『ゲージ』は見えるんだろう？」"},
{"id": 184, "speaker": 29, "form": "dlg", "jp": "「見えない方がよかったわ‥‥」"},
{"id": 185, "speaker": 29, "form": "dlg", "jp": "「こんな能力はなかった方がよかった‥‥」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「なんで？」"},
{"id": 187, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 188, "speaker": 29, "form": "dlg", "jp": "『世界の終わり』"},
{"id": 189, "speaker": 29, "form": "dlg", "jp": "の"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "『カウントダウン』"},
{"id": 191, "speaker": 29, "form": "dlg", "jp": "が見えるのよ‥‥」"},
{"id": 192, "speaker": 29, "form": "dlg", "jp": "「見えないナゴムにはわからないでしょうけど‥‥」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「コワイの？」"},
{"id": 194, "speaker": 29, "form": "dlg", "jp": "「コワイわよ！」"},
{"id": 195, "speaker": 29, "form": "dlg", "jp": "「コワくて、コワくて仕方ない！」"},
{"id": 196, "speaker": 29, "form": "dlg", "jp": "「あと数時間でみんなが死んじゃうのが\n　実感できる能力なんて‥‥」"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "「まだ死ぬって決まったわけじゃないよ‥‥」"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "「そのために父さんたちもがんばってるんだし‥‥」"},
{"id": 199, "speaker": 29, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "「ジーンには『陽気なラテンの血』が流れてるんだから\n　もっとノーテンキにかまえていれば？」"},
{"id": 201, "speaker": 2, "form": "dlg", "jp": "「まだどうなるかわからないんだし、\n　もしかしたら助かるかもしれないし‥‥」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「まあ、ダメだったとしても\n　それはそれで仕方ないんだから」"},
{"id": 203, "speaker": 2, "form": "dlg", "jp": "「とにかく、あと数時間の間は絶対安全なんだから、\n　『余生』を楽しんだ方がいいんじゃないかな？」"},
{"id": 204, "speaker": 29, "form": "dlg", "jp": "「アリガト‥‥」"},
{"id": 205, "speaker": 29, "form": "dlg", "jp": "「少し気が楽になった‥‥」"},
{"id": 206, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 207, "speaker": 29, "form": "dlg", "jp": "「じゃぁ、私、部屋に戻るわ‥‥」"},
{"id": 208, "speaker": 29, "form": "dlg", "jp": "「ナゴムと２人っきりだなんてアイコにバレたら\n　怒られちゃうから‥‥」"},
{"id": 209, "speaker": 29, "form": "dlg", "jp": "「ナゴムと２人っきりだなんてアキラにバレたら\n　怒られちゃうから‥‥」"},
{"id": 210, "speaker": 29, "form": "dlg", "jp": "「ナゴムと２人っきりだなんてナナセにバレたら\n　怒られちゃうから‥‥」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「なんで？」"},
{"id": 212, "speaker": 29, "form": "dlg", "jp": "「私もナゴムぐらい鈍感だったら\n　悩みが減るんだけどなぁ～」"},
{"id": 213, "speaker": 29, "form": "dlg", "jp": "「じゃぁ‥‥」"},
{"id": 214, "speaker": 29, "form": "dlg", "jp": "ボクはジーンと別れた。"},
{"id": 215, "speaker": 29, "form": "dlg", "jp": "「アラ？」"},
{"id": 216, "speaker": 29, "form": "dlg", "jp": "「ナゴムどこへ行くの？」"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "「いや、ジーンに会いに行こうと思ってたとこ‥‥」"},
{"id": 218, "speaker": 29, "form": "dlg", "jp": "「ふーん‥‥」"},
{"id": 219, "speaker": 29, "form": "dlg", "jp": "「立ち話もなんだし‥‥」"},
{"id": 220, "speaker": 29, "form": "dlg", "jp": "「上にあがってみない？」"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "「上って？」"},
{"id": 222, "speaker": 29, "form": "dlg", "jp": "「まだ、遺跡の観光してないんでしょう？」"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "「だって、観光で来たわけじゃないから」"},
{"id": 224, "speaker": 29, "form": "dlg", "jp": "「気にしなくていいんじゃない？」"},
{"id": 225, "speaker": 29, "form": "dlg", "jp": "「もうオシマイかもしれないんだから‥‥」"},
{"id": 226, "speaker": 29, "form": "dlg", "jp": "ボクたちは上の遺跡に行ってみることにした。"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「いいながめだね‥‥」"},
{"id": 228, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "「ほとんど本部の中ばっかりだったから\n　あんまり実感なかったけど」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「今、『外国』にいるんだよなぁ」"},
{"id": 231, "speaker": 29, "form": "dlg", "jp": "「そういえば、前に『ペルー』に来た時は牢の中だしね‥‥」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「忘れてたけど、\n　ジーンとはじめて会ったのもこの国だったね」"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "「そうだったわね‥‥」"},
{"id": 234, "speaker": 29, "form": "dlg", "jp": "「あれからまだ１ヶ月しかたってないのに‥‥」"},
{"id": 235, "speaker": 29, "form": "dlg", "jp": "「ナゴムはすっかり『戦士』になった感じね」"},
{"id": 236, "speaker": 2, "form": "dlg", "jp": "「いろいろあったから‥‥」"},
{"id": 237, "speaker": 29, "form": "dlg", "jp": "「ゴメンね、私が巻き込んだせいね‥‥」"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "「関係ないよ！」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「ジーンと出会わなかったら、\n　あの『牢』の中で死んでいたよ！」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「それに‥‥」"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "「『ゲーマー』の攻撃に巻き込まれない人間なんて\n　１人もいないんだから‥‥」"},
{"id": 242, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「この後どうなるんだろうね‥‥」"},
{"id": 244, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 245, "speaker": 29, "form": "dlg", "jp": "「私には『予知能力』はないから‥‥」"},
{"id": 246, "speaker": 29, "form": "dlg", "jp": "「アイコならわかるかもしれないわね‥‥」"},
{"id": 247, "speaker": 29, "form": "dlg", "jp": "「アキラならわかるかもしれないわね‥‥」"},
{"id": 248, "speaker": 29, "form": "dlg", "jp": "「ナナセならわかるかもしれないわね‥‥」"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "「でも、『ゲージ』は見えるんだろう？」"},
{"id": 250, "speaker": 29, "form": "dlg", "jp": "「見えない方がよかったわ‥‥」"},
{"id": 251, "speaker": 29, "form": "dlg", "jp": "「こんな能力はなかった方がよかった‥‥」"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "「なんで？」"},
{"id": 253, "speaker": 29, "form": "dlg", "jp": "「"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "『世界の終わり』"},
{"id": 255, "speaker": 29, "form": "dlg", "jp": "の"},
{"id": 256, "speaker": 29, "form": "dlg", "jp": "『カウントダウン』"},
{"id": 257, "speaker": 29, "form": "dlg", "jp": "が見えるのよ‥‥」"},
{"id": 258, "speaker": 29, "form": "dlg", "jp": "「見えないナゴムにはわからないでしょうけど‥‥」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「コワイの？」"},
{"id": 260, "speaker": 29, "form": "dlg", "jp": "「コワイわよ！」"},
{"id": 261, "speaker": 29, "form": "dlg", "jp": "「コワくて、コワくて仕方ない！」"},
{"id": 262, "speaker": 29, "form": "dlg", "jp": "「あと数時間でみんなが死んじゃうのが\n　実感できる能力なんて‥‥」"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "「まだ死ぬって決まったわけじゃないよ‥‥」"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "「そのために父さんたちもがんばってるんだし‥‥」"},
{"id": 265, "speaker": 29, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "「ジーンには『陽気なラテンの血』が流れてるんだから\n　もっとノーテンキにかまえていれば？」"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "「まだどうなるかわからないんだし、\n　もしかしたら助かるかもしれないし‥‥」"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "「まあ、ダメだったとしても\n　それはそれで仕方ないんだから」"},
{"id": 269, "speaker": 2, "form": "dlg", "jp": "「とにかく、あと数時間の間は絶対安全なんだから、\n　『余生』を楽しんだ方がいいんじゃないかな？」"},
{"id": 270, "speaker": 29, "form": "dlg", "jp": "「アリガト‥‥」"},
{"id": 271, "speaker": 29, "form": "dlg", "jp": "「少し気が楽になった‥‥」"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "「じゃあ戻ろうか？」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「ジーンも少し眠った方がいいよ！」"},
{"id": 274, "speaker": 29, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 275, "speaker": 29, "form": "dlg", "jp": "ボクはジーンと別れた。"},
{"id": 276, "speaker": 29, "form": "choice", "jp": "【ケネスのところでも行ってみるか‥‥】"},
{"id": 277, "speaker": 29, "form": "choice", "jp": "【アイコのところでも行ってみるか‥‥】"},
{"id": 278, "speaker": 29, "form": "choice", "jp": "【ケネスのところでも行ってみるか‥‥】"},
{"id": 279, "speaker": 29, "form": "choice", "jp": "【長尾のところでも行ってみるか‥‥】"},
{"id": 280, "speaker": 29, "form": "choice", "jp": "【ケネスのところでも行ってみるか‥‥】"},
{"id": 281, "speaker": 29, "form": "choice", "jp": "【堤さんのところでも行ってみるか‥‥】"},
{"id": 282, "speaker": 29, "form": "dlg", "jp": "ウロウロしていても仕方ないな‥‥"},
{"id": 283, "speaker": 29, "form": "dlg", "jp": "ボクは父さんたちの様子を見に行くことにした。"},
{"id": 284, "speaker": 29, "form": "dlg", "jp": "【アイコのところでも行ってみるか‥‥】"},
{"id": 285, "speaker": 29, "form": "dlg", "jp": "ボクはアイコの部屋に行くことにした。"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "「アイコ、入るよ‥‥」"},
{"id": 287, "speaker": 15, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "「いや、別に用はないけど‥‥」"},
{"id": 289, "speaker": 15, "form": "dlg", "jp": "「ジーンなら出て行っちゃったわよ‥‥」"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "「なあ、アイコ‥‥」"},
{"id": 291, "speaker": 15, "form": "dlg", "jp": "「何？」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "「本当に最近『夢』を見ていないのか？」"},
{"id": 293, "speaker": 15, "form": "dlg", "jp": "「うん」"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 295, "speaker": 15, "form": "dlg", "jp": "「それより良かったわね、\n　オジさんが生きてて‥‥」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 297, "speaker": 2, "form": "dlg", "jp": "「生きてるんだったら生きているで\n　連絡ぐらいくれたら良かったのに‥‥」"},
{"id": 298, "speaker": 15, "form": "dlg", "jp": "「もう少しほとぼりが冷めるのを待ってたんじゃぁ？」"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 301, "speaker": 2, "form": "dlg", "jp": "「‥‥」"},
{"id": 302, "speaker": 2, "form": "dlg", "jp": "「ボクたちこのままヤラれちゃうのかなぁ‥‥？」"},
{"id": 303, "speaker": 15, "form": "dlg", "jp": "「さあ、わからない‥‥」"},
{"id": 304, "speaker": 15, "form": "dlg", "jp": "「でも、『ゲーマー』は人間を全滅はさせないんでしょう？」"},
{"id": 305, "speaker": 15, "form": "dlg", "jp": "「なら、私たちだけは助かるかもしれないわね！」"},
{"id": 306, "speaker": 15, "form": "dlg", "jp": "「ここには『アカシックレコード』があるから\n　大きな攻撃はしてこないでしょうし‥‥」"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "「それはどうだろう？」"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "「『アカシックレコード』はどっちにしても\n　壊れないんだからここも攻撃して来るんじゃない？」"},
{"id": 309, "speaker": 2, "form": "dlg", "jp": "「それにボクたちだけ生き残ればいいって考えも\n　あんまり賛同できないな‥‥」"},
{"id": 310, "speaker": 15, "form": "dlg", "jp": "「じゃあ、ナゴムちゃんは死ぬのは恐くないの？」"},
{"id": 311, "speaker": 2, "form": "dlg", "jp": "「そりゃあコワイよ‥‥」"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "「でも、自分たち以外にみんなが死んじゃうっていうのも\n　自分が死ぬのと同じくらいコワイよ！」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "「コワイから戦ってきたんじゃないか！」"},
{"id": 314, "speaker": 15, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 315, "speaker": 15, "form": "dlg", "jp": "「ゴメンなさい‥‥」"},
{"id": 316, "speaker": 15, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 317, "speaker": 15, "form": "dlg", "jp": "「ねえ、ナゴムちゃん‥‥」"},
{"id": 318, "speaker": 15, "form": "dlg", "jp": "「もう、部屋に戻った方がいいんじゃぁ？」"},
{"id": 319, "speaker": 2, "form": "dlg", "jp": "「どうして？」"},
{"id": 320, "speaker": 15, "form": "dlg", "jp": "「２人っきりでいるところをジーンに見つかったら\n　叱られちゃうわよ！」"},
{"id": 321, "speaker": 2, "form": "dlg", "jp": "「なんで、そんなことで叱られるんだよ！」"},
{"id": 322, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃんは相変わらずニブイのね」"},
{"id": 323, "speaker": 2, "form": "dlg", "jp": "「はあ？」"},
{"id": 324, "speaker": 15, "form": "dlg", "jp": "「とにかく、私は少し眠るから\n　ナゴムちゃんも部屋に戻りなさい！」"},
{"id": 325, "speaker": 15, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 327, "speaker": 2, "form": "dlg", "jp": "ボクはアイコの部屋を出た。"},
{"id": 328, "speaker": 15, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 329, "speaker": 2, "form": "dlg", "jp": "「いや、別に用はないけど‥‥」"},
{"id": 330, "speaker": 15, "form": "dlg", "jp": "「ジーンなら出て行っちゃったわよ‥‥」"},
{"id": 331, "speaker": 2, "form": "dlg", "jp": "「なあ、アイコ‥‥」"},
{"id": 332, "speaker": 15, "form": "dlg", "jp": "「何？」"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "「本当に最近『夢』を見ていないのか？」"},
{"id": 334, "speaker": 15, "form": "dlg", "jp": "「うん」"},
{"id": 335, "speaker": 2, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 336, "speaker": 15, "form": "dlg", "jp": "「ねえ、ナゴムちゃん‥‥」"},
{"id": 337, "speaker": 15, "form": "dlg", "jp": "「上の遺跡に行ってみない？」"},
{"id": 338, "speaker": 2, "form": "dlg", "jp": "「えっ？」"},
{"id": 339, "speaker": 2, "form": "dlg", "jp": "「別にいいけど‥‥」"},
{"id": 340, "speaker": 15, "form": "dlg", "jp": "「じゃあ、行きましょう！」"},
{"id": 341, "speaker": 15, "form": "dlg", "jp": "ボクたちは上の遺跡に行ってみることにした。"},
{"id": 342, "speaker": 2, "form": "dlg", "jp": "「いいながめだね‥‥」"},
{"id": 343, "speaker": 15, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 344, "speaker": 2, "form": "dlg", "jp": "「ほとんど本部の中ばっかりだったから\n　あんまり実感なかったけど」"},
{"id": 345, "speaker": 2, "form": "dlg", "jp": "「今、『外国』にいるんだよなぁ」"},
{"id": 346, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃんは前にも『ペルー』には来たんでしょう？」"},
{"id": 347, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 348, "speaker": 2, "form": "dlg", "jp": "「でもあの時は『牢』に閉じ込められていただけだから‥‥」"},
{"id": 349, "speaker": 15, "form": "dlg", "jp": "「本当にいろんな目にあってるんだね？」"},
{"id": 350, "speaker": 2, "form": "dlg", "jp": "「いやになるよ‥」"},
{"id": 351, "speaker": 15, "form": "dlg", "jp": "「そうそう、オジさんが生きていたんだね！」"},
{"id": 352, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 353, "speaker": 2, "form": "dlg", "jp": "「生きてるんだったら生きているで\n　連絡ぐらいくれたら良かったのに‥‥」"},
{"id": 354, "speaker": 15, "form": "dlg", "jp": "「もう少しほとぼりが冷めるのを待ってたんじゃぁ？」"},
{"id": 355, "speaker": 2, "form": "dlg", "jp": "「そうなんだろうけど‥‥」"},
{"id": 356, "speaker": 2, "form": "dlg", "jp": "「せっかく家族３人そろったのに\n　世界の終わりが近付いているなんて‥‥」"},
{"id": 357, "speaker": 2, "form": "dlg", "jp": "「ボクたちこのままヤラれちゃうのかなぁ‥‥？」"},
{"id": 358, "speaker": 15, "form": "dlg", "jp": "「さあ、わからない‥‥」"},
{"id": 359, "speaker": 15, "form": "dlg", "jp": "「でも、『ゲーマー』は人間を全滅はさせないんでしょう？」"},
{"id": 360, "speaker": 15, "form": "dlg", "jp": "「なら、私たちだけは助かるかもしれないわね！」"},
{"id": 361, "speaker": 15, "form": "dlg", "jp": "「ここには『アカシックレコード』があるから\n　大きな攻撃はしてこないでしょうし‥‥」"},
{"id": 362, "speaker": 2, "form": "dlg", "jp": "「それはどうだろう？」"},
{"id": 363, "speaker": 2, "form": "dlg", "jp": "「『アカシックレコード』はどっちにしても\n　壊れないんだからここも攻撃して来るんじゃない？」"},
{"id": 364, "speaker": 2, "form": "dlg", "jp": "「それにボクたちだけ生き残ればいいって考えも\n　あんまり賛同できないな‥‥」"},
{"id": 365, "speaker": 2, "form": "dlg", "jp": "「たしかに、\n　ウチの家族はここに集まっちゃっているけど‥‥」"},
{"id": 366, "speaker": 2, "form": "dlg", "jp": "「アイコの家族はそうじゃないんだし‥‥」"},
{"id": 367, "speaker": 15, "form": "dlg", "jp": "「ジョウダンよ！」"},
{"id": 368, "speaker": 15, "form": "dlg", "jp": "「なんか‥‥」"},
{"id": 369, "speaker": 15, "form": "dlg", "jp": "「あと数時間で世界が滅んじゃうって言われても\n　全然実感がわかないの‥‥」"},
{"id": 370, "speaker": 15, "form": "dlg", "jp": "「まあ、私の場合はただ『夢』を報告するだけで\n　戦ってきたわけじゃないけど」"},
{"id": 371, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃんは今まで命がけで戦ってきたけど\n　恐くなかったの？」"},
{"id": 372, "speaker": 2, "form": "dlg", "jp": "「そりゃあコワイよ‥‥」"},
{"id": 373, "speaker": 2, "form": "dlg", "jp": "「でも、自分たち以外にみんなが死んじゃうっていうのも\n　自分が死ぬのと同じくらいコワイよ！」"},
{"id": 374, "speaker": 2, "form": "dlg", "jp": "「コワイから戦ってきたのかもしれないな‥‥」"},
{"id": 375, "speaker": 15, "form": "dlg", "jp": "「ねぇ‥‥」"},
{"id": 376, "speaker": 2, "form": "dlg", "jp": "「うん？」"},
{"id": 377, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん‥‥」"},
{"id": 378, "speaker": 15, "form": "dlg", "jp": "「アイコが死んだら悲しい？」"},
{"id": 379, "speaker": 2, "form": "dlg", "jp": "「当たり前じゃないか！」"},
{"id": 380, "speaker": 15, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 381, "speaker": 15, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 382, "speaker": 2, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 383, "speaker": 15, "form": "dlg", "jp": "「アイコもナゴムちゃんが死んだらイヤだと思って‥‥」"},
{"id": 384, "speaker": 2, "form": "dlg", "jp": "「なるべく死なないようにするよ‥‥」"},
{"id": 385, "speaker": 15, "form": "dlg", "jp": "「ダメよ！」"},
{"id": 386, "speaker": 15, "form": "dlg", "jp": "「絶対死んじゃダメ！！」"},
{"id": 387, "speaker": 15, "form": "dlg", "jp": "「もう『約束』なんてどうでもいいから！」"},
{"id": 388, "speaker": 2, "form": "dlg", "jp": "「『約束』？」"},
{"id": 389, "speaker": 2, "form": "dlg", "jp": "「なあ、アイコ‥‥」"},
{"id": 390, "speaker": 2, "form": "dlg", "jp": "「前から気になってたんだけど‥‥」"},
{"id": 391, "speaker": 2, "form": "dlg", "jp": "「『約束』ってなんなんだ？」"},
{"id": 392, "speaker": 15, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 393, "speaker": 15, "form": "dlg", "jp": "「昔のことだから覚えてないわよね‥‥」"},
{"id": 394, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん、『インディー』のこと覚えてる？」"},
{"id": 395, "speaker": 2, "form": "dlg", "jp": "「アイコが飼っていた犬だろう？」"},
{"id": 396, "speaker": 15, "form": "dlg", "jp": "「『インディー』が死んだ時のことは？」"},
{"id": 397, "speaker": 2, "form": "dlg", "jp": "「『インディーが死んだ時』？」"},
{"id": 398, "speaker": 2, "form": "dlg", "jp": "（思い出した！！）"},
{"id": 399, "speaker": 2, "form": "dlg", "jp": "（ボクは『アイコを守る約束』をしたんだ！！）"},
{"id": 400, "speaker": 2, "form": "dlg", "jp": "それは小学校の２年か、３年の時だったと思う‥‥"},
{"id": 401, "speaker": 2, "form": "dlg", "jp": "犬を散歩中のアイコが、\nトラックにひかれそうになったことがあったんだ。"},
{"id": 402, "speaker": 2, "form": "dlg", "jp": "で、とっさにボクはアイコを引き寄せて、\nトラックから守ったんだ。"},
{"id": 403, "speaker": 2, "form": "dlg", "jp": "でも、その時、\nアイコの犬はトラックにひかれて死んじゃったんだ。"},
{"id": 404, "speaker": 2, "form": "dlg", "jp": "で、アイコがあんまり泣き止まないから‥‥"},
{"id": 405, "speaker": 2, "form": "dlg", "jp": "『オレが助けてやったのが気に入らないのか！』"},
{"id": 406, "speaker": 2, "form": "dlg", "jp": "『なら、もう助けてやらない！』って\n怒鳴っちゃったんだ‥‥"},
{"id": 407, "speaker": 2, "form": "dlg", "jp": "そしたら、『アイコ』のヤツ‥‥"},
{"id": 408, "speaker": 2, "form": "dlg", "jp": "『ゴメンなさい！\n　アイコのこと見捨てないで‥‥』"},
{"id": 409, "speaker": 2, "form": "dlg", "jp": "で、ボクもいいかっこして、"},
{"id": 410, "speaker": 2, "form": "dlg", "jp": "『見捨てないよ、\n　いつでもアイコのこと守ってやるから！』"},
{"id": 411, "speaker": 2, "form": "dlg", "jp": "『約束するよ！』って言ったんだ‥‥"},
{"id": 412, "speaker": 15, "form": "dlg", "jp": "「思い出した？」"},
{"id": 413, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 414, "speaker": 15, "form": "dlg", "jp": "「でも忘れちゃっていいよ‥‥」"},
{"id": 415, "speaker": 15, "form": "dlg", "jp": "「今のナゴムちゃんは\n　守るためにムチャしちゃいそうだから‥‥」"},
{"id": 416, "speaker": 15, "form": "dlg", "jp": "「私、ナゴムちゃんに死んでほしくないから‥‥」"},
{"id": 417, "speaker": 2, "form": "dlg", "jp": "「大丈夫だよ‥‥」"},
{"id": 418, "speaker": 2, "form": "dlg", "jp": "「今の状況じゃあ、ムチャのしようもないし‥‥」"},
{"id": 419, "speaker": 15, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 420, "speaker": 2, "form": "dlg", "jp": "「まあ、いろいろ心配してくれてありがとう‥‥」"},
{"id": 421, "speaker": 2, "form": "dlg", "jp": "「アイコ、コッチに来てから\n　あんまり眠れてないんじゃないか？」"},
{"id": 422, "speaker": 2, "form": "dlg", "jp": "「少し顔色わるいぞ‥‥」"},
{"id": 423, "speaker": 15, "form": "dlg", "jp": "「眠れるわけないじゃない！」"},
{"id": 424, "speaker": 2, "form": "dlg", "jp": "「少し休んだ方がいいよ‥‥」"},
{"id": 425, "speaker": 2, "form": "dlg", "jp": "「さあ、戻ろう‥‥」"},
{"id": 426, "speaker": 2, "form": "dlg", "jp": "ボクはアイコと別れ本部に戻った。"},
{"id": 427, "speaker": 2, "form": "dlg", "jp": "さてと‥‥"},
{"id": 428, "speaker": 2, "form": "choice", "jp": "【ケネスのところでも行ってみるか‥‥】"},
{"id": 429, "speaker": 2, "form": "choice", "jp": "【ジーンのところでも行ってみるか‥‥】"},
{"id": 430, "speaker": 2, "form": "dlg", "jp": "ウロウロしていても仕方ないな‥‥"},
{"id": 431, "speaker": 2, "form": "dlg", "jp": "ボクは父さんたちの様子を見に行くことにした。"},
{"id": 432, "speaker": 2, "form": "dlg", "jp": "【長尾のところでも行ってみるか‥‥】"},
{"id": 433, "speaker": 2, "form": "dlg", "jp": "ボクは長尾の部屋に行くことにした。"},
{"id": 434, "speaker": 2, "form": "dlg", "jp": "「長尾、入るよ‥‥」"},
{"id": 435, "speaker": 16, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 436, "speaker": 2, "form": "dlg", "jp": "「いや、別に用はないけど‥‥」"},
{"id": 437, "speaker": 16, "form": "dlg", "jp": "「ジーンなら出て行っちゃったわよ‥‥」"},
{"id": 438, "speaker": 2, "form": "dlg", "jp": "「なあ、長尾‥‥」"},
{"id": 439, "speaker": 16, "form": "dlg", "jp": "「何？」"},
{"id": 440, "speaker": 2, "form": "dlg", "jp": "「本当に最近『夢』を見ていないのか？」"},
{"id": 441, "speaker": 16, "form": "dlg", "jp": "「み、見てないわよ！」"},
{"id": 442, "speaker": 2, "form": "dlg", "jp": "「そうか‥‥」"},
{"id": 443, "speaker": 16, "form": "dlg", "jp": "「それより良かったわね、\n　オジさんが生きてて‥‥」"},
{"id": 444, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 445, "speaker": 2, "form": "dlg", "jp": "「生きてるんだったら生きているで\n　連絡ぐらいくれたら良かったのに‥‥」"},
{"id": 446, "speaker": 16, "form": "dlg", "jp": "「もう少しほとぼりが冷めるのを待ってたんじゃないの？」"},
{"id": 447, "speaker": 2, "form": "dlg", "jp": "「なあ‥‥」"},
{"id": 448, "speaker": 2, "form": "dlg", "jp": "「ボクたちこのままヤラれちゃうのかなぁ‥‥？」"},
{"id": 449, "speaker": 16, "form": "dlg", "jp": "「さあ、わからないわね‥‥」"},
{"id": 450, "speaker": 16, "form": "dlg", "jp": "「でも、『ゲーマー』は人間を全滅はさせないんでしょう？」"},
{"id": 451, "speaker": 16, "form": "dlg", "jp": "「なら、アキラたちは助かるかもしれないわね！」"},
{"id": 452, "speaker": 16, "form": "dlg", "jp": "「ここには『アカシックレコード』があるから\n　大きな攻撃はしてこないでしょうし‥‥」"},
{"id": 453, "speaker": 2, "form": "dlg", "jp": "「それはどうだろう？」"},
{"id": 454, "speaker": 2, "form": "dlg", "jp": "「『アカシックレコード』はどっちにしても\n　壊れないんだからここも攻撃して来るんじゃない？」"},
{"id": 455, "speaker": 2, "form": "dlg", "jp": "「それにボクたちだけ生き残ればいいって考えも\n　あんまり賛同できないな‥‥」"},
{"id": 456, "speaker": 16, "form": "dlg", "jp": "「じゃあ、常光寺くんは死ぬのは恐くないの？」"},
{"id": 457, "speaker": 2, "form": "dlg", "jp": "「そりゃあコワイよ‥‥」"},
{"id": 458, "speaker": 2, "form": "dlg", "jp": "「でも、自分たち以外にみんなが死んじゃうっていうのも\n　自分が死ぬのと同じくらいコワイよ！」"},
{"id": 459, "speaker": 2, "form": "dlg", "jp": "「コワイから戦ってきたんじゃないか！」"},
{"id": 460, "speaker": 16, "form": "dlg", "jp": "「そうよね‥‥」"},
{"id": 461, "speaker": 16, "form": "dlg", "jp": "「ゴメンなさい‥‥」"},
{"id": 462, "speaker": 16, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 463, "speaker": 16, "form": "dlg", "jp": "「ねえ、常光寺くん‥‥」"},
{"id": 464, "speaker": 16, "form": "dlg", "jp": "「もう、部屋に戻った方がいいんじゃない？」"},
{"id": 465, "speaker": 2, "form": "dlg", "jp": "「どうして？」"},
{"id": 466, "speaker": 16, "form": "dlg", "jp": "「２人っきりでいるところをジーンに見つかったら\n　叱られちゃうわよ！」"},
{"id": 467, "speaker": 2, "form": "dlg", "jp": "「なんで、そんなことで叱られるんだよ！」"},
{"id": 468, "speaker": 16, "form": "dlg", "jp": "「常光寺くんは相変わらずニブイのね」"},
{"id": 469, "speaker": 2, "form": "dlg", "jp": "「はあ？」"},
{"id": 470, "speaker": 16, "form": "dlg", "jp": "「とにかく、アキラは少し眠るから\n　常光寺くんも部屋に戻りなさい！」"},
{"id": 471, "speaker": 16, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 472, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 473, "speaker": 2, "form": "dlg", "jp": "ボクは長尾の部屋を出た。"},
{"id": 474, "speaker": 16, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 475, "speaker": 2, "form": "dlg", "jp": "「いや、別に用はないけど‥‥」"},
{"id": 476, "speaker": 16, "form": "dlg", "jp": "「ジーンなら出て行っちゃったわよ‥‥」"},
{"id": 477, "speaker": 2, "form": "dlg", "jp": "「なあ、長尾ぉ‥‥」"},
{"id": 478, "speaker": 16, "form": "dlg", "jp": "「何？」"},
{"id": 479, "speaker": 2, "form": "dlg", "jp": "「本当に最近『夢』を見ていないのか？」"},
{"id": 480, "speaker": 16, "form": "dlg", "jp": "「えっ、ええ‥‥」"},
{"id": 481, "speaker": 2, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 482, "speaker": 16, "form": "dlg", "jp": "「ねえ、常光寺くん‥‥」"},
{"id": 483, "speaker": 16, "form": "dlg", "jp": "「上の遺跡に行ってみない？」"},
{"id": 484, "speaker": 2, "form": "dlg", "jp": "「えっ？」"},
{"id": 485, "speaker": 2, "form": "dlg", "jp": "「別にいいけど‥‥」"},
{"id": 486, "speaker": 16, "form": "dlg", "jp": "「じゃあ、行こう！」"},
{"id": 487, "speaker": 16, "form": "dlg", "jp": "ボクたちは上の遺跡に行ってみることにした。"},
{"id": 488, "speaker": 2, "form": "dlg", "jp": "「いいながめだね‥‥」"},
{"id": 489, "speaker": 16, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 490, "speaker": 2, "form": "dlg", "jp": "「ほとんど本部の中ばっかりだったから\n　あんまり実感なかったけど」"},
{"id": 491, "speaker": 2, "form": "dlg", "jp": "「今、『外国』にいるんだよなぁ」"},
{"id": 492, "speaker": 16, "form": "dlg", "jp": "「常光寺くんは前にも『ペルー』には来たんでしょう？」"},
{"id": 493, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 494, "speaker": 2, "form": "dlg", "jp": "「でもあの時は『牢』に閉じ込められていただけだから‥‥」"},
{"id": 495, "speaker": 16, "form": "dlg", "jp": "「本当にいろんな目にあってるんだね？」"},
{"id": 496, "speaker": 2, "form": "dlg", "jp": "「いやになるよ‥」"},
{"id": 497, "speaker": 16, "form": "dlg", "jp": "「そうそう、オジさんが生きていたんだね！」"},
{"id": 498, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 499, "speaker": 2, "form": "dlg", "jp": "「生きてるんだったら生きているで\n　連絡ぐらいくれたら良かったのに‥‥」"},
{"id": 500, "speaker": 16, "form": "dlg", "jp": "「もう少しほとぼりが冷めるのを待ってたんじゃない？」"},
{"id": 501, "speaker": 2, "form": "dlg", "jp": "「そうなんだろうけど‥‥」"},
{"id": 502, "speaker": 2, "form": "dlg", "jp": "「せっかく家族３人そろったのに\n　世界の終わりが近付いているなんて‥‥」"},
{"id": 503, "speaker": 2, "form": "dlg", "jp": "「ボクたちこのままヤラれちゃうのかなぁ‥‥？」"},
{"id": 504, "speaker": 16, "form": "dlg", "jp": "「さあ、わからない‥‥」"},
{"id": 505, "speaker": 16, "form": "dlg", "jp": "「でも、『ゲーマー』は人間を全滅はさせないんでしょう？」"},
{"id": 506, "speaker": 16, "form": "dlg", "jp": "「なら、アキラたちは助かるかもしれないわね！」"},
{"id": 507, "speaker": 16, "form": "dlg", "jp": "「ここには『アカシックレコード』があるから\n　大きな攻撃はしてこないでしょうし‥‥」"},
{"id": 508, "speaker": 2, "form": "dlg", "jp": "「それはどうだろう？」"},
{"id": 509, "speaker": 2, "form": "dlg", "jp": "「『アカシックレコード』はどっちにしても\n　壊れないんだからここも攻撃して来るんじゃない？」"},
{"id": 510, "speaker": 2, "form": "dlg", "jp": "「それにボクたちだけ生き残ればいいって考えも\n　あんまり賛同できないな‥‥」"},
{"id": 511, "speaker": 2, "form": "dlg", "jp": "「たしかに、\n　ウチの家族はここに集まっちゃっているけど‥‥」"},
{"id": 512, "speaker": 2, "form": "dlg", "jp": "「長尾の家族はそうじゃないんだし‥‥」"},
{"id": 513, "speaker": 16, "form": "dlg", "jp": "「ジョウダンよ！」"},
{"id": 514, "speaker": 16, "form": "dlg", "jp": "「なんか‥‥」"},
{"id": 515, "speaker": 16, "form": "dlg", "jp": "「あと数時間で世界が滅んじゃうって言われても\n　全然実感がわかないの‥‥」"},
{"id": 516, "speaker": 16, "form": "dlg", "jp": "「まあ、私の場合はただ『夢』を報告するだけで\n　戦ってきたわけじゃないけど」"},
{"id": 517, "speaker": 16, "form": "dlg", "jp": "「常光寺くんは今まで命がけで戦ってきたけど\n　恐くなかったの？」"},
{"id": 518, "speaker": 2, "form": "dlg", "jp": "「そりゃあコワイよ‥‥」"},
{"id": 519, "speaker": 2, "form": "dlg", "jp": "「でも、自分たち以外にみんなが死んじゃうっていうのも\n　自分が死ぬのと同じくらいコワイよ！」"},
{"id": 520, "speaker": 2, "form": "dlg", "jp": "「コワイから戦ってきたのかもしれないな‥‥」"},
{"id": 521, "speaker": 16, "form": "dlg", "jp": "「ねぇ‥‥」"},
{"id": 522, "speaker": 2, "form": "dlg", "jp": "「うん？」"},
{"id": 523, "speaker": 16, "form": "dlg", "jp": "「常光寺くん‥‥」"},
{"id": 524, "speaker": 16, "form": "dlg", "jp": "「アキラが死んだら悲しい？」"},
{"id": 525, "speaker": 2, "form": "dlg", "jp": "「当たり前じゃないか！」"},
{"id": 526, "speaker": 16, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 527, "speaker": 16, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 528, "speaker": 2, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 529, "speaker": 16, "form": "dlg", "jp": "「アキラも常光寺くんが死んだらイヤだと思って‥‥」"},
{"id": 530, "speaker": 2, "form": "dlg", "jp": "「なるべく死なないようにするよ‥‥」"},
{"id": 531, "speaker": 16, "form": "dlg", "jp": "「そうしてね！」"},
{"id": 532, "speaker": 16, "form": "dlg", "jp": "「常光寺くんはムチャしちゃうところがあるから‥‥」"},
{"id": 533, "speaker": 2, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 534, "speaker": 16, "form": "dlg", "jp": "「ねえ、松尾さんは今何してるの？」"},
{"id": 535, "speaker": 2, "form": "dlg", "jp": "「多分寝ていると‥‥」"},
{"id": 536, "speaker": 16, "form": "dlg", "jp": "「そうなんだ‥‥」"},
{"id": 537, "speaker": 2, "form": "dlg", "jp": "「松尾さんになんか用？」"},
{"id": 538, "speaker": 16, "form": "dlg", "jp": "「せっかく『ペルー』に来てるんだから\n　いろいろと観光に連れていってもらおうかと‥‥」"},
{"id": 539, "speaker": 2, "form": "dlg", "jp": "「ダメだよ、そんなことに能力使わせたら！！」"},
{"id": 540, "speaker": 2, "form": "dlg", "jp": "「松尾さん可哀相だよ‥‥」"},
{"id": 541, "speaker": 16, "form": "dlg", "jp": "「やっぱり常光寺くんはやさしいんだね‥‥」"},
{"id": 542, "speaker": 16, "form": "dlg", "jp": "「なんでアキラにはつまらない能力しか\n　さずからなかったんだろう？」"},
{"id": 543, "speaker": 16, "form": "dlg", "jp": "「アキラに常光寺くんと同じ能力があったら‥‥」"},
{"id": 544, "speaker": 2, "form": "dlg", "jp": "「ボクと同じ能力じゃ意味ないよ‥‥」"},
{"id": 545, "speaker": 2, "form": "dlg", "jp": "「結局なんにもできないんだから‥‥」"},
{"id": 546, "speaker": 16, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 547, "speaker": 16, "form": "dlg", "jp": "「やっぱり常光寺くん、たくましくなったわね」"},
{"id": 548, "speaker": 2, "form": "dlg", "jp": "「そういう長尾だって\n　ずいぶん大人しくなったように思うけど‥‥」"},
{"id": 549, "speaker": 16, "form": "dlg", "jp": "「大人しくなったんじゃなくて\n　寝不足なだけかも‥‥」"},
{"id": 550, "speaker": 16, "form": "dlg", "jp": "「コッチに来てからあんまり寝ていないから‥‥」"},
{"id": 551, "speaker": 2, "form": "dlg", "jp": "「少し休んだ方がいいよ‥‥」"},
{"id": 552, "speaker": 2, "form": "dlg", "jp": "「さあ、部屋に戻ろう‥‥」"},
{"id": 553, "speaker": 2, "form": "dlg", "jp": "ボクは長尾と別れ本部に戻った。"},
{"id": 554, "speaker": 2, "form": "dlg", "jp": "【堤さんのところでも行ってみるか‥‥】"},
{"id": 555, "speaker": 2, "form": "dlg", "jp": "ボクは堤さんの部屋に行くことにした。"},
{"id": 556, "speaker": 2, "form": "dlg", "jp": "「堤さん、入るよ‥‥」"},
{"id": 557, "speaker": 18, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 558, "speaker": 2, "form": "dlg", "jp": "「いや、別に用はないけど‥‥」"},
{"id": 559, "speaker": 18, "form": "dlg", "jp": "「ジーンさんなら出て行っちゃったわよ‥‥」"},
{"id": 560, "speaker": 2, "form": "dlg", "jp": "「堤さん‥‥」"},
{"id": 561, "speaker": 18, "form": "dlg", "jp": "「何？」"},
{"id": 562, "speaker": 2, "form": "dlg", "jp": "「本当に最近『夢』を見ていないのか？」"},
{"id": 563, "speaker": 18, "form": "dlg", "jp": "「え、ええ‥‥」"},
{"id": 564, "speaker": 2, "form": "dlg", "jp": "「そうなの‥‥」"},
{"id": 565, "speaker": 18, "form": "dlg", "jp": "「それより、お父さんが生きてて良かったわね‥‥」"},
{"id": 566, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 567, "speaker": 2, "form": "dlg", "jp": "「生きてるんだったら生きているで\n　連絡ぐらいくれたら良かったのに‥‥」"},
{"id": 568, "speaker": 18, "form": "dlg", "jp": "「もう少しほとぼりが冷めるのを待ってたとか？」"},
{"id": 569, "speaker": 2, "form": "dlg", "jp": "「そうなんだろうけど‥‥」"},
{"id": 570, "speaker": 18, "form": "dlg", "jp": "「ねえ、私たちどうなっちゃうんだろう？」"},
{"id": 571, "speaker": 2, "form": "dlg", "jp": "「ボクには予知能力はないからなんとも‥‥」"},
{"id": 572, "speaker": 18, "form": "dlg", "jp": "「それってイヤミ？」"},
{"id": 573, "speaker": 2, "form": "dlg", "jp": "「違うよ！」"},
{"id": 574, "speaker": 2, "form": "dlg", "jp": "「気にさわったんならあやまるよ‥‥」"},
{"id": 575, "speaker": 18, "form": "dlg", "jp": "「ううん、私の方こそ‥‥」"},
{"id": 576, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 577, "speaker": 2, "form": "dlg", "jp": "「堤さん、コワイの？」"},
{"id": 578, "speaker": 18, "form": "dlg", "jp": "「コワイわ‥‥」"},
{"id": 579, "speaker": 18, "form": "dlg", "jp": "「自分が死んじゃうことより、\n　この世界がなくなっちゃうってことが‥‥」"},
{"id": 580, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 581, "speaker": 2, "form": "dlg", "jp": "「きっと何か方法があると思うんだ！」"},
{"id": 582, "speaker": 2, "form": "dlg", "jp": "「まだ父さんたちがいろいろ調べてるみたいだし‥‥」"},
{"id": 583, "speaker": 2, "form": "dlg", "jp": "「あと少ししか時間はないけど\n　最後の１秒まであきらめちゃだめだよ！」"},
{"id": 584, "speaker": 18, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 585, "speaker": 2, "form": "dlg", "jp": "「うん！」"},
{"id": 586, "speaker": 18, "form": "dlg", "jp": "「ねえ、常光寺くん‥‥」"},
{"id": 587, "speaker": 18, "form": "dlg", "jp": "「もう、部屋に戻った方がいいと思うの‥‥」"},
{"id": 588, "speaker": 2, "form": "dlg", "jp": "「どうして？」"},
{"id": 589, "speaker": 18, "form": "dlg", "jp": "「２人っきりでいるところをジーンさんに見つかったら\n　叱られちゃうわよ！」"},
{"id": 590, "speaker": 2, "form": "dlg", "jp": "「なんで、そんなことで叱られるんだよ！」"},
{"id": 591, "speaker": 18, "form": "dlg", "jp": "「常光寺くんは気付いてないのね？」"},
{"id": 592, "speaker": 18, "form": "dlg", "jp": "「ジーンさんかわいそう‥‥」"},
{"id": 593, "speaker": 2, "form": "dlg", "jp": "「はあ？」"},
{"id": 594, "speaker": 18, "form": "dlg", "jp": "「とにかく、部屋に戻りなさい！」"},
{"id": 595, "speaker": 18, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 596, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 597, "speaker": 2, "form": "dlg", "jp": "ボクは堤さんの部屋を出た。"},
{"id": 598, "speaker": 18, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 599, "speaker": 2, "form": "dlg", "jp": "「いや、別に用はないけど‥‥」"},
{"id": 600, "speaker": 18, "form": "dlg", "jp": "「ジーンさんなら出て行っちゃったわよ‥‥」"},
{"id": 601, "speaker": 2, "form": "dlg", "jp": "「堤さん‥‥」"},
{"id": 602, "speaker": 18, "form": "dlg", "jp": "「何？」"},
{"id": 603, "speaker": 2, "form": "dlg", "jp": "「本当に最近『夢』を見ていないのか？」"},
{"id": 604, "speaker": 18, "form": "dlg", "jp": "「えっ、ええ‥‥」"},
{"id": 605, "speaker": 2, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 606, "speaker": 18, "form": "dlg", "jp": "「ねえ、常光寺くん‥‥」"},
{"id": 607, "speaker": 18, "form": "dlg", "jp": "「上の遺跡に行ってみない？」"},
{"id": 608, "speaker": 2, "form": "dlg", "jp": "「えっ？」"},
{"id": 609, "speaker": 2, "form": "dlg", "jp": "「別にいいけど‥‥」"},
{"id": 610, "speaker": 18, "form": "dlg", "jp": "「じゃあ、行きましょう！」"},
{"id": 611, "speaker": 18, "form": "dlg", "jp": "ボクたちは上の遺跡に行ってみることにした。"},
{"id": 612, "speaker": 2, "form": "dlg", "jp": "「いいながめだね‥‥」"},
{"id": 613, "speaker": 18, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 614, "speaker": 2, "form": "dlg", "jp": "「ほとんど本部の中ばっかりだったから\n　あんまり実感なかったけど」"},
{"id": 615, "speaker": 2, "form": "dlg", "jp": "「今、『外国』にいるんだよなぁ」"},
{"id": 616, "speaker": 18, "form": "dlg", "jp": "「常光寺くんは前にも『ペルー』には来たんでしょう？」"},
{"id": 617, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 618, "speaker": 2, "form": "dlg", "jp": "「でもあの時は『牢』に閉じ込められていただけだから‥‥」"},
{"id": 619, "speaker": 18, "form": "dlg", "jp": "「本当にいろんな目にあってるのね？」"},
{"id": 620, "speaker": 2, "form": "dlg", "jp": "「いやになるよ‥」"},
{"id": 621, "speaker": 18, "form": "dlg", "jp": "「そうそう、お父さん生きてたのね‥‥」"},
{"id": 622, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 623, "speaker": 2, "form": "dlg", "jp": "「生きてるんだったら生きているで\n　連絡ぐらいくれたら良かったのに‥‥」"},
{"id": 624, "speaker": 18, "form": "dlg", "jp": "「もう少しほとぼりが冷めるのを待ってたんでしょう？」"},
{"id": 625, "speaker": 2, "form": "dlg", "jp": "「そうなんだろうけど‥‥」"},
{"id": 626, "speaker": 2, "form": "dlg", "jp": "「せっかく家族３人そろったのに\n　世界の終わりが近付いているなんて‥‥」"},
{"id": 627, "speaker": 2, "form": "dlg", "jp": "「ボクたちこのままヤラれちゃうのかなぁ‥‥？」"},
{"id": 628, "speaker": 18, "form": "dlg", "jp": "「さあ、わからないわ‥‥」"},
{"id": 629, "speaker": 18, "form": "dlg", "jp": "「一応、それを防ぐために私たちが呼ばれたんだし」"},
{"id": 630, "speaker": 18, "form": "dlg", "jp": "「常光寺くんのお父さんたちもがんばってるんでしょうし」"},
{"id": 631, "speaker": 2, "form": "dlg", "jp": "「そうだね、まだ数時間だけど猶予はあるんだもんね‥‥」"},
{"id": 632, "speaker": 2, "form": "dlg", "jp": "「あきらめちゃダメだよね‥‥」"},
{"id": 633, "speaker": 18, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 634, "speaker": 18, "form": "dlg", "jp": "「まあ、私たちは\n　オジサンたちの結果を待つしかできないんだけど‥‥」"},
{"id": 635, "speaker": 2, "form": "dlg", "jp": "「なんか変だよね？」"},
{"id": 636, "speaker": 2, "form": "dlg", "jp": "「普通の人を助けるために\n　『超能力者』が集められたハズなのに‥‥」"},
{"id": 637, "speaker": 2, "form": "dlg", "jp": "「『超能力者』が\n　そうじゃない人にたよってるなんて‥‥」"},
{"id": 638, "speaker": 18, "form": "dlg", "jp": "「もちつもたれつってことでいいんじゃないの？」"},
{"id": 639, "speaker": 2, "form": "dlg", "jp": "「そうなのかな？」"},
{"id": 640, "speaker": 18, "form": "dlg", "jp": "「でも、本当にあと数時間しか人類に猶予がないんだったら\n　みんなに教えてあげたいわね‥‥」"},
{"id": 641, "speaker": 18, "form": "dlg", "jp": "「そしたら、みんな最後の数時間を好きな人とか\n　家族とかといっしょに過ごせるんだろうに‥‥」"},
{"id": 642, "speaker": 2, "form": "dlg", "jp": "「どうなんだろう？」"},
{"id": 643, "speaker": 2, "form": "dlg", "jp": "「パニックになったりするんじゃないかな」"},
{"id": 644, "speaker": 18, "form": "dlg", "jp": "「そうかな、私は絶対教えてもらいたいけど‥‥」"},
{"id": 645, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 646, "speaker": 2, "form": "dlg", "jp": "「ゴメンね‥‥」"},
{"id": 647, "speaker": 18, "form": "dlg", "jp": "「何？」"},
{"id": 648, "speaker": 2, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』のメンバーになってなかったら\n　今頃家族といっしょに過ごせたのにね‥‥」"},
{"id": 649, "speaker": 18, "form": "dlg", "jp": "「それは気にしないで！」"},
{"id": 650, "speaker": 18, "form": "dlg", "jp": "「そのかわり‥‥」"},
{"id": 651, "speaker": 2, "form": "dlg", "jp": "「そのかわり？」"},
{"id": 652, "speaker": 18, "form": "dlg", "jp": "「ううん、なんでもない！」"},
{"id": 653, "speaker": 2, "form": "dlg", "jp": "「へんなの？」"},
{"id": 654, "speaker": 18, "form": "dlg", "jp": "「ねえ！」"},
{"id": 655, "speaker": 18, "form": "dlg", "jp": "「そろそろ戻りましょう」"},
{"id": 656, "speaker": 18, "form": "dlg", "jp": "「ジーンさんが心配するでしょうから‥‥」"},
{"id": 657, "speaker": 18, "form": "dlg", "jp": "ボクは堤さんと別れ本部に戻った。"}
]
