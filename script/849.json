{"id": 108, "speaker": 2, "form": "choice", "jp": "【堤さんのところでも行ってみるか‥‥】"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "【ケネスのところでも行ってみるか‥‥】"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "ボクは隣のケネスの部屋に行くことにした。"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「コン！コン！」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「ケネス、入るよ！」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 115, "speaker": 31, "form": "dlg", "jp": "「何か用か？」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「用はないんだけど‥‥」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「部屋にいてもすることないし‥‥」"},
{"id": 118, "speaker": 31, "form": "dlg", "jp": "「落ち着かないんだな？」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「当たり前だろう！」"},
{"id": 120, "speaker": 31, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「ケネスは恐くないのかい？」"},
{"id": 122, "speaker": 31, "form": "dlg", "jp": "「ウ～～ン‥‥」"},
{"id": 123, "speaker": 31, "form": "dlg", "jp": "「恐いっちゃあ恐いんだけど‥‥」"},
{"id": 124, "speaker": 31, "form": "dlg", "jp": "「それより『なさけない』っていうか‥‥」"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "「『なさけない』？」"},
{"id": 126, "speaker": 31, "form": "dlg", "jp": "「こんな大きな体と人にはない能力を持っていて\n　何もできないなんて‥‥」"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 128, "speaker": 31, "form": "dlg", "jp": "「オレは戦ったら負けないと思うんだよ！」"},
{"id": 129, "speaker": 31, "form": "dlg", "jp": "「でも戦わせてももらえないってのが‥‥」"},
{"id": 130, "speaker": 31, "form": "dlg", "jp": "「‥‥‥‥‥‥」"},
{"id": 131, "speaker": 31, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 132, "speaker": 31, "form": "dlg", "jp": "「‥‥」"},
{"id": 133, "speaker": 31, "form": "dlg", "jp": "「実はオレ、『バスケットの選手』だったんだ‥‥」"},
{"id": 134, "speaker": 31, "form": "dlg", "jp": "「でも、監督に嫌われてたから\n　試合に出してもらえなかったんだよ」"},
{"id": 135, "speaker": 31, "form": "dlg", "jp": "「試合にさえ出れれば活躍できる自信はあったんだ」"},
{"id": 136, "speaker": 31, "form": "dlg", "jp": "「もちろん、能力を使わずに‥‥」"},
{"id": 137, "speaker": 31, "form": "dlg", "jp": "「でも、監督はオレよりヘタな選手ばっかり使うんだよ」"},
{"id": 138, "speaker": 31, "form": "dlg", "jp": "「そいつらのゴマスリが可愛いから‥‥」"},
{"id": 139, "speaker": 31, "form": "dlg", "jp": "「どんなに試合に負けつづけても、\n　ぜったいゴマスリ選手しか使わないんだよ！」"},
{"id": 140, "speaker": 31, "form": "dlg", "jp": "「オレが出れば勝てるのに‥‥」"},
{"id": 141, "speaker": 31, "form": "dlg", "jp": "「だからオレは『バスケット』を止めたんだよ！」"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「ふ～ん‥‥」"},
{"id": 143, "speaker": 31, "form": "dlg", "jp": "「オレは戦って負けるのはガマンできるんだ‥‥」"},
{"id": 144, "speaker": 31, "form": "dlg", "jp": "「でも、戦わずに負けるのは‥‥」"},
{"id": 145, "speaker": 31, "form": "dlg", "jp": "「ガマンできないんだよ！」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 147, "speaker": 31, "form": "dlg", "jp": "「まあナゴムにはどうでもいい話だったな‥‥」"},
{"id": 148, "speaker": 31, "form": "dlg", "jp": "「なあ、ナゴム‥‥」"},
{"id": 149, "speaker": 31, "form": "dlg", "jp": "「ジーンのことどう思う？」"},
{"id": 150, "speaker": 31, "form": "dlg", "jp": "「アイツはさみしいヤツだから‥‥」"},
{"id": 151, "speaker": 31, "form": "dlg", "jp": "「やさしくしてやってくれな‥‥」"},
{"id": 152, "speaker": 31, "form": "dlg", "jp": "「まあ、こんなこと頼まなくても\n　ナゴムはやさしいんだろうけど‥‥」"},
{"id": 153, "speaker": 31, "form": "dlg", "jp": "「ラテンの女は情熱的だと思われているけど\n　アイツは自分の感情を出すのが下手だから‥‥」"},
{"id": 154, "speaker": 31, "form": "dlg", "jp": "「まあ、のんびりできるのは今のうちだ‥‥」"},
{"id": 155, "speaker": 31, "form": "dlg", "jp": "「少しは休んでおけ！」"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "「うん、ありがとう‥‥」"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「バタン！」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "ボクはケネスの部屋をあとにした。"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "さてと、これからどうしよう？"},
{"id": 162, "speaker": 2, "form": "choice", "jp": "【ジーンのところでも行ってみるか‥‥】"},
{"id": 163, "speaker": 2, "form": "choice", "jp": "【アイコのところでも行ってみるか‥‥】"},
{"id": 164, "speaker": 2, "form": "choice", "jp": "【ジーンのところでも行ってみるか‥‥】"},
{"id": 165, "speaker": 2, "form": "choice", "jp": "【長尾のところでも行ってみるか‥‥】"},
{"id": 166, "speaker": 2, "form": "choice", "jp": "【ジーンのところでも行ってみるか‥‥】"},
{"id": 167, "speaker": 2, "form": "choice", "jp": "【堤さんのところでも行ってみるか‥‥】"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "【ジーンのところでも行ってみるか‥‥】"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "ボクはジーンたちのいる部屋に行くことにした。"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "「アラ？」"},
{"id": 172, "speaker": 29, "form": "dlg", "jp": "「ナゴムどこへ行くの？」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「いや、ジーンに会いに行こうと思ってたとこ‥‥」"},
{"id": 174, "speaker": 29, "form": "dlg", "jp": "「ふーん‥‥」"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "「で、何か用？」"},
