[
{"id": 0, "speaker": 29, "form": "dlg", "jp": "「まあ、今回はナゴムはなにもしてないケド\n　『アスカ』は十分休んでおいてね」"},
{"id": 1, "speaker": 29, "form": "dlg", "jp": "「ナゴムは遺跡見学でもしてヒマつぶしでもしておきなさい」"},
{"id": 2, "speaker": 29, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 3, "speaker": 15, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 4, "speaker": 16, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 5, "speaker": 18, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 6, "speaker": 18, "form": "dlg", "jp": "「バタン！」"},
{"id": 7, "speaker": 35, "form": "dlg", "jp": "「ナゴムくん‥‥」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 9, "speaker": 35, "form": "dlg", "jp": "「ボクたち死んじゃうのかな？」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「う～ん‥‥」"},
{"id": 11, "speaker": 2, "form": "choice", "jp": "「松尾さんは死なないんじゃないかな？」"},
{"id": 12, "speaker": 2, "form": "choice", "jp": "「それはボクじゃわからないよ‥‥」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「松尾さんは死なないんじゃないかな？」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「もしなにかあっても松尾さんは『能力』で\n　逃げ回ればいいだけなんだから‥‥」"},
{"id": 15, "speaker": 35, "form": "dlg", "jp": "「やっぱり、『逃げる』しか仕方ないのかな？」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「それはボクじゃわからないよ‥‥」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「そのあたりのことは『アリス』が‥‥」"},
{"id": 18, "speaker": 35, "form": "dlg", "jp": "「もし、死んじゃうんなら、\n　『ゲーマー』ってヤツを１発殴ってやりたいよな‥‥」"},
{"id": 19, "speaker": 2, "form": "dlg", "jp": "「殴れるぐらいなら倒すことができるんだけどね‥‥」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「ねえ、松尾さんの能力で『アカシックレコード』の中に\n　テレポートするってのはできないのかな？」"},
{"id": 21, "speaker": 35, "form": "dlg", "jp": "「ムリだよ！」"},
{"id": 22, "speaker": 35, "form": "dlg", "jp": "「シローの話によると『アノ信号』って\n　『人間の思考』に似てるんだろう？」"},
{"id": 23, "speaker": 35, "form": "dlg", "jp": "「ってことは、\n　あの中って『人間の脳』に似てると思うんだよ」"},
{"id": 24, "speaker": 35, "form": "dlg", "jp": "「なら、オレの能力じゃムリだね‥‥」"},
{"id": 25, "speaker": 35, "form": "dlg", "jp": "「もしかしたら、\n　『清田』の能力ならできたのかもしれないけど‥‥」"},
{"id": 26, "speaker": 35, "form": "choice", "jp": "「やっぱり『清田さん』は倒さない方がよかったのかな？」"},
{"id": 27, "speaker": 35, "form": "choice", "jp": "「もう倒しちゃったしなぁ～」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「やっぱり『清田さん』は倒さない方がよかったのかな？」"},
{"id": 29, "speaker": 35, "form": "dlg", "jp": "「いや、彼は倒しておかないといけないヤツだと思うよ！」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "「もう倒しちゃったしなぁ～」"},
{"id": 31, "speaker": 35, "form": "dlg", "jp": "「彼は倒しちゃって正解だよ！」"},
{"id": 32, "speaker": 35, "form": "dlg", "jp": "「ある意味『ゲーマー』の何倍も邪悪なやつだから‥‥」"},
{"id": 33, "speaker": 35, "form": "dlg", "jp": "「まあ、終わったことをグズグズ言ってもしかたないな‥‥」"},
{"id": 34, "speaker": 35, "form": "dlg", "jp": "「わるいけど、ちょっと眠らせてもらえるかな‥‥」"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "「ゴメンなさい‥‥」"},
{"id": 36, "speaker": 35, "form": "dlg", "jp": "「じゃあ、オヤスミ‥‥」"},
{"id": 37, "speaker": 35, "form": "dlg", "jp": "松尾さんはさっきのミサイルの疲れからか、\nすぐに眠ってしまった。"},
{"id": 38, "speaker": 35, "form": "dlg", "jp": "さて、どうやって時間をつぶそうかな？"},
{"id": 39, "speaker": 35, "form": "choice", "jp": "【ちょっと考えてみるか‥‥】"},
{"id": 40, "speaker": 35, "form": "choice", "jp": "【少し仮眠をとろう】"},
{"id": 41, "speaker": 35, "form": "choice", "jp": "【松尾さんと話をしよう！】"},
