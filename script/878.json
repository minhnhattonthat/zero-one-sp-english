{"id": 22, "speaker": 31, "form": "dlg", "jp": "その時！！"},
{"id": 23, "speaker": 4, "form": "dlg", "jp": "「ぎゃあああああ！」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥！」"},
{"id": 25, "speaker": 29, "form": "dlg", "jp": "「『コンピュータールーム』の方からよ！」"},
{"id": 26, "speaker": 31, "form": "dlg", "jp": "「行って見よう！」"},
{"id": 27, "speaker": 31, "form": "dlg", "jp": "ボクたちは『コンピュータールーム』へと急いだ。"},
{"id": 28, "speaker": 31, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
