{"id": 40, "speaker": 13, "form": "dlg", "jp": "「『射殺』！？」"},
{"id": 41, "speaker": 31, "form": "dlg", "jp": "「エイジは右の目から、\n　『レーザー光線』を発射できるんだよ」"},
{"id": 42, "speaker": 31, "form": "choice", "jp": "「本当にもう大丈夫なの？」"},
{"id": 43, "speaker": 31, "form": "choice", "jp": "「なら、大丈夫だね‥‥」"},
{"id": 44, "speaker": 2, "form": "dlg", "jp": "「本当にもう大丈夫なの？」"},
{"id": 45, "speaker": 50, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「もしかしたら、\n　『スパイ』じゃないんじゃないかな？」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「もし『スパイ』なら‥‥」"},
{"id": 48, "speaker": 2, "form": "choice", "jp": "「ウイルスとか仕掛ける方が‥‥」"},
{"id": 49, "speaker": 2, "form": "choice", "jp": "「リーダーを狙うんじゃぁ？」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「なら大丈夫だね‥‥」"},
{"id": 51, "speaker": 29, "form": "dlg", "jp": "「スパイって、いったい何のための？」"},
{"id": 52, "speaker": 31, "form": "dlg", "jp": "「確かにそうだな‥‥」"},
{"id": 53, "speaker": 31, "form": "dlg", "jp": "「オレたちは全人類の敵と戦ってるんだから\n　敵対する人間はいないと思うがな‥‥」"},
{"id": 54, "speaker": 50, "form": "dlg", "jp": "「しかし、エンジニアの中に\n　『敵』がいたのは間違いないよ‥‥」"},
{"id": 55, "speaker": 45, "form": "dlg", "jp": "「そうです！」"},
{"id": 56, "speaker": 45, "form": "dlg", "jp": "「ワタシもそのエンジニアが\n　他のエンジニアに襲いかかるのを見ました‥‥」"},
{"id": 57, "speaker": 50, "form": "dlg", "jp": "「ボクも襲われかけたし‥‥」"},
{"id": 58, "speaker": 50, "form": "choice", "jp": "「もしかして、『クリエーター』が操った？」"},
{"id": 59, "speaker": 50, "form": "choice", "jp": "「『クリエーター』を信じていない連中の仕業じゃあ？」"},
{"id": 60, "speaker": 50, "form": "choice", "jp": "「『スパイ』じゃないんじゃないかな？」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "「『スパイ』じゃないんじゃないかな？」"},
{"id": 62, "speaker": 29, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「よくわからないんだけど、\n　そんな気がするんだ‥‥」"},
{"id": 64, "speaker": 13, "form": "dlg", "jp": "「いいかげんだなぁ～～」"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "「もし『スパイ』なら‥‥」"},
{"id": 66, "speaker": 2, "form": "choice", "jp": "「ウイルスとか仕掛ける方が‥‥」"},
