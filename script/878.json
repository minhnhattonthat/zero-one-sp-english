{"id": 143, "speaker": 46, "form": "dlg", "jp": "「スミマセン！」"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "「ツトム言いすぎだよ！」"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "「相手は子供なんだし‥‥」"},
{"id": 146, "speaker": 46, "form": "dlg", "jp": "「年齢は関係ありません」"},
{"id": 147, "speaker": 46, "form": "dlg", "jp": "「私がリーダーであるのは間違いありませんから‥‥」"},
{"id": 148, "speaker": 13, "form": "dlg", "jp": "「わかればいいんだ」"},
{"id": 149, "speaker": 13, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 150, "speaker": 49, "form": "dlg", "jp": "「大変ですっ！」"},
{"id": 151, "speaker": 46, "form": "dlg", "jp": "「どうかしたのですか？」"},
{"id": 152, "speaker": 49, "form": "dlg", "jp": "「インドのミサイルが暴走により\n　パキスタンに向けて発射準備に入りました！」"},
{"id": 153, "speaker": 49, "form": "dlg", "jp": "「３０分後に発射されるもようです！」"},
{"id": 154, "speaker": 29, "form": "dlg", "jp": "「ケネス、ナゴム、行くわよっ！」"},
{"id": 155, "speaker": 31, "form": "dlg", "jp": "「きりがないなぁ‥‥」"},
{"id": 156, "speaker": 29, "form": "dlg", "jp": "「アスカッ！」"},
{"id": 157, "speaker": 35, "form": "dlg", "jp": "「ホイきた！」"},
{"id": 158, "speaker": 29, "form": "dlg", "jp": "「じゃあ、行って来ます！」"},
{"id": 159, "speaker": 13, "form": "dlg", "jp": "「ちょっと待った！」"},
{"id": 160, "speaker": 13, "form": "choice", "jp": "「なんだよ！？」"},
{"id": 161, "speaker": 13, "form": "choice", "jp": "「時間が無いんだよ！」"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "「なんだよ！？」"},
{"id": 163, "speaker": 13, "form": "dlg", "jp": "「行ってどうするつもりだ？」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "「止めるんだよ！」"},
