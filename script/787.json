{"id": 132, "speaker": 2, "form": "dlg", "jp": "（それだっ！）"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "（ボクが聞いたウワサも！！）"},
{"id": 134, "speaker": 29, "form": "dlg", "jp": "（そのウワサが本当だとしたら‥‥）"},
{"id": 135, "speaker": 31, "form": "dlg", "jp": "（なんらかの『能力』を使っているって可能性も‥‥）"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "（『透明人間』の仕業だって‥‥）"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "（そんなウワサは知らないわ！）"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "（ねえ、どこで聞いたのそのウワサ？）"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "（イヤ、ボクの勘違いかも‥‥）"},
{"id": 140, "speaker": 29, "form": "dlg", "jp": "（私たちが聞いたウワサは被害者が突然消えるって‥‥）"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "（それだっ！）"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "（消えるっていうので、勘違いしてたよ！）"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "（もしそうなら、警察じゃぁどうすることも‥‥）"},
{"id": 144, "speaker": 29, "form": "dlg", "jp": "（当たり前じゃない！）"},
{"id": 145, "speaker": 31, "form": "dlg", "jp": "（それに『警察』に知られちゃまずいな‥‥）"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "（まずいって‥‥？）"},
{"id": 147, "speaker": 31, "form": "dlg", "jp": "（オレたちみたいな能力者がいることを\n　他の連中に知られるわけにはいかないからな‥‥）"},
{"id": 148, "speaker": 29, "form": "dlg", "jp": "（そうね‥‥）"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "（でも、本当に『通り魔』が『超能力者』かどうか？）"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "（たしかに、『ただの変質者』かもしれないわね‥‥）"},
{"id": 151, "speaker": 29, "form": "dlg", "jp": "（ねえ、『ただの変質者』と、『超能力者の変質者』‥‥）"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "（どっちが世の中に多いと思う？）"},
{"id": 153, "speaker": 29, "form": "choice", "jp": "（『ただの変質者』！！）"},
{"id": 154, "speaker": 29, "form": "choice", "jp": "（『超能力者の変質者』‥‥？）"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "（『ただの変質者』！！）"},
{"id": 156, "speaker": 29, "form": "dlg", "jp": "（その通りね‥‥）"},
{"id": 157, "speaker": 29, "form": "dlg", "jp": "（だいたい、『超能力者』自体圧倒的に\n　少ないんだから当然ね！）"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "（『超能力者の変質者』‥‥？）"},
{"id": 159, "speaker": 29, "form": "dlg", "jp": "（そんなわけないでしょう！！）"},
{"id": 160, "speaker": 29, "form": "dlg", "jp": "（だいたい、\n　『超能力者』自体圧倒的に少ないんだから‥‥）"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "（まあ、そうだけど‥‥）"},
{"id": 162, "speaker": 29, "form": "dlg", "jp": "（じゃあ、普通の人が『変質者』になる確率と）"},
{"id": 163, "speaker": 29, "form": "dlg", "jp": "（『超能力者』が『変質者』になる確率ではどっち？）"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "（はぁ？）"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "（そんなのわかんないよ！！）"},
{"id": 166, "speaker": 31, "form": "dlg", "jp": "（難しく考えるな！！）"},
{"id": 167, "speaker": 31, "form": "dlg", "jp": "（人より優れた能力があるとおかしくなるヤツが多いか？）"},
{"id": 168, "speaker": 31, "form": "dlg", "jp": "（それとも少ないか？　それだけのこと‥‥）"},
