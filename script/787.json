{"id": 190, "speaker": 31, "form": "dlg", "jp": "（優しかったら『格闘技』なんかできないよ！）"},
{"id": 191, "speaker": 31, "form": "dlg", "jp": "（ただ、『理性』があるだけだよ‥‥）"},
{"id": 192, "speaker": 31, "form": "dlg", "jp": "（理性があるから、\n　『暴力』を『スポーツ』にぶつけているだけで‥‥）"},
{"id": 193, "speaker": 31, "form": "dlg", "jp": "（決して、『乱暴』じゃないわけじゃないだろう？）"},
{"id": 194, "speaker": 2, "form": "dlg", "jp": "（うう～ん‥‥）"},
{"id": 195, "speaker": 31, "form": "dlg", "jp": "（こういう言い方をしたら、\n　『格闘技』を否定しているように聞こえるけど‥‥）"},
{"id": 196, "speaker": 31, "form": "dlg", "jp": "（その逆で、『腕力のある者』には『格闘技』が\n　一番理性を与えるのに有効なんだよ）"},
{"id": 197, "speaker": 31, "form": "dlg", "jp": "（もし、『格闘技』に目覚めなかったら、\n　ただの『チンピラ』になるしかないからな！）"},
{"id": 198, "speaker": 31, "form": "dlg", "jp": "（オレたちだって、『ゲーマー』と戦うって\n　目標がなかったら『力』を持て余してしまうだろ？）"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "（だからといって、\n　『通り魔』＝『超能力者』ってのも‥‥）"},
{"id": 200, "speaker": 29, "form": "dlg", "jp": "（あと、気になるのが、この町で事件の起きた日よ！）"},
{"id": 201, "speaker": 29, "form": "choice", "jp": "（３日前だろう？）"},
{"id": 202, "speaker": 29, "form": "choice", "jp": "（５日前だろう？）"},
{"id": 203, "speaker": 29, "form": "choice", "jp": "（１０日前だろう？）"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "（３日前だろう？）"},
{"id": 205, "speaker": 29, "form": "dlg", "jp": "（違うわ！）"},
{"id": 206, "speaker": 29, "form": "dlg", "jp": "（５日前よ！）"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "（そっか、２日前に『３日前』って聞いたんだった‥‥）"},
{"id": 208, "speaker": 2, "form": "dlg", "jp": "（５日前だろう？）"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "（１０日前だろう？）"},
{"id": 210, "speaker": 29, "form": "dlg", "jp": "（違うわ！）"},
{"id": 211, "speaker": 29, "form": "dlg", "jp": "（５日前よ！）"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "（それがどうかしたの？）"},
{"id": 213, "speaker": 29, "form": "dlg", "jp": "（それって、私たちがやって来た日なの‥‥）"},
{"id": 214, "speaker": 29, "form": "dlg", "jp": "（『超能力者同士はひかれあう』っていうし‥‥）"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "（じゃあ、やっぱり『超能力者』？）"},
{"id": 216, "speaker": 29, "form": "dlg", "jp": "（断言はできないけど‥‥）"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "（でも、調べてみてもいいんじゃない？）"},
{"id": 218, "speaker": 29, "form": "dlg", "jp": "（ナゴムも同じ町に『通り魔』が\n　ウロウロしているってイヤでしょうし‥‥）"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "（まあ、そうだけど‥‥）"},
{"id": 220, "speaker": 29, "form": "dlg", "jp": "（とりあえず、ナゴムは『情報』を集めてちょうだい！）"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "（『情報』って‥‥）"},
{"id": 222, "speaker": 29, "form": "dlg", "jp": "（この町の人間なんだから、\n　情報を集めやすいでしょう‥‥）"},
{"id": 223, "speaker": 29, "form": "dlg", "jp": "（それに警察に知り合いもいるでしょうし‥‥）"},
{"id": 224, "speaker": 29, "form": "choice", "jp": "（わかったよ）"},
{"id": 225, "speaker": 29, "form": "choice", "jp": "（イヤだよ‥‥）"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "（わかったよ）"},
{"id": 227, "speaker": 29, "form": "dlg", "jp": "（くれぐれも気を付けてね‥‥）"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "（イヤだよ‥‥）"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "（相手は『人殺し』をする『通り魔』だろう‥‥？）"},
{"id": 230, "speaker": 29, "form": "dlg", "jp": "（ナニ情けないこと言ってるの。　男のコでしょ！？）"},
{"id": 231, "speaker": 29, "form": "dlg", "jp": "（あ、そうそう！！）"},
{"id": 232, "speaker": 29, "form": "dlg", "jp": "（ダメよ。\n　むやみに『能力』をつかっちゃ！）"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "（ナゴムはまだ『能力』を確実に使いこなせないし‥‥）"},
{"id": 234, "speaker": 29, "form": "dlg", "jp": "（それに、誰かに見られたりしたら‥‥）"},
{"id": 235, "speaker": 31, "form": "dlg", "jp": "（まあ、そうだな）"},
{"id": 236, "speaker": 31, "form": "dlg", "jp": "（ナゴムの『能力』はオレたちのと違って\n　人に見られたらイイワケできないからな‥‥）"},
{"id": 237, "speaker": 29, "form": "dlg", "jp": "（とりあえず、絶対人に見られちゃダメよ！！）"},
{"id": 238, "speaker": 29, "form": "dlg", "jp": "（もし、他人に知られたら‥‥）"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "（わかったよ‥‥　気を付けるよ！）"},
{"id": 240, "speaker": 29, "form": "dlg", "jp": "（じゃぁ、頼んだわよ！）"},
{"id": 241, "speaker": 29, "form": "dlg", "jp": "（何かわかったら、ホテルの方に連絡ちょうだい‥‥）"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 243, "speaker": 31, "form": "dlg", "jp": "（じゃぁな‥‥）"},
{"id": 244, "speaker": 31, "form": "dlg", "jp": "「シュンッ！」"},
{"id": 245, "speaker": 31, "form": "dlg", "jp": "２人は窓から飛び去った‥‥"}
]
