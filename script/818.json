[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／０６／ＰＭ０１：００"},
{"id": 1, "speaker": 31, "form": "dlg", "jp": "（アイツに動きは？）"},
{"id": 2, "speaker": 29, "form": "dlg", "jp": "「まだ、ないわ！」"},
{"id": 3, "speaker": 29, "form": "dlg", "jp": "「それより、『テレパシー』は使わないで！」"},
{"id": 4, "speaker": 29, "form": "dlg", "jp": "「あのコにも聞こえるかも知れないから‥‥」"},
{"id": 5, "speaker": 31, "form": "dlg", "jp": "「そ、そうだな‥‥」"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "「ナゴム、がんばってよ！」"},
{"id": 7, "speaker": 29, "form": "dlg", "jp": "「ある意味、『最終決戦』よ！」"},
{"id": 8, "speaker": 31, "form": "dlg", "jp": "「間違いなく、\n　人類の運命はナゴムにかかっているな‥‥」"},
{"id": 9, "speaker": 2, "form": "dlg", "jp": "「プレッシャーだなぁ～」"},
{"id": 10, "speaker": 16, "form": "dlg", "jp": "「憧れるなぁ～～」"},
{"id": 11, "speaker": 16, "form": "dlg", "jp": "「世界の救世主でしょう？」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「かわれるもんなら、かわってもらいたいよ‥‥」"},
{"id": 13, "speaker": 51, "form": "dlg", "jp": "「かわれるものなら、かわってやりたいけど‥‥」"},
{"id": 14, "speaker": 51, "form": "dlg", "jp": "「結局ウチ、ぜんぜん活躍してへんし‥‥」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「ボクだって、活躍できるかどうか‥‥」"},
{"id": 16, "speaker": 29, "form": "dlg", "jp": "「ダメよ、弱気になっちゃ！」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「わかってるけど‥‥」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「キーッ！」"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "「なんでもいいから、\n　スキをみつけてあのコと『融合』するのよ！」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「チン！」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「どうする？」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「やっぱり、ノックした方がいい？」"},
{"id": 24, "speaker": 16, "form": "dlg", "jp": "「映画とかだったら、蹴やぶるんだろうけど‥‥」"},
{"id": 25, "speaker": 51, "form": "dlg", "jp": "「映画とかだったら、蹴やぶるんやろうけど‥‥」"},
{"id": 26, "speaker": 51, "form": "dlg", "jp": "その時！"},
{"id": 27, "speaker": 51, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 28, "speaker": 50, "form": "dlg", "jp": "「丸聞こえだよ！」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「じゃあ入るよ！」"},
{"id": 30, "speaker": 50, "form": "dlg", "jp": "「見たかい、テレビ‥‥」"},
{"id": 31, "speaker": 29, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 32, "speaker": 50, "form": "dlg", "jp": "「ニューヨークと上海が壊滅だって‥‥」"},
{"id": 33, "speaker": 50, "form": "dlg", "jp": "「ハハハハハハハ‥‥」"},
{"id": 34, "speaker": 50, "form": "dlg", "jp": "「爆笑だね？」"},
{"id": 35, "speaker": 31, "form": "dlg", "jp": "「笑えないよ！」"},
{"id": 36, "speaker": 50, "form": "dlg", "jp": "「で、また来たってことは、\n　なんかくだらない作戦でも思い付いたのかい？」"},
{"id": 37, "speaker": 29, "form": "dlg", "jp": "「まあね‥‥」"},
{"id": 38, "speaker": 50, "form": "dlg", "jp": "「こりない連中だね？」"},
{"id": 39, "speaker": 31, "form": "dlg", "jp": "「オマエを相手にするのはコリゴリなんだがな‥‥」"},
{"id": 40, "speaker": 29, "form": "dlg", "jp": "「もう時間がないの、\n　戦闘を始めさせてもらっていいかしら？」"},
{"id": 41, "speaker": 50, "form": "dlg", "jp": "「勝手にやってくれよ！」"},
{"id": 42, "speaker": 50, "form": "dlg", "jp": "「まあ、何をやっても同じなんだから‥‥」"},
{"id": 43, "speaker": 29, "form": "dlg", "jp": "「じゃあ、始めさせてもらうわよ！」"},
{"id": 44, "speaker": 29, "form": "dlg", "jp": "「ナゴム、やりなさい！」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「えっ！？」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "ボクはあわてて出口に飛びかかった。"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "しかし‥‥"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「シュン！」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "出口は当然のように姿をくらました。"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「ジーン！」"},
{"id": 51, "speaker": 29, "form": "dlg", "jp": "「今、奥へ下がったわ‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「奥だね？」"},
{"id": 53, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って、少し右‥‥」"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "「違う、左‥‥」"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「で、どこなんだよ！」"},
{"id": 56, "speaker": 50, "form": "dlg", "jp": "「どうして常光寺くんに指示をだしてるんだい？」"},
{"id": 57, "speaker": 50, "form": "dlg", "jp": "「昨日みたいに直接『銃』をうたないのかい？」"},
{"id": 58, "speaker": 29, "form": "dlg", "jp": "「どうせ、きかないんでしょう？」"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "「そんなことより、どこにいるんだよ！」"},
{"id": 60, "speaker": 29, "form": "dlg", "jp": "「ゴメン、窓の側‥‥そこじゃない‥‥\n　もっと右‥‥」"},
{"id": 61, "speaker": 16, "form": "dlg", "jp": "「アキラにまかせてよ！」"},
{"id": 62, "speaker": 16, "form": "dlg", "jp": "長尾はそう言うと、ポケットから\n小麦粉の袋を取り出した。"},
{"id": 63, "speaker": 16, "form": "dlg", "jp": "「くらえっ！」"},
{"id": 64, "speaker": 16, "form": "dlg", "jp": "そう言って長尾は小麦粉を空中にバラまいた。"},
{"id": 65, "speaker": 31, "form": "dlg", "jp": "「何してんだ、\n　余計に視界が悪くなったじゃないか！」"},
{"id": 66, "speaker": 16, "form": "dlg", "jp": "「視界なんてどうでもいいじゃん\n　アイツさえ見えれば！」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥！？」"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "小麦粉が空中にまったおかげで\n出口の動きが見えるようになっていた。"},
{"id": 69, "speaker": 31, "form": "dlg", "jp": "「これも『夢』でみたのか？」"},
{"id": 70, "speaker": 16, "form": "dlg", "jp": "「違うわ！」"},
{"id": 71, "speaker": 16, "form": "dlg", "jp": "「アキラの能力は頼りにならないから、\n　『知恵』に頼ったのよ！」"},
{"id": 72, "speaker": 31, "form": "dlg", "jp": "「スゴイぞアキラ！！」"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「とにかくチャンスよ！」"},
{"id": 74, "speaker": 51, "form": "dlg", "jp": "「ええい、イライラするなぁ！」"},
{"id": 75, "speaker": 51, "form": "dlg", "jp": "「これでどうや！」"},
{"id": 76, "speaker": 51, "form": "dlg", "jp": "小田は洗面所の壁を強くたたいた！"},
{"id": 77, "speaker": 51, "form": "dlg", "jp": "「ドカン！」"},
{"id": 78, "speaker": 51, "form": "dlg", "jp": "小田の能力によって壁は粉々にくだかれ、\n目の前はほこりだらけになった。"},
{"id": 79, "speaker": 31, "form": "dlg", "jp": "「何してんだ、\n　余計に視界が悪くなったじゃないか！」"},
{"id": 80, "speaker": 51, "form": "dlg", "jp": "「視界なんてどうでもええやろ、\n　アイツさえ見えれば！」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥！？」"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "小さなホコリが空中にまったおかげで\n出口の動きが見えるようになっていた。"},
{"id": 83, "speaker": 29, "form": "dlg", "jp": "「チャンスよ！」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "ボクはホコリの中に見える\n出口のカゲをキャッチした。"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「つ、つかまえたぞ！」"},
{"id": 87, "speaker": 50, "form": "dlg", "jp": "「フフフフフフ‥‥」"},
{"id": 88, "speaker": 50, "form": "dlg", "jp": "「捕まったよ！」"},
{"id": 89, "speaker": 50, "form": "dlg", "jp": "「で、どうするつもりなのかな？」"},
{"id": 90, "speaker": 50, "form": "dlg", "jp": "「キミたちの攻撃が通用しないのは\n　知ってるだろう？」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「知ってるよ‥‥」"},
{"id": 92, "speaker": 50, "form": "dlg", "jp": "「じゃあ、どうするの？」"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "「『１つになるのさ‥‥』」"},
{"id": 94, "speaker": 50, "form": "dlg", "jp": "「なんだって！？」"},
{"id": 95, "speaker": 50, "form": "dlg", "jp": "ボクは出口と『１つになるイメージ』を抱いた。"},
{"id": 96, "speaker": 50, "form": "dlg", "jp": "そして‥‥"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 98, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "こ、ここはどこだ？"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "「ナゴム、聞こえる？」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "「＃％＆＄（＃＃＄％％＆‥‥」"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "「な、何言ってるの？」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "「＃％＆＄（＃＃＄％％＆＠＠％＃‥‥！」"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "「テレパシーに切り替えてみて！」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "（聞こえるけど、見えないんだよ！）"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "「今、君はあのコと『融合』しているのよ！」"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "「たぶん、神経回路があのコのものと\n　混線しているから、」"},
{"id": 108, "speaker": 29, "form": "dlg", "jp": "「感覚器官が正常に動いていないんじゃない？」"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "（で、これからどうすれば？）"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "「倒すのよ、『あのコの意識』を‥‥」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "（どうやって‥‥）"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "「心を内側に向けなさい！」"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "「そうすれば、そこにいる\n　『あのコの意識』が見えるハズだから‥‥」"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "心を内側に？"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "よくわからないけど、\nやってみるか‥‥"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "ボクはいわゆる『メイソウ』を試みた。"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "すると、目の前にだんだんと\n『心の内側』の景色が見えてきた。"},
{"id": 118, "speaker": 50, "form": "dlg", "jp": "「まさか、こんなところまで追ってくるとは‥‥」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「ボク自身もあきれてるよ‥‥」"},
{"id": 120, "speaker": 50, "form": "dlg", "jp": "「フフフフフフ‥‥」"},
{"id": 121, "speaker": 50, "form": "dlg", "jp": "「作戦としては、\n　かなりオモシロイ作戦だね‥‥」"},
{"id": 122, "speaker": 50, "form": "dlg", "jp": "「どうせ、『意識』を殺してこいって\n　そそのかされたんだろう？」"},
{"id": 123, "speaker": 50, "form": "dlg", "jp": "「たしかに、\n　もしキミがボクの意識を倒すことができたら」"},
{"id": 124, "speaker": 50, "form": "dlg", "jp": "「ボクを殺さないで倒すことができるだろうけど‥‥」"},
{"id": 125, "speaker": 50, "form": "dlg", "jp": "「それはボクの意識を倒せた場合の話で\n　かならずそれができるってワケじゃないんだが‥‥」"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "「でも、できないワケでもないだろう？」"},
{"id": 127, "speaker": 50, "form": "dlg", "jp": "「知ってると思うけど、\n　ここはイメージの世界の中だぜ？」"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "「それがどうかしたのか？」"},
{"id": 129, "speaker": 50, "form": "dlg", "jp": "「ここにはキミの仲間は助けに来れないんだぜ？」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「知ってるよ！」"},
{"id": 131, "speaker": 50, "form": "dlg", "jp": "「キミ１人の力でボクに勝てるかな？」"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "「勝ってみせるよ！」"},
{"id": 133, "speaker": 50, "form": "dlg", "jp": "「フフフフフフフ‥‥」"},
{"id": 134, "speaker": 50, "form": "dlg", "jp": "「スキあり！」"},
{"id": 135, "speaker": 50, "form": "dlg", "jp": "出口はボクに向かって光線を発射した。"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「何度も同じ手には引っかからないよ！」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "ボクはそれを素早くかわした。"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "『意識だけの存在』でも\n『能力』を使うことができるのか‥‥？"},
{"id": 139, "speaker": 50, "form": "dlg", "jp": "「『能力』は『意識が生み出す力』‥‥」"},
{"id": 140, "speaker": 50, "form": "dlg", "jp": "「たとえ、『意識だけの存在』になろうと\n　『能力』は使うことができるんだよ！」"},
{"id": 141, "speaker": 50, "form": "dlg", "jp": "「たしかに、キミの能力は\n　攻撃力も防御力も非常に高い‥‥」"},
{"id": 142, "speaker": 50, "form": "dlg", "jp": "「しかし、『攻撃射程』は圧倒的に\n　ボクの方が勝ってるんだよ！」"},
{"id": 143, "speaker": 50, "form": "dlg", "jp": "「くらえっ！」"},
{"id": 144, "speaker": 50, "form": "dlg", "jp": "エイジは再び光線を発射した。"},
{"id": 145, "speaker": 50, "form": "dlg", "jp": "ボクはどうにかそれもかわすことができた。"},
{"id": 146, "speaker": 50, "form": "dlg", "jp": "しかし‥‥"},
{"id": 147, "speaker": 50, "form": "dlg", "jp": "ボクが攻撃をよけているすきに\nエイジは遠くに逃げてしまった。"},
{"id": 148, "speaker": 50, "form": "dlg", "jp": "ちくしょう！"},
{"id": 149, "speaker": 50, "form": "dlg", "jp": "飛び道具をもたないボクが\n攻撃するには接近戦に持ち込まないと‥‥"},
{"id": 150, "speaker": 50, "form": "dlg", "jp": "ただ、出口の攻撃をよけてるだけじゃあ、\nそのうち疲れて、やられてしまう。"},
{"id": 151, "speaker": 50, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 152, "speaker": 50, "form": "dlg", "jp": "ええいっ！"},
{"id": 153, "speaker": 50, "form": "dlg", "jp": "こうなれば！"},
{"id": 154, "speaker": 50, "form": "dlg", "jp": "つかまえてやる！！"},
{"id": 155, "speaker": 50, "form": "dlg", "jp": "ボクは光線を発射する出口に\n向かって行くことにした。"},
{"id": 156, "speaker": 50, "form": "dlg", "jp": "「フフフフフフフ‥‥」"},
{"id": 157, "speaker": 50, "form": "dlg", "jp": "「また、追いかけっこかい？」"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "「くらぇ～～～～っ！」"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "「ブン！」"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "「バシッ！」"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "ボクはありったけの力で、エイジを殴り付けた。"},
{"id": 162, "speaker": 50, "form": "dlg", "jp": "「うわっ～～～～～～！」"},
{"id": 163, "speaker": 50, "form": "dlg", "jp": "ボクは拳にたしかな手ごたえを感じた。"},
{"id": 164, "speaker": 50, "form": "dlg", "jp": "ボクの拳の先に小さくなってゆく出口の姿が見えた。"},
{"id": 165, "speaker": 50, "form": "dlg", "jp": "そこでボクの意識は一旦途切れた。"},
{"id": 166, "speaker": 50, "form": "dlg", "jp": "たぶん、この『融合した肉体』を支えている\n『意識』の一方が途切れたせいだろう。"},
{"id": 167, "speaker": 50, "form": "dlg", "jp": "それから、しばらくして\nボクは仲間たちの声で目を覚ました。"},
{"id": 168, "speaker": 29, "form": "dlg", "jp": "「ナゴム、気がついたのね‥‥」"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "「ジ、ジーン‥‥」"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "そこは、いつの間に移動したのか、\nボクが目を覚ましたのは自分の部屋だった。"},
{"id": 171, "speaker": 31, "form": "dlg", "jp": "「よくやったぞ、ナゴム！！」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「よくやった？」"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "「ってことは？」"},
{"id": 174, "speaker": 16, "form": "dlg", "jp": "「とりかえしたのよ『ノア』を‥‥」"},
{"id": 175, "speaker": 51, "form": "dlg", "jp": "「とりかえしたんよ『ノア』を‥‥」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「ほ、本当？」"},
{"id": 177, "speaker": 29, "form": "dlg", "jp": "「本当よ‥‥」"},
{"id": 178, "speaker": 29, "form": "dlg", "jp": "ジーンは小さな丸い石を差し出した。"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「こ、これが『ノア』？」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "「こんなに小さいの？」"},
{"id": 181, "speaker": 31, "form": "dlg", "jp": "「そうか、ナゴムは初めて見るんだったな？」"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "「で、出口は？」"},
{"id": 183, "speaker": 31, "form": "dlg", "jp": "「あの部屋で気絶してるよ‥‥」"},
{"id": 184, "speaker": 31, "form": "dlg", "jp": "「多分、あのまま廃人になっちゃうだろうな‥‥」"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "「そ、そんな‥‥」"},
{"id": 186, "speaker": 16, "form": "dlg", "jp": "「自業自得よ‥‥」"},
{"id": 187, "speaker": 51, "form": "dlg", "jp": "「自業自得や‥‥」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「なんか、心苦しいよ‥‥」"},
{"id": 189, "speaker": 29, "form": "dlg", "jp": "「あんなヤツに同情しても仕方ないわよ‥‥」"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "「コイツのせいで、ニューヨークと\n　上海の大勢の人たちが死んじゃったんだから‥‥」"},
{"id": 191, "speaker": 4, "form": "dlg", "jp": "「じゃあ、帰ろうか‥‥」"},
{"id": 192, "speaker": 29, "form": "dlg", "jp": "「頼んだわよ！」"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "「この人は？」"},
{"id": 194, "speaker": 45, "form": "dlg", "jp": "「ピリ・ライナニだ‥‥」"},
{"id": 195, "speaker": 29, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』の仲間よ！」"},
{"id": 196, "speaker": 29, "form": "dlg", "jp": "「『ノア』を運ぶために本部から来てもらったの」"},
{"id": 197, "speaker": 31, "form": "dlg", "jp": "「ピリは優秀な『テレポーター』だからな‥‥」"},
{"id": 198, "speaker": 16, "form": "dlg", "jp": "「常光寺くんをここまで運んだのもピリなの‥‥」"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "「で、ゲーマーは？」"},
{"id": 200, "speaker": 16, "form": "dlg", "jp": "「今、ロンドンの上空にいるらしいの‥‥」"},
{"id": 201, "speaker": 51, "form": "dlg", "jp": "「常光寺をここまで運んだのもピリなんよ‥‥」"},
{"id": 202, "speaker": 2, "form": "dlg", "jp": "「で、ゲーマーは？」"},
{"id": 203, "speaker": 51, "form": "dlg", "jp": "「今、ロンドンの上空にいるらしい‥‥」"},
{"id": 204, "speaker": 45, "form": "dlg", "jp": "「早くしないと、また被害が‥‥」"},
{"id": 205, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 206, "speaker": 31, "form": "dlg", "jp": "「じゃあ、オレたちは本部へ帰るよ‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「えっ、もう？」"},
{"id": 208, "speaker": 29, "form": "dlg", "jp": "「一刻も早く『ノア』を作動させないとね‥‥」"},
{"id": 209, "speaker": 16, "form": "dlg", "jp": "「アキラたちは‥‥？」"},
{"id": 210, "speaker": 29, "form": "dlg", "jp": "「『ノア』が無事作動すれば、\n　とりあえずそれで大丈夫だから‥‥」"},
{"id": 211, "speaker": 31, "form": "dlg", "jp": "「まあ、普通の中学生に戻ることだな‥‥」"},
{"id": 212, "speaker": 16, "form": "dlg", "jp": "「なんか、さみしいこと言うのね～～」"},
{"id": 213, "speaker": 29, "form": "dlg", "jp": "「でも、『能力』がある以上、\n　アナタたちは『Ｅ－ｇｒｏ』のメンバーよ‥‥」"},
{"id": 214, "speaker": 29, "form": "dlg", "jp": "「くれぐれも忘れないでね」"},
{"id": 215, "speaker": 16, "form": "dlg", "jp": "「もちろんよ！」"},
{"id": 216, "speaker": 51, "form": "dlg", "jp": "「ウチらは‥‥？」"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "「『ノア』が無事作動すれば、\n　とりあえずそれで大丈夫だから‥‥」"},
{"id": 218, "speaker": 31, "form": "dlg", "jp": "「まあ、普通の中学生に戻ることだな‥‥」"},
{"id": 219, "speaker": 51, "form": "dlg", "jp": "「なんか、さみしいこと言うなぁ～～」"},
{"id": 220, "speaker": 29, "form": "dlg", "jp": "「でも、『能力』がある以上、\n　アナタたちは『Ｅ－ｇｒｏ』のメンバーよ‥‥」"},
{"id": 221, "speaker": 29, "form": "dlg", "jp": "「くれぐれも忘れないでね」"},
{"id": 222, "speaker": 51, "form": "dlg", "jp": "「わかってるって！」"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "「また、会えるよね‥‥」"},
{"id": 224, "speaker": 29, "form": "dlg", "jp": "「会わない方がいいと思うわよ‥‥」"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "「どうして？」"},
{"id": 226, "speaker": 45, "form": "dlg", "jp": "「私たちが召集される時は\n　『人類の危機』が迫った時‥‥」"},
{"id": 227, "speaker": 45, "form": "dlg", "jp": "「バラバラにやってる時が\n　『平和の証』ですから‥‥」"},
{"id": 228, "speaker": 29, "form": "dlg", "jp": "「ってコトよ‥‥」"},
{"id": 229, "speaker": 45, "form": "dlg", "jp": "「さあ、早く行かないと！」"},
{"id": 230, "speaker": 31, "form": "dlg", "jp": "「そ、そうだな‥‥」"},
{"id": 231, "speaker": 31, "form": "dlg", "jp": "「じゃあな！」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 233, "speaker": 16, "form": "dlg", "jp": "「じゃね！」"},
{"id": 234, "speaker": 51, "form": "dlg", "jp": "「じゃね！」"},
{"id": 235, "speaker": 29, "form": "dlg", "jp": "「さようなら‥」"},
{"id": 236, "speaker": 2, "form": "dlg", "jp": "「さようなら‥‥」"},
{"id": 237, "speaker": 45, "form": "dlg", "jp": "「じゃあ、行きますよ！」"},
{"id": 238, "speaker": 45, "form": "dlg", "jp": "「シュン！」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「ジーーーーン！！」"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "「なんか、あっけないお別れだね‥‥」"},
{"id": 242, "speaker": 16, "form": "dlg", "jp": "「仕方ないわよ、もう時間が‥‥」"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "「そうなんだろうけど‥‥」"},
{"id": 244, "speaker": 16, "form": "dlg", "jp": "「これで人類は助かるのよね？」"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "「そう言えば、ロンドンのＵＦＯは？」"},
{"id": 246, "speaker": 16, "form": "dlg", "jp": "「忘れてた！」"},
{"id": 247, "speaker": 16, "form": "dlg", "jp": "「ちょっとテレビつけてみてよ！」"},
{"id": 248, "speaker": 51, "form": "dlg", "jp": "「仕方ないやん、もう時間が‥‥」"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "「そうなんだろうけど‥‥」"},
{"id": 250, "speaker": 51, "form": "dlg", "jp": "「ホンマにあんな石で、人類が救われるんやろうか？」"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "「そう言えば、ロンドンのＵＦＯは？」"},
{"id": 252, "speaker": 51, "form": "dlg", "jp": "「忘れてた！」"},
{"id": 253, "speaker": 51, "form": "dlg", "jp": "「ちょっとテレビつけてみて！」"},
{"id": 254, "speaker": 2, "form": "dlg", "jp": "「あ、ああ‥‥」"},
{"id": 255, "speaker": 2, "form": "dlg", "jp": "ボクはテレビをつけてみた。"},
{"id": 256, "speaker": 44, "form": "dlg", "jp": "「現在ご覧頂いている映像は無人カメラによる映像です」"},
{"id": 257, "speaker": 44, "form": "dlg", "jp": "「先ほど、\n　軍の方からロンドンからの避難命令が出され」"},
{"id": 258, "speaker": 44, "form": "dlg", "jp": "「われわれマスコミも\n　すでにロンドンから撤退しているのですが」"},
{"id": 259, "speaker": 44, "form": "dlg", "jp": "「依然、ＵＦＯはなんら動きをみせません！」"},
{"id": 260, "speaker": 16, "form": "dlg", "jp": "「アレ？\n　ぜんぜん変わってないわね？」"},
{"id": 261, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 262, "speaker": 0, "form": "dlg", "jp": "「ＵＦＯの映像をごらん頂いている最中ですが、\n　ただいま別のニュースが入りました‥‥」"},
{"id": 263, "speaker": 0, "form": "dlg", "jp": "「一旦、そちらの映像をごらんください‥‥」"},
{"id": 264, "speaker": 16, "form": "dlg", "jp": "「なにかしら？」"},
{"id": 265, "speaker": 51, "form": "dlg", "jp": "「なんや、ぜんぜん動きないやん！」"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 267, "speaker": 0, "form": "dlg", "jp": "「ＵＦＯの映像をごらん頂いている最中ですが、\n　ただいま別のニュースが入りました‥‥」"},
{"id": 268, "speaker": 0, "form": "dlg", "jp": "「一旦、そちらの映像をごらんください‥‥」"},
{"id": 269, "speaker": 51, "form": "dlg", "jp": "「なんやろう？」"},
{"id": 270, "speaker": 0, "form": "dlg", "jp": "「ご覧頂いている映像は『ペルー』の\n　『アンデス山脈』の現在の映像です‥‥」"},
{"id": 271, "speaker": 0, "form": "dlg", "jp": "「つい、先ほどから、『不思議な光』が\n　ちょうど『マチュピチュ』付近から‥‥」"},
{"id": 272, "speaker": 16, "form": "dlg", "jp": "「『ノアの光』の増幅が始まったのかも！」"},
{"id": 273, "speaker": 0, "form": "dlg", "jp": "「現在、『ペルー政府』はこの『光』の調査を‥‥」"},
{"id": 274, "speaker": 0, "form": "dlg", "jp": "どうやら、ジーンたちは無事、『ペルー』の\n『本部』に戻ったみたいだな‥‥"},
{"id": 275, "speaker": 0, "form": "dlg", "jp": "「この『光』につきましては\n　詳しい情報がわかり次第‥‥」"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "「わかりっこないよ！」"},
{"id": 277, "speaker": 16, "form": "dlg", "jp": "「ねえ、なんか明るくない？」"},
{"id": 278, "speaker": 51, "form": "dlg", "jp": "「『ノアの光』の増幅が始まったんやわ！」"},
{"id": 279, "speaker": 0, "form": "dlg", "jp": "「現在、『ペルー政府』はこの『光』の調査を‥‥」"},
{"id": 280, "speaker": 0, "form": "dlg", "jp": "どうやら、ジーンたちは無事、『ペルー』の\n『本部』に戻ったみたいだな‥‥"},
{"id": 281, "speaker": 0, "form": "dlg", "jp": "「この『光』につきましては\n　詳しい情報がわかり次第‥‥」"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "「わかりっこないよ！」"},
{"id": 283, "speaker": 51, "form": "dlg", "jp": "「なあ、なんか明るくない？」"},
{"id": 284, "speaker": 2, "form": "dlg", "jp": "「そ、そういえば‥‥」"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 287, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "世界中が『ノアの光』に包まれた。"},
{"id": 290, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 291, "speaker": 14, "form": "dlg", "jp": "「おいっ！」"},
{"id": 292, "speaker": 14, "form": "dlg", "jp": "「おいってば‥‥」"},
{"id": 293, "speaker": 14, "form": "dlg", "jp": "「何、ほうけてるんだ？」"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "「べ、べつに‥‥」"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "「ちょっと考えごとをしていただけだよ‥‥」"},
{"id": 296, "speaker": 14, "form": "dlg", "jp": "「考え事？」"},
{"id": 297, "speaker": 14, "form": "dlg", "jp": "「新しい先生のことだろう？」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "「違うよ！」"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "どうやら、こういうことらしい‥‥"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "つまり、『ノアの光』の『力』とは\n『命を守る光』ではなく、"},
{"id": 301, "speaker": 2, "form": "dlg", "jp": "『光を浴びたモノ』の『時間を戻す』\n『力』だったようだ‥‥"},
{"id": 302, "speaker": 2, "form": "dlg", "jp": "『Ｅ－ｇｒｏ』の増幅装置によって\n世界中をつつんだ『光』は"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "世界中の時間を戻した。"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "結果、たしかに世界中の多くの命は『守られ』、\nさらに壊滅した都市なども元通りになった。"},
{"id": 305, "speaker": 16, "form": "dlg", "jp": "「でも、コレって時間が戻っただけだから\n　また『ゲーマー』が襲ってくるんじゃないの？」"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "「さあ、どうなんだろう？」"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "「戻ったって言っても\n　全てが戻ったわけじゃないし‥‥」"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "「実際、\n　ボクらは戻る前の記憶を持ってるワケだし‥‥」"},
{"id": 309, "speaker": 16, "form": "dlg", "jp": "「そ、そうね‥‥」"},
{"id": 310, "speaker": 16, "form": "dlg", "jp": "「実際、出口も\n　犬のアイツも意識が戻ってないままみたいだし‥‥」"},
{"id": 311, "speaker": 16, "form": "dlg", "jp": "「でも、どうして他のみんなは、\n　戻る前の記憶が残ってないの？」"},
{"id": 312, "speaker": 51, "form": "dlg", "jp": "「でも、コレって時間が戻っただけやから\n　また『ゲーマー』が襲ってくるんちゃうのん？」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "「さあ、どうなんだろう？」"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "「戻ったって言っても\n　全てが戻ったわけじゃないし‥‥」"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "「実際、\n　ボクらは戻る前の記憶を持ってるワケだし‥‥」"},
{"id": 316, "speaker": 51, "form": "dlg", "jp": "「そうやなぁ」"},
{"id": 317, "speaker": 51, "form": "dlg", "jp": "「実際、出口も\n　犬のアイツも意識が戻ってないままやし‥‥」"},
{"id": 318, "speaker": 51, "form": "dlg", "jp": "「でも、なんで他のみんなは、\n　戻る前の記憶が残ってないんやろう？」"},
{"id": 319, "speaker": 2, "form": "dlg", "jp": "「そ、そう言えばそうだね‥‥」"},
{"id": 320, "speaker": 4, "form": "dlg", "jp": "「消したのよ‥‥」"},
{"id": 321, "speaker": 4, "form": "dlg", "jp": "ボクたちの背後から懐かしい声が聞こえた。"},
{"id": 322, "speaker": 29, "form": "dlg", "jp": "「おひさしぶり！」"},
{"id": 323, "speaker": 2, "form": "dlg", "jp": "「ジーン！！」"},
{"id": 324, "speaker": 31, "form": "dlg", "jp": "「正確にははじめましてかな‥‥」"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "「ケネスも！！」"},
{"id": 326, "speaker": 16, "form": "dlg", "jp": "「何しに来たの？」"},
{"id": 327, "speaker": 51, "form": "dlg", "jp": "「何しに来たん？」"},
{"id": 328, "speaker": 2, "form": "dlg", "jp": "「まさか、またボクたちを『勧誘しに』？」"},
{"id": 329, "speaker": 29, "form": "dlg", "jp": "「言ったでしょう！」"},
{"id": 330, "speaker": 29, "form": "dlg", "jp": "「『能力』がある限り、\n　ナゴムたちは『Ｅ－ｇｒｏ』のメンバーなの‥‥」"},
{"id": 331, "speaker": 31, "form": "dlg", "jp": "「メンバーをもう一度勧誘したりしないよ！」"},
{"id": 332, "speaker": 16, "form": "dlg", "jp": "「じゃあ、どうして？」"},
{"id": 333, "speaker": 51, "form": "dlg", "jp": "「じゃあ、なんで？」"},
{"id": 334, "speaker": 31, "form": "dlg", "jp": "「時間が戻ったせいで、\n　あの『ゾンビオヤジ』まで生き返ったんだよ！」"},
{"id": 335, "speaker": 2, "form": "dlg", "jp": "「なんだって！」"},
{"id": 336, "speaker": 29, "form": "dlg", "jp": "「大丈夫よ！」"},
{"id": 337, "speaker": 29, "form": "dlg", "jp": "「アイツも一度死んだ記憶は持っているみたいで\n　私たちの顔を見るなりあやまってきたわ！」"},
{"id": 338, "speaker": 16, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 339, "speaker": 4, "form": "dlg", "jp": "「新しく仲間になった\n　『秋山』と申します‥‥」"},
{"id": 340, "speaker": 2, "form": "dlg", "jp": "「ああーっ！！」"},
{"id": 341, "speaker": 16, "form": "dlg", "jp": "「ちょっと、この人は人殺しよ！」"},
{"id": 342, "speaker": 51, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 343, "speaker": 4, "form": "dlg", "jp": "「新しく仲間になった\n　『秋山』と申します‥‥」"},
{"id": 344, "speaker": 2, "form": "dlg", "jp": "「ああーっ！！」"},
{"id": 345, "speaker": 51, "form": "dlg", "jp": "「ちょっと、コイツ人殺しやん！」"},
{"id": 346, "speaker": 22, "form": "dlg", "jp": "「カン違いしないでくださいよ！」"},
{"id": 347, "speaker": 22, "form": "dlg", "jp": "「『この時間』ではまだ『人殺し』はしていませんよ！」"},
{"id": 348, "speaker": 22, "form": "dlg", "jp": "「それに、私自身すでに、\n　死をもってつぐなっているワケですし‥‥」"},
{"id": 349, "speaker": 31, "form": "dlg", "jp": "「まあ、被害もないし、\n　仲間になったんだからゆるしてやれよ！」"},
{"id": 350, "speaker": 2, "form": "dlg", "jp": "「なんか、メッチャふくざつな気分だよ‥‥」"},
{"id": 351, "speaker": 16, "form": "dlg", "jp": "「で、信用していいの？」"},
{"id": 352, "speaker": 51, "form": "dlg", "jp": "「で、信用していいの？」"},
{"id": 353, "speaker": 29, "form": "dlg", "jp": "「大丈夫じゃないかしら？」"},
{"id": 354, "speaker": 29, "form": "dlg", "jp": "「本当に死ぬような目にあったわけだし‥‥」"},
{"id": 355, "speaker": 22, "form": "dlg", "jp": "「そ、そうですよ‥‥」"},
{"id": 356, "speaker": 2, "form": "dlg", "jp": "「それより、『消した』って？」"},
{"id": 357, "speaker": 29, "form": "dlg", "jp": "「『記憶』をよ‥‥」"},
{"id": 358, "speaker": 2, "form": "dlg", "jp": "「『記憶』？」"},
{"id": 359, "speaker": 29, "form": "dlg", "jp": "「そうよ‥‥」"},
{"id": 360, "speaker": 29, "form": "dlg", "jp": "「世界中の人たちの記憶を全部‥‥」"},
{"id": 361, "speaker": 16, "form": "dlg", "jp": "「そんなことできるの？」"},
{"id": 362, "speaker": 51, "form": "dlg", "jp": "「そんなことできるの？」"},
{"id": 363, "speaker": 29, "form": "dlg", "jp": "「『リーダー』がやったの‥‥」"},
{"id": 364, "speaker": 2, "form": "dlg", "jp": "「『リーダー』？」"},
{"id": 365, "speaker": 31, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』の『リーダー』だよ！」"},
{"id": 366, "speaker": 29, "form": "dlg", "jp": "「『リーダー』は強力な『催眠術』を使えるのよ」"},
{"id": 367, "speaker": 31, "form": "dlg", "jp": "「誰かさんみたいに『死んだ記憶』なんか持ってちゃ\n　大変だろう？」"},
{"id": 368, "speaker": 22, "form": "dlg", "jp": "「もう、イジめないでくださいよ！」"},
{"id": 369, "speaker": 2, "form": "dlg", "jp": "「そうだ、時間が戻ったってことは\n　また『ゲーマー』が襲ってくるんじゃあ？」"},
{"id": 370, "speaker": 29, "form": "dlg", "jp": "「安心して‥‥」"},
