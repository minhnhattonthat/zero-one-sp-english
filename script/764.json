[
{"id": 0, "speaker": 21, "form": "dlg", "jp": "「キミが第一発見者ね‥‥」"},
{"id": 1, "speaker": 50, "form": "dlg", "jp": "「いえ、常光寺くんと２人で見つけたんです」"},
{"id": 2, "speaker": 21, "form": "dlg", "jp": "「そうなの‥‥」"},
{"id": 3, "speaker": 21, "form": "choice", "jp": "「ちがいます！」"},
{"id": 4, "speaker": 21, "form": "choice", "jp": "「そうです」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "「そうです」"},
{"id": 6, "speaker": 2, "form": "dlg", "jp": "「まず、彼が見つけて、\n　その後しばらくしてからボクも‥‥」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「ちがいます！」"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「まず、彼が見つけて、\n　その後しばらくしてからボクも‥‥」"},
{"id": 9, "speaker": 21, "form": "dlg", "jp": "「しばらくってどれくらい？」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「１分ぐらいじゃないかと‥‥」"},
{"id": 11, "speaker": 21, "form": "dlg", "jp": "「１分ぐらいなら２人同時に発見したってことね‥‥」"},
{"id": 12, "speaker": 11, "form": "dlg", "jp": "「で、キミの名前は？」"},
{"id": 13, "speaker": 50, "form": "dlg", "jp": "「出口エイジです」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「同じ学校に通ってるんです‥‥」"},
{"id": 15, "speaker": 11, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「そうだっ！」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「警部さん、こんなものが‥‥」"},
{"id": 18, "speaker": 11, "form": "dlg", "jp": "「なんだコレは！？」"},
{"id": 19, "speaker": 21, "form": "dlg", "jp": "「ちょっと見せて‥‥」"},
{"id": 20, "speaker": 21, "form": "dlg", "jp": "「なめたことをしてくれるわね‥‥」"},
{"id": 21, "speaker": 2, "form": "dlg", "jp": "「これってやっぱり‥‥」"},
{"id": 22, "speaker": 21, "form": "dlg", "jp": "「『ルード』以外考えられないわね‥‥」"},
{"id": 23, "speaker": 12, "form": "dlg", "jp": "「警視、リツコさんの方の無事は確認されました！」"},
{"id": 24, "speaker": 21, "form": "dlg", "jp": "「そうでしょうね‥‥」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「そうでしょう？」"},
{"id": 26, "speaker": 21, "form": "dlg", "jp": "「ヤツらはドクタージョウコウジを\n　追い込むつもりよ‥‥」"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "「追い込む？」"},
{"id": 28, "speaker": 21, "form": "dlg", "jp": "「見つけられないから、\n　誘い出す作戦に切り替えたのよ」"},
{"id": 29, "speaker": 21, "form": "dlg", "jp": "「２人の子供のうち、１人を殺すことで」"},
{"id": 30, "speaker": 21, "form": "dlg", "jp": "「出てこないと\n　もう１人の命も危ないと思わせる作戦ね‥‥」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「つまり‥‥」"},
{"id": 32, "speaker": 21, "form": "dlg", "jp": "「ルードはとりあえずキミから殺そうとしている」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥！！」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "なんてことだ‥‥"},
{"id": 35, "speaker": 21, "form": "dlg", "jp": "「アキヤマッ！！」"},
{"id": 36, "speaker": 22, "form": "dlg", "jp": "「ハッ！」"},
{"id": 37, "speaker": 21, "form": "dlg", "jp": "「フロントに『ドアの開閉記録』を確認して！」"},
{"id": 38, "speaker": 22, "form": "dlg", "jp": "「わかりました！」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「『ドアの開閉記録』？」"},
{"id": 40, "speaker": 11, "form": "dlg", "jp": "「この部屋は警護用にドアの開閉された時間が\n　フロントに記録されるんだよ‥‥」"},
{"id": 41, "speaker": 11, "form": "dlg", "jp": "「つまり、いつあの部屋に犯人が入ったか\n　特定することができるんだよ」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "「ちょっと待ってください！」"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "「じゃあ、\n　あの部屋に犯人が侵入していたんですか？」"},
{"id": 44, "speaker": 21, "form": "dlg", "jp": "「窓ガラスが割れていないことを考えると\n　外から狙撃されたわけではない‥‥」"},
{"id": 45, "speaker": 21, "form": "dlg", "jp": "「となると、部屋の中で撃たれた‥‥」"},
{"id": 46, "speaker": 21, "form": "dlg", "jp": "「それに、こちらの部屋に\n　『メモ』があるってことからしても」"},
{"id": 47, "speaker": 21, "form": "dlg", "jp": "「両方の部屋に犯人は入ったことに‥‥」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「じゃあ、\n　ボクたちはそんなキケンな場所に‥‥」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 50, "speaker": 22, "form": "dlg", "jp": "「お待たせしました」"},
{"id": 51, "speaker": 21, "form": "dlg", "jp": "「どうだったの？」"},
{"id": 52, "speaker": 22, "form": "dlg", "jp": "「それが‥‥」"},
{"id": 53, "speaker": 22, "form": "dlg", "jp": "「あちらの部屋は朝ワレワレが出ていってからは\n　一度も開けられていないそうです」"},
{"id": 54, "speaker": 21, "form": "dlg", "jp": "「となると、\n　犯人はこちらの部屋から入った‥‥」"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「それはあり得ません！」"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "「ドアの開いた時間うんぬんより\n　もっと重要なことが‥‥」"},
{"id": 57, "speaker": 21, "form": "dlg", "jp": "「何かしら？」"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "「ボクたちが死体を見つけるほんの\n　数分前まで刑事さんたちは生きてたんです！」"},
{"id": 59, "speaker": 11, "form": "dlg", "jp": "「どういうことなんだい？」"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "「出口がこの部屋に来る前に\n　刑事さんにそのことを伝えたんです」"},
{"id": 61, "speaker": 11, "form": "dlg", "jp": "「その後、どれぐらいして彼は来たんだ？」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "「多分、２～３分ぐらいです‥‥」"},
{"id": 63, "speaker": 50, "form": "dlg", "jp": "「ボクがあちらの部屋から\n　悲鳴を聞いたのはその３分後ぐらいです‥‥」"},
{"id": 64, "speaker": 11, "form": "dlg", "jp": "「じゃあ、\n　『５～６分』の間に殺されたということか‥‥」"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "「それにその間、\n　ずっとボクがコチラの部屋にいたんで」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「こちらのドアから\n　誰かが入ってくるなんてありえません！」"},
{"id": 67, "speaker": 11, "form": "dlg", "jp": "「ふむう‥‥」"},
{"id": 68, "speaker": 21, "form": "dlg", "jp": "「ねえ、アナタは悲鳴は聞かなかったの？」"},
{"id": 69, "speaker": 21, "form": "choice", "jp": "「聞いてません‥‥」"},
{"id": 70, "speaker": 21, "form": "choice", "jp": "「聞きました！」"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "「聞きました！」"},
{"id": 72, "speaker": 11, "form": "dlg", "jp": "「となるとやはりその時間に\n　殺されたということだな‥‥」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「聞いてません‥‥」"},
{"id": 74, "speaker": 11, "form": "dlg", "jp": "「どうして、キミだけに聞こえたんだ？」"},
{"id": 75, "speaker": 50, "form": "dlg", "jp": "「ボクは視力が弱いので\n　普通の人より音にビンカンなんです‥‥」"},
{"id": 76, "speaker": 11, "form": "dlg", "jp": "「そうなのか‥‥」"},
{"id": 77, "speaker": 11, "form": "dlg", "jp": "「で、『銃声』は？」"},
{"id": 78, "speaker": 50, "form": "dlg", "jp": "「聞きませんでした‥‥」"},
{"id": 79, "speaker": 22, "form": "dlg", "jp": "「そうでしょうね‥‥」"},
{"id": 80, "speaker": 22, "form": "dlg", "jp": "「遺体をみるかぎり、\n　犯行には『レイガン』が使われたようですから‥‥」"},
{"id": 81, "speaker": 11, "form": "dlg", "jp": "「『レイガン』？」"},
{"id": 82, "speaker": 21, "form": "dlg", "jp": "「『光線銃』よ‥‥」"},
{"id": 83, "speaker": 11, "form": "dlg", "jp": "「そんなものを‥‥」"},
{"id": 84, "speaker": 21, "form": "dlg", "jp": "「犯人が出入りした形跡がないとすると‥‥」"},
{"id": 85, "speaker": 21, "form": "dlg", "jp": "「まだ、\n　ここに潜んでいるかもしれないわね‥‥」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「それはありえないでしょう？」"},
{"id": 87, "speaker": 21, "form": "dlg", "jp": "「言っておくけど、\n　一番怪しいのはアナタたちよ‥‥」"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "「そんなぁ～」"},
{"id": 89, "speaker": 11, "form": "dlg", "jp": "「そうですよ、彼らには『動機』が‥‥」"},
{"id": 90, "speaker": 11, "form": "dlg", "jp": "「それに『光線銃』なんて特殊なモノも‥‥」"},
{"id": 91, "speaker": 21, "form": "dlg", "jp": "「彼等に『動機』はなくても\n　『動機』のある人間から依頼を受けてるかも‥‥」"},
{"id": 92, "speaker": 21, "form": "dlg", "jp": "「それなら、凶器の手配も依頼人がすれば‥‥」"},
{"id": 93, "speaker": 11, "form": "dlg", "jp": "「はぁ‥‥」"},
{"id": 94, "speaker": 21, "form": "dlg", "jp": "「それに『自動発射装置』ということも考えられます」"},
{"id": 95, "speaker": 21, "form": "dlg", "jp": "「彼等２人と、\n　この部屋をテッテイ的に調べましょう」"},
{"id": 96, "speaker": 21, "form": "dlg", "jp": "こうして、ボクと出口の２人は\n持ち物検査をされ、"},
{"id": 97, "speaker": 21, "form": "dlg", "jp": "２つの部屋はテッテイ的に調べられた‥‥"},
{"id": 98, "speaker": 21, "form": "dlg", "jp": "しかし‥‥"},
{"id": 99, "speaker": 22, "form": "dlg", "jp": "「何も出て来ませんね‥‥」"},
{"id": 100, "speaker": 21, "form": "dlg", "jp": "「『自動発射装置』の線は消えたわね」"},
{"id": 101, "speaker": 11, "form": "dlg", "jp": "「ナゴムくんたちも何も持っておりません！」"},
{"id": 102, "speaker": 21, "form": "dlg", "jp": "「じゃあ、\n　犯人はここからすでに出て行ってしまった‥‥」"},
{"id": 103, "speaker": 11, "form": "dlg", "jp": "「ナゴムくん、本当にこちらのドアから\n　誰か出ていかなかったのかい？」"},
{"id": 104, "speaker": 11, "form": "choice", "jp": "「はい、誰も‥‥」"},
{"id": 105, "speaker": 11, "form": "choice", "jp": "「よく覚えていません‥‥」"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "「よく覚えていません‥‥」"},
{"id": 107, "speaker": 21, "form": "dlg", "jp": "「ということは、\n　やはり誰かが出入りした可能性があるわね」"},
{"id": 108, "speaker": 21, "form": "dlg", "jp": "「とにかく、\n　アナタたちには別の部屋を用意します」"},
{"id": 109, "speaker": 21, "form": "dlg", "jp": "「後は館内に不審な人物が出入りしてないか\n　もう一度洗い直しを‥‥」"},
{"id": 110, "speaker": 22, "form": "dlg", "jp": "「わかりました！」"},
{"id": 111, "speaker": 22, "form": "dlg", "jp": "こうして、ボクたちは別の部屋に移ることになった。"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "「ゴメンね、変なことに巻き込んじゃって‥‥」"},
{"id": 113, "speaker": 50, "form": "dlg", "jp": "「いいよ‥‥」"},
{"id": 114, "speaker": 50, "form": "dlg", "jp": "「でも、よかったじゃない‥‥」"},
{"id": 115, "speaker": 50, "form": "dlg", "jp": "「また、こんないい部屋に移してもらって‥‥」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「いい部屋って言っても、\n　前の部屋とまったく同じつくりだし‥‥」"},
{"id": 117, "speaker": 50, "form": "dlg", "jp": "「でも、いったいいつの間に犯人は\n　出入りしたんだろうね‥‥」"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「さあ、ちゃんと注意しておけば良かったよ‥‥」"},
{"id": 119, "speaker": 50, "form": "dlg", "jp": "「今のうちに『メモ』がおかれてるかどうか\n　チェックしておいたら‥‥」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「あの『メモ』がいつ置かれたのか\n　気になってたんだよ‥‥」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "ボクは念のため、あらかじめ部屋の\n状態をチェックしておくことにした。"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "その時！！"},
{"id": 124, "speaker": 50, "form": "dlg", "jp": "「常光寺くんっ！　危ない！！」"},
{"id": 125, "speaker": 50, "form": "dlg", "jp": "ボクは出口の危険を知らせる叫び声に振り向いた。"},
{"id": 126, "speaker": 50, "form": "dlg", "jp": "しかし‥‥"},
{"id": 127, "speaker": 2, "form": "dlg", "jp": "「うわぁぁぁぁぁぁぁぁぁ」"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "ボクは何が起きたのか確認する前に\n撃ち抜かれた。"},
{"id": 129, "speaker": 2, "form": "dlg", "jp": "「はい、誰も‥‥」"},
{"id": 130, "speaker": 11, "form": "dlg", "jp": "「そこまで、\n　言い切られると信じないわけにはいかないな‥‥」"},
{"id": 131, "speaker": 21, "form": "dlg", "jp": "「となると、犯人はどこへいったの？」"},
{"id": 132, "speaker": 21, "form": "dlg", "jp": "たしかに‥‥"},
{"id": 133, "speaker": 21, "form": "dlg", "jp": "犯人がこちらのドアから出入りしなかったとしたら\nいったいどこに行ってしまったんだ？"},
{"id": 134, "speaker": 21, "form": "dlg", "jp": "考えられるのは‥‥"},
{"id": 135, "speaker": 21, "form": "choice", "jp": "【犯人なんていない！？】"},
{"id": 136, "speaker": 21, "form": "choice", "jp": "【犯人はここにいる！？】"},
{"id": 137, "speaker": 21, "form": "dlg", "jp": "【犯人なんていない！？】"},
{"id": 138, "speaker": 21, "form": "dlg", "jp": "つまり、第三者に殺されたんじゃなく、\n刑事さん同士で殺しあった。"},
{"id": 139, "speaker": 21, "form": "dlg", "jp": "もしくはどちらかの刑事さんがもう１人を殺し、\n自分は自殺した‥‥"},
{"id": 140, "speaker": 21, "form": "dlg", "jp": "ワレながらいい推理かも！！"},
{"id": 141, "speaker": 2, "form": "dlg", "jp": "「あのぅ‥‥」"},
{"id": 142, "speaker": 21, "form": "dlg", "jp": "「何かしら？」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「もしかしたら、『犯人』なんていないんじゃぁ？」"},
{"id": 144, "speaker": 21, "form": "dlg", "jp": "「はぁ？」"},
{"id": 145, "speaker": 11, "form": "dlg", "jp": "「どういうことだい？」"},
{"id": 146, "speaker": 11, "form": "dlg", "jp": "ボクは自分の推理を警部さんたちに話した。"},
{"id": 147, "speaker": 11, "form": "dlg", "jp": "「オイオイ、なんでそんなこと‥‥」"},
{"id": 148, "speaker": 21, "form": "dlg", "jp": "「でも、状況から考えるとないともいえないわね‥‥」"},
{"id": 149, "speaker": 11, "form": "dlg", "jp": "「警視まで‥‥」"},
{"id": 150, "speaker": 21, "form": "dlg", "jp": "「つまり、\n　警察の内部に『刺客』が送り込まれていたのよ‥‥」"},
{"id": 151, "speaker": 11, "form": "dlg", "jp": "「そんなぁ、彼らは『警察』ですよ！」"},
{"id": 152, "speaker": 21, "form": "dlg", "jp": "「日本の警察がそこまでフハイしていないと言い切れる？」"},
{"id": 153, "speaker": 11, "form": "dlg", "jp": "「‥‥でも、２人とも死んでるんですよ？」"},
{"id": 154, "speaker": 21, "form": "dlg", "jp": "「たぶん、片方が犯人でもう１人が自殺ね‥‥」"},
{"id": 155, "speaker": 11, "form": "dlg", "jp": "「なんで自殺なんか！？」"},
{"id": 156, "speaker": 21, "form": "dlg", "jp": "「そこまでの『料金』でやとわれたんじゃぁ？」"},
{"id": 157, "speaker": 11, "form": "dlg", "jp": "「はぁ？」"},
{"id": 158, "speaker": 21, "form": "dlg", "jp": "「お金をやるから『死ね』と‥‥」"},
{"id": 159, "speaker": 11, "form": "dlg", "jp": "「そんなことするワケが‥‥」"},
{"id": 160, "speaker": 21, "form": "dlg", "jp": "「例えば『借金』とか‥‥」"},
{"id": 161, "speaker": 21, "form": "dlg", "jp": "「家族にメイワクかけないように\n　保険金をかけて自殺する人間もいるでしょう？」"},
{"id": 162, "speaker": 21, "form": "dlg", "jp": "「とにかく、２人の『借金』について調べてみて！」"},
{"id": 163, "speaker": 22, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 164, "speaker": 21, "form": "dlg", "jp": "「『ルード』め‥‥」"},
{"id": 165, "speaker": 21, "form": "dlg", "jp": "「手の込んだコトを‥‥」"},
{"id": 166, "speaker": 21, "form": "dlg", "jp": "「とにかく、\n　アナタたちには別の部屋を用意します」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「すみません‥‥」"},
{"id": 168, "speaker": 21, "form": "dlg", "jp": "「念のため、\n　今回の警備のメンバー全員のリストを提出して！」"},
{"id": 169, "speaker": 11, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 170, "speaker": 11, "form": "dlg", "jp": "【犯人はここにいる！？】"},
{"id": 171, "speaker": 11, "form": "dlg", "jp": "つまり、今ここにいる人の中に犯人が‥‥！？"},
{"id": 172, "speaker": 11, "form": "dlg", "jp": "この事件のカギとなるのは、"},
{"id": 173, "speaker": 11, "form": "choice", "jp": "【その人が入ってきた時間だ】"},
{"id": 174, "speaker": 11, "form": "choice", "jp": "【その人が出て行った時間だ】"},
{"id": 175, "speaker": 11, "form": "dlg", "jp": "【その人が出て行った時間だ】"},
{"id": 176, "speaker": 11, "form": "dlg", "jp": "警視の言う通り、『自動発射装置』を使えば、\n事前にセットしておくことは可能。"},
{"id": 177, "speaker": 11, "form": "dlg", "jp": "後はその『自動発射装置』を回収さえすればいいだけ。"},
{"id": 178, "speaker": 11, "form": "dlg", "jp": "つまり！！"},
{"id": 179, "speaker": 11, "form": "dlg", "jp": "警察が『自動発射装置』を探す前に\nこの部屋を出た人間が犯人だ‥‥"},
{"id": 180, "speaker": 11, "form": "dlg", "jp": "それはいったい？"},
{"id": 181, "speaker": 11, "form": "dlg", "jp": "とりあえず、ボクと出口は事件以降\nこの部屋を一歩も出ていない‥‥"},
{"id": 182, "speaker": 11, "form": "dlg", "jp": "となると、あやしいのは‥‥"},
{"id": 183, "speaker": 11, "form": "choice", "jp": "【ブラバスキー警視！】"},
{"id": 184, "speaker": 11, "form": "choice", "jp": "【大槻警部！】"},
{"id": 185, "speaker": 11, "form": "choice", "jp": "【秋山警部補！】"},
{"id": 186, "speaker": 11, "form": "dlg", "jp": "【大槻警部！】"},
{"id": 187, "speaker": 11, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 188, "speaker": 11, "form": "dlg", "jp": "いや、警部はこの部屋に来てから、\n一度もここから移動していない！"},
{"id": 189, "speaker": 11, "form": "dlg", "jp": "となると‥‥"},
{"id": 190, "speaker": 11, "form": "choice", "jp": "【ブラバスキー警視！】"},
{"id": 191, "speaker": 11, "form": "choice", "jp": "【秋山警部補！】"},
{"id": 192, "speaker": 11, "form": "dlg", "jp": "ブラバスキー警視　！"},
{"id": 193, "speaker": 11, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 194, "speaker": 11, "form": "dlg", "jp": "いや、警視もこの部屋に来てから、\n一度もここから移動していない！"},
{"id": 195, "speaker": 11, "form": "dlg", "jp": "残るのは‥‥"},
{"id": 196, "speaker": 11, "form": "dlg", "jp": "【ブラバスキー警視！】"},
{"id": 197, "speaker": 11, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 198, "speaker": 11, "form": "dlg", "jp": "いや、警視はこの部屋に来てから、\n一度もここから移動していない！"},
{"id": 199, "speaker": 11, "form": "dlg", "jp": "となると‥‥"},
{"id": 200, "speaker": 11, "form": "choice", "jp": "【大槻警部！】"},
{"id": 201, "speaker": 11, "form": "choice", "jp": "【秋山警部補！】"},
{"id": 202, "speaker": 11, "form": "dlg", "jp": "【大槻警部！】"},
{"id": 203, "speaker": 11, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 204, "speaker": 11, "form": "dlg", "jp": "いや、警部もこの部屋に来てから、\n一度もここから移動していない！"},
{"id": 205, "speaker": 11, "form": "dlg", "jp": "残るのは‥‥"},
{"id": 206, "speaker": 11, "form": "dlg", "jp": "【秋山警部補！】"},
{"id": 207, "speaker": 11, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 208, "speaker": 11, "form": "dlg", "jp": "たしか、秋山警部補は『ドアの開閉記録』を\n調べるためにいったんこの部屋を出た‥‥"},
{"id": 209, "speaker": 11, "form": "dlg", "jp": "あの時なら、『自動発射装置』を持ち出し\n処分できたハズだ！！"},
{"id": 210, "speaker": 11, "form": "dlg", "jp": "「ナゴムくん、どうかしたのかい？」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「あのぅ‥‥」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "やっぱり、言いづらいな‥‥"},
{"id": 213, "speaker": 21, "form": "dlg", "jp": "「ハッキリ言いなさいっ！！」"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "「もし、『自動発射装置』を使ったんなら‥‥」"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "ボクは自分の推理を発表した。"},
{"id": 216, "speaker": 22, "form": "dlg", "jp": "「ちょっ、ちょっと、何をいいだすんだ‥‥」"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "「でも、状況を整理するとそういうことに‥‥」"},
{"id": 219, "speaker": 50, "form": "dlg", "jp": "「なるほどっ！！」"},
{"id": 220, "speaker": 21, "form": "dlg", "jp": "「なるほどじゃないわよ！」"},
{"id": 221, "speaker": 21, "form": "dlg", "jp": "「少年探偵ゴッコじゃ事件は解決できないわよ！」"},
{"id": 222, "speaker": 50, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 223, "speaker": 21, "form": "dlg", "jp": "「キミたちは『メモ』のことを忘れていない？」"},
{"id": 224, "speaker": 21, "form": "dlg", "jp": "「確かに、ここから退出したのは\n　秋山しかいないけど」"},
{"id": 225, "speaker": 21, "form": "dlg", "jp": "「秋山じゃ『メモ』を置くことはできないわよ！」"},
{"id": 226, "speaker": 22, "form": "dlg", "jp": "「そ、そうですよ！」"},
{"id": 227, "speaker": 11, "form": "dlg", "jp": "「たしかに、そうですな‥‥」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "「すみません！」"},
{"id": 229, "speaker": 21, "form": "dlg", "jp": "「疑心暗鬼にならない方がいいわよ‥‥」"},
{"id": 230, "speaker": 21, "form": "dlg", "jp": "「ルードの連中は\n　その辺りを狙ってやってるんでしょうし‥‥」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 232, "speaker": 21, "form": "dlg", "jp": "「とにかく、\n　アナタたちには別の部屋を用意します」"},
{"id": 233, "speaker": 21, "form": "dlg", "jp": "「殺人のあった部屋なんてイヤでしょうから‥‥」"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "「すみません‥‥」"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "【その人が入ってきた時間だ】"},
{"id": 236, "speaker": 2, "form": "dlg", "jp": "『ドアの開閉記録』がある以上、\n第三者が出入りしたとは思えない‥‥"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "つまり、この関係者の中に『犯人』がいる！"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "いったい誰が‥‥"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "ボクが刑事さんたちにあいさつしてから\n事件が起こるまでにこの部屋に入って来たのは"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "出口エイジただ１人だけ‥‥"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "まさか『出口』が！？"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "いや、それはありえない！"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "たしか、『悲鳴』を聞いた時、\n出口はボクと話をしていた。"},
{"id": 244, "speaker": 2, "form": "dlg", "jp": "つまり、『光線銃』なんて\n発射できるワケないんだ‥‥"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "となると‥‥"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "入ってきた時間ではなく、"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "出口に刑事さんたちを殺す時間なんかあったか？"},
{"id": 248, "speaker": 2, "form": "choice", "jp": "【出口にそんな時間はなかった！】"},
{"id": 249, "speaker": 2, "form": "choice", "jp": "【出口にはその時間があった！】"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "【出口にそんな時間はなかった！】"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "たしかにボクたちはずっといっしょにいたんだ。"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "つまり、『光線銃』なんて\n発射できるワケないんだ‥‥"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "となると‥‥"},
{"id": 254, "speaker": 2, "form": "dlg", "jp": "入ってきた時間ではなく、"},
{"id": 255, "speaker": 2, "form": "dlg", "jp": "【出口にはその時間があった！】"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "たしか‥‥"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "ボクには『悲鳴』なんて聞こえなくて\n出口が先にあっちの部屋をのぞいたんだ‥‥"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "つまり、そのときに\n『光線銃』で撃つことはできたんだ‥‥"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥！"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "そうか！"},
{"id": 261, "speaker": 2, "form": "dlg", "jp": "出口なら、『メモ』を置くことだって！！"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "まさか！！"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "「出口‥‥」"},
{"id": 264, "speaker": 50, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "やっぱ、言いにくいよな‥‥"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "でも、言わなくちゃっ！"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "「もしかしたら、キミが‥‥」"},
{"id": 269, "speaker": 50, "form": "dlg", "jp": "「何が？」"},
{"id": 270, "speaker": 2, "form": "dlg", "jp": "「キミが犯人なのか？」"},
{"id": 271, "speaker": 50, "form": "dlg", "jp": "「何言ってんだよ」"},
{"id": 272, "speaker": 21, "form": "dlg", "jp": "「ちょっと、どう言うこと？」"},
{"id": 273, "speaker": 21, "form": "dlg", "jp": "ボクは自分の推理を打ち明けた。"},
{"id": 274, "speaker": 21, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 275, "speaker": 21, "form": "dlg", "jp": "「ある程度、スジは通ってるわね‥‥」"},
{"id": 276, "speaker": 50, "form": "dlg", "jp": "「ちょっと待てよ‥‥」"},
{"id": 277, "speaker": 50, "form": "dlg", "jp": "「ボクは『光線銃』なんて持ってないだろう？」"},
{"id": 278, "speaker": 11, "form": "dlg", "jp": "「たしかに‥‥」"},
{"id": 279, "speaker": 11, "form": "dlg", "jp": "そ、そうなんだ‥‥"},
{"id": 280, "speaker": 11, "form": "dlg", "jp": "問題はそこなんだ‥‥"},
{"id": 281, "speaker": 11, "form": "dlg", "jp": "出口がこの部屋に来た時は手ぶらだったし、"},
{"id": 282, "speaker": 11, "form": "dlg", "jp": "さっきの取り調べの時も\n何も持ってなかったんだ‥‥"},
{"id": 283, "speaker": 11, "form": "dlg", "jp": "もし、出口が犯人ならどこかに\n隠してることになる‥‥"},
{"id": 284, "speaker": 11, "form": "dlg", "jp": "いったいどこに？"},
{"id": 285, "speaker": 11, "form": "choice", "jp": "【たぶん、それはありえない！‥‥】"},
{"id": 286, "speaker": 11, "form": "choice", "jp": "【そうだ、隠してるんだ！】"},
{"id": 287, "speaker": 11, "form": "dlg", "jp": "【たぶん、それはありえない！‥‥】"},
{"id": 288, "speaker": 11, "form": "dlg", "jp": "たしかにボクたちはずっといっしょにいたんだ。"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "「じょ、冗談だよ‥‥」"},
{"id": 290, "speaker": 50, "form": "dlg", "jp": "「オイ、冗談にしてはタチが悪すぎるよぉ」"},
{"id": 291, "speaker": 2, "form": "dlg", "jp": "「ゴメン、ゴメン」"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "となると‥‥"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "入ってきた時間ではなく‥‥"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "【そうだ、隠してるんだ！】"},
{"id": 295, "speaker": 2, "form": "dlg", "jp": "「隠してるんだろう？」"},
{"id": 296, "speaker": 50, "form": "dlg", "jp": "「オイ、オイ‥‥」"},
{"id": 297, "speaker": 50, "form": "dlg", "jp": "「この部屋もさっき調べられたじゃないか‥‥」"},
{"id": 298, "speaker": 50, "form": "dlg", "jp": "「それにボクがこの部屋を出てないのは\n　キミが知ってるハズだろう？」"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 300, "speaker": 21, "form": "dlg", "jp": "「そんなに言うのなら、\n　その隠し場所はわかるの？」"},
{"id": 301, "speaker": 21, "form": "dlg", "jp": "隠し場所‥‥"},
{"id": 302, "speaker": 21, "form": "dlg", "jp": "出口が『隠してる所』‥‥"},
{"id": 303, "speaker": 21, "form": "choice", "jp": "【きっとアソコだ！！】"},
{"id": 304, "speaker": 21, "form": "choice", "jp": "【そこまではわからない！】"},
{"id": 305, "speaker": 21, "form": "dlg", "jp": "【そこまではわからない！】"},
{"id": 306, "speaker": 21, "form": "dlg", "jp": "これ以上、出口のことを疑うのはよくないな‥‥"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "「わかりません‥‥」"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "「って、言うか、冗談のつもりで‥‥」"},
{"id": 309, "speaker": 50, "form": "dlg", "jp": "「オイ、冗談にしてはタチが悪すぎるよぉ」"},
{"id": 310, "speaker": 2, "form": "dlg", "jp": "「ゴメン、ゴメン‥‥」"},
{"id": 311, "speaker": 2, "form": "dlg", "jp": "しまった！"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "たぶん、出口のヤツ、\n気を悪くしてるよな‥‥"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "となると‥‥"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "入ってきた時間ではなく‥‥"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "【きっとアソコだ！！】"},
{"id": 316, "speaker": 2, "form": "dlg", "jp": "「わかります！」"},
{"id": 317, "speaker": 50, "form": "dlg", "jp": "「オイ、冗談にしてはタチが悪すぎるよぉ」"},
{"id": 318, "speaker": 2, "form": "dlg", "jp": "「冗談じゃない！」"},
{"id": 319, "speaker": 2, "form": "dlg", "jp": "「ボクには目星がついてるんだ！」"},
{"id": 320, "speaker": 21, "form": "dlg", "jp": "「じゃあ、どこなの？」"},
{"id": 321, "speaker": 21, "form": "dlg", "jp": "「それを教えてもらえる？」"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "「わかりました！」"},
{"id": 323, "speaker": 21, "form": "dlg", "jp": "「本当にそんなところにかくしてると思う？」"},
{"id": 324, "speaker": 2, "form": "dlg", "jp": "「そんなわけないですよね‥‥」"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "ダメだ‥‥"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "出口が犯人だって証拠なんてないじゃないか‥‥"},
{"id": 327, "speaker": 21, "form": "dlg", "jp": "「キミたちは仲が悪いの？」"},
{"id": 328, "speaker": 2, "form": "dlg", "jp": "「そ、そういうわけじゃぁ‥‥」"},
{"id": 329, "speaker": 2, "form": "dlg", "jp": "出口が悲しい顔でコッチを見てる‥‥"},
{"id": 330, "speaker": 2, "form": "dlg", "jp": "どうにかしてゴマかさないと‥‥"},
{"id": 331, "speaker": 50, "form": "dlg", "jp": "「もしかしたら、冗談のつもり？」"},
{"id": 332, "speaker": 50, "form": "dlg", "jp": "‥‥‥！？"},
{"id": 333, "speaker": 50, "form": "dlg", "jp": "それだっ！！"},
{"id": 334, "speaker": 2, "form": "dlg", "jp": "「そ、そうなんです‥‥」"},
{"id": 335, "speaker": 2, "form": "dlg", "jp": "「あんまり、空気が重たかったから‥‥」"},
{"id": 336, "speaker": 50, "form": "dlg", "jp": "「オイ、冗談にしてはタチが悪すぎるよぉ」"},
{"id": 337, "speaker": 2, "form": "dlg", "jp": "「ゴメン、ゴメン‥‥」"},
{"id": 338, "speaker": 2, "form": "dlg", "jp": "しまった！"},
{"id": 339, "speaker": 2, "form": "dlg", "jp": "たぶん、出口のヤツ、\n気を悪くしてるよな‥‥"},
{"id": 340, "speaker": 2, "form": "dlg", "jp": "どうにかして、ごまかさないと気マズイな‥‥"},
{"id": 341, "speaker": 2, "form": "dlg", "jp": "ちゃんと『真犯人』をみつけないと‥‥"},
{"id": 342, "speaker": 2, "form": "dlg", "jp": "とにかく、\n犯人が入ってきた時間が関係ないとすると‥‥"},
{"id": 343, "speaker": 21, "form": "dlg", "jp": "「『眼帯』の中‥‥？」"},
{"id": 344, "speaker": 11, "form": "dlg", "jp": "「オイオイ、いくら『光線銃』でも\n　そんな小さな場所にはかくせないだろう‥‥」"},
{"id": 345, "speaker": 2, "form": "dlg", "jp": "「たしかに、\n　『銃』を隠すことはできないでしょう‥‥」"},
{"id": 346, "speaker": 2, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 347, "speaker": 2, "form": "dlg", "jp": "「『ルード』の刺客なら‥‥」"},
{"id": 348, "speaker": 11, "form": "dlg", "jp": "「『ルードの刺客』？」"},
{"id": 349, "speaker": 2, "form": "dlg", "jp": "「警部、『ルード』と言えば？」"},
{"id": 350, "speaker": 11, "form": "dlg", "jp": "「武器密売組織‥‥ペルー‥‥サイボーグ‥‥」"},
{"id": 351, "speaker": 21, "form": "dlg", "jp": "「もしかして！！」"},
{"id": 352, "speaker": 21, "form": "dlg", "jp": "「『サイボーグ』！？」"},
{"id": 353, "speaker": 2, "form": "dlg", "jp": "「そうです‥‥」"},
{"id": 354, "speaker": 2, "form": "dlg", "jp": "「出口が『サイボーグ』だとすれば、\n　すべての謎がとけるんです！」"},
{"id": 355, "speaker": 2, "form": "dlg", "jp": "「刑事さんたちが死んでるのが確認されたのは\n　出口があちらの部屋をのぞいた後‥‥」"},
{"id": 356, "speaker": 2, "form": "dlg", "jp": "「つまり、出口はあちらの部屋をのぞいた時に\n　『光線銃』を発射したんです」"},
{"id": 357, "speaker": 50, "form": "dlg", "jp": "「ちょっと待ってくれ！」"},
{"id": 358, "speaker": 50, "form": "dlg", "jp": "「ボクがあっちの部屋をのぞいたのは\n　『悲鳴』が聞こえたから‥‥」"},
{"id": 359, "speaker": 2, "form": "dlg", "jp": "「それがウソなんだ！」"},
{"id": 360, "speaker": 2, "form": "dlg", "jp": "「実際、ボクは『悲鳴』なんて聞いていない！」"},
{"id": 361, "speaker": 2, "form": "dlg", "jp": "「それに、キミならこの部屋に\n　『メモ』を置くのも簡単にできたハズだ！」"},
{"id": 362, "speaker": 50, "form": "dlg", "jp": "「‥‥‥‥‥」"},
{"id": 363, "speaker": 50, "form": "dlg", "jp": "「じゃあ、キミはボクが『サイボーグ』だと‥‥」"},
{"id": 364, "speaker": 2, "form": "dlg", "jp": "「わるいけど、そうとしか考えられない‥‥」"},
{"id": 365, "speaker": 50, "form": "dlg", "jp": "「冗談はよしてくれよ‥‥」"},
{"id": 366, "speaker": 2, "form": "dlg", "jp": "「冗談かどうかは、\n　その眼帯をはずせば簡単に答えがでるだろう‥‥」"},
{"id": 367, "speaker": 21, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 368, "speaker": 21, "form": "dlg", "jp": "「とにかく、その眼帯を外してもらえる？」"},
{"id": 369, "speaker": 50, "form": "dlg", "jp": "「‥‥‥‥‥」"},
{"id": 370, "speaker": 21, "form": "dlg", "jp": "「さぁ！」"},
{"id": 371, "speaker": 50, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥」"},
{"id": 372, "speaker": 50, "form": "dlg", "jp": "「フフッ‥‥‥」"},
{"id": 373, "speaker": 50, "form": "dlg", "jp": "「アッハハハハハ‥‥‥‥‥」"},
{"id": 374, "speaker": 50, "form": "dlg", "jp": "「スゴイぞ常光寺ナゴム！！」"},
{"id": 375, "speaker": 11, "form": "dlg", "jp": "「おおっ‥‥！」"},
{"id": 376, "speaker": 50, "form": "dlg", "jp": "「もう少しじわじわ追い込んでやろうと思ったのに‥‥」"},
{"id": 377, "speaker": 21, "form": "dlg", "jp": "「なんてコなの！」"},
{"id": 378, "speaker": 50, "form": "dlg", "jp": "「おっと、近寄るなっ！」"},
{"id": 379, "speaker": 50, "form": "dlg", "jp": "「今、名探偵の説明を聞いただろう？」"},
{"id": 380, "speaker": 50, "form": "dlg", "jp": "「オレの目は『光線銃』なんだぜ‥‥」"},
{"id": 381, "speaker": 2, "form": "dlg", "jp": "「出口‥‥」"},
{"id": 382, "speaker": 50, "form": "dlg", "jp": "「フフフフフ‥‥」"},
{"id": 383, "speaker": 50, "form": "dlg", "jp": "「今のはデモンストレーションだ‥‥」"},
{"id": 384, "speaker": 50, "form": "dlg", "jp": "「大人しくしないと、\n　あの刑事さんたちみたいになるぜ‥‥」"},
{"id": 385, "speaker": 11, "form": "dlg", "jp": "「オノレー‥‥」"},
{"id": 386, "speaker": 50, "form": "dlg", "jp": "「じゃぁ、オレはいったんテッタイさせてもらうよ‥‥」"},
{"id": 387, "speaker": 50, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 388, "speaker": 21, "form": "dlg", "jp": "「待ちなさいっ！」"},
{"id": 389, "speaker": 21, "form": "dlg", "jp": "そして！"},
{"id": 390, "speaker": 50, "form": "dlg", "jp": "「ウギャ～～！！」"},
{"id": 391, "speaker": 11, "form": "dlg", "jp": "「なんだ！？」"},
{"id": 392, "speaker": 11, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 393, "speaker": 11, "form": "dlg", "jp": "なんで！？"},
{"id": 394, "speaker": 11, "form": "dlg", "jp": "そこには血まみれになった出口が倒れていた‥‥"},
{"id": 395, "speaker": 22, "form": "dlg", "jp": "「し、死んでます‥‥」"},
{"id": 396, "speaker": 22, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 397, "speaker": 11, "form": "dlg", "jp": "「何っ！？」"},
{"id": 398, "speaker": 11, "form": "dlg", "jp": "足音の方を見ると、\n長いコート姿の人影が立ち去って行くのが見えた。"},
{"id": 399, "speaker": 11, "form": "dlg", "jp": "「追えっ、追うんだ！」"},
{"id": 400, "speaker": 21, "form": "dlg", "jp": "「『カマキリ』ね‥‥」"},
{"id": 401, "speaker": 2, "form": "dlg", "jp": "「『カマキリ』？」"},
{"id": 402, "speaker": 21, "form": "dlg", "jp": "「『カマキリジャック』‥‥」"},
{"id": 403, "speaker": 21, "form": "dlg", "jp": "「『ルード』のサイコな殺し屋‥‥」"},
{"id": 404, "speaker": 21, "form": "dlg", "jp": "「刀で人を斬り付けるのが趣味の『変質者』よ！」"},
{"id": 405, "speaker": 21, "form": "dlg", "jp": "「ウワサでは\n　最近サイボーグ手術を受けたって‥‥」"},
{"id": 406, "speaker": 11, "form": "dlg", "jp": "「なんで、『ルード』の殺し屋が‥‥」"},
{"id": 407, "speaker": 11, "form": "dlg", "jp": "「仲間われですか？」"},
{"id": 408, "speaker": 21, "form": "dlg", "jp": "「『口封じ』ね‥‥」"},
{"id": 409, "speaker": 11, "form": "dlg", "jp": "「『口封じ』‥‥？」"},
{"id": 410, "speaker": 21, "form": "dlg", "jp": "「もしくは『見せしめ』‥‥」"},
{"id": 411, "speaker": 21, "form": "dlg", "jp": "「作戦に失敗した『工作員』はこうなるという‥‥」"},
{"id": 412, "speaker": 2, "form": "dlg", "jp": "「そんな‥‥」"},
{"id": 413, "speaker": 21, "form": "dlg", "jp": "「とにかく、このホテルにルードの連中が\n　入り込んでいるのは間違いないわ！」"},
{"id": 414, "speaker": 21, "form": "dlg", "jp": "「アキヤマッ！」"},
{"id": 415, "speaker": 22, "form": "dlg", "jp": "「ハッ！」"},
{"id": 416, "speaker": 21, "form": "dlg", "jp": "「館内の人間全員をチェックして！」"},
{"id": 417, "speaker": 22, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 418, "speaker": 11, "form": "dlg", "jp": "「とりあえず、こんな事件のあった部屋に\n　泊まってもらうわけにはいかないんで」"},
{"id": 419, "speaker": 11, "form": "dlg", "jp": "「別の部屋を用意しよう！」"},
{"id": 420, "speaker": 11, "form": "dlg", "jp": "「それから、リツコさんにも安全のため\n　すぐに帰ってきてもらうことにする」"},
{"id": 421, "speaker": 11, "form": "dlg", "jp": "「オマエたちは、全室くまなくチェックして、\n　『カマキリ』を捜し出すんだ！！」"},
{"id": 422, "speaker": 20, "form": "dlg", "jp": "「はいっ！」"},
{"id": 423, "speaker": 20, "form": "dlg", "jp": "こうして、\nボクたちは別の部屋にうつされることになった。"},
{"id": 424, "speaker": 20, "form": "dlg", "jp": "失敗の原因は記憶力または推理力不足。\n冷静に考えれば犯人がわかるハズ‥‥"}
]
