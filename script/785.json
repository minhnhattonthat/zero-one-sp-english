{"id": 16, "speaker": 2, "form": "dlg", "jp": "「いったいどうしたの？」"},
{"id": 17, "speaker": 29, "form": "dlg", "jp": "「説明してあげるから、\n　大きな声をださないで‥‥」"},
{"id": 18, "speaker": 29, "form": "dlg", "jp": "「お家の人に聞こえるでしょう！」"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "「とりあえず、今からは\n　『テレパシー』で会話するからね‥‥」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "（まず、私たちが、何しに来たかというと、\n　夕方の続きを説明しに来たの‥‥）"},
{"id": 22, "speaker": 29, "form": "dlg", "jp": "（多分、キミは今の時点では、私たちのことを\n　なにも理解できてないでしょうから‥‥）"},
{"id": 23, "speaker": 29, "form": "dlg", "jp": "（そうなんでしょう？）"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 25, "speaker": 29, "form": "dlg", "jp": "（だから、今から説明してあげる‥‥）"},
{"id": 26, "speaker": 29, "form": "dlg", "jp": "（長い話だけど大丈夫？？）"},
{"id": 27, "speaker": 29, "form": "choice", "jp": "（ああ、わかった！）"},
{"id": 28, "speaker": 29, "form": "choice", "jp": "（手短にお願いします）"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "（ああ、わかった！）"},
{"id": 30, "speaker": 29, "form": "dlg", "jp": "（詳しく説明すると本当に長くなるわよ‥‥）"},
{"id": 31, "speaker": 29, "form": "choice", "jp": "（詳しく教えてくれ！）"},
{"id": 32, "speaker": 29, "form": "choice", "jp": "（簡単にでいいよ‥‥）"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "（詳しく教えてくれ！）"},
{"id": 34, "speaker": 29, "form": "dlg", "jp": "（わかったわ‥‥）"},
{"id": 35, "speaker": 29, "form": "dlg", "jp": "（じゃあ、長くなるけど覚悟してね‥‥）"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "（簡単にでいいよ‥‥）"},
{"id": 37, "speaker": 29, "form": "dlg", "jp": "（わかったわ‥‥）"},
{"id": 38, "speaker": 29, "form": "dlg", "jp": "（それでもちょっと長い話だから頑張ってね‥）"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "（手短にお願いします）"},
{"id": 40, "speaker": 29, "form": "dlg", "jp": "（詳しい説明はいいのね？）"},
{"id": 41, "speaker": 29, "form": "choice", "jp": "（詳しく教えてくれ！）"},
{"id": 42, "speaker": 29, "form": "choice", "jp": "（簡単にでいいよ‥‥）"},
{"id": 43, "speaker": 2, "form": "dlg", "jp": "（詳しく教えてくれ！）"},
{"id": 44, "speaker": 29, "form": "dlg", "jp": "（わかったわ‥‥）"},
{"id": 45, "speaker": 29, "form": "dlg", "jp": "（じゃあ、長くなるけど覚悟してね‥‥）"},
{"id": 46, "speaker": 29, "form": "dlg", "jp": "（私たちは、\n　他の人たちが持っていない能力を持っているの）"},
{"id": 47, "speaker": 29, "form": "dlg", "jp": "（それはわかるわね？）"},
{"id": 48, "speaker": 29, "form": "dlg", "jp": "（じゃあ、私たちと、\n　それ以外の人たちでどっちが強いと思う？）"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "（そりゃぁ、ボクたちの方が‥‥）"},
{"id": 50, "speaker": 29, "form": "dlg", "jp": "（じゃあ、強いモノが\n　弱いモノを守ってあげなくちゃって考え方は？）"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "（理解できるよ‥‥）"},
{"id": 52, "speaker": 29, "form": "dlg", "jp": "（ただ、それだけのことよ‥‥）"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "（それじゃ、全然わかんないよ！）"},
{"id": 54, "speaker": 2, "form": "choice", "jp": "（いったい何から守るんだよ？）"},
{"id": 55, "speaker": 2, "form": "choice", "jp": "（『この世』を守るってどういう意味？）"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "（いったい何から守るんだよ？）"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "（"},
{"id": 58, "speaker": 29, "form": "dlg", "jp": "『ゲーマー』"},
{"id": 59, "speaker": 29, "form": "dlg", "jp": "だって言ったでしょう？）"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "（『この世』を守るってどういう意味？）"},
{"id": 61, "speaker": 29, "form": "dlg", "jp": "（"},
{"id": 62, "speaker": 29, "form": "dlg", "jp": "『ゲーマー』の攻撃から世界を守る"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "って意味よ！）"},
{"id": 64, "speaker": 29, "form": "choice", "jp": "（『ゲーマー』って何なんだよ！！）"},
{"id": 65, "speaker": 29, "form": "choice", "jp": "（なんで『ゲーマー』が襲ってくるんだよ！）"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "（『ゲーマー』って何なんだよ！！）"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "（『ゲーム』を楽しむ人ね‥‥）"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "（なんで『ゲーマー』が襲ってくるんだよ！）"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "（世界を破壊するのが『ゲーマー』の楽しみだから‥‥）"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "（でも、『ゲーム』の話なんだろう？）"},
{"id": 71, "speaker": 2, "form": "choice", "jp": "（そんなヤツ、いちいち相手しなくても‥‥）"},
{"id": 72, "speaker": 2, "form": "choice", "jp": "（そんなヤツに何ができるんだよ！？）"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "（そんなヤツ、いちいち相手しなくても‥‥）"},
{"id": 74, "speaker": 29, "form": "dlg", "jp": "（そうはいかないわ‥‥）"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "（そんなヤツに何ができるんだよ！？）"},
{"id": 76, "speaker": 29, "form": "dlg", "jp": "（ナゴムが思っている何倍もスゴイことよ！）"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "（彼等の"},
{"id": 78, "speaker": 29, "form": "dlg", "jp": "『ゲームのターゲット』"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "は\n　"},
{"id": 80, "speaker": 29, "form": "dlg", "jp": "『この世界』"},
{"id": 81, "speaker": 29, "form": "dlg", "jp": "なんだから‥‥）"},
{"id": 82, "speaker": 2, "form": "dlg", "jp": "（はぁ？）"},
{"id": 83, "speaker": 2, "form": "choice", "jp": "（どんな『ゲーム』？？）"},
{"id": 84, "speaker": 2, "form": "choice", "jp": "（それって『ゲーム』？？）"},
{"id": 85, "speaker": 2, "form": "dlg", "jp": "（どんな『ゲーム』？？）"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "（それって『ゲーム』？？）"},
{"id": 87, "speaker": 29, "form": "dlg", "jp": "（『ゲーム』っていっても、\n　『テレビゲーム』とかじゃないわよ‥‥）"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "（‥‥‥‥）"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "（そうね‥‥）"},
{"id": 90, "speaker": 29, "form": "dlg", "jp": "（『バス釣り』みたいなものね‥‥）"},
{"id": 91, "speaker": 29, "form": "dlg", "jp": "（『バス釣り』って、不思議な『ゲーム』でしょう？）"},
{"id": 92, "speaker": 29, "form": "dlg", "jp": "（生きている動物を釣り上げるだけで、\n　食べるワケでもないんだから‥‥）"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "（だから？）"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "（それと同じように、\n　"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "『意味もなく世界を破滅させるゲーム』"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "よ‥‥）"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "（『意味もなく世界を破滅させる』？）"},
{"id": 98, "speaker": 2, "form": "choice", "jp": "（そんなことできるワケないだろう？）"},
{"id": 99, "speaker": 2, "form": "choice", "jp": "（『ゲーマー』って『軍人』？）"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "（そんなことできるワケないだろう？）"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "（『ゲーマー』って『軍人』？）"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "（ゴメン、ちゃんと説明してなかったわね‥‥）"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』って"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "『普通の人間じゃない』"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "から‥‥）"},
{"id": 106, "speaker": 29, "form": "choice", "jp": "（じゃあ『超能力者』？）"},
{"id": 107, "speaker": 29, "form": "choice", "jp": "（まさか『サイボーグ』？）"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "（じゃあ『超能力者』？）"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "（まさか『サイボーグ』？）"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "（いいえ、違うわ‥‥）"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "（じゃあ、なんなんだよ‥‥）"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "（私たちとは文字どおり\n　"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "『次元の違う存在』"},
{"id": 114, "speaker": 29, "form": "dlg", "jp": "ね‥‥）"},
{"id": 115, "speaker": 31, "form": "dlg", "jp": "（わかりやすく説明するとだな‥‥）"},
{"id": 116, "speaker": 31, "form": "dlg", "jp": "（この世界を\n　『テレビゲームの中の世界』だと考えるんだ‥‥）"},
{"id": 117, "speaker": 31, "form": "dlg", "jp": "（そして、オレたちはその中にいる『キャラクター』だ‥‥）"},
{"id": 118, "speaker": 31, "form": "dlg", "jp": "（その『キャラクター』を、『ゲーマー』が\n　殺したり、街を破壊したりするって感じだ‥‥）"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "（どうしてそんなことを？）"},
{"id": 120, "speaker": 31, "form": "dlg", "jp": "（君は『ゲーム』の中の『キャラクター』を\n　殺した事は無いか？）"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "（‥‥‥）"},
{"id": 122, "speaker": 31, "form": "dlg", "jp": "（それにマトモな『意味』や『理由』はあるか？）"},
{"id": 123, "speaker": 31, "form": "dlg", "jp": "（ないだろう？）"},
{"id": 124, "speaker": 31, "form": "dlg", "jp": "（ただ、『カタルシス』を感じたいだけで、\n　平気で『キャラクター』を殺す‥‥）"},
{"id": 125, "speaker": 31, "form": "dlg", "jp": "（ヤツらも同じことさ‥‥）"},
{"id": 126, "speaker": 31, "form": "choice", "jp": "（『警察』に通報すれば？）"},
{"id": 127, "speaker": 31, "form": "choice", "jp": "（『軍隊』にまかせれば‥‥？）"},
{"id": 128, "speaker": 2, "form": "dlg", "jp": "（『警察』に通報すれば？）"},
{"id": 129, "speaker": 29, "form": "dlg", "jp": "（まだ、わかってないようね\n　相手は"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "『次元の違う存在』"},
{"id": 131, "speaker": 29, "form": "dlg", "jp": "なの‥‥）"},
{"id": 132, "speaker": 29, "form": "dlg", "jp": "（『警察』なんかがどうにかできる相手じゃないわ！）"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "（『軍隊』にまかせれば‥‥？）"},
{"id": 134, "speaker": 29, "form": "dlg", "jp": "（まだ、わかってないようね\n　相手は"},
{"id": 135, "speaker": 29, "form": "dlg", "jp": "『次元の違う存在』"},
{"id": 136, "speaker": 29, "form": "dlg", "jp": "なの‥‥）"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "（『軍隊』なんかがどうにかできる相手じゃないわ！）"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "（私たちの住んでいる世界や、\n　時間の外側にいる連中なの‥‥）"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "（それが、よくわからないんだよ！）"},
{"id": 140, "speaker": 29, "form": "dlg", "jp": "（まあ、簡単に言えば"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "『神』に近い存在ね‥‥）"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "（『神』！？）"},
{"id": 143, "speaker": 29, "form": "dlg", "jp": "（ええ‥‥）"},
{"id": 144, "speaker": 29, "form": "dlg", "jp": "（だから、彼等の攻撃は、\n　よく『神の仕業』と間違えられるの‥‥）"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "（『神の仕業』！？）"},
{"id": 146, "speaker": 29, "form": "dlg", "jp": "（『ノアの大洪水』とか、\n"},
{"id": 147, "speaker": 29, "form": "dlg", "jp": "　『アトランティスの水没』とか‥‥）"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "（それって、『天変地異』じゃぁ？）"},
{"id": 149, "speaker": 29, "form": "dlg", "jp": "（そう、彼らの『攻撃』は\n　『天変地異』のレベルのものなの‥‥）"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "（だから、『警察』や『軍隊』では\n　どうすることもできないの‥‥）"},
{"id": 151, "speaker": 29, "form": "choice", "jp": "（そんなの相手じゃボクたちだって‥‥？）"},
{"id": 152, "speaker": 29, "form": "choice", "jp": "（そんなのとどうやって戦うつもりなの？）"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "（そんなの相手じゃボクたちだって‥‥）"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "（そんなのとどうやって戦うつもりなの？）"},
{"id": 155, "speaker": 29, "form": "dlg", "jp": "（そうね‥‥）"},
{"id": 156, "speaker": 29, "form": "dlg", "jp": "（いきなり、大陸を沈められたりしたら、\n　私たちでもどうすることもできないわね‥‥）"},
{"id": 157, "speaker": 2, "form": "dlg", "jp": "（じゃぁ、どうして？）"},
{"id": 158, "speaker": 29, "form": "dlg", "jp": "（"},
{"id": 159, "speaker": 29, "form": "dlg", "jp": "『ルール』"},
{"id": 160, "speaker": 29, "form": "dlg", "jp": "があるの‥‥）"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "（『ルール』？）"},
{"id": 162, "speaker": 29, "form": "dlg", "jp": "（彼等の目的は『楽しむこと』‥‥\n　つまり『楽しみ』が薄れるようなことはしないの）"},
{"id": 163, "speaker": 29, "form": "dlg", "jp": "（そして、もう１つの大きなルールが\n　彼等の『力』は『人間』には通用しない‥‥）"},
{"id": 164, "speaker": 29, "form": "choice", "jp": "（彼等の『力』？）"},
{"id": 165, "speaker": 29, "form": "choice", "jp": "（『人間』には通用しない？）"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "（彼等の『力』？）"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "（『人間』には通用しない？）"},
{"id": 168, "speaker": 29, "form": "dlg", "jp": "（彼等は"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "『人間以外のあらゆるモノ』を\n　自由に操ることができる"},
{"id": 170, "speaker": 29, "form": "dlg", "jp": "の‥‥）"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "（『人間以外のモノ』を操る？）"},
{"id": 172, "speaker": 29, "form": "dlg", "jp": "（そう、『洪水』だって、『核兵器』だって\n　なんだってよ！）"},
{"id": 173, "speaker": 29, "form": "dlg", "jp": "（だから彼等には『銃』も『核兵器』も通用しない！）"},
{"id": 174, "speaker": 29, "form": "dlg", "jp": "（でも、逆に言えば、\n　『人間』が殴りつけることはできるの‥‥）"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "（つまり、彼等と戦うには『人間』でありながら、\n　『人間以上の存在』でないといけないの‥‥）"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "（だから、ボクたちが戦うってこと？）"},
{"id": 177, "speaker": 29, "form": "dlg", "jp": "（そういうことよ‥‥）"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "（その『ゲーマー』って何人ぐらいいるの？）"},
{"id": 179, "speaker": 29, "form": "dlg", "jp": "（わからないわ‥‥）"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "（わからないって‥‥！！）"},
{"id": 181, "speaker": 29, "form": "dlg", "jp": "（彼等は私たちと違う時間に生きているの‥‥）"},
{"id": 182, "speaker": 29, "form": "dlg", "jp": "（だから、彼等の『ゲーム』は\n　私たちの時間では千年ほどの周期で行われるから）"},
{"id": 183, "speaker": 29, "form": "dlg", "jp": "（人間で、彼等を見たモノは\n　誰も生き残ってないの‥‥）"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "（それじゃぁ、どうして\n　『ゲーマー』のことなんてわかったんだよ？）"},
{"id": 185, "speaker": 29, "form": "dlg", "jp": "（私たちには"},
{"id": 186, "speaker": 29, "form": "dlg", "jp": "『アカシックレコード』"},
{"id": 187, "speaker": 29, "form": "dlg", "jp": "っていう\n　歴史の記憶を読み取ることができる『石』があるの‥‥）"},
{"id": 188, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』についての情報は\n　すべて、その『アカシックレコード』から得たものなの）"},
{"id": 189, "speaker": 29, "form": "choice", "jp": "（ふ～ん）"},
{"id": 190, "speaker": 29, "form": "choice", "jp": "（信用できるのかい、それ？）"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "（ふ～ん）"},
{"id": 192, "speaker": 2, "form": "dlg", "jp": "（信用できるのかい、それ？）"},
{"id": 193, "speaker": 29, "form": "dlg", "jp": "（『アカシックレコード』は真実しか語らないのよ‥‥）"},
{"id": 194, "speaker": 29, "form": "dlg", "jp": "（どう？　少しは理解できた？）"},
{"id": 195, "speaker": 29, "form": "choice", "jp": "（だいたい、理解できたケド‥‥）"},
{"id": 196, "speaker": 29, "form": "choice", "jp": "（気になることがある‥‥）"},
{"id": 197, "speaker": 2, "form": "dlg", "jp": "（だいたい、理解できたケド‥‥）"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "（気になることがある‥‥）"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "（そんなに『力』があるヤツが、何度も襲って来ているのに\n　どうして人間は今でも生き延びているんだ？）"},
{"id": 200, "speaker": 29, "form": "dlg", "jp": "（彼等の目的が『人間を滅ぼす』ことではなく、\n　ただ、『人間を苦しめたいだけ』だからよ‥‥）"},
{"id": 201, "speaker": 29, "form": "dlg", "jp": "（世界をボロボロにして、人間のほとんどを\n　殺してしまうけど、決して全滅はさせない‥‥）"},
{"id": 202, "speaker": 29, "form": "dlg", "jp": "（わずかな人間を生き残らせ、\n　再び人間が増えるのを待つの‥‥）"},
{"id": 203, "speaker": 29, "form": "dlg", "jp": "（そして、人間が十分に増え、\n　力を付けた時にまた『ゲーム』を楽しむの‥‥）"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "（ヒドイ‥‥）"},
{"id": 205, "speaker": 29, "form": "dlg", "jp": "（だから、私たちが戦わなくちゃいけないの！）"},
{"id": 206, "speaker": 29, "form": "dlg", "jp": "（現時点で世界中に『３００人』近くの\n　『ホンモノの超能力者』が確認されているから‥‥）"},
{"id": 207, "speaker": 29, "form": "dlg", "jp": "（その全員が１つにまとまることができれば、）"},
{"id": 208, "speaker": 29, "form": "dlg", "jp": "（もしかしたら、\n　『ゲーマー』を倒せるかもしれないでしょう？）"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "（わかったよ！）"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "（で、決戦はいつに？）"},
{"id": 211, "speaker": 29, "form": "dlg", "jp": "（正確な日時はわからないの‥‥）"},
{"id": 212, "speaker": 29, "form": "dlg", "jp": "（でも、もうあまり時間がないことは\n　間違いないわね‥‥）"},
{"id": 213, "speaker": 29, "form": "dlg", "jp": "（もしかしたら、もう『ゲーマー』の攻撃は\n　徐々に始まっているかも‥‥）"},
{"id": 214, "speaker": 2, "form": "dlg", "jp": "（どういうこと？）"},
{"id": 215, "speaker": 29, "form": "dlg", "jp": "（私が気になってるのは最近、世界中で\n　"},
{"id": 216, "speaker": 29, "form": "dlg", "jp": "『機械の誤作動による事故』"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "が増えていること‥‥）"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "（それがどうかしたの？）"},
{"id": 219, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』の能力を忘れたの？）"},
{"id": 220, "speaker": 29, "form": "dlg", "jp": "（彼等は『人間以外のあらゆるものを\n　自由に操ることができる』のよ‥‥）"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "（つまり、\n　『機械を操って事故を起こしている』ってこと？）"},
{"id": 222, "speaker": 29, "form": "dlg", "jp": "（そういう可能性もあるんじゃないかしら‥‥）"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "（ボクたちはいったいどうすればいいんだい？）"},
{"id": 224, "speaker": 29, "form": "dlg", "jp": "（とりあえず、仲間を集めることが先決ね！）"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "（仲間？）"},
{"id": 226, "speaker": 31, "form": "dlg", "jp": "（そのためにオレたちは日本に来てるんだ！）"},
{"id": 227, "speaker": 31, "form": "dlg", "jp": "（『ジーンの能力』でこの国には　君をいれて\n　"},
{"id": 228, "speaker": 31, "form": "dlg", "jp": "『５人』の超能力者"},
{"id": 229, "speaker": 31, "form": "dlg", "jp": "がいるってことはわかっている）"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "（じゃあ、あと４人‥‥？）"},
{"id": 231, "speaker": 29, "form": "dlg", "jp": "（ええ‥‥）"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "（その人たちはどこに‥‥？）"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "（心配しないで、\n　『超能力者』は"},
{"id": 234, "speaker": 29, "form": "dlg", "jp": "お互いひかれあう"},
{"id": 235, "speaker": 29, "form": "dlg", "jp": "ものなの‥‥）"},
{"id": 236, "speaker": 29, "form": "dlg", "jp": "（だから、探していれば\n　きっと簡単に出会えるハズ‥‥）"},
{"id": 237, "speaker": 29, "form": "dlg", "jp": "（キミと私が出会えたように‥‥）"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "（じゃあ、すぐに仲間は集められそうだね？）"},
{"id": 239, "speaker": 29, "form": "dlg", "jp": "（そうだといいんだけど‥‥）"},
{"id": 240, "speaker": 2, "form": "dlg", "jp": "（どういうこと？）"},
{"id": 241, "speaker": 31, "form": "dlg", "jp": "（見つけるのは簡単だけど、\n　仲間にするのは難しいってことだよ‥‥）"},
{"id": 242, "speaker": 31, "form": "dlg", "jp": "（まあ、\n　君はすんなり仲間になるって言ってくれたけど‥‥）"},
{"id": 243, "speaker": 31, "form": "dlg", "jp": "（全員がそうだとはかぎらない‥‥）"},
{"id": 244, "speaker": 31, "form": "dlg", "jp": "（例えば、\n　君が『ジーン』の能力をもってたらどうだろう？）"},
{"id": 245, "speaker": 31, "form": "dlg", "jp": "（遠くのものが簡単に見えてしまう能力だ‥‥）"},
{"id": 246, "speaker": 31, "form": "dlg", "jp": "（きっと、悪用したくなるだろうし、その能力を\n　他人のために使おうなんて思わないんじゃないかな？）"},
{"id": 247, "speaker": 31, "form": "dlg", "jp": "（君のようにまだ覚醒する前の超能力者ならともかく‥‥）"},
{"id": 248, "speaker": 31, "form": "dlg", "jp": "（すでに覚醒して『能力におぼれてしまっている』\n　連中を説得するのは大変なんだ‥‥）"},
{"id": 249, "speaker": 31, "form": "dlg", "jp": "（場合によっては、『戦い』になってしまうことも‥‥）"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "（同じ『超能力者』同士ででも‥‥？）"},
{"id": 251, "speaker": 29, "form": "dlg", "jp": "（例えば、自分の能力を悪用していた場合、\n　それがバレてしまった連中は、自分を守るために）"},
{"id": 252, "speaker": 29, "form": "dlg", "jp": "（私たちを殺害しようとするわね‥‥）"},
{"id": 253, "speaker": 29, "form": "dlg", "jp": "（私たちも『超能力者』が\n　世間から悪く思われると困るので、）"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "（能力を悪用する者がいたら、\n　『抹殺』するけど‥‥）"},
{"id": 255, "speaker": 29, "form": "dlg", "jp": "（もちろんキミが悪用した場合もそうするわよ‥‥）"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "（ああ、憶えておくよ‥‥）"},
{"id": 257, "speaker": 29, "form": "dlg", "jp": "（それから、他の人間を動揺させないために\n　絶対、能力のことは他人に話さないこと！）"},
{"id": 258, "speaker": 29, "form": "dlg", "jp": "（たとえ、親、兄弟であっても、\n　能力のことがバレた時には‥‥）"},
{"id": 259, "speaker": 29, "form": "dlg", "jp": "（キミはもちろん、\n　そのことを知ってしまった人も"},
{"id": 260, "speaker": 29, "form": "dlg", "jp": "死んでもらう"},
{"id": 261, "speaker": 29, "form": "dlg", "jp": "から‥‥）"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "（わかったよ‥‥）"},
{"id": 263, "speaker": 29, "form": "dlg", "jp": "（長くなったけど、私の話はここまでよ、\n　どう理解してくれた‥‥？）"},
{"id": 264, "speaker": 29, "form": "choice", "jp": "（ああ、理解できたよ‥‥）"},
{"id": 265, "speaker": 29, "form": "choice", "jp": "（なんとなくしか理解できなかった‥‥）"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "（ああ、理解できたよ‥‥）"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "（なんとなくしか理解できなかった‥‥）"},
{"id": 268, "speaker": 31, "form": "dlg", "jp": "（まあ、難しく考えるな！）"},
{"id": 269, "speaker": 31, "form": "dlg", "jp": "（キミには、\n　『守るべきものを守ることができる力』がある）"},
{"id": 270, "speaker": 31, "form": "dlg", "jp": "（だから、その『力』を使って、\n　『守るべきものを守る』だけだ‥‥）"},
{"id": 271, "speaker": 31, "form": "dlg", "jp": "（そして、そのための仲間が、\n　『Ｅ－ｇｒｏ』（イーグル）ってことだ‥‥）"},
{"id": 272, "speaker": 31, "form": "dlg", "jp": "こうしてボクは『ジーン』たちの仲間になった。"},
{"id": 273, "speaker": 31, "form": "dlg", "jp": "‥‥‥‥"},
{"id": 274, "speaker": 31, "form": "dlg", "jp": "説明によると、この世界は、\n"},
{"id": 275, "speaker": 31, "form": "dlg", "jp": "『ゲーマー』"},
{"id": 276, "speaker": 31, "form": "dlg", "jp": "と呼ばれている連中に狙われているらしい。"},
{"id": 277, "speaker": 31, "form": "dlg", "jp": "『ゲーマー』は自分たちの快楽のためだけに、\n"},
{"id": 278, "speaker": 31, "form": "dlg", "jp": "人間社会を壊滅させようとする"},
{"id": 279, "speaker": 31, "form": "dlg", "jp": "イカレた連中だという。"},
{"id": 280, "speaker": 31, "form": "dlg", "jp": "彼女が言うには『ゲーム感覚』で破壊活動をするので\n『ゲーマー』と呼ばれているらしかった。"},
{"id": 281, "speaker": 29, "form": "dlg", "jp": "（まあ、人間の行動に例えると‥‥）"},
{"id": 282, "speaker": 29, "form": "dlg", "jp": "（『バス釣り』みたいなものね‥‥）"},
{"id": 283, "speaker": 29, "form": "dlg", "jp": "（『バス釣り』って、不思議な『ゲーム』でしょう？）"},
{"id": 284, "speaker": 29, "form": "dlg", "jp": "（生きている動物を釣り上げるだけで、\n　食べるワケでもないんだから‥‥）"},
{"id": 285, "speaker": 2, "form": "dlg", "jp": "（でも、『世界を破滅させる』なんて‥‥）"},
{"id": 286, "speaker": 2, "form": "choice", "jp": "（そんなことできるワケないだろう？）"},
{"id": 287, "speaker": 2, "form": "choice", "jp": "（『ゲーマー』って『軍人』？）"},
{"id": 288, "speaker": 29, "form": "dlg", "jp": "（近いうちに"},
{"id": 289, "speaker": 29, "form": "dlg", "jp": "『ペルーの本部』"},
{"id": 290, "speaker": 29, "form": "dlg", "jp": "に来てもらって、\n　『リーダー』に紹介するわ‥‥）"},
{"id": 291, "speaker": 29, "form": "dlg", "jp": "（詳しいことは、『リーダー』から\n　聞いてちょうだい‥‥）"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "（また、ペルーか‥‥‥‥）"},
{"id": 293, "speaker": 29, "form": "dlg", "jp": "（じゃ、遅くなったんで私たちは\n　いったんホテルに戻るから‥‥）"},
{"id": 294, "speaker": 29, "form": "dlg", "jp": "（何かあったら、ホテルの方に連絡ちょうだい‥‥）"},
{"id": 295, "speaker": 29, "form": "dlg", "jp": "『ジーン』は連絡先の書かれたメモを手渡した。"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "（戻るってどうやって‥‥）"},
{"id": 297, "speaker": 29, "form": "dlg", "jp": "（窓からに決まってるでしょう？）"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "（ここ、２階だけど‥‥）"},
{"id": 299, "speaker": 31, "form": "dlg", "jp": "（オレの『能力』を忘れたのか？）"},
{"id": 300, "speaker": 31, "form": "dlg", "jp": "（人間の１人や、２人軽いものさ‥‥）"},
{"id": 301, "speaker": 29, "form": "dlg", "jp": "（じゃぁね！）"},
{"id": 302, "speaker": 29, "form": "dlg", "jp": "「シュンッ！」"},
{"id": 303, "speaker": 29, "form": "dlg", "jp": "２人は窓から飛び去った‥‥"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "（ふう‥‥）"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "（なんで、こんなに次々と大変なことに\n　巻き込まれるんだろう？）"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥これは、\n　また眠れない日が続きそうだな‥‥）"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "しかし、意外なことに\nその夜はすんなりと眠りにつくことができた‥‥"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "それは仲間ができて安心したのかもしれないし、"},
{"id": 309, "speaker": 2, "form": "dlg", "jp": "単に疲れていただけなのかもしれなかった。"}
]
