[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０７／２１／ＰＭ０９：２０"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "（‥‥？？）"},
{"id": 2, "speaker": 2, "form": "dlg", "jp": "（窓が開いている？）"},
{"id": 3, "speaker": 2, "form": "dlg", "jp": "（なぜだ？）"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「シュンッ！」"},
{"id": 5, "speaker": 2, "form": "dlg", "jp": "何かが風を切る音が聞こえた。"},
{"id": 6, "speaker": 29, "form": "dlg", "jp": "「コンバンハ‥‥」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「ジーン！！」"},
{"id": 8, "speaker": 31, "form": "dlg", "jp": "「オジャマしてるよ‥‥」"},
{"id": 9, "speaker": 31, "form": "choice", "jp": "「ギネス！！」"},
{"id": 10, "speaker": 31, "form": "choice", "jp": "「ケイン！！」"},
{"id": 11, "speaker": 31, "form": "choice", "jp": "「ケネス！！」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「ギネス！！」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "「ケイン！！」"},
{"id": 14, "speaker": 31, "form": "dlg", "jp": "「ケネスだよ！！」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「ケネス！！」"},
{"id": 16, "speaker": 31, "form": "dlg", "jp": "「キミのことが心配だから来たんだよ！」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "「心配？」"},
{"id": 18, "speaker": 29, "form": "dlg", "jp": "「なんでもいいけど、声を出さないで！」"},
{"id": 19, "speaker": 29, "form": "dlg", "jp": "「家の人いるんでしょう？」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「でも‥‥」"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "「今からは『テレパシー』で会話しましょう」"},
{"id": 22, "speaker": 29, "form": "choice", "jp": "「わかった‥‥」"},
{"id": 23, "speaker": 29, "form": "choice", "jp": "「で、何しに来たの？」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「わかった‥‥」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「で、何しに来たの？」"},
{"id": 26, "speaker": 29, "form": "dlg", "jp": "（だから！　『テレパシー』を使いなさい！）"},
{"id": 27, "speaker": 2, "form": "dlg", "jp": "（ゴメン‥‥）"},
{"id": 28, "speaker": 31, "form": "dlg", "jp": "（キミがそんな風に危なっかしいから、\n　わざわざ来てやったんだよ！）"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "（危なっかしい？）"},
{"id": 30, "speaker": 29, "form": "dlg", "jp": "（『真実』にたえられないんじゃないかと思ってね‥‥）"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "（真実にたえられない？）"},
{"id": 32, "speaker": 31, "form": "dlg", "jp": "（『認知的共和』だな‥‥）"},
{"id": 33, "speaker": 29, "form": "dlg", "jp": "（心理学用語よ‥‥）"},
{"id": 34, "speaker": 29, "form": "dlg", "jp": "（人間は相反する２つの感情を認知しづらいの‥‥）"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "（‥‥‥？）"},
{"id": 36, "speaker": 31, "form": "dlg", "jp": "（例えば、キミが『ナットウを食べる女性』がキライで、\n　ある『女性アイドル』のことが好きだとする）"},
{"id": 37, "speaker": 31, "form": "dlg", "jp": "（でもって、その『女性アイドル』が\n　『ナットウを食べる』とする）"},
{"id": 38, "speaker": 31, "form": "dlg", "jp": "（とたん、キミの脳はパニックになり‥‥）"},
{"id": 39, "speaker": 31, "form": "dlg", "jp": "（その『女性アイドル』のことがキライになったり、\n　『ナットウを食べる女性』を認めたりするだろう？）"},
{"id": 40, "speaker": 31, "form": "dlg", "jp": "（そういうことさ‥‥）"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "（せっかくの例えだけど、何を言いたいのか‥‥？）"},
{"id": 42, "speaker": 29, "form": "dlg", "jp": "（パニックになると間違った答えを出すってことよ！）"},
{"id": 43, "speaker": 29, "form": "dlg", "jp": "（さっきの例だとその中でのキミの頭の中での正解は）"},
{"id": 44, "speaker": 29, "form": "dlg", "jp": "（『ナットウを食べる女性』がキライで\n　『女性アイドル』がスキってことなのに‥‥）"},
{"id": 45, "speaker": 29, "form": "dlg", "jp": "（２つの異なる条件が合わさったことで、\n　頭の中の考えがパニックで変わってしまう）"},
{"id": 46, "speaker": 29, "form": "dlg", "jp": "（つまり、今日のことでキミがパニックになって\n　おかしな行動をしないか心配してやって来たのよ！）"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "（おかしな考え？）"},
{"id": 48, "speaker": 31, "form": "dlg", "jp": "（あんなスゴイ能力を手に入れたことに\n　間違った『意味付け』をしないかと心配してんだよ！）"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "（『意味付け』‥‥）"},
{"id": 50, "speaker": 29, "form": "dlg", "jp": "（人間は『意味』を求める生き物なの）"},
{"id": 51, "speaker": 29, "form": "dlg", "jp": "（風景写真に『顔みたいなカゲ』が写ってたら、\n　『死んだ人』の霊だと思い込んだり）"},
{"id": 52, "speaker": 29, "form": "dlg", "jp": "（まん中に梅干しをおいた弁当を\n　国旗だと思ったり‥‥）"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "（『意味』を求めちゃいけないの？）"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "（そうじゃないわ！）"},
{"id": 55, "speaker": 29, "form": "dlg", "jp": "（勝手に『間違った意味』をつけることが危険なのよ！）"},
{"id": 56, "speaker": 29, "form": "dlg", "jp": "（風景写真に写った『顔みたいなカゲ』は『陰』だし）"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "（まん中に梅干しを置くのはゴハンに\n　その味をしみ込ませるタメ‥‥）"},
{"id": 58, "speaker": 29, "form": "dlg", "jp": "（本当の意味はそういうものなの‥‥）"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "（それがボクの『能力』とどう関係あるの？）"},
{"id": 60, "speaker": 29, "form": "dlg", "jp": "（『能力』を間違った使い方しないで欲しいってこと）"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "（はぁ‥‥）"},
{"id": 62, "speaker": 31, "form": "dlg", "jp": "（キミの『能力』は決して『透明人間』になって\n　女風呂をのぞくためのもんじゃないってことだ！）"},
{"id": 63, "speaker": 31, "form": "choice", "jp": "（そんなコトできるの？）"},
{"id": 64, "speaker": 31, "form": "choice", "jp": "（そんなコトしないよ！）"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "（そんなコトできるの？）"},
{"id": 66, "speaker": 31, "form": "dlg", "jp": "（キミが『透明な体』をイメージできたらな‥‥）"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "（そんなコトしないよ！）"},
{"id": 68, "speaker": 31, "form": "dlg", "jp": "（『透明な体』をイメージできないとムリだしな‥‥）"},
{"id": 69, "speaker": 29, "form": "dlg", "jp": "（まあ、本当にそんなことをしたら、間違いなく\n　『Ｅ－ｇｒｏ』のメンバーに暗殺されるけど‥‥）"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "（『暗殺』！！）"},
{"id": 71, "speaker": 29, "form": "dlg", "jp": "（世間に『超能力者』が危険な存在だと思われて\n　一番困るのは『Ｅ－ｇｒｏ』だから‥‥）"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "（言っておくけど、『Ｅ－ｇｒｏ』はけっして\n　『超能力者』のサークルじゃないから‥‥）"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "（ちゃんと『目的をもった集団』なの！）"},
{"id": 74, "speaker": 31, "form": "dlg", "jp": "（だから目的の為なら暗殺ぐらいは‥‥）"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "（暗殺ぐらいって‥‥）"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "（それって『犯罪』だろう！？）"},
{"id": 77, "speaker": 31, "form": "dlg", "jp": "（言っておくが、『のぞき』も犯罪だぜ‥‥）"},
{"id": 78, "speaker": 29, "form": "dlg", "jp": "（それに『殺人』がすべて犯罪ではないわ‥‥）"},
{"id": 79, "speaker": 31, "form": "dlg", "jp": "（戦争で兵士が兵士を殺すのは殺人じゃないよな‥‥）"},
{"id": 80, "speaker": 29, "form": "dlg", "jp": "（私たちは『兵士』なの‥‥）"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "（でも、ボクは‥‥）"},
{"id": 82, "speaker": 29, "form": "dlg", "jp": "（キミも『兵士』よ！）"},
{"id": 83, "speaker": 29, "form": "dlg", "jp": "（言ったでしょう、『私たち』って‥‥）"},
{"id": 84, "speaker": 31, "form": "dlg", "jp": "（オレたちの『能力』は\n　『戦うため』の『能力』なんだ‥‥）"},
{"id": 85, "speaker": 31, "form": "dlg", "jp": "（『戦うための能力』を持っている以上、\n　『兵士』なんだよ‥‥）"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "（でも、ボクは戦うつもりは‥‥）"},
{"id": 87, "speaker": 31, "form": "dlg", "jp": "（日本人らしい、意見だな‥‥）"},
{"id": 88, "speaker": 31, "form": "dlg", "jp": "（じゃあ、『戦う力』を持った『自衛隊』が\n　戦争で殺されたら『民間人』が死んだことになるのか？）"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "（キミがどう思おうと、キミが『能力者』であるかぎり\n　キミは『兵士』なのよ！）"},
{"id": 90, "speaker": 29, "form": "dlg", "jp": "（『兵士』が『民間人』にその『力』を駆使するのなら\n　さばかれるのは当たり前でしょう？）"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "（じゃぁ、ボクのこの『能力』の意味は‥‥）"},
{"id": 92, "speaker": 29, "form": "dlg", "jp": "（『戦うための力』だと思ってくれればいいわ‥‥）"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "（『戦う』って、誰と？）"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "（さっきも言ったけど、『ゲーマー』よ‥‥）"},
{"id": 95, "speaker": 2, "form": "dlg", "jp": "（だから、その『ゲーマー』っていったい？）"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "（長い話だけど大丈夫？？）"},
{"id": 97, "speaker": 29, "form": "choice", "jp": "（ああ、わかった！）"},
{"id": 98, "speaker": 29, "form": "choice", "jp": "（手短にお願いします）"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "（わかったわ‥‥）"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "（じゃあ、簡単に説明するから‥‥）"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "説明によると、この世界は、\n"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "『ゲーマー』"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "と呼ばれている連中に狙われているらしい。"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "『ゲーマー』は自分たちの快楽のためだけに、\n"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "人間社会を壊滅させようとする"},
{"id": 106, "speaker": 29, "form": "dlg", "jp": "イカレた連中だという。"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "彼女が言うには『ゲーム感覚』で破壊活動をするので\n『ゲーマー』と呼ばれているらしかった。"},
{"id": 108, "speaker": 29, "form": "dlg", "jp": "すでに人類は『ゲーマー』によって\nほとんど壊滅状態に追い込まれているらしく、"},
{"id": 109, "speaker": 29, "form": "dlg", "jp": "『アトランティス』や『ムー』の水没なども\nすべて『ゲーマー』の仕業だという。"},
{"id": 110, "speaker": 29, "form": "dlg", "jp": "しかし、人類を『全滅』させてしまうと\n次の『ゲーム』が楽しめなくなるので"},
{"id": 111, "speaker": 29, "form": "dlg", "jp": "決して『全滅』はさせず、ぎりぎりまで滅ぼすと\n再び人類が増えるのを待つらしい。"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "つまり、『ゲーマー』は何千年、何万年という単位で\n人類を襲う次元の違う『敵』なんだという。"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "（どう？　わかってくれた？）"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "（なんとなくだけど‥‥）"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "（ただ‥‥）"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "（何よ？）"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "（そんな何千年単位のことを\n　どうしてキミたちが知ってるんだ？）"},
{"id": 118, "speaker": 29, "form": "dlg", "jp": "（人間は他の動物と違い、\n　後世に伝える手段を持ってるでしょう？）"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "（言葉とか文字とか‥‥）"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "（まず、わかって欲しいのは‥‥）"},
{"id": 121, "speaker": 29, "form": "dlg", "jp": "（私たちの言う『ゲーマー』と\n　キミが思っている『人間のゲーマー』とは）"},
{"id": 122, "speaker": 29, "form": "dlg", "jp": "（まったく関係がないから‥‥）"},
{"id": 123, "speaker": 29, "form": "choice", "jp": "（それはなんとなくわかってるけど‥‥）"},
{"id": 124, "speaker": 29, "form": "choice", "jp": "（じゃあ『人間』じゃないの！？）"},
{"id": 125, "speaker": 2, "form": "dlg", "jp": "（それはなんとなくわかってるけど‥‥）"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "（じゃあ『人間』じゃないの！？）"},
{"id": 127, "speaker": 31, "form": "dlg", "jp": "（人間相手に『能力』はいらないだろう）"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』っていうのは私たちが勝手に名付けた\n　名前であって本当の名前はわからないの‥‥）"},
{"id": 129, "speaker": 29, "form": "choice", "jp": "（わからない？）"},
{"id": 130, "speaker": 29, "form": "choice", "jp": "（なんで『ゲーマー』って名付けたの？）"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "（なんで『ゲーマー』って名付けたの？）"},
{"id": 132, "speaker": 29, "form": "dlg", "jp": "（『ゲーム感覚』で\n　『人類』を『滅亡』させるからよ‥‥）"},
{"id": 133, "speaker": 2, "form": "dlg", "jp": "（ハァ？）"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "（わからない？）"},
{"id": 135, "speaker": 29, "form": "dlg", "jp": "（そう‥‥）"},
{"id": 136, "speaker": 29, "form": "dlg", "jp": "（名前どころか、どんなヤツなのかも‥‥）"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "（ただわかっていることは、『ゲーム感覚』で\n　『人類』を『滅亡』させるっていうことだけ‥‥）"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "（ハァ？）"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "いったい、何を言い出すんだ！！"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "『ゲーム感覚』で『人類』を『滅亡』させる？"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "（それ以外がわからないの‥‥）"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "（それってほとんど何も知らないってことじゃぁ？）"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "（知らないヤツに『敵意』を抱いてるの？）"},
{"id": 144, "speaker": 31, "form": "dlg", "jp": "（バカ、ソイツを知らないだけだ‥‥）"},
{"id": 145, "speaker": 31, "form": "dlg", "jp": "（ソイツがしたことは知ってるんだよ！）"},
{"id": 146, "speaker": 29, "form": "dlg", "jp": "（『犯人』のわからない『殺人事件』のようなものね‥‥）"},
{"id": 147, "speaker": 29, "form": "dlg", "jp": "ぜんぜん話が見えてこない‥‥"},
{"id": 148, "speaker": 29, "form": "choice", "jp": "【少し、ツッコんでみるか】"},
{"id": 149, "speaker": 29, "form": "choice", "jp": "【もう少し話を聞いてみよう】"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "【少し、ツッコんでみるか】"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "（その話には『ムジュン』があるだろう）"},
{"id": 152, "speaker": 2, "form": "dlg", "jp": "（『人類滅亡』を『した』んなら、\n　ボクたちはここにいないはずだろう？）"},
{"id": 153, "speaker": 29, "form": "dlg", "jp": "（その通りね‥‥）"},
{"id": 154, "speaker": 29, "form": "dlg", "jp": "（正確には『人類』を『滅亡』に近いくらい\n　殺したってこと‥‥）"},
{"id": 155, "speaker": 29, "form": "dlg", "jp": "【もう少し話を聞いてみよう】"},
{"id": 156, "speaker": 29, "form": "dlg", "jp": "（まあ正確には『滅亡』させたんじゃなく）"},
{"id": 157, "speaker": 29, "form": "dlg", "jp": "（『滅亡』に近いくらい殺したってことね‥‥）"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "（でも、そんな大きな事件なら、\n　みんな知ってるハズじゃあ？）"},
{"id": 159, "speaker": 29, "form": "dlg", "jp": "（普通の人は知りようがないの‥‥）"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "（どうして？）"},
{"id": 161, "speaker": 29, "form": "dlg", "jp": "（数千年も前のことだから‥‥）"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "（はぁ？）"},
{"id": 163, "speaker": 2, "form": "choice", "jp": "（どうしてキミたちは知ってるの？）"},
{"id": 164, "speaker": 2, "form": "choice", "jp": "（それなら、ソイツももう死んでるんじゃぁ？）"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "（それなら、ソイツももう死んでるんじゃぁ？）"},
{"id": 166, "speaker": 29, "form": "dlg", "jp": "（死んでないわ‥‥）"},
{"id": 167, "speaker": 29, "form": "dlg", "jp": "（人間じゃないから‥‥）"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "（人間じゃないにしても、\n　そんなに長生きできないだろう？）"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』は私たちとは違う時間に生きているの‥‥）"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "（どうしてキミたちは知ってるの？）"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "（人間は他の動物と違い、\n　後世に伝える手段を持ってるでしょう？）"},
{"id": 172, "speaker": 29, "form": "dlg", "jp": "（言葉とか文字とか‥‥）"},
{"id": 173, "speaker": 29, "form": "dlg", "jp": "（キミも体験したから\n　わかってもらえると思うけど‥‥）"},
{"id": 174, "speaker": 29, "form": "dlg", "jp": "（私たちの中には『残存思念』を残せる仲間が\n　何人かいるの‥‥）"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "（そうした仲間の意志が、\n　何千年、何万年と語り継いできたの‥‥）"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "（でも、そんな『イイツタエ』レベルの話じゃぁ‥‥）"},
{"id": 177, "speaker": 29, "form": "dlg", "jp": "（『百聞は一見にしかず』よ！）"},
{"id": 178, "speaker": 29, "form": "dlg", "jp": "（『映像』が残ってるの）"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "（『映像』？）"},
{"id": 180, "speaker": 29, "form": "dlg", "jp": "（先人が残した『アカシックレコード』が‥‥）"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "（『アカシックレコード』‥‥）"},
{"id": 182, "speaker": 2, "form": "choice", "jp": "（何それ？）"},
{"id": 183, "speaker": 2, "form": "choice", "jp": "（知ってるよそれ！）"},
{"id": 184, "speaker": 2, "form": "dlg", "jp": "（知ってるよそれ！）"},
{"id": 185, "speaker": 2, "form": "dlg", "jp": "（よく、ＳＦなんかで出てくる、\n　未来の出来事がすべて記されてるってヤツだろう？）"},
{"id": 186, "speaker": 29, "form": "dlg", "jp": "（それは作り話の中の話ね‥‥）"},
{"id": 187, "speaker": 29, "form": "dlg", "jp": "（本物は本部にある\n　過去の出来事が記録された『不思議な石』よ‥‥）"},
{"id": 188, "speaker": 29, "form": "dlg", "jp": "（『アカシックレコード』には\n　過去の『ゲーマー』の仕打ちが全て記録されているの）"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "（何それ？）"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "（私たちの本部にある\n　過去の出来事が記録された『不思議な石』よ‥‥）"},
{"id": 191, "speaker": 29, "form": "dlg", "jp": "（『アカシックレコード』には\n　過去の『ゲーマー』の仕打ちが全て記録されているの）"},
{"id": 192, "speaker": 31, "form": "dlg", "jp": "（とにかく、オレたちを信じるんだ）"},
{"id": 193, "speaker": 31, "form": "dlg", "jp": "（『テレパシー』の使えるオレたち同士が\n　ウソをつくことはできないんだから‥‥）"},
{"id": 194, "speaker": 31, "form": "dlg", "jp": "たしかに、『テレパシー』がある以上、彼等がウソをついても見破れていしまう。"},
{"id": 195, "speaker": 31, "form": "dlg", "jp": "っていうことは、今の話は全て本当なのか？"},
{"id": 196, "speaker": 31, "form": "dlg", "jp": "ムチャクチャだ‥‥"},
{"id": 197, "speaker": 31, "form": "dlg", "jp": "遊び感覚で人類を滅亡できる敵とか、\n数万年の過去の記録‥‥"},
{"id": 198, "speaker": 31, "form": "dlg", "jp": "そんなことが『真実』だなんて‥‥"},
{"id": 199, "speaker": 31, "form": "choice", "jp": "【でも、信じるしかないんだよな‥‥】"},
{"id": 200, "speaker": 31, "form": "choice", "jp": "【いや、やっぱりおかしい！！】"},
{"id": 201, "speaker": 31, "form": "dlg", "jp": "【でも、信じるしかないんだよな‥‥】"},
{"id": 202, "speaker": 29, "form": "dlg", "jp": "（どう？）"},
{"id": 203, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』については理解してくれた？）"},
{"id": 204, "speaker": 2, "form": "dlg", "jp": "（理解はできないけど‥‥）"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "（信じるしかなんだろう？）"},
{"id": 206, "speaker": 31, "form": "dlg", "jp": "（そうだな‥）"},
{"id": 207, "speaker": 29, "form": "dlg", "jp": "（もちろん、『アカシックレコード』にも\n　『ゲーマー』の姿は記録されていないから）"},
{"id": 208, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』の姿は私たちも知らないんだけど‥‥）"},
{"id": 209, "speaker": 2, "form": "dlg", "jp": "（なんで？）"},
{"id": 210, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』は自分自身では攻撃をしてこないから‥‥）"},
{"id": 211, "speaker": 29, "form": "dlg", "jp": "【いや、やっぱりおかしい！！】"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "（ちょっとまって、\n　さっき『ゲーマー』を見たことないって‥‥）"},
{"id": 213, "speaker": 29, "form": "dlg", "jp": "（『アカシックレコード』には\n　『ゲーマーの仕業』しか記録されていないの）"},
{"id": 214, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』は自分自身では攻撃をしてこないから‥‥）"},
{"id": 215, "speaker": 29, "form": "dlg", "jp": "ジーンたちは、その『アカシックレコード』という\n不思議な石から『ゲーマー』の情報を入手したらしい。"},
{"id": 216, "speaker": 29, "form": "dlg", "jp": "さらにジーンによると、『ゲーマー』の攻撃は\nすでに始まっているのだという。"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "『ゲーマー』が『洪水』や『地震』などの\n『天変地異』をあやつれるのは"},
{"id": 218, "speaker": 29, "form": "dlg", "jp": "『人間以外のあらゆるモノ』を\nコントロールする能力を持っているかららしく"},
{"id": 219, "speaker": 29, "form": "dlg", "jp": "すでにその能力を使って世界中の機械などを\n『暴走』させているらしい。"},
{"id": 220, "speaker": 29, "form": "dlg", "jp": "なんでも、いきなり『天変地異』等を起すと\n『楽しみが減る』のでそんな攻撃をしているらしい。"},
{"id": 221, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』についての説明は以上よ‥‥）"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "（キミたちはそんなスゴイヤツと\n　戦おうとしてるの？）"},
{"id": 223, "speaker": 31, "form": "dlg", "jp": "（違うよ！）"},
{"id": 224, "speaker": 31, "form": "dlg", "jp": "（オレたちだけじゃなく、オマエもだ‥‥）"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "（でも、そんなヤツ相手にボクらだけで‥‥）"},
{"id": 226, "speaker": 29, "form": "dlg", "jp": "（私たちじゃないと戦えないのよ！）"},
{"id": 227, "speaker": 29, "form": "dlg", "jp": "（ヤツには『人間以外をコントロールできる』から、\n　一切『武器』は通用しないの）"},
{"id": 228, "speaker": 29, "form": "dlg", "jp": "（つまり、『ゲーマー』と戦えるのは人間でありながら\n　『戦闘能力』をもった私たちだけなの‥‥）"},
{"id": 229, "speaker": 31, "form": "dlg", "jp": "（強いモノが弱いモのを守ってやらなければいけない\n　ってのは理解できるだろう？）"},
{"id": 230, "speaker": 31, "form": "dlg", "jp": "（それだけのことだよ‥‥）"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "（それだけのことって‥‥）"},
{"id": 232, "speaker": 29, "form": "dlg", "jp": "（ザンネンだけど、私たちにも戦って勝てる相手か\n　どうかなんてわかってないの‥‥）"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "（でも、確実に言えることは、\n　戦わなきゃ『みんな死んじゃう』ってこと‥‥）"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "（『みんな死んじゃう』‥‥）"},
{"id": 235, "speaker": 2, "form": "dlg", "jp": "（じゃあ、どんな攻撃をしてくるの？）"},
{"id": 236, "speaker": 29, "form": "dlg", "jp": "（例えば、『天変地異』‥‥）"},
{"id": 237, "speaker": 29, "form": "dlg", "jp": "（『洪水』や『地震』などをあやつって\n　人類を壊滅状態に‥‥）"},
{"id": 238, "speaker": 2, "form": "dlg", "jp": "（‥‥‥！？）"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "（なんで、そんなものあやつれるんだよ！）"},
{"id": 240, "speaker": 31, "form": "dlg", "jp": "（『ルール』だよ‥‥）"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "（『ルール』！？）"},
{"id": 242, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』の『ルール』よ！）"},
{"id": 243, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』は『人間以外のモノ』ならなんでも\n　コントロールできるの‥‥）"},
{"id": 244, "speaker": 2, "form": "dlg", "jp": "（『なんでも』！？）"},
{"id": 245, "speaker": 29, "form": "dlg", "jp": "（そう、『なんでも』よ！）"},
{"id": 246, "speaker": 31, "form": "dlg", "jp": "（だからオレたちが戦わなくちゃいけないんだ）"},
{"id": 247, "speaker": 31, "form": "dlg", "jp": "（『ゲーマーの能力』なら、世界中の兵器を\n　無力化できてしまうからな‥‥）"},
{"id": 248, "speaker": 29, "form": "dlg", "jp": "（それともう１つの『ルール』が\n　人類を決して『絶滅』はさせない‥‥）"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "（１つ目のルールはともかく、\n　２つ目にルールはなんのために‥‥）"},
{"id": 250, "speaker": 29, "form": "dlg", "jp": "（『ゲーム』だからよ‥‥）"},
{"id": 251, "speaker": 29, "form": "dlg", "jp": "（『全滅』させてしまうと、\n　２度とゲームを楽しめないから‥‥）"},
{"id": 252, "speaker": 31, "form": "dlg", "jp": "（まあ、釣りの『キャッチ＆リリース』\n　みたいなものだな‥‥）"},
{"id": 253, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』は『ゲーム感覚』で\n　人間を襲うだけだから）"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "（本当に『全滅』させちゃうと\n　もう『ゲーム』ができなくなるでしょう）"},
{"id": 255, "speaker": 31, "form": "dlg", "jp": "（『ゲーマー』にとってオレたちは\n　ゲームキャラクターでしかないんだよ‥‥）"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥）"},
{"id": 257, "speaker": 31, "form": "dlg", "jp": "（人類は過去何度も『ゲーマー』に滅ぼされかけ\n　そして復興してきたんだ‥‥）"},
{"id": 258, "speaker": 31, "form": "dlg", "jp": "（もちろん、その度に文明は失われ\n　人類の大半は殺されちゃったんだがな‥‥）"},
{"id": 259, "speaker": 29, "form": "dlg", "jp": "（もし、今度『ゲーマー』の攻撃が始まったら\n　間違いなく今の世の中はなくなってしまうわ）"},
{"id": 260, "speaker": 29, "form": "choice", "jp": "（世の中がなくなる！？）"},
{"id": 261, "speaker": 29, "form": "choice", "jp": "（そんなヤツと戦うつもりなの？）"},
{"id": 262, "speaker": 29, "form": "choice", "jp": "（攻撃が始まる？）"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "（世の中がなくなる？）"},
{"id": 264, "speaker": 29, "form": "dlg", "jp": "（そうね‥‥）"},
{"id": 265, "speaker": 29, "form": "dlg", "jp": "（『アトランティス』や『ムー』の水没の話とか\n　聞いたことあるでしょう？）"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "（まさか、それも！！）"},
{"id": 267, "speaker": 29, "form": "dlg", "jp": "（『ゲーマー』の仕業よ‥‥）"},
{"id": 268, "speaker": 29, "form": "dlg", "jp": "（今は小さなモノのしか\n　あやつってないみたいだけど、本気になったら‥‥）"},
{"id": 269, "speaker": 2, "form": "dlg", "jp": "（ちょっと待って！）"},
{"id": 270, "speaker": 2, "form": "dlg", "jp": "（『今は小さなモノしか』って、\n　もう攻撃は始まってるの！？）"},
{"id": 271, "speaker": 29, "form": "dlg", "jp": "（最近、世界中でいろんな機械が\n　『暴走』しているってニュース知ってるでしょう？）"},
{"id": 272, "speaker": 29, "form": "dlg", "jp": "（もしかしたらあれも『ゲーマー』の可能性が‥‥）"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "（ハァ！？）"},
{"id": 274, "speaker": 31, "form": "dlg", "jp": "（人間以外のものをコントロールできる能力が\n　あるって言っただろう、それだよ‥‥）"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "（でも、人類を滅亡に追い込むには\n　あんまりにも小さな攻撃じゃない？）"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "（『洪水』とか『地震』とかコントロールできるのに‥‥）"},
{"id": 277, "speaker": 29, "form": "dlg", "jp": "（『遊び』だからよ‥‥）"},
{"id": 278, "speaker": 29, "form": "dlg", "jp": "（ヤツらからすれば、人間を滅ぼすなんて\n　人間がアリを殺すのと同じようなもの‥‥）"},
{"id": 279, "speaker": 29, "form": "dlg", "jp": "（本気を出せば一瞬だけど、\n　それじゃぁ『ゲーム』としておもしろくない‥‥）"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "（キミたちはそんなスゴイヤツと\n　戦おうとしてるの？）"},
{"id": 281, "speaker": 31, "form": "dlg", "jp": "（違うよ！）"},
{"id": 282, "speaker": 31, "form": "dlg", "jp": "（オレたちだけじゃなく、オマエもだ‥‥）"},
{"id": 283, "speaker": 2, "form": "dlg", "jp": "（でも、そんなヤツ相手にボクらだけで‥‥）"},
{"id": 284, "speaker": 29, "form": "dlg", "jp": "（私たちじゃないと戦えないのよ！）"},
{"id": 285, "speaker": 29, "form": "dlg", "jp": "（ヤツには『人間以外をコントロールできる』から、\n　一切『武器』は通用しないの）"},
{"id": 286, "speaker": 29, "form": "dlg", "jp": "（つまり、『ゲーマー』と戦えるのは人間でありながら\n　『戦闘能力』をもった私たちだけなの‥‥）"},
{"id": 287, "speaker": 31, "form": "dlg", "jp": "（強いモノが弱いモのを守ってやらなければいけない\n　ってのは理解できるだろう？）"},
{"id": 288, "speaker": 31, "form": "dlg", "jp": "（それだけのことだよ‥‥）"},
{"id": 289, "speaker": 2, "form": "dlg", "jp": "（それだけのことって‥‥）"},
{"id": 290, "speaker": 29, "form": "dlg", "jp": "（ザンネンだけど、私たちにも戦って勝てる相手か\n　どうかなんてわかってないの‥‥）"},
{"id": 291, "speaker": 29, "form": "dlg", "jp": "（でも、確実に言えることは、\n　戦わなきゃ『みんな死んじゃう』ってこと‥‥）"},
{"id": 292, "speaker": 2, "form": "dlg", "jp": "（『みんな死んじゃう』‥‥）"},
{"id": 293, "speaker": 2, "form": "dlg", "jp": "（そんなヤツと戦うつもりなの？）"},
{"id": 294, "speaker": 29, "form": "dlg", "jp": "（私たちじゃないと戦えないのよ！）"},
