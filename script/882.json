[
{"id": 0, "speaker": null, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "『クリエーター』の次の攻撃可能時間まで、\nあと２時間となった。"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "ジーンの報告を受けたリーダーはすんなりと\nボクが『クリエーター』と対決することを許可してくれた。"},
{"id": 3, "speaker": 46, "form": "dlg", "jp": "「‥‥ということで、\n　"},
{"id": 4, "speaker": 46, "form": "dlg", "jp": "人類の命運"},
{"id": 5, "speaker": 46, "form": "dlg", "jp": "を"},
{"id": 6, "speaker": 46, "form": "dlg", "jp": "ナゴムにゆだねる"},
{"id": 7, "speaker": 46, "form": "dlg", "jp": "ことに決定しました」"},
{"id": 8, "speaker": 46, "form": "dlg", "jp": "「これが人類最後の抵抗となります！」"},
{"id": 9, "speaker": 46, "form": "dlg", "jp": "「ただし‥‥」"},
{"id": 10, "speaker": 46, "form": "dlg", "jp": "「誤解をしないでください！」"},
{"id": 11, "speaker": 46, "form": "dlg", "jp": "「後がないから『最後』というのではありません！」"},
{"id": 12, "speaker": 46, "form": "dlg", "jp": "「この作戦が必ず成功するから\n　『最後』となるのです！」"},
{"id": 13, "speaker": 46, "form": "dlg", "jp": "『オオーーーッ！』"},
{"id": 14, "speaker": 46, "form": "dlg", "jp": "こうして『Ｅ－ｇｒｏ』のメンバー全員が\nボクの勝利を信じて送りだしてくれることになった。\n"},
{"id": 15, "speaker": 46, "form": "dlg", "jp": "アリスは何人かサポートをつけると言ってくれたが\nボクは余計な犠牲がでないようにそれをことわり、"},
{"id": 16, "speaker": 46, "form": "dlg", "jp": "『クリエーター』のところまで\n『松尾さん』に運んでもらうように頼んだ。"},
{"id": 17, "speaker": 35, "form": "dlg", "jp": "「ほんとにオレに送らせてくれるのかい？」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「うん、松尾さんにお願いしたいんだ‥‥」"},
{"id": 19, "speaker": 35, "form": "dlg", "jp": "「ピリの方が確実だぜ？」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「もしかしてコワイ？」"},
{"id": 21, "speaker": 35, "form": "dlg", "jp": "「バカなこと言うなよ！」"},
{"id": 22, "speaker": 35, "form": "dlg", "jp": "「光栄すぎるんだよ！」"},
{"id": 23, "speaker": 13, "form": "dlg", "jp": "「いっしょに『歴史』に名前が残るだろうな‥‥」"},
{"id": 24, "speaker": 13, "form": "dlg", "jp": "「ナゴムとアスカの\n　『歴史ゲーム』が売り出されたりして‥‥」"},
{"id": 25, "speaker": 35, "form": "dlg", "jp": "「メチャメチャ光栄だよ！！」"},
{"id": 26, "speaker": 31, "form": "dlg", "jp": "「ナゴム‥‥」"},
{"id": 27, "speaker": 31, "form": "dlg", "jp": "「オレもついて行っちゃダメか？」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「ダメだよ！」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「子供のオツカイじゃないし‥‥」"},
{"id": 30, "speaker": 2, "form": "dlg", "jp": "「誰かが側にいると、\n　その誰かに頼ってしまうから‥‥」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「『弱気』になったら勝てないだろう‥‥」"},
{"id": 32, "speaker": 31, "form": "dlg", "jp": "「そ、そうだな‥‥」"},
{"id": 33, "speaker": 51, "form": "dlg", "jp": "「なあ‥‥」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 35, "speaker": 31, "form": "dlg", "jp": "「オイ、弱気なことを言うなよ！」"},
{"id": 36, "speaker": 51, "form": "dlg", "jp": "「言わへんよ！」"},
{"id": 37, "speaker": 51, "form": "dlg", "jp": "「ウチは誰よりも常光寺を信じてる！」"},
{"id": 38, "speaker": 51, "form": "dlg", "jp": "「常光寺はウチが認める唯一の『男』や！」"},
{"id": 39, "speaker": 31, "form": "dlg", "jp": "「じゃあなんだよ！」"},
{"id": 40, "speaker": 51, "form": "dlg", "jp": "「心配なんや‥‥」"},
{"id": 41, "speaker": 31, "form": "dlg", "jp": "「だから、そういうことを言うなって！」"},
{"id": 42, "speaker": 31, "form": "dlg", "jp": "「ナゴムは絶対『勝つ』んだから‥‥」"},
{"id": 43, "speaker": 51, "form": "dlg", "jp": "「『勝つ』から心配なんや‥‥」"},
{"id": 44, "speaker": 51, "form": "dlg", "jp": "「そんな、世界の救世主みたいにリッパになったら、\n　ウチなんかと口きいてくれへんのやないかって‥‥」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「大丈夫だよ！」"},
{"id": 46, "speaker": 2, "form": "dlg", "jp": "「アイツには負けないけど‥‥」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「ヒーローインタビューを\n　堂々とできるほどの根性はないから‥‥」"},
{"id": 48, "speaker": 2, "form": "dlg", "jp": "「その時は『しゃべりの上手な女の子』に\n　そばでサポートしてもらうつもりだから‥‥」"},
{"id": 49, "speaker": 51, "form": "dlg", "jp": "「約束やで！」"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 51, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん‥‥」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 53, "speaker": 31, "form": "dlg", "jp": "「オイ、弱気なことを言うなよ！」"},
{"id": 54, "speaker": 15, "form": "dlg", "jp": "「言わないわよ！」"},
{"id": 55, "speaker": 15, "form": "dlg", "jp": "「私が一番ナゴムちゃんを信じてるんだから！」"},
{"id": 56, "speaker": 15, "form": "dlg", "jp": "「私は誰よりもナゴムちゃんを知っているのよ！」"},
{"id": 57, "speaker": 31, "form": "dlg", "jp": "「じゃあなんだよ！」"},
{"id": 58, "speaker": 15, "form": "dlg", "jp": "「心配なの‥‥」"},
{"id": 59, "speaker": 31, "form": "dlg", "jp": "「だから、そういうことを言うなって！」"},
{"id": 60, "speaker": 31, "form": "dlg", "jp": "「ナゴムは絶対『勝つ』んだから‥‥」"},
{"id": 61, "speaker": 15, "form": "dlg", "jp": "「『勝つ』から心配なのよ‥‥」"},
{"id": 62, "speaker": 15, "form": "dlg", "jp": "「そんな、世界の救世主みたいにリッパになったら、\n　もう遠い存在になっちゃうんじゃないかって‥‥」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「ボクも心配だよ‥‥」"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "「せっかく、歴史に残るような英雄になっても」"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "「口うるさい幼馴染みに\n　つきまとわられるんじゃないかって‥‥」"},
{"id": 66, "speaker": 15, "form": "dlg", "jp": "「もう、ナゴムちゃんたら！」"},
{"id": 67, "speaker": 15, "form": "dlg", "jp": "「一生つきまとってやる！」"},
{"id": 68, "speaker": 16, "form": "dlg", "jp": "「常光寺くん‥‥」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「何？」"},
{"id": 70, "speaker": 31, "form": "dlg", "jp": "「オイ、弱気なことを言うなよ！」"},
{"id": 71, "speaker": 16, "form": "dlg", "jp": "「言わないわよ！」"},
{"id": 72, "speaker": 16, "form": "dlg", "jp": "「アキラが一番常光寺くんを信じてるんだから！」"},
{"id": 73, "speaker": 31, "form": "dlg", "jp": "「じゃあなんだよ！」"},
{"id": 74, "speaker": 16, "form": "dlg", "jp": "「心配なの‥‥」"},
{"id": 75, "speaker": 31, "form": "dlg", "jp": "「だから、そういうことを言うなって！」"},
{"id": 76, "speaker": 31, "form": "dlg", "jp": "「ナゴムは絶対『勝つ』んだから‥‥」"},
{"id": 77, "speaker": 16, "form": "dlg", "jp": "「『勝つ』から心配なのよ‥‥」"},
{"id": 78, "speaker": 16, "form": "dlg", "jp": "「そんな、世界の救世主みたいにリッパになったら、\n　もう遠い存在になっちゃうんじゃないかって‥‥」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「大丈夫だよ‥‥」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「ボクからすれば長尾の方がいつもフシギな話ばっかりして\n　遠い存在だったから‥‥」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「でも、あのフシギなヤツを倒したら、\n　やっと共通の話題ができるだろうし‥‥」"},
{"id": 82, "speaker": 16, "form": "dlg", "jp": "「そうね！」"},
{"id": 83, "speaker": 16, "form": "dlg", "jp": "「帰って来たら、アイツのフシギな話いろいろ聞かせてよ！」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「いろいろは難しいかも‥‥」"},
{"id": 85, "speaker": 16, "form": "dlg", "jp": "「どうして？」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「たぶん、あっと言う間に倒しちゃうから‥‥」"},
{"id": 87, "speaker": 16, "form": "dlg", "jp": "「約束よ！」"},
{"id": 88, "speaker": 18, "form": "dlg", "jp": "「常光寺くん‥‥」"},
{"id": 89, "speaker": 2, "form": "dlg", "jp": "「何？」"},
