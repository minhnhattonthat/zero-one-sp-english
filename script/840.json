[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／２９／ＰＭ００：３０"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "「シュン！」"},
{"id": 2, "speaker": 31, "form": "dlg", "jp": "「ウヒャァ！」"},
{"id": 3, "speaker": 31, "form": "dlg", "jp": "「ハデにあばれやがって！」"},
{"id": 4, "speaker": 35, "form": "dlg", "jp": "「で、これからどうするの？」"},
{"id": 5, "speaker": 29, "form": "dlg", "jp": "「どうするも何も、アレを止めるんでしょう？」"},
{"id": 6, "speaker": 35, "form": "dlg", "jp": "「止めるってどうやって！」"},
{"id": 7, "speaker": 31, "form": "dlg", "jp": "「それ以前に止めなきゃならないのが来たぜ！」"},
{"id": 8, "speaker": 35, "form": "dlg", "jp": "「やった！　戦闘機だ！！」"},
{"id": 9, "speaker": 29, "form": "dlg", "jp": "「喜んでいる場合じゃ無いでしょう！！」"},
{"id": 10, "speaker": 35, "form": "dlg", "jp": "「どうして？」"},
{"id": 11, "speaker": 35, "form": "dlg", "jp": "「アレ、絶対スゴイミサイル搭載してるぜ‥‥」"},
{"id": 12, "speaker": 31, "form": "dlg", "jp": "「忘れたのか？」"},
{"id": 13, "speaker": 31, "form": "dlg", "jp": "「ゲーマーの力を！！」"},
{"id": 14, "speaker": 29, "form": "dlg", "jp": "「アイツらは人間以外のものは、\n　自由に操ることができるのよ！！」"},
{"id": 15, "speaker": 35, "form": "dlg", "jp": "「あのミサイルなら大丈夫だよ！」"},
{"id": 16, "speaker": 35, "form": "dlg", "jp": "「うわっ、なんてこった！」"},
{"id": 17, "speaker": 31, "form": "dlg", "jp": "「ＵＦＯもだけど、\n　案外あの戦闘機もやっかいかもしれないな‥‥」"},
{"id": 18, "speaker": 31, "form": "dlg", "jp": "「ヘタしたら自前の兵器で勝手に自滅しちゃうかもな」"},
{"id": 19, "speaker": 35, "form": "dlg", "jp": "「オレたちもここにいたらアブナイんじゃないか？」"},
{"id": 20, "speaker": 29, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "その時！！"},
{"id": 22, "speaker": 29, "form": "dlg", "jp": "ゲーマーによって軌道を変更させられたミサイルが\nボクたちの方へ向かってきた。"},
{"id": 23, "speaker": 29, "form": "choice", "jp": "「松尾さん！」"},
{"id": 24, "speaker": 29, "form": "choice", "jp": "「ケネス！」"},
{"id": 25, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「ケネス！」"},
{"id": 27, "speaker": 31, "form": "dlg", "jp": "「ダメだ！　オレの力じゃ！」"},
{"id": 28, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 29, "speaker": 2, "form": "dlg", "jp": "「松尾さん！」"},
{"id": 30, "speaker": 35, "form": "dlg", "jp": "「うん、わかった！」"},
{"id": 31, "speaker": 35, "form": "dlg", "jp": "「シュン！」"},
{"id": 32, "speaker": 35, "form": "dlg", "jp": "ボクたちは松尾さんの能力でミサイルをかわした。"},
{"id": 33, "speaker": 35, "form": "dlg", "jp": "「シュン！」"},
{"id": 34, "speaker": 31, "form": "dlg", "jp": "「オイオイ、間一髪じゃないか！！」"},
{"id": 35, "speaker": 29, "form": "dlg", "jp": "「ミサイルを操ったってことは、\n　やっぱりゲーマーってことね‥‥」"},
{"id": 36, "speaker": 31, "form": "dlg", "jp": "「間違いないな！」"},
{"id": 37, "speaker": 31, "form": "dlg", "jp": "ＵＦＯは戦闘機を一瞬で全滅させてしまった。"},
{"id": 38, "speaker": 31, "form": "dlg", "jp": "「弱っちい軍隊だな‥‥」"},
{"id": 39, "speaker": 29, "form": "dlg", "jp": "「ゲーマーが強すぎるのよ！」"},
{"id": 40, "speaker": 29, "form": "dlg", "jp": "たしかに『ＵＦＯ』の破壊力は\n自衛隊のロボットどころではなかった。"},
{"id": 41, "speaker": 29, "form": "dlg", "jp": "もちろん、破壊力だけでなく、\nその防御力も強力だ。"},
{"id": 42, "speaker": 29, "form": "dlg", "jp": "あらゆる物をコントロールできるのだから、\nあらゆる兵器を無力化できてしまうのだ。"},
{"id": 43, "speaker": 29, "form": "dlg", "jp": "その力を目の前で見せつけられて\nボクはすっかり自信を失いかけていた。"},
{"id": 44, "speaker": 29, "form": "dlg", "jp": "「まあ、これで行動がしやすくなったわ」"},
{"id": 45, "speaker": 29, "form": "dlg", "jp": "「今のうちにあのＵＦＯを‥‥」"},
{"id": 46, "speaker": 31, "form": "dlg", "jp": "「今のうちにっていってもなぁ～」"},
{"id": 47, "speaker": 29, "form": "dlg", "jp": "「とりあえず、\n　あのＵＦＯにもっと近付いてみましょう！」"},
{"id": 48, "speaker": 29, "form": "dlg", "jp": "「早くしないと\n　また戦闘機のオカワリがやってくるわよ！」"},
{"id": 49, "speaker": 2, "form": "dlg", "jp": "「でも、近付くってどうやって！」"},
{"id": 50, "speaker": 29, "form": "dlg", "jp": "「ケネス‥‥」"},
{"id": 51, "speaker": 31, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 52, "speaker": 31, "form": "dlg", "jp": "ボクたちはケネスの能力を使って\n問題のＵＦＯに近付くことになった。"},
{"id": 53, "speaker": 35, "form": "dlg", "jp": "「うわわわわ‥‥」"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "「なさけない声を出さないでよ！」"},
{"id": 55, "speaker": 35, "form": "dlg", "jp": "「だって‥‥」"},
{"id": 56, "speaker": 31, "form": "dlg", "jp": "「安心しろ、絶対落とさないから‥‥」"},
{"id": 57, "speaker": 31, "form": "dlg", "jp": "「で、どうする？」"},
{"id": 58, "speaker": 29, "form": "dlg", "jp": "「どうするって、やっつけるんでしょ？」"},
{"id": 59, "speaker": 29, "form": "choice", "jp": "「当たり前だろう！」"},
{"id": 60, "speaker": 29, "form": "choice", "jp": "「ボクたちでできるかな？」"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "「当たり前だろう！」"},
{"id": 62, "speaker": 2, "form": "dlg", "jp": "「そのために来たんだから！」"},
{"id": 63, "speaker": 2, "form": "dlg", "jp": "「ボクたちでできるかな？」"},
{"id": 64, "speaker": 29, "form": "dlg", "jp": "「今になってそんなこと言わないでよ！！」"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "「アンタたちのために来たんだから！」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「あの破壊力を見せつけられちゃうと‥‥」"},
{"id": 68, "speaker": 31, "form": "dlg", "jp": "「まあ、\n　正攻法で戦っても勝ち目はないな‥‥」"},
{"id": 69, "speaker": 31, "form": "dlg", "jp": "「なんか、戦略をねらないと‥‥」"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "「そうだね‥‥」"},
{"id": 71, "speaker": 35, "form": "dlg", "jp": "「戦略なんかたてなくても、ナゴムくんの力なら\n　あんなの簡単に破壊できるんじゃぁ？」"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "「さあ、それはどうかしら？」"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「私たちはあのＵＦＯの強さを十分に知らないのよ」"},
{"id": 74, "speaker": 29, "form": "choice", "jp": "「大丈夫だよ！」"},
{"id": 75, "speaker": 29, "form": "choice", "jp": "「そのとおりだね‥‥」"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "「大丈夫だよ！」"},
{"id": 77, "speaker": 35, "form": "dlg", "jp": "「だよね？」"},
{"id": 78, "speaker": 35, "form": "dlg", "jp": "「なんたって、\n　ナゴムくんは戦車より強いんだから‥‥」"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "「でも、\n　あのＵＦＯだって戦闘機より強いのよ！」"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "「そのとおりだね‥‥」"},
{"id": 81, "speaker": 2, "form": "dlg", "jp": "「あのＵＦＯの強さは未知数だからね」"},
{"id": 82, "speaker": 31, "form": "dlg", "jp": "「もっとあのＵＦＯのことを調べないとな‥‥」"},
{"id": 83, "speaker": 31, "form": "choice", "jp": "「もっと近寄ってみようか？」"},
{"id": 84, "speaker": 31, "form": "choice", "jp": "「ＵＦＯの中に入ってみる？」"},
{"id": 85, "speaker": 31, "form": "choice", "jp": "「ＵＦＯのことは気にしなくても‥‥」"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「もっと近寄ってみようか？」"},
{"id": 87, "speaker": 31, "form": "dlg", "jp": "「あぶなくないか？」"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "「そうね」"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "「私たちはまだあのＵＦＯについて何も知らないし、\n　あんまりウカツな行動は‥‥」"},
{"id": 90, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 91, "speaker": 2, "form": "choice", "jp": "「一旦、本部に行こうよ！」"},
{"id": 92, "speaker": 2, "form": "choice", "jp": "「ＵＦＯの中に入ってみる？」"},
{"id": 93, "speaker": 2, "form": "choice", "jp": "「ＵＦＯのことは気にしなくても‥‥」"},
{"id": 94, "speaker": 2, "form": "dlg", "jp": "「一旦、本部に行こうよ！」"},
{"id": 95, "speaker": 35, "form": "dlg", "jp": "「ダメだよ！」"},
{"id": 96, "speaker": 35, "form": "dlg", "jp": "「あのＵＦＯをそのままにして、\n　この国を離れるなんて出来ないよ！」"},
{"id": 97, "speaker": 2, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 98, "speaker": 35, "form": "dlg", "jp": "「何か方法があるんじゃないかな？」"},
{"id": 99, "speaker": 35, "form": "choice", "jp": "「ＵＦＯの中に入ってみる？」"},
{"id": 100, "speaker": 35, "form": "choice", "jp": "「ＵＦＯのことは気にしなくても‥‥」"},
{"id": 101, "speaker": 2, "form": "dlg", "jp": "「ＵＦＯの中に入ってみる？」"},
{"id": 102, "speaker": 31, "form": "dlg", "jp": "「オイオイ、ムチャを言うなよ！」"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "「待って！」"},
{"id": 104, "speaker": 29, "form": "dlg", "jp": "「それっていい考えかも！！」"},
{"id": 105, "speaker": 29, "form": "dlg", "jp": "「あんな乗り物に乗っているっていうことは、\n　案外ゲーマー自身は非力なのかも‥‥」"},
{"id": 106, "speaker": 31, "form": "dlg", "jp": "「そうか、あのＵＦＯは破壊できなくても、\n　操縦しているゲーマーを倒せば！」"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「ＵＦＯのことは気にしなくても‥‥」"},
{"id": 108, "speaker": 35, "form": "dlg", "jp": "「何いってるんだよ！」"},
{"id": 109, "speaker": 35, "form": "dlg", "jp": "「あんなの放っておけないよ！」"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「いや、そうじゃなくって」"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "「ＵＦＯを破壊できなくても、\n　コントロールしているパイロットを倒せば‥‥」"},
{"id": 112, "speaker": 35, "form": "dlg", "jp": "「たしかにそうだけど‥‥」"},
{"id": 113, "speaker": 35, "form": "dlg", "jp": "「パイロットってゲーマーだろう？」"},
{"id": 114, "speaker": 35, "form": "dlg", "jp": "「そんなに簡単に倒せるとは‥‥」"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "「そうかなぁ？」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「案外ゲーマーって非力なんじゃないかな？」"},
{"id": 117, "speaker": 35, "form": "dlg", "jp": "「そんなわけないだろう！」"},
{"id": 118, "speaker": 35, "form": "dlg", "jp": "「人類を滅ぼすほどの力をもってるんだぜ？」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「だから、それはゲーマーの能力のことだろう」"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "「確かに、このＵＦＯや天変地異は強力だけど\n　ゲーマー自身はどれだけ力を持ってるんだろう？」"},
{"id": 121, "speaker": 29, "form": "dlg", "jp": "「確かにその通りね‥‥」"},
{"id": 122, "speaker": 29, "form": "dlg", "jp": "「ゲーマーがそんなに強いんなら、\n　わざわざあんな乗り物に乗る必要ないものね！」"},
{"id": 123, "speaker": 35, "form": "dlg", "jp": "「そのゲーマーを倒すために\n　あの中に入るのは納得できたけど」"},
{"id": 124, "speaker": 35, "form": "dlg", "jp": "「どうやってあの中に入るつもり？」"},
{"id": 125, "speaker": 31, "form": "dlg", "jp": "「それはアスカの能力で‥‥」"},
{"id": 126, "speaker": 35, "form": "dlg", "jp": "「ダメだよ！！」"},
{"id": 127, "speaker": 35, "form": "dlg", "jp": "「オレの能力はイメージできる場所にしか\n　移動できないんだから‥‥」"},
{"id": 128, "speaker": 35, "form": "dlg", "jp": "「見たこともないＵＦＯの中なんて、\n　絶対移動できないよ！」"},
{"id": 129, "speaker": 29, "form": "dlg", "jp": "「難しく考えちゃダメよ！」"},
{"id": 130, "speaker": 29, "form": "dlg", "jp": "「あのＵＦＯの中をイメージしなくても、\n　ＵＦＯの中に移動できる方法があるでしょう！」"},
{"id": 131, "speaker": 35, "form": "dlg", "jp": "「例えば‥‥？」"},
{"id": 132, "speaker": 29, "form": "dlg", "jp": "「あのＵＦＯの『装甲の１メートル向こう』とかイメージして\n　テレポートさせてくれればいいのよ！」"},
{"id": 133, "speaker": 35, "form": "dlg", "jp": "「そうか！」"},
{"id": 134, "speaker": 35, "form": "dlg", "jp": "「でも、装甲が１メートル以上あったら装甲の中に\n　めりこんじゃうけどね」"},
{"id": 135, "speaker": 29, "form": "dlg", "jp": "「そのあたりはイチかバチかね‥‥」"},
{"id": 136, "speaker": 31, "form": "dlg", "jp": "「って言うか、\n　すべてがイチかバチかっぽいんだけど‥‥」"},
{"id": 137, "speaker": 29, "form": "dlg", "jp": "「ゴチャゴチャ言わないの！」"},
{"id": 138, "speaker": 29, "form": "dlg", "jp": "「とっとと片付けてしまって、\n　早く本部へいかないと‥‥」"},
{"id": 139, "speaker": 31, "form": "dlg", "jp": "「ハイハイ‥‥」"},
{"id": 140, "speaker": 29, "form": "dlg", "jp": "「じゃあ、アスカお願いね！」"},
{"id": 141, "speaker": 35, "form": "dlg", "jp": "「どうなっても知らないよ？」"},
{"id": 142, "speaker": 35, "form": "dlg", "jp": "「じゃあ、行くからね！」"},
{"id": 143, "speaker": 35, "form": "dlg", "jp": "「シュン！」"},
{"id": 144, "speaker": 35, "form": "dlg", "jp": "ボクたちは松尾さんの能力で\nＵＦＯの中に突入することになった。"},
{"id": 145, "speaker": 35, "form": "dlg", "jp": "「シュン！」"},
{"id": 146, "speaker": 29, "form": "dlg", "jp": "「うまくいったじゃない！」"},
{"id": 147, "speaker": 35, "form": "dlg", "jp": "「念のため、２メートル内側をイメージしたんだけどね」"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「で、肝心のゲーマーは？」"},
{"id": 149, "speaker": 29, "form": "dlg", "jp": "「そういえば、全然気配がしないわ！」"},
{"id": 150, "speaker": 29, "form": "choice", "jp": "【観察する】"},
{"id": 151, "speaker": 29, "form": "choice", "jp": "【話す】"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "【観察する】"},
{"id": 153, "speaker": 29, "form": "dlg", "jp": "ボクは周りを観察した。"},
{"id": 154, "speaker": 2, "form": "dlg", "jp": "（このＵＦＯなんかヘンだぞ？）"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "周りを見渡したボクはおかしな印象を受け取った。"},
{"id": 156, "speaker": 2, "form": "dlg", "jp": "（いったいこの『違和感』は何だろう？）"},
{"id": 157, "speaker": 2, "form": "choice", "jp": "【もっと観察する】"},
{"id": 158, "speaker": 2, "form": "choice", "jp": "【話す】"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "【もっと観察する】"},
{"id": 160, "speaker": 2, "form": "dlg", "jp": "ボクはもっと観察してみた。"},
{"id": 161, "speaker": 2, "form": "dlg", "jp": "しかし、何も変わったものは見つからなかった。"},
{"id": 162, "speaker": 2, "form": "dlg", "jp": "そこには、\nよく見るような機械がならんでいるだけだった。"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "「‥‥！！」"},
{"id": 164, "speaker": 2, "form": "dlg", "jp": "（‥‥なんで、地球の機械と似たような機械が\n　ならんでるんだ？）"},
{"id": 165, "speaker": 2, "form": "dlg", "jp": "【話す】"},
{"id": 166, "speaker": 2, "form": "choice", "jp": "【ジーンと話す】"},
{"id": 167, "speaker": 2, "form": "choice", "jp": "【ケネスと話す】"},
{"id": 168, "speaker": 2, "form": "choice", "jp": "【松尾さんと話す】"},
{"id": 169, "speaker": 2, "form": "dlg", "jp": "【ジーンと話す】"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "ボクはジーンに話しかけた。"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "「ジーン‥‥」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「なんか違和感を感じないか？」"},
{"id": 173, "speaker": 29, "form": "dlg", "jp": "「ナゴムも気付いたの？」"},
{"id": 174, "speaker": 2, "form": "dlg", "jp": "「なんだろう、この違和感は？」"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "「なんだ、気付いてないのね！」"},
{"id": 176, "speaker": 29, "form": "dlg", "jp": "「ここに並んでいる機械をよく見て！」"},
{"id": 177, "speaker": 29, "form": "dlg", "jp": "しかし、何も変わったものは見つからなかった。"},
{"id": 178, "speaker": 29, "form": "dlg", "jp": "そこにはよく見るような機械がならんでいるだけだった。"},
{"id": 179, "speaker": 2, "form": "dlg", "jp": "「別に変わった機械じゃなさそうだけど‥‥」"},
{"id": 180, "speaker": 29, "form": "dlg", "jp": "「ヘンでしょう？」"},
{"id": 181, "speaker": 29, "form": "choice", "jp": "「別にヘンじゃないだろう？」"},
{"id": 182, "speaker": 29, "form": "choice", "jp": "「そういえばヘンだな‥‥」"},
{"id": 183, "speaker": 2, "form": "dlg", "jp": "「別にヘンじゃないだろう？」"},
{"id": 184, "speaker": 29, "form": "dlg", "jp": "「まだ、わからないの？」"},
{"id": 185, "speaker": 29, "form": "dlg", "jp": "「どうして、未知の乗り物の中に、\n　見たことあるような機械が並んでいるの？」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「そういえばヘンだな‥‥」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「地球人の乗り物じゃないのに、\n　見なれた機械だなんて‥‥」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "【ケネスと話す】"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "ボクはケネスに話しかけた。"},
{"id": 190, "speaker": 2, "form": "dlg", "jp": "「ケネス‥‥」"},
{"id": 191, "speaker": 2, "form": "dlg", "jp": "「なんか違和感を感じないか？」"},
{"id": 192, "speaker": 31, "form": "dlg", "jp": "「ぜんぜん‥‥」"},
{"id": 193, "speaker": 31, "form": "dlg", "jp": "「ごくごく普通だと思うぜ！」"},
{"id": 194, "speaker": 29, "form": "dlg", "jp": "「それがおかしいでしょ？」"},
{"id": 195, "speaker": 29, "form": "dlg", "jp": "「どうして、未知の乗り物の中に、\n　見たことあるような機械が並んでいるの？」"},
{"id": 196, "speaker": 29, "form": "dlg", "jp": "【松尾さんと話す】"},
{"id": 197, "speaker": 29, "form": "dlg", "jp": "ボクは松尾さんに話しかけた。"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "「松尾さん‥‥」"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "「なんか違和感を感じない？」"},
{"id": 200, "speaker": 35, "form": "dlg", "jp": "「ぜんぜん‥‥」"},
{"id": 201, "speaker": 35, "form": "dlg", "jp": "「普通の機械が並んでいる普通の乗り物だと思うけど？」"},
{"id": 202, "speaker": 29, "form": "dlg", "jp": "「それがおかしいでしょ？」"},
{"id": 203, "speaker": 29, "form": "dlg", "jp": "「どうして、未知の乗り物の中に、\n　見たことあるような機械が並んでいるの？」"},
{"id": 204, "speaker": 29, "form": "dlg", "jp": "話す。"},
{"id": 205, "speaker": 29, "form": "choice", "jp": "【ジーンと話す】"},
{"id": 206, "speaker": 29, "form": "choice", "jp": "【ケネスと話す】"},
{"id": 207, "speaker": 29, "form": "choice", "jp": "【松尾さんと話す】"},
{"id": 208, "speaker": 29, "form": "dlg", "jp": "【ジーンと話す】"},
{"id": 209, "speaker": 29, "form": "dlg", "jp": "ボクはジーンに話しかけた。"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "「ジーン‥‥」"},
{"id": 211, "speaker": 29, "form": "dlg", "jp": "「ねえ、なにかヘンだと思わない？」"},
{"id": 212, "speaker": 2, "form": "dlg", "jp": "「何が？」"},
{"id": 213, "speaker": 29, "form": "dlg", "jp": "「よく観察してみてよ！」"},
{"id": 214, "speaker": 29, "form": "dlg", "jp": "ボクは周りを観察した。"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "（このＵＦＯなんかヘンだぞ？）"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "周りを見渡したボクはおかしな印象を受け取った。"},
{"id": 217, "speaker": 2, "form": "dlg", "jp": "（いったいこの『違和感』は何だろう？）"},
{"id": 218, "speaker": 2, "form": "choice", "jp": "【もっと観察する】"},
{"id": 219, "speaker": 2, "form": "choice", "jp": "【話す】"},
{"id": 220, "speaker": 2, "form": "dlg", "jp": "【もっと観察する】"},
{"id": 221, "speaker": 2, "form": "dlg", "jp": "ボクはもっと観察してみた。"},
{"id": 222, "speaker": 2, "form": "dlg", "jp": "しかし、何も変わったものは見つからなかった。"},
{"id": 223, "speaker": 2, "form": "dlg", "jp": "そこには、\nよく見るような機械がならんでいるだけだった。"},
{"id": 224, "speaker": 2, "form": "dlg", "jp": "「‥‥！！」"},
{"id": 225, "speaker": 2, "form": "dlg", "jp": "（なんで、\n　地球の機械と似たような機械がならんでるんだ？）"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「そういえばヘンだな‥‥」"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "「地球人の乗り物じゃないのに、\n　見なれた機械だなんて‥‥」"},
{"id": 228, "speaker": 2, "form": "dlg", "jp": "【話す】"},
{"id": 229, "speaker": 2, "form": "dlg", "jp": "ジーンに話しかけてみた。"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「なんか違和感を感じるけど？」"},
{"id": 231, "speaker": 29, "form": "dlg", "jp": "「ナゴムも気付いたの？」"},
{"id": 232, "speaker": 2, "form": "dlg", "jp": "「なんだろう、この違和感は？」"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "「なんだ、気付いてないのね！」"},
{"id": 234, "speaker": 29, "form": "dlg", "jp": "「ここに並んでいる機械を良く見て！」"},
{"id": 235, "speaker": 29, "form": "dlg", "jp": "しかし、何も変わったものは見つからなかった。"},
{"id": 236, "speaker": 29, "form": "dlg", "jp": "そこには、\nよく見るような機械がならんでいるだけだった。"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「別に変わった機械じゃなさそうだけど‥‥」"},
{"id": 238, "speaker": 29, "form": "dlg", "jp": "「ヘンでしょう？」"},
{"id": 239, "speaker": 29, "form": "choice", "jp": "「別にヘンじゃないだろう？」"},
{"id": 240, "speaker": 29, "form": "choice", "jp": "「そういえばヘンだな‥‥」"},
{"id": 241, "speaker": 2, "form": "dlg", "jp": "「別にヘンじゃないだろう？」"},
{"id": 242, "speaker": 29, "form": "dlg", "jp": "「まだ、わからないの？」"},
{"id": 243, "speaker": 29, "form": "dlg", "jp": "「どうして、未知の乗り物の中に、\n　見たことあるような機械が並んでいるの？」"},
{"id": 244, "speaker": 29, "form": "dlg", "jp": "【ケネスと話す】"},
{"id": 245, "speaker": 29, "form": "dlg", "jp": "ボクはケネスに話しかけた。"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "「ケネス‥‥」"},
{"id": 247, "speaker": 31, "form": "dlg", "jp": "「いったい、どこ消えやがったんだ？」"},
{"id": 248, "speaker": 31, "form": "dlg", "jp": "「ゲーマーの野郎！！」"},
{"id": 249, "speaker": 31, "form": "choice", "jp": "【ジーンと話す】"},
{"id": 250, "speaker": 31, "form": "choice", "jp": "【松尾さんと話す】"},
{"id": 251, "speaker": 31, "form": "dlg", "jp": "【松尾さんと話す】"},
{"id": 252, "speaker": 31, "form": "dlg", "jp": "ボクは松尾さんに話しかけた。"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "「松尾さん‥‥」"},
{"id": 254, "speaker": 35, "form": "dlg", "jp": "「いないね、ゲーマー？」"},
{"id": 255, "speaker": 35, "form": "choice", "jp": "【ジーンと話す】"},
{"id": 256, "speaker": 35, "form": "choice", "jp": "【ケネスと話す】"},
{"id": 257, "speaker": 2, "form": "dlg", "jp": "「ジーン、やっぱりヘンだよ！」"},
{"id": 258, "speaker": 29, "form": "dlg", "jp": "「ナゴムもそう思う？」"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "「じゃあ、ジーン‥‥も？」"},
{"id": 260, "speaker": 29, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 261, "speaker": 31, "form": "dlg", "jp": "「オイ、\n　いったいなんの話をしているんだ？」"},
{"id": 262, "speaker": 29, "form": "dlg", "jp": "「ねえ、ここを見て何もおかしいと思わないの？」"},
{"id": 263, "speaker": 31, "form": "dlg", "jp": "「ぜんぜん‥‥」"},
{"id": 264, "speaker": 31, "form": "dlg", "jp": "「ごくごく普通だと思うぜ！」"},
{"id": 265, "speaker": 29, "form": "dlg", "jp": "「それがおかしいでしょ？」"},
{"id": 266, "speaker": 29, "form": "dlg", "jp": "「どうして、未知の乗り物の中に、\n　見たことあるような機械が並んでいるの？」"},
{"id": 267, "speaker": 31, "form": "dlg", "jp": "「そういえば！！」"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "「ジーン、やっぱりヘンだよ！」"},
{"id": 269, "speaker": 29, "form": "dlg", "jp": "「でしょう？」"},
{"id": 270, "speaker": 29, "form": "dlg", "jp": "「この部品なんてアメリカのメーカーのものよ！」"},
{"id": 271, "speaker": 31, "form": "dlg", "jp": "「オイオイ、コッチの部品も\n　アメリカの軍事メーカーのヤツだぜ！」"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "「っていうことは！？」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「このＵＦＯはアメリカ製！？」"},
{"id": 274, "speaker": 29, "form": "dlg", "jp": "「みたいね‥‥」"},
{"id": 275, "speaker": 31, "form": "dlg", "jp": "「そういえば米軍が極秘で\n　ＵＦＯを作ってるってウワサがあったな‥‥」"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "「じゃあゲーマーの乗り物じゃあないの？」"},
{"id": 277, "speaker": 29, "form": "dlg", "jp": "「そうみたいね‥‥」"},
{"id": 278, "speaker": 31, "form": "dlg", "jp": "「どうりで、パイロットの姿がないはずだ‥‥」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "「じゃあコイツも？」"},
{"id": 280, "speaker": 29, "form": "dlg", "jp": "「ゲーマーにただ操られているだけみたいね‥‥」"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "「そんな～～」"},
{"id": 282, "speaker": 29, "form": "dlg", "jp": "「そんなにがっくりしないで！」"},
{"id": 283, "speaker": 29, "form": "dlg", "jp": "「未知のものじゃないんだったら、\n　簡単に破壊できるかも‥‥」"},
{"id": 284, "speaker": 29, "form": "dlg", "jp": "「どっちにしても、\n　コイツを止めなくちゃいけないんでしょう？」"},
{"id": 285, "speaker": 31, "form": "dlg", "jp": "「オイ、コレ見ろよ！」"},
{"id": 286, "speaker": 29, "form": "dlg", "jp": "「レーダーみたいね？」"},
{"id": 287, "speaker": 31, "form": "dlg", "jp": "「なんか近付いてくるぜ！」"},
{"id": 288, "speaker": 29, "form": "dlg", "jp": "「ちょっと待って‥‥」"},
{"id": 289, "speaker": 29, "form": "dlg", "jp": "「能力で調べてみるわ！」"},
{"id": 290, "speaker": 29, "form": "dlg", "jp": "ジーンは能力を使って、レーダーの陰を追いかけた。"},
{"id": 291, "speaker": 29, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 292, "speaker": 29, "form": "dlg", "jp": "「マズイわよ！」"},
{"id": 293, "speaker": 31, "form": "dlg", "jp": "「なんなんだ？」"},
{"id": 294, "speaker": 29, "form": "dlg", "jp": "「応援の"},
{"id": 295, "speaker": 29, "form": "dlg", "jp": "戦闘機が来る"},
{"id": 296, "speaker": 29, "form": "dlg", "jp": "みたい！！」"},
{"id": 297, "speaker": 31, "form": "dlg", "jp": "「なんだって！」"},
{"id": 298, "speaker": 31, "form": "dlg", "jp": "「わかってない連中だな‥‥」"},
{"id": 299, "speaker": 31, "form": "dlg", "jp": "「また操られて、被害が増えるだけだろう！」"},
{"id": 300, "speaker": 29, "form": "dlg", "jp": "「とにかく早くコイツをぶっ壊してしまわないと\n　どんどんやってくるでしょうね？」"},
{"id": 301, "speaker": 2, "form": "dlg", "jp": "「壊すって‥‥？」"},
{"id": 302, "speaker": 31, "form": "dlg", "jp": "「それはホラ‥‥」"},
{"id": 303, "speaker": 31, "form": "dlg", "jp": "「戦車より強いナゴムくんの出番ってことか‥‥」"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "「ええっ～～！」"},
{"id": 305, "speaker": 31, "form": "dlg", "jp": "「簡単だろう？」"},
{"id": 306, "speaker": 31, "form": "dlg", "jp": "「別に宇宙人の乗り物ってワケじゃ\n　なさそうだし‥‥」"},
{"id": 307, "speaker": 31, "form": "dlg", "jp": "「あのカボチャ野郎の時みたいにガツーンと！」"},
{"id": 308, "speaker": 29, "form": "dlg", "jp": "「そうね、それしか考えられないわね‥‥」"},
{"id": 309, "speaker": 2, "form": "dlg", "jp": "「わかったよ！」"},
{"id": 310, "speaker": 2, "form": "dlg", "jp": "「で、コイツの動力源はどこなんだよ？」"},
{"id": 311, "speaker": 29, "form": "dlg", "jp": "「それなら。チェック済みよ！」"},
{"id": 312, "speaker": 29, "form": "dlg", "jp": "「丁度この"},
{"id": 313, "speaker": 29, "form": "dlg", "jp": "天井の真上"},
{"id": 314, "speaker": 29, "form": "dlg", "jp": "よ！」"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "「そんなとこ、どうやって攻撃するんだよ！」"},
{"id": 316, "speaker": 29, "form": "dlg", "jp": "「外から攻撃するしかなさそうね‥‥」"},
{"id": 317, "speaker": 29, "form": "dlg", "jp": "「アスカ、頼んだわよ！！」"},
{"id": 318, "speaker": 35, "form": "dlg", "jp": "「ＯＫ！！」"},
{"id": 319, "speaker": 29, "form": "dlg", "jp": "「いい？」"},
{"id": 320, "speaker": 29, "form": "dlg", "jp": "「急いで破壊するのよ！」"},
{"id": 321, "speaker": 29, "form": "dlg", "jp": "「そうしないと、また戦闘機が‥‥」"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "「わかってるよ！」"},
{"id": 323, "speaker": 35, "form": "dlg", "jp": "「じゃあ、いくよ！」"},
{"id": 324, "speaker": 31, "form": "dlg", "jp": "「頼んだぞ！！」"},
{"id": 325, "speaker": 31, "form": "dlg", "jp": "「シュン！」"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "（とにかく、早くコイツを片付けてしまわないと‥‥）"},
{"id": 327, "speaker": 2, "form": "dlg", "jp": "ボクは能力を使って筋力アップした。"},
{"id": 328, "speaker": 2, "form": "dlg", "jp": "（あとは、ロボットの時と同じように‥‥）"},
{"id": 329, "speaker": 29, "form": "dlg", "jp": "（何ぐずぐすしてるのっ！）"},
{"id": 330, "speaker": 2, "form": "dlg", "jp": "（でも‥‥）"},
{"id": 331, "speaker": 29, "form": "dlg", "jp": "（応援の戦闘機が到着したわ！）"},
{"id": 332, "speaker": 2, "form": "dlg", "jp": "（なんだって！）"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "戦闘機のミサイルは当然、ＵＦＯに"},
{"id": 334, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 335, "speaker": 2, "form": "dlg", "jp": "（やったよジーン！）"},
{"id": 336, "speaker": 29, "form": "dlg", "jp": "（わかったわ！）"},
{"id": 337, "speaker": 29, "form": "dlg", "jp": "（すぐに脱出しましょう！）"},
{"id": 338, "speaker": 35, "form": "dlg", "jp": "（じゃあ、いくよ！）"},
{"id": 339, "speaker": 35, "form": "dlg", "jp": "「シュン！」"},
{"id": 340, "speaker": 35, "form": "dlg", "jp": "松尾さんはロボットの時と同様に\nボクを安全な場所まで移動してくれた。"},
{"id": 341, "speaker": 35, "form": "dlg", "jp": "「シュン！」"},
{"id": 342, "speaker": 35, "form": "dlg", "jp": "「やっぱ、ナゴムくんはスゴイね！」"},
{"id": 343, "speaker": 2, "form": "dlg", "jp": "「松尾さんこそいつもありがとう」"},
{"id": 344, "speaker": 29, "form": "dlg", "jp": "「見て！」"},
{"id": 345, "speaker": 31, "form": "dlg", "jp": "「ざまあ、見ろ！！」"},
{"id": 346, "speaker": 2, "form": "dlg", "jp": "「そういえば」"},
{"id": 347, "speaker": 2, "form": "dlg", "jp": "「応援の戦闘機はどうなったの？」"},
{"id": 348, "speaker": 29, "form": "dlg", "jp": "「引き返したみたい‥‥」"},
{"id": 349, "speaker": 2, "form": "dlg", "jp": "「じゃあ？」"},
{"id": 350, "speaker": 29, "form": "dlg", "jp": "「ここはもう大丈夫よ！」"},
{"id": 351, "speaker": 29, "form": "dlg", "jp": "「さあ、戻って本部へ行く準備をしましょう！」"},
{"id": 352, "speaker": 31, "form": "dlg", "jp": "「うんそうだな‥‥」"},
{"id": 353, "speaker": 31, "form": "dlg", "jp": "「シュン！」"},
{"id": 354, "speaker": 31, "form": "dlg", "jp": "失敗の原因は決断力不足。\nもっと素早く決断していれば‥‥"},
{"id": 355, "speaker": 31, "form": "dlg", "jp": "失敗の原因は能力を判断ミス。\nケネスの能力はスピードを必要とする移動には不向き。"},
{"id": 356, "speaker": 31, "form": "dlg", "jp": "失敗の原因は能力を\nうまくコントロールできなかったこと。\nタイミングをつかめばそんなに難しくないはず。"}
]
