[
{"id": 0, "speaker": null, "form": "dlg", "jp": "『マチュピチュ』‥‥"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "アンデス山脈の標高２４００ｍにあるインカ文明の遺跡。"},
{"id": 2, "speaker": null, "form": "dlg", "jp": "１６世紀にインカ人がスペイン人から逃れるために築いた\n要塞都市と言われている。"},
{"id": 3, "speaker": null, "form": "dlg", "jp": "しかし、遺跡の古いものは２０００年前のものもあり、\n真実は未だ解明されていない。"},
{"id": 4, "speaker": 35, "form": "dlg", "jp": "「‥‥‥‥」"},
{"id": 5, "speaker": 35, "form": "dlg", "jp": "「ねえ、こんな所に本当に本部なんてあるの？」"},
{"id": 6, "speaker": 35, "form": "dlg", "jp": "「ここ観光客いっぱいいるじゃん！」"},
{"id": 7, "speaker": 29, "form": "dlg", "jp": "「こんな目立つ場所にあるわけないでしょ！」"},
{"id": 8, "speaker": 35, "form": "dlg", "jp": "「ここにあるって言ったじゃないか！」"},
{"id": 9, "speaker": 29, "form": "dlg", "jp": "「あるのはこの"},
{"id": 10, "speaker": 29, "form": "dlg", "jp": "地下"},
{"id": 11, "speaker": 29, "form": "dlg", "jp": "よ！」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「地下！？」"},
{"id": 13, "speaker": 2, "form": "dlg", "jp": "ボクたちは秘密の通路に案内された。"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "この通路は地下の本部につながっているらしい。"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "ボクたちは通路を長時間かけて下っていった。"},
{"id": 16, "speaker": 29, "form": "dlg", "jp": "「さあ、ついたわよ！」"},
{"id": 17, "speaker": 29, "form": "dlg", "jp": "「ここが『Ｅ－ｇｒｏ』の本部よ‥‥」"},
{"id": 18, "speaker": 15, "form": "dlg", "jp": "「どうして、こんなところに？」"},
{"id": 19, "speaker": 16, "form": "dlg", "jp": "「どうして、こんなところに？」"},
{"id": 20, "speaker": 18, "form": "dlg", "jp": "「どうして、こんなところに？」"},
{"id": 21, "speaker": 29, "form": "dlg", "jp": "「私たちは本部をどうしても\n　ここに作らなきゃいけなかった理由があるのよ‥‥」"},
{"id": 22, "speaker": 29, "form": "dlg", "jp": "「というより、もともとここに『本部』があって」"},
{"id": 23, "speaker": 29, "form": "dlg", "jp": "「そこに『Ｅ－ｇｒｏ』が結成されたって感じなの」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「その理由って？」"},
{"id": 25, "speaker": 29, "form": "dlg", "jp": "「それは後で説明するわ‥‥」"},
{"id": 26, "speaker": 29, "form": "dlg", "jp": "「それより、まず"},
{"id": 27, "speaker": 29, "form": "dlg", "jp": "『リーダー』"},
{"id": 28, "speaker": 29, "form": "dlg", "jp": "に紹介しないとね‥‥」"},
{"id": 29, "speaker": 29, "form": "dlg", "jp": "「ついて来て‥‥」"},
{"id": 30, "speaker": 29, "form": "dlg", "jp": "ジーンはそう言って歩き始めた。"},
{"id": 31, "speaker": 29, "form": "dlg", "jp": "「ここが『Ｅ－ｇｒｏ』の『指令室』‥‥」"},
{"id": 32, "speaker": 29, "form": "dlg", "jp": "「『メインホール』よ」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「遺跡の中にこんな近代的な設備があるなんて‥‥」"},
{"id": 34, "speaker": 29, "form": "dlg", "jp": "「近代的っていうより、『超近代的』ね‥‥」"},
{"id": 35, "speaker": 29, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』には識者や\n　富豪のスポンサーがついてるから」"},
{"id": 36, "speaker": 29, "form": "dlg", "jp": "「その人たちの援助のおかげね‥‥」"},
{"id": 37, "speaker": 2, "form": "dlg", "jp": "「そんな人たちまで『超能力者』なの？」"},
{"id": 38, "speaker": 29, "form": "dlg", "jp": "「違うわ‥‥」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』は『超能力者』の集団じゃあ？」"},
{"id": 40, "speaker": 29, "form": "dlg", "jp": "「だから、援助をしてもらっているだけで\n　メンバーってわけじゃないから‥‥」"},
{"id": 41, "speaker": 29, "form": "dlg", "jp": "「いくら『超能力者』でも\n　お金がないと生きてゆけないでしょう？」"},
{"id": 42, "speaker": 2, "form": "dlg", "jp": "「でも、よく協力してくれるよね？」"},
{"id": 43, "speaker": 29, "form": "dlg", "jp": "「当たり前でしょう？」"},
{"id": 44, "speaker": 29, "form": "dlg", "jp": "「たくさん持っている人程、\n　失うのが恐いのよ！」"},
{"id": 45, "speaker": 29, "form": "dlg", "jp": "「例えば、ナゴムが一文無しで‥‥」"},
{"id": 46, "speaker": 29, "form": "dlg", "jp": "「身寄りがだれもいなくて‥‥」"},
{"id": 47, "speaker": 29, "form": "dlg", "jp": "「何をやってもダメで‥‥」"},
{"id": 48, "speaker": 29, "form": "dlg", "jp": "「世の中があなたを敵視していて‥‥」"},
{"id": 49, "speaker": 29, "form": "dlg", "jp": "「重い病気になっていたとしたら、\n　今の生活を守りたいと思う？」"},
{"id": 50, "speaker": 29, "form": "dlg", "jp": "「それとも‥‥」"},
{"id": 51, "speaker": 29, "form": "dlg", "jp": "「それとも『こんな世界なくなってしまえ』って思う？」"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 53, "speaker": 31, "form": "dlg", "jp": "「それだけじゃないな‥‥」"},
{"id": 54, "speaker": 31, "form": "dlg", "jp": "「富豪の連中はオレたちのことがコワイんだよ！」"},
{"id": 55, "speaker": 31, "form": "dlg", "jp": "「確かに能力を悪用しない限り、現在の社会で\n　『超能力者』がお金を使わずに生きていこうとしたら」"},
{"id": 56, "speaker": 31, "form": "dlg", "jp": "「お金をたよりにして生きているアイツらの立場が\n　なくなっちゃうからな‥‥」"},
{"id": 57, "speaker": 31, "form": "dlg", "jp": "「超能力者たちが本当に『能力』を\n　解放しちゃったら」"},
{"id": 58, "speaker": 31, "form": "dlg", "jp": "「『お金』や『名誉』なんて\n　価値がなくなっちゃうだろう？」"},
{"id": 59, "speaker": 31, "form": "dlg", "jp": "「だからアイツらは『援助』してくれるんだよ！」"},
{"id": 60, "speaker": 29, "form": "dlg", "jp": "「どうでもいいけど、\n　『援助』ってイヤな言葉になっちゃったわね？」"},
{"id": 61, "speaker": 29, "form": "dlg", "jp": "「とにかく！！」"},
{"id": 62, "speaker": 29, "form": "dlg", "jp": "「金持ちだろうが貧しかろうが、ほとんどの人が\n　『ゲーマー』に殺されたくなんかないのよ！」"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "「ゲーマーの攻撃が本格化した今、\n　人類のほとんどが私たちの味方ね‥‥」"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "「まあ、そうだろうね‥‥」"},
{"id": 65, "speaker": 29, "form": "dlg", "jp": "「それは私たちも同じでしょう？」"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "「すでに『国籍』も『性別』も『年令』もまったく違うのに\n　こうして協力しあえてるんだから‥‥」"},
{"id": 67, "speaker": 15, "form": "dlg", "jp": "「それはそうね‥‥」"},
{"id": 68, "speaker": 15, "form": "dlg", "jp": "「それより‥‥」"},
{"id": 69, "speaker": 15, "form": "dlg", "jp": "「『リーダー』って人に会わせてくれるんじゃ？」"},
{"id": 70, "speaker": 16, "form": "dlg", "jp": "「それはそうね‥‥」"},
{"id": 71, "speaker": 16, "form": "dlg", "jp": "「それより‥‥」"},
{"id": 72, "speaker": 16, "form": "dlg", "jp": "「『リーダー』って人に会わせてくれないの？」"},
{"id": 73, "speaker": 18, "form": "dlg", "jp": "「それはそうかも‥‥」"},
{"id": 74, "speaker": 18, "form": "dlg", "jp": "「で‥‥」"},
{"id": 75, "speaker": 18, "form": "dlg", "jp": "「『リーダー』って人は‥‥？」"},
{"id": 76, "speaker": 29, "form": "dlg", "jp": "「ゴメンなさい‥‥」"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "「いつもはここにいるハズなんだけど‥‥」"},
{"id": 78, "speaker": 4, "form": "dlg", "jp": "「ジーン！」"},
{"id": 79, "speaker": 29, "form": "dlg", "jp": "「？？？」"},
{"id": 80, "speaker": 4, "form": "dlg", "jp": "「帰ってきていたのか？」"},
{"id": 81, "speaker": 29, "form": "dlg", "jp": "「『ピリ』！！」"},
{"id": 82, "speaker": 15, "form": "dlg", "jp": "「このヒトが『リーダー』？」"},
{"id": 83, "speaker": 16, "form": "dlg", "jp": "「このヒトが『リーダー』？」"},
{"id": 84, "speaker": 18, "form": "dlg", "jp": "「こちらが『リーダー』の‥‥？」"},
{"id": 85, "speaker": 29, "form": "dlg", "jp": "「違うわよ‥‥」"},
{"id": 86, "speaker": 29, "form": "dlg", "jp": "「彼は『ピリ・ライナニ』、\n　アスカと同じ『テレポート』の使い手よ‥‥」"},
{"id": 87, "speaker": 45, "form": "dlg", "jp": "「ヨロシク‥‥」"},
{"id": 88, "speaker": 2, "form": "dlg", "jp": "「常光寺ナゴムです」"},
{"id": 89, "speaker": 35, "form": "dlg", "jp": "「松尾アスカです」"},
{"id": 90, "speaker": 15, "form": "dlg", "jp": "「三船アイコです」"},
{"id": 91, "speaker": 16, "form": "dlg", "jp": "「長尾アキラよ！」"},
{"id": 92, "speaker": 18, "form": "dlg", "jp": "「堤ナナセです」"},
{"id": 93, "speaker": 45, "form": "dlg", "jp": "「スゴイな‥‥」"},
{"id": 94, "speaker": 45, "form": "dlg", "jp": "「３人も連れて来たんだ！！」"},
{"id": 95, "speaker": 31, "form": "dlg", "jp": "「本当は５人見つけてたんだけどな‥‥」"},
{"id": 96, "speaker": 31, "form": "dlg", "jp": "「あとの２人はどーしようもないヤツだったんだよ！」"},
{"id": 97, "speaker": 45, "form": "dlg", "jp": "「でも、いいじゃん３人集まれば‥‥」"},
{"id": 98, "speaker": 45, "form": "dlg", "jp": "「ワタシなんて２人で精一杯だよ」"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "「で、『リーダー』は？」"},
{"id": 100, "speaker": 45, "form": "dlg", "jp": "「今、ニューヨークの円盤を‥‥」"},
{"id": 101, "speaker": 45, "form": "dlg", "jp": "「でも、もうすぐ帰ってくるんじゃないかな？」"},
{"id": 102, "speaker": 45, "form": "dlg", "jp": "「円盤は破壊されたってさっきニュースで流れてたから‥‥」"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "「そう‥‥」"},
{"id": 104, "speaker": 4, "form": "dlg", "jp": "「ジーン戻って来たのですね？」"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "「？？？」"},
{"id": 106, "speaker": 4, "form": "dlg", "jp": "「彼らですね、新しいメンバーというのは‥‥？」"},
{"id": 107, "speaker": 29, "form": "dlg", "jp": "「ハイ！」"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "「この子は？」"},
{"id": 109, "speaker": 29, "form": "dlg", "jp": "「バカ、ちゃんとあいさつしなさい！」"},
{"id": 110, "speaker": 4, "form": "dlg", "jp": "「あいさつは必要ありません‥‥」"},
{"id": 111, "speaker": 4, "form": "dlg", "jp": "「彼らのことはもう知っていますから‥‥‥」"},
{"id": 112, "speaker": 29, "form": "dlg", "jp": "「そ、そうですね‥‥」"},
{"id": 113, "speaker": 4, "form": "dlg", "jp": "「彼がナゴムですね‥‥」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「ハァ？」"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "「『リーダー』に向かってハアはないでしょう！」"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「リーダー！？」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「この子がぁ？」"},
{"id": 118, "speaker": 4, "form": "dlg", "jp": "「『アリス・アティック』です‥‥」"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「ハア‥‥」"},
{"id": 120, "speaker": 45, "form": "dlg", "jp": "「驚くのもムリないな‥‥」"},
{"id": 121, "speaker": 45, "form": "dlg", "jp": "「しかし、アリスは１０才にして、\n　知能指数『１３００』のスーパーキッズだから」"},
{"id": 122, "speaker": 45, "form": "dlg", "jp": "「世界のどの国の指導者より立派な指導者です‥‥」"},
{"id": 123, "speaker": 31, "form": "dlg", "jp": "「国によっては\n　普通の子供以下の指導者がいる国もあるだろうけど？」"},
{"id": 124, "speaker": 31, "form": "dlg", "jp": "「まあ、心配するな！」"},
{"id": 125, "speaker": 31, "form": "dlg", "jp": "「アリスが立派な『リーダー』なのは\n　オレが保証するから‥‥」"},
{"id": 126, "speaker": 45, "form": "dlg", "jp": "「で、ニューヨークの円盤の方は？」"},
{"id": 127, "speaker": 46, "form": "dlg", "jp": "「無事停止させて来ました」"},
{"id": 128, "speaker": 31, "form": "dlg", "jp": "「さすがは『リーダー』！！」"},
{"id": 129, "speaker": 46, "form": "dlg", "jp": "「私ではありません！」"},
{"id": 130, "speaker": 46, "form": "dlg", "jp": "「『ローズ』のおかげです」"},
{"id": 131, "speaker": 31, "form": "dlg", "jp": "「なるほど！」"},
{"id": 132, "speaker": 31, "form": "dlg", "jp": "「ローズの『生体レーザー』なら！」"},
{"id": 133, "speaker": 49, "form": "dlg", "jp": "「そんなことありませんよ！」"},
{"id": 134, "speaker": 49, "form": "dlg", "jp": "「アリスさまの\n　的確な指示があったからですよ！」"},
{"id": 135, "speaker": 35, "form": "dlg", "jp": "「『生体レーザー』って何？」"},
{"id": 136, "speaker": 31, "form": "dlg", "jp": "「元オペラ歌手のローズだからこその能力だよ！」"},
{"id": 137, "speaker": 31, "form": "dlg", "jp": "「ノドを振動させて、レーザーを発射するんだ！」"},
{"id": 138, "speaker": 35, "form": "dlg", "jp": "「ふ～ん‥‥」"},
{"id": 139, "speaker": 29, "form": "dlg", "jp": "「あの、リーダー‥‥」"},
{"id": 140, "speaker": 46, "form": "dlg", "jp": "「なんでしょう？」"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "「実はあのＵＦＯはゲーマーの乗り物ではなくて‥‥」"},
{"id": 142, "speaker": 46, "form": "dlg", "jp": "「知っています」"},
{"id": 143, "speaker": 46, "form": "dlg", "jp": "「米軍の秘密兵器ですね？」"},
{"id": 144, "speaker": 29, "form": "dlg", "jp": "「さすが『リーダー』‥‥」"},
{"id": 145, "speaker": 46, "form": "dlg", "jp": "「ＵＦＯのことはアナタがたが心配しなくても大丈夫です」"},
{"id": 146, "speaker": 46, "form": "dlg", "jp": "「まだ、試作機なので数もそんなにはないでしょう」"},
{"id": 147, "speaker": 46, "form": "dlg", "jp": "「他のメンバーに任せることにします」"},
{"id": 148, "speaker": 46, "form": "dlg", "jp": "「それより、アナタがたは少し休んでください」"},
{"id": 149, "speaker": 46, "form": "dlg", "jp": "「地球の反対側から来たのですから、\n　『時差』でさらに疲れが増しているはずです」"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "「ありがとうございます」"},
{"id": 151, "speaker": 46, "form": "dlg", "jp": "「ジーン、彼等を『ベッドルーム』へ‥‥」"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "「わかりました」"},
{"id": 153, "speaker": 29, "form": "dlg", "jp": "ボクたちは本部内の宿泊施設に案内された。"},
{"id": 154, "speaker": 29, "form": "dlg", "jp": "「ここがアナタたちが寝起きする場所よ‥‥」"},
{"id": 155, "speaker": 29, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 156, "speaker": 35, "form": "dlg", "jp": "「なんか、さみしい部屋だね‥‥」"},
{"id": 157, "speaker": 29, "form": "dlg", "jp": "「ガマンしなさい！」"},
{"id": 158, "speaker": 29, "form": "dlg", "jp": "「観光旅行じゃないんだから‥‥」"},
{"id": 159, "speaker": 35, "form": "dlg", "jp": "「オレ、家に眠りに帰ってもいい？」"},
{"id": 160, "speaker": 29, "form": "dlg", "jp": "「ダメよ！」"},
{"id": 161, "speaker": 29, "form": "dlg", "jp": "「自分だけ勝手な行動をしちゃぁ！」"},
{"id": 162, "speaker": 29, "form": "dlg", "jp": "「特にアスカはテレパシーが弱いんだから、\n　なおさら遠出は禁止よ！」"},
{"id": 163, "speaker": 35, "form": "dlg", "jp": "「そうだよね‥‥」"},
{"id": 164, "speaker": 31, "form": "dlg", "jp": "「まあ、オレは隣の部屋にいるんで\n　なんかあったらいつでも来てくれよ！」"},
{"id": 165, "speaker": 29, "form": "dlg", "jp": "「私とアイコは女性棟の方にいるから‥‥」"},
{"id": 166, "speaker": 29, "form": "dlg", "jp": "「じゃあ、ゆっくり休んでね‥‥」"},
{"id": 167, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん、ちゃんと体を休めるのよ！」"},
{"id": 168, "speaker": 29, "form": "dlg", "jp": "「じゃあ行きましょうか？」"},
{"id": 169, "speaker": 15, "form": "dlg", "jp": "「ハイ」"},
{"id": 170, "speaker": 29, "form": "dlg", "jp": "「私とアキラは女性棟の方にいるから‥‥」"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "「じゃあ、ゆっくり休んでね‥‥」"},
{"id": 172, "speaker": 16, "form": "dlg", "jp": "「常光寺くん、ちゃんと休むのよ！」"},
{"id": 173, "speaker": 29, "form": "dlg", "jp": "「じゃあ行きましょうか？」"},
{"id": 174, "speaker": 16, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "「私とナナセは女性棟の方にいるから‥‥」"},
{"id": 176, "speaker": 29, "form": "dlg", "jp": "「じゃあ、ちゃんと体を休めるのよ！！」"},
{"id": 177, "speaker": 29, "form": "dlg", "jp": "「じゃあ行きましょうか？」"},
{"id": 178, "speaker": 18, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 179, "speaker": 18, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 180, "speaker": 18, "form": "dlg", "jp": "３人は部屋を出て行った。"},
{"id": 181, "speaker": 35, "form": "dlg", "jp": "「ほんとなんにも無い部屋だね？」"},
{"id": 182, "speaker": 35, "form": "dlg", "jp": "「オレは自衛隊にいたから全然平気だけどね‥‥」"},
{"id": 183, "speaker": 35, "form": "dlg", "jp": "「ナゴムくんはどう？」"},
{"id": 184, "speaker": 35, "form": "choice", "jp": "「どうって言われても‥‥」"},
{"id": 185, "speaker": 35, "form": "choice", "jp": "「まあこんなモンでしょう？」"},
{"id": 186, "speaker": 35, "form": "choice", "jp": "「もっといい部屋がよかったですね！」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「どうって言われても‥‥」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「こんなもんでしょう？」"},
{"id": 189, "speaker": 35, "form": "dlg", "jp": "「ナゴムくんはエライねぇ‥‥」"},
{"id": 190, "speaker": 35, "form": "dlg", "jp": "「やっぱ、世界平和のために戦おうっていう人物は\n　考え方がしっかりしてるよ！」"},
{"id": 191, "speaker": 35, "form": "dlg", "jp": "「なんだか、１０年前の自分を見ているようだよ！」"},
{"id": 192, "speaker": 35, "form": "choice", "jp": "「そうなんだ？」"},
{"id": 193, "speaker": 35, "form": "choice", "jp": "「そのころはやせてたの？」"},
{"id": 194, "speaker": 35, "form": "choice", "jp": "「どんな中学生だったの？」"},
{"id": 195, "speaker": 2, "form": "dlg", "jp": "「そうなんだ？」"},
{"id": 196, "speaker": 35, "form": "dlg", "jp": "「ボクも中学のころから、\n　いつも人の為に何かできないかを考えていたからね‥‥」"},
{"id": 197, "speaker": 35, "form": "dlg", "jp": "「そのころの同級生とかは\n　自分勝手なこと考えてる連中ばっかでさ」"},
{"id": 198, "speaker": 35, "form": "dlg", "jp": "「逆にオレのことをバカにしたりしてたけど‥‥」"},
{"id": 199, "speaker": 35, "form": "dlg", "jp": "「まさか、そのオレに助けてもらうことになるなんて\n　思ってないんだろうな？」"},
{"id": 200, "speaker": 2, "form": "dlg", "jp": "「そのころはやせてたの？」"},
{"id": 201, "speaker": 35, "form": "dlg", "jp": "「やせてはなかったね！」"},
{"id": 202, "speaker": 35, "form": "dlg", "jp": "「やせてたら、\n　いざというときにパワーがでないでしょう？」"},
{"id": 203, "speaker": 35, "form": "dlg", "jp": "「そのころから世の中のために戦う大人になろうって\n　決めてたからやせないようにしていたよ！」"},
{"id": 204, "speaker": 35, "form": "dlg", "jp": "「『すもうとり』も『プロレスラー』も\n　本当に強いヤツはやせてないだろう？」"},
{"id": 205, "speaker": 35, "form": "dlg", "jp": "「イヤね、\n　確かにやせようと思ったこともあるんだよ」"},
{"id": 206, "speaker": 35, "form": "dlg", "jp": "「ホラ、テレビのグループヒーローとかって\n　太ってるヤツだけが死んだりするじゃん！」"},
{"id": 207, "speaker": 35, "form": "dlg", "jp": "「アメリカのホラー映画で、金髪で\n　ストレートヘアの女の子は死なないのと同じように」"},
{"id": 208, "speaker": 35, "form": "dlg", "jp": "「でもね、自分が死にたくないからって、\n　やせたり、金髪にするのはヒキョウだろう？」"},
{"id": 209, "speaker": 35, "form": "dlg", "jp": "「やっぱ、『正義の味方』はフェアプレイじゃないと‥‥」"},
{"id": 210, "speaker": 35, "form": "dlg", "jp": "「だから、オレはやせないようにしてるんだ‥‥」"},
{"id": 211, "speaker": 2, "form": "dlg", "jp": "「どんな中学生だったの？」"},
{"id": 212, "speaker": 35, "form": "dlg", "jp": "「常に人の役に立つ大人になることを考えている\n　フツーの中学生だったよ‥‥」"},
{"id": 213, "speaker": 2, "form": "dlg", "jp": "「そんな中学生のほうが珍しかったんじゃぁ？」"},
{"id": 214, "speaker": 35, "form": "dlg", "jp": "「フツーって多数決じゃないよね？」"},
{"id": 215, "speaker": 35, "form": "dlg", "jp": "「世の中の法則にのっとったのもフツーなんだろ！」"},
{"id": 216, "speaker": 35, "form": "dlg", "jp": "「家族全員がカゼひいて寝込んでるからって、\n　カゼをひいてるのがフツーとは言わないだろう？」"},
{"id": 217, "speaker": 35, "form": "dlg", "jp": "「それと同じだよ！」"},
{"id": 218, "speaker": 35, "form": "dlg", "jp": "「人間は社会的な動物なんだから\n　やっぱり社会貢献をするのがフツーだよ！」"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "「まあこんなモンでしょう？」"},
{"id": 220, "speaker": 35, "form": "dlg", "jp": "「ナゴムくんはエライねぇ‥‥」"},
{"id": 221, "speaker": 35, "form": "dlg", "jp": "「やっぱ、世界平和のために戦おうっていう人物は\n　考え方がしっかりしてるよ！」"},
{"id": 222, "speaker": 35, "form": "dlg", "jp": "「なんだか、１０年前の自分を見ているようだよ！」"},
{"id": 223, "speaker": 35, "form": "choice", "jp": "「そうなんだ？」"},
{"id": 224, "speaker": 35, "form": "choice", "jp": "「そのころはやせてたの？」"},
{"id": 225, "speaker": 35, "form": "choice", "jp": "「どんな中学生だったの？」"},
{"id": 226, "speaker": 2, "form": "dlg", "jp": "「もっといい部屋がよかったですね！」"},
{"id": 227, "speaker": 35, "form": "dlg", "jp": "「うーん、\n　やっぱりナゴムくんもフツーの中学生なんだな‥‥」"},
{"id": 228, "speaker": 35, "form": "dlg", "jp": "「まあ、仕方ないけどね」"},
{"id": 229, "speaker": 35, "form": "dlg", "jp": "「とりあえず、ガマンはできるだろう？」"},
{"id": 230, "speaker": 2, "form": "dlg", "jp": "「まあ‥‥」"},
{"id": 231, "speaker": 35, "form": "dlg", "jp": "「ゲーマーを倒して『平和』を手に入れるまでは\n　ガマンしようよ！」"},
{"id": 232, "speaker": 35, "form": "dlg", "jp": "「ゲーマーの攻撃がもっと本格的になったら」"},
{"id": 233, "speaker": 35, "form": "dlg", "jp": "「いい部屋どころか、\n　寝る場所すらなくなっちゃうだろうし‥‥」"},
{"id": 234, "speaker": 35, "form": "choice", "jp": "「松尾さんは立派ですね！」"},
{"id": 235, "speaker": 35, "form": "choice", "jp": "「松尾さんカッコイイ！」"},
{"id": 236, "speaker": 35, "form": "choice", "jp": "「どんな中学生だったの？」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「松尾さんは立派ですね！」"},
{"id": 238, "speaker": 35, "form": "dlg", "jp": "「フツーだよ！！」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「いいえ、立派ですよ！」"},
{"id": 240, "speaker": 35, "form": "dlg", "jp": "「だから、『立派なの』がフツーなの‥‥」"},
{"id": 241, "speaker": 35, "form": "dlg", "jp": "「フツーの大人はみんな立派なの！」"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "「松尾さんカッコイイ！」"},
{"id": 243, "speaker": 35, "form": "dlg", "jp": "「ありがとう！！」"},
{"id": 244, "speaker": 35, "form": "dlg", "jp": "「いつかそういう風に言われる人間になろうと\n　がんばってきたんだよ！」"},
{"id": 245, "speaker": 35, "form": "dlg", "jp": "「やっぱり、一番カッコイイのは、\n　マジメに生きることだろう？」"},
{"id": 246, "speaker": 35, "form": "dlg", "jp": "「それをカッコ悪いと考えるコドモが多くて\n　イヤになるんだよ！」"},
{"id": 247, "speaker": 35, "form": "dlg", "jp": "「産まれ持った黒髪を\n　黄色く染めてカッコイイっておかしいだろう？」"},
{"id": 248, "speaker": 35, "form": "dlg", "jp": "「黒髪がいやなら、そればいいのに‥‥」"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "「それより、松尾さん‥‥」"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "「『時差ボケ』とか大丈夫？」"},
{"id": 251, "speaker": 35, "form": "dlg", "jp": "「そういえば、頭がボーっとするような\n　しないような‥‥」"},
{"id": 252, "speaker": 35, "form": "dlg", "jp": "「ダメだ、少し眠るよ‥‥」"},
{"id": 253, "speaker": 2, "form": "dlg", "jp": "「それがいいですよ！」"},
{"id": 254, "speaker": 35, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 255, "speaker": 35, "form": "dlg", "jp": "「ナゴムくんも休めよ‥‥」"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "「はい‥‥」"},
{"id": 257, "speaker": 35, "form": "dlg", "jp": "「オヤスミ‥‥」"},
{"id": 258, "speaker": 35, "form": "dlg", "jp": "余程疲れていたのか、松尾さんはすぐに眠ってしまった。"},
{"id": 259, "speaker": 2, "form": "dlg", "jp": "（さてと‥‥）"},
{"id": 260, "speaker": 2, "form": "choice", "jp": "（ボクも眠るかな‥‥）"},
{"id": 261, "speaker": 2, "form": "choice", "jp": "（少し散歩でもしてくるか‥‥）"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "（ボクも眠るかな‥‥）"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "ボクも少し眠ることにした。"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "ベッドに横になったボクはそのまま眠りについた。"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "（少し散歩でもしてくるか‥‥）"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "（こんな所で寝ていても気は休まらないだろうし‥‥）"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "ボクは少し、この施設の中を探検してみることにした。"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "（どこに行こうかな？）"},
{"id": 269, "speaker": 2, "form": "dlg", "jp": "（ケネスの部屋に行ってみよう！）"},
{"id": 270, "speaker": 2, "form": "dlg", "jp": "ボクはケネスのいる隣の部屋に行くことにした。"},
{"id": 271, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 272, "speaker": 2, "form": "dlg", "jp": "「コンコン！」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「ナゴムだけど‥‥」"},
{"id": 274, "speaker": 2, "form": "dlg", "jp": "「入るよ！！」"},
{"id": 275, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 276, "speaker": 31, "form": "dlg", "jp": "「なんか用か？」"},
{"id": 277, "speaker": 2, "form": "dlg", "jp": "「たいした用はないんだけど‥‥」"},
{"id": 278, "speaker": 2, "form": "dlg", "jp": "「色々とここの話を聞こうと思って‥‥」"},
{"id": 279, "speaker": 31, "form": "dlg", "jp": "「ここの？」"},
{"id": 280, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 281, "speaker": 2, "form": "dlg", "jp": "「到着してすぐに休んでいろって感じだったんで\n　まだなんにも教えてもらってないだろう？」"},
{"id": 282, "speaker": 31, "form": "dlg", "jp": "「ああ、そうだったな‥‥」"},
{"id": 283, "speaker": 31, "form": "dlg", "jp": "「まあ、２０００年以上前の遺跡の改造だけど、\n　それなりに設備はそろってるぞ‥‥」"},
{"id": 284, "speaker": 31, "form": "dlg", "jp": "「トイレは部屋の奥にあっただろう？」"},
{"id": 285, "speaker": 31, "form": "dlg", "jp": "「シャワーは、男性用のは通路のおくにある」"},
{"id": 286, "speaker": 31, "form": "dlg", "jp": "「ただし、日本みたいにフロはないぞ！」"},
{"id": 287, "speaker": 31, "form": "dlg", "jp": "「フロに入りたきゃ、とっとと戦いを終わらせて\n　日本に帰ることだな‥‥」"},
{"id": 288, "speaker": 31, "form": "dlg", "jp": "「コンコン！」"},
{"id": 289, "speaker": 29, "form": "dlg", "jp": "「ジーンだけど‥‥」"},
{"id": 290, "speaker": 29, "form": "dlg", "jp": "「ココにナゴム来ていない？」"},
{"id": 291, "speaker": 31, "form": "dlg", "jp": "「ああ、来てるよ‥‥」"},
{"id": 292, "speaker": 31, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 293, "speaker": 29, "form": "dlg", "jp": "「ちょっと、何してんのっ！」"},
{"id": 294, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 295, "speaker": 29, "form": "dlg", "jp": "「休みなさいって言ったでしょう！」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「そんな眠る程疲れてないし‥‥」"},
{"id": 297, "speaker": 29, "form": "dlg", "jp": "「そんなわけないでしょう！」"},
{"id": 298, "speaker": 29, "form": "dlg", "jp": "「あれだけの戦闘をしておいて‥‥」"},
{"id": 299, "speaker": 2, "form": "dlg", "jp": "「戦闘っていっても能力を使ったんだから‥‥」"},
{"id": 300, "speaker": 29, "form": "dlg", "jp": "「何もわかってないようね！」"},
{"id": 301, "speaker": 29, "form": "dlg", "jp": "「確かに能力で『拳を硬くしたり』、\n　『筋力をアップさせたり』したけど‥‥」"},
{"id": 302, "speaker": 29, "form": "dlg", "jp": "「『体を使って攻撃した』のは間違いないでしょう？」"},
{"id": 303, "speaker": 29, "form": "dlg", "jp": "「それで体が疲れないワケないんだから‥‥」"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "「そういわれてみると‥‥」"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "（確かに肩が痛い様な‥‥）"},
{"id": 306, "speaker": 29, "form": "dlg", "jp": "「とにかく、ゲーマーの攻撃は始まったばかりなの‥‥」"},
{"id": 307, "speaker": 29, "form": "dlg", "jp": "「今休んでおかないと、\n　いつ出撃命令が出るかわからないのよ！」"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 309, "speaker": 31, "form": "dlg", "jp": "「まあ、というこった‥‥」"},
{"id": 310, "speaker": 31, "form": "dlg", "jp": "「帰って大人しく寝ろ‥‥」"},
{"id": 311, "speaker": 2, "form": "dlg", "jp": "「うん、そうするよ‥‥」"},
{"id": 312, "speaker": 31, "form": "dlg", "jp": "「じゃあな‥‥」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "「アリガトウ‥‥」"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "ボクは部屋に戻っておとなしく眠ることにした。"},
{"id": 316, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 317, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 318, "speaker": 2, "form": "dlg", "jp": "「ドサッ！」"},
{"id": 319, "speaker": 2, "form": "choice", "jp": "（ケネスの部屋に行ってみよう！）"},
{"id": 320, "speaker": 2, "form": "choice", "jp": "（ジーンに会いに行こう！）"},
{"id": 321, "speaker": 2, "form": "choice", "jp": "（アイコに会いに行こう！）"},
{"id": 322, "speaker": 2, "form": "dlg", "jp": "（ジーンに会いに行こう）"},
{"id": 323, "speaker": 2, "form": "dlg", "jp": "ボクはジーンたちのいる女子棟に行くことにした。"},
{"id": 324, "speaker": 29, "form": "dlg", "jp": "「ちょっと、こんなとこで何してるの！」"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "「いや、ジーンの所に行こうと思って‥‥」"},
{"id": 326, "speaker": 29, "form": "dlg", "jp": "「休みなさいって言ったでしょう！」"},
{"id": 327, "speaker": 2, "form": "dlg", "jp": "「そんな眠る程、疲れてないし‥‥」"},
{"id": 328, "speaker": 2, "form": "dlg", "jp": "「いろいろ聞きたいこともあるし‥‥」"},
{"id": 329, "speaker": 29, "form": "dlg", "jp": "「そんなわけないでしょう！」"},
{"id": 330, "speaker": 29, "form": "dlg", "jp": "「あれだけの戦闘をしておいて‥‥」"},
{"id": 331, "speaker": 2, "form": "dlg", "jp": "「戦闘っていっても能力を使ったんだから‥‥」"},
{"id": 332, "speaker": 29, "form": "dlg", "jp": "「何もわかってないようね！」"},
{"id": 333, "speaker": 29, "form": "dlg", "jp": "「確かに能力で『拳を硬くしたり』、\n　『筋力をアップさせたり』したけど‥‥」"},
{"id": 334, "speaker": 29, "form": "dlg", "jp": "「『体を使って攻撃した』のは間違いないでしょう？」"},
{"id": 335, "speaker": 29, "form": "dlg", "jp": "「それで体が疲れないワケないんだから‥‥」"},
{"id": 336, "speaker": 2, "form": "dlg", "jp": "「そうだろうけど‥‥」"},
{"id": 337, "speaker": 2, "form": "dlg", "jp": "「緊張して眠れないんだ‥‥」"},
{"id": 338, "speaker": 29, "form": "dlg", "jp": "「わからないワケじゃないけど‥‥」"},
{"id": 339, "speaker": 29, "form": "dlg", "jp": "「ムリしてでも寝ないとダメよ」"},
{"id": 340, "speaker": 29, "form": "dlg", "jp": "「とにかく、ゲーマーの攻撃は始まったばかりなんだから」"},
{"id": 341, "speaker": 29, "form": "dlg", "jp": "「今休んでおかないと、\n　いつ出撃命令が出るかわからないわよ」"},
{"id": 342, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 343, "speaker": 2, "form": "dlg", "jp": "「わかったよ」"},
{"id": 344, "speaker": 2, "form": "dlg", "jp": "「なるべく眠るようにするよ‥‥」"},
{"id": 345, "speaker": 2, "form": "dlg", "jp": "「でもやっぱり、今は緊張して眠れそうもないんだ‥‥」"},
{"id": 346, "speaker": 29, "form": "dlg", "jp": "「仕方ないわね‥‥」"},
{"id": 347, "speaker": 29, "form": "dlg", "jp": "「少しだけ、話しましょうか‥‥」"},
{"id": 348, "speaker": 2, "form": "dlg", "jp": "「悪いね‥‥」"},
{"id": 349, "speaker": 29, "form": "dlg", "jp": "「丁度、この部屋があいてるから‥‥」"},
{"id": 350, "speaker": 29, "form": "dlg", "jp": "「ここを使わせてもらいましょう‥‥」"},
{"id": 351, "speaker": 29, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 352, "speaker": 29, "form": "dlg", "jp": "ボクたちは使われていない部屋に入ることにした。"},
{"id": 353, "speaker": 29, "form": "dlg", "jp": "「で、聞きたいことって何？」"},
{"id": 354, "speaker": 2, "form": "dlg", "jp": "「ジーンはどうして『Ｅ－ｇｒｏ』のメンバーになったの？」"},
{"id": 355, "speaker": 29, "form": "dlg", "jp": "「そんなこともわからないの？」"},
{"id": 356, "speaker": 29, "form": "dlg", "jp": "「『超能力者』だからよ！」"},
{"id": 357, "speaker": 2, "form": "dlg", "jp": "「いや、そうじゃなくって‥‥」"},
{"id": 358, "speaker": 2, "form": "dlg", "jp": "「どんなきっかけで『Ｅ－ｇｒｏ』に？」"},
{"id": 359, "speaker": 29, "form": "dlg", "jp": "「ナゴムといっしょよ‥‥」"},
{"id": 360, "speaker": 29, "form": "dlg", "jp": "「スカウトされただけ‥‥」"},
{"id": 361, "speaker": 2, "form": "dlg", "jp": "「で、その時ジーンはすんなりＯＫしたの？」"},
{"id": 362, "speaker": 29, "form": "dlg", "jp": "「したわよ！」"},
{"id": 363, "speaker": 2, "form": "dlg", "jp": "「家族とか反対しなかったの？」"},
{"id": 364, "speaker": 29, "form": "dlg", "jp": "「アレ？」"},
{"id": 365, "speaker": 29, "form": "dlg", "jp": "「ナゴムにはまだ言ってなかったっけ？」"},
{"id": 366, "speaker": 29, "form": "dlg", "jp": "「私に家族なんていないわよ！」"},
{"id": 367, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 368, "speaker": 29, "form": "dlg", "jp": "「私、もともとストリートチルドレンだから‥‥」"},
{"id": 369, "speaker": 2, "form": "dlg", "jp": "「はあっ？」"},
{"id": 370, "speaker": 29, "form": "dlg", "jp": "「豊かな日本生まれのナゴムにはわからないか‥‥」"},
{"id": 371, "speaker": 29, "form": "dlg", "jp": "「まあ、子供のホームレスみたいなものよ‥‥」"},
{"id": 372, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 373, "speaker": 29, "form": "dlg", "jp": "「南米には結構いるのよ‥‥」"},
{"id": 374, "speaker": 29, "form": "dlg", "jp": "「家族も住む家もなく、明日目が覚めるかどうかも\n　わからないまま路上で眠っている子供たちが‥‥」"},
{"id": 375, "speaker": 29, "form": "dlg", "jp": "「だからね、ナゴムには悪いことをしたと思うのよ！」"},
{"id": 376, "speaker": 29, "form": "dlg", "jp": "「私と違って、寝食の心配もないのに巻き込んじゃって‥‥」"},
{"id": 377, "speaker": 29, "form": "dlg", "jp": "「私なんかは、もとの生活だって、\n　その日を生きてゆくのが精一杯だったから」"},
{"id": 378, "speaker": 29, "form": "dlg", "jp": "「今の方が何倍もいいんだけど」"},
{"id": 379, "speaker": 29, "form": "dlg", "jp": "「ナゴムたちは\n　巻き込まれない方がきっとよかったんだよね‥‥」"},
{"id": 380, "speaker": 2, "form": "dlg", "jp": "「気にしないでいいよ！」"},
{"id": 381, "speaker": 2, "form": "dlg", "jp": "「ゲーマーってのが、ジーンたちが言う通りのヤツなら、\n　巻き込まれない人間なんていないんだから‥‥」"},
{"id": 382, "speaker": 2, "form": "dlg", "jp": "「明日死んじゃうかもしれないのは一緒なんだろう？」"},
{"id": 383, "speaker": 29, "form": "dlg", "jp": "「そう言ってくれるとコッチも気が楽になったわ‥‥」"},
{"id": 384, "speaker": 2, "form": "dlg", "jp": "「ボクの方こそ、\n　ツライ過去を聞いちゃったりして‥‥」"},
{"id": 385, "speaker": 29, "form": "dlg", "jp": "「それは気にしないで‥‥」"},
{"id": 386, "speaker": 29, "form": "dlg", "jp": "「それより、もう部屋に帰って休んでくれる？」"},
{"id": 387, "speaker": 29, "form": "dlg", "jp": "「やっぱり、\n　ナゴムの戦闘力は私たちにはかかせないものだから‥‥」"},
{"id": 388, "speaker": 2, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 389, "speaker": 29, "form": "dlg", "jp": "「ううん、ナゴムのためだけじゃないから‥‥」"},
{"id": 390, "speaker": 29, "form": "dlg", "jp": "「戦争や災害で、一番被害を被るのは\n　いつも弱いものたちなの‥‥」"},
{"id": 391, "speaker": 29, "form": "dlg", "jp": "「私の住んでいた町には、\n　いまだにストリートチルドレンがたくさんいるの」"},
{"id": 392, "speaker": 29, "form": "dlg", "jp": "「そのほとんどが、私の兄弟みたいなものだから‥‥」"},
{"id": 393, "speaker": 29, "form": "dlg", "jp": "「彼らのためにも‥‥」"},
{"id": 394, "speaker": 2, "form": "dlg", "jp": "「うん、わかった‥‥」"},
{"id": 395, "speaker": 29, "form": "dlg", "jp": "「じゃぁ、ゆっくり休んで‥‥」"},
{"id": 396, "speaker": 2, "form": "dlg", "jp": "「ジーンもね‥‥」"},
{"id": 397, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 398, "speaker": 2, "form": "dlg", "jp": "ジーンと別れたボクは\n部屋に戻っておとなしく眠ることにした。"},
{"id": 399, "speaker": 2, "form": "dlg", "jp": "（アイコに会いに行こう！）"},
{"id": 400, "speaker": 2, "form": "dlg", "jp": "ボクはアイコたちのいる女子棟に行くことにした。"},
{"id": 401, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 402, "speaker": 2, "form": "dlg", "jp": "「コンコン！」"},
{"id": 403, "speaker": 2, "form": "dlg", "jp": "「アイコ、ナゴムだけど‥‥」"},
{"id": 404, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 405, "speaker": 15, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 406, "speaker": 2, "form": "dlg", "jp": "「コッチは\n　どんな部屋の造りになっているのかと思って‥‥」"},
{"id": 407, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃんたちの部屋と変わんないわよ」"},
{"id": 408, "speaker": 2, "form": "dlg", "jp": "「ジーンは‥‥？」"},
{"id": 409, "speaker": 15, "form": "dlg", "jp": "「出て行ったわ‥‥」"},
{"id": 410, "speaker": 15, "form": "dlg", "jp": "「なんか、急がしそうよ彼女‥‥」"},
{"id": 411, "speaker": 2, "form": "dlg", "jp": "「大変だね‥‥」"},
{"id": 412, "speaker": 2, "form": "dlg", "jp": "「なあ、アイコ‥‥」"},
{"id": 413, "speaker": 2, "form": "dlg", "jp": "「オマエ、本当にこんなとこに来てよかったのか？」"},
{"id": 414, "speaker": 2, "form": "dlg", "jp": "「お母さんとか‥‥」"},
{"id": 415, "speaker": 15, "form": "dlg", "jp": "「まあね、かなり心配していたわ」"},
{"id": 416, "speaker": 15, "form": "dlg", "jp": "「私自信も、本当にここにいていいのか？\n　って思うこともあるし‥‥」"},
{"id": 417, "speaker": 2, "form": "dlg", "jp": "「それはなんで？」"},
{"id": 418, "speaker": 15, "form": "dlg", "jp": "「だって‥‥」"},
{"id": 419, "speaker": 15, "form": "dlg", "jp": "「私の能力はナゴムちゃんみたいに\n　戦闘の役に立つわけじゃないから‥‥」"},
{"id": 420, "speaker": 2, "form": "dlg", "jp": "「そんなことないよ！」"},
{"id": 421, "speaker": 2, "form": "dlg", "jp": "「アイコの能力だって役に立ってきたじゃないか！」"},
{"id": 422, "speaker": 15, "form": "dlg", "jp": "「大体私の能力で未来がわかっても、\n　その未来を変えることはできないみたいだから‥‥」"},
{"id": 423, "speaker": 15, "form": "dlg", "jp": "「結局はいてもいなくても同じなんじゃない？」"},
{"id": 424, "speaker": 15, "form": "dlg", "jp": "「それに松尾さんの時以外は、\n　ほとんどが悪い未来の予知ばっかりだし‥‥」"},
{"id": 425, "speaker": 15, "form": "dlg", "jp": "「今もジーンからは寝ておきなさいって\n　言われてるんだけど‥‥」"},
{"id": 426, "speaker": 2, "form": "dlg", "jp": "「けど？」"},
{"id": 427, "speaker": 15, "form": "dlg", "jp": "「もし『悪い夢』を見たらと思うと‥‥」"},
{"id": 428, "speaker": 2, "form": "dlg", "jp": "「眠れないんだ？」"},
{"id": 429, "speaker": 15, "form": "dlg", "jp": "「『不眠症』ってナゴムちゃんみたいね？」"},
{"id": 430, "speaker": 2, "form": "dlg", "jp": "「ボクと同じなんだったらすぐに眠れるようになるよ‥‥」"},
{"id": 431, "speaker": 2, "form": "dlg", "jp": "「ボクも、色んなことが立続けに起きたときには\n　眠れなくなっちゃったけど」"},
{"id": 432, "speaker": 2, "form": "dlg", "jp": "「ジーンとか仲間が増えたとたん\n　なんでか安心して眠れるようになったよ」"},
{"id": 433, "speaker": 2, "form": "dlg", "jp": "「アイコの場合、ボクの時より仲間が多いんだから\n　もっと安心すればいいんじゃないかな？」"},
{"id": 434, "speaker": 2, "form": "dlg", "jp": "「特にココは本部なんだから、\n　もっと安心できるはずなんだけどな‥‥」"},
{"id": 435, "speaker": 2, "form": "dlg", "jp": "「それにアイコの夢はいつも断片だけだから、\n　結末はどうにかできそうだしな‥‥」"},
{"id": 436, "speaker": 15, "form": "dlg", "jp": "「そう言われるとちょっと気が楽になるけど‥‥」"},
{"id": 437, "speaker": 15, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 438, "speaker": 29, "form": "dlg", "jp": "「ちょっと、何してんのっ！」"},
{"id": 439, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 440, "speaker": 29, "form": "dlg", "jp": "「休みなさいって言ったでしょう！」"},
{"id": 441, "speaker": 2, "form": "dlg", "jp": "「そんな眠る程疲れてないし‥‥」"},
{"id": 442, "speaker": 29, "form": "dlg", "jp": "「そんなわけないでしょう！」"},
{"id": 443, "speaker": 29, "form": "dlg", "jp": "「あれだけの戦闘をしておいて‥‥」"},
{"id": 444, "speaker": 2, "form": "dlg", "jp": "「戦闘っていっても能力を使ったんだから‥‥」"},
{"id": 445, "speaker": 29, "form": "dlg", "jp": "「何もわかってないようね！」"},
{"id": 446, "speaker": 29, "form": "dlg", "jp": "「確かに能力で『拳を硬くしたり』、\n　『筋力をアップさせたり』したけど‥‥」"},
{"id": 447, "speaker": 29, "form": "dlg", "jp": "「『体を使って攻撃した』のは間違いないでしょう？」"},
{"id": 448, "speaker": 29, "form": "dlg", "jp": "「それで体が疲れないワケないんだから‥‥」"},
{"id": 449, "speaker": 2, "form": "dlg", "jp": "「そういわれてみると‥‥」"},
{"id": 450, "speaker": 2, "form": "dlg", "jp": "（確かに肩が痛い様な‥‥）"},
{"id": 451, "speaker": 29, "form": "dlg", "jp": "「とにかく、ゲーマーの攻撃は始まったばかりなの‥‥」"},
{"id": 452, "speaker": 29, "form": "dlg", "jp": "「今休んでおかないと、\n　いつ出撃命令が出るかわからないのよ！」"},
{"id": 453, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 454, "speaker": 15, "form": "dlg", "jp": "「ナゴムちゃん‥‥」"},
{"id": 455, "speaker": 15, "form": "dlg", "jp": "「私のことはいいから、\n　部屋に帰って休んだほうが‥‥」"},
{"id": 456, "speaker": 2, "form": "dlg", "jp": "「うん、そうするよ‥‥」"},
{"id": 457, "speaker": 15, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 458, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 459, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 460, "speaker": 2, "form": "dlg", "jp": "ボクは部屋に戻っておとなしく眠ることにした。"},
{"id": 461, "speaker": 2, "form": "choice", "jp": "（ケネスの部屋に行ってみよう！）"},
{"id": 462, "speaker": 2, "form": "choice", "jp": "（ジーンに会いに行こう！）"},
{"id": 463, "speaker": 2, "form": "choice", "jp": "（長尾に会いに行こう！）"},
{"id": 464, "speaker": 2, "form": "dlg", "jp": "（長尾に会いに行こう！）"},
{"id": 465, "speaker": 2, "form": "dlg", "jp": "ボクは長尾たちのいる女子棟に行くことにした。"},
{"id": 466, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 467, "speaker": 2, "form": "dlg", "jp": "「コンコン！」"},
{"id": 468, "speaker": 2, "form": "dlg", "jp": "「長尾ォ、ナゴムだけど‥‥」"},
{"id": 469, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 470, "speaker": 16, "form": "dlg", "jp": "「何、アキラに会いに来てくれたの？」"},
{"id": 471, "speaker": 2, "form": "dlg", "jp": "「まあ、そうには違いないけど‥‥」"},
{"id": 472, "speaker": 16, "form": "dlg", "jp": "「で、なんの用？」"},
{"id": 473, "speaker": 2, "form": "dlg", "jp": "「いや、コッチの部屋はどんな感じなのかと思って‥‥」"},
{"id": 474, "speaker": 16, "form": "dlg", "jp": "「ソッチの部屋と変わんないわよ！」"},
{"id": 475, "speaker": 2, "form": "dlg", "jp": "「アレ？」"},
{"id": 476, "speaker": 2, "form": "dlg", "jp": "「ジーンは‥‥？」"},
{"id": 477, "speaker": 16, "form": "dlg", "jp": "「出て行ったわ‥‥」"},
{"id": 478, "speaker": 16, "form": "dlg", "jp": "「なんか、急がしそうよ彼女‥‥」"},
{"id": 479, "speaker": 2, "form": "dlg", "jp": "「大変だね‥‥」"},
{"id": 480, "speaker": 2, "form": "dlg", "jp": "「なあ、長尾‥‥」"},
{"id": 481, "speaker": 2, "form": "dlg", "jp": "「オマエ、本当にこんなとこに来てよかったのか？」"},
{"id": 482, "speaker": 2, "form": "dlg", "jp": "「家族の人とか‥‥」"},
{"id": 483, "speaker": 16, "form": "dlg", "jp": "「まあね、かなり心配していたわよ」"},
{"id": 484, "speaker": 16, "form": "dlg", "jp": "「でも、必死に説得したら、\n　『好きにしなさい！』って‥‥」"},
{"id": 485, "speaker": 2, "form": "dlg", "jp": "「どうやって説得したんだ？」"},
{"id": 486, "speaker": 16, "form": "dlg", "jp": "「『タダでペルーに行けるチャンスなのよ！』って‥‥」"},
{"id": 487, "speaker": 2, "form": "dlg", "jp": "「それで説得させられちゃう家族って可哀相だね」"},
{"id": 488, "speaker": 16, "form": "dlg", "jp": "「いいのよ！」"},
{"id": 489, "speaker": 16, "form": "dlg", "jp": "「そのかわりあの人たちの命と未来を\n　守ってあげるんだから！」"},
{"id": 490, "speaker": 2, "form": "dlg", "jp": "「長尾はいつもたのもしいね！」"},
{"id": 491, "speaker": 16, "form": "dlg", "jp": "「でも、『ペルー』に来れるだけでもカンゲキなのに‥‥」"},
{"id": 492, "speaker": 16, "form": "dlg", "jp": "「『マチュピチュ』に来れるなんて大カンゲキ！！」"},
{"id": 493, "speaker": 2, "form": "dlg", "jp": "「これってそんなにスゴイ遺跡なの？」"},
{"id": 494, "speaker": 16, "form": "dlg", "jp": "「正確に言うと、『インカ文明』自体がスゴイじゃない！」"},
{"id": 495, "speaker": 16, "form": "dlg", "jp": "「イセキ、イセキって言うけど、\n　ここには５００年前までは文明があったのよ！」"},
{"id": 496, "speaker": 16, "form": "dlg", "jp": "「日本でその時代のものを遺跡って言わないでしょう？」"},
{"id": 497, "speaker": 16, "form": "dlg", "jp": "「南米ってインカとかアステカとかマヤとか、\n　ほんと謎の文明がたくさんあったのよ！」"},
{"id": 498, "speaker": 16, "form": "dlg", "jp": "「スゴイと思わない？」"},
{"id": 499, "speaker": 16, "form": "dlg", "jp": "「こんな山奥に要塞都市を作れちゃう人たちって、\n　ほんとスゴすぎるわ‥‥」"},
{"id": 500, "speaker": 16, "form": "dlg", "jp": "「もう、『神秘』『神秘』『神秘』よ！」"},
{"id": 501, "speaker": 16, "form": "dlg", "jp": "「きっとここなら、\n　『スカイフィッシュ』もウジャイジャいるはずよ！」"},
{"id": 502, "speaker": 2, "form": "dlg", "jp": "「ふ～～ん」"},
{"id": 503, "speaker": 16, "form": "dlg", "jp": "「なんかアキラの趣味にピッタリの場所よねココ！」"},
{"id": 504, "speaker": 2, "form": "dlg", "jp": "「そうだね！」"},
{"id": 505, "speaker": 16, "form": "dlg", "jp": "「でも、どうしてアキラにはみんなみたいな\n　役に立つ能力が備わらなかったんだろう？」"},
{"id": 506, "speaker": 2, "form": "dlg", "jp": "「そうかな、十分役にたってるよ！」"},
{"id": 507, "speaker": 16, "form": "dlg", "jp": "「ウソ！」"},
{"id": 508, "speaker": 16, "form": "dlg", "jp": "「それは気休めよ！」"},
{"id": 509, "speaker": 16, "form": "dlg", "jp": "「アキラ気付いたんだ‥‥」"},
{"id": 510, "speaker": 16, "form": "dlg", "jp": "「アキラの能力って無意味だって‥‥」"},
{"id": 511, "speaker": 16, "form": "dlg", "jp": "「だって、アキラの見る『予知夢』は\n　絶対的な未来だから‥‥」"},
{"id": 512, "speaker": 16, "form": "dlg", "jp": "「未来がわかったからって、\n　その未来は絶対で変えることができないんだもん！」"},
{"id": 513, "speaker": 16, "form": "dlg", "jp": "「ぜんぜん、イ　ミ　ナ　イ　ジ　ャ　ン！」"},
{"id": 514, "speaker": 2, "form": "dlg", "jp": "「そうでもないと思うよ！」"},
{"id": 515, "speaker": 2, "form": "dlg", "jp": "「長尾の『予知夢』って断片的だろう？」"},
{"id": 516, "speaker": 2, "form": "dlg", "jp": "「例えば、『お湯がわく』とか‥‥」"},
{"id": 517, "speaker": 2, "form": "dlg", "jp": "「確かにその夢を見ちゃった、\n　絶対お湯がわいちゃうんだけど」"},
{"id": 518, "speaker": 2, "form": "dlg", "jp": "「それがあらかじめわかるんなら、\n　カップラーメンを買っておけるだろう？」"},
{"id": 519, "speaker": 2, "form": "dlg", "jp": "「そう考えれば便利な能力だと思うけど‥‥」"},
{"id": 520, "speaker": 16, "form": "dlg", "jp": "「アキラ、カップラーメン嫌いだし‥‥」"},
{"id": 521, "speaker": 2, "form": "dlg", "jp": "「じゃあ、好きなテレビを留守番録画するときに、\n　『野球が延長する夢』を見るっていうのは？」"},
{"id": 522, "speaker": 16, "form": "dlg", "jp": "「それってスゴクいいかも！！」"},
{"id": 523, "speaker": 2, "form": "dlg", "jp": "「だろう？」"},
{"id": 524, "speaker": 2, "form": "dlg", "jp": "「それくらい、いい能力だと思うよ！」"},
{"id": 525, "speaker": 16, "form": "dlg", "jp": "「常光寺くんて、やさしいのね‥‥」"},
{"id": 526, "speaker": 2, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 527, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 528, "speaker": 29, "form": "dlg", "jp": "「ちょっと、何してんのっ！」"},
{"id": 529, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 530, "speaker": 29, "form": "dlg", "jp": "「休みなさいって言ったでしょう！」"},
{"id": 531, "speaker": 2, "form": "dlg", "jp": "「そんな眠る程疲れてないし‥‥」"},
{"id": 532, "speaker": 29, "form": "dlg", "jp": "「そんなわけないでしょう！」"},
{"id": 533, "speaker": 29, "form": "dlg", "jp": "「あれだけの戦闘をしておいて‥‥」"},
{"id": 534, "speaker": 2, "form": "dlg", "jp": "「戦闘っていっても能力を使ったんだから‥‥」"},
{"id": 535, "speaker": 29, "form": "dlg", "jp": "「何もわかってないようね！」"},
{"id": 536, "speaker": 29, "form": "dlg", "jp": "「確かに能力で『拳を硬くしたり』、\n　『筋力をアップさせたり』したけど‥‥」"},
{"id": 537, "speaker": 29, "form": "dlg", "jp": "「『体を使って攻撃した』のは間違いないでしょう？」"},
{"id": 538, "speaker": 29, "form": "dlg", "jp": "「それで体が疲れないワケないんだから‥‥」"},
{"id": 539, "speaker": 2, "form": "dlg", "jp": "「そういわれてみると‥‥」"},
{"id": 540, "speaker": 2, "form": "dlg", "jp": "（確かに肩が痛い様な‥‥）"},
{"id": 541, "speaker": 29, "form": "dlg", "jp": "「とにかく、ゲーマーの攻撃は始まったばかりなの‥‥」"},
{"id": 542, "speaker": 29, "form": "dlg", "jp": "「今休んでおかないと、\n　いつ出撃命令が出るかわからないのよ！」"},
{"id": 543, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 544, "speaker": 2, "form": "dlg", "jp": "「じゃあ、戻って休むことにするよ！」"},
{"id": 545, "speaker": 16, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 546, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 547, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 548, "speaker": 2, "form": "dlg", "jp": "ボクは部屋に戻っておとなしく眠ることにした。"},
{"id": 549, "speaker": 2, "form": "choice", "jp": "（ケネスの部屋に行ってみよう！）"},
{"id": 550, "speaker": 2, "form": "choice", "jp": "（ジーンに会いに行こう！）"},
{"id": 551, "speaker": 2, "form": "choice", "jp": "（堤さんに会いに行こう）"},
{"id": 552, "speaker": 2, "form": "dlg", "jp": "（堤さんに会いに行こう！）"},
{"id": 553, "speaker": 2, "form": "dlg", "jp": "ボクは堤さんたちのいる女子棟に行くことにした。"},
{"id": 554, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 555, "speaker": 2, "form": "dlg", "jp": "「コンコン！」"},
{"id": 556, "speaker": 2, "form": "dlg", "jp": "「堤さん、ナゴムだけど‥‥」"},
{"id": 557, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 558, "speaker": 18, "form": "dlg", "jp": "「どうかしたの？」"},
{"id": 559, "speaker": 2, "form": "dlg", "jp": "「コッチは\n　どんな部屋の造りになっているのかと思って‥‥」"},
{"id": 560, "speaker": 18, "form": "dlg", "jp": "「常光寺くんたちの部屋と変わんないわよ」"},
{"id": 561, "speaker": 2, "form": "dlg", "jp": "「ジーンは‥‥？」"},
{"id": 562, "speaker": 18, "form": "dlg", "jp": "「出て行ったわ‥‥」"},
{"id": 563, "speaker": 18, "form": "dlg", "jp": "「なんか、急がしそうよジーンさん‥‥」"},
{"id": 564, "speaker": 2, "form": "dlg", "jp": "「大変だね‥‥」"},
{"id": 565, "speaker": 18, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 566, "speaker": 18, "form": "dlg", "jp": "「もっと私たちがしっかりしていれば、\n　ジーンさんも楽になるんでしょうね‥‥」"},
{"id": 567, "speaker": 2, "form": "dlg", "jp": "「でさぁ‥‥」"},
{"id": 568, "speaker": 2, "form": "dlg", "jp": "「気になってたんだけど、\n　堤さんどうやって家族を説得したの？」"},
{"id": 569, "speaker": 18, "form": "dlg", "jp": "「普通によ」"},
{"id": 570, "speaker": 2, "form": "dlg", "jp": "「それで許してもらえたの？」"},
{"id": 571, "speaker": 18, "form": "dlg", "jp": "「お父さんは反対していたわ！」"},
{"id": 572, "speaker": 18, "form": "dlg", "jp": "「でも、お母さんが」"},
{"id": 573, "speaker": 18, "form": "dlg", "jp": "「『普段ワガママを言わないこの子が、\n　これだけ言うんだから』って味方になってくれたの‥‥」"},
{"id": 574, "speaker": 2, "form": "dlg", "jp": "「いいお母さんだね‥‥」"},
{"id": 575, "speaker": 18, "form": "dlg", "jp": "「でしょう？」"},
{"id": 576, "speaker": 2, "form": "dlg", "jp": "「堤さん自体は不安はないの？」"},
{"id": 577, "speaker": 18, "form": "dlg", "jp": "「ないって言えばウソになるけど、\n　それよりワクワクするって方が大きいかな？」"},
{"id": 578, "speaker": 18, "form": "dlg", "jp": "「まあ、不満はあるけどね！」"},
{"id": 579, "speaker": 2, "form": "dlg", "jp": "「不満って？」"},
{"id": 580, "speaker": 18, "form": "dlg", "jp": "「やっぱり、このユニフォームは\n　ちょっとハズかしいかな？」"},
{"id": 581, "speaker": 2, "form": "dlg", "jp": "「まあ、そうだけど‥‥」"},
{"id": 582, "speaker": 2, "form": "dlg", "jp": "「恐くはないの？」"},
{"id": 583, "speaker": 18, "form": "dlg", "jp": "「ええ、そっちはぜんぜん‥‥」"},
{"id": 584, "speaker": 18, "form": "dlg", "jp": "「だって常光寺くんがいるし‥‥」"},
{"id": 585, "speaker": 2, "form": "dlg", "jp": "「ハハハハハハハ‥‥‥」"},
{"id": 586, "speaker": 2, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 587, "speaker": 29, "form": "dlg", "jp": "「ちょっと、何してんのっ！」"},
{"id": 588, "speaker": 2, "form": "dlg", "jp": "「へっ？」"},
{"id": 589, "speaker": 29, "form": "dlg", "jp": "「休みなさいって言ったでしょう！」"},
{"id": 590, "speaker": 2, "form": "dlg", "jp": "「そんな眠る程疲れてないし‥‥」"},
{"id": 591, "speaker": 29, "form": "dlg", "jp": "「そんなわけないでしょう！」"},
{"id": 592, "speaker": 29, "form": "dlg", "jp": "「あれだけの戦闘をしておいて‥‥」"},
{"id": 593, "speaker": 2, "form": "dlg", "jp": "「戦闘っていっても能力を使ったんだから‥‥」"},
{"id": 594, "speaker": 29, "form": "dlg", "jp": "「何もわかってないようね！」"},
{"id": 595, "speaker": 29, "form": "dlg", "jp": "「確かに能力で『拳を硬くしたり』、\n　『筋力をアップさせたり』したけど‥‥」"},
{"id": 596, "speaker": 29, "form": "dlg", "jp": "「『体を使って攻撃した』のは間違いないでしょう？」"},
{"id": 597, "speaker": 29, "form": "dlg", "jp": "「それで体が疲れないワケないんだから‥‥」"},
{"id": 598, "speaker": 2, "form": "dlg", "jp": "「そういわれてみると‥‥」"},
{"id": 599, "speaker": 2, "form": "dlg", "jp": "（確かに肩が痛い様な‥‥）"},
{"id": 600, "speaker": 29, "form": "dlg", "jp": "「とにかく、ゲーマーの攻撃は始まったばかりなの‥‥」"},
{"id": 601, "speaker": 29, "form": "dlg", "jp": "「今休んでおかないと、\n　いつ出撃命令が出るかわからないのよ！」"},
{"id": 602, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 603, "speaker": 2, "form": "dlg", "jp": "「じゃあ、戻って休むことにするよ‥‥」"},
{"id": 604, "speaker": 2, "form": "dlg", "jp": "「じゃあね、堤さん‥‥」"},
{"id": 605, "speaker": 18, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 606, "speaker": 18, "form": "dlg", "jp": "「ガチャッ！」"},
{"id": 607, "speaker": 18, "form": "dlg", "jp": "ボクは部屋に戻っておとなしく眠ることにした。"}
]
