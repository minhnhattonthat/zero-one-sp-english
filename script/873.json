[
{"id": 0, "speaker": null, "form": "dlg", "jp": "２００５／０８／２９／ＰＭ０８：００"},
{"id": 1, "speaker": null, "form": "dlg", "jp": "そして、８時になった。"},
{"id": 2, "speaker": 35, "form": "dlg", "jp": "「ねえ、テレビ観た？」"},
{"id": 3, "speaker": 35, "form": "dlg", "jp": "「アメリカ軍、スゴイことになってるね！」"},
{"id": 4, "speaker": 35, "form": "dlg", "jp": "どうやら本格的に\n『クリエーター』が活動を開始したようだ‥‥"},
{"id": 5, "speaker": 35, "form": "dlg", "jp": "アメリカ南部で、\n『無人戦車』によるテロ事件が発生している。"},
{"id": 6, "speaker": 35, "form": "dlg", "jp": "「まあ、無人で戦車が動くわけないから、\n　間違いなく『クリエーター』の仕業なんだろうけど‥‥」"},
{"id": 7, "speaker": 35, "form": "dlg", "jp": "「政府は『テロによる遠隔操作』だと思い込んでるね」"},
{"id": 8, "speaker": 35, "form": "dlg", "jp": "「もう戦車より、それを破壊しようとする\n　軍の戦闘機の暴走の方がひどくって‥‥」"},
{"id": 9, "speaker": 31, "form": "dlg", "jp": "「心配するな！」"},
{"id": 10, "speaker": 31, "form": "dlg", "jp": "「あの国では戦闘機の１００機ぐらい、\n　痛くもかゆくもないよ‥‥」"},
{"id": 11, "speaker": 35, "form": "dlg", "jp": "「あれ！？」"},
{"id": 12, "speaker": 35, "form": "dlg", "jp": "「どうかしたのトモちゃん？」"},
{"id": 13, "speaker": 35, "form": "dlg", "jp": "「ナゴムくんも‥‥」"},
{"id": 14, "speaker": 51, "form": "dlg", "jp": "「同じクラスの男子が‥‥」"},
{"id": 15, "speaker": 51, "form": "dlg", "jp": "「病院に運ばれたんや‥‥」"},
{"id": 16, "speaker": 35, "form": "dlg", "jp": "「どうかしたのナナセちゃん？」"},
{"id": 17, "speaker": 35, "form": "dlg", "jp": "「ナゴムくんも‥‥」"},
{"id": 18, "speaker": 18, "form": "dlg", "jp": "「同じクラスの男子が‥‥」"},
{"id": 19, "speaker": 18, "form": "dlg", "jp": "「病院に運ばれたらしいの‥‥」"},
{"id": 20, "speaker": 35, "form": "dlg", "jp": "「どうかしたのアキラちゃん？」"},
{"id": 21, "speaker": 35, "form": "dlg", "jp": "「ナゴムくんも‥‥」"},
{"id": 22, "speaker": 16, "form": "dlg", "jp": "「同級生が‥‥」"},
{"id": 23, "speaker": 16, "form": "dlg", "jp": "「病院に運ばれたの‥‥」"},
{"id": 24, "speaker": 35, "form": "dlg", "jp": "「どうかしたのアイコちゃん？」"},
{"id": 25, "speaker": 35, "form": "dlg", "jp": "「ナゴムくんも‥‥」"},
{"id": 26, "speaker": 15, "form": "dlg", "jp": "「友達が‥‥」"},
{"id": 27, "speaker": 15, "form": "dlg", "jp": "「病院に運ばれたらしいの‥‥」"},
{"id": 28, "speaker": 29, "form": "dlg", "jp": "「さっきの『ＵＦＯ』の時に巻き込まれたらしいのよ‥‥」"},
{"id": 29, "speaker": 29, "form": "choice", "jp": "「大丈夫かな‥‥」"},
{"id": 30, "speaker": 29, "form": "choice", "jp": "「大丈夫だよ‥‥」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「大丈夫かな‥‥」"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "「ツトムは命にはべつじょうはないって言ってたけど‥‥」"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "「大丈夫だよ‥‥」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「ツトムは命にはべつじょうはないって‥‥」"},
{"id": 35, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "「そんなことより、\n　これ以上、被害をふやさないように‥‥」"},
{"id": 37, "speaker": 29, "form": "dlg", "jp": "「その通りね‥‥」"},
{"id": 38, "speaker": 29, "form": "dlg", "jp": "「ニュースで知ってると思うけど‥‥」"},
{"id": 39, "speaker": 29, "form": "dlg", "jp": "「『クリエーター』の被害は世界中に広がってるわ‥‥」"},
{"id": 40, "speaker": 29, "form": "dlg", "jp": "『アメリカ』の『兵器の暴走』以外にも、"},
{"id": 41, "speaker": 29, "form": "dlg", "jp": "『旅客機の墜落』、『科学工場の爆発』などの\n『クリエーター』の仕業と思われる事故が"},
{"id": 42, "speaker": 29, "form": "dlg", "jp": "世界中で発生していた。"},
{"id": 43, "speaker": 29, "form": "dlg", "jp": "また、ジーンの話によると、\n『兵器の暴走』をテロと勘違いして"},
{"id": 44, "speaker": 29, "form": "dlg", "jp": "戦争を始めようとしている国もあるらしい‥‥"},
{"id": 45, "speaker": 29, "form": "dlg", "jp": "「人間のバカさ加減を考えたら、\n　クリエーターじゃなくても全滅させたくなるわね」"},
{"id": 46, "speaker": 31, "form": "dlg", "jp": "「まあ、罪のない人間もいるのは間違いないんだから‥‥」"},
{"id": 47, "speaker": 2, "form": "dlg", "jp": "「そうさ、シンちゃんに罪があるとは‥‥」"},
{"id": 48, "speaker": 29, "form": "dlg", "jp": "「とにかく、早く本部に行って\n　みんなと合流しましょう‥‥」"},
{"id": 49, "speaker": 31, "form": "dlg", "jp": "「そうだな‥‥」"},
{"id": 50, "speaker": 35, "form": "dlg", "jp": "「あのう‥‥」"},
{"id": 51, "speaker": 35, "form": "dlg", "jp": "「ちょっといいかな？」"},
{"id": 52, "speaker": 35, "form": "dlg", "jp": "「ペルーまでどうやって行くつもり？」"},
{"id": 53, "speaker": 35, "form": "dlg", "jp": "「この時間に『飛行機』は飛んでないと思うけど‥‥」"},
{"id": 54, "speaker": 29, "form": "dlg", "jp": "「『クリエーター』の能力を忘れたの？」"},
{"id": 55, "speaker": 29, "form": "dlg", "jp": "「飛行機なんて危なすぎるでしょう！！」"},
{"id": 56, "speaker": 35, "form": "dlg", "jp": "「もしかして、『テレポート』？」"},
{"id": 57, "speaker": 29, "form": "dlg", "jp": "「そうよ！」"},
{"id": 58, "speaker": 35, "form": "dlg", "jp": "「じゃあ、ダメだよ‥‥」"},
{"id": 59, "speaker": 35, "form": "dlg", "jp": "「オレは本部の場所なんて知らないから‥‥」"},
{"id": 60, "speaker": 29, "form": "dlg", "jp": "「大丈夫よ！」"},
{"id": 61, "speaker": 35, "form": "dlg", "jp": "「ダメだよ！」"},
{"id": 62, "speaker": 35, "form": "dlg", "jp": "「オレ、イメージできない場所には行けないんだって！」"},
{"id": 63, "speaker": 29, "form": "dlg", "jp": "「大丈夫だって！！」"},
{"id": 64, "speaker": 29, "form": "dlg", "jp": "「アスカには頼まないから‥‥」"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "「ってどういうこと？」"},
{"id": 66, "speaker": 29, "form": "dlg", "jp": "「本部にいる"},
{"id": 67, "speaker": 29, "form": "dlg", "jp": "『別のテレポーター』"},
{"id": 68, "speaker": 29, "form": "dlg", "jp": "に運んでもらうわ‥‥」"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "『別のテレポーター』"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "？」"},
{"id": 72, "speaker": 29, "form": "dlg", "jp": "「そうよ‥‥」"},
{"id": 73, "speaker": 29, "form": "dlg", "jp": "「こちらから行かなくても、\n　あっちから呼び寄せてもらった方が確実でしょう‥‥」"},
{"id": 74, "speaker": 35, "form": "dlg", "jp": "「たしかに‥‥」"},
{"id": 75, "speaker": 29, "form": "dlg", "jp": "「こっちから電話すれば、\n　呼び寄せてくれるように言ってるから‥‥」"},
{"id": 76, "speaker": 29, "form": "dlg", "jp": "そう言って、ジーンはみんなに携帯電話を配った。"},
{"id": 77, "speaker": 29, "form": "dlg", "jp": "「そのケイタイのメモリーの１に電話をかけて‥‥」"},
{"id": 78, "speaker": 29, "form": "dlg", "jp": "「そしたら、『転送』してもらえるはずだから‥‥」"},
{"id": 79, "speaker": 35, "form": "dlg", "jp": "「ふ～ん‥‥」"},
{"id": 80, "speaker": 29, "form": "dlg", "jp": "「ケネス、試しに見せてあげて‥‥」"},
{"id": 81, "speaker": 31, "form": "dlg", "jp": "「分かった‥‥」"},
{"id": 82, "speaker": 31, "form": "dlg", "jp": "「ピ・ポ・パ・ポ・ピ‥‥」"},
{"id": 83, "speaker": 31, "form": "dlg", "jp": "「シュン！」"},
{"id": 84, "speaker": 35, "form": "dlg", "jp": "「本当に消えちゃったよ！」"},
{"id": 85, "speaker": 29, "form": "dlg", "jp": "「こういうことよ‥‥」"},
{"id": 86, "speaker": 29, "form": "dlg", "jp": "「さあ、次は誰？」"},
{"id": 87, "speaker": 29, "form": "dlg", "jp": "「シュン！」"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "「シュン！」"},
{"id": 89, "speaker": 29, "form": "dlg", "jp": "こうして、みんなは次々と\n『本部』へと向かった。"},
{"id": 90, "speaker": 29, "form": "dlg", "jp": "「さあ、ナゴムも早く！」"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って‥‥」"},
{"id": 92, "speaker": 2, "form": "dlg", "jp": "「友達に電話してから行くよ‥‥」"},
{"id": 93, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥」"},
{"id": 94, "speaker": 29, "form": "dlg", "jp": "「分かったわ‥‥」"},
{"id": 95, "speaker": 29, "form": "dlg", "jp": "「じゃあ、先に行くから‥‥」"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "「すまない‥‥」"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "「逃げたりしないでよ！」"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "「しないよ！！」"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "「じゃあね‥‥」"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "「シュン！」"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥"},
{"id": 102, "speaker": 29, "form": "dlg", "jp": "「ピ・ポ・パ・ポ・ピ‥‥」"},
{"id": 103, "speaker": 29, "form": "dlg", "jp": "ボクはツトムに電話をかけた‥‥"},
{"id": 104, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 105, "speaker": 13, "form": "dlg", "jp": "（ナゴムか！？）"},
{"id": 106, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 107, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 108, "speaker": 13, "form": "dlg", "jp": "（なんか連絡あったか？）"},
{"id": 109, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "「その様子じゃ、そっちも連絡ないんだな‥‥」"},
{"id": 111, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 112, "speaker": 13, "form": "dlg", "jp": "（じゃあ、連絡ないんだな‥‥）"},
{"id": 113, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 114, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 115, "speaker": 13, "form": "dlg", "jp": "（オバさん、いそがしそうだったからな‥‥）"},
{"id": 116, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「でさぁ‥‥」"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「ボク、ちょっとの間連絡とれなくなるから‥‥」"},
{"id": 119, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 120, "speaker": 13, "form": "dlg", "jp": "（どこか行くのか？）"},
{"id": 121, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 122, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 123, "speaker": 2, "form": "dlg", "jp": "「ちょっと‥‥」"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "「わるいけど、シンちゃんのこと頼むよ‥‥」"},
{"id": 125, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 126, "speaker": 13, "form": "dlg", "jp": "（ＯＫ！）"},
{"id": 127, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 128, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 129, "speaker": 13, "form": "dlg", "jp": "（まかせとけって！）"},
{"id": 130, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "「じゃあ、帰ってきたら、また電話するよ‥‥」"},
{"id": 132, "speaker": 2, "form": "dlg", "jp": "「じゃあな‥‥」"},
{"id": 133, "speaker": 13, "form": "dlg", "jp": "「"},
{"id": 134, "speaker": 13, "form": "dlg", "jp": "（ああ‥‥）"},
{"id": 135, "speaker": 13, "form": "dlg", "jp": "」"},
{"id": 136, "speaker": 13, "form": "dlg", "jp": "「ピッ！」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "（さてと‥‥）"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "ボクは姉さんにあいさつをするために\nリビングへおりていった。"},
{"id": 139, "speaker": 2, "form": "dlg", "jp": "「タンタンタンタン‥‥」"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "「姉さん‥‥」"},
{"id": 141, "speaker": 3, "form": "dlg", "jp": "「行くのね‥‥？」"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「うん‥‥」"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "「ツトムから、電話があるかもしれないから\n　うまくゴマかしといて！」"},
{"id": 144, "speaker": 3, "form": "dlg", "jp": "「わかったわ‥‥」"},
{"id": 145, "speaker": 5, "form": "dlg", "jp": "「くれぐれも気をつけてね」"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 147, "speaker": 5, "form": "dlg", "jp": "「『キミたちを守ること』がボクの使命なんだ‥‥」"},
{"id": 148, "speaker": 5, "form": "dlg", "jp": "「ナゴムにもしものことがあったら‥‥」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 150, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "「行ってくるよ‥‥」"},
{"id": 152, "speaker": 3, "form": "dlg", "jp": "「『行ってらっしゃい』‥‥」"},
{"id": 153, "speaker": 3, "form": "dlg", "jp": "ボクはジーンから受け取った携帯電話の\nメモリーを呼び出した。"},
{"id": 154, "speaker": 3, "form": "dlg", "jp": "「ピ・ポ・パ・ポ・ピ‥‥」"},
{"id": 155, "speaker": 3, "form": "dlg", "jp": "「シュン！」"},
{"id": 156, "speaker": 3, "form": "dlg", "jp": "こうしてボクたちは『本部』のある\n『ペルー』に向かった。"}
]
