[
{"id": 0, "speaker": 3, "form": "dlg", "jp": "「ハイ、キップ‥‥‥」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "「これで、父さんもシローも助かるんだね？」"},
{"id": 2, "speaker": 3, "form": "dlg", "jp": "「ちゃんと、父さんがいてくれたらね‥‥」"},
{"id": 3, "speaker": 3, "form": "dlg", "jp": "「急いで、電車が来るわよ！」"},
{"id": 4, "speaker": 3, "form": "dlg", "jp": "ボクたちは１時間程電車にゆられ\n五色沢を目指した。"},
{"id": 5, "speaker": 3, "form": "dlg", "jp": "『五色沢』‥‥"},
{"id": 6, "speaker": 3, "form": "dlg", "jp": "ボクたちの町から電車で\n１時間程離れた場所にある別荘地だ‥‥"},
{"id": 7, "speaker": 3, "form": "dlg", "jp": "２００５／０７／２３／ＰＭ０５：４０"},
{"id": 8, "speaker": 2, "form": "dlg", "jp": "「姉さん‥‥」"},
{"id": 9, "speaker": 3, "form": "dlg", "jp": "「何？」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「『研究所』の場所覚えてるの？」"},
{"id": 11, "speaker": 3, "form": "dlg", "jp": "「なんとなくだけどね‥‥」"},
{"id": 12, "speaker": 3, "form": "dlg", "jp": "「たしか‥‥」"},
{"id": 13, "speaker": 3, "form": "dlg", "jp": "「あの山の上の方だったと思うわよ‥‥」"},
{"id": 14, "speaker": 3, "form": "dlg", "jp": "「ここからはずっと歩くことになるわよ！」"},
{"id": 15, "speaker": 2, "form": "dlg", "jp": "「平気だよこれくらい‥‥」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「それより、シローをおいて来たけど、\n　大丈夫かな？」"},
{"id": 17, "speaker": 3, "form": "dlg", "jp": "「たぶんね‥‥」"},
{"id": 18, "speaker": 3, "form": "dlg", "jp": "そして、２０分後"},
{"id": 19, "speaker": 3, "form": "dlg", "jp": "「着いたわ‥‥」"},
{"id": 20, "speaker": 3, "form": "dlg", "jp": "そこは古い洋館だった。"},
{"id": 21, "speaker": 3, "form": "dlg", "jp": "大学の研究室というものが\nイメージのできないボクには意外な建物であった。"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「父さんたち、本当にいるのかな？」"},
{"id": 23, "speaker": 3, "form": "dlg", "jp": "「父さんたちかどうか別として、\n　間違いなく、『誰か』いるみたいよ‥‥」"},
{"id": 24, "speaker": 2, "form": "dlg", "jp": "「どうしてわかるの？」"},
{"id": 25, "speaker": 3, "form": "dlg", "jp": "「電気のメーターが回ってるわ‥‥」"},
{"id": 26, "speaker": 2, "form": "dlg", "jp": "「なるほど‥‥」"},
{"id": 27, "speaker": 3, "form": "dlg", "jp": "「で、どうする？」"},
{"id": 28, "speaker": 3, "form": "choice", "jp": "「しばらく、様子をみよう」"},
{"id": 29, "speaker": 3, "form": "choice", "jp": "「ノックしてみようか？」"},
{"id": 30, "speaker": 3, "form": "choice", "jp": "「中に入ろうか‥‥」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「しばらく、様子をみよう」"},
{"id": 32, "speaker": 3, "form": "dlg", "jp": "「そうね‥‥」"},
{"id": 33, "speaker": 3, "form": "dlg", "jp": "ボクたちはしばらく様子を見ることにした。"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 35, "speaker": 3, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 36, "speaker": 2, "form": "dlg", "jp": "「誰も出て来そうにないね‥‥」"},
{"id": 37, "speaker": 2, "form": "choice", "jp": "「ノックしてみようか？」"},
{"id": 38, "speaker": 2, "form": "choice", "jp": "「中に入ろうか‥‥」"},
{"id": 39, "speaker": 2, "form": "dlg", "jp": "「ノックしてみようか？」"},
{"id": 40, "speaker": 2, "form": "dlg", "jp": "「コン！コン！」"},
{"id": 41, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 42, "speaker": 3, "form": "dlg", "jp": "「返事はないわね‥‥」"},
{"id": 43, "speaker": 3, "form": "choice", "jp": "「しばらく、様子をみよう」"},
{"id": 44, "speaker": 3, "form": "choice", "jp": "「中に入ろうか‥‥」"},
{"id": 45, "speaker": 2, "form": "dlg", "jp": "「中に入ろうか‥‥」"},
{"id": 46, "speaker": 3, "form": "dlg", "jp": "「そ、そうね‥‥」"},
{"id": 47, "speaker": 3, "form": "dlg", "jp": "ボクたちは中へ入ってみることにした。"},
{"id": 48, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 49, "speaker": 8, "form": "dlg", "jp": "「ようこそ‥‥」"},
{"id": 50, "speaker": 8, "form": "dlg", "jp": "「待っていたよ‥‥」"},
{"id": 51, "speaker": 8, "form": "dlg", "jp": "「とりあえず、静かにしてもらおうか‥‥」"},
{"id": 52, "speaker": 8, "form": "dlg", "jp": "「ガツンッ！」"},
{"id": 53, "speaker": 8, "form": "dlg", "jp": "ボクはいきなり後頭部を殴られた。"},
{"id": 54, "speaker": 3, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 55, "speaker": 2, "form": "dlg", "jp": "「ね、姉さん‥‥」"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "だんだんと意識が遠くなる‥‥"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "いったいボクたちはどうなってしまうのだろう‥‥"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "２００５／０７／２３／ＰＭ０５：３０"},
{"id": 59, "speaker": 3, "form": "dlg", "jp": "「彼は、シローは大丈夫なんですか？」"},
{"id": 60, "speaker": 11, "form": "dlg", "jp": "「まあ、破壊されたのはバッテリーだけなんで‥‥」"},
{"id": 61, "speaker": 3, "form": "dlg", "jp": "「修理はしてもらえるんですよね‥‥」"},
{"id": 62, "speaker": 11, "form": "dlg", "jp": "「それは、なんとも‥‥」"},
{"id": 63, "speaker": 11, "form": "dlg", "jp": "「警察としても、あの『体』を放置するわけには‥‥」"},
{"id": 64, "speaker": 11, "form": "dlg", "jp": "「それに、『暴走』している可能性もあるんで‥‥」"},
{"id": 65, "speaker": 11, "form": "choice", "jp": "「たしかにそうだけど‥‥」"},
{"id": 66, "speaker": 11, "form": "choice", "jp": "「暴走させたのは警察じゃないかっ！」"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "「たしかにそうだけど‥‥」"},
{"id": 68, "speaker": 3, "form": "dlg", "jp": "「いいえ、シローは暴走なんて‥‥」"},
{"id": 69, "speaker": 11, "form": "dlg", "jp": "「でも、実際逃げ出したわけだし‥‥」"},
{"id": 70, "speaker": 3, "form": "dlg", "jp": "「自分を守ろうとしただけです！」"},
{"id": 71, "speaker": 3, "form": "dlg", "jp": "「おかしくなったんじゃなくって、\n　まともな行動です！」"},
{"id": 72, "speaker": 11, "form": "dlg", "jp": "「うむぅ‥‥」"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "「暴走させたのは警察じゃないかっ！」"},
{"id": 74, "speaker": 3, "form": "dlg", "jp": "「いいえ、シローは暴走なんて‥‥」"},
{"id": 75, "speaker": 11, "form": "dlg", "jp": "「でも、実際逃げ出したわけだし‥‥」"},
{"id": 76, "speaker": 3, "form": "dlg", "jp": "「自分を守ろうとしただけです！」"},
{"id": 77, "speaker": 3, "form": "dlg", "jp": "「おかしくなったんじゃなくって、\n　まともな行動です！」"},
{"id": 78, "speaker": 11, "form": "dlg", "jp": "「うむぅ‥‥」"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "「で、シローは一体どこに電話を‥‥？」"},
{"id": 80, "speaker": 11, "form": "dlg", "jp": "「おおっ、そうだ！」"},
{"id": 81, "speaker": 11, "form": "dlg", "jp": "「なんでも、"},
{"id": 82, "speaker": 11, "form": "dlg", "jp": "『五色沢の別荘』"},
{"id": 83, "speaker": 11, "form": "dlg", "jp": "に\n　電話をしていたみたいだ‥‥」"},
{"id": 84, "speaker": 3, "form": "dlg", "jp": "「『五色沢』！！」"},
{"id": 85, "speaker": 3, "form": "dlg", "jp": "「『五色沢』なら、父さんの大学の古い研究室が‥‥」"},
{"id": 86, "speaker": 11, "form": "dlg", "jp": "「現在、令状の手配をしている最中だ」"},
{"id": 87, "speaker": 11, "form": "dlg", "jp": "「令状が発行され次第、現場へ向かう予定だが‥‥」"},
{"id": 88, "speaker": 11, "form": "dlg", "jp": "「コン、コン」"},
{"id": 89, "speaker": 11, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 90, "speaker": 23, "form": "dlg", "jp": "「失礼します！」"},
{"id": 91, "speaker": 11, "form": "dlg", "jp": "「どうかしたのか？」"},
{"id": 92, "speaker": 23, "form": "dlg", "jp": "「実は‥‥」"},
{"id": 93, "speaker": 23, "form": "dlg", "jp": "科学班員は大槻警部に耳打ちをした‥‥"},
{"id": 94, "speaker": 3, "form": "dlg", "jp": "「何かあったんですか？」"},
{"id": 95, "speaker": 11, "form": "dlg", "jp": "「いや、そのう‥‥」"},
{"id": 96, "speaker": 3, "form": "dlg", "jp": "「シローのことですねっ！」"},
{"id": 97, "speaker": 11, "form": "dlg", "jp": "「いや、ははははは‥‥」"},
{"id": 98, "speaker": 11, "form": "dlg", "jp": "「スミマセン！！」"},
{"id": 99, "speaker": 3, "form": "dlg", "jp": "「はぁ！？」"},
{"id": 100, "speaker": 11, "form": "dlg", "jp": "「実は、『シローくん』のデータが‥‥」"},
{"id": 101, "speaker": 11, "form": "dlg", "jp": "「"},
{"id": 102, "speaker": 11, "form": "dlg", "jp": "消えてしまってる"},
{"id": 103, "speaker": 11, "form": "dlg", "jp": "そうです‥‥」"},
{"id": 104, "speaker": 3, "form": "dlg", "jp": "「‥‥！？」"},
{"id": 105, "speaker": 23, "form": "dlg", "jp": "「データどころか、メインプログラムまで、\n　メモリがすっかりクリアされてました‥‥」"},
{"id": 106, "speaker": 23, "form": "dlg", "jp": "「たぶん、自分でメモリ消去のプログラムを‥‥」"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "（ウソだろう‥‥）"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "姉さんはよほどショックだったのか、\nだまり込んでしまった‥‥"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "もちろん、ショックだったのはボクも同じだった。"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "（どうして、そんなことを？）"},
{"id": 111, "speaker": 2, "form": "choice", "jp": "「そこまでして『データ』を見られたくなかった‥‥」"},
{"id": 112, "speaker": 2, "form": "choice", "jp": "「そこまでして『命令』を守ろうとした‥‥」"},
{"id": 113, "speaker": 2, "form": "choice", "jp": "「違うっ！警察はウソをついている！」"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "（そこまでして『データ』を見られたくなかった‥‥）"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "確かにボクも心の中をのぞかれるとしたら\n死にたくなるに違いなかった。"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "人間と同じ感情を持っているということは\n当然、そうした感情も持っていたんだろう‥‥"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "（そこまでして『命令』を守ろうとした‥‥）"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "人間のボクには理解できない感情だった。"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "しかし、機械である彼は絶対に『命令』を\nやぶることはできなかったんだ‥‥"},
{"id": 120, "speaker": 2, "form": "dlg", "jp": "（違うっ！警察はウソをついている！）"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "「警部さん、\n　シローのプログラムを消してしまったんだね！」"},
{"id": 122, "speaker": 11, "form": "dlg", "jp": "「いや、絶対にそんなことは‥‥」"},
{"id": 123, "speaker": 23, "form": "dlg", "jp": "「はい、それは絶対ありません！」"},
{"id": 124, "speaker": 11, "form": "dlg", "jp": "「まさか、ブラバスキー警視が‥‥？」"},
{"id": 125, "speaker": 23, "form": "dlg", "jp": "「それもありえません！」"},
{"id": 126, "speaker": 23, "form": "dlg", "jp": "「それに、プログラムだけでなく\n　データも消えていますから‥‥」"},
{"id": 127, "speaker": 23, "form": "dlg", "jp": "どうやら、本当にシローは自分の意志で、\n自分を消し去った様だった。"},
{"id": 128, "speaker": 23, "form": "dlg", "jp": "人間であるボクには、自分で自分の命を断つことを\n理解することができなかった‥‥"},
{"id": 129, "speaker": 11, "form": "dlg", "jp": "「まあ、シローくんなりに\n　ベストな判断をしたんじゃないかな‥‥？」"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "「何がベストなんですかっ！！」"},
{"id": 131, "speaker": 11, "form": "dlg", "jp": "「絶対居場所を教えるなという博士の命令と‥‥」"},
{"id": 132, "speaker": 11, "form": "dlg", "jp": "「居場所を知りたいという\n　キミたちの願いを両方かなえたんだから‥‥」"},
{"id": 133, "speaker": 3, "form": "dlg", "jp": "「‥‥？」"},
{"id": 134, "speaker": 11, "form": "dlg", "jp": "「彼は博士の命令通り\n　最後まで博士の居場所を教えなかった‥‥」"},
{"id": 135, "speaker": 11, "form": "dlg", "jp": "「しかし、電話をかけることで、\n　『ヒント』だけはくれた‥‥」"},
{"id": 136, "speaker": 11, "form": "dlg", "jp": "「その『ヒント』をどう使おうが、\n　彼の責任ではないんじゃぁないかな‥‥」"},
{"id": 137, "speaker": 3, "form": "dlg", "jp": "「うっうぅ‥‥」"},
{"id": 138, "speaker": 3, "form": "dlg", "jp": "姉さんはガマンしきれなくなったのか\nついに泣き崩れてしまった。"},
{"id": 139, "speaker": 3, "form": "dlg", "jp": "警部さんたちはやさしい言葉を残して、\n部屋を出て行ってしまった。"},
{"id": 140, "speaker": 3, "form": "dlg", "jp": "ボクは泣き崩れている\n姉さんと２人きりになった。"},
{"id": 141, "speaker": 3, "form": "dlg", "jp": "そして、重苦しい空気の中で\nボクは重大なことに気付いてしまった。"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "（シローにキチンとお礼を言っていなかった‥‥）"},
{"id": 143, "speaker": 2, "form": "dlg", "jp": "そしてボクも大きな悲しみにおそわれた。"},
{"id": 144, "speaker": 2, "form": "dlg", "jp": "ボクは声を出して泣きそうになった。"},
{"id": 145, "speaker": 2, "form": "dlg", "jp": "しかし、泣き崩れている姉を横にして\nそうすることができなかった。"},
{"id": 146, "speaker": 2, "form": "dlg", "jp": "そう、ボクは強くならなくてはならないんだ‥‥"},
{"id": 147, "speaker": 2, "form": "dlg", "jp": "『シロー』がいなくなった今、\nボクが姉さんを守らなくては‥‥"},
{"id": 148, "speaker": 2, "form": "dlg", "jp": "「コン、コン」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 150, "speaker": 11, "form": "dlg", "jp": "「『捜査令状』が出ました\n　これから博士のところに行って来ます！」"},
{"id": 151, "speaker": 3, "form": "dlg", "jp": "「私たちも連れていってください！」"},
{"id": 152, "speaker": 3, "form": "dlg", "jp": "「お願いしますっ！！」"},
{"id": 153, "speaker": 11, "form": "dlg", "jp": "「しかし‥‥」"},
{"id": 154, "speaker": 3, "form": "dlg", "jp": "「『シロー』は私たちに父の居場所を知らせるために‥‥」"},
{"id": 155, "speaker": 11, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 156, "speaker": 11, "form": "dlg", "jp": "「特例ですからね！」"},
{"id": 157, "speaker": 3, "form": "dlg", "jp": "「ありがとうございますっ！！」"},
{"id": 158, "speaker": 3, "form": "dlg", "jp": "ボクたちは『シロー』のくれた\n『ヒント』の場所に行くことになった。"},
{"id": 159, "speaker": 3, "form": "dlg", "jp": "『シロー』が電話をかけていたのは\n別荘地にある父さんの大学の古い研究室だった。"},
{"id": 160, "speaker": 3, "form": "dlg", "jp": "たしかに父さんがいてもおかしくない場所だが、\nこれまで、誰も探さなかったのが不思議な場所だった。"},
{"id": 161, "speaker": 11, "form": "dlg", "jp": "「見つかるといいですね、お父さん‥‥」"},
{"id": 162, "speaker": 3, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 163, "speaker": 3, "form": "dlg", "jp": "姉さんは返事をしなかった。"},
{"id": 164, "speaker": 3, "form": "dlg", "jp": "そして、車の中にも重たい空気が充満した。"},
{"id": 165, "speaker": 3, "form": "dlg", "jp": "ボクは早く目的地に着いて、\nそこに父さんがいてくれるように祈った。"},
{"id": 166, "speaker": 2, "form": "dlg", "jp": "（どうか、父さんは無事でありますように‥‥‥）"},
{"id": 167, "speaker": 11, "form": "dlg", "jp": "「もうすぐ、ですよ‥‥」"},
{"id": 168, "speaker": 11, "form": "dlg", "jp": "２００５／０７／２３／ＰＭ０６：４０"},
{"id": 169, "speaker": 12, "form": "dlg", "jp": "「ごくろうさま‥‥」"},
{"id": 170, "speaker": 21, "form": "dlg", "jp": "「おそかったわね‥‥」"},
{"id": 171, "speaker": 11, "form": "dlg", "jp": "「なんか、以前にもこうやってしかられたような‥‥」"},
{"id": 172, "speaker": 21, "form": "dlg", "jp": "「さあ、行きましょう‥‥」"},
{"id": 173, "speaker": 21, "form": "dlg", "jp": "「それから、アナタたち！」"},
{"id": 174, "speaker": 21, "form": "dlg", "jp": "「十分注意してね、当然ヤツらもここのこと\n　気付いているハズだから‥‥」"},
{"id": 175, "speaker": 2, "form": "dlg", "jp": "「はい‥‥」"},
{"id": 176, "speaker": 3, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 177, "speaker": 3, "form": "dlg", "jp": "姉さんはやはり返事をしなかった。"},
{"id": 178, "speaker": 3, "form": "dlg", "jp": "研究室は別荘の一番奥にあり、\nそこまでは歩いて行かなくてはならなかった。"},
{"id": 179, "speaker": 3, "form": "dlg", "jp": "そして、その道中、警部さんたちのどんな言葉にも\n姉さんは決して返事をしなかった。"},
{"id": 180, "speaker": 21, "form": "dlg", "jp": "「ついたわよ！」"},
{"id": 181, "speaker": 21, "form": "dlg", "jp": "そこは古い洋館だった。"},
{"id": 182, "speaker": 21, "form": "dlg", "jp": "大学の研究室というものが\nイメージのできないボクには意外な建物であった。"},
{"id": 183, "speaker": 11, "form": "dlg", "jp": "「本当にこんなところにいるのか？」"},
{"id": 184, "speaker": 11, "form": "choice", "jp": "【見る】"},
