{"id": 125, "speaker": 29, "form": "dlg", "jp": "「『信号の解析に手間取ってる』って‥‥」"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "「大丈夫かしら‥‥」"},
{"id": 127, "speaker": 29, "form": "dlg", "jp": "「心配だわ‥‥」"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 129, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
