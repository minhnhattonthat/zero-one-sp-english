{"id": 112, "speaker": 2, "form": "dlg", "jp": "「ローズ‥‥」"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "「信号の解析に手間取ってるって？」"},
{"id": 114, "speaker": 49, "form": "dlg", "jp": "「やっぱり、『未知の信号』だから‥‥」"},
{"id": 115, "speaker": 49, "form": "dlg", "jp": "「まあ、アナタが心配することじゃないわ‥‥」"},
{"id": 116, "speaker": 49, "form": "dlg", "jp": "「心配しなくて大丈夫よ‥‥」"},
{"id": 117, "speaker": 49, "form": "dlg", "jp": "「きっとなんとかなるわ‥‥」"},
{"id": 118, "speaker": 49, "form": "dlg", "jp": "【ケネス】"},
{"id": 119, "speaker": 2, "form": "dlg", "jp": "「ケネス‥‥」"},
{"id": 120, "speaker": 31, "form": "dlg", "jp": "「なんか、ヤバイ展開になってきたな‥‥」"},
{"id": 121, "speaker": 31, "form": "dlg", "jp": "「やっぱり、オレたちが戦うしかないのか‥‥」"},
{"id": 122, "speaker": 31, "form": "dlg", "jp": "「ちくしょうっ！」"},
{"id": 123, "speaker": 31, "form": "dlg", "jp": "【ジーン】"},
