[
{"id": 0, "speaker": 8, "form": "dlg", "jp": "「オイ、起きろ！」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "（‥‥‥）"},
{"id": 2, "speaker": 8, "form": "dlg", "jp": "「着いたぞっ！！」"},
{"id": 3, "speaker": 8, "form": "dlg", "jp": "「さっさと起きるんだっ！」"},
{"id": 4, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 5, "speaker": 3, "form": "dlg", "jp": "「ナゴム、着いたみたいよ‥‥」"},
{"id": 6, "speaker": 28, "form": "dlg", "jp": "「良く眠れたようだな？」"},
{"id": 7, "speaker": 2, "form": "dlg", "jp": "「これからどうするつもりだ！？」"},
{"id": 8, "speaker": 28, "form": "dlg", "jp": "「リツコさんには『研究室』の方に入ってもらう‥‥」"},
{"id": 9, "speaker": 28, "form": "dlg", "jp": "「君とはここで離ればなれだ‥‥」"},
{"id": 10, "speaker": 8, "form": "dlg", "jp": "「オマエには"},
{"id": 11, "speaker": 8, "form": "dlg", "jp": "特別すてきな部屋"},
{"id": 12, "speaker": 8, "form": "dlg", "jp": "に入ってもらう‥‥」"},
{"id": 13, "speaker": 8, "form": "dlg", "jp": "「さあ、来いっ！！」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「放せっ、自分で歩ける！！」"},
{"id": 15, "speaker": 3, "form": "dlg", "jp": "「ナゴムッ！！」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「大丈夫、心配しないで‥‥」"},
{"id": 17, "speaker": 2, "form": "dlg", "jp": "ボクたちは別々の場所に連行されることになった。"},
{"id": 18, "speaker": 8, "form": "dlg", "jp": "「スゴイ工場だろう‥‥」"},
{"id": 19, "speaker": 8, "form": "dlg", "jp": "「ここで、\n　ルードのあつかう武器の８０％が作られてるんだ！」"},
{"id": 20, "speaker": 8, "form": "dlg", "jp": "「まあ、ルードのメイン工場‥‥」"},
{"id": 21, "speaker": 8, "form": "dlg", "jp": "「逃げようとか企んでもムダだからな‥‥」"},
{"id": 22, "speaker": 8, "form": "dlg", "jp": "「まあ、逃げたとしてもジャングルで迷子になって\n　死ぬだけだがな‥‥」"},
{"id": 23, "speaker": 8, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 24, "speaker": 8, "form": "dlg", "jp": "「さあ、今日からここがオマエのネグラだ‥‥」"},
{"id": 25, "speaker": 8, "form": "dlg", "jp": "「とりあえず、オマエの姉さんが\n　すんなり言うことを聞いてくれれば」"},
{"id": 26, "speaker": 8, "form": "dlg", "jp": "「もっとましな部屋に移してやる」"},
{"id": 27, "speaker": 8, "form": "dlg", "jp": "「あの女のことだ、\n　すんなりと言うことを聞くとは思えないがな‥‥」"},
{"id": 28, "speaker": 8, "form": "dlg", "jp": "「まあ、あの女が言うことを聞きたくなるよう\n　早くやつれてくれ！」"},
{"id": 29, "speaker": 8, "form": "dlg", "jp": "「それから、"},
{"id": 30, "speaker": 8, "form": "dlg", "jp": "熱射病"},
{"id": 31, "speaker": 8, "form": "dlg", "jp": "や"},
{"id": 32, "speaker": 8, "form": "dlg", "jp": "脱水症"},
{"id": 33, "speaker": 8, "form": "dlg", "jp": "に気をつけるんだな‥‥」"},
{"id": 34, "speaker": 8, "form": "dlg", "jp": "「ここにはクーラーなんてないからな‥‥」"},
{"id": 35, "speaker": 8, "form": "dlg", "jp": "「"},
{"id": 36, "speaker": 8, "form": "dlg", "jp": "水だけ"},
{"id": 37, "speaker": 8, "form": "dlg", "jp": "は差し入れてやる‥‥きちんと補給しろ！」"},
{"id": 38, "speaker": 8, "form": "dlg", "jp": "「ここは特別な牢屋だから、見張りはいない‥‥」"},
{"id": 39, "speaker": 8, "form": "dlg", "jp": "「つまり、体調を崩しても、\n　見回りが来るまでは放置されることになる」"},
{"id": 40, "speaker": 8, "form": "dlg", "jp": "「死にたく無ければ、\n　水分の補給だけはかかさないようにしろ！」"},
{"id": 41, "speaker": 8, "form": "dlg", "jp": "「それから‥‥」"},
{"id": 42, "speaker": 8, "form": "dlg", "jp": "「見張りはいないと言ったが、\n　脱走なんてことは考えるな！」"},
{"id": 43, "speaker": 8, "form": "dlg", "jp": "「この牢は特別で、中からは決して\n　開けることができないようになっている！」"},
{"id": 44, "speaker": 8, "form": "dlg", "jp": "「オレも出る時は外で待っている子分に\n　開けてもらわないと出られないわけだ‥‥」"},
{"id": 45, "speaker": 8, "form": "dlg", "jp": "「もし、無理に内側から開けようとすると\n　"},
{"id": 46, "speaker": 8, "form": "dlg", "jp": "高圧電流"},
{"id": 47, "speaker": 8, "form": "dlg", "jp": "が流れて黒コゲになってしまうからな！」"},
{"id": 48, "speaker": 8, "form": "dlg", "jp": "「バタン！」"},
{"id": 49, "speaker": 8, "form": "dlg", "jp": "そう言い残してアキスは立ち去った。"},
{"id": 50, "speaker": 2, "form": "dlg", "jp": "（高圧電流か‥‥）"},
{"id": 51, "speaker": 2, "form": "dlg", "jp": "（どうすればいいんだ‥‥）"},
{"id": 52, "speaker": 2, "form": "dlg", "jp": "（たしか、水はくれるといっていた‥‥）"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "（ということは‥‥）"},
{"id": 54, "speaker": 2, "form": "choice", "jp": "（食事はくれないということか‥‥）"},
{"id": 55, "speaker": 2, "form": "choice", "jp": "（殺すつもりはないということか‥‥）"},
{"id": 56, "speaker": 2, "form": "dlg", "jp": "（食事はくれないということか‥‥）"},
{"id": 57, "speaker": 2, "form": "dlg", "jp": "（そうか、ボクのヤツレた姿を\n　姉さんに見せつけるつもりだな‥‥）"},
{"id": 58, "speaker": 2, "form": "dlg", "jp": "（ちくしょう！）"},
{"id": 59, "speaker": 2, "form": "dlg", "jp": "（殺すつもりはないということか‥‥）"},
{"id": 60, "speaker": 2, "form": "dlg", "jp": "（そうか、ボクのヤツレた姿を\n　姉さんに見せつけるつもりだな‥‥）"},
{"id": 61, "speaker": 2, "form": "dlg", "jp": "（ちくしょう！）"},
{"id": 62, "speaker": 2, "form": "choice", "jp": "（どうにかしてここから逃げ出さないと‥‥）"},
{"id": 63, "speaker": 2, "form": "choice", "jp": "（イヤ、それはキケンだ！！）"},
{"id": 64, "speaker": 2, "form": "dlg", "jp": "（どうにかしてここから逃げ出さないと‥‥）"},
{"id": 65, "speaker": 2, "form": "dlg", "jp": "（ボクが人質になってる以上、\n　きっと姉さんはヤツらのいいなりになってしまう！！）"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "（そんなことになったら‥‥）"},
{"id": 67, "speaker": 2, "form": "dlg", "jp": "（しかし、どうやったら逃げ出せるんだ？）"},
{"id": 68, "speaker": 2, "form": "dlg", "jp": "（イヤ、それはキケンだ！！）"},
{"id": 69, "speaker": 2, "form": "dlg", "jp": "（ボクが姉さんにとっての人質なのと同じように、\n　姉さんも人質なんだ）"},
{"id": 70, "speaker": 2, "form": "dlg", "jp": "（もしボクだけ逃げ出そうもんなら、\n　きっと姉さんは殺されてしまう！！）"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "（それに逃げ出す方法もわからない‥‥）"},
{"id": 72, "speaker": 2, "form": "dlg", "jp": "（とにかく、なんとかしないと‥‥）"},
{"id": 73, "speaker": 2, "form": "dlg", "jp": "（ここは日本じゃないんだ、\n　警部さんたちが助けに来てくれるとは考えられない）"},
{"id": 74, "speaker": 2, "form": "dlg", "jp": "（まして、\n　いつもボクたちを守ってくれていたシローも‥‥）"},
{"id": 75, "speaker": 2, "form": "dlg", "jp": "（どうすればいいんだ‥‥）"},
{"id": 76, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 77, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥‥‥‥‥‥‥）"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥）"},
{"id": 79, "speaker": 2, "form": "dlg", "jp": "（‥‥‥）"},
{"id": 80, "speaker": 2, "form": "dlg", "jp": "（ダメだ‥‥）"},
{"id": 81, "speaker": 4, "form": "dlg", "jp": "（困っているみたいだね？）"},
{"id": 82, "speaker": 4, "form": "choice", "jp": "「誰だっ！？」"},
{"id": 83, "speaker": 4, "form": "choice", "jp": "「当たり前だろう！！」"},
{"id": 84, "speaker": 2, "form": "dlg", "jp": "「誰だっ！？」"},
{"id": 85, "speaker": 4, "form": "dlg", "jp": "（ダメだよ、声を出しちゃ‥‥）"},
{"id": 86, "speaker": 2, "form": "dlg", "jp": "「？？？」"},
{"id": 87, "speaker": 4, "form": "dlg", "jp": "（頭の中で返事をして‥‥）"},
{"id": 88, "speaker": 4, "form": "dlg", "jp": "（この『声』が聞こえているの？）"},
{"id": 89, "speaker": 4, "form": "choice", "jp": "「ああ、聞こえる！」"},
{"id": 90, "speaker": 4, "form": "choice", "jp": "（ああ、聞こえる‥‥）"},
{"id": 91, "speaker": 2, "form": "dlg", "jp": "「ああ、聞こえる！」"},
{"id": 92, "speaker": 4, "form": "dlg", "jp": "（バカ！　声を出しちゃダメだって‥‥）"},
{"id": 93, "speaker": 2, "form": "dlg", "jp": "「？？？？？」"},
{"id": 94, "speaker": 4, "form": "dlg", "jp": "（とりあえず聞こえてるみたいだね‥‥）"},
{"id": 95, "speaker": 4, "form": "dlg", "jp": "（いい？　何でもいいから、しばらく黙ってて‥‥）"},
{"id": 96, "speaker": 2, "form": "dlg", "jp": "（ああ、聞こえる‥‥）"},
{"id": 97, "speaker": 4, "form": "dlg", "jp": "（そう、声を出さないでね‥‥）"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "（で、キミはいったい‥‥？）"},
{"id": 99, "speaker": 4, "form": "dlg", "jp": "（いまから説明するから‥‥）"},
{"id": 100, "speaker": 2, "form": "dlg", "jp": "「当たり前だろう！！」"},
{"id": 101, "speaker": 4, "form": "dlg", "jp": "（ダメだって、声を出しちゃ‥‥）"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「？？？」"},
{"id": 103, "speaker": 4, "form": "dlg", "jp": "（頭の中で返事をして‥‥）"},
{"id": 104, "speaker": 4, "form": "dlg", "jp": "（この『声』が聞こえている？）"},
{"id": 105, "speaker": 4, "form": "choice", "jp": "「ああ、聞こえる！」"},
{"id": 106, "speaker": 4, "form": "choice", "jp": "（ああ、聞こえる‥‥）"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "「ああ、聞こえる！」"},
{"id": 108, "speaker": 4, "form": "dlg", "jp": "（バカ！　声を出しちゃダメだって‥‥）"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "「？？？？？」"},
{"id": 110, "speaker": 4, "form": "dlg", "jp": "（とりあえず聞こえてるみたいだね‥‥）"},
{"id": 111, "speaker": 4, "form": "dlg", "jp": "（いいかい？　何でもいいから、しばらく黙ってて‥‥）"},
{"id": 112, "speaker": 4, "form": "dlg", "jp": "（ボクは『ジーン』‥‥）"},
{"id": 113, "speaker": 29, "form": "dlg", "jp": "（キミと同じように、隣の牢に監禁されている‥‥）"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "「隣？」"},
{"id": 115, "speaker": 29, "form": "dlg", "jp": "（声を出さないでって！！）"},
{"id": 116, "speaker": 2, "form": "dlg", "jp": "「そんな、キミばっかり話して、\n　会話できないじゃないか？」"},
{"id": 117, "speaker": 29, "form": "dlg", "jp": "（だから、ボクも声を出していないだろう？）"},
{"id": 118, "speaker": 2, "form": "dlg", "jp": "「はぁ？」"},
{"id": 119, "speaker": 29, "form": "dlg", "jp": "（もう解っただろう？）"},
{"id": 120, "speaker": 29, "form": "dlg", "jp": "（『テレパシー』さ‥‥）"},
{"id": 121, "speaker": 2, "form": "dlg", "jp": "（『テレパシー』？？）"},
{"id": 122, "speaker": 29, "form": "dlg", "jp": "（そう、ボクは空気振動を使わずに、\n　キミの心に直接語りかけているんだ‥‥）"},
{"id": 123, "speaker": 29, "form": "dlg", "jp": "（わかった？）"},
{"id": 124, "speaker": 2, "form": "dlg", "jp": "（理解はできるけど信じられない‥‥）"},
{"id": 125, "speaker": 29, "form": "dlg", "jp": "（信じるも何も、こうして会話が成立しているだろう？）"},
{"id": 126, "speaker": 2, "form": "dlg", "jp": "（そういえば‥‥）"},
{"id": 127, "speaker": 29, "form": "dlg", "jp": "（困っているんだろう？）"},
{"id": 128, "speaker": 29, "form": "dlg", "jp": "（今は信じて‥‥）"},
{"id": 129, "speaker": 29, "form": "dlg", "jp": "（困っているもの同士、助けあわないか？）"},
{"id": 130, "speaker": 2, "form": "dlg", "jp": "（助けあう‥‥？）"},
{"id": 131, "speaker": 2, "form": "dlg", "jp": "（ボクは今、牢の中だぜ、\n　助けることなんてできるわけないじゃないか？）"},
{"id": 132, "speaker": 29, "form": "dlg", "jp": "（だから、ボクが"},
{"id": 133, "speaker": 29, "form": "dlg", "jp": "牢から出る方法"},
{"id": 134, "speaker": 29, "form": "dlg", "jp": "を教えてあげる‥‥）"},
{"id": 135, "speaker": 29, "form": "dlg", "jp": "（代わりに、ボクを牢から出して欲しいんだ‥‥）"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "（？？？）"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "（ちょっとまってよ！）"},
{"id": 138, "speaker": 2, "form": "dlg", "jp": "（牢から出る方法を知ってるんなら自分で脱出すれば‥‥）"},
{"id": 139, "speaker": 29, "form": "dlg", "jp": "（できないから、頼んでるんだ！）"},
{"id": 140, "speaker": 2, "form": "dlg", "jp": "（それに、ここは『特別な牢』で、\n　中からは開けることができないって‥‥）"},
{"id": 141, "speaker": 29, "form": "dlg", "jp": "（確かに、この牢は特別だけど、\n　ここの連中は特別にバカだから‥‥）"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "（？？？）"},
{"id": 143, "speaker": 29, "form": "dlg", "jp": "（ここの連中はこの牢を信用しきっているから、\n　見回りは"},
{"id": 144, "speaker": 29, "form": "dlg", "jp": "１人で来る"},
{"id": 145, "speaker": 29, "form": "dlg", "jp": "）"},
{"id": 146, "speaker": 29, "form": "dlg", "jp": "（見回りが来たら"},
{"id": 147, "speaker": 29, "form": "dlg", "jp": "扉の陰に隠れて"},
{"id": 148, "speaker": 29, "form": "dlg", "jp": "おくんだ‥‥）"},
{"id": 149, "speaker": 29, "form": "dlg", "jp": "（見回りは、牢の中に姿が見えないとなると、\n　ドアを開けっ放しで牢の中を探すはず！）"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "（その隙にキミはドアから逃げ出せばいいんだ‥‥）"},
{"id": 151, "speaker": 2, "form": "dlg", "jp": "（そんな簡単に逃げられるハズが‥‥）"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "（絶対、大丈夫！　ボクを信じて‥‥）"},
{"id": 153, "speaker": 2, "form": "dlg", "jp": "（それに、そんなに簡単なら、自分でやれば‥‥）"},
{"id": 154, "speaker": 29, "form": "dlg", "jp": "（ボクはできないんだ‥‥）"},
{"id": 155, "speaker": 2, "form": "dlg", "jp": "（どうして？）"},
{"id": 156, "speaker": 29, "form": "dlg", "jp": "（服を奪われた‥‥）"},
{"id": 157, "speaker": 29, "form": "dlg", "jp": "（ハダカでは逃げられない！！）"},
{"id": 158, "speaker": 2, "form": "dlg", "jp": "（はあ？）"},
{"id": 159, "speaker": 2, "form": "dlg", "jp": "（このさい、ハダカなんてどうでもいいじゃん！）"},
{"id": 160, "speaker": 29, "form": "dlg", "jp": "（ダメだ！！）"},
{"id": 161, "speaker": 29, "form": "dlg", "jp": "（もし、無事に牢から出られたら、\n　廊下に放りだされているボクの服を拾って）"},
{"id": 162, "speaker": 29, "form": "dlg", "jp": "（隣の牢に投げ込んでくれないか‥‥？）"},
{"id": 163, "speaker": 2, "form": "dlg", "jp": "（キミの牢の扉はどうやって‥‥？）"},
{"id": 164, "speaker": 29, "form": "dlg", "jp": "（ここの牢の扉は中からは絶対開けられないケド）"},
{"id": 165, "speaker": 29, "form": "dlg", "jp": "（外からは『暗証番号』さえ入力すれば、\n　簡単に開けられるんだ）"},
{"id": 166, "speaker": 29, "form": "dlg", "jp": "（この牢の『電子ロック』は簡単なものだから‥‥）"},
{"id": 167, "speaker": 29, "form": "dlg", "jp": "（ある程度はボクの『能力』で\n　解析することができる！）"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "（『能力』‥‥？）"},
{"id": 169, "speaker": 29, "form": "dlg", "jp": "（ボクは、『見えない物を見ることができる』\n　『超能力者』なんだ‥‥）"},
{"id": 170, "speaker": 2, "form": "dlg", "jp": "（『超能力者』‥‥！？）"},
{"id": 171, "speaker": 29, "form": "dlg", "jp": "（まあ、そんなことはどうでもいい！）"},
{"id": 172, "speaker": 29, "form": "dlg", "jp": "（とにかく、ボクは『電子ロック』の『暗証番号』の\n　『ヒント』を探ることができるんだ！）"},
{"id": 173, "speaker": 2, "form": "dlg", "jp": "（『ヒント』だけなの‥‥）"},
{"id": 174, "speaker": 29, "form": "dlg", "jp": "（多分、それで十分なハズ！！）"},
{"id": 175, "speaker": 29, "form": "dlg", "jp": "（『ヒント』にしたがって行動すれば、\n　扉は簡単に開くから‥‥）"},
{"id": 176, "speaker": 29, "form": "dlg", "jp": "（あとは服を投げ込んで、ボクが服を着終えるまで\n　扉を開けて待っててくれればいいんだ！）"},
{"id": 177, "speaker": 29, "form": "dlg", "jp": "（後はボクが基地の外まで誘導してあげるから‥‥）"},
{"id": 178, "speaker": 29, "form": "dlg", "jp": "（どうだい、悪い話じゃないだろう？）"},
{"id": 179, "speaker": 29, "form": "choice", "jp": "（わかった、信じよう！）"},
{"id": 180, "speaker": 29, "form": "choice", "jp": "（ダメだ‥‥信用できない！）"},
{"id": 181, "speaker": 2, "form": "dlg", "jp": "（ダメだ‥‥信用できない！）"},
{"id": 182, "speaker": 2, "form": "dlg", "jp": "（第一、キミが味方かどうかも‥‥）"},
{"id": 183, "speaker": 29, "form": "dlg", "jp": "（味方に決まってるだろう！）"},
{"id": 184, "speaker": 29, "form": "dlg", "jp": "（そうじゃなかったらどうして牢に‥‥）"},
{"id": 185, "speaker": 29, "form": "choice", "jp": "（わかった、信じよう！）"},
{"id": 186, "speaker": 29, "form": "choice", "jp": "（その話自体怪しい‥‥）"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "（その話自体怪しい‥‥）"},
{"id": 188, "speaker": 29, "form": "dlg", "jp": "（わかった、\n　じゃあゆっくりと壁をノックするそれで良いだろう？）"},
{"id": 189, "speaker": 29, "form": "dlg", "jp": "「コン、コン」"},
{"id": 190, "speaker": 29, "form": "dlg", "jp": "（信じてくれたかい？）"},
{"id": 191, "speaker": 29, "form": "choice", "jp": "（わかった、信じよう！）"},
{"id": 192, "speaker": 29, "form": "choice", "jp": "（ダメだ、そんなに簡単に脱出できるハズがない‥‥）"},
{"id": 193, "speaker": 2, "form": "dlg", "jp": "（ダメだ、そんなに簡単に脱出できるハズがない‥‥）"},
{"id": 194, "speaker": 29, "form": "dlg", "jp": "「もういい、キミには頼まない！！」"},
{"id": 195, "speaker": 29, "form": "dlg", "jp": "それから、\n２度とテレパシーの交信がされることはなかった。"},
{"id": 196, "speaker": 29, "form": "dlg", "jp": "そのまま、長い時間が流れた。"},
{"id": 197, "speaker": 29, "form": "dlg", "jp": "用心深いボクは、\n差し入れの水にすら手をつけることができなかったので"},
{"id": 198, "speaker": 29, "form": "dlg", "jp": "『脱水症状』になっていた。"},
{"id": 199, "speaker": 29, "form": "dlg", "jp": "意識はもうろうとし、もう助けを呼ぶ気力もない。"},
{"id": 200, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 201, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 202, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥\n‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 203, "speaker": 29, "form": "dlg", "jp": "多分ボクはこのまま死んでしまうのだろう‥‥"},
{"id": 204, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥きっと‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 205, "speaker": 2, "form": "dlg", "jp": "（わかった、信じよう！）"},
{"id": 206, "speaker": 29, "form": "dlg", "jp": "（アリガトウ‥‥）"},
{"id": 207, "speaker": 29, "form": "dlg", "jp": "（じゃあ、行動は次の水の差し入れ時間だ‥‥）"},
{"id": 208, "speaker": 29, "form": "dlg", "jp": "（ヤツらは見回りもかねて、１時間ごとに水を持ってくる）"},
{"id": 209, "speaker": 29, "form": "dlg", "jp": "（そのタイミングで‥‥）"},
{"id": 210, "speaker": 2, "form": "dlg", "jp": "（わかった！）"},
{"id": 211, "speaker": 29, "form": "dlg", "jp": "（じゃあ、最終確認だ‥‥）"},
{"id": 212, "speaker": 29, "form": "dlg", "jp": "（まず、見回りが水をもって来たら‥‥）"},
{"id": 213, "speaker": 29, "form": "choice", "jp": "（隙をみて飛び出す！）"},
{"id": 214, "speaker": 29, "form": "choice", "jp": "（扉の後ろに隠れる！）"},
{"id": 215, "speaker": 2, "form": "dlg", "jp": "（隙をみて飛び出す！）"},
{"id": 216, "speaker": 29, "form": "dlg", "jp": "（ダメだ、そんなことをしたら射殺される！）"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "（まずは、扉の後ろにかくれて、\n　牢の中に見張りをおびき出すんだ）"},
{"id": 218, "speaker": 2, "form": "dlg", "jp": "（ああ、そうだった‥‥）"},
{"id": 219, "speaker": 2, "form": "dlg", "jp": "（扉の後ろに隠れる！）"},
{"id": 220, "speaker": 29, "form": "dlg", "jp": "（そう、まずは、扉の後ろにかくれて、\n　牢の中に見張りをおびき出すんだ）"},
{"id": 221, "speaker": 29, "form": "dlg", "jp": "（そして、見回りが牢の中に入って来たら\n　隙を見て抜け出し、）"},
{"id": 222, "speaker": 29, "form": "dlg", "jp": "（廊下にあるボクの服を拾って、\n　ボクの牢を開けて服を投げ込む）"},
{"id": 223, "speaker": 29, "form": "dlg", "jp": "（そして‥‥）"},
{"id": 224, "speaker": 29, "form": "choice", "jp": "（一目散に逃げる！）"},
{"id": 225, "speaker": 29, "form": "choice", "jp": "（キミが服を着終わるのを待つ）"},
{"id": 226, "speaker": 29, "form": "choice", "jp": "（キミが服を着るのをじっと見守る）"},
{"id": 227, "speaker": 2, "form": "dlg", "jp": "（一目散に逃げる！）"},
{"id": 228, "speaker": 29, "form": "dlg", "jp": "（『逃げる』って、\n　キミはここの出口を知らないんだろう？）"},
{"id": 229, "speaker": 29, "form": "dlg", "jp": "（ボクが服を着終えるまで\n　扉をあけて待っててくれ‥‥）"},
{"id": 230, "speaker": 29, "form": "dlg", "jp": "（あとは\n　ボクが出口まで案内する‥‥）"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "（わかった、キミの着替えを見守ればいいんだね？）"},
{"id": 232, "speaker": 29, "form": "dlg", "jp": "（ダメだ、ボクが服を着終えるまで\n　牢の中は見ないでくれ‥‥）"},
{"id": 233, "speaker": 2, "form": "dlg", "jp": "（ああ、わかった‥‥）"},
{"id": 234, "speaker": 2, "form": "dlg", "jp": "（キミが服を着るのをじっと見守る）"},
{"id": 235, "speaker": 29, "form": "dlg", "jp": "（ダメだ、ボクが服を着終えるまで\n　牢の中は見ないでくれ‥‥）"},
{"id": 236, "speaker": 2, "form": "dlg", "jp": "（ああ、わかった‥‥）"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "（キミが服を着終わるのを待つ）"},
{"id": 238, "speaker": 29, "form": "dlg", "jp": "（その通り！）"},
{"id": 239, "speaker": 29, "form": "dlg", "jp": "（ボクが服を着終えるまで\n　扉をあけて待っててくれ‥‥）"},
{"id": 240, "speaker": 29, "form": "dlg", "jp": "（あとは\n　ボクが出口まで案内する‥‥）"},
{"id": 241, "speaker": 29, "form": "dlg", "jp": "（それから、ボクが服を着終えるまで\n　牢の中は見ないでくれ‥‥）"},
{"id": 242, "speaker": 2, "form": "dlg", "jp": "（ああ、わかった‥‥）"},
{"id": 243, "speaker": 2, "form": "dlg", "jp": "ボクたちの無言の作戦会議は終了し、\nあとは、見回りが水を持ってくるのを待つだけだった。"},
{"id": 244, "speaker": 2, "form": "dlg", "jp": "（本当にうまくいくのかな？）"},
{"id": 245, "speaker": 2, "form": "dlg", "jp": "‥‥‥"},
{"id": 246, "speaker": 2, "form": "dlg", "jp": "‥‥‥"},
{"id": 247, "speaker": 2, "form": "dlg", "jp": "ボクはのどの奥から\n心臓を吐き出しそうなくらい緊張していた。"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "‥‥‥"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "‥‥‥"},
{"id": 250, "speaker": 2, "form": "dlg", "jp": "多分、失敗すれば殺されてしまうんだ。"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "‥‥‥"},
{"id": 252, "speaker": 2, "form": "dlg", "jp": "‥‥‥"},
{"id": 253, "speaker": 29, "form": "dlg", "jp": "（時間だ！！）"},
{"id": 254, "speaker": 29, "form": "dlg", "jp": "ジーンから、見回りがこっちへ向かったという\n信号が送られて来た。"},
{"id": 255, "speaker": 29, "form": "dlg", "jp": "ボクは扉の後ろに隠れ、\n見回りを迎え入れる準備をした。"},
{"id": 256, "speaker": 8, "form": "dlg", "jp": "「テメエ、脱走するつもりだな‥‥？」"},
{"id": 257, "speaker": 8, "form": "dlg", "jp": "「オマエには両足のうらみもあるんだ」"},
{"id": 258, "speaker": 8, "form": "dlg", "jp": "「死んでもらうぜ！！」"},
{"id": 259, "speaker": 8, "form": "dlg", "jp": "「ダーーーン！」"},
{"id": 260, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 261, "speaker": 2, "form": "dlg", "jp": "ボクの胸から大量の血が吹き出した。"},
{"id": 262, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 263, "speaker": 2, "form": "dlg", "jp": "ボクはそのまま意識を失った‥‥"},
{"id": 264, "speaker": 2, "form": "dlg", "jp": "（‥‥‥‥‥‥）"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "（ゴメン、タイミング失っちゃって‥‥）"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "（次はちゃんとするから‥‥）"},
{"id": 267, "speaker": 29, "form": "dlg", "jp": "（次はもうないんだ‥‥）"},
{"id": 268, "speaker": 2, "form": "dlg", "jp": "（どういうこと？）"},
{"id": 269, "speaker": 29, "form": "dlg", "jp": "（ボクにはわかるんだ‥‥）"},
{"id": 270, "speaker": 29, "form": "dlg", "jp": "（次の見回りの時間には、\n　ここはもう戦場になっている‥‥）"},
{"id": 271, "speaker": 2, "form": "dlg", "jp": "（意味がわからないよ！）"},
{"id": 272, "speaker": 29, "form": "dlg", "jp": "（ボクがさっき聞いた警察の無線によると、\n　警察がここに大挙して踏み込むと‥‥）"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "（じゃあ、警察に助けてもらえばいいじゃないか！）"},
{"id": 274, "speaker": 29, "form": "dlg", "jp": "（そうなればいいけど‥‥）"},
{"id": 275, "speaker": 29, "form": "dlg", "jp": "（もし警察がここに気付かなかったら‥‥）"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "（そんなワケないじゃないか！）"},
{"id": 277, "speaker": 2, "form": "dlg", "jp": "（キミのテレパシーで呼びかければ\n　気付かせることなんて簡単じゃないか？）"},
{"id": 278, "speaker": 29, "form": "dlg", "jp": "（キミは大きな勘違いをしている‥‥）"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "（ハァ？）"},
{"id": 280, "speaker": 29, "form": "dlg", "jp": "（ボクがテレパシーを送信しているんじゃないんだ‥‥）"},
{"id": 281, "speaker": 29, "form": "dlg", "jp": "（キミがテレパシーを受信しているだけなんだよ）"},
{"id": 282, "speaker": 2, "form": "dlg", "jp": "（どういうこと？）"},
{"id": 283, "speaker": 29, "form": "dlg", "jp": "（ラジオの電波は常に飛び回っているけど、\n　ラジオ自体がないと聞こえないだろう？）"},
{"id": 284, "speaker": 29, "form": "dlg", "jp": "（それと同じさ‥‥）"},
{"id": 285, "speaker": 29, "form": "dlg", "jp": "（キミが超能力者だから、\n　ボクのテレパシーを感じとれるだけなんだ‥‥）"},
{"id": 286, "speaker": 2, "form": "dlg", "jp": "（ボクが『超能力者』？）"},
{"id": 287, "speaker": 29, "form": "dlg", "jp": "（多分ね‥‥）"},
{"id": 288, "speaker": 2, "form": "dlg", "jp": "（でも、ボクは念写も、スプーン曲げも‥‥）"},
{"id": 289, "speaker": 29, "form": "dlg", "jp": "（‥‥‥）"},
{"id": 290, "speaker": 29, "form": "dlg", "jp": "（とりあえず、ボクは自力でなんとか脱出するから）"},
{"id": 291, "speaker": 29, "form": "dlg", "jp": "（キミはキミでそうしてくれ‥‥）"},
{"id": 292, "speaker": 29, "form": "dlg", "jp": "それから、\n２度とテレパシーの交信がされることはなかった。"},
{"id": 293, "speaker": 29, "form": "dlg", "jp": "そして‥‥‥"},
{"id": 294, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥夕方になった。"},
{"id": 295, "speaker": 29, "form": "dlg", "jp": "やたらと外が騒がしい‥‥"},
{"id": 296, "speaker": 29, "form": "dlg", "jp": "ジーンの言ってた通り、警察がやってきたようだ‥‥"},
{"id": 297, "speaker": 29, "form": "dlg", "jp": "だんだん火薬の匂いがしてきた。"},
{"id": 298, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 299, "speaker": 29, "form": "dlg", "jp": "あちこちで銃声と爆発音が聞こえる‥‥"},
{"id": 300, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 301, "speaker": 29, "form": "dlg", "jp": "姉さんは大丈夫なんだろうか‥‥"},
{"id": 302, "speaker": 29, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥\n‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 303, "speaker": 2, "form": "dlg", "jp": "（ジーン、大丈夫か？）"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "返事がない‥‥"},
{"id": 305, "speaker": 2, "form": "dlg", "jp": "「ジーン！！ジーンてばっ！！」"},
{"id": 306, "speaker": 2, "form": "dlg", "jp": "もしかして、もう逃げたのか？"},
{"id": 307, "speaker": 2, "form": "dlg", "jp": "それとも‥‥"},
{"id": 308, "speaker": 2, "form": "dlg", "jp": "爆発音がだんだん近付いてくる‥‥"},
{"id": 309, "speaker": 2, "form": "dlg", "jp": "このままここにいては危険だ‥‥"},
{"id": 310, "speaker": 2, "form": "dlg", "jp": "「ドンドン！」"},
{"id": 311, "speaker": 2, "form": "dlg", "jp": "「誰か助けてください～！！」"},
{"id": 312, "speaker": 2, "form": "dlg", "jp": "「ドンドン！」"},
{"id": 313, "speaker": 2, "form": "dlg", "jp": "「ここに、閉じ込められています～！！」"},
{"id": 314, "speaker": 2, "form": "dlg", "jp": "どんなに大声をあげても爆音や銃声にかき消されてしまう。"},
{"id": 315, "speaker": 2, "form": "dlg", "jp": "‥‥‥‥‥‥‥‥‥‥‥‥‥そして‥‥‥‥‥‥‥‥‥‥‥"},
{"id": 316, "speaker": 2, "form": "dlg", "jp": "「バーーーン！」"},
{"id": 317, "speaker": 2, "form": "dlg", "jp": "（成功だ！！）"},
{"id": 318, "speaker": 2, "form": "dlg", "jp": "「ドンドン！」"},
{"id": 319, "speaker": 8, "form": "dlg", "jp": "「オイコラ、出しやがれ！！」"},
{"id": 320, "speaker": 8, "form": "dlg", "jp": "「オイ、開けるんだ！」"},
{"id": 321, "speaker": 2, "form": "dlg", "jp": "「ムリに開けようとしないほうがいいよ、\n　高圧電流が流れるから‥‥」"},
{"id": 322, "speaker": 8, "form": "dlg", "jp": "「ちくしょうっ！」"},
{"id": 323, "speaker": 2, "form": "dlg", "jp": "（さてと‥‥）"},
{"id": 324, "speaker": 2, "form": "dlg", "jp": "（廊下に服が放り出されてるっていってたな‥‥）"},
{"id": 325, "speaker": 2, "form": "dlg", "jp": "確かに隣の牢の前に服が放りだされていた。"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "（変わった服だな‥‥？）"},
{"id": 327, "speaker": 2, "form": "dlg", "jp": "（どこかの民族衣装みたいだ‥‥）"},
{"id": 328, "speaker": 2, "form": "dlg", "jp": "ボクは服を拾って隣の牢へ向かった。"},
{"id": 329, "speaker": 29, "form": "dlg", "jp": "（うまくいったようだね‥‥）"},
{"id": 330, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 331, "speaker": 29, "form": "dlg", "jp": "（服は‥‥？）"},
{"id": 332, "speaker": 2, "form": "dlg", "jp": "「持って来たよ！」"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "「それより、『暗証番号』を‥‥！！」"},
{"id": 334, "speaker": 29, "form": "dlg", "jp": "（だから、『暗証番号』はわからないんだって！）"},
{"id": 335, "speaker": 29, "form": "dlg", "jp": "（でも、『ヒント』はわかるから‥‥）"},
{"id": 336, "speaker": 29, "form": "dlg", "jp": "（ここの『暗証番号』は『４桁の数字』なんだ‥‥）"},
{"id": 337, "speaker": 29, "form": "dlg", "jp": "（でたらめでもいいから入力してみてくれ！）"},
{"id": 338, "speaker": 29, "form": "dlg", "jp": "（そしたら、ボクの能力で‥‥）"},
{"id": 339, "speaker": 29, "form": "dlg", "jp": "（『桁は間違ってるけど、合っている数字の数』と）"},
{"id": 340, "speaker": 29, "form": "dlg", "jp": "（『桁も数字も合っている数』を\n　知ることができるから‥‥）"},
{"id": 341, "speaker": 29, "form": "dlg", "jp": "（それを『ヒント』に『正解』を見つけだしてくれ！）"},
{"id": 342, "speaker": 2, "form": "dlg", "jp": "「なんだかわからないけど、やってみるよ！」"},
{"id": 343, "speaker": 29, "form": "dlg", "jp": "（急いでくれ！）"},
{"id": 344, "speaker": 29, "form": "dlg", "jp": "（もうすぐ、君の脱走が知れ渡るころだ！）"},
{"id": 345, "speaker": 29, "form": "dlg", "jp": "（チャンスはだいたい『１０回』ぐらいが限度だ！）"},
{"id": 346, "speaker": 29, "form": "dlg", "jp": "（グズグズしていたら見張りが来てしまう！）"},
{"id": 347, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 348, "speaker": 2, "form": "dlg", "jp": "「『１０回』以内にあければいいんだね！」"},
{"id": 349, "speaker": 29, "form": "dlg", "jp": "（早くっ！）"},
{"id": 350, "speaker": 29, "form": "dlg", "jp": "（ダメだっ！！）"},
{"id": 351, "speaker": 29, "form": "dlg", "jp": "（時間がかかりすぎだよ！）"},
{"id": 352, "speaker": 30, "form": "dlg", "jp": "「コゾウ！　そんなところで何してやがる！！」"},
{"id": 353, "speaker": 30, "form": "dlg", "jp": "「脱走とはいい度胸だ！！」"},
{"id": 354, "speaker": 30, "form": "dlg", "jp": "「死ねっ！」"},
{"id": 355, "speaker": 30, "form": "dlg", "jp": "「ダーーーン！」"},
{"id": 356, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 357, "speaker": 2, "form": "dlg", "jp": "ボクの胸から大量の血が吹き出した。"},
{"id": 358, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 359, "speaker": 2, "form": "dlg", "jp": "ボクはそのまま意識を失った‥‥"},
{"id": 360, "speaker": 2, "form": "dlg", "jp": "「やった！！」"},
{"id": 361, "speaker": 2, "form": "dlg", "jp": "「これで、この扉が開くんだね！」"},
{"id": 362, "speaker": 29, "form": "dlg", "jp": "（ああ、早く服をくれ！）"},
{"id": 363, "speaker": 2, "form": "dlg", "jp": "「あっ、そうか‥‥」"},
{"id": 364, "speaker": 29, "form": "dlg", "jp": "（早く放りこんで！）"},
{"id": 365, "speaker": 29, "form": "dlg", "jp": "（それから、絶対こっちを見ないでくれよな！）"},
{"id": 366, "speaker": 2, "form": "dlg", "jp": "「わかった！」"},
{"id": 367, "speaker": 2, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 368, "speaker": 2, "form": "dlg", "jp": "ボクは牢の中を見ないように服だけ放りこんだ‥‥"},
{"id": 369, "speaker": 29, "form": "dlg", "jp": "（ありがとう！）"},
{"id": 370, "speaker": 2, "form": "dlg", "jp": "「早くしてくれよ！」"},
{"id": 371, "speaker": 2, "form": "dlg", "jp": "（しかし、どうしてそんなに見られるのがいやなんだろう？）"},
{"id": 372, "speaker": 2, "form": "dlg", "jp": "（気になるなぁ～～）"},
{"id": 373, "speaker": 2, "form": "choice", "jp": "（よし、見てみよう！）"},
{"id": 374, "speaker": 2, "form": "choice", "jp": "（いや、やめておこう！）"},
{"id": 375, "speaker": 2, "form": "dlg", "jp": "（いや、やめておこう！）"},
{"id": 376, "speaker": 2, "form": "dlg", "jp": "（約束だからな‥‥）"},
{"id": 377, "speaker": 4, "form": "dlg", "jp": "「さあ、行きましょう！」"},
{"id": 378, "speaker": 4, "form": "dlg", "jp": "悩んでいるボクの背後から知らない女性の声が聞こえた。"},
{"id": 379, "speaker": 4, "form": "dlg", "jp": "「行くわよ！」"},
{"id": 380, "speaker": 2, "form": "dlg", "jp": "「‥‥？？」"},
{"id": 381, "speaker": 2, "form": "dlg", "jp": "「キミは‥‥？」"},
{"id": 382, "speaker": 4, "form": "dlg", "jp": "「ジーンよ！」"},
{"id": 383, "speaker": 2, "form": "dlg", "jp": "「女だったのか‥‥？」"},
{"id": 384, "speaker": 29, "form": "dlg", "jp": "「悪い？」"},
{"id": 385, "speaker": 2, "form": "dlg", "jp": "「悪くはないけど‥‥」"},
{"id": 386, "speaker": 29, "form": "dlg", "jp": "「だって、私が女で、服を着ていないってわかったら\n　ぜったい見たがるでしょう」"},
{"id": 387, "speaker": 2, "form": "dlg", "jp": "「いや、そんなことは‥‥」"},
{"id": 388, "speaker": 29, "form": "dlg", "jp": "「まあ、とりあえず約束は守ってくれたようだし、\n　出口を教えてあげるわ‥‥」"},
{"id": 389, "speaker": 2, "form": "dlg", "jp": "（よし、見てみよう！）"},
{"id": 390, "speaker": 29, "form": "dlg", "jp": "（見るなっていってるだろう！）"},
{"id": 391, "speaker": 29, "form": "dlg", "jp": "（見たらコロスから‥‥）"},
{"id": 392, "speaker": 2, "form": "dlg", "jp": "（しまった、『心の声』がまる聞こえだったか‥‥）"},
{"id": 393, "speaker": 2, "form": "dlg", "jp": "（わかった見ないよ！）"},
{"id": 394, "speaker": 2, "form": "dlg", "jp": "（‥‥と言っておいて）"},
{"id": 395, "speaker": 2, "form": "choice", "jp": "【見ないふりをして見ない！】"},
{"id": 396, "speaker": 2, "form": "choice", "jp": "【見ると思わせておいて見る！】"},
{"id": 397, "speaker": 2, "form": "dlg", "jp": "【見ないふりをして見ない！】"},
{"id": 398, "speaker": 2, "form": "dlg", "jp": "ボクは見たいのをぐっと堪えた‥‥"},
{"id": 399, "speaker": 4, "form": "dlg", "jp": "「お待たせ！」"},
{"id": 400, "speaker": 4, "form": "dlg", "jp": "ボクの背後から知らない女性の声が聞こえた。"},
{"id": 401, "speaker": 4, "form": "dlg", "jp": "「行くわよ！」"},
{"id": 402, "speaker": 2, "form": "dlg", "jp": "「‥‥？？」"},
{"id": 403, "speaker": 2, "form": "dlg", "jp": "「キミは‥‥？」"},
{"id": 404, "speaker": 4, "form": "dlg", "jp": "「ジーンよ！」"},
{"id": 405, "speaker": 2, "form": "dlg", "jp": "「女だったのか‥‥？」"},
{"id": 406, "speaker": 29, "form": "dlg", "jp": "「悪い？」"},
{"id": 407, "speaker": 2, "form": "dlg", "jp": "「悪くはないけど‥‥」"},
{"id": 408, "speaker": 29, "form": "dlg", "jp": "「だって、私が女で、服を着ていないってわかったら\n　ぜったい見たがるでしょう」"},
{"id": 409, "speaker": 2, "form": "dlg", "jp": "「いや、そんなことは‥‥」"},
{"id": 410, "speaker": 29, "form": "dlg", "jp": "「まあ、とりあえず約束は守ってくれたようだし、\n　出口を教えてあげるわ‥‥」"},
{"id": 411, "speaker": 29, "form": "dlg", "jp": "【見ると思わせておいて見る！】"},
{"id": 412, "speaker": 29, "form": "dlg", "jp": "ボクは素早く振り向いた！"},
{"id": 413, "speaker": 29, "form": "dlg", "jp": "「キャッ！」"},
{"id": 414, "speaker": 2, "form": "dlg", "jp": "「ゴメン！」"},
{"id": 415, "speaker": 2, "form": "dlg", "jp": "そこには裸の女の人が着替えをしていた。"},
{"id": 416, "speaker": 2, "form": "dlg", "jp": "ボクは慌てて後ろを向いた。"},
{"id": 417, "speaker": 29, "form": "dlg", "jp": "「見ないでっていったでしょう！」"},
{"id": 418, "speaker": 2, "form": "dlg", "jp": "「ゴメン‥‥」"},
{"id": 419, "speaker": 2, "form": "dlg", "jp": "ジーンの声は明らかに怒っていた。"},
{"id": 420, "speaker": 29, "form": "dlg", "jp": "「ハイ、もういいわよ‥‥」"},
{"id": 421, "speaker": 2, "form": "dlg", "jp": "「女だと思ってなかったから‥‥」"},
{"id": 422, "speaker": 29, "form": "dlg", "jp": "「当たり前じゃない、\n　女だと思わせないようにしてたんだから‥‥」"},
{"id": 423, "speaker": 29, "form": "dlg", "jp": "「だって、私が女で、服を着ていないってわかったら\n　ぜったい見たがるでしょう」"},
{"id": 424, "speaker": 2, "form": "dlg", "jp": "「いや、そんなことは‥‥」"},
{"id": 425, "speaker": 2, "form": "dlg", "jp": "「言ってくれた方が見なかったよ！」"},
{"id": 426, "speaker": 29, "form": "dlg", "jp": "「まあ、いいわ‥‥」"},
{"id": 427, "speaker": 29, "form": "dlg", "jp": "「約束はやぶったけど、\n　牢から出してくれたんだから」"},
{"id": 428, "speaker": 29, "form": "dlg", "jp": "「出口を教えてあげる」"},
{"id": 429, "speaker": 29, "form": "dlg", "jp": "「ついて来て！」"},
{"id": 430, "speaker": 2, "form": "dlg", "jp": "「あ、ああ‥‥」"},
{"id": 431, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 432, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 433, "speaker": 2, "form": "dlg", "jp": "ボクはジーンのおかげで無事、\n建物から抜け出すことができた。"},
{"id": 434, "speaker": 29, "form": "dlg", "jp": "「ここまで来たらもう大丈夫よ‥‥」"},
{"id": 435, "speaker": 29, "form": "dlg", "jp": "「アイツらてんで方向ちがいの方を\n　探しているみたいだし‥‥」"},
{"id": 436, "speaker": 2, "form": "dlg", "jp": "「どうして、それがわかるの？」"},
{"id": 437, "speaker": 29, "form": "dlg", "jp": "「それが私の"},
{"id": 438, "speaker": 29, "form": "dlg", "jp": "『能力』"},
{"id": 439, "speaker": 29, "form": "dlg", "jp": "だから‥‥」"},
{"id": 440, "speaker": 2, "form": "dlg", "jp": "「能力？」"},
{"id": 441, "speaker": 29, "form": "dlg", "jp": "「だから、言ったでしょう‥‥\n　私たちは"},
{"id": 442, "speaker": 29, "form": "dlg", "jp": "『超能力者』"},
{"id": 443, "speaker": 29, "form": "dlg", "jp": "だって！」"},
{"id": 444, "speaker": 2, "form": "dlg", "jp": "「私たちって‥‥」"},
{"id": 445, "speaker": 2, "form": "dlg", "jp": "「ボクは念写もスプーン曲げも\n　オシリジャンプもできないって‥‥」"},
{"id": 446, "speaker": 29, "form": "dlg", "jp": "「そんなの私もできないわよ！」"},
{"id": 447, "speaker": 29, "form": "dlg", "jp": "「私の能力は、こんな感じに\n　遠くの物を見たり、聞いたりできるだけ‥‥」"},
{"id": 448, "speaker": 29, "form": "dlg", "jp": "「アナタは？」"},
{"id": 449, "speaker": 2, "form": "dlg", "jp": "「だから、ボクは超能力者じゃないって！！」"},
{"id": 450, "speaker": 29, "form": "dlg", "jp": "「そんなワケないでしょう？」"},
{"id": 451, "speaker": 29, "form": "dlg", "jp": "「じゃあ、なんでヤツらはキミを捕まえたりするのよ？」"},
{"id": 452, "speaker": 29, "form": "dlg", "jp": "「私みたいに、\n　キミの能力を利用しようとしているんでしょう？」"},
{"id": 453, "speaker": 2, "form": "dlg", "jp": "「違うんだ、ボクじゃなくて‥‥」"},
{"id": 454, "speaker": 2, "form": "dlg", "jp": "（‥‥‥！！）"},
{"id": 455, "speaker": 2, "form": "dlg", "jp": "「忘れてた！！」"},
{"id": 456, "speaker": 2, "form": "dlg", "jp": "「ねえ、キミはその『能力』とやらで、\n　遠くのものが見えるんだろ？」"},
{"id": 457, "speaker": 29, "form": "dlg", "jp": "「そうよ‥‥」"},
{"id": 458, "speaker": 29, "form": "dlg", "jp": "「だから、見張りのいない場所を選んで\n　こうして逃げてこれたんじゃない！」"},
{"id": 459, "speaker": 2, "form": "dlg", "jp": "「悪いけど、もう少し力を貸してくれないか？」"},
{"id": 460, "speaker": 29, "form": "dlg", "jp": "「何よ？」"},
{"id": 461, "speaker": 2, "form": "dlg", "jp": "「ボクの姉さんもやつらにつかまっているんだ‥‥」"},
{"id": 462, "speaker": 2, "form": "dlg", "jp": "「助け出すのを手伝ってくれないか？」"},
{"id": 463, "speaker": 29, "form": "dlg", "jp": "「ダメ、できないわ‥‥」"},
{"id": 464, "speaker": 29, "form": "dlg", "jp": "「私には"},
{"id": 465, "speaker": 29, "form": "dlg", "jp": "重要な任務"},
{"id": 466, "speaker": 29, "form": "dlg", "jp": "があるの‥‥」"},
{"id": 467, "speaker": 29, "form": "dlg", "jp": "「あんな危険な所へ戻れない」"},
{"id": 468, "speaker": 29, "form": "choice", "jp": "「能力で危険を避けれるんじゃあ？」"},
{"id": 469, "speaker": 29, "form": "choice", "jp": "「お願いだから‥‥」"},
{"id": 470, "speaker": 2, "form": "dlg", "jp": "「能力で危険を避けれるんじゃあ？」"},
{"id": 471, "speaker": 29, "form": "dlg", "jp": "「勝手なことを言わないでよ！！」"},
{"id": 472, "speaker": 29, "form": "dlg", "jp": "「キミ、見えるからっていって\n　ボールを１０個投げられて全部よけられる？」"},
{"id": 473, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 474, "speaker": 30, "form": "dlg", "jp": "「コゾウ！　そんなところで何してやがる！！」"},
{"id": 475, "speaker": 30, "form": "dlg", "jp": "「ダーーーン！」"},
{"id": 476, "speaker": 2, "form": "dlg", "jp": "「うわぁ～っ！」"},
{"id": 477, "speaker": 2, "form": "dlg", "jp": "ボクの胸から大量の血が吹き出した。"},
{"id": 478, "speaker": 2, "form": "dlg", "jp": "そして‥‥"},
{"id": 479, "speaker": 2, "form": "dlg", "jp": "ボクはそのまま意識を失った‥‥"},
{"id": 480, "speaker": 2, "form": "dlg", "jp": "「お願いだから‥‥」"},
{"id": 481, "speaker": 29, "form": "dlg", "jp": "「確かに牢から出してもらったのは感謝するけど、\n　やっぱり、それはできないわ‥‥」"},
{"id": 482, "speaker": 2, "form": "dlg", "jp": "「‥‥‥」"},
{"id": 483, "speaker": 2, "form": "dlg", "jp": "「じゃあ‥‥」"},
{"id": 484, "speaker": 2, "form": "dlg", "jp": "「姉さんの居場所だけでも教えてくれないか？」"},
{"id": 485, "speaker": 2, "form": "dlg", "jp": "「後は自分でどうにかするから‥‥」"},
{"id": 486, "speaker": 29, "form": "dlg", "jp": "「まあ、それぐらいなら‥‥」"},
{"id": 487, "speaker": 29, "form": "dlg", "jp": "「じゃあ、教えてあげるけど、\n　絶対ムリをしないでね‥‥」"},
{"id": 488, "speaker": 29, "form": "dlg", "jp": "「もしかしたら、キミはこんなところで\n　死んじゃいけない人かもしれないんだから‥‥」"},
{"id": 489, "speaker": 2, "form": "dlg", "jp": "「わかったムリはしない！」"},
{"id": 490, "speaker": 29, "form": "dlg", "jp": "「仕方ないわね‥‥」"},
{"id": 491, "speaker": 29, "form": "dlg", "jp": "こうして、ボクはジーンから\n姉さんの居場所を聞き出すことになった。"},
{"id": 492, "speaker": 28, "form": "dlg", "jp": "「キミたちにはとりあえず『オリ』に入ってもらう‥‥」"},
{"id": 493, "speaker": 2, "form": "dlg", "jp": "「『オリ』だって！？」"},
{"id": 494, "speaker": 28, "form": "dlg", "jp": "「まあ、協力的になってくれれば、\n　その時にはもっと別の部屋に移ってもらうよ‥‥」"},
{"id": 495, "speaker": 8, "form": "dlg", "jp": "「さあ、来いっ！！」"},
{"id": 496, "speaker": 2, "form": "dlg", "jp": "「放せっ、自分で歩ける！！」"},
{"id": 497, "speaker": 2, "form": "dlg", "jp": "こうして、\nボクたちは『牢屋』に監禁されることになった。"},
{"id": 498, "speaker": 8, "form": "dlg", "jp": "「スゴイ工場だろう‥‥」"},
{"id": 499, "speaker": 8, "form": "dlg", "jp": "「ここで、\n　ルードのあつかう武器の８０％が作られてるんだ！」"},
{"id": 500, "speaker": 8, "form": "dlg", "jp": "「まあ、ルードのメイン工場‥‥」"},
{"id": 501, "speaker": 8, "form": "dlg", "jp": "「逃げようとか企んでもムダだからな‥‥」"},
{"id": 502, "speaker": 8, "form": "dlg", "jp": "「まあ、逃げたとしてもジャングルで迷子になって\n　死ぬだけだがな‥‥」"},
{"id": 503, "speaker": 8, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 504, "speaker": 8, "form": "dlg", "jp": "「さあ、今日からここがオマエたちのネグラだ‥‥」"},
{"id": 505, "speaker": 8, "form": "dlg", "jp": "「とりあえず、オマエたちのオヤジさんが\n　すんなり言うことを聞いてくれれば」"},
{"id": 506, "speaker": 8, "form": "dlg", "jp": "「もっとましな部屋に移してやる」"},
{"id": 507, "speaker": 8, "form": "dlg", "jp": "「それから‥‥」"},
{"id": 508, "speaker": 8, "form": "dlg", "jp": "「脱走なんてことは考えるな！」"},
{"id": 509, "speaker": 8, "form": "dlg", "jp": "「この牢は特別で、中からは決して\n　開けることができないようになっている！」"},
{"id": 510, "speaker": 8, "form": "dlg", "jp": "「オレも出る時は外で待っている子分に\n　開けてもらわないと出られないわけだ‥‥」"},
{"id": 511, "speaker": 8, "form": "dlg", "jp": "「もし、無理に内側から開けようとすると\n　"},
{"id": 512, "speaker": 8, "form": "dlg", "jp": "高圧電流"},
{"id": 513, "speaker": 8, "form": "dlg", "jp": "が流れて黒コゲになってしまうからな！」"},
{"id": 514, "speaker": 8, "form": "dlg", "jp": "「バタン！」"},
{"id": 515, "speaker": 8, "form": "dlg", "jp": "そう言い残してアキスは立ち去った。"},
{"id": 516, "speaker": 8, "form": "choice", "jp": "【調べる】"},
{"id": 517, "speaker": 8, "form": "choice", "jp": "【たたく】"},
{"id": 518, "speaker": 8, "form": "choice", "jp": "【話す】"},
{"id": 519, "speaker": 8, "form": "dlg", "jp": "【たたく】"},
{"id": 520, "speaker": 8, "form": "dlg", "jp": "ボクは牢屋のカベをたたいてみた。"},
{"id": 521, "speaker": 8, "form": "dlg", "jp": "「ガン！ガン！」"},
{"id": 522, "speaker": 8, "form": "dlg", "jp": "隣にも部屋があるらしく、\n頑丈なカベのわりに音が良くひびく。"},
{"id": 523, "speaker": 8, "form": "dlg", "jp": "カベはかなりしっかりしている。"},
{"id": 524, "speaker": 8, "form": "dlg", "jp": "ちょっとたたいたぐらいではビクともしない。"},
{"id": 525, "speaker": 8, "form": "dlg", "jp": "【調べる】"},
{"id": 526, "speaker": 8, "form": "dlg", "jp": "ボクは牢屋の中を調べることにした。"},
{"id": 527, "speaker": 8, "form": "dlg", "jp": "何を調べようかな？"},
{"id": 528, "speaker": 8, "form": "choice", "jp": "【窓】"},
{"id": 529, "speaker": 8, "form": "choice", "jp": "【ドア】"},
{"id": 530, "speaker": 8, "form": "choice", "jp": "【ベッド】"},
{"id": 531, "speaker": 8, "form": "dlg", "jp": "【窓】"},
{"id": 532, "speaker": 8, "form": "dlg", "jp": "ボクは『窓』を調べてみた。"},
{"id": 533, "speaker": 8, "form": "dlg", "jp": "窓にはしっかりと鉄格子がはまっている。"},
{"id": 534, "speaker": 8, "form": "dlg", "jp": "つまり、\n窓から逃げることは不可能ということだ"},
{"id": 535, "speaker": 8, "form": "dlg", "jp": "【ドア】"},
{"id": 536, "speaker": 8, "form": "dlg", "jp": "ボクは『ドア』を調べてみた。"},
{"id": 537, "speaker": 8, "form": "dlg", "jp": "分厚くガンジョウそうなドアだ。"},
{"id": 538, "speaker": 8, "form": "dlg", "jp": "アイツの話が本当なら、\n『高圧電流』が流れている。"},
{"id": 539, "speaker": 8, "form": "dlg", "jp": "決して中から開かないらしい‥‥"},
{"id": 540, "speaker": 8, "form": "dlg", "jp": "【ベッド】"},
{"id": 541, "speaker": 8, "form": "dlg", "jp": "ボクは『ベッド』を調べることにした。"},
{"id": 542, "speaker": 8, "form": "dlg", "jp": "備え付けらているベッドは\n安物のパイプベッドが１つだけだ‥‥"},
{"id": 543, "speaker": 8, "form": "dlg", "jp": "それに２人を閉じ込めているクセに\n１つしかない‥‥"},
{"id": 544, "speaker": 8, "form": "dlg", "jp": "つまり、\n姉さんかボクのどちらか１人しか使えない‥‥"},
{"id": 545, "speaker": 8, "form": "dlg", "jp": "【話す】"},
{"id": 546, "speaker": 2, "form": "dlg", "jp": "「姉さん‥‥」"},
{"id": 547, "speaker": 3, "form": "dlg", "jp": "「大丈夫よ！」"},
{"id": 548, "speaker": 3, "form": "dlg", "jp": "「私たちは『人質』なんだから、\n　絶対殺されないわよ‥‥」"},
{"id": 549, "speaker": 3, "form": "dlg", "jp": "「今までだって、\n　危ない目にあっても助かったんだから‥‥」"},
{"id": 550, "speaker": 3, "form": "dlg", "jp": "「大丈夫だって言ってるでしょう」"},
{"id": 551, "speaker": 3, "form": "dlg", "jp": "「弱気になっちゃダメよ！」"},
{"id": 552, "speaker": 3, "form": "dlg", "jp": "「きっと助かるわよ！」"},
{"id": 553, "speaker": 2, "form": "dlg", "jp": "「助かるってどうやって？」"},
{"id": 554, "speaker": 3, "form": "dlg", "jp": "「誰かが助けにきてくれるわよ！」"},
{"id": 555, "speaker": 3, "form": "dlg", "jp": "「今までもそうだったんだから‥‥」"},
{"id": 556, "speaker": 2, "form": "dlg", "jp": "「今までは『シロー』がいたから‥‥」"},
{"id": 557, "speaker": 3, "form": "dlg", "jp": "「そうだけど‥‥」"},
{"id": 558, "speaker": 3, "form": "dlg", "jp": "その時！"},
{"id": 559, "speaker": 3, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 560, "speaker": 3, "form": "dlg", "jp": "「ギィィィ！」"},
{"id": 561, "speaker": 4, "form": "dlg", "jp": "「"},
{"id": 562, "speaker": 4, "form": "dlg", "jp": "（助けに来ました！）"},
{"id": 563, "speaker": 4, "form": "dlg", "jp": "」"},
{"id": 564, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥！？」"},
{"id": 565, "speaker": 3, "form": "dlg", "jp": "「三田さん！」"},
{"id": 566, "speaker": 3, "form": "dlg", "jp": "父さんの助手の三田さんだった。"},
{"id": 567, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 568, "speaker": 26, "form": "dlg", "jp": "（あんまり大声を出さないで下さい！）"},
{"id": 569, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 570, "speaker": 3, "form": "dlg", "jp": "「"},
{"id": 571, "speaker": 3, "form": "dlg", "jp": "（ゴメンなさい‥‥）"},
{"id": 572, "speaker": 3, "form": "dlg", "jp": "」"},
{"id": 573, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 574, "speaker": 2, "form": "dlg", "jp": "（どうして、こんな所に？）"},
{"id": 575, "speaker": 2, "form": "dlg", "jp": "」"},
{"id": 576, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 577, "speaker": 26, "form": "dlg", "jp": "（それは後で説明します）"},
{"id": 578, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 579, "speaker": 26, "form": "dlg", "jp": "「"},
{"id": 580, "speaker": 26, "form": "dlg", "jp": "（とりあえず、ついて来て下さい！）"},
{"id": 581, "speaker": 26, "form": "dlg", "jp": "」"},
{"id": 582, "speaker": 26, "form": "dlg", "jp": "ボクたちは三田さんに誘導されて\n牢屋から抜け出した。"},
{"id": 583, "speaker": 26, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 584, "speaker": 26, "form": "dlg", "jp": "２００５／０７／２４／ＰＭ０６：００"},
{"id": 585, "speaker": 26, "form": "dlg", "jp": "「ここまでくれば、もう大丈夫です！」"},
{"id": 586, "speaker": 2, "form": "dlg", "jp": "「どうして、三田さんが‥‥？」"},
{"id": 587, "speaker": 26, "form": "dlg", "jp": "「ボクも博士といっしょにさらわれて来たんですよ！」"},
{"id": 588, "speaker": 2, "form": "dlg", "jp": "「じゃあ、父さんも逃げ出したんですか？」"},
{"id": 589, "speaker": 26, "form": "dlg", "jp": "「いいえ、博士はまだです‥‥」"},
{"id": 590, "speaker": 26, "form": "dlg", "jp": "「ボクだけ逃げ出せるチャンスがあったので‥‥」"},
{"id": 591, "speaker": 3, "form": "dlg", "jp": "「そうですか‥‥」"},
{"id": 592, "speaker": 26, "form": "dlg", "jp": "「スミマセン‥‥」"},
{"id": 593, "speaker": 26, "form": "choice", "jp": "【話す】"},
{"id": 594, "speaker": 26, "form": "choice", "jp": "【聞く】"},
{"id": 595, "speaker": 26, "form": "dlg", "jp": "【話す】"},
{"id": 596, "speaker": 2, "form": "dlg", "jp": "「一事はどうなるかと思いましたよ‥‥」"},
{"id": 597, "speaker": 26, "form": "dlg", "jp": "「うん、まだ安心できないけどね‥‥」"},
{"id": 598, "speaker": 2, "form": "dlg", "jp": "「ねえ、三田さん‥‥」"},
{"id": 599, "speaker": 2, "form": "dlg", "jp": "【聞く】"},
{"id": 600, "speaker": 2, "form": "dlg", "jp": "「ねえ、三田さん‥‥」"},
{"id": 601, "speaker": 2, "form": "choice", "jp": "「父さんは大丈夫そうなの？」"},
{"id": 602, "speaker": 2, "form": "choice", "jp": "「どうやって逃げ出してきたの？」"},
{"id": 603, "speaker": 2, "form": "dlg", "jp": "「父さんは大丈夫そうなの？」"},
{"id": 604, "speaker": 26, "form": "dlg", "jp": "「ヤツらは\n　博士の知識が欲しくてこんなことをしてるんです」"},
{"id": 605, "speaker": 26, "form": "dlg", "jp": "「博士の知識を手にいれるまでは\n　博士を殺すようなことはしないと思いますよ！」"},
{"id": 606, "speaker": 2, "form": "dlg", "jp": "「どうやって逃げ出してきたの？」"},
{"id": 607, "speaker": 26, "form": "dlg", "jp": "「『シロー』のおかげだよ‥‥」"},
{"id": 608, "speaker": 3, "form": "dlg", "jp": "「『シロー』！？」"},
{"id": 609, "speaker": 26, "form": "dlg", "jp": "「はい！」"},
{"id": 610, "speaker": 3, "form": "dlg", "jp": "「『シロー』もこっちに来てるんですか？」"},
{"id": 611, "speaker": 26, "form": "dlg", "jp": "「いえ、さすがにそれは‥‥」"},
{"id": 612, "speaker": 3, "form": "dlg", "jp": "「じゃあ、シローはどうやって？」"},
{"id": 613, "speaker": 26, "form": "dlg", "jp": "「連絡があったんですよ、『シロー』から‥‥」"},
{"id": 614, "speaker": 2, "form": "dlg", "jp": "「『シロー』から？」"},
{"id": 615, "speaker": 26, "form": "dlg", "jp": "「一応、ここに‥‥」"},
{"id": 616, "speaker": 26, "form": "dlg", "jp": "そういって、三田さんは\n『ノートパソコン』を取り出した。"},
{"id": 617, "speaker": 2, "form": "dlg", "jp": "「どういうこと？」"},
{"id": 618, "speaker": 2, "form": "dlg", "jp": "三田さんの話によると、"},
{"id": 619, "speaker": 2, "form": "dlg", "jp": "父さんと三田さんはムリやり\n『ルード』の研究を手伝わされることになり"},
{"id": 620, "speaker": 2, "form": "dlg", "jp": "『ルード』の研究室に閉じ込められていたらしい。"},
{"id": 621, "speaker": 2, "form": "dlg", "jp": "そして、作業を押し付けられた三田さんが、\n仕方なく自分のノートパソコンを"},
{"id": 622, "speaker": 2, "form": "dlg", "jp": "ネット回線につないだところ、ノートパソコンに\nシローが連絡をとって来たらしい‥‥"},
{"id": 623, "speaker": 3, "form": "dlg", "jp": "「なるほど！！」"},
{"id": 624, "speaker": 26, "form": "dlg", "jp": "「警察の目を盗んで、\n　警察の回線をジャックしたみたいですよ！」"},
{"id": 625, "speaker": 26, "form": "dlg", "jp": "「で、シローが『ルード』のコンピューターに侵入して」"},
{"id": 626, "speaker": 26, "form": "dlg", "jp": "「見張りのスケジュールや電子ロックの解除とか\n　脱出の準備をしてくれたんですよ！」"},
{"id": 627, "speaker": 3, "form": "dlg", "jp": "「それで、\n　私たちの捕らわれてる場所がわかったんですね？」"},
{"id": 628, "speaker": 26, "form": "dlg", "jp": "「あと、『カベをたたく音』がしたから‥‥」"},
{"id": 629, "speaker": 2, "form": "dlg", "jp": "「あの音で？」"},
{"id": 630, "speaker": 2, "form": "dlg", "jp": "「ねえ、\n　どうして父さんもいっしょに逃げ出さなかったの？」"},
{"id": 631, "speaker": 26, "form": "dlg", "jp": "「それは‥‥」"},
{"id": 632, "speaker": 26, "form": "dlg", "jp": "「博士の判断なんです‥‥」"},
{"id": 633, "speaker": 2, "form": "dlg", "jp": "「父さんの！？」"},
{"id": 634, "speaker": 26, "form": "dlg", "jp": "「脱出を計画していたところ、\n　リツコさんたちまでつかまったと知って‥‥」"},
{"id": 635, "speaker": 26, "form": "dlg", "jp": "「もし、博士が逃げ出せば\n　つかまっているリツコさんたちの命が危ないと‥‥」"},
{"id": 636, "speaker": 26, "form": "dlg", "jp": "「それで、予定を変更してとりあえず\n　リツコさんたちに先に逃げてもらおうと‥‥」"},
{"id": 637, "speaker": 3, "form": "dlg", "jp": "「そんなぁ‥‥」"},
{"id": 638, "speaker": 26, "form": "dlg", "jp": "「でも、安心してください！！」"},
{"id": 639, "speaker": 26, "form": "dlg", "jp": "「ヤツらは博士の技術が欲しくてたまらんのです」"},
{"id": 640, "speaker": 26, "form": "dlg", "jp": "「ですから、それを手に入れるまでは\n　絶対博士の命をうばうようなマネはしません！」"},
{"id": 641, "speaker": 26, "form": "dlg", "jp": "「それに、もうすぐシローが\n　応援をつれてやってくるハズです」"},
{"id": 642, "speaker": 2, "form": "dlg", "jp": "「応援？」"},
{"id": 643, "speaker": 26, "form": "dlg", "jp": "「シローはここのことを\n　日本にいるインターポールに知らせたそうです」"},
{"id": 644, "speaker": 26, "form": "dlg", "jp": "「シローの話では２４時間後には\n　インターポールの突撃部隊がやってくるそうです」"},
{"id": 645, "speaker": 3, "form": "dlg", "jp": "「あのう、今シローと連絡は取れますか？」"},
{"id": 646, "speaker": 26, "form": "dlg", "jp": "「ここじゃあ、無理です‥‥」"},
{"id": 647, "speaker": 26, "form": "dlg", "jp": "「ネットにつながりませんから‥‥」"},
{"id": 648, "speaker": 3, "form": "dlg", "jp": "「そ、そうよね‥‥」"},
{"id": 649, "speaker": 2, "form": "dlg", "jp": "「でも、あと２４時間もあるんだろう？」"},
{"id": 650, "speaker": 2, "form": "dlg", "jp": "「まさか、こんな所で応援を待つの？」"},
{"id": 651, "speaker": 3, "form": "dlg", "jp": "「インターポールと連絡がついてるなら\n　いっそのこと町へ出るとか‥‥」"},
{"id": 652, "speaker": 26, "form": "dlg", "jp": "「町へはここから歩いて１０時間以上かかります‥‥」"},
{"id": 653, "speaker": 26, "form": "dlg", "jp": "「それに、すでに町の工作員には\n　ボクたちがにげたことも連絡されているハズです」"},
{"id": 654, "speaker": 2, "form": "dlg", "jp": "「そんなぁ～～～～～」"},
{"id": 655, "speaker": 26, "form": "dlg", "jp": "「たぶん、こうしてジャングルに\n　潜んでいるのが一番安全です」"},
{"id": 656, "speaker": 3, "form": "dlg", "jp": "「じゃあ、あと２４時間もこんなところに？」"},
{"id": 657, "speaker": 26, "form": "dlg", "jp": "「そうなります‥‥」"},
{"id": 658, "speaker": 26, "form": "choice", "jp": "「ねえ、町まで行ってみようよ！」"},
{"id": 659, "speaker": 26, "form": "choice", "jp": "「しかたないね、ここで応援を待つよ‥‥」"},
{"id": 660, "speaker": 2, "form": "dlg", "jp": "「ねえ、町まで行ってみようよ！」"},
{"id": 661, "speaker": 26, "form": "dlg", "jp": "「ダメだよ‥‥」"},
{"id": 662, "speaker": 26, "form": "dlg", "jp": "「ココの方がぜったいに安全だって‥‥」"},
{"id": 663, "speaker": 2, "form": "dlg", "jp": "「でも、こんな所でジッとしてたら、\n　熱射病で倒れてしまうよ！」"},
{"id": 664, "speaker": 26, "form": "dlg", "jp": "「大丈夫、木陰なら温度も下がるし‥‥」"},
{"id": 665, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥」"},
{"id": 666, "speaker": 2, "form": "choice", "jp": "「ボク１人で町まで行ってくるよ！」"},
{"id": 667, "speaker": 2, "form": "choice", "jp": "「しかたないね、ここで応援を待つよ‥‥」"},
{"id": 668, "speaker": 2, "form": "dlg", "jp": "「ボク１人で町まで行ってくるよ！」"},
{"id": 669, "speaker": 3, "form": "dlg", "jp": "「ナゴム待ちなさい！！」"},
{"id": 670, "speaker": 3, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 671, "speaker": 3, "form": "dlg", "jp": "そして‥‥"},
{"id": 672, "speaker": 3, "form": "dlg", "jp": "「ガサゴソ‥‥」"},
{"id": 673, "speaker": 2, "form": "dlg", "jp": "「うん？」"},
{"id": 674, "speaker": 8, "form": "dlg", "jp": "「‥‥‥‥‥‥！？」"},
{"id": 675, "speaker": 8, "form": "dlg", "jp": "「み、見つけたぞ！！」"},
{"id": 676, "speaker": 8, "form": "dlg", "jp": "「死ねぇ！」"},
{"id": 677, "speaker": 8, "form": "dlg", "jp": "「バキューン！」"},
{"id": 678, "speaker": 2, "form": "dlg", "jp": "「ウワァ～～～～」"},
{"id": 679, "speaker": 2, "form": "dlg", "jp": "「しかたないね、ここで応援を待つよ‥‥」"},
{"id": 680, "speaker": 2, "form": "dlg", "jp": "こうして、\nボクたちはシローが応援をつれてくるまで"},
{"id": 681, "speaker": 2, "form": "dlg", "jp": "このジャングルで過ごすことになった。"},
{"id": 682, "speaker": 2, "form": "dlg", "jp": "失敗の原因は他人を信用できなかったこと。\n信じるものはスクワレル‥‥"},
{"id": 683, "speaker": 2, "form": "dlg", "jp": "失敗の原因は他人を信用できなかったこと。\nきちんとジーンについて行けば‥‥"},
{"id": 684, "speaker": 2, "form": "dlg", "jp": "敵の動きは一定のパターンなので見極めれば\n簡単に脱出できるハズ\n経験を積むことがクリアへの近道。"},
{"id": 685, "speaker": 2, "form": "dlg", "jp": "敵の動きは把握できたハズ、\nあとは踏み出す勇気だけ‥‥"},
{"id": 686, "speaker": 2, "form": "dlg", "jp": "カギをあけるには相当の『知力』が必要。\nじっくり考えれば、答えは見つかるハズ。"},
{"id": 687, "speaker": 2, "form": "dlg", "jp": "もう少し冷静になる必要がある。\nヤケになってはいけない。"}
]
