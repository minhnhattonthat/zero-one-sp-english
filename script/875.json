[
{"id": 0, "speaker": 31, "form": "dlg", "jp": "「オイ！　起きろ！」"},
{"id": 1, "speaker": 2, "form": "dlg", "jp": "「へっ、何？」"},
{"id": 2, "speaker": 31, "form": "dlg", "jp": "「リーダーが呼んでる」"},
{"id": 3, "speaker": 31, "form": "dlg", "jp": "なんだ『夢』か‥‥"},
{"id": 4, "speaker": 31, "form": "dlg", "jp": "でも、なんで『ツトム』の夢なんか‥‥"},
{"id": 5, "speaker": 31, "form": "dlg", "jp": "「ガチャ！」"},
{"id": 6, "speaker": 31, "form": "dlg", "jp": "「バタン！」"},
{"id": 7, "speaker": 31, "form": "dlg", "jp": "ケネスに起されたボクは、\nみんなと一緒に『メインホール』へと向かった。"},
{"id": 8, "speaker": 31, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 9, "speaker": 50, "form": "dlg", "jp": "「ゆっくり休めたかい？」"},
{"id": 10, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 11, "speaker": 50, "form": "dlg", "jp": "「今からどこへ？」"},
{"id": 12, "speaker": 2, "form": "dlg", "jp": "「リーダーが呼んでるらしいんだ‥‥」"},
{"id": 13, "speaker": 50, "form": "dlg", "jp": "「そうなんだ」"},
{"id": 14, "speaker": 2, "form": "dlg", "jp": "「出口は？」"},
{"id": 15, "speaker": 50, "form": "dlg", "jp": "「『出撃』だよ‥‥」"},
{"id": 16, "speaker": 2, "form": "dlg", "jp": "「『出撃』！？」"},
{"id": 17, "speaker": 50, "form": "dlg", "jp": "「うん、『出撃』だよ‥‥」"},
{"id": 18, "speaker": 2, "form": "dlg", "jp": "「危なくないのかい？」"},
{"id": 19, "speaker": 50, "form": "dlg", "jp": "「危ないだろうけど、\n　出撃しないと人類全体が危ないだろう？」"},
{"id": 20, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 21, "speaker": 50, "form": "dlg", "jp": "「じゃあ！」"},
{"id": 22, "speaker": 2, "form": "dlg", "jp": "「ああ‥‥」"},
{"id": 23, "speaker": 2, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 24, "speaker": 46, "form": "dlg", "jp": "「どうですか？」"},
{"id": 25, "speaker": 46, "form": "dlg", "jp": "「少しは、体は休まりましたか？」"},
{"id": 26, "speaker": 29, "form": "dlg", "jp": "「ハイ、ありがとうございました」"},
{"id": 27, "speaker": 46, "form": "dlg", "jp": "「アナタがたを呼んだのは他でもありません」"},
{"id": 28, "speaker": 46, "form": "dlg", "jp": "「アナタがたにも\n　"},
{"id": 29, "speaker": 46, "form": "dlg", "jp": "『アカシックレコード』"},
{"id": 30, "speaker": 46, "form": "dlg", "jp": "を見てもらおうと思いまして」"},
{"id": 31, "speaker": 2, "form": "dlg", "jp": "「"},
{"id": 32, "speaker": 2, "form": "dlg", "jp": "『アカシックレコード』"},
{"id": 33, "speaker": 2, "form": "dlg", "jp": "って‥‥」"},
{"id": 34, "speaker": 2, "form": "dlg", "jp": "「前にジーンが話していた？」"},
{"id": 35, "speaker": 29, "form": "dlg", "jp": "「そう、人類の過去の記憶が記録されているっていう‥‥」"},
{"id": 36, "speaker": 51, "form": "dlg", "jp": "「ゴロの悪い名前やなぁ？」"},
{"id": 37, "speaker": 51, "form": "dlg", "jp": "「ダシをつけて食べるタコヤキモドキかと思たで‥‥」"},
{"id": 38, "speaker": 29, "form": "dlg", "jp": "「ウソツキ！！」"},
{"id": 39, "speaker": 29, "form": "dlg", "jp": "「そんなこと思ってないでしょう！」"},
{"id": 40, "speaker": 29, "form": "dlg", "jp": "「『アカシックレコード』には」"},
{"id": 41, "speaker": 29, "form": "dlg", "jp": "「人類の『過去』が全て記録されているの‥‥」"},
{"id": 42, "speaker": 29, "form": "dlg", "jp": "「もちろん、『クリエーター』の過去も‥‥」"},
{"id": 43, "speaker": 15, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 44, "speaker": 15, "form": "dlg", "jp": "「『アカシックレコード』ってＳＦに出てくる\n　人類の未来までの記述がされているってヤツじゃぁ？」"},
{"id": 45, "speaker": 16, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 46, "speaker": 16, "form": "dlg", "jp": "「『アカシックレコード』って\n　人類の未来までの記述がされているってヤツじゃない？」"},
{"id": 47, "speaker": 18, "form": "dlg", "jp": "「ちょっと待って！」"},
{"id": 48, "speaker": 18, "form": "dlg", "jp": "「『アカシックレコード』ってＳＦに出てくる\n　人類の未来までの記述がされているってヤツでしょう？」"},
{"id": 49, "speaker": 29, "form": "dlg", "jp": "「だから、それは『ＳＦ』の中の話でしょう？」"},
{"id": 50, "speaker": 29, "form": "dlg", "jp": "「実際の『アカシックレコード』はそうじゃないの」"},
{"id": 51, "speaker": 29, "form": "dlg", "jp": "「人類の『過去』が全て記録されているの‥‥」"},
{"id": 52, "speaker": 29, "form": "dlg", "jp": "「もちろん、『クリエーター』の過去も‥‥」"},
{"id": 53, "speaker": 2, "form": "dlg", "jp": "「で、それはどこに？」"},
{"id": 54, "speaker": 46, "form": "dlg", "jp": "「それは今から案内します」"},
{"id": 55, "speaker": 46, "form": "dlg", "jp": "「ついて来てください‥‥」"},
{"id": 56, "speaker": 46, "form": "dlg", "jp": "ボクたちは『アリス』の後について行った。"},
{"id": 57, "speaker": 46, "form": "dlg", "jp": "「タッタッタッタ‥‥」"},
{"id": 58, "speaker": 46, "form": "dlg", "jp": "「ここが『コンピュータルーム』です。」"},
{"id": 59, "speaker": 35, "form": "dlg", "jp": "「うわぁ～～」"},
{"id": 60, "speaker": 35, "form": "dlg", "jp": "「スゴイなぁ～！」"},
{"id": 61, "speaker": 35, "form": "dlg", "jp": "「全然、この遺跡のイメージにあっていないけど‥‥」"},
{"id": 62, "speaker": 35, "form": "dlg", "jp": "「で、このコンピュータたちにそのゲーマーの\n　記録が残ってるの？」"},
{"id": 63, "speaker": 31, "form": "dlg", "jp": "「『アカシックレコード』は\n　２０００年前からあるんだぞ！」"},
{"id": 64, "speaker": 31, "form": "dlg", "jp": "「現在のコンピュータの形をしているハズないだろう！」"},
{"id": 65, "speaker": 46, "form": "dlg", "jp": "「あの、奥に固定されているのが\n　『アカシックレコード』です」"},
{"id": 66, "speaker": 2, "form": "dlg", "jp": "「こ、この石が‥‥？」"},
{"id": 67, "speaker": 46, "form": "dlg", "jp": "「石なのか、機械なのかもよくわかりません‥‥」"},
{"id": 68, "speaker": 46, "form": "dlg", "jp": "「これを構成している物質すら何なのか‥‥」"},
{"id": 69, "speaker": 46, "form": "dlg", "jp": "「先ほどケネスが『２０００年前』と言いましたが、\n　実際はそれよりずっと前からあったみたいです」"},
{"id": 70, "speaker": 46, "form": "dlg", "jp": "「インカ人がこれを見つけたのが\n　『２０００年前』ってだけですから‥‥」"},
{"id": 71, "speaker": 2, "form": "dlg", "jp": "「インカ人が見つけたってことは？」"},
{"id": 72, "speaker": 46, "form": "dlg", "jp": "「そうです」"},
{"id": 73, "speaker": 46, "form": "dlg", "jp": "「『アカシックレコード』はずっとこの場所にあるのです」"},
{"id": 74, "speaker": 46, "form": "dlg", "jp": "「インカ人がここに『要塞都市』を作ったのも\n　この『アカシックレコード』がここにあったからです。」"},
{"id": 75, "speaker": 35, "form": "dlg", "jp": "「そんなの動かしちゃえばいいのに‥‥」"},
{"id": 76, "speaker": 31, "form": "dlg", "jp": "「動かないんだよ！」"},
{"id": 77, "speaker": 31, "form": "dlg", "jp": "「動かせないし、壊すこともできないんだよ！」"},
{"id": 78, "speaker": 2, "form": "dlg", "jp": "「そんなもの存在するの？」"},
{"id": 79, "speaker": 46, "form": "dlg", "jp": "「存在しているから、目の前にあるのです」"},
{"id": 80, "speaker": 46, "form": "dlg", "jp": "「『壊れない』から、何千年もこうして存在し」"},
{"id": 81, "speaker": 46, "form": "dlg", "jp": "「『動かせない』から、ここにあり続けているのです」"},
{"id": 82, "speaker": 46, "form": "dlg", "jp": "「インカの人々はここに『要塞』を作れば\n　壊されないことを知っていたのです」"},
{"id": 83, "speaker": 46, "form": "dlg", "jp": "「だから、こんな不便な山奥に要塞を作ったのです」"},
{"id": 84, "speaker": 46, "form": "dlg", "jp": "「そして私たち『Ｅ－ｇｒｏ』も、\n　最も安全な場所としてここに本部を設けたのです」"},
{"id": 85, "speaker": 35, "form": "dlg", "jp": "「で、コイツからどうやって『記憶』を読み取ったの？」"},
{"id": 86, "speaker": 46, "form": "dlg", "jp": "「触れてみてください‥‥」"},
{"id": 87, "speaker": 35, "form": "dlg", "jp": "「ふれると御利益があるの？」"},
{"id": 88, "speaker": 29, "form": "dlg", "jp": "「いいから、触れてみて‥‥」"},
{"id": 89, "speaker": 35, "form": "dlg", "jp": "「じゃあ、ちょっとだけ‥‥」"},
{"id": 90, "speaker": 35, "form": "dlg", "jp": "松尾さんはおそるおそる\n『アカシックレコード』に手を伸ばした。"},
{"id": 91, "speaker": 35, "form": "dlg", "jp": "そして‥‥"},
{"id": 92, "speaker": 35, "form": "dlg", "jp": "「うわぁ～～！」"},
{"id": 93, "speaker": 35, "form": "dlg", "jp": "「うわっ！うわっ！」"},
{"id": 94, "speaker": 35, "form": "dlg", "jp": "「うわぁ～～～！」"},
{"id": 95, "speaker": 35, "form": "dlg", "jp": "「な、なんだよこれ‥‥」"},
{"id": 96, "speaker": 29, "form": "dlg", "jp": "「アスカには刺激が強すぎたかもね‥‥」"},
{"id": 97, "speaker": 29, "form": "dlg", "jp": "「じゃあ、次はナゴムの番よ‥‥」"},
{"id": 98, "speaker": 2, "form": "dlg", "jp": "「なんか、コワイなぁ‥‥」"},
{"id": 99, "speaker": 29, "form": "dlg", "jp": "「大丈夫よ！」"},
{"id": 100, "speaker": 29, "form": "dlg", "jp": "「アスカが特別怖がりなだけなんだから‥‥」"},
{"id": 101, "speaker": 29, "form": "dlg", "jp": "「さあ‥‥」"},
{"id": 102, "speaker": 2, "form": "dlg", "jp": "「わかったよ‥‥」"},
{"id": 103, "speaker": 2, "form": "dlg", "jp": "ボクもおそるおそる『アカシックレコード』に触れてみた。"},
{"id": 104, "speaker": 2, "form": "dlg", "jp": "すると‥‥"},
{"id": 105, "speaker": 2, "form": "dlg", "jp": "指先から『イメージ』が直接頭の中に流れ込んで来た。"},
{"id": 106, "speaker": 2, "form": "dlg", "jp": "それは恐ろしい映像の数々だった。"},
{"id": 107, "speaker": 2, "form": "dlg", "jp": "大洪水で、町が一瞬に飲み込まれ、"},
{"id": 108, "speaker": 2, "form": "dlg", "jp": "幼い子も年寄りも、\nだれかれなく悲鳴とともに激流にのまれてゆく‥‥"},
{"id": 109, "speaker": 2, "form": "dlg", "jp": "なすすべも無く流され、\n肺いっぱいに水を飲み、溺れ死んでゆく映像。"},
{"id": 110, "speaker": 2, "form": "dlg", "jp": "火山が噴火し、"},
{"id": 111, "speaker": 2, "form": "dlg", "jp": "溶岩が押し寄せ、"},
{"id": 112, "speaker": 2, "form": "dlg", "jp": "山も森も炎に包まれ、"},
{"id": 113, "speaker": 2, "form": "dlg", "jp": "家を焼かれ、町を焼かれ、"},
{"id": 114, "speaker": 2, "form": "dlg", "jp": "逃げ場を失った人々が灼熱に焼かれてゆくイメージ。"},
{"id": 115, "speaker": 2, "form": "dlg", "jp": "それ以外にも大寒波、干ばつ、大地震等\n様々な天変地異が人類を打ちのめしていた。"},
{"id": 116, "speaker": 29, "form": "dlg", "jp": "「どうだった？」"},
{"id": 117, "speaker": 2, "form": "dlg", "jp": "「これが誰かの仕業ならヒドすぎる！！」"},
{"id": 118, "speaker": 29, "form": "dlg", "jp": "「トモも見てみる？」"},
{"id": 119, "speaker": 51, "form": "dlg", "jp": "「見せてもらおうやないか！」"},
{"id": 120, "speaker": 51, "form": "dlg", "jp": "そして‥‥"},
{"id": 121, "speaker": 51, "form": "dlg", "jp": "「ヒドイな‥‥」"},
{"id": 122, "speaker": 51, "form": "dlg", "jp": "「『クリエーター』には感情とかないんかな？」"},
{"id": 123, "speaker": 29, "form": "dlg", "jp": "「アイコも見てみる？」"},
{"id": 124, "speaker": 15, "form": "dlg", "jp": "「エンリョします‥‥」"},
{"id": 125, "speaker": 15, "form": "dlg", "jp": "「ハイ‥‥」"},
{"id": 126, "speaker": 29, "form": "dlg", "jp": "「アキラも見てみる？」"},
{"id": 127, "speaker": 16, "form": "dlg", "jp": "「ヤダ！」"},
{"id": 128, "speaker": 16, "form": "dlg", "jp": "「絶対見ない！」"},
{"id": 129, "speaker": 29, "form": "dlg", "jp": "「ナナセも見てみる？」"},
{"id": 130, "speaker": 18, "form": "dlg", "jp": "「辞退します‥‥」"},
{"id": 131, "speaker": 46, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 132, "speaker": 46, "form": "choice", "jp": "「これって真実なの？」"},
{"id": 133, "speaker": 46, "form": "choice", "jp": "「どうしてこれが『クリエーター』の仕業だと？」"},
{"id": 134, "speaker": 2, "form": "dlg", "jp": "「これって真実なの？」"},
{"id": 135, "speaker": 46, "form": "dlg", "jp": "「冗談だと思いますか？」"},
{"id": 136, "speaker": 2, "form": "dlg", "jp": "「でも、これが『人類の過去』だって言う証拠は？」"},
{"id": 137, "speaker": 2, "form": "dlg", "jp": "「どうしてこれが『クリエーター』の仕業だと？」"},
{"id": 138, "speaker": 46, "form": "dlg", "jp": "「ひとつはイイツタエです」"},
{"id": 139, "speaker": 46, "form": "dlg", "jp": "「インカの人々は文字を持たなかったので、\n　文献は残っていません」"},
{"id": 140, "speaker": 46, "form": "dlg", "jp": "「しかし、イイツタエることで\n　クリエーターの記録を残してきました」"},
{"id": 141, "speaker": 46, "form": "dlg", "jp": "「そして、もうひとつが『能力』‥‥」"},
{"id": 142, "speaker": 2, "form": "dlg", "jp": "「『能力』？」"},
{"id": 143, "speaker": 46, "form": "dlg", "jp": "「ジーンたちのような、\n　特別なものが見える能力者には」"},
{"id": 144, "speaker": 46, "form": "dlg", "jp": "「この"},
{"id": 145, "speaker": 46, "form": "dlg", "jp": "『天変地異』"},
{"id": 146, "speaker": 46, "form": "dlg", "jp": "が"},
{"id": 147, "speaker": 46, "form": "dlg", "jp": "『何ものか』"},
{"id": 148, "speaker": 46, "form": "dlg", "jp": "によって\n　コントロールされているってことがわかるのです」"},
{"id": 149, "speaker": 2, "form": "dlg", "jp": "「そうなのジーン‥‥？」"},
{"id": 150, "speaker": 29, "form": "dlg", "jp": "「ええ‥‥」"},
{"id": 151, "speaker": 29, "form": "dlg", "jp": "「ものスゴク"},
{"id": 152, "speaker": 29, "form": "dlg", "jp": "『邪悪な意志』"},
{"id": 153, "speaker": 29, "form": "dlg", "jp": "を感じるの！」"},
{"id": 154, "speaker": 46, "form": "dlg", "jp": "「さらにジーンたちは、最近になって」"},
{"id": 155, "speaker": 46, "form": "dlg", "jp": "「この『アカシックレコード』から、\n　新たな『邪悪な意識』を感じとったのです‥‥」"},
{"id": 156, "speaker": 15, "form": "dlg", "jp": "「それで、近々\n　『クリエーター』の攻撃があるって知ったのね！」"},
{"id": 157, "speaker": 16, "form": "dlg", "jp": "「それで、近々\n　『クリエーター』の攻撃があるって知ったのね！」"},
{"id": 158, "speaker": 18, "form": "dlg", "jp": "「それで、近々\n　『クリエーター』の攻撃があるって知ったんですね！」"},
{"id": 159, "speaker": 51, "form": "dlg", "jp": "「それで、近々\n　『クリエーター』の攻撃があるって知ったんやね！」"},
{"id": 160, "speaker": 46, "form": "dlg", "jp": "「それ以外にも『予知』のできるメンバーが\n　現在の事態を予知していましたから‥‥」"},
{"id": 161, "speaker": 35, "form": "dlg", "jp": "「ふーん‥‥」"},
{"id": 162, "speaker": 35, "form": "dlg", "jp": "「でも、さっきの『アカシックレコード』の映像の中には\n　『クリエーター』っぽいのって写ってなかったね？」"},
{"id": 163, "speaker": 46, "form": "dlg", "jp": "「攻撃の基本が『遠隔操作』ですから‥‥」"},
{"id": 164, "speaker": 46, "form": "choice", "jp": "「リーダー‥‥」"},
{"id": 165, "speaker": 46, "form": "choice", "jp": "「ジーン‥‥」"},
{"id": 166, "speaker": 46, "form": "choice", "jp": "「松尾さん‥‥」"},
{"id": 167, "speaker": 2, "form": "dlg", "jp": "「リーダー‥‥」"},
{"id": 168, "speaker": 2, "form": "dlg", "jp": "「『遠隔操作』って？」"},
{"id": 169, "speaker": 46, "form": "dlg", "jp": "「ジーンたちが感じている『邪悪な感覚』です‥‥」"},
{"id": 170, "speaker": 46, "form": "dlg", "jp": "「それが、『操る力』だと‥‥」"},
{"id": 171, "speaker": 2, "form": "dlg", "jp": "「ジーン‥‥」"},
{"id": 172, "speaker": 2, "form": "dlg", "jp": "「ジーンは『遠隔操作』の電波みたいなのを\n　感知できているの？」"},
{"id": 173, "speaker": 29, "form": "dlg", "jp": "「『邪悪ななにか』を感じるのだけはたしかね‥‥」"},
{"id": 174, "speaker": 29, "form": "choice", "jp": "「ケネス‥‥」"},
{"id": 175, "speaker": 29, "form": "choice", "jp": "「松尾さん‥‥」"},
{"id": 176, "speaker": 2, "form": "dlg", "jp": "「ケネス‥‥」"},
{"id": 177, "speaker": 2, "form": "dlg", "jp": "「ケネスはどう思う？」"},
{"id": 178, "speaker": 2, "form": "dlg", "jp": "「クリエーターが姿を見せないことを‥‥」"},
{"id": 179, "speaker": 31, "form": "dlg", "jp": "「まあ、『遠隔攻撃』できるんなら、\n　わざわざ姿を見せないだろうな‥‥」"},
{"id": 180, "speaker": 2, "form": "dlg", "jp": "「松尾さん‥‥」"},
{"id": 181, "speaker": 35, "form": "dlg", "jp": "「う～～～～ん‥‥」"},
{"id": 182, "speaker": 35, "form": "dlg", "jp": "「『遠隔操作』ってことは、\n　『本体』をオレたちが攻撃できないんだよな‥‥」"},
{"id": 183, "speaker": 35, "form": "dlg", "jp": "「て、言うことはどんなに戦っても\n　意味がないんじぁあ？」"},
{"id": 184, "speaker": 35, "form": "choice", "jp": "「たしかに‥‥」"},
{"id": 185, "speaker": 35, "form": "choice", "jp": "「それはそうだけど‥‥」"},
{"id": 186, "speaker": 2, "form": "dlg", "jp": "「たしかに‥‥」"},
{"id": 187, "speaker": 2, "form": "dlg", "jp": "「ボクたちは『防戦』一方になっちゃうね‥‥」"},
{"id": 188, "speaker": 2, "form": "dlg", "jp": "「それはそうだけど‥‥」"},
{"id": 189, "speaker": 2, "form": "dlg", "jp": "「戦わないわけにはいかないよね‥‥」"},
{"id": 190, "speaker": 51, "form": "dlg", "jp": "「そうやね！」"},
{"id": 191, "speaker": 51, "form": "dlg", "jp": "「それに、必死で戦えば、\n　『気持ち』が伝わるかもしらんしな‥‥」"},
{"id": 192, "speaker": 18, "form": "dlg", "jp": "「そうよね！」"},
{"id": 193, "speaker": 18, "form": "dlg", "jp": "「それに、必死で戦えば、\n　『気持ち』が伝わるかも‥‥」"},
{"id": 194, "speaker": 16, "form": "dlg", "jp": "「そうよね！」"},
{"id": 195, "speaker": 16, "form": "dlg", "jp": "「それに、必死で戦えば、\n　『気持ち』が伝わるかも‥‥」"},
{"id": 196, "speaker": 15, "form": "dlg", "jp": "「そうよね！」"},
{"id": 197, "speaker": 15, "form": "dlg", "jp": "「それに、必死で戦えば、\n　『気持ち』が伝わるかも‥‥」"},
{"id": 198, "speaker": 2, "form": "dlg", "jp": "「そうかも知れないね‥」"},
{"id": 199, "speaker": 2, "form": "dlg", "jp": "「相手が『知能』のある生き物ならば、\n　そう言うこともありうるかも‥‥」"},
{"id": 200, "speaker": 35, "form": "dlg", "jp": "「でも、防戦しか手段がないっていうのも‥‥」"},
{"id": 201, "speaker": 35, "form": "dlg", "jp": "「どうにかして、\n　本体をたたくとはできないのかな？」"},
{"id": 202, "speaker": 29, "form": "dlg", "jp": "「本体が出てこない以上ムリっぽいわね‥‥」"},
{"id": 203, "speaker": 35, "form": "dlg", "jp": "「なんで、姿を現さないんだろう？」"},
{"id": 204, "speaker": 35, "form": "choice", "jp": "「『直接攻撃がニガテ』なんじゃあ‥‥」"},
{"id": 205, "speaker": 35, "form": "choice", "jp": "「『その必要がない』から‥‥」"},
{"id": 206, "speaker": 35, "form": "choice", "jp": "「『クリエーターなんていない』‥‥」"},
{"id": 207, "speaker": 2, "form": "dlg", "jp": "「『直接攻撃がニガテ』なんじゃあ‥‥」"},
{"id": 208, "speaker": 35, "form": "dlg", "jp": "「あっ、オレも今そう思ってたの‥‥」"},
{"id": 209, "speaker": 35, "form": "dlg", "jp": "「射程距離の長い兵器って、\n　接近戦に弱いんじゃあ‥‥」"},
{"id": 210, "speaker": 46, "form": "dlg", "jp": "「それはありえますね‥‥」"},
{"id": 211, "speaker": 35, "form": "dlg", "jp": "「って、ことは、『直接攻撃』に持ち込んだら、\n　勝てるかもしれないね‥‥」"},
{"id": 212, "speaker": 51, "form": "dlg", "jp": "「でも姿を見せへん以上、\n　直接攻撃ってムリやなぁ‥‥」"},
{"id": 213, "speaker": 18, "form": "dlg", "jp": "「でも姿を見せないんじゃあ、\n　直接攻撃ってムリなんじゃ‥‥」"},
{"id": 214, "speaker": 16, "form": "dlg", "jp": "「でも姿を見せないんじゃあ、\n　直接攻撃ってムリなんじゃ‥‥」"},
{"id": 215, "speaker": 15, "form": "dlg", "jp": "「でも姿を見せないんじゃあ、\n　直接攻撃ってムリなんじゃ‥‥」"},
{"id": 216, "speaker": 2, "form": "dlg", "jp": "「『その必要がない』から‥‥」"},
{"id": 217, "speaker": 29, "form": "dlg", "jp": "「まあ、そうよね‥‥」"},
{"id": 218, "speaker": 29, "form": "dlg", "jp": "「拳銃を持ってるのに、\n　わざわざ拳では勝負しないでしょうね‥‥」"},
{"id": 219, "speaker": 51, "form": "dlg", "jp": "「『天変地異』を操れるんやもんね‥‥」"},
{"id": 220, "speaker": 51, "form": "dlg", "jp": "「きっと、ウチらのことなんか\n　『虫ケラ』以下ぐらいにしか思わへんわな‥‥」"},
{"id": 221, "speaker": 31, "form": "dlg", "jp": "「姿さえ現せば、\n　１発ぐらいは殴ってやりたいんだけどな‥‥」"},
{"id": 222, "speaker": 18, "form": "dlg", "jp": "「『天変地異』を操れるんだもんね‥‥」"},
{"id": 223, "speaker": 18, "form": "dlg", "jp": "「きっと、私たちのことなんか\n　『虫ケラ』以下ぐらいにしか‥‥」"},
{"id": 224, "speaker": 31, "form": "dlg", "jp": "「姿さえ現せば、\n　１発ぐらいは殴ってやりたいんだけどな‥‥」"},
{"id": 225, "speaker": 16, "form": "dlg", "jp": "「『天変地異』を操れるんだもんね‥‥」"},
{"id": 226, "speaker": 16, "form": "dlg", "jp": "「きっと、アキラたちのことなんか\n　『虫ケラ』以下ぐらいにしか思ってないと‥‥」"},
{"id": 227, "speaker": 31, "form": "dlg", "jp": "「姿さえ現せば、\n　１発ぐらいは殴ってやりたいんだけどな‥‥」"},
{"id": 228, "speaker": 15, "form": "dlg", "jp": "「『天変地異』を操れるんだもんね‥‥」"},
{"id": 229, "speaker": 15, "form": "dlg", "jp": "「きっと、私たちのことなんか\n　『虫ケラ』以下ぐらいにしか‥‥」"},
{"id": 230, "speaker": 31, "form": "dlg", "jp": "「姿さえ現せば、\n　１発ぐらいは殴ってやりたいんだけどな‥‥」"},
{"id": 231, "speaker": 2, "form": "dlg", "jp": "「『クリエーターなんていない』‥‥」"},
{"id": 232, "speaker": 35, "form": "dlg", "jp": "「あっ、オレも今そう思ってたの‥‥」"},
{"id": 233, "speaker": 29, "form": "dlg", "jp": "「ちょっと、何言い出すのよ！」"},
{"id": 234, "speaker": 29, "form": "dlg", "jp": "「『クリエーターがいない』としたら、\n　世界中の騒ぎは何だと思うの？」"},
{"id": 235, "speaker": 29, "form": "choice", "jp": "「単なる事故とか‥‥」"},
{"id": 236, "speaker": 29, "form": "choice", "jp": "「誰かが仕組んだとか‥‥」"},
{"id": 237, "speaker": 2, "form": "dlg", "jp": "「単なる事故とか‥‥」"},
{"id": 238, "speaker": 29, "form": "dlg", "jp": "「そんなに事故が重なると思う？」"},
{"id": 239, "speaker": 2, "form": "dlg", "jp": "「大事故ほど重なるって言うじゃない‥‥」"},
{"id": 240, "speaker": 31, "form": "dlg", "jp": "「『シンクロニシティー』か‥‥」"},
{"id": 241, "speaker": 46, "form": "dlg", "jp": "「まあ、その可能性も十分にあります‥‥」"},
{"id": 242, "speaker": 46, "form": "dlg", "jp": "「でも、そうじゃない可能性もあるのです‥‥」"},
{"id": 243, "speaker": 46, "form": "dlg", "jp": "「そうした場合、『いない』と考えるよりも\n　『いる』と考えて備えておいた方が‥‥」"},
{"id": 244, "speaker": 31, "form": "dlg", "jp": "「まあ、もし、ナゴムの言うように\n　『クリエーター』がいなかったとしても」"},
{"id": 245, "speaker": 31, "form": "dlg", "jp": "「大した被害はないからな‥‥」"},
{"id": 246, "speaker": 31, "form": "dlg", "jp": "「逆に『クリエーター』が存在した場合は\n　『人類』は全滅するんだ‥‥」"},
{"id": 247, "speaker": 46, "form": "dlg", "jp": "「わかってもらえますか？」"},
{"id": 248, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 249, "speaker": 2, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 250, "speaker": 46, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 251, "speaker": 2, "form": "dlg", "jp": "「誰かが仕組んだとか‥‥」"},
{"id": 252, "speaker": 29, "form": "dlg", "jp": "「仕組んだ？」"},
{"id": 253, "speaker": 29, "form": "dlg", "jp": "「いったい誰が？」"},
{"id": 254, "speaker": 29, "form": "choice", "jp": "「それはわからない‥‥」"},
{"id": 255, "speaker": 29, "form": "choice", "jp": "「『Ｅ－ｇｒｏ』に決まってるだろう！」"},
{"id": 256, "speaker": 2, "form": "dlg", "jp": "「それはわからない‥‥」"},
{"id": 257, "speaker": 46, "form": "dlg", "jp": "「『わからない』？」"},
{"id": 258, "speaker": 2, "form": "dlg", "jp": "「わからないけど‥‥」"},
{"id": 259, "speaker": 46, "form": "dlg", "jp": "「アナタは自分では答えを出せないのに‥‥」"},
{"id": 260, "speaker": 46, "form": "dlg", "jp": "「すでにある答えを否定するのですか？」"},
{"id": 261, "speaker": 35, "form": "dlg", "jp": "「オレも『次元を超えた存在』なんて‥‥」"},
{"id": 262, "speaker": 46, "form": "dlg", "jp": "「信じられないと‥‥」"},
{"id": 263, "speaker": 46, "form": "dlg", "jp": "「本当に信じられないのですか？」"},
{"id": 264, "speaker": 46, "form": "dlg", "jp": "「信じたくないのでは‥‥？」"},
{"id": 265, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 266, "speaker": 2, "form": "dlg", "jp": "そうかもしれない‥‥"},
{"id": 267, "speaker": 2, "form": "dlg", "jp": "『クリエーター』のことを事実と受け止めれば、\nそんなスゴイ相手と戦わなきゃならないんだ‥‥"},
{"id": 268, "speaker": 46, "form": "dlg", "jp": "「弱いことは決して恥じることではありません」"},
{"id": 269, "speaker": 46, "form": "dlg", "jp": "「でも、自分の弱さに負けることは\n　もっとも恥じる行為です‥‥」"},
{"id": 270, "speaker": 46, "form": "dlg", "jp": "「アナタたちだけが戦うのではありません」"},
{"id": 271, "speaker": 46, "form": "dlg", "jp": "「全人類が戦うことになるのです」"},
{"id": 272, "speaker": 46, "form": "dlg", "jp": "「どうか、\n　私たちをもう少しだけ信じてください‥‥」"},
{"id": 273, "speaker": 2, "form": "dlg", "jp": "「‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥」"},
{"id": 274, "speaker": 2, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 275, "speaker": 46, "form": "dlg", "jp": "「ありがとう‥‥」"},
{"id": 276, "speaker": 2, "form": "dlg", "jp": "「『Ｅ－ｇｒｏ』に決まってるだろう！」"},
{"id": 277, "speaker": 29, "form": "dlg", "jp": "「ナゴム！！」"},
{"id": 278, "speaker": 29, "form": "dlg", "jp": "「いったい何を言い出すの！？」"},
{"id": 279, "speaker": 2, "form": "dlg", "jp": "「でも、\n　そう考えるのが一番しっくりくるだろう」"},
{"id": 280, "speaker": 35, "form": "dlg", "jp": "「オレもそう思う‥‥」"},
{"id": 281, "speaker": 31, "form": "dlg", "jp": "「アスカまで！」"},
{"id": 282, "speaker": 35, "form": "dlg", "jp": "「なんだか、ジーンたちの都合のいいように\n　すべてが動いてる様に思うんだ‥‥」"},
{"id": 283, "speaker": 35, "form": "dlg", "jp": "「クリエーターの証拠はまったくないし‥‥」"},
{"id": 284, "speaker": 18, "form": "dlg", "jp": "「そういえば‥‥」"},
{"id": 285, "speaker": 18, "form": "dlg", "jp": "「『ＵＦＯ』も『Ｅ－ｇｒｏ製』だったわね‥‥」"},
{"id": 286, "speaker": 29, "form": "dlg", "jp": "「ナナセまで！！」"},
{"id": 287, "speaker": 16, "form": "dlg", "jp": "「そういえば‥‥」"},
{"id": 288, "speaker": 16, "form": "dlg", "jp": "「『ＵＦＯ』も『Ｅ－ｇｒｏ製』だったわね‥‥」"},
{"id": 289, "speaker": 29, "form": "dlg", "jp": "「アキラまで！！」"},
{"id": 290, "speaker": 15, "form": "dlg", "jp": "「そういえば‥‥」"},
{"id": 291, "speaker": 15, "form": "dlg", "jp": "「『ＵＦＯ』も『Ｅ－ｇｒｏ製』だったわね‥‥」"},
{"id": 292, "speaker": 29, "form": "dlg", "jp": "「アイコまで！！」"},
{"id": 293, "speaker": 51, "form": "dlg", "jp": "「そういえば‥‥」"},
{"id": 294, "speaker": 51, "form": "dlg", "jp": "「『ＵＦＯ』ですら、『Ｅ－ｇｒｏ製』やったしなぁ‥‥」"},
{"id": 295, "speaker": 29, "form": "dlg", "jp": "「トモ‥‥！！」"},
{"id": 296, "speaker": 2, "form": "dlg", "jp": "「やっぱり、みんな同じ考えなんだね‥‥」"},
{"id": 297, "speaker": 31, "form": "dlg", "jp": "「いったいオレたちがなんでそんなことを‥‥」"},
{"id": 298, "speaker": 2, "form": "dlg", "jp": "「『世界征服』だろう？」"},
{"id": 299, "speaker": 29, "form": "dlg", "jp": "「な、なにを‥‥！」"},
{"id": 300, "speaker": 2, "form": "dlg", "jp": "「『クリエーター』の仕業にして\n　世界中にダメージを与える‥‥」"},
{"id": 301, "speaker": 2, "form": "dlg", "jp": "「で、ある程度世界がダメージを受けたら、\n　今度は『救世主』のフリをする‥‥」"},
{"id": 302, "speaker": 35, "form": "dlg", "jp": "「まあ、『能力』もあるから、\n　普通の人間は『Ｅ－ｇｒｏ』に支配されるね‥‥」"},
{"id": 303, "speaker": 31, "form": "dlg", "jp": "「オマエ、本当にそう思うのか！？」"},
{"id": 304, "speaker": 2, "form": "dlg", "jp": "「もうダマされないよ‥‥」"},
{"id": 305, "speaker": 29, "form": "dlg", "jp": "「リーダー‥‥」"},
{"id": 306, "speaker": 46, "form": "dlg", "jp": "「一番恐れていたことになりましたね‥‥」"},
{"id": 307, "speaker": 29, "form": "dlg", "jp": "「一番恐れていたこと‥‥」"},
{"id": 308, "speaker": 46, "form": "dlg", "jp": "「『疑心暗鬼』‥‥」"},
{"id": 309, "speaker": 31, "form": "dlg", "jp": "「われわれが一番恐れなくてはならないもの‥‥」"},
{"id": 310, "speaker": 31, "form": "dlg", "jp": "「それは『恐怖』そのもの‥‥」"},
{"id": 311, "speaker": 46, "form": "dlg", "jp": "「その通り‥‥」"},
{"id": 312, "speaker": 46, "form": "dlg", "jp": "「彼らは『クリエーター』に対する恐怖心から、\n　ついに『クリエーター』を心から消滅させた‥‥」"},
{"id": 313, "speaker": 29, "form": "dlg", "jp": "「どうなるんですか？」"},
{"id": 314, "speaker": 46, "form": "dlg", "jp": "「『クリエーター』より『恐くないモノ』が\n　彼らの敵と定められたのです‥‥」"},
{"id": 315, "speaker": 29, "form": "dlg", "jp": "「そんなぁ！！」"},
{"id": 316, "speaker": 31, "form": "dlg", "jp": "「弱いものたちは\n　さらに弱いものをたたきたがるってヤツか‥‥」"},
{"id": 317, "speaker": 35, "form": "dlg", "jp": "「むずかしいことを言ってごまかそうとしてもムダだよ！」"},
{"id": 318, "speaker": 46, "form": "dlg", "jp": "「ジーン、残念ですが‥‥」"},
{"id": 319, "speaker": 29, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 320, "speaker": 29, "form": "dlg", "jp": "ジーンがボクに向けて拳銃を構えた。"},
{"id": 321, "speaker": 2, "form": "dlg", "jp": "「ついに正体を現したね‥‥」"},
{"id": 322, "speaker": 29, "form": "dlg", "jp": "「ナゴムゆるしてっ！」"},
{"id": 323, "speaker": 29, "form": "dlg", "jp": "「バキューーーン！」"},
{"id": 324, "speaker": 29, "form": "dlg", "jp": "「キーン！」"},
{"id": 325, "speaker": 29, "form": "dlg", "jp": "「‥‥‥‥‥！」"},
{"id": 326, "speaker": 2, "form": "dlg", "jp": "「ボクが体をかたくできるのを忘れたの？」"},
{"id": 327, "speaker": 2, "form": "dlg", "jp": "「そんな拳銃ではボクを倒せないよ！」"},
{"id": 328, "speaker": 46, "form": "dlg", "jp": "「ローズ！！」"},
{"id": 329, "speaker": 49, "form": "dlg", "jp": "「はっ！」"},
{"id": 330, "speaker": 46, "form": "dlg", "jp": "「彼等を『浄化』してあげて！」"},
{"id": 331, "speaker": 49, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 332, "speaker": 49, "form": "dlg", "jp": "‥‥‥‥！！"},
{"id": 333, "speaker": 2, "form": "dlg", "jp": "「うわぁぁぁぁぁ～～～～～」"},
{"id": 334, "speaker": 2, "form": "dlg", "jp": "ボクたちは『謎の光線』に打ち抜かれた。"},
{"id": 335, "speaker": 35, "form": "dlg", "jp": "「『防戦』しかできないんだったら、\n　『長期戦』になるかもしれないね‥‥」"},
{"id": 336, "speaker": 29, "form": "dlg", "jp": "「そうね、どちらかがあきらめるまでの\n　『精神的消耗戦』になるわね‥‥」"},
{"id": 337, "speaker": 31, "form": "dlg", "jp": "「『精神力』の弱い方が負けってことか‥‥」"},
{"id": 338, "speaker": 31, "form": "dlg", "jp": "その時‥‥"},
{"id": 339, "speaker": 29, "form": "dlg", "jp": "「何っ？」"},
{"id": 340, "speaker": 4, "form": "dlg", "jp": "「失礼します！」"},
{"id": 341, "speaker": 46, "form": "dlg", "jp": "「どうかしたの『ローズ』？」"},
{"id": 342, "speaker": 49, "form": "dlg", "jp": "「部外者がここに侵入したもようです！」"},
{"id": 343, "speaker": 29, "form": "dlg", "jp": "「なんですって！？」"},
{"id": 344, "speaker": 49, "form": "dlg", "jp": "「なんでも、ピリが間違って呼びよせた様です！」"},
{"id": 345, "speaker": 31, "form": "dlg", "jp": "「間違った？」"},
{"id": 346, "speaker": 49, "form": "dlg", "jp": "「ナゴムくんの部屋に置き忘れていた\n　『携帯電話』をリダイヤルしたらしく‥‥」"},
{"id": 347, "speaker": 49, "form": "dlg", "jp": "「ピリが仲間の連絡と間違って、\n　コチラへ‥‥」"},
{"id": 348, "speaker": 49, "form": "dlg", "jp": "ボクの部屋！？"},
{"id": 349, "speaker": 49, "form": "dlg", "jp": "まさか、姉さんじゃあ？"},
{"id": 350, "speaker": 46, "form": "dlg", "jp": "「で、その侵入者は？」"},
{"id": 351, "speaker": 49, "form": "dlg", "jp": "「すでに、ピリが取り押さえました！」"},
{"id": 352, "speaker": 49, "form": "dlg", "jp": "「いかがいたしましょう？」"},
{"id": 353, "speaker": 46, "form": "dlg", "jp": "「いかがも何も‥‥」"},
{"id": 354, "speaker": 46, "form": "dlg", "jp": "「『処刑』するしか‥‥」"},
{"id": 355, "speaker": 2, "form": "dlg", "jp": "「ちょっと待って下さい！」"},
{"id": 356, "speaker": 2, "form": "dlg", "jp": "「ボクの部屋から、テレポートしてきたと言うことは\n　ボクの知り合いかもしれません！」"},
{"id": 357, "speaker": 31, "form": "dlg", "jp": "「だろうな‥‥」"},
{"id": 358, "speaker": 46, "form": "dlg", "jp": "「しかし、部外者にココのことを知られることは‥‥」"},
{"id": 359, "speaker": 2, "form": "dlg", "jp": "「『全人類』の危機に\n　『部外者』なんて存在しないハズです！」"},
{"id": 360, "speaker": 31, "form": "dlg", "jp": "「まあ、そうだな‥‥」"},
{"id": 361, "speaker": 2, "form": "dlg", "jp": "「お願いします、\n　とりあえず話だけでもさせてください！」"},
{"id": 362, "speaker": 46, "form": "dlg", "jp": "「わかりました‥‥」"},
{"id": 363, "speaker": 46, "form": "dlg", "jp": "「ここに連れて来てください‥‥」"},
{"id": 364, "speaker": 49, "form": "dlg", "jp": "「わかりました‥‥」"},
